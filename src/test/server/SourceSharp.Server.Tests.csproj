<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The server's facts: this project references SourceSharp.Server and never the client.
    plan_side_isolation P6 (with P7b): the suite is split by side, so each side's
    facts compile against that side alone. Fact-less helpers shared between the
    test projects live in ../common and are linked in by name below.
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <OutputPath>$(RepoRoot)bin/$(SourceSharpConfig)/tests-server/</OutputPath>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\abi\SourceSharp.Abi.csproj" />
    <!-- StaticStateWaivers reads the static-state waiver list through the analyzer's parser. -->
    <ProjectReference Include="..\..\analyzers\SourceSharp.Analyzers.csproj" />
    <ProjectReference Include="..\support\SourceSharp.TestSupport.csproj" />
    <ProjectReference Include="..\..\server\managed\SourceSharp.Server.csproj" />
    <ProjectReference Include="..\..\debug_api\interfaces\Debug.Api.Server.Interfaces.csproj" />
    <ProjectReference Include="..\..\debug_api\Debug.Api.Server.csproj" />
    <ProjectReference Include="..\..\mapgen\SourceSharp.MapGen.csproj" />
    <ProjectReference Include="..\..\debug_api_shared\Debug.Api.Shared.csproj" />
    <ProjectReference Include="..\..\mods\SourceSharp.Mods.csproj" />
    <ProjectReference Include="..\..\launcher\SourceSharp.Launcher.csproj" />
    <ProjectReference Include="..\..\host\managed\SourceSharp.Bootstrap.csproj" />
    <ProjectReference Include="..\..\generators\SourceSharp.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>

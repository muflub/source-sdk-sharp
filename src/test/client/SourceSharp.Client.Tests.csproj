<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The client's facts: this project references SourceSharp.Client and never the server.
    plan_side_isolation P6 (with P7b): the suite is split by side, so each side's
    facts compile against that side alone. Fact-less helpers shared between the
    test projects live in ../common and are linked in by name below.
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <OutputPath>$(RepoRoot)bin/$(SourceSharpConfig)/tests-client/</OutputPath>
    <IsTestProject>true</IsTestProject>
    <!--
      Blocking GCs only, no background GC: under concurrent GC the runtime
      counts a thread's unused allocation-context room as allocated when a
      background GC on another thread retires it, a few kB at random, which
      the zero-allocation facts (UiAllocationTests) read as an allocation.
      Reproduced on demand by A_background_gc_on_another_thread_does_not_move_the_count.
    -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- The UI analyzer's code fix is run in an AdhocWorkspace. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\abi\SourceSharp.Abi.csproj" />
    <ProjectReference Include="..\support\SourceSharp.TestSupport.csproj" />
    <!-- global AND client: the client-side helpers in ../common are linked into
         the cross-side project too, where the client is reached as client::
         (plan_side_isolation P7); here the same spelling names the one client. -->
    <ProjectReference Include="..\..\client\managed\SourceSharp.Client.csproj" Aliases="global,client" />
    <ProjectReference Include="..\..\client\interface\SourceSharp.Client.Interface.csproj" />
    <!-- plan_client_ui: the UI toolkit and screens, tested under Ui/. -->
    <ProjectReference Include="..\..\client\ui\toolkit\SourceSharp.Client.Ui.Toolkit.csproj" />
    <ProjectReference Include="..\..\client\ui\screens\SourceSharp.Client.Ui.csproj" />
    <ProjectReference Include="..\..\client\ui\host\SourceSharp.Client.Ui.Host.csproj" />
    <!-- The UI analyzer, as a library: its rules are run on planted code in memory. -->
    <ProjectReference Include="..\..\client\ui\analyzers\SourceSharp.Client.Ui.Analyzers.csproj" />
    <ProjectReference Include="..\..\client\ui\analyzers.codefixes\SourceSharp.Client.Ui.Analyzers.CodeFixes.csproj" />
    <!-- The preview tool: SkiaBackend (pixel goldens) and the lint's backdrops. -->
    <ProjectReference Include="..\..\tools\UiPreview\SourceSharp.UiPreview.csproj" />
    <!-- The game UI assemblies listed in tools/ui-preview-assemblies.txt, so
         DescentUiSourceUseTests can name their interfaces; each listed game
         adds its reference here (docs/plans/descent_ui.md §4). -->
    <ProjectReference Include="..\..\tf2_descent\ui\TF2.Descent.Client.Ui.csproj" />
    <ProjectReference Include="..\..\debug_api_client\Debug.Api.Client.csproj" />
    <ProjectReference Include="..\..\debug_api_shared\Debug.Api.Shared.csproj" />
    <ProjectReference Include="..\..\mods\SourceSharp.Mods.csproj" />
    <ProjectReference Include="..\..\launcher\SourceSharp.Launcher.csproj" />
    <ProjectReference Include="..\..\host\managed\SourceSharp.Bootstrap.csproj" />
    <ProjectReference Include="..\..\generators\SourceSharp.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- LINKS -->
    <Compile Include="..\common\TestServices.Client.cs" Link="common\TestServices.Client.cs" />
    <Compile Include="..\common\NotOnCiFactAttribute.cs" Link="common\NotOnCiFactAttribute.cs" />
    <Compile Include="..\common\LinuxOnlyFactAttribute.cs" Link="common\LinuxOnlyFactAttribute.cs" />
    <Compile Include="..\common\VtableSlots.cs" Link="common\VtableSlots.cs" />
    <Compile Include="..\common\ThreadPoolFloor.cs" Link="common\ThreadPoolFloor.cs" />
    <Compile Include="..\common\RecordingRagdolls.cs" Link="common\RecordingRagdolls.cs" />
    <Compile Include="..\common\ProcessWide.cs" Link="common\ProcessWide.cs" />
    <Compile Include="..\common\FakeShimRoot.cs" Link="common\FakeShimRoot.cs" />
    <Compile Include="..\common\TestVPhysics.cs" Link="common\TestVPhysics.cs" />
    <Compile Include="..\common\TestConsoleBuffer.cs" Link="common\TestConsoleBuffer.cs" />
    <Compile Include="..\common\AssemblyInfo.cs" Link="common\AssemblyInfo.cs" />
    <Compile Include="..\common\EntityInjectionClientFixtures.cs" Link="common\EntityInjectionClientFixtures.cs" />
    <Compile Include="..\common\EntityInjectionShared.cs" Link="common\EntityInjectionShared.cs" />
    <Compile Include="..\common\DirectoryProbeEntity.cs" Link="common\DirectoryProbeEntity.cs" />
    <Compile Include="..\common\WireRecords.cs" Link="common\WireRecords.cs" />
    <Compile Include="..\common\DebugApiGoldenBuildTests.Helpers.cs" Link="common\DebugApiGoldenBuildTests.Helpers.cs" />
    <Compile Include="..\common\CMakeGraph.cs" Link="common\CMakeGraph.cs" />
    <Compile Include="..\common\StudioHdrBuilder.cs" Link="common\StudioHdrBuilder.cs" />
    <Compile Include="..\common\StudioHdrBuilder.Procedural.cs" Link="common\StudioHdrBuilder.Procedural.cs" />
    <Compile Include="..\common\StudioHdrBuilder.Query.cs" Link="common\StudioHdrBuilder.Query.cs" />
    <Compile Include="..\common\TestDebugHooks.Client.cs" Link="common\TestDebugHooks.Client.cs" />
    <Compile Include="..\common\DebugApiJson.cs" Link="common\DebugApiJson.cs" />
    <Compile Include="..\common\RepoLayout.cs" Link="common\RepoLayout.cs" />
    <Compile Include="..\common\ClientShellFactAttribute.cs" Link="common\ClientShellFactAttribute.cs" />
    <Compile Include="..\common\TestServices.cs" Link="common\TestServices.cs" />
  </ItemGroup>
</Project>

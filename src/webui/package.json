{
  "name": "debug-api-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The development API's web interface. Built into Debug.Api.Server's ui/ directory, which the assembly embeds.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.0",
    "jsdom": "^28.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}

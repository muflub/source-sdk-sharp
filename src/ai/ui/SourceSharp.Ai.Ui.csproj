<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Bot setup's screens that are the same in every game (plan_hl2mp_ai §3.5,
    plan_bots_teams_tf2 C.2): the custom bot editor, opened by name
    (cs_ui_open boteditor) from each game's bots page. On the SourceSharp UI
    toolkit — the toolkit and the data contract only, never the AI core, the
    engine or Abi (the assembly rule UiAssemblyRulesTests holds over the core
    screens); it takes each game's look from the mod's theme. The data arrives
    through SourceSharp.Ai.Client.Interface; the adapters that answer it live
    in src/ai/client. Listed in mods.yaml's client_ui for every mod with bots,
    and discovered by the preview, lint and UI tests through
    tools/ui-preview-assemblies.txt.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\client\ui\analyzers\SourceSharp.Client.Ui.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\client\interface\SourceSharp.Client.Interface.csproj" />
    <ProjectReference Include="..\..\client\ui\toolkit\SourceSharp.Client.Ui.Toolkit.csproj" />
    <ProjectReference Include="..\interface\SourceSharp.Ai.Client.Interface.csproj" />
  </ItemGroup>
</Project>

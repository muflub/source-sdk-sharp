    <ProjectReference Include="..\..\..\client\ui\toolkit\SourceSharp.Client.Ui.Toolkit.csproj" />
    <ProjectReference Include="..\interface\SourceSharp.Ai.Hl2mp.Client.Interface.csproj" />
  </ItemGroup>
</Project>

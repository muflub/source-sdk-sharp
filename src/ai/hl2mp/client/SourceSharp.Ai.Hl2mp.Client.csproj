<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The HL2MP AI binding's client side (docs/plans/plan_hl2mp_ai.md §3.5,
    Phase 5c): bot setup when creating a server. It keeps the player's custom
    bot profiles under the mod's game dir and turns the create-server
    screen's choices into console commands; the server judges every profile
    again (ai_bot_add, ai_bot_roster). A mod assembly, listed in mods.yaml's
    test mod, under the mod and static-state analyzers (Directory.Build.props).
    It answers the screens' interfaces (SourceSharp.Ai.Hl2mp.Client.Interface)
    with [SideService] adapters; the screens live in SourceSharp.Ai.Hl2mp.Ui.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="SourceSharp.Ai.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\core\SourceSharp.Ai.csproj" />
    <ProjectReference Include="..\interface\SourceSharp.Ai.Hl2mp.Client.Interface.csproj" />
    <ProjectReference Include="..\..\..\abi\SourceSharp.Abi.csproj" />
    <ProjectReference Include="..\..\..\client\managed\SourceSharp.Client.csproj" />
  </ItemGroup>
</Project>

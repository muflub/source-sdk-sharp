<Project Sdk="Microsoft.NET.Sdk">
  <!-- The AI's facts (docs/plans/plan_hl2mp_ai.md §8.1): their own project and
       their own leg, `ai`, as the TF2 mod's are. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputPath>$(RepoRoot)bin/$(SourceSharpConfig)/ai-tests/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- The fixtures are written with map-tools' own Nav3dWriter (§8.2). -->
    <PackageReference Include="SourceSharp.MapFormats" Version="$(MapFormatsVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\core\SourceSharp.Ai.csproj" />
    <ProjectReference Include="..\hl2mp\server\SourceSharp.Ai.Hl2mp.csproj" />
    <!-- The nav PNG and its golden (§7.3). -->
    <ProjectReference Include="..\replay\SourceSharp.Ai.Replay.csproj" />
    <ProjectReference Include="..\..\abi\SourceSharp.Abi.csproj" />
    <ProjectReference Include="..\..\server\managed\SourceSharp.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- So facts can find the repository the way the core tests do. -->
    <Compile Include="..\..\test\common\RepoLayout.cs" Link="common\RepoLayout.cs" />
    <Compile Include="..\..\test\common\IlCallCensus.cs" Link="common\IlCallCensus.cs" />
  </ItemGroup>
</Project>

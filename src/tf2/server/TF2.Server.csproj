<Project Sdk="Microsoft.NET.Sdk">
  <!-- TF2's server side: stock TF2 server logic, ported. -->
  <ItemGroup>
    <!-- TF2's shared source compiles into each side (plan_side_isolation §2.4,
         the Descent pattern): no TF2.Shared assembly, so the shared netstate
         classes register once per side like src/shared/managed/*NetState.cs. -->
    <Compile Include="..\shared\**\*.cs" Link="shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\abi\SourceSharp.Abi.csproj" />
    <ProjectReference Include="..\..\server\managed\SourceSharp.Server.csproj" />
    <ProjectReference Include="..\..\generators\SourceSharp.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>

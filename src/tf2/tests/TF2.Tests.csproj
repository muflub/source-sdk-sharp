<Project Sdk="Microsoft.NET.Sdk">
  <!-- TF2's facts (stage0_core_seams 0.1): their own project and leg, like
       TF2.Descent.Tests, minus the host packages TF2 never references. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputPath>$(RepoRoot)bin/$(SourceSharpConfig)/tf2-tests/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\server\TF2.Server.csproj" />
    <!-- Aliased: the shared source compiles into both sides, so its types exist
         twice (plan_side_isolation §2.5); and the client core it builds on,
         under the same alias: unaliased its copy of the shared source would
         collide with the server's (plan_side_isolation P7). -->
    <ProjectReference Include="..\client\TF2.Client.csproj" Aliases="client" />
    <ProjectReference Include="..\..\client\managed\SourceSharp.Client.csproj" Aliases="client" />
    <ProjectReference Include="..\..\abi\SourceSharp.Abi.csproj" />
    <!-- plan_shim_areas_split phase 3: each side compiles the shared interop, so the
         doubles are built per side and the client's interop is named under the
         client alias, as the client's logic is. -->
    <ProjectReference Include="..\..\test\support\server\SourceSharp.TestSupport.Server.csproj" />
    <ProjectReference Include="..\..\test\support\client\SourceSharp.TestSupport.Client.csproj" Aliases="client" />
    <ProjectReference Include="..\..\client\interop\SourceSharp.Client.Interop.csproj" Aliases="client" />
    <ProjectReference Include="..\..\client\interface\SourceSharp.Client.Interface.csproj" Aliases="client" />
    <ProjectReference Include="..\interface\TF2.Client.Interface.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- So facts can read the farm/fork the way core tests do. -->
    <Compile Include="..\..\test\common\RepoLayout.cs" Link="common\RepoLayout.cs" />
    <Compile Include="..\..\test\common\DeclaredConVars.cs" Link="common\DeclaredConVars.cs" />
    <Compile Include="..\..\test\common\DeclaredConVars.Client.cs" Link="common\DeclaredConVars.Client.cs" />
    <Compile Include="..\..\test\common\IlCallCensus.cs" Link="common\IlCallCensus.cs" />
    <Compile Include="..\..\test\common\TempEntPathCensus.cs" Link="common\TempEntPathCensus.cs" />
    <Compile Include="..\..\test\common\ByNameConVarReads.cs" Link="common\ByNameConVarReads.cs" />
    <!-- The CI skip, for the facts that need a mounted Team Fortress 2 install. -->
    <Compile Include="..\..\test\common\NotOnCiFactAttribute.cs" Link="common\NotOnCiFactAttribute.cs" />
    <!-- The core's entity doubles (stage 2.4): the map entities' facts spawn
         through a ScriptedEntityRegistry over a RecordingEngine, as the core's do. -->
    <Compile Include="..\..\test\common\TestServices.cs" Link="common\TestServices.cs" />
    <Compile Include="..\..\test\common\TempEntFill.cs" Link="common\TempEntFill.cs" />
    <Compile Include="..\..\test\common\TestServices.Server.cs" Link="common\TestServices.Server.cs" />
    <Compile Include="..\..\test\common\TestVPhysics.cs" Link="common\TestVPhysics.cs" />
    <!-- A spawner for facts that are not about map spawning (plan_entity.md 2d):
         the carrier's cleanup facts run the real MapCleanup, which wants one. -->
    <Compile Include="..\..\test\common\TestMapSpawner.cs" Link="common\TestMapSpawner.cs" />
    <Compile Include="..\..\test\common\RecordingDecals.cs" Link="common\RecordingDecals.cs" />
    <Compile Include="..\..\test\common\RecordingServerSkins.cs" Link="common\RecordingServerSkins.cs" />
    <Compile Include="..\..\test\common\LagWorld.cs" Link="common\LagWorld.cs" />
    <Compile Include="..\..\test\common\RecordingEffectDispatch.cs" Link="common\RecordingEffectDispatch.cs" />
    <Compile Include="..\..\test\common\RecordingJointTables.cs" Link="common\RecordingJointTables.cs" />
    <Compile Include="..\..\test\common\RecordingBlastSweep.cs" Link="common\RecordingBlastSweep.cs" />
    <Compile Include="..\..\test\common\TempEntsDouble.cs" Link="common\TempEntsDouble.cs" />
    <!-- The allocation facts measure without a one-off tier-up charge (TFConditionsTests). -->
    <Compile Include="..\..\test\common\SteadyAllocation.cs" Link="common\SteadyAllocation.cs" />
    <!-- Oracle facts read the pristine clone through the oracle project's helper (stage1 Corrections 11). -->
    <Compile Include="..\..\test\oracle\managed\ValveSdk.cs" Link="common\ValveSdk.cs" />
    <Compile Include="..\..\test\oracle\managed\StockStringArrays.cs" Link="common\StockStringArrays.cs" />
  </ItemGroup>
</Project>

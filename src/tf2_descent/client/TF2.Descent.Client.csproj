<Project Sdk="Microsoft.NET.Sdk">
  <!-- TF2Descent's client side. Never the SDK or Host.Contracts. -->
  <PropertyGroup>
    <!-- Bootstrap loads by simple name from bin/<config>/bin/managed, so the
         prefetch's SharpZipLib must be copied there, as the server copies the
         SDK's packages (DeployedReferencesTests). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- TF2.Descent's shared source compiles into each side (plan_side_isolation §2.4): no shared assembly. -->
    <Compile Include="..\shared\**\*.cs" Link="shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\abi\SourceSharp.Abi.csproj" />
    <ProjectReference Include="..\..\client\managed\SourceSharp.Client.csproj" />
    <!-- The generator writes each shared user message payload's wire code. -->
    <ProjectReference Include="..\..\generators\SourceSharp.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- bzip2 for the next level's prefetch (fastdl serves .bsp.bz2; .NET has none). The host's own version. -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The rules' content the screens display (plan_descent_logic UI3): the SAME
      files TF2.Descent.Rules embeds, linked, as TF2.Descent.Client.Content.<table>.json.
      The client may not reference Rules (it references Host.Contracts), so it
      reads names, tiers and requirements (and the robot names, champion
      affixes and status words a health bar shows, UI6; the miner's lamp's light and the hazard kinds, HE10) from these
      bytes (Content/DescentCatalog.cs, Lamp/HeroLampLights.cs, Lamp/HeroHazards.cs);
      DescentCatalog.Tables lists them, and a fact holds the two lists equal.
    -->
    <EmbeddedResource Include="..\rules\Content\skills.json;..\rules\Content\skill_tabs.json;..\rules\Content\skill_settings.json;..\rules\Content\item_bases.json;..\rules\Content\affixes.json;..\rules\Content\attributes.json;..\rules\Content\rarities.json;..\rules\Content\families.json;..\rules\Content\damage_types.json;..\rules\Content\unusual_effects.json;..\rules\Content\uniques.json;..\rules\Content\inventory.json;..\rules\Content\robots.json;..\rules\Content\champions.json;..\rules\Content\status.json;..\rules\Content\lamp.json;..\rules\Content\hazards.json"
                      Link="Content\%(Filename)%(Extension)"
                      LogicalName="TF2.Descent.Client.Content.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- TF2Descent builds on the TF2 mod. -->
    <ProjectReference Include="..\..\tf2\client\TF2.Client.csproj" />
    <!-- The Descent screens' contract (plan_descent_logic UI1): client/Ui answers it. -->
    <ProjectReference Include="..\interface\TF2.Descent.Client.Interface.csproj" />
  </ItemGroup>
</Project>

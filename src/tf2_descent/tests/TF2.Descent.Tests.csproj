<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputPath>$(RepoRoot)bin/$(SourceSharpConfig)/tf2_descent-tests/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\rules\TF2.Descent.Rules.csproj" />
    <ProjectReference Include="..\server\TF2.Descent.Server.csproj" />
    <!-- Aliased: the shared source compiles into both sides, so its types exist twice (plan_side_isolation §2.5). -->
    <ProjectReference Include="..\client\TF2.Descent.Client.csproj" Aliases="client" />
    <!-- And the client core it builds on, under the same alias: it reaches this
         project through TF2.Descent.Client too, and unaliased its copy of the
         shared source would collide with the server's (plan_side_isolation P7). -->
    <ProjectReference Include="..\..\client\managed\SourceSharp.Client.csproj" Aliases="client" />
    <ProjectReference Include="..\..\abi\SourceSharp.Abi.csproj" />
    <!-- plan_shim_areas_split phase 3: each side compiles the shared interop, so the
         doubles are built per side and the client's interop is named under the
         client alias, as the client's logic is. -->
    <ProjectReference Include="..\..\test\support\server\SourceSharp.TestSupport.Server.csproj" />
    <ProjectReference Include="..\..\test\support\client\SourceSharp.TestSupport.Client.csproj" Aliases="client" />
    <ProjectReference Include="..\..\client\interop\SourceSharp.Client.Interop.csproj" Aliases="client" />
    <ProjectReference Include="..\..\client\interface\SourceSharp.Client.Interface.csproj" Aliases="client" />
  </ItemGroup>
  <ItemGroup>
    <!-- The core's censuses, run over this mod's assemblies too (HooksCensusTests). -->
    <Compile Include="..\..\test\common\NullableEngineInterfaceCensus.cs" Link="common\NullableEngineInterfaceCensus.cs" />
    <Compile Include="..\..\test\common\IlCallCensus.cs" Link="common\IlCallCensus.cs" />
    <Compile Include="..\..\test\common\HooksCensus.cs" Link="common\HooksCensus.cs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    source#: the mod launcher, NativeAOT. Replaces the native
    launcher_main_mod_sharp and Valve's hl2.sh: finds the engine install through
    Steam, then starts the engine with the mod mods.yaml names, restarting it
    while it exits with the restart code, as hl2.sh did.

    The assembly is SourceSharp.Launcher because MSBuild is not trusted with a
    `#` in a file name; the PublishSourceSharp target below copies the native
    binary to bin/<config>/source# after publish.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The platform this build runs on, x64 on each: the engine is x86-64
         only, so an Apple Silicon machine publishes the osx-x64 launcher too.
         Linux unless the host says otherwise (a build on Linux is the Linux
         launcher, as before). -->
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <!-- Not beside the managed game assemblies: the launcher is not loaded by the game. -->
    <OutputPath>$(RepoRoot)bin/$(SourceSharpConfig)/launcher/</OutputPath>
    <PublishDir>$(RepoRoot)bin/$(SourceSharpConfig)/launcher/publish/</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\mods\SourceSharp.Mods.csproj" />
    <InternalsVisibleTo Include="SourceSharp.Shared.Tests" />
    <InternalsVisibleTo Include="SourceSharp.Server.Tests" />
    <InternalsVisibleTo Include="SourceSharp.Client.Tests" />
  </ItemGroup>

  <!-- source#, or source#.exe on Windows, where the engine's loader wants
       the extension (the name is otherwise the same on every platform; the
       Makefile's launcher-name-test reads it). -->
  <Target Name="PublishSourceSharp" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)SourceSharp.Launcher$(NativeBinaryExt)"
          DestinationFiles="$(RepoRoot)bin/$(SourceSharpConfig)/source#$(NativeBinaryExt)" />
  </Target>
</Project>

{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "local",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/farm/${presetName}/build",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-22",
        "SS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "local",
      "displayName": "debug: host clang 22 + lld",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "local",
      "displayName": "release: host clang 22 + lld",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ci",
      "hidden": true,
      "generator": "Ninja",
      "description": "Inside registry.gitlab.steamos.cloud/steamrt/sniper/sdk (tools/build/ci-build). The image's default gcc (10) is the compiler: it is the one the VPC build used and it builds this code with zero warnings; the image's clang is 11.",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "x86_64-linux-gnu-g++",
        "SS_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "ci-debug",
      "inherits": "ci",
      "displayName": "ci-debug: sniper container gcc",
      "binaryDir": "${sourceDir}/farm/debug/build-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SS_DEPLOY_DIR": "${sourceDir}/bin/ci-debug/linux64"
      }
    },
    {
      "name": "ci-release",
      "inherits": "ci",
      "displayName": "ci-release: sniper container gcc",
      "binaryDir": "${sourceDir}/farm/release/build-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SS_DEPLOY_DIR": "${sourceDir}/bin/ci-release/linux64"
      }
    },
    {
      "name": "oracle-debug",
      "inherits": "debug",
      "displayName": "oracle-debug: the oracle tests' own build directory",
      "binaryDir": "${sourceDir}/farm/debug/build-oracle",
      "cacheVariables": {
        "SS_TEST_TREE": "oracle"
      }
    },
    {
      "name": "oracle-release",
      "inherits": "release",
      "displayName": "oracle-release: the oracle tests' own build directory",
      "binaryDir": "${sourceDir}/farm/release/build-oracle",
      "cacheVariables": {
        "SS_TEST_TREE": "oracle"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "generator": "Ninja",
      "description": "MSVC (cl on PATH from a VS 2022 developer prompt, the toolset Valve's README names) with Ninja. The farm is the same; the output goes to bin/<config>/bin/x64. The native tests build too (bin/<config>/cpptest), less the LINUX_ONLY ones, which configure lists with their reasons.",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "SS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows",
      "displayName": "windows-debug: MSVC + Ninja",
      "binaryDir": "${sourceDir}/farm/debug/build-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "inherits": "windows",
      "displayName": "windows-release: MSVC + Ninja",
      "binaryDir": "${sourceDir}/farm/release/build-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "osx",
      "hidden": true,
      "generator": "Ninja",
      "description": "Apple clang with Ninja, building the x86_64 slice whatever the machine is (the engine is x86-64 only). Output to bin/<config>/bin/osx64. Valve ships no macOS prebuilts, so the game libraries link with -undefined dynamic_lookup and libss_particles is not built (cmake/sdk/CMakeLists.txt).",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "SS_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "osx-debug",
      "inherits": "osx",
      "displayName": "osx-debug: Apple clang + Ninja, x86_64",
      "binaryDir": "${sourceDir}/farm/debug/build-osx",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "osx-release",
      "inherits": "osx",
      "displayName": "osx-release: Apple clang + Ninja, x86_64",
      "binaryDir": "${sourceDir}/farm/release/build-osx",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "ci-debug",
      "configurePreset": "ci-debug"
    },
    {
      "name": "ci-release",
      "configurePreset": "ci-release"
    },
    {
      "name": "oracle-debug",
      "configurePreset": "oracle-debug"
    },
    {
      "name": "oracle-release",
      "configurePreset": "oracle-release"
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },
    {
      "name": "osx-debug",
      "configurePreset": "osx-debug"
    },
    {
      "name": "osx-release",
      "configurePreset": "osx-release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "oracle-debug",
      "configurePreset": "oracle-debug"
    },
    {
      "name": "oracle-release",
      "configurePreset": "oracle-release"
    }
  ]
}

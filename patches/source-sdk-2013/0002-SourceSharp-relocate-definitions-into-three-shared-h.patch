-interval_t ReadInterval( const char *pString );
-float RandomInterval( const interval_t &interval );
+inline interval_t ReadInterval( const char *pString )
+{
+	interval_t tmp;
+
+	tmp.start = 0;
+	tmp.range = 0;
+
+	char tempString[128];
+	Q_strncpy( tempString, pString, sizeof(tempString) );
+
+	char *token = strtok( tempString, "," );
+	if ( token )
+	{
+		tmp.start = atof( token );
+		token = strtok( NULL, "," );
+		if ( token )
+		{
+			tmp.range = atof( token ) - tmp.start;
+		}
+	}
+
+	return tmp;
+}
+
+inline float RandomInterval( const interval_t &interval )
+{
+	float out = interval.start;
+	if ( interval.range != 0 )
+	{
+		out += RandomFloat( 0, interval.range );
+	}
+
+	return out;
+}
 
 #endif // INTERVAL_H

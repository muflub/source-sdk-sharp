 #define MAPKEY_MAXLENGTH	2048
 
+#include "tier0/dbg.h"
+#include "tier1/strtools.h"
+#include <cstring>
+#include <cstdlib>
+
 
 //-----------------------------------------------------------------------------
 // Purpose: encapsulates the data string in the map file 

 src/public/iclientunknown.h            |  4 +-
 src/public/isaverestore.h              | 10 +--
 src/public/iserverentity.h             |  4 ++
 src/public/iservernetworkable.h        |  4 +-
 src/public/iserverunknown.h            |  4 +-
 src/public/networkvar.h                | 90 +++++++++++++++++++++-----
 src/public/saverestoretypes.h          | 14 ++--
 src/public/tier1/utlblockmemory.h      |  9 +++
 src/public/toolframework/itoolentity.h | 66 +++++++++----------
 18 files changed, 209 insertions(+), 96 deletions(-)


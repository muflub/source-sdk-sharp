+
+static int SourceSharp_CountParticles( CParticleCollection *pCollection )
+{
+	if ( !pCollection )
+		return 0;
+
+	int nTotal = pCollection->m_nActiveParticles;
+
+	for ( CParticleCollection *pChild = pCollection->m_Children.m_pHead;
+	      pChild; pChild = pChild->m_pNext )
+	{
+		nTotal += SourceSharp_CountParticles( pChild );
+	}
+
+	return nTotal;
+}
+
+void CParticleMgr::SourceSharpParticleReport()
+{
+	int nEffects = 0;
+	int nDrawing = 0;
+
+	for ( CNewParticleEffect *pEffect = m_NewEffects.m_pHead;
+	      pEffect; pEffect = pEffect->m_pNext )
+	{
+		nEffects++;
+
+		const int nParticles = SourceSharp_CountParticles( pEffect );
+
+		if ( nParticles > 0 )
+			nDrawing++;
+
+		const Vector cp0 = pEffect->m_ControlPoints[ 0 ].m_Position;
+		const Vector cp1 = pEffect->m_ControlPoints[ 1 ].m_Position;
+		const Vector vSort = pEffect->GetSortOrigin();
+
+		Msg( "[SourceSharp] particle system: name '%s' particles %d "
+		     "cp0 (%.1f %.1f %.1f) cp1 (%.1f %.1f %.1f) "
+		     "sort (%.1f %.1f %.1f) highestcp %d\n",
+		     pEffect->GetEffectName(), nParticles,
+		     cp0.x, cp0.y, cp0.z,
+		     cp1.x, cp1.y, cp1.z,
+		     vSort.x, vSort.y, vSort.z,
+		     pEffect->GetHighestControlPoint() );
+	}
+
+	Msg( "[SourceSharp] particle report: %d system(s), %d with particles\n",
+	     nEffects, nDrawing );
+}
+
+static void SourceSharp_ReportClientEntityOrigin( int nEntIndex )
+{
+	IClientEntity *pEnt = SSClientEntityFromIndex( nEntIndex );
+
+	if ( !pEnt )
+	{
+		Msg( "[SourceSharp] client entity %d: ABSENT on this side\n", nEntIndex );
+		return;
+	}
+
+	const Vector vOrigin = pEnt->GetAbsOrigin();
+
+	Msg( "[SourceSharp] client entity %d: origin (%.1f %.1f %.1f)\n",
+	     nEntIndex, vOrigin.x, vOrigin.y, vOrigin.z );
+}
+
+CON_COMMAND( cs_cl_particle_report,
+             "plan_entity.md 7e: every live particle system, its active particle "
+             "count (with children), its control points 0 and 1, and its sort origin" )
+{
+	CParticleMgr *pMgr = ParticleMgr();
+
+	if ( !pMgr )
+	{
+		Msg( "[SourceSharp] particle report: no particle manager\n" );
+		return;
+	}
+
+	pMgr->SourceSharpParticleReport();
+
+	if ( args.ArgC() > 1 )
+		SourceSharp_ReportClientEntityOrigin( atoi( args[ 1 ] ) );
+}

+		case SHADOWS_SIMPLE:                   ++nSimple; break;
+		case SHADOWS_RENDER_TO_DEPTH_TEXTURE:  ++nDepth;  break;
+		default:                               ++nNone;   break;
+		}
+
+		Vector vecRender( 0.0f, 0.0f, 0.0f );
+
+		if ( pRenderable )
+			vecRender = pRenderable->GetRenderOrigin();
+
+		Msg( "[SourceSharp] shadow %d: entry %d serial %d  projectedFrom (%.1f %.1f %.1f)  "
+		     "renderOrigin (%.1f %.1f %.1f)  type %d  renderFrame %d  %s\n",
+		     (int)h,
+		     shadow.m_Entity.GetEntryIndex(), shadow.m_Entity.GetSerialNumber(),
+		     shadow.m_LastOrigin.x, shadow.m_LastOrigin.y, shadow.m_LastOrigin.z,
+		     vecRender.x, vecRender.y, vecRender.z,
+		     (int)GetActualShadowCastType( h ),
+		     shadow.m_nRenderFrame,
+		     pRenderable ? "resolved" : "UNRESOLVED" );
+	}
+
+	Msg( "[SourceSharp] shadow report: held %d  rtt %d  simple %d  depth %d  none %d  "
+	     "lostRenderable %d  texturesDrawn %d  rttActive %d  r_shadows %d\n",
+	     nHeld, nRtt, nSimple, nDepth, nNone, nLost,
+	     s_nRttShadowTexturesDrawn,
+	     m_RenderToTextureActive ? 1 : 0,
+	     r_shadows.GetInt() );
+
+	Msg( "[SourceSharp] shadow resolve: asks %d  fromTable %d  fromLegacy %d  unresolved %d\n",
+	     stats.nAsks, stats.nFromTable, stats.nFromLegacy, stats.nUnresolved );
+
+	if ( nHeld == 0 )
+	{
+		Msg( "[SourceSharp] shadow report: THE MANAGER HOLDS NO SHADOWS -- every number "
+		     "above is about an empty list and none of them is evidence that shadows work\n" );
+	}
+
+	if ( bResetCounters )
+	{
+		s_nRttShadowTexturesDrawn = 0;
+		SourceSharp_ResetRenderableResolveStats();
+	}
+}
+
+CON_COMMAND( cs_cl_shadow_report,
+	"cs_cl_shadow_report [reset] — every client shadow: who it is for, where it was last projected from, and whether its renderable still resolves" )
+{
+	const bool bReset = ( args.ArgC() > 1 ) && ( Q_stricmp( args.Arg( 1 ), "reset" ) == 0 );
+
+	s_ClientShadowMgr.PrintShadowReport( bReset );
+}

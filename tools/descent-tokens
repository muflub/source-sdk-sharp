#!/usr/bin/env python3
"""tools/descent-tokens -- append #Descent_* copy to the UTF-16 language file.

The descent mod's token file (game/mod_tf2_descent/resource/descent_english.txt)
is UTF-16 KeyValues, which git cannot merge as text (docs/plans/descent_ui.md
§1). Lanes therefore never hand-edit it: each keeps a plain UTF-8 TSV of its
own additions (Token<TAB>Text per line) and runs

    tools/descent-tokens add <tsv> [<tsv> ...]

which appends the TSV's tokens that the file lacks, in the file's own shape
(quoted key, two tabs, quoted value), preserving the UTF-16 LE byte-order
mark. The same command run at integration over every lane's TSV rebuilds the
one true file with no merge at all.

    tools/descent-tokens list          # every token, TAB-separated
    tools/descent-tokens check <tsv>   # exit 1 if a TSV token is missing

A key that exists with a different value is an error naming both sides: the
first file wins in the game too, so a lane may not silently redefine copy.
"""
import re
import sys
import os

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LANG = os.path.join(ROOT, "game", "mod_tf2_descent", "resource", "descent_english.txt")

LINE = re.compile(r'^"((?:[^"\\]|\\.)*)"\s+"((?:[^"\\]|\\.)*)"\s*$')


def unquote(text):
    out, i = [], 0
    while i < len(text):
        if text[i] == "\\" and i + 1 < len(text):
            nxt = {"n": "\n", '"': '"', "\\": "\\"}.get(text[i + 1], text[i + 1])
            out.append(nxt)
            i += 2
        else:
            out.append(text[i])
            i += 1
    return "".join(out)


def read_tokens():
    with open(LANG, "r", encoding="utf-16") as f:
        text = f.read()
    tokens = {}
    for line in text.splitlines():
        m = LINE.match(line.strip())
        if m:
            tokens[m.group(1)] = unquote(m.group(2))
    return text, tokens


def read_tsv(path):
    out = []
    with open(path, "r", encoding="utf-8") as f:
        for n, line in enumerate(f, 1):
            line = line.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) != 2:
                sys.exit(f"{path}:{n}: expected Token<TAB>Text, got {line!r}")
            out.append((parts[0], parts[1]))
    return out


def quote(text):
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def main(argv):
    if not argv or argv[0] not in ("list", "add", "check"):
        sys.exit(__doc__)
    text, tokens = read_tokens()

    if argv[0] == "list":
        for k, v in tokens.items():
            print(f"{k}\t{v}")
        return 0

    added = 0
    for path in argv[1:]:
        for key, value in read_tsv(path):
            if key in tokens:
                if tokens[key] != value:
                    sys.exit(f"{path}: {key} already reads {tokens[key]!r}, the TSV says {value!r}")
                continue
            text = text.replace("\n}\n}", f"\n{quote(key)}\t\t{quote(value)}\n}}\n}}", 1)
            tokens[key] = value
            added += 1
    if argv[0] == "check":
        return 0 if added == 0 else 1

    with open(LANG, "w", encoding="utf-16", newline="") as f:
        f.write(text)
    print(f"descent-tokens: +{added} token(s) -> {os.path.relpath(LANG, ROOT)} ({len(tokens)} total)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

           and '_shim.Table->EntityGetModelName(_shim.Self' in in_class('EntityGetModelName', 'ModelsArea'))
    expect('a client switch list naming a base the client does not implement is refused',
           'IShimNoSuchBase' in bad_client)
    # plan_client_vtables CC: a client-only area.
    expect('a client-only area is a client class on the client root, not a server area',
           'class CShimHudClient final : public IShimHudClient' in gen[OUT_CLASSES]
           and 'CShimHudClient::GetLocalPlayerHealth' in gen[OUT_IMPL_CLIENT]
           and 'SOURCESHARP_SHIM_HUDCLIENT_VERSION' in gen[OUT_IMPL_CLIENT]
           and 'HudClient' not in gen[OUT_IMPL])
    expect('a client-only slot is typed on its client area, which the client registration alone hands out',
           len(typed_lines('GetLocalPlayerHealth')) == 1
           and '_shim.Table->GetLocalPlayerHealth(_shim.Self' in in_class('GetLocalPlayerHealth', 'HudClientArea')
           and out.count('        add(typeof(IHudClientArea), hudClientArea);') == 1
           and managed.index('add(typeof(IHudClientArea)') > managed.index('class ClientAreaRegistration'))
    try:
        globals()['client_switched'] = lambda: real_client() - {'IShimHudClient'}
        generate()
        hud_off = ''
    except SystemExit as e:
        hud_off = str(e)
    finally:
        globals()['client_switched'] = real_client
    expect('an unswitched client-only area is refused: its typed call would have no route',
           'GetLocalPlayerHealth' in hud_off or 'IShimHudClient' in hud_off)
    # docs/todo.md router retirement: the attach plumbing lives on EngineSide,
    # so the generated file must not carry it back.
    expect('the generated file attaches nothing: AttachShims/Root/ServerAttached are EngineSide\'s',
           'AttachShims' not in gen[OUT_MANAGED] and 'AttachClientShims' not in gen[OUT_MANAGED]
           and 'ServerAttached' not in gen[OUT_MANAGED] and ' internal ShimRoot? Root' not in gen[OUT_MANAGED])
    expect('the areas are still acquired with the span check and counts',
           managed.count('internal static bool TryAcquire(ShimRoot root, Action<Type, object> add, out string why)') == 2
           and managed.count('internal static int Count =>') == 2)
    # The vtable order (lane c5-particles): the tree agrees, and each way of
    # disagreeing is caught.
    expect('the hand-kept headers declare every TSV interface in the TSV\'s order', order_problems() == [])
    client_text = read(OUT_IFACE_CLIENT)
    swapped = client_text.replace(
        '\tvirtual void ParticlesConfigure(', '\tvirtual void ParticlesConfigureSwapTmp(', 1)
    lines = client_text.split('\n')
    create = [k for k, l in enumerate(lines) if 'virtual int32_t ParticlesCreate(' in l]
    if create:
        moved = lines[:create[0]] + lines[create[0] + 1:]
        close = [k for k, l in enumerate(moved) if k > create[0] and l == '};'][0]
        moved = moved[:close] + [lines[create[0]]] + moved[close:]
        moved_text = '\n'.join(moved)
    else:
        moved_text = ''
    expect('a slot declared out of the TSV\'s order is refused (the 10-vs-11 class)',
           any('IShimParticlesClient' in p and 'first difference at slot 0' in p
               for p in order_problems([read(OUT_IFACE), moved_text])))
    expect('a slot the header names differently is refused',
           any('IShimParticlesClient' in p for p in order_problems([read(OUT_IFACE), swapped])))
    expect('an interface missing from both headers is refused',
           any('IShimEngine' in p and 'no abstract_class' in p
               for p in order_problems([read(OUT_IFACE).replace('abstract_class IShimEngine', 'class IShimEngineGone'),
                                        client_text])))
    print('\n%d arm(s), %d failed.' % (len(arms), arms.count(False)))
    return 0 if all(arms) else 1


def formatted(text, name):
    '''What tools/clang-format makes of a native file this writes.'''
    import importlib.machinery
    cf = importlib.machinery.SourceFileLoader(
        'clang_format_tool', os.path.join(os.path.dirname(os.path.realpath(__file__)), 'clang-format')).load_module()
    return cf.format_text(text, name)


def main(argv):
    if '--self-test' in argv:
        return self_test()
    if '--vtable-order' in argv:
        problems = order_problems()
        for p in problems:
            print('tools/shim-areas: vtable order: %s' % p)
        if problems:
            return 1
        print('tools/shim-areas: the hand-kept headers declare every TSV interface in its TSV order.')
        return 0
    out = {rel: formatted(text, rel) if rel.endswith(('.h', '.cpp', '.inl')) else text
           for rel, text in generate().items()}
    if '--write' in argv:
        for rel, text in out.items():
            with open(os.path.join(ROOT, rel), 'w') as f:
                f.write(text)
            print('wrote %s' % rel)
        return 0
    stale = [rel for rel, text in out.items()
             if not os.path.exists(os.path.join(ROOT, rel)) or read(rel) != text]
    if stale:
        print('tools/shim-areas: stale: %s -- run `tools/shim-areas --write` and read the diff'
              % ', '.join(stale))
        return 1
    print('tools/shim-areas: %d generated file(s) are what the inputs say.' % len(out))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env python3
"""tools/shim-areas -- the server's EngineApi areas as C++ shim classes, generated.

    tools/shim-areas            check the generated files are what the inputs say
    tools/shim-areas --write    write them
    tools/shim-areas --self-test
    tools/shim-areas --vtable-order   the hand-kept ishim_areas.h / ishim_areas_client.h
                                      declare every interface's slots in the TSV's order

    exit 0   they are current
    exit 1   they are not -- run --write and read the diff

plan_engineapi_vtables.md Phase C. docs/engineapi-areas.tsv rules every slot
the server fills to an IShim* interface. This generates, from that table, the
slot signatures in host/native/sourcesharp.h and the server's fill in
sourcesharp_gamesystem.cpp:

  src/shared/native/ishim_areas.h        the interfaces: shared bases, their
                                          server extensions, the server-only ones
  src/shared/native/shell_shim_areas.h   the server's concrete classes, one per
                                          bound interface, and CShimAreas, which
                                          the shim root holds by value
  src/shared/native/shell_shim_areas.inc their methods, each a one-line forward
                                          to the body the struct slot is filled
                                          with, and ShimAreas_Acquire; included at
                                          the end of sourcesharp_gamesystem.cpp,
                                          where the static bodies are visible
  src/test/native/shim_areas_forwarders.inc  one count test per bound interface,
                                          its forwarder table against the
                                          compiler, included by fwd_shim_test
  src/abi/ShimAreas.g.cs                 the managed areas: one class per area over
                                          its forwarder table (a server area deriving
                                          the shared base it extends), and each
                                          side's registration, which hands them by
                                          type to that side's registry
                                          (plan_shim_areas_split phases 2 and 11)

FORWARDS, NOT RENAMES. The bodies stay free SourceSharp_* functions: 969 gtest
calls and tools/entrypoint-decls depend on them, and the client still fills the
struct from the same bodies. The class is the vtable managed calls through.

Method names are the SLOT names, verbatim: greppable from either side, and a
slot never needs a second name. The Console and Root areas are hand-written
(A3/A4) and skipped here.
"""

import csv
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

TSV = 'docs/engineapi-areas.tsv'
HEADER = 'src/host/native/sourcesharp.h'
FILL = 'src/shared/native/sourcesharp_gamesystem.cpp'
VALVE = 'tools/valve-header.txt'

OUT_IFACE = 'src/shared/native/ishim_areas.h'
OUT_IFACE_CLIENT = 'src/shared/native/ishim_areas_client.h'   # hand-kept, plan_client_vtables CC
OUT_CLASSES = 'src/shared/native/shell_shim_areas.h'
OUT_IMPL = 'src/shared/native/shell_shim_areas.inc'
OUT_IMPL_CLIENT = 'src/shared/native/shell_shim_areas_client.inc'
OUT_TEST = 'src/test/native/shim_areas_forwarders.inc'
OUT_MANAGED = 'src/abi/ShimAreas.g.cs'
OUT_DEFAULTS = 'src/test/support/ShimAreaDefaults.g.cs'
SWITCHED = 'docs/engineapi-switched.txt'
# plan_client_vtables CB: the shared bases whose EngineSide calls go through the
# client's vtable on the client (empty: the client still reads the struct).
CLIENT_SWITCHED = 'docs/engineapi-client-switched.txt'

HAND_WRITTEN = {'IShimRoot', 'IShimConsole'}

GENERATED = '// GENERATED by `tools/shim-areas --write` from docs/engineapi-areas.tsv. DO NOT EDIT.'


def read(rel):
    with open(os.path.join(ROOT, rel)) as f:
        return f.read()


def strip_comments(text):
    text = re.sub(r'/\*.*?\*/', lambda m: '\n' * m.group(0).count('\n'), text, flags=re.S)
    return re.sub(r'//[^\n]*', '', text)


TYPE_WORDS = {'int', 'int32_t', 'uint32_t', 'int64_t', 'uint64_t', 'float', 'double', 'char',
              'bool', 'void', 'short', 'long', 'unsigned', 'signed', 'uint8_t', 'uint16_t',
              'int16_t', 'size_t'}


def iface_signatures(header_text):
    """slot -> (return type, [(type, name)]) from ishim_areas.h's pure virtuals.

    Since plan_engineapi_vtables C6a the header is the source of truth for the
    C++ signatures: C-last removes the server-only fields from the struct this
    tool used to read them from.
    """
    code = strip_comments(header_text)
    out = {}
    for m in re.finditer(r'virtual\s+([\w\s\*]+?)\s*\b(\w+)\(\s*(.*?)\s*\)\s*=\s*0\s*;', code, re.S):
        params = []
        raw = ' '.join(m.group(3).split())
        if raw and raw != 'void':
            for p in split_top(raw):
                p = p.strip()
                pm = re.match(r'(.*?[\s\*&])(\w+)$', p)
                params.append((pm.group(1).strip(), pm.group(2)))
        out[m.group(2)] = (' '.join(m.group(1).split()), params)
    return out


def header_order(header_text):
    """{interface: [method names in declaration order]} from a header's
    `abstract_class IShimX` blocks: the vtable order the C++ compiler lays out."""
    code = strip_comments(header_text)
    out = {}
    for m in re.finditer(r'abstract_class\s+(IShim\w+)[^{]*\{(.*?)\n\};', code, re.S):
        out[m.group(1)] = re.findall(r'virtual\s+[\w\s\*]+?\s*\b(\w+)\(', m.group(2))
    return out


def order_problems(header_texts=None):
    """The hand-kept headers' vtable order against docs/engineapi-areas.tsv's.

    THE SLOT COUNT AND THE MANAGED LAYOUT COME FROM THE TSV, THE VTABLE FROM
    THE HEADER. A row appended to the TSV after the last one but declared in
    the header elsewhere (or the reverse) compiles on both sides and is caught
    only when native acquires the area at load: lane c5-particles' first
    ParticlesMaterialVarInt build answered "SourceSharpParticlesClient001 has
    10 slot(s) and its generated layout needs 11". Every interface the TSV
    names (but the hand-written console and root) must be declared in one of
    the two headers with exactly its TSV slots, in its TSV order.
    """
    if header_texts is None:
        header_texts = [read(OUT_IFACE), read(OUT_IFACE_CLIENT) or '']
    declared = {}
    for text in header_texts:
        declared.update(header_order(text))
    tsv = {}
    for r in rows():
        i = r['interface']
        if i in HAND_WRITTEN:
            continue
        tsv.setdefault(i, []).append(r['slot'])
    problems = []
    for iface, slots in tsv.items():
        have = declared.get(iface)
        if have is None:
            problems.append('%s: no abstract_class in either header' % iface)
        elif have != slots:
            k = next((n for n, (a, b) in enumerate(zip(have, slots)) if a != b), min(len(have), len(slots)))
            problems.append('%s: the header declares %d slot(s), the TSV lists %d; first difference at slot %d '
                            '(header %s, TSV %s)' % (iface, len(have), len(slots), k,
                                                     have[k] if k < len(have) else '-',
                                                     slots[k] if k < len(slots) else '-'))
    return problems


def split_top(s):
    out, depth, cur = [], 0, ''
    for ch in s:
        if ch in '(<[':
            depth += 1
        elif ch in ')>]':
            depth -= 1
        if ch == ',' and depth == 0:
            out.append(cur)
            cur = ''
        else:
            cur += ch
    if cur.strip():
        out.append(cur)
    return out


def read_list(rel):
    path = os.path.join(ROOT, rel)
    if not os.path.exists(path):
        return set()
    with open(path) as f:
        return {l.strip() for l in f if l.strip() and not l.startswith('#')}


def switched():
    return read_list(SWITCHED)


def client_switched():
    return read_list(CLIENT_SWITCHED)


def rows():
    with open(os.path.join(ROOT, TSV)) as f:
        return [r for r in csv.DictReader(f, delimiter='\t') if r['struct'] == 'EngineApi']


def client_model():
    """plan_client_vtables CC: ([client-only interfaces in order], {iface: [slots]})."""
    order, slots = [], {}
    for r in rows():
        if r['kind'] != 'client':
            continue
        i = r['interface']
        if i not in slots:
            order.append(i)
            slots[i] = []
        slots[i].append(r['slot'])
    return order, slots


def model():
    """([interfaces in order], {iface: [slots]}, {iface: base}, [concrete])."""
    order, slots, base = [], {}, {}
    for r in rows():
        i = r['interface']
        if i in HAND_WRITTEN or r['kind'] == 'client':
            continue
        if i not in slots:
            order.append(i)
            slots[i] = []
            # A hand-written base (IShimConsole) is not extended here: the
            # extension stands alone, so no generated class implements it.
            base[i] = r['base'] if r['base'] and r['base'] not in HAND_WRITTEN else None
        slots[i].append(r['slot'])
    derived = {b for b in base.values() if b}
    concrete = [i for i in order if i not in derived]
    # bases before the classes that extend them
    order = [i for i in order if not base[i]] + [i for i in order if base[i]]
    return order, slots, base, concrete


def short(iface):
    return iface[len('IShim'):]


def field(iface):
    """The managed field an area is held in. short() but for IShimEngine, the
    shared base: a field named `Engine` read as the static class Engine to every
    `Engine.X` census (plan_abi_hotreload D8), so it is `EngineBase`."""
    name = short(iface)
    return 'EngineBase' if name == 'Engine' else name


def version(iface):
    return 'SourceSharp%s001' % short(iface)


def chain(iface, base):
    return ([base[iface]] if base[iface] else []) + [iface]


def decl(ret, name, params, suffix):
    ps = ', '.join('%s %s' % (t, n) for t, n in params) if params else ''
    return '%s %s( %s )%s' % (ret, name, ps, suffix) if ps else '%s %s()%s' % (ret, name, suffix)


def generate():
    sigs = iface_signatures(read(OUT_IFACE))
    sigs.update(iface_signatures(read(OUT_IFACE_CLIENT) or ''))
    client_only, client_slots = client_model()
    missing_client = [s for i in client_only for s in client_slots[i] if s not in sigs]
    if missing_client:
        raise SystemExit('tools/shim-areas: no declaration in %s for: %s'
                         % (OUT_IFACE_CLIENT, ', '.join(missing_client)))
    table = {r['slot']: r for r in rows()}
    fill = {s: r['body'] for s, r in table.items()}
    # plan_client_vtables CB: the client's body for a shared slot, where it differs.
    client_fill = {s: (r.get('client_body') or r['body']) for s, r in table.items()}
    order, slots, base, concrete = model()
    # The shared bases: the client implements each on its own (CB), served by
    # the client's shim root. Most are extended by a server area; one no server
    # area extends (IShimEvents, once plan_side_isolation P2 took its
    # user-message slot to IShimUserMessages) is the server's concrete class too.
    client_bases = [i for i in order if not base[i]
                    and all(table[s]['side'] == 'both' for s in slots[i])]
    valve = read(VALVE).rstrip('\n')

    missing = [s for i in order for s in slots[i] if s not in sigs or s not in fill]
    if missing:
        raise SystemExit('tools/shim-areas: no signature or server fill for: %s' % ', '.join(missing))

    # ---- the interfaces ------------------------------------------------------
    h = [valve, '', GENERATED, '//',
         '// plan_engineapi_vtables.md Phase C: every EngineApi slot the server fills,',
         '// as a slot of one of these interfaces, acquired from IShimRoot by the version',
         '// string beside it. Shared bases are what both DLLs will implement; each',
         '// extension appends the server-only slots of the same family. Rules as',
         '// ishim_frame.h: no virtual destructor, blittable arguments, APPEND-ONLY.',
         '', '#pragma once', '',
         '#include <stdint.h>', '#include "tier0/platform.h"', '#include "sourcesharp.h"', '']
    for i in order:
        h.append('#define SOURCESHARP_SHIM_%s_VERSION "%s"' % (short(i).upper(), version(i)))
    h.append('')
    for i in order:
        head = 'abstract_class %s' % i + (' : public %s' % base[i] if base[i] else '')
        h += [head, '{', 'public:']
        for s in slots[i]:
            ret, params = sigs[s]
            h.append('\tvirtual ' + decl(ret, s, params, ' = 0;'))
        h += ['};', '']
    h += ['']

    # ---- the server's concrete classes ----------------------------------------
    c = [valve, '', GENERATED, '//',
         '// The server\'s implementation of each bound interface in ishim_areas.h: one',
         '// class per interface managed binds, whose methods forward to the bodies the',
         '// struct slots are filled with (shell_shim_areas.inc). The shim root holds',
         '// CShimAreas by value, so the areas add one member to one static.',
         '', '#pragma once', '',
         '#include "ishim_areas.h"', '#include "ishim_areas_client.h"', '', '#ifndef CLIENT_DLL', '']
    for i in concrete:
        c += ['class CShim%s final : public %s' % (short(i), i), '{', 'public:']
        for ci in chain(i, base):
            for s in slots[ci]:
                ret, params = sigs[s]
                c.append('\t' + decl(ret, s, params, ' override;'))
        c += ['};', '']
    c += ['struct CShimAreas', '{']
    for i in concrete:
        c.append('\tCShim%s m_%s;' % (short(i), short(i)))
    c += ['};', '',
          '// The internal factory\'s rows for every interface above: the area and the',
          '// compiler\'s slot count for it, or NULL and 0. Defined in shell_shim_areas.inc.',
          'void *ShimAreas_Acquire( CShimAreas &areas, const char *pszName );',
          '', '#else // CLIENT_DLL', '',
          '// plan_client_vtables CB, CC: the client implements each shared base, and its',
          '// client-only areas, forwarding to the body each row of the slot table names.', '']
    for i in client_bases:
        c += ['class CShim%sClient final : public %s' % (short(i), i), '{', 'public:']
        for s in slots[i]:
            ret, params = sigs[s]
            c.append('\t' + decl(ret, s, params, ' override;'))
        c += ['};', '']
    for i in client_only:
        c += ['class CShim%s final : public %s' % (short(i), i), '{', 'public:']
        for s in client_slots[i]:
            ret, params = sigs[s]
            c.append('\t' + decl(ret, s, params, ' override;'))
        c += ['};', '']
    c += ['struct CShimAreasClient', '{']
    for i in client_bases:
        c.append('\tCShim%sClient m_%s;' % (short(i), short(i)))
    for i in client_only:
        c.append('\tCShim%s m_%s;' % (short(i), short(i)))
    c += ['};', '',
          '// The client factory\'s rows: each shared base by its own version string.',
          'void *ShimAreasClient_Acquire( CShimAreasClient &areas, const char *pszName );',
          '', '#endif // CLIENT_DLL', '', '']

    # ---- the forwards ------------------------------------------------------------
    im = [valve, '', GENERATED, '//',
          '// Included at the end of sourcesharp_gamesystem.cpp, server only, where every',
          '// body the struct is filled with -- the static ones too -- is in scope.', '']
    for i in concrete:
        for ci in chain(i, base):
            for s in slots[ci]:
                ret, params = sigs[s]
                args = ', '.join(n for _t, n in params)
                im.append(decl(ret, 'CShim%s::%s' % (short(i), s), params, ''))
                im.append('\t{ return ::%s(%s); }' % (fill[s], ' %s ' % args if args else ''))
        im.append('')
    im += ['void *ShimAreas_Acquire( CShimAreas &areas, const char *pszName )', '{',
           '\tif ( !pszName )', '\t\treturn NULL;', '']
    for i in concrete:
        im += ['\tif ( !ss::StrICmp( pszName, SOURCESHARP_SHIM_%s_VERSION ) )' % short(i).upper(),
               '\t\treturn static_cast< %s * >( &areas.m_%s );' % (i, short(i)), '']
    im += ['\treturn NULL;', '}', '']

    # ---- the client's forwards (plan_client_vtables CB) ----------------------
    cim = [valve, '', GENERATED, '//',
           '// plan_client_vtables CB, CC: the client\'s shim areas (its shared bases and',
           '// its client-only areas). Included at the end of sourcesharp_gamesystem.cpp,',
           '// client only; each forwards to the body its row in docs/engineapi-areas.tsv names.', '']
    for i in client_bases:
        for s in slots[i]:
            ret, params = sigs[s]
            args = ', '.join(n for _t, n in params)
            cim.append(decl(ret, 'CShim%sClient::%s' % (short(i), s), params, ''))
            cim.append('\t{ return ::%s(%s); }' % (client_fill[s], ' %s ' % args if args else ''))
        cim.append('')
    for i in client_only:
        for s in client_slots[i]:
            ret, params = sigs[s]
            args = ', '.join(n for _t, n in params)
            cim.append(decl(ret, 'CShim%s::%s' % (short(i), s), params, ''))
            cim.append('\t{ return ::%s(%s); }' % (fill[s], ' %s ' % args if args else ''))
        cim.append('')
    cim += ['void *ShimAreasClient_Acquire( CShimAreasClient &areas, const char *pszName )', '{',
            '\tif ( !pszName )', '\t\treturn NULL;', '']
    for i in client_bases + client_only:
        cim += ['\tif ( !ss::StrICmp( pszName, SOURCESHARP_SHIM_%s_VERSION ) )' % short(i).upper(),
                '\t\treturn static_cast< %s * >( &areas.m_%s );' % (i, short(i)), '']
    cim += ['\treturn NULL;', '}', '']

    # ---- the forwarder tables' counts ----------------------------------------------
    # Each area is called through its forwarder table (plan_forwarders_everywhere.md),
    # which tools/engine-forwarders generates from the same header: its count is
    # held to the compiler's for the interface, so a header walk that dropped or
    # doubled a slot is caught where the table is built.
    t = ['// ' + GENERATED[3:], '//',
         '// Included by fwd_shim_test.cpp: the compiler\'s count for each generated shim',
         '// interface, held to the forwarder table the server\'s library serves for it.', '']
    def table_test(name, i, last, n):
        return ['TEST( FwdShimAreas, %s )' % name, '{',
                '\tconst int compiler = VTableHook::MemberOf( &%s::%s ).slot + 1;' % (i, last),
                '\tEXPECT_EQ( %d, compiler );' % n,
                '\tconst SSForwarderTable *pTable = SSFwdServer_Table( "SSFwd_Shim%s" );' % short(i),
                '\tASSERT_NE( nullptr, pTable );',
                '\tEXPECT_EQ( compiler, pTable->nSlots );', '}', '']
    for i in concrete:
        n = sum(len(slots[ci]) for ci in chain(i, base))
        t += table_test('Shim%sIs%dSlots' % (short(i), n), i, slots[i][-1], n)
    for i in client_bases:
        n = len(slots[i])
        t += table_test('Shim%sIs%dSlotsOnTheClient' % (short(i), n), i, slots[i][-1], n)
    for i in client_only:
        n = len(client_slots[i])
        t += table_test('Shim%sIs%dSlots' % (short(i), n), i, client_slots[i][-1], n)

    # ---- the managed side: routing helpers and the bound areas --------------
    types = {}
    for s, r in table.items():
        parts = [x.strip() for x in split_top(r['managed'])]
        types[s] = (parts[:-1], parts[-1], r['suppress'] == 'S')
    live = switched()
    # The hand-written console (A4) is routed like a generated area on the
    # managed side: its native class already exists, so only the routing is
    # generated. The root is not an area.
    hand = {'IShimConsole': [r['slot'] for r in rows() if r['interface'] == 'IShimConsole']}
    routed = concrete + sorted(hand)
    def chain_of(i):
        return chain(i, base) if i in concrete else [i]
    def slots_of(ci):
        return slots[ci] if ci in slots else hand[ci]
    unknown = sorted(live - set(routed))
    if unknown:
        raise SystemExit('tools/shim-areas: %s lists %s, which %s not a bound interface'
                         % (SWITCHED, ', '.join(unknown), 'is' if len(unknown) == 1 else 'are'))
    owner = {s: i for i in routed for ci in chain_of(i) for s in slots_of(ci)}
    m = ['// ' + GENERATED[3:],
         '//',
         '// plan_shim_areas_split phase 2. One class per shim area, over its',
         '// forwarder table (plan_forwarders_everywhere.md), with one typed call',
         '// per slot it declares. A server area that extends a shared base derives',
         '// that base\'s class: its table starts with exactly the base\'s slots',
         '// (SharedForwarders.g.cs holds that field by field), so the base class',
         '// reads either side\'s table. Each side\'s registration acquires every',
         '// area of that side or none and hands them, by type, to the side\'s',
         '// registry; nothing holds them as a set. A consumer is given the areas',
         '// it calls in its constructor (plan_shim_areas_split phase 11). A',
         '// derived area is also registered as its shared base, so code compiled',
         '// into both sides asks for a both-sides area by the same type.',
         '',
         '#nullable enable',
         '',
         'namespace SourceSharp.Abi;',
         '',
         '/// <summary>',
         '/// One acquired shim area: its object and the forwarder table that calls',
         '/// it (<c>SSFwd_Shim&lt;Area&gt;</c>). Nothing is read through the object.',
         '/// </summary>',
         'internal readonly unsafe struct ShimRef<TFwd> where TFwd : unmanaged, IForwarderTable',
         '{',
         '    public readonly void* Self;',
         '    public readonly TFwd* Vt;',
         '',
         '    public ShimRef(void* self, TFwd* table) { Self = self; Vt = table; }',
         '',
         '    /// <summary>',
         '    /// The same object over the same table read as <typeparamref name="TBase"/>\'s:',
         '    /// a derived area\'s table starts with exactly its base\'s slots.',
         '    /// </summary>',
         '    public ShimRef<TBase> As<TBase>() where TBase : unmanaged, IForwarderTable',
         '        => new(Self, (TBase*)Vt);',
         '',
         '    /// <summary>',
         '    /// The table every typed call goes through. A detached area (what a side',
         '    /// registers before its attach, over no table) refuses here with the',
         '    /// reason rather than reading a null table. Nothing checks for the attach:',
         '    /// the game composes only after it, and a test with no engine is given',
         '    /// the default areas (src/test/support/ShimAreaDefaults.g.cs).',
         '    /// </summary>',
         '    public TFwd* Table',
         '    {',
         '        [System.Runtime.CompilerServices.MethodImpl(System.Runtime.CompilerServices.MethodImplOptions.AggressiveInlining)]',
         '        get',
         '        {',
         '            TFwd* table = Vt;',
         '            if (table == null)',
         '                Detached();',
         '            return table;',
         '        }',
         '    }',
         '',
         '    [System.Diagnostics.CodeAnalysis.DoesNotReturn]',
         '    [System.Runtime.CompilerServices.MethodImpl(System.Runtime.CompilerServices.MethodImplOptions.NoInlining)]',
         '    private static void Detached()',
         '        => throw new InvalidOperationException(',
         '            $"{TFwd.TableName} was called before the shim areas were attached");',
         '',
         '    /// <summary>',
         '    /// The area by its version string and its table by the table\'s name,',
         '    /// both from the shim root, the table held to the struct\'s count',
         '    /// (<see cref="Forwarders.TryBind"/>); false with the reason.',
         '    /// </summary>',
         '    public static bool TryTake(ShimRoot root, string version, out ShimRef<TFwd> area, out string why)',
         '    {',
         '        area = default;',
         '        void* self = root.Acquire(version);',
         '        if (self == null)',
         '        {',
         '            why = $"the shim root does not serve {version}";',
         '            return false;',
         '        }',
         '        var header = (ForwarderTableHeader*)root.Acquire(TFwd.TableName);',
         '        if (!Forwarders.TryBind(header, out TFwd* table, out why))',
         '        {',
         '            why = $"{version}: {why}";',
         '            return false;',
         '        }',
         '        area = new ShimRef<TFwd>(self, table);',
         '        return true;',
         '    }',
         '}',
         '']
    ptr = ('nint', 'IntPtr', 'nuint', 'UIntPtr')

    def params_of(ptypes):
        return ', '.join('%s a%d' % (ty, k) for k, ty in enumerate(ptypes))

    def typed(ret, ptypes, s):
        """A slot's typed call on its area class, through the class's own table."""
        vargs = ', '.join(('(void*)a%d' % k) if ty in ptr else 'a%d' % k
                          for k, ty in enumerate(ptypes))
        v = '_shim.Table->%s(_shim.Self%s)' % (s, (', ' + vargs) if vargs else '')
        if ret in ptr or (ret.endswith('*') and ret != 'void*'):
            v = '(%s)%s' % (ret, v)
        return '    public %s %s(%s) { %s%s; }' % (ret, s, params_of(ptypes),
                                                  '' if ret == 'void' else 'return ', v)

    def area(i):
        return short(i) + 'Area'

    def fwd(i):
        return 'Shim%sFwd' % short(i)

    # Every area class: the shared bases and the console (both sides), the
    # server's areas (deriving their base where they extend one), and the
    # client-only areas. A class is declared once, whichever side uses it.
    client_routed = client_bases + sorted(hand) + client_only
    extended = {base[i] for i in concrete if base[i]}
    classes = []
    for i in client_bases + sorted(hand) + concrete + client_only:
        if i not in classes:
            classes.append(i)

    def own_slots(i):
        if i in client_only:
            return client_slots[i]
        return slots_of(i)

    def iface(i):
        return 'I' + area(i)

    def slot_decl(ret, ptypes, s):
        return '    %s %s(%s);' % (ret, s, params_of(ptypes))

    for i in classes:
        b = base[i] if i in concrete else None
        sealed = '' if i in extended else 'sealed '
        # The area as its consumers see it: they take the interface, so a test
        # with no engine hands them the generated default instead
        # (plan_shim_areas_split phase 11 review).
        m += ['/// <summary>',
              '/// <c>%s</c> as its consumers take it: <see cref="%s"/> over the engine,' % (i, area(i)),
              '/// or a test\'s default (<c>Default%s</c>).' % area(i),
              '/// </summary>',
              'internal unsafe interface %s%s' % (iface(i), (' : %s' % iface(b)) if b else ''),
              '{']
        for s in own_slots(i):
            ptypes, ret, _sup = types[s]
            m.append(slot_decl(ret, ptypes, s))
        m += ['}', '']
        m += ['/// <summary>',
              '/// <c>%s</c>, served as <c>%s</c>, through <see cref="%s"/>.%s' % (
                  i, version(i), fwd(i),
                  (' Its base\'s slots are <see cref="%s"/>\'s.' % area(b)) if b else ''),
              '/// </summary>',
              'internal %sunsafe class %s : %s%s' % (sealed, area(i), ('%s, ' % area(b)) if b else '', iface(i)),
              '{',
              '    private readonly ShimRef<%s> _shim;' % fwd(i),
              '']
        if b:
            # The base's view of the same table is handed in (the registration
            # makes it with ShimRef.As), so the constructor only keeps what it
            # is given (plan_shim_areas_split phase 11 review).
            m += ['    internal %s(ShimRef<%s> shim, ShimRef<%s> asBase)' % (area(i), fwd(i), fwd(b)),
                  '        : base(asBase)',
                  '    {',
                  '        _shim = shim;',
                  '    }']
        else:
            m.append('    internal %s(ShimRef<%s> shim) { _shim = shim; }' % (area(i), fwd(i)))
        m.append('')
        for s in own_slots(i):
            ptypes, ret, _sup = types[s]
            m.append(typed(ret, ptypes, s))
        m += ['}', '']

    def registration(name, routed_here, doc, count):
        # No container: the areas are handed one by one, by type, to the
        # side's registry (plan_shim_areas_split phase 11), and each consumer
        # is given the areas it calls in its constructor. A derived area is
        # also handed under its shared base's type, so code compiled into both
        # sides asks for a both-sides area by the same type on either.
        def local(i):
            f = field(i)
            return f[0].lower() + f[1:] + 'Area'
        views = [i for i in routed_here if i in concrete and base[i]]
        out = ['/// <summary>'] + ['/// ' + l for l in doc] + ['/// </summary>',
               'internal static unsafe class %s' % name, '{',
               '    internal static int Count => %d;' % count, '',
               '    /// <summary>',
               '    /// Takes every area from the root, each with its table, and hands them',
               '    /// to <paramref name="add"/> only when all were taken: the first refused',
               '    /// stops the walk with its reason in <paramref name="why"/>, and nothing',
               '    /// is handed.',
               '    /// </summary>',
               '    internal static bool TryAcquire(ShimRoot root, Action<Type, object> add, out string why)',
               '    {']
        for i in routed_here:
            out.append('        if (!ShimRef<%s>.TryTake(root, "%s", out var %s, out why)) return false;'
                       % (fwd(i), version(i), local(i)))
        def made(i, ref):
            b = base[i] if i in concrete else None
            if not b:
                return 'new %s(%s)' % (area(i), ref)
            return 'new %s(%s, %s)' % (area(i), ref, ('%s.As<%s>()' % (ref, fwd(b))) if ref != 'default' else 'default')
        out += ['        Add(add,'] + ['            %s%s' % (made(i, local(i)), ',' if k + 1 < len(routed_here) else ');')
                                      for k, i in enumerate(routed_here)]
        out += [
                '        return true;',
                '    }',
                '',
                '    /// <summary>',
                '    /// Every area over no table: what a side registers before its attach,',
                '    /// so it can be made before the root is bound. A call throws, naming',
                '    /// the area; the game composes only after the attach.',
                '    /// </summary>',
                '    internal static void AddDetached(Action<Type, object> add)',
                '        => Add(add,']
        out += ['            %s%s' % (made(i, 'default'), ',' if k + 1 < len(routed_here) else ');')
                for k, i in enumerate(routed_here)]
        out += ['',
                '    private static void Add(Action<Type, object> add,']
        out += ['        %s %s%s' % (area(i), local(i), ',' if k + 1 < len(routed_here) else ')')
                for k, i in enumerate(routed_here)]
        out += ['    {']
        for i in routed_here:
            out.append('        add(typeof(%s), %s);' % (iface(i), local(i)))
        for i in views:
            out.append('        add(typeof(%s), %s);' % (iface(base[i]), local(i)))
        out += ['    }', '}', '']
        return out

    m += registration('ServerAreaRegistration', routed,
                      ['Every server area, acquired from the shim root by version string with',
                       'its forwarder table, which native must serve at no fewer slots than the',
                       'struct reads (the tables only append).'], len(concrete))
    m += registration('ClientAreaRegistration', client_routed,
                      ['plan_client_vtables CB: the client\'s areas, its shared bases and its',
                       'own, acquired from its shim root with the same span check.'], len(client_routed))

    clive = client_switched()
    unknown_client = sorted(clive - set(client_routed))
    if unknown_client:
        raise SystemExit('tools/shim-areas: %s lists %s, which the client does not implement'
                         % (CLIENT_SWITCHED, ', '.join(unknown_client)))
    # Each both-sides slot's shared base, for the client's typed call.
    client_owner = {s: i for i in client_routed if i not in client_only for s in slots_of(i)}
    # The router (ShimSlots) is retired (docs/todo.md): the typed methods are the
    # calls. What stays here is the census that every slot has a route: a
    # server-only slot's area must be switched, a shared slot's areas both, and a
    # client-only area switched on the client; anything else would emit a typed
    # call no side can serve.
    for i in routed:
        for ci in chain_of(i):
            for s in slots_of(ci):
                if s in table and table[s]['struct'] == 'EngineApi' and table[s]['side'] == 'server':
                    # C6c: no struct field. Served by its area or not at all.
                    if i not in live:
                        raise SystemExit('tools/shim-areas: %s is server-only and has no struct field, '
                                         'so %s must be listed in %s' % (s, i, SWITCHED))
                    continue
                cb = client_owner.get(s)
                if i not in live or cb not in clive:
                    raise SystemExit('tools/shim-areas: %s is a shared slot, so %s must be in %s and %s in %s'
                                     % (s, i, SWITCHED, cb, CLIENT_SWITCHED))
    for i in client_only:
        for s in client_slots[i]:
            if i not in clive:
                raise SystemExit('tools/shim-areas: %s is client-only, so %s must be in %s (there is no struct)'
                                 % (s, i, CLIENT_SWITCHED))

    # THE DEFAULT AREAS, for tests (plan_shim_areas_split phase 11 review: the
    # user's ruling that tests get generated doubles of the interfaces that
    # answer good defaults, and managed logic never checks for an attach or a
    # null interface). Compiled into the test support assemblies only.
    # A slot whose zero means something (entity handle 0 is the world, index
    # 0 the first) answers what "nothing" is instead: what the attach guards
    # these defaults replace answered.
    nothing = {
        'GetCommandClientHandle': '0xFFFFFFFFu',
        'FindEntityByClassname': '0xFFFFFFFFu', 'CreateEntity': '0xFFFFFFFFu',
        'MapSpawnCreate': '0xFFFFFFFFu', 'EntityGetParent': '0xFFFFFFFFu',
        'GetPlayerHandle': '0xFFFFFFFFu', 'BeamEntityAt': '0xFFFFFFFFu',
        'EntityGetIndex': '-1', 'FxHandleEntityIndex': '-1',
        'RegisterConCommand': '-1', 'RegisterConVar': '-1',
        # -1 is "the engine defines no such convar": a 0 would claim every
        # managed declaration as the engine's (ConVarRegistry's alias check).
        'FindConVarFlags': '-1',
    }
    unknown_nothing = sorted(set(nothing) - set(types))
    if unknown_nothing:
        raise SystemExit('tools/shim-areas: defaults name slots that do not exist: %s' % ', '.join(unknown_nothing))

    def default_value(ret, s):
        if s in nothing:
            return nothing[s]
        return 'default'

    def default_slot(ret, ptypes, s):
        if ret == 'void':
            return '    public void %s(%s) { }' % (s, params_of(ptypes))
        return '    public %s %s(%s) => %s;' % (ret, s, params_of(ptypes), default_value(ret, s))

    d = ['// ' + GENERATED[3:],
         '//',
         '// plan_shim_areas_split phase 11 review. One default per shim area',
         '// interface, for a test with no engine: every call answers its type\'s',
         '// default (zero, false, a null pointer: no text) and writes',
         '// nothing through the pointers it is handed, which the callers allocate',
         '// zeroed. A derived area\'s default derives its base\'s, as the areas do.',
         '// Each side\'s defaults are handed, by interface, as its registration',
         '// hands the real areas, so a test side composes exactly as the game\'s.',
         '',
         '#nullable enable',
         '',
         'namespace SourceSharp.Abi;',
         '']
    for i in classes:
        b = base[i] if i in concrete else None
        sealed = '' if i in extended else 'sealed '
        d += ['/// <summary><see cref="%s"/> for a test with no engine: every call answers its default.</summary>' % iface(i),
              'internal %sunsafe class Default%s : %s%s' % (sealed, area(i), ('Default%s, ' % area(b)) if b else '', iface(i)),
              '{']
        for s in own_slots(i):
            ptypes, ret, _sup = types[s]
            d.append(default_slot(ret, ptypes, s))
        d += ['}', '']

    def defaults_of(name, routed_here, side):
        views = [i for i in routed_here if i in concrete and base[i]]
        out = ['/// <summary>',
               '/// The %s\'s default areas, handed by interface as <c>%s</c>' % (side, name.replace('Defaults', 'Registration')),
               '/// hands the real ones (a derived area also as its shared base).',
               '/// </summary>',
               'internal static class %s' % name, '{',
               '    internal static void AddTo(Action<Type, object> add)',
               '    {']
        for i in routed_here:
            out.append('        var %s = new Default%s();' % (field(i)[0].lower() + field(i)[1:] + 'Area', area(i)))
        for i in routed_here:
            out.append('        add(typeof(%s), %s);' % (iface(i), field(i)[0].lower() + field(i)[1:] + 'Area'))
        for i in views:
            out.append('        add(typeof(%s), %s);' % (iface(base[i]), field(i)[0].lower() + field(i)[1:] + 'Area'))
        out += ['    }', '}', '']
        return out

    d += ['/// <summary>',
          '/// The slots whose default is "nothing" (-1, the invalid handle) rather than',
          '/// zero, by name: what a fake root\'s unserved slot answers for them too.',
          '/// </summary>',
          'internal static class ShimAreaNothingSlots',
          '{',
          '    public static bool Contains(string slot) => slot is %s;' % ' or '.join('"%s"' % n for n in sorted(nothing)),
          '}',
          '']
    d += defaults_of('ServerAreaDefaults', routed, 'server')
    d += defaults_of('ClientAreaDefaults', client_routed, 'client')

    # OUT_IFACE is not written since C6a: it is the hand-maintained contract
    # the rest is generated from (h is kept only to validate the table).
    return {OUT_CLASSES: '\n'.join(c),
            OUT_IMPL: '\n'.join(im), OUT_IMPL_CLIENT: '\n'.join(cim), OUT_TEST: '\n'.join(t), OUT_MANAGED: '\n'.join(m),
            OUT_DEFAULTS: '\n'.join(d)}



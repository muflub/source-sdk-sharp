GAME_DIR = os.path.join(ROOT, "bin", CONFIG)
MOD_DIR = os.path.join(GAME_DIR, "mods", "test")

def launch_command(mod_dir):
    """source#, run from the game directory. No -game: it takes the mod from
    mods.yaml beside it, so every launch proves the file supplies it. `#` is
    quoted, so no shell reads it as a comment (tools/launcher-name-test)."""
    return "./'source#'"
SOCKET_DIR = os.environ.get("DEBUG_API_DIR", "/tmp/sourcesharp-debug-api")
CONSOLE = os.path.join(MOD_DIR, "console.log")

LAUNCH = ["-debugapi", "-debugapisocket", "-condebug", "-nomessagebox",
          "-nocrashdialog", "-assertlog", "-insecure", "-novid", "-windowed",
          "-w", "640", "-h", "480", "-maxplayers", "2",
          ] + local_launch.local_args() + ["+map", "dm_lockdown"]

# The same open floor tools/7c-view-gate uses: room around the player, so the
# 400-unit walk below does not end inside a wall and get clipped -- which would
# read as a particle system that failed to follow.
START = (-3843.0, 2894.0, 0.0)
MOVE = (-3443.0, 2894.0, 0.0)      # +400 units on x, in the open

#     this one.
#
# They are 2,220 units apart, which is also what the shell-less sound check
# below needs: the same entity emitting the same script is audible from one and
# not from the other.
SPOT_NEAR = (-3667.0, 3439.0, 12.0)     # env_soundscape prison.hall_with_burrows, 4 units
SPOT_FAR  = (-4067.0, 5622.0, 12.0)     # env_soundscape prison.larger_cellblock_lightcombat, 3 units

# A SHELL-LESS entity of dm_lockdown's own -- an info_target, which is a
# [ScriptedEntity] of the default kind Logical and so has no edict, no entity

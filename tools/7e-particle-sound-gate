#
# NAMED rather than picked by class on purpose: `playentitysound <script>
# info_target` emits from all eight of them at once, and eight traces whose
# recipient counts happen to agree would read as a pass for an implementation
# that emitted every one of them from the same fixed point.
SHELLLESS_ENTITY = "burrow_2_sound"

# A soundscript the map's own doors precache, so the emit is not measuring a
# missing precache. Step 4b used this one for the same reason.
EMIT_SCRIPT = "Doors.Move18"

FAILURES = []
UNPROVEN = []
NOTES = []


def check(name, ok, detail):
    print("  %-46s %s   %s" % (name, "PASS" if ok else "FAIL", detail))
    if not ok:
        FAILURES.append(name)
    return ok


def unproven(name, detail):
    """A check this harness could not REACH, as distinct from one that failed.

    The distinction is the whole difference between "the port is broken" and
    "this gate cannot see". Both keep the gate red -- an unmet gate is unmet --
    but only one of them is a bug report, and a run that printed FAIL for both
    would file the harness's limits as the port's defects. That is the mistake
    this project has already made in the other direction ("the live gate's
    failures were being misattributed"), so it is a separate word here.
    """
    print("  %-46s %s  %s" % (name, "UNPRV", detail))
    UNPROVEN.append(name)


def live_sockets():
    if not os.path.isdir(SOCKET_DIR):
        return []
    out = []
    for name in os.listdir(SOCKET_DIR):
        if not name.endswith(".sock"):
            continue
        try:
            os.kill(int(name[:-5]), 0)
        except (OSError, ValueError):
            continue
        out.append(os.path.join(SOCKET_DIR, name))
    return out


def debug_api(pid, *args):
    env = dict(os.environ, DEBUG_API_PID=str(pid), DEBUG_API_DIR=SOCKET_DIR)
    r = subprocess.run([os.path.join(ROOT, "tools", "debug-api")] + list(args),
                       capture_output=True, text=True, env=env, timeout=120)
    return r.stdout


def console():
    try:
        with open(CONSOLE, "r", errors="replace") as fh:
            return fh.read()
    except IOError:
        return ""


def tail_after(marker):
    """Everything the console said after the LAST occurrence of marker.

    Every report below is asked for several times and a whole-log search would
    answer with the first run's numbers every time. 7c's gate learned this the
    same way.
    """
    text = console()
    i = text.rfind(marker)
    return text[i:] if i >= 0 else ""


def particle_report(pid, entindex=None):
    """[(name, particles, cp0, cp1, sort)] for every live particle system.

    With entindex, the client's own origin for that entity is printed beside the
    report and is available from client_origin() afterwards. That is the other
    half of the follow verdict: see the command's own note in particlemgr.cpp.
    """
    debug_api(pid, "cmd", "cs_cl_particle_report"
                       + ("" if entindex is None else " %d" % entindex))
    time.sleep(1.0)
    text = tail_after("[SourceSharp] particle report:")
    # The summary line is printed LAST, so rfind lands past every system line.
    # Take the block that ENDS at that summary instead: everything after the
    # previous summary.
    whole = console()
    end = whole.rfind("[SourceSharp] particle report:")
    if end < 0:
        return []
    prev = whole.rfind("[SourceSharp] particle report:", 0, end)
    block = whole[prev + 1:end] if prev >= 0 else whole[:end]
    out = []
    for m in re.finditer(
            r"particle system: name '([^']*)' particles (\d+) "
            r"cp0 \((-?[\d.]+) (-?[\d.]+) (-?[\d.]+)\) "
            r"cp1 \((-?[\d.]+) (-?[\d.]+) (-?[\d.]+)\) "
            r"sort \((-?[\d.]+) (-?[\d.]+) (-?[\d.]+)\)", block):
        g = m.groups()
        out.append((g[0], int(g[1]),
                    tuple(float(x) for x in g[2:5]),
                    tuple(float(x) for x in g[5:8]),
                    tuple(float(x) for x in g[8:11])))
    _ = text
    return out


def client_origin():
    """The last `cs_cl_particle_report <index>` line, as three floats."""
    text = tail_after("[SourceSharp] client entity ")
    m = re.search(r"client entity \d+: origin \((-?[\d.]+) (-?[\d.]+) (-?[\d.]+)\)", text)
    if not m:
        return None
    return tuple(float(m.group(i)) for i in (1, 2, 3))


def soundscape_report(pid):
    """(parsed, current, name, looping, random, pushed, forced) or None."""
    debug_api(pid, "cmd", "cs_cl_soundscape_report")
    time.sleep(1.0)
    text = tail_after("[SourceSharp] soundscape report:")
    m = re.search(r"soundscape report: parsed (\d+) current (-?\d+) \[([^\]]*)\] "
                  r"looping (\d+) random (\d+) pushed (\d+) forced (-?\d+)", text)
    if not m:
        return None
    return (int(m.group(1)), int(m.group(2)), m.group(3),
            int(m.group(4)), int(m.group(5)), int(m.group(6)), int(m.group(7)))


def server_soundscape_report(pid):
    """(registered, id, index, name) the SERVER chose for player 1, or None.

    plan_entity.md step 8e-sound. The CLIENT's report alone cannot say whether
    soundscapes change on ENTRY: a client that has latched onto a
    `playsoundscape` answers "current 248 [labs_mp]" perfectly while the
    transport is still missing, which is the state step 7e measured. Both ends,
    compared, is the only reading that means the wire carried something.
    """
    debug_api(pid, "cmd", "cs_sv_soundscape_report")
    time.sleep(1.0)
    text = tail_after("[SourceSharp] server soundscape report:")
    m = re.search(r"server soundscape report: registered (\d+) player \d+ "
                  r"id (-?\d+) index (-?\d+) \[([^\]]*)\]", text)
    if not m:
        return None
    return (int(m.group(1)), int(m.group(2)), int(m.group(3)), m.group(4))


def native_reach(pid):
    """logical.nativeReach -- step 2e's engine-invisible-range counter.

    It counts handles from the shell-less half that reached NATIVE and did not
    resolve. Step 4b measured the shell-less sound defect with it: one emit from
    a shell-less entity moved it 24 -> 25 while three from shelled func_doors
    left it at 24. So it is the second, independent reading on the same defect,
    and it is the one that cannot be satisfied by a sound that plays for some
    other reason.
    """
    out = debug_api(pid, "status")
    m = re.search(r'"logical":\s*\{[^}]*"nativeReach":\s*(-?\d+)', out)
    return int(m.group(1)) if m else None


def ents(pid, klass):
    """[(handle, index, origin)] for every live entity of that class."""
    out = debug_api(pid, "ents", klass)
    found = []
    for m in re.finditer(r'\{"handle":(\d+),"index":(-?\d+),"classname":"[^"]*",'
                         r'"health":-?\d+,"origin":\[(-?[\d.eE+-]+),(-?[\d.eE+-]+),(-?[\d.eE+-]+)\]',
                         out.replace(" ", "")):
        found.append((int(m.group(1)), int(m.group(2)),
                      tuple(float(m.group(i)) for i in (3, 4, 5))))
    return found


def emit_traces(text):
    """[(script, wave, entindex, recipients)] out of sv_soundemitter_trace output."""
    return [(m.group(1), m.group(2), int(m.group(3)), int(m.group(4)))
            for m in re.finditer(
                r"EmitSound:  '([^']*)' emitted as '([^']*)' "
                r"\(ent (-?\d+), (\d+) recipients\)", text)]


def dist(a, b):
    return math.sqrt(sum((a[i] - b[i]) ** 2 for i in range(3)))


def fire_systems(systems):
    """ss_firesmoke's own systems, by name.

    Matched on the "env_fire" prefix FireParticleNames.ForBucket produces, and
    NOT on "the only system present": dm_lockdown can carry particle systems of
    its own and a check that assumed one would measure the map's rather than the
    subject's. The gate prints the whole list in its notes either way.
    """
    return [s for s in systems if s[0].lower().startswith("env_fire")]


def entity_index(pid, klass):
    """The SERVER's entity index for the first live entity of that class."""
    out = debug_api(pid, "ents", klass)
    m = re.search(r'"index":\s*(-?\d+)', out)
    return int(m.group(1)) if m else None


def entity_origin(pid, klass):
    """The SERVER's origin for the first live entity of that class, or None.

    Read from `debug-api ents`, which answers from the server's own entity list, so
    the follow check compares the client's control point against a number the
    other side stated rather than against one this harness assumed.
    """
    out = debug_api(pid, "ents", klass)
    m = re.search(r'"origin":\s*\[\s*(-?[\d.]+),\s*(-?[\d.]+),\s*(-?[\d.]+)\s*\]', out)
    if not m:
        return None
    return tuple(float(m.group(i)) for i in (1, 2, 3))


def count_games():
    # `pgrep -c` prints 0 AND exits 1, so a shell `|| echo 0` emits TWO zeroes.
    r = subprocess.run(["pgrep", "-x", "hl2_linux64"], capture_output=True, text=True)
    return str(len([l for l in r.stdout.split("\n") if l.strip()]))


def setpos(pid, xyz):
    """Move the player, retried: setpos is a player command and the console
    answers "no player issued that" -- silently, from here -- while the local
    player is still arriving."""
    for _ in range(15):
        before = console().count("no player issued that")
        debug_api(pid, "cmd", "setpos %.0f %.0f %.0f" % xyz)
        time.sleep(1.0)
        if console().count("no player issued that") == before:
            return True
    return False


def main():
    tmpdir = "/tmp/ss-7e-gate"
    os.makedirs(tmpdir, exist_ok=True)
    os.makedirs(SOCKET_DIR, exist_ok=True)
    if os.path.exists(CONSOLE):
        os.remove(CONSOLE)

    print("box before: hl2_linux64 %s, free -g:" % count_games())
    subprocess.run(["free", "-g"])

    known = set(live_sockets())
    quoted = " ".join("'%s'" % a for a in LAUNCH)
    line = (". '%s/tools/gpu-offload'; cd '%s' && exec %s %s"
            % (ROOT, GAME_DIR, launch_command(MOD_DIR), quoted))
    log = open(os.path.join(tmpdir, "launch.log"), "wb")
    popen = subprocess.Popen(["bash", "-c", line], stdout=log,
                             stderr=subprocess.STDOUT,
                             env=dict(os.environ, TMPDIR=tmpdir),
                             start_new_session=True)

    pid = None
    deadline = time.time() + 240
    while time.time() < deadline:
        fresh = [s for s in live_sockets() if s not in known]
        if fresh:
            pid = int(os.path.basename(fresh[0])[:-5])
            break
        if popen.poll() is not None:
            break
        time.sleep(1.0)

    if pid is None:
        try:
            os.killpg(os.getpgid(popen.pid), signal.SIGKILL)
        except OSError:
            pass
        print("no socket appeared; the game never came up")
        return 2

    try:
        print("game pid %d" % pid)
        for _ in range(60):
            if "ss_player" in debug_api(pid, "ents", "ss_player"):
                break
            time.sleep(1.0)

        debug_api(pid, "cmd", "sv_cheats 1")
        time.sleep(0.5)
        setpos(pid, START)
        time.sleep(1.5)
        # FACING A FIXED WAY, because ent_create puts the fire where the
        # player aims and the player spawns at a random yaw. Facing +x it lands
        # on a wall face 963 units off (-2880, 2894, 92), and the 400-unit move
        # then puts its point-sized bounds inside the wall: CheckTransmit's
        # CheckBoxInPVS never passes, the server stops sending it, and "the
        # CLIENT saw the move" read 0 (2 of 11 runs, 2026-10-11; the transmit
        # set lacked the fire with the player 320 units from it). Facing -y it
        # lands in the open at (-3843, 2240) and the move stays in the open.
        debug_api(pid, "cmd", "setang 0 270 0")
        time.sleep(1.0)

        # -----------------------------------------------------------------
        # THE PARTICLE HALF
        # -----------------------------------------------------------------
        before = particle_report(pid)
        NOTES.append("particle systems before: %d (%s)"
                     % (len(before), ", ".join(s[0] for s in before)[:180]))

        debug_api(pid, "cmd", "ent_create ss_firesmoke targetname ss7efire")
        time.sleep(2.0)
        NOTES.append("ents ss_firesmoke: " + " ".join(
            debug_api(pid, "ents", "ss_firesmoke").split())[:300])
        NOTES.append("client firesmoke line(s): %d"
                     % console().count("[SourceSharp/Client] ss_firesmoke:"))

        # WHERE THE FIRE IS, from the SERVER, so the control-point check below
        # compares against a measured origin rather than against where the
        # harness hoped ent_create would put it (it spawns at the player's aim,
        # not at the player).
        fire_a = entity_origin(pid, "ss_firesmoke")
        fire_index = entity_index(pid, "ss_firesmoke")
        NOTES.append("firesmoke: server origin %s, entity index %s"
                     % (fire_a, fire_index))

        lit = []
        for _ in range(10):
            lit = fire_systems(particle_report(pid, fire_index))
            if lit and max(s[1] for s in lit) > 0:
                break
            time.sleep(1.0)

        check("a managed entity starts a particle system",
              len(lit) > 0,
              "%d fire system(s) after the create, %d before"
              % (len(lit), len(fire_systems(before))))

        drawing0 = max([s[1] for s in lit], default=0)
        check("and it DRAWS -- a live particle count",
              drawing0 > 0,
              "%d active particles across the collection and its children; "
              "zero is a system that follows perfectly and shows nothing"
              % drawing0)

        cp0_a = lit[0][2] if lit else None
        sort_a = lit[0][4] if lit else None
        cli_a = client_origin()
        NOTES.append("client-side firesmoke origin before the move: %s" % (cli_a,))

        check("control point 0 is at the entity, not the map origin",
              cp0_a is not None and fire_a is not None
              and dist(cp0_a, fire_a) < 64.0,
              "cp0 %s against the entity at %s (%.1f units apart)"
              % (cp0_a, fire_a,
                 dist(cp0_a, fire_a) if (cp0_a and fire_a) else -1))

        # ---- THE MOVE, by a known distance ---------------------------------
        if fire_a is None:
            fire_b_want = None
        else:
            fire_b_want = (fire_a[0] + MOVE_DISTANCE, fire_a[1], fire_a[2])
            NOTES.append("ent_keyvalue origin: " + " ".join(debug_api(
                pid, "cmd",
                'ent_keyvalue ss_firesmoke origin "%.0f %.0f %.0f"' % fire_b_want
            ).split())[:200])
        time.sleep(2.5)

        fire_b = entity_origin(pid, "ss_firesmoke")
        NOTES.append("firesmoke origin after the move: %s" % (fire_b,))

        server_moved = dist(fire_a, fire_b) if (fire_a and fire_b) else -1.0
        check("the harness actually MOVED the entity",
              server_moved > MOVE_DISTANCE * 0.8,
              "the server says the entity moved %.1f units. A zero here is a "
              "broken harness, not a broken follow, and the checks below would "
              "pass vacuously without it" % server_moved)

        after = fire_systems(particle_report(pid, fire_index))
        cli_b = client_origin()
        NOTES.append("client-side firesmoke origin after the move: %s" % (cli_b,))

        # THE HALF OF THE VERDICT THAT DID NOT EXIST ON RUN 3. A control point
        # that did not move means the sweep is broken ONLY IF the client's own
        # copy of the entity moved. If it did not, the harness moved the
        # server's copy alone and the control point is correct.
        client_moved = dist(cli_a, cli_b) if (cli_a and cli_b) else -1.0
        check("the CLIENT saw the move",
              client_moved > MOVE_DISTANCE * 0.8,
              "the client's own copy of the entity moved %.1f units against the "
              "server's %.1f. Without this the follow check below cannot tell a "
              "broken sweep from a move that never networked."
              % (client_moved, server_moved))

        cp0_b = after[0][2] if after else None
        sort_b = after[0][4] if after else None
        drawing1 = max([s[1] for s in after], default=0)

        moved = dist(cp0_a, cp0_b) if (cp0_a and cp0_b) else -1.0
        movedS = dist(sort_a, sort_b) if (sort_a and sort_b) else -1.0

        if client_moved > MOVE_DISTANCE * 0.8:
            check("the system FOLLOWED the handle",
                  cp0_b is not None and fire_b is not None
                  and dist(cp0_b, fire_b) < 64.0 and moved > MOVE_DISTANCE * 0.8,
                  "cp0 moved %.1f units against the entity's %.1f, and now reads "
                  "%s against the entity at %s"
                  % (moved, server_moved, cp0_b, fire_b))
            check("the sort origin followed",
                  movedS > MOVE_DISTANCE * 0.8,
                  "sort origin moved %.1f units; the client leaf system sorts "
                  "and culls by this, so a stale one is culled where it used to "
                  "be" % movedS)
        else:
            # NOT "FAIL". The control point sitting still is the CORRECT answer
            # when the client's own copy of the entity sat still, and calling
            # that a port defect would file this harness's limits as the port's
            # bugs. cp0 moved %.1f units and so did the entity, on this side.
            unproven("the system FOLLOWED the handle",
                     "the client's entity did not move, so cp0 staying at %s is "
                     "correct rather than wrong. cp0 moved %.1f units, the "
                     "client's entity %.1f. THIS GATE CANNOT REACH A VERDICT "
                     "until something moves a particle-owning managed entity in "
                     "a way the client sees."
                     % (cp0_b, moved, client_moved))
            unproven("the sort origin followed",
                     "same reason; sort origin moved %.1f units" % movedS)

        check("and it is STILL drawing after the move",
              drawing1 > 0,
              "%d active particles after the move, %d before"
              % (drawing1, drawing0))

        # THE FLAME THAT DOES NOT DRAW, measured in the same run rather than
        # asserted from the last one. See the module docstring: this is a defect
        # 7e found and does not own, and it is pinned here so it cannot be lost.
        debug_api(pid, "cmd", "ent_setname ss7evictim ss_player")
        time.sleep(0.6)
        debug_api(pid, "cmd", "ent_create env_entity_igniter targetname ss7eigniter "
                           "target ss7evictim lifetime 60")
        time.sleep(1.0)
        debug_api(pid, "fire", "env_entity_igniter", "Ignite")
        time.sleep(3.0)
        srv_flame = " ".join(debug_api(pid, "ents", "ss_entityflame").split())
        NOTES.append("ents ss_entityflame (SERVER): " + srv_flame[:240])
        cli_flame = console().count("[SourceSharp/Client] ss_entityflame:")
        NOTES.append("client flame spawn line(s): %d" % cli_flame)
        check("KNOWN GAP: the flame's client half never spawns",
              '"count":1' in srv_flame and cli_flame == 0,
              "the server has the flame and the client logged %d spawn line(s). "
              "If this check FAILS because the client now spawns it, the gap "
              "closed -- turn this into an assertion that it draws."
              % cli_flame)

        # -----------------------------------------------------------------
        # THE SOUND HALF
        # -----------------------------------------------------------------
        r0 = soundscape_report(pid)
        NOTES.append("soundscape report at rest: %s" % (r0,))

        check("the map parses soundscapes at all",
              r0 is not None and r0[0] > 0,
              "%d parsed; zero would make every check below vacuous"
              % (r0[0] if r0 else -1))

        # -----------------------------------------------------------------
        # plan_entity.md step 8e-sound, DEFECT 2 -- SOUNDSCAPES CHANGE ON ENTRY.
        #
        # THIS BLOCK REPLACED THE OPPOSITE ASSERTION, and the replacement is the
        # point. Step 7e's gate asserted "NO soundscape is current at rest" and
        # "the refusal IS printed", because at 325e8f137 both ends of the
        # mechanism were present and there was no wire between them. Its own
        # note said what to do the day somebody wired it: "turn it into an
        # assertion that entering a trigger_soundscape changes it". That is
        # what these are.
        #
        # BOTH ENDS, COMPARED, IS THE WHOLE DESIGN OF THE CHECK. The client's
        # report alone cannot tell "the server decided and the client followed"
        # from "the client latched onto a playsoundscape", which is exactly the
        # state 7e measured -- so every clause below reads the SERVER's choice
        # and the CLIENT's answer in the same breath and requires them to
        # agree.
        # -----------------------------------------------------------------
        setpos(pid, SPOT_NEAR)
        time.sleep(3.0)

        sv_a = server_soundscape_report(pid)
        r_near = soundscape_report(pid)
        NOTES.append("at SPOT_NEAR: server %s, client %s" % (sv_a, r_near))

        check("the SERVER chooses a soundscape for a player standing in one",
              sv_a is not None and sv_a[1] > 0 and sv_a[2] >= 0,
              "server id %s index %s [%s] of %s registered; a zero id is a "
              "server that decided nothing, and every clause below would then "
              "be measuring the client alone"
              % (sv_a[1] if sv_a else "?", sv_a[2] if sv_a else "?",
                 sv_a[3] if sv_a else "?", sv_a[0] if sv_a else "?"))

        check("and the CLIENT is playing exactly that one",
              r_near is not None and sv_a is not None and r_near[1] == sv_a[2],
              "client current %d [%s], server chose index %d [%s]"
              % (r_near[1] if r_near else -99, r_near[2] if r_near else "?",
                 sv_a[2] if sv_a else -99, sv_a[3] if sv_a else "?"))

        check("and it is actually PLAYING, not merely selected",
              r_near is not None and r_near[3] > 0,
              "%d looping sound(s); zero is a soundscape that was chosen, "
              "networked and then made no noise" % (r_near[3] if r_near else -1))

        # THE REFUSAL, IN THE DIRECTION IT WAS BUILT TO FAIL IN.
        #
        # shell_soundscape_client.cpp used to print, once per level on a map
        # that parses any soundscapes, "N parsed and NONE can be entered". 7e
        # wrote it so that wiring the transport would stop it. It is gone from
        # the source now rather than merely silent -- a refusal whose subject is
        # fixed is a lie that goes on excusing something -- and this is the
        # reading that says so in a running game.
        refusals = console().count("parsed and NONE can be entered")
        check("7e's printed refusal has STOPPED",
              refusals == 0,
              "%d refusal line(s) in the console on a map with %d soundscapes "
              "parsed" % (refusals, r_near[0] if r_near else -1))

        # -----------------------------------------------------------------
        # DEFECT 1 -- A SHELL-LESS ENTITY'S SOUND, HEARD AT ITS OWN POSITION.
        #
        # Step 4b measured this defect with two numbers and both are read here.
        # The TRACE says the emit happened at all: three shelled func_doors gave
        # three `EmitSound:` lines and one shell-less info_target gave zero. The
        # RECIPIENT COUNT beside it -- which 4b put in that trace for exactly
        # this reason -- says somebody could hear it, and an empty filter is the
        # failure mode of every change to how a source position is worked out.
        # -----------------------------------------------------------------
        debug_api(pid, "cmd", "sv_soundemitter_trace 1")
        time.sleep(0.5)

        reach_before = native_reach(pid)
        mark = len(console())
        debug_api(pid, "cmd", "playentitysound %s %s" % (EMIT_SCRIPT, SHELLLESS_ENTITY))
        time.sleep(2.0)
        near_traces = emit_traces(console()[mark:])
        reach_after = native_reach(pid)
        NOTES.append("shell-less emit from SPOT_NEAR: traces %s, nativeReach %s -> %s"
                     % (near_traces, reach_before, reach_after))

        check("a SHELL-LESS entity's sound is emitted at all",
              len(near_traces) >= 1,
              "%d EmitSound: trace(s) for one emit from '%s'; step 4b measured "
              "ZERO here and three for shelled doors"
              % (len(near_traces), SHELLLESS_ENTITY))

        check("and somebody can HEAR it -- a live recipient count",
              len(near_traces) >= 1 and max(t[3] for t in near_traces) >= 1,
              "%s recipients standing %d units away; zero is a sound that was "
              "emitted into an empty filter, which is what an emit at the map "
              "origin looks like from here"
              % (max(t[3] for t in near_traces) if near_traces else -1, 144))

        # THE COUNTER THAT SAYS IT NEVER CROSSED. Step 2e's invisible-range
        # counter moved 24 -> 25 for step 4b's one shell-less emit and stayed
        # flat for three shelled ones. A fix that routed the sound in managed
        # code leaves it flat; a fix that carried the point across a new slot
        # would move it, and would be a different design.
        check("and the emit no longer falls into the native resolve",
              reach_before is not None and reach_after == reach_before,
              "logical.nativeReach %s -> %s across the emit"
              % (reach_before, reach_after))

        # -----------------------------------------------------------------
        # WALK AWAY, and read both defects again from the far end.
        # -----------------------------------------------------------------
        setpos(pid, SPOT_FAR)
        time.sleep(3.0)

        sv_b = server_soundscape_report(pid)
        r_far = soundscape_report(pid)
        NOTES.append("at SPOT_FAR: server %s, client %s" % (sv_b, r_far))

        check("the soundscape CHANGES when the player enters another one",
              sv_a is not None and sv_b is not None and sv_b[1] > 0
              and sv_b[2] != sv_a[2],
              "server chose index %s [%s] here, was %s [%s] there"
              % (sv_b[2] if sv_b else "?", sv_b[3] if sv_b else "?",
                 sv_a[2] if sv_a else "?", sv_a[3] if sv_a else "?"))

        check("and the client FOLLOWED the change",
              r_far is not None and sv_b is not None and r_far[1] == sv_b[2]
              and r_near is not None and r_far[1] != r_near[1],
              "client current %d [%s], was %d [%s]; server chose %d"
              % (r_far[1] if r_far else -99, r_far[2] if r_far else "?",
                 r_near[1] if r_near else -99, r_near[2] if r_near else "?",
                 sv_b[2] if sv_b else -99))

        mark = len(console())
        debug_api(pid, "cmd", "playentitysound %s %s" % (EMIT_SCRIPT, SHELLLESS_ENTITY))
        time.sleep(2.0)
        far_traces = emit_traces(console()[mark:])
        debug_api(pid, "cmd", "sv_soundemitter_trace 0")
        NOTES.append("shell-less emit from SPOT_FAR: traces %s" % (far_traces,))

        # THE CLAUSE THAT MAKES THE ONE ABOVE MEAN "AT ITS OWN POSITION".
        #
        # Same entity, same script, same emit -- and the player is now 2,190
        # units away instead of 144. An implementation that emitted every
        # shell-less sound from one fixed point would give the SAME recipient
        # count both times and pass the check above; this one it cannot pass.
        check("and it is placed AT THE ENTITY -- inaudible from across the map",
              len(far_traces) >= 1 and max(t[3] for t in far_traces) == 0,
              "%s recipients from %d units away, against %s from %d units; "
              "equal counts would mean the position is not the entity's"
              % (max(t[3] for t in far_traces) if far_traces else -1, 2190,
                 max(t[3] for t in near_traces) if near_traces else -1, 144))

        # 4b's refusal, AFTER both emits rather than before them -- a count of
        # zero taken before anything has been emitted is a check that cannot
        # fail. It warns once per process when a sound is emitted from a handle
        # this side cannot place, so two shell-less emits are two chances for it
        # to appear and it needs only one.
        sound_refusals = console().count("asked to emit")
        check("4b's printed refusal has STOPPED",
              sound_refusals == 0,
              "%d shell-less-emit refusal line(s) after %d shell-less emit(s)"
              % (sound_refusals, 2))

        # The machinery itself, so the refusal above is a finding and not an
        # excuse for a broken subsystem.
        debug_api(pid, "cmd", "playsoundscape %s" % SOUNDSCAPE)
        time.sleep(2.0)
        r1 = soundscape_report(pid)
        NOTES.append("soundscape report after playsoundscape: %s" % (r1,))

        check("a forced soundscape becomes the current one",
              r1 is not None and r1[2] == SOUNDSCAPE,
              "current is [%s], asked for [%s]"
              % (r1[2] if r1 else "?", SOUNDSCAPE))

        check("and it STARTS its looping sounds",
              r1 is not None and r1[3] > 0,
              "%d looping sound(s), %d before; zero is a soundscape that was "
              "selected and is not playing"
              % (r1[3] if r1 else -1, r0[3] if r0 else -1))

        # AND IT CHANGES, which is the verb in the gate's own sentence.
        #
        # A SECOND, DIFFERENT soundscape rather than `stopsoundscape`, and the
        # first run is why: stopsoundscape calls StartNewSoundscape( NULL ) and
        # deliberately leaves m_forcedSoundscapeIndex alone, so the current
        # soundscape after it is the one before it. That is stock behaviour, and
        # a check that read it as a failure was measuring the harness.
        #
        # Two different soundscapes, both from the shipped scripts, so the
        # reading cannot be a latch: a system that answered its first soundscape
        # forever would pass a one-shot check and fails this one.
        debug_api(pid, "cmd", "playsoundscape %s" % SOUNDSCAPE_2)
        time.sleep(2.0)
        r2 = soundscape_report(pid)
        NOTES.append("soundscape report after the second playsoundscape: %s" % (r2,))

        check("and the current soundscape CHANGES to a second one",
              r2 is not None and r1 is not None
              and r2[2] == SOUNDSCAPE_2 and r2[1] != r1[1],
              "current is [%s] (%d), was [%s] (%d)"
              % (r2[2] if r2 else "?", r2[1] if r2 else -99,
                 r1[2] if r1 else "?", r1[1] if r1 else -99))

        check("and the second one is playing too",
              r2 is not None and r2[3] > 0,
              "%d looping sound(s)" % (r2[3] if r2 else -1))

        # -----------------------------------------------------------------
        # And nothing fell over on the way.
        # -----------------------------------------------------------------
        text = console()
        nbad = len(re.findall(r"Assertion|SIGSEGV|Segmentation", text))
        check("no assertion and no segfault", nbad == 0,
              "%d matches for Assertion|SIGSEGV|Segmentation" % nbad)

    finally:
        try:
            os.killpg(os.getpgid(popen.pid), signal.SIGKILL)
        except OSError:
            pass
        try:
            popen.wait(timeout=20)
        except Exception:
            pass
        log.close()
        print("box after: hl2_linux64 %s" % count_games())

    print()
    for note in NOTES:
        print("  note: " + note)
    print()
    if UNPROVEN:
        print("7e-particle-sound-gate: NOT REACHED -- " + ", ".join(UNPROVEN))
    if FAILURES:
        print("7e-particle-sound-gate: FAILED -- " + ", ".join(FAILURES))
    if FAILURES or UNPROVEN:
        return 1
    print("7e-particle-sound-gate: every check passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())

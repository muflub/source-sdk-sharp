#!/usr/bin/env python3
"""tools/nohost-sln -- keep SourceSharp.NoHost.slnf honest.

    tools/nohost-sln              check the filter against SourceSharp.slnx
    tools/nohost-sln --write      regenerate the filter from the solution
    tools/nohost-sln --self-test

SourceSharp.NoHost.slnf is what `make ... HOST_SDK=0` builds: SourceSharp.slnx
minus the projects that restore the host's SDK package (the Makefile says why
a tree can lack it). A solution filter is a second list of the solution's
projects, and a second list drifts: a project added to the .slnx and not to
the filter is silently never built or tested on CI. So this check fails when
the filter is not EXACTLY the solution minus EXCLUDED, in the solution's
order, and names the project that is missing or extra.

EXCLUDED is the closure of "needs SourceSharp.Host.Sdk": the Descent server,
which references the package, and its facts, which reference the server.
TF2.Descent.Rules needs only SourceSharp.Host.Contracts, which the public host
packs, so it and everything built on it stay in.
"""

import json
import os
import re
import sys
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SOLUTION = "SourceSharp.slnx"
FILTER = "SourceSharp.NoHost.slnf"
EXCLUDED = (
    "src/tf2_descent/server/TF2.Descent.Server.csproj",
    "src/tf2_descent/tests/TF2.Descent.Tests.csproj",
)

PROJECT = re.compile(r'<Project\s+Path="([^"]+)"')


def solution_projects(repo):
    with open(os.path.join(repo, SOLUTION)) as f:
        return PROJECT.findall(f.read())


def expected_filter(repo):
    projects = solution_projects(repo)
    missing = [e for e in EXCLUDED if e not in projects]
    if missing:
        raise SystemExit(f"{SOLUTION} no longer holds {missing[0]}; "
                         f"update EXCLUDED in {os.path.relpath(__file__, repo)}")
    return {"solution": {"path": SOLUTION,
                         "projects": [p for p in projects if p not in EXCLUDED]}}


def write(repo):
    with open(os.path.join(repo, FILTER), "w") as f:
        json.dump(expected_filter(repo), f, indent=2)
        f.write("\n")


def check(repo, out=print):
    """0 when the filter matches; 1 naming the first difference."""
    path = os.path.join(repo, FILTER)
    if not os.path.exists(path):
        out(f"{FILTER} is missing; run tools/nohost-sln --write")
        return 1
    with open(path) as f:
        have = json.load(f)
    want = expected_filter(repo)
    if have.get("solution", {}).get("path") != SOLUTION:
        out(f"{FILTER} does not filter {SOLUTION}")
        return 1
    got = have["solution"].get("projects", [])
    exp = want["solution"]["projects"]
    for p in exp:
        if p not in got:
            out(f"{FILTER} lacks {p} (in {SOLUTION}); run tools/nohost-sln --write")
            return 1
    for p in got:
        if p not in exp:
            why = "excluded on purpose" if p in EXCLUDED else f"not in {SOLUTION}"
            out(f"{FILTER} holds {p}, {why}; run tools/nohost-sln --write")
            return 1
    if got != exp:
        out(f"{FILTER} lists the projects in another order than {SOLUTION}; "
            "run tools/nohost-sln --write")
        return 1
    out(f"{FILTER}: {len(exp)} of {len(exp) + len(EXCLUDED)} projects, in step with {SOLUTION}")
    return 0


# --- self-test ----------------------------------------------------------------

def self_test():
    """Each failure the check exists to catch, on a fixture solution."""
    failures = 0

    def expect(name, cond):
        nonlocal failures
        print(f"{'ok ' if cond else 'BAD'} {name}")
        if not cond:
            failures += 1

    def fixture(projects):
        d = tempfile.mkdtemp(prefix="nohost-sln-")
        with open(os.path.join(d, SOLUTION), "w") as f:
            f.write("<Solution>\n" + "".join(
                f'  <Project Path="{p}" />\n' for p in projects) + "</Solution>\n")
        return d

    base = ["src/a/A.csproj", *EXCLUDED, "src/b/B.csproj"]

    d = fixture(base)
    write(d)
    said = []
    expect("a freshly written filter passes", check(d, said.append) == 0)
    with open(os.path.join(d, FILTER)) as f:
        kept = json.load(f)["solution"]["projects"]
    expect("the filter holds the solution minus the excluded projects",
           kept == ["src/a/A.csproj", "src/b/B.csproj"])

    d = fixture(base)
    expect("a missing filter fails", check(d, lambda _: None) == 1)

    d = fixture(base)
    write(d)
    with open(os.path.join(d, SOLUTION), "a") as f:
        pass
    with open(os.path.join(d, SOLUTION), "w") as f:
        f.write("<Solution>\n" + "".join(
            f'  <Project Path="{p}" />\n' for p in base + ["src/c/C.csproj"]) + "</Solution>\n")
    said = []
    expect("a project added to the solution but not the filter fails naming it",
           check(d, said.append) == 1 and "src/c/C.csproj" in said[0])

    d = fixture(base)
    write(d)
    with open(os.path.join(d, FILTER)) as f:
        doc = json.load(f)
    doc["solution"]["projects"].append(EXCLUDED[0])
    with open(os.path.join(d, FILTER), "w") as f:
        json.dump(doc, f)
    said = []
    expect("an excluded project in the filter fails naming it",
           check(d, said.append) == 1 and EXCLUDED[0] in said[0])

    d = fixture(base)
    write(d)
    with open(os.path.join(d, FILTER)) as f:
        doc = json.load(f)
    doc["solution"]["projects"].reverse()
    with open(os.path.join(d, FILTER), "w") as f:
        json.dump(doc, f)
    expect("a reordered filter fails", check(d, lambda _: None) == 1)

    d = fixture(["src/a/A.csproj"])
    try:
        expected_filter(d)
        expect("a solution without an excluded project is refused", False)
    except SystemExit as e:
        expect("a solution without an excluded project is refused",
               EXCLUDED[0] in str(e))

    print("nohost-sln self-test:", "PASS" if failures == 0 else f"{failures} FAILED")
    return 1 if failures else 0


def main(argv):
    if "--self-test" in argv:
        return self_test()
    if "--write" in argv:
        write(REPO)
        return check(REPO)
    return check(REPO)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

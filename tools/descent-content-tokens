#!/usr/bin/env python3
"""tools/descent-content-tokens -- the language file's skill tokens, from the rules' content.

The skill tree draws a skill's name and a tab's title as tokens (ui.Text), so
every skill and tab in src/tf2_descent/rules/Content needs one in
game/mod_tf2_descent/resource/tf2_descent_english.txt. They are written from
the tables, never by hand:

    #Descent_SkillName_<skill id>   the skill's "name"     (skills.json)
    #Descent_SkillTab_<tab id>      the tab's "name"       (skill_tabs.json)
    #Descent_Req_<attribute>_<min>  "Requires Aim 30"      (item_bases.json "requires")
    #Descent_ReqLevel_<level>       "Requires level 6"     (item_bases.json "level", above 1)

    tools/descent-content-tokens write   # docs/plans/tokens-content.tsv from the tables
    tools/descent-content-tokens check   # exit 1 when the TSV is not what the tables give

then `tools/descent-tokens add docs/plans/tokens-content.tsv` appends them
(a renamed skill is a changed value, which descent-tokens refuses: edit the
row in the language file, then add). Item, affix, family and effect names are
not tokens: the inventory draws them as game data (ui.Data), straight from
the tables the client embeds (DescentCatalog).
"""
import json
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CONTENT = os.path.join(ROOT, "src", "tf2_descent", "rules", "Content")
TSV = os.path.join(ROOT, "docs", "plans", "tokens-content.tsv")
HEADER = "# Generated by tools/descent-content-tokens from src/tf2_descent/rules/Content: do not edit.\n"


def load(table):
    with open(os.path.join(CONTENT, table + ".json"), encoding="utf-8") as f:
        return json.load(f)


def rows():
    out = []
    for tab in load("skill_tabs"):
        out.append((f"Descent_SkillTab_{tab['id']}", tab["name"]))
    for skill in load("skills"):
        out.append((f"Descent_SkillName_{skill['id']}", skill["name"]))
    # The item tooltip's requirement line, one token a requirement an item base names.
    names = {a["id"]: a["name"] for a in load("attributes")}
    requirements, levels = set(), set()
    for base in load("item_bases"):
        for r in base.get("requires", []):
            requirements.add((r["attribute"], r["min"]))
        if base.get("level", 0) > 1:
            levels.add(base["level"])
    for attribute, minimum in sorted(requirements):
        out.append((f"Descent_Req_{attribute}_{minimum}", f"Requires {names[attribute]} {minimum}"))
    for level in sorted(levels):
        out.append((f"Descent_ReqLevel_{level}", f"Requires level {level}"))
    return out


def text():
    return HEADER + "".join(f"{k}\t{v}\n" for k, v in rows())


def main(argv):
    if argv[:1] == ["write"]:
        with open(TSV, "w", encoding="utf-8", newline="\n") as f:
            f.write(text())
        print(f"descent-content-tokens: {len(rows())} row(s) -> {os.path.relpath(TSV, ROOT)}")
        return 0
    if argv[:1] == ["check"]:
        try:
            with open(TSV, encoding="utf-8") as f:
                held = f.read()
        except FileNotFoundError:
            print(f"descent-content-tokens: {os.path.relpath(TSV, ROOT)} is missing", file=sys.stderr)
            return 1
        if held != text():
            print(f"descent-content-tokens: {os.path.relpath(TSV, ROOT)} is stale: run write", file=sys.stderr)
            return 1
        return 0
    sys.exit(__doc__)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

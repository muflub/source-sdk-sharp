def summary(side, config, mtime_policy):
    rows, objs, archives = take_census(side, config, mtime_policy)
    state = [r for r in rows if is_state(r)]
    link = link_level(rows)
    guards = [r for r in rows if r.kind in MUTABLE_KINDS and r.category == "guard"]
    vecs = [r for r in rows if r.kind in MUTABLE_KINDS and is_vec_constant(r)]

    initialisers = 0
    for o in objs:
        if "_GLOBAL__sub_I_" in sh("nm", os.path.join(SRC, o)):
            initialisers += 1

    out = provenance((("side", side), ("config", config)))
    out.append("objects\t%d" % len(objs))
    out.append("archives\t%d" % len(archives))
    out.append("population\t%d" % len(rows))
    for k in sorted(ALL_KINDS):
        out.append("  kind_%s\t%d" % (k, sum(1 for r in rows if r.kind == k)))
    out.append("mutable_raw\t%d" % sum(1 for r in rows if r.kind in MUTABLE_KINDS))
    out.append("  minus_guard_variables\t%d" % len(guards))
    out.append("  minus_vec_header_constants\t%d" % len(vecs))
    out.append("object_level\t%d" % len(state))
    out.append("link_level\t%d" % len(link))
    out.append("object_level_bytes\t%d" % sum(r.size for r in state))
    out.append("objects_with_a_static_initialiser\t%d" % initialisers)
    for s in ("file-or-global", "function-local", "class-or-namespace"):
        out.append("scope_%s\t%d" % (s, sum(1 for r in state if r.scope == s)))
    for c, n in collections.Counter(r.category for r in state).most_common():
        out.append("category_%s\t%d" % (c, n))
    return out



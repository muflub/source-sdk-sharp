    `subject` is a seam for --self-test only. check_vec_subject() records why:
    a guard that has never been shown to fire is a guard nobody has checked,
    and `== []` on a healthy tree passes whether or not the function can ever
    return anything else.
    """
    bad = []
    rows = subject if subject is not None else CLIENT_FLOOR_SUBJECT
    for name, rel, needle in rows:
        found = False
        for prefix in CLIENT_FLOOR_PREFIXES:
            path = os.path.join(SRC, prefix + rel)
            try:
                if needle in open(path, errors="replace").read():
                    found = True
                    break
            except OSError:
                continue
        if not found:
            bad.append("%s is FLOOR because of `%s` in %s, and that is no "
                       "longer there" % (name, needle, rel))
    return bad

# Headers that are not this port's to change. A static inside one of them is
# the vendor's, and moving it means forking the header.
FLOOR_HEADER_PREFIXES = ("public/steam/",)

# The unwinder's indirect reference to __gxx_personality_v0, emitted by the
# compiler into .data of every TU that can throw. Not ours and not state we
# wrote.
FLOOR_COMPILER_EMITTED = frozenset(("DW.ref.__gxx_personality_v0",))


def derive(row, is_dropped, side="server"):
    """(disposition, reason). UNRULED whenever no rule fires.

    `side` defaults to server so that every caller written before the client
    had a ledger keeps its meaning; the ONLY thing it selects is which named
    floor list applies, because the server's three names and the client's nine
    are different mechanisms in different files and neither set is true of the
    other side.
    """
    if is_dropped:
        return "DEAD", "the linker drops it: nothing in the shipped .so reads it"
    # THE NAMED FLOOR IS TESTED BEFORE THE REGISTRATION RULE, and the order is
    # the point. The registration rule is an ADMISSION -- "settle this by
    # grepping the engine for the string" -- and a name in the list below is a
    # row where somebody has already done that grep and written the answer
    # down. Tested the other way round, `__g_CGameClientExports_singleton`
    # matched `EXPOSE_SINGLE_INTERFACE` in the source line at its definition,
    # came back UNRULED, and its entry in the list was dead text that nothing
    # would ever have reported as unreachable.
    if row.name in FLOOR_BY_NAME_BY_SIDE.get(side, frozenset()):
        if side == "client":
            return "FLOOR", CLIENT_FLOOR_REASON[row.name]
        return "FLOOR", "static-init registration named in plan_globals.md 2"
    if row.category == "iface-registration":
        # NOT a floor, and this rule used to say it was.
        #
        # An InterfaceReg node registers an interface STRING. Whether anything
        # asks for that string is a separate question the node's existence does
        # not answer: `IServerTools` has no Linux caller and `PluginHelpersCheck`
        # does (memory: grep-the-engine-for-the-interface-string). The
        # 619-row ruling table, which did that analysis, ruled 2 of these 11
        # DEAD for exactly that reason -- "InterfaceReg node for GameMovement001
        # that nobody resolves".
        #
        # A wrong FLOOR is the most expensive kind of wrong ruling: it means
        # "stays forever" and it hides the row from the UNRULED count that the
        # ratchet drives to zero. So the node is UNRULED with the check that
        # settles it written down.
        return ("UNRULED",
                "InterfaceReg node: settle by grepping the ENGINE for the "
                "interface string it registers, not by its existence")
    if row.name in FLOOR_COMPILER_EMITTED:
        return "FLOOR", "compiler-emitted unwinder reference, not state this port wrote"
    for p in FLOOR_HEADER_PREFIXES:
        if row.defined_at.startswith(p):
            return "FLOOR", "a static in %s: the vendor's header, not ours" % p
    return "UNRULED", ""


def linker_dropped_keys(side, config, rows, link):
    """The link_key()s the linker garbage-collects out of the .so."""
    sop = so_path(side, config)
    if not os.path.exists(sop):
        die("the linked .so is not on disk: %s" % sop)
    so, _ = so_state(sop)
    so_names = collections.Counter(n for n, _, _, _ in so)
    dropped, seen = set(), collections.Counter()
    for k in sorted(link):
        r = link[k]
        if r.bind == "LOCAL":
            seen[r.mangled] += 1
            if seen[r.mangled] > so_names.get(r.mangled, 0):
                dropped.add(k)
        elif r.mangled not in so_names:
            dropped.add(k)
    return dropped


def reseed(side, config, mtime_policy, ledger_path=None, write=False):
    """RECONCILE the ledger against the tree. Never regenerate it.

    A human ruling already in the ledger is carried forward untouched; a symbol
    with no row gets one, derived if a rule fires and UNRULED if not; a row
    whose symbol is gone is listed and, with --write, removed. Regenerating
    from the raw schema would overwrite the triage, which is what the
    `scan-guards --tsv is not the ledger` note on this project records.
    """
    rows, objs, _ = take_census(side, config, mtime_policy)
    link = link_level(rows)

    # derive()'s vendor-header rule reads the DWARF definition line, and this
    # host's `nm` may not emit one: binutils 2.35.2 in the steamrt sniper
    # container prints no file:line at all. Deriving from an empty column would
    # quietly rule 8 Steam SDK cells UNRULED instead of FLOOR. The GATE does not
    # need DWARF -- only reseed does -- so this refusal is here and not there.
    withloc = sum(1 for r in link.values() if r.defined_at)
    if link and withloc * 4 < len(link):
        die("this `nm` reports a DWARF definition line for only %d of %d "
            "symbols, so reseed cannot derive. Run it on a host whose binutils "
            "emits `nm -l` locations; `gate` reads the symbol table only and "
            "works anywhere." % (withloc, len(link)))

    dropped = linker_dropped_keys(side, config, rows, link)
    existing = read_ledger(ledger_path or ledger_for(side))

    kept = added = 0
    out_rows = []
    derived = collections.Counter()
    for k in sorted(link, key=lambda k: (link[k].tu, link[k].name, k[0])):
        r = link[k]
        if k in existing and existing[k]["disposition"]:
            e = existing[k]
            disp, owner, reason = e["disposition"], e["owner"], e["reason"]
            kept += 1
        else:
            disp, reason = derive(r, k in dropped, side)
            owner = ""
            added += 1
            derived[disp] += 1
        out_rows.append((k[0], r.mangled, r.name, r.tu, r.bind, r.kind,
                         r.scope, str(r.size), disp, owner, reason))
    pruned = sorted(k for k in existing if k not in link)

    report = provenance((("side", side), ("config", config),
                         ("objects", len(objs))))
    report.append("link_level\t%d" % len(link))
    report.append("rows_carried_forward\t%d" % kept)
    report.append("rows_added\t%d" % added)
    for d, n in sorted(derived.items()):
        report.append("  added_as_%s\t%d" % (d, n))
    report.append("rows_pruned\t%d" % len(pruned))
    for k in pruned[:20]:
        report.append("# pruned\t%s\t%s" % k)
    for d, n in sorted(collections.Counter(r[8] for r in out_rows).items()):
        report.append("disposition_%s\t%d" % (d, n))

    if write:
        path = ledger_path or ledger_for(side)
        head = []
        if os.path.exists(path):
            with open(path, errors="replace") as fh:
                for line in fh:
                    if line.startswith("#"):
                        head.append(line.rstrip("\n"))
                    else:
                        break
        with open(path, "w") as fh:
            for line in head:
                fh.write(line + "\n")
            fh.write("\t".join(LEDGER_COLUMNS) + "\n")
            for r in out_rows:
                fh.write("\t".join(r) + "\n")
        report.append("wrote\t%s" % os.path.relpath(path, ROOT))
    return report, out_rows


def gate(side, config, mtime_policy, ledger_path=None):
    """(report_lines, ok). Set membership, BOTH ways.

    plan_globals.md G0: the gate is membership, not a count. A count alone goes
    the wrong way for the wrong reason -- deleting one static and adding another
    is invisible to it -- and a keep-list nobody re-derives rots silently, which
    is the failure this repo caught at a merge on 2026-09-20. So BOTH:

      up     a state symbol with no ledger row FAILS.
      stale  a ledger row naming a symbol that is no longer on the link line
             FAILS. A row describing a tree that no longer exists still reads
             as a claim, and nothing would ever contradict it.

    and a third, because the ledger's own vocabulary can rot too: a disposition
    outside plan_globals.md 1's six plus UNRULED FAILS, so a seventh cannot be
    created by typing one into the file.
    """
    rows, objs, _ = take_census(side, config, mtime_policy)
    link = link_level(rows)
    ledger = read_ledger(ledger_path or ledger_for(side))

    no_row = sorted(k for k in link if k not in ledger)
    stale = sorted(k for k in ledger if k not in link)
    bad_disp = sorted(k for k, v in ledger.items()
                      if v["disposition"] not in DISPOSITIONS)
    unruled = sorted(k for k, v in ledger.items()
                     if v["disposition"] == "UNRULED")

    ok = not no_row and not stale and not bad_disp
    out = provenance((("side", side), ("config", config), ("objects", len(objs))))
    out.append("link_level\t%d" % len(link))
    out.append("ledger_rows\t%d" % len(ledger))
    out.append("symbols_with_no_ledger_row\t%d" % len(no_row))
    out.append("ledger_rows_with_no_symbol\t%d" % len(stale))
    out.append("bad_disposition\t%d" % len(bad_disp))
    for d in DISPOSITIONS:
        out.append("disposition_%s\t%d"
                   % (d, sum(1 for v in ledger.values()
                             if v["disposition"] == d)))
    out.append("unruled\t%d" % len(unruled))
    for k in no_row[:20]:
        out.append("# no_ledger_row\t%s\t%s" % k)
    for k in stale[:20]:
        out.append("# no_such_symbol\t%s\t%s" % k)
    for k in bad_disp[:20]:
        out.append("# bad_disposition\t%s\t%s" % k)
    out.append("gate\t%s" % ("PASS" if ok else "FAIL"))
    return out, ok
    return out, ok



    "client": os.path.join(ROOT, "docs", "globals-client-ledger.tsv"),
}

RATCHET_BY_SIDE = {
    "server": RATCHET,
    "client": os.path.join(ROOT, "docs", "globals-client-ratchet.tsv"),
}


def ledger_for(side):
    return LEDGER_BY_SIDE[side]


def ratchet_for(side):

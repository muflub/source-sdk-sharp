_PASS, _FAIL = [], []


def ok(cond, what):
    (_PASS if cond else _FAIL).append(what)
    sys.stderr.write("  %s  %s\n" % ("ok  " if cond else "FAIL", what))


def _mkrow(**kw):
    base = dict(object="a.o", tu="game/server/a.cpp", kind="bss", bind="LOCAL",
                scope="file-or-global", category="other", size=4,
                mangled="_ZL3s_n", name="s_n", defined_at="", text="")
    base.update(kw)
    return Row(**base)


def self_test():
    sys.stderr.write("globals-census --self-test\n")

    # -------------------------------------------------------------------
    # METHOD RULE 3, and it is the whole reason this block exists first.
    #
    # Re-running this census on 2026-09-21 with `kind ~ /bss|data/` returned
    # 11,820 rows from a 1,017-row mutable population, because the substring
    # also matches `rodata` and `data.rel.ro`. The filter below must be a SET
    # MEMBERSHIP test, and these rows are the ones that tell the two apart.
    # -------------------------------------------------------------------
    ok("rodata" not in MUTABLE_KINDS,
       "rodata is not mutable state -- a substring filter says it is")
    ok("relro" not in MUTABLE_KINDS,
       "relro (.data.rel.ro: vtables, typeinfo) is not mutable state")
    ok(isinstance(MUTABLE_KINDS, frozenset),
       "MUTABLE_KINDS is a SET, so it cannot be used as a substring pattern")
    ok(is_state(_mkrow(kind="bss")), "a .bss symbol is state")
    ok(is_state(_mkrow(kind="data")), "a .data symbol is state")
    ok(is_state(_mkrow(kind="tls")), "a thread-local is state")
    ok(not is_state(_mkrow(kind="rodata")), "a .rodata constant is not state")
    ok(not is_state(_mkrow(kind="relro")), "a vtable in .data.rel.ro is not state")

    # kind_of: .data.rel.ro must lose to .data, or every vtable is state.
    ok(kind_of(".data.rel.ro") == "relro",
       ".data.rel.ro is relro -- tested before .data, or vtables count as state")
    ok(kind_of(".data.rel.ro.local") == "relro", ".data.rel.ro.local is relro")
    ok(kind_of(".bss._ZL3s_n") == "bss", "a -ffunction-sections .bss.<sym> is bss")
    ok(kind_of(".data.s_n") == "data", "a per-symbol .data section is data")
    ok(kind_of(".rodata.cst8") == "rodata", ".rodata.cst8 is rodata")
    ok(kind_of(".tbss") == "tls" and kind_of(".tdata") == "tls",
       "thread-local sections are tls")
    ok(kind_of(".text") is None and kind_of(".init_array") is None,
       "sections that are not storage are not classified")

    # exclusions
    ok(not is_state(_mkrow(category="guard")),
       "a guard variable is not the state it guards")
    # THE ROW THAT DISCRIMINATES, TWICE OVER.
    #
    # These four ARE file-locals (`_ZL11vec2_origin`), so the first version of
    # this exclusion, keyed on the MANGLED name, matched none of the 406 and the
    # object level read 958 instead of 552.
    #
    # The SECOND version keyed on the demangled name AND the DWARF file. That
    # is exact on this host and matched NOTHING in the steamrt sniper
    # container, where `nm` is binutils 2.35.2 and prints no file:line: the
    # gtest reported 875 against a ceiling of 469. Hence the empty-defined_at
    # rows below, which are the container's shape.
    ok(not is_state(_mkrow(mangled="_ZL11vec2_origin", name="vec2_origin",
                           size=8, defined_at="public/mathlib/vector2d.h:150")),
       "vec2_origin is a header constant with one -O0 copy per TU -- and it is "
       "a FILE-LOCAL, so a mangled-name test misses every one of them")
    ok(not is_state(_mkrow(mangled="_ZL11vec2_origin", name="vec2_origin",
                           size=8, defined_at="")),
       "and it is excluded with NO DWARF LINE AT ALL, which is what the sniper "
       "container's nm gives -- a count that depends on which binutils is "
       "installed is not a measurement")
    ok(not is_state(_mkrow(mangled="_ZL12vec4_invalid", name="vec4_invalid",
                           size=16, defined_at="")),
       "vec4_invalid at 16 bytes is a Vector4D and is excluded the same way")
    ok(is_state(_mkrow(mangled="vec2_origin", name="vec2_origin", size=8)),
       "a NON-file-local named vec2_origin is somebody's global and is state -- "
       "the four header definitions can only produce the _ZL form")
    ok(is_state(_mkrow(mangled="_ZL11vec2_origin", name="vec2_origin",
                       size=64)),
       "a file-local named vec2_origin that is NOT 8 bytes is not a Vector2D "
       "and is state")
    ok(is_state(_mkrow(mangled="_ZL9vec3_zero", name="vec3_zero", size=12)),
       "the exclusion is the four named constants, not everything in mathlib")

    ok(check_vec_subject() == [],
       "public/mathlib/vector{2,4}d.h still define all four constants, so the "
       "exclusion that drops 406 rows still names its subject")
    # ... and the guard can actually FIRE. Without these two the row above
    # passes for a `return []` stub, which a mutation proved.
    ok(len(check_vec_subject(
        (("public/mathlib/vector2d.h", ("const Vector2D vec2_moved_away",)),)
    )) == 1,
       "check_vec_subject REPORTS a header that no longer defines the constant "
       "it is supposed to")
    ok(len(check_vec_subject(
        (("public/mathlib/a_header_that_is_not_there.h", ("anything",)),)
    )) == 1,
       "check_vec_subject REPORTS a header that is gone, rather than reading "
       "the missing file as nothing to complain about")

    # -------------------------------------------------------------------
    # The counting rule. LOCAL once per object, everything else once by name.
    # -------------------------------------------------------------------
    rows = [
        _mkrow(object="a.o", bind="LOCAL", mangled="_ZL3s_n"),
        _mkrow(object="b.o", bind="LOCAL", mangled="_ZL3s_n"),
        _mkrow(object="a.o", bind="GLOBAL", mangled="g_x"),
        _mkrow(object="b.o", bind="GLOBAL", mangled="g_x"),
        _mkrow(object="a.o", bind="UNIQUE", mangled="_ZZ3foovE3s_m"),
        _mkrow(object="b.o", bind="UNIQUE", mangled="_ZZ3foovE3s_m"),
    ]
    ok(len(rows) == 6, "six object-level rows in the fixture")
    ok(len(link_level(rows)) == 4,
       "link level folds the two GLOBAL g_x into one and the two UNIQUE into "
       "one, and keeps both LOCAL s_n -- 4, not 6 and not 3")
    ok(link_key(_mkrow(object="a.o", bind="LOCAL")) !=
       link_key(_mkrow(object="b.o", bind="LOCAL")),
       "two TUs' file-local statics of the same name are two pieces of state")
    ok(link_key(_mkrow(object="a.o", bind="WEAK", mangled="w")) ==
       link_key(_mkrow(object="b.o", bind="WEAK", mangled="w")),
       "a WEAK symbol the linker folds is ONE piece of state")

    # -------------------------------------------------------------------
    # scope_of: the shape tools/statics-audit could not see.
    # -------------------------------------------------------------------
    for demangled, want in (
        ("PhysicsShell()::s_Shell", "function-local"),
        ("CFoo::Bar() const::s_n", "function-local"),
        ("CFoo::Bar(int (*)(char))::s_n", "function-local"),
        ("CFoo::s_nCount", "class-or-namespace"),
        ("ns::g_x", "class-or-namespace"),
        ("g_pEngine", "file-or-global"),
        ("guard variable for PhysicsShell()::s_Shell", "function-local"),
        # A template argument carrying `::` but no function call: the depth
        # walk must not read the inner `::` as a qualifier boundary.
        ("CUtlVector<ns::T>", "file-or-global"),
    ):
        got = scope_of(demangled)
        ok(got == want, "scope_of(%r) is %s%s"
           % (demangled, want, "" if got == want else " -- got %s" % got))

    # -------------------------------------------------------------------
    # _size: readelf prints a decimal size normally and hex for a big one.
    # -------------------------------------------------------------------
    ok(_size("266392") == 266392, "a decimal size parses as decimal")
    ok(_size("0x41098") == 266392, "a hex size parses as hex")
    ok(_size("16") == 16, "16 is sixteen, not twenty-two -- decimal by default")

    # -------------------------------------------------------------------
    # The link-edge reader, on a fixture graph with a CONTINUED edge. Reading
    # only the first line would return two objects out of three and every
    # count after it would be wrong in the direction that looks fine.
    # -------------------------------------------------------------------
    tmp = tempfile.mkdtemp(prefix="globals-census-selftest-")
    try:
        # A CMake build dir: farm/<cfg>/build beside farm/<cfg>/src.
        g = os.path.join(tmp, "farm", "debug", "build")
        os.makedirs(g)
        src = os.path.join(tmp, "farm", "debug", "src")
        srv = "src/server/native/CMakeFiles/server_sourcesharp.dir/"
        cli = "src/client/native/CMakeFiles/client_sourcesharp.dir/"
        with open(os.path.join(g, "build.ninja"), "w") as fh:
            fh.write("build %sa.cpp.o: CXX_COMPILER__server_sourcesharp_Debug %s/game/server/a.cpp\n" % (srv, src))
            fh.write("build out/client.so: CXX_SHARED_LIBRARY_LINKER__client_sourcesharp_Debug"
                     " %sz.cpp.o\n" % cli)
            fh.write("  LINK_LIBRARIES = -ldl\n\n")
            fh.write("build out/server.so: CXX_SHARED_LIBRARY_LINKER__server_sourcesharp_Debug $\n")
            fh.write("    %sa.cpp.o $\n" % srv)
            fh.write("    %sb.cpp.o | lib/libtier1.a\n" % srv)
            fh.write("  LINK_LIBRARIES = -lmanaged_host  lib/libtier1.a  /abs/tier2.a\n")
            fh.write("\nbuild somethingelse: phony\n")
        with open(os.path.join(g, "compile_commands.json"), "w") as fh:
            import json
            json.dump([{"directory": g, "command": "c++ -c x", "file": src + "/game/server/a.cpp",
                        "output": srv + "a.cpp.o"},
                       {"directory": g, "command": "c++ -c x", "file": src + "/game/client/z.cpp",
                        "output": cli + "z.cpp.o"}], fh)
        objs, arch = link_edge(g, "server")
        ok(len(objs) == 2, "the continued link edge yields both objects (got %d)"
           % len(objs))
        ok(arch == ["/abs/tier2.a", os.path.join(g, "lib/libtier1.a")],
           "the archives are read off the same edge's LINK_LIBRARIES (got %s)" % arch)
        ok(all("client" not in o for o in objs),

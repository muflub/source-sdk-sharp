        ok(led[("a.o", "_ZL3s_n")]["disposition"] == "DEAD",
           "the ledger's disposition is read from the right column")
        ok(("a.o", "s_n") not in led,
           "the ledger key is the MANGLED name, the one link_key() folds on -- "
           "keyed on the demangled name studio.o's two __executeCount statics "
           "collapse into one row and the gate reports a phantom orphan")
        ok(led[("a.o", "_ZL3s_n")]["name"] == "s_n",
           "the demangled name is carried beside the key so the file reads")
    finally:
        import shutil
        shutil.rmtree(tmp2, ignore_errors=True)

    # -------------------------------------------------------------------
    # The reconciliation's own traps.
    # -------------------------------------------------------------------
    ok("u" in ARCHIVE_DATA_TYPES,
       "nm type `u` (GNU_UNIQUE) is a data definition -- leaving it out left "
       "12 CDmxElement/CDmxAttribute template `defaultValue` statics looking "
       "as though nothing on the link line defined them, and they landed in "
       "the unattributed residue")
    ok("V" in ARCHIVE_DATA_TYPES and "v" in ARCHIVE_DATA_TYPES,
       "weak data counts as a definition")
    ok("T" not in ARCHIVE_DATA_TYPES and "t" not in ARCHIVE_DATA_TYPES,
       "text is not data -- a filter that took every defined symbol would "
       "attribute half the archive to every unattributed name")
    ok("U" not in ARCHIVE_DATA_TYPES,
       "an UNDEFINED reference is not a definition (memory: "
       "nm-without-symbol-type-inflates)")

    tmp3 = tempfile.mkdtemp(prefix="globals-census-archives-")
    try:
        with open(os.path.join(tmp3, "build.ninja"), "w") as fh:
            fh.write("build lib/public/linux64/mathlib.a: CXX_STATIC_LIBRARY_LINKER__mathlib_Debug a.o b.o\n")
            fh.write("build lib/public/linux64/tier1.a: CXX_STATIC_LIBRARY_LINKER__tier1_Debug c.o\n")
            fh.write("build lib/public/linux64/copied.a: CUSTOM_COMMAND x\n")
            fh.write("# lib/public/linux64/tier2.a is prebuilt, not built\n")
        built = built_archives(tmp3)
        ok(built == {os.path.join(tmp3, "lib/public/linux64/mathlib.a"),
                     os.path.join(tmp3, "lib/public/linux64/tier1.a")},
           "built_archives reads the archives the BUILD links (got %s)"
           % sorted(built))
        ok(os.path.join(tmp3, "lib/public/linux64/tier2.a") not in built,
           "a PREBUILT archive is not a build output -- its mtime is when the "
           "worktree was written and says nothing about which config it is")

        # A .so older than both archives. Only the BUILT one may be reported.
        so = os.path.join(tmp3, "server.so")
        open(so, "w").close()
        os.utime(so, (1000, 1000))
        srcdir = os.path.join(tmp3, "lib", "public", "linux64")
        os.makedirs(srcdir)
        for a in ("mathlib.a", "tier2.a"):
            f = os.path.join(srcdir, a)
            open(f, "w").close()
            os.utime(f, (2000, 2000))
        old_src = globals()["SRC"]
        try:
            globals()["SRC"] = tmp3
            names = [os.path.join(tmp3, "lib/public/linux64/mathlib.a"),
                     os.path.join(tmp3, "lib/public/linux64/tier2.a")]
            stale = archives_are_current(names, so, built)
        finally:
            globals()["SRC"] = old_src
        ok(stale == [os.path.join(tmp3, "lib/public/linux64/mathlib.a")],
           "a BUILT archive newer than the .so is the config-mismatch refusal, "
           "and a TRACKED one newer than it is not (got %s)" % stale)
    finally:
        import shutil
        shutil.rmtree(tmp3, ignore_errors=True)

    # -------------------------------------------------------------------
    # partition_so, driven over a fixture. THE LIVE NUMBER CANNOT TEST THIS:
    # UNATTRIBUTED is 0 on a healthy tree whether the partition is right or
    # whether it absorbs everything into the archive bucket, and a mutation
    # proved exactly that -- `elif True` left the whole suite green.
    # -------------------------------------------------------------------
    _so = [
        ("g_x", "g_x", "GLOBAL", "1000"),               # a link-line global
        ("_ZL3s_n", "s_n", "LOCAL", "1008"),            # a link-line local
        ("_ZN5tier1L3s_qE", "tier1::s_q", "LOCAL", "1010"),   # an archive's
        ("__dso_handle", "__dso_handle", "GLOBAL", "1018"),   # the C runtime
        ("_ZL7mystery", "mystery", "LOCAL", "1020"),    # nobody's
    ]
    _obj_global = {"g_x"}
    _obj_local = collections.Counter({"_ZL3s_n": 1})
    _arch = {"_ZN5tier1L3s_qE"}
    _o, _a, _c, _u = partition_so(_so, _obj_global, _obj_local, _arch)
    ok((_o, _a, _c) == (2, 1, 1),
       "partition_so sources 2 from objects, 1 from an archive and 1 from the "
       "C runtime (got %r)" % ((_o, _a, _c),))
    ok([n for n, _ in _u] == ["_ZL7mystery"],
       "a symbol no independently-derived source explains is REPORTED, not "
       "absorbed -- this is the assertion the live UNATTRIBUTED==0 cannot make")
    ok(_o + _a + _c + len(_u) == len(_so),
       "the partition is total: every symbol lands in exactly one bucket")

    # One file-local NAME, two pieces of state: a link-line object's copy and
    # an archive's. Found at the Phase 0 merge (plan_sharp_repo.md) on the
    # client: detailobjectsystem.o and mathlib.a each carry
    # _ZL17Four_MagicNumbers, client.so holds both, and a name-membership
    # partition put BOTH in the objects bucket -- 1716 vs link_level less
    # dropped 1715, reconcile DISAGREE. The object side owns only as many
    # copies as the objects emit.
    _so3 = [
        ("_ZL5magic", "magic", "LOCAL", "1000"),        # the object's copy
        ("_ZL5magic", "magic", "LOCAL", "1010"),        # the archive's copy
    ]
    _o3, _a3, _c3, _u3 = partition_so(
        _so3, set(), collections.Counter({"_ZL5magic": 1}), {"_ZL5magic"})
    ok((_o3, _a3, len(_u3)) == (1, 1, 0),
       "a local name an object AND an archive both emit is one copy each, "
       "not two from the objects (got %r)" % ((_o3, _a3, len(_u3)),))

    _o2, _a2, _c2, _u2 = partition_so(_so, set(), collections.Counter(), set())
    ok(len(_u2) == 4 and _c2 == 1,
       "with no objects and no archives to attribute to, four of the five are "
       "unattributed and only the named crt symbol is explained -- the buckets "
       "do not quietly swallow what they cannot source")

    ok(reconcilable_config("server") in (None,) + CONFIGS,
       "reconcilable_config answers a config or None, never a guess")
    ok(reconcilable_config("server") is not None,
       "one of the two configs is reconcilable in this tree right now -- if "
       "neither is, something built the other config last and the "
       "reconciliation cannot be taken at all")

    ok("__dso_handle" in CRT_SYMBOLS and "dwarf_reg_size_table" in CRT_SYMBOLS,
       "the C runtime residue is a NAMED list, so a new one reddens as "
       "unattributed instead of vanishing into a bucket that always balances")
    ok(len(CRT_SYMBOLS) == 19,
       "19 crt/libgcc names (14 + the host libgcc 15 unwinder's 5, Phase 6b), which is what the partition needs on this tree; "
       "a change here is a change to what the reconciliation excuses")

    ok(set(DISPOSITIONS) == {"GONE", "DEAD", "CONST", "MANAGED", "MEMBER",
                             "FLOOR", "UNRULED"},
       "plan_globals.md 1's six dispositions plus UNRULED, and no eighth can "
       "be created by typing one into the ledger")
    ok("UNRULED" in DISPOSITIONS,
       "UNRULED is a first-class row state: a symbol with no ruling still has "
       "a row, so the gate's membership check is about the SET and the ratchet "
       "is about the ruling")

    # -------------------------------------------------------------------
    # derive(): two rules fire and everything else is an admission. A tool
    # that guessed MEMBER/MANAGED/CONST would produce a ledger nobody read.
    # -------------------------------------------------------------------
    ok(derive(_mkrow(), True) == ("DEAD",
       "the linker drops it: nothing in the shipped .so reads it"),
       "a symbol the linker dropped derives DEAD")
    ok(derive(_mkrow(category="iface-registration"), False)[0] == "UNRULED",
       "an InterfaceReg node is NOT derived FLOOR: it registers a string, and "
       "whether anything resolves that string is a question its existence does "
       "not answer -- the ruling table found 2 of 11 dead for that reason")
    ok(derive(_mkrow(name="(anonymous namespace)::s_gameShellDll"), False)[0]
       == "FLOOR", "the DLL instance whose address static-init takes is FLOOR")
    ok(derive(_mkrow(defined_at="public/steam/isteamugc.h:395"), False)[0]
       == "FLOOR", "a static inside a vendor header under public/steam/ is FLOOR")
    ok(derive(_mkrow(defined_at="public/mathlib/vector.h:9"), False)[0]
       == "UNRULED",
       "the vendor-header rule names public/steam/ and nothing else -- it is "
       "not a licence for every header under public/")
    ok(derive(_mkrow(category="convar"), False)[0] == "UNRULED",
       "a ConVar object is NOT derived: whether it becomes managed, a member "
       "or stays is a ruling somebody makes, not a category lookup")
    ok(derive(_mkrow(scope="function-local", size=266392), False)[0] == "UNRULED",
       "being big and function-local derives nothing -- PhysicsShell()::s_Shell "
       "is 266,392 bytes and still needs a human to say where it goes")
    ok(derive(_mkrow(), True)[0] == "DEAD"
       and derive(_mkrow(category="iface-registration"), True)[0] == "DEAD",
       "DEAD wins: a registration node the linker dropped is gone, whatever "
       "string it would have registered")
    ok(derive(_mkrow(name="(anonymous namespace)::s_gameShellDll"), True)[0]
       == "DEAD",
       "and DEAD wins over the named floor too -- the linker is the evidence, "
       "a name in a list is a claim")

    # -------------------------------------------------------------------
    # ONE LEDGER PER SIDE.
    #
    # `--side client` existed before any of this and every ledger path in the
    # file was the server's, so the client gate joined 1,966 client symbols
    # against 469 server rows and failed in both directions at once -- which
    # reads like a gate working, and is a gate answering about another tree.
    # -------------------------------------------------------------------
    ok(ledger_for("server") != ledger_for("client"),
       "the two sides do not share a ledger file: a client reseed would "
       "otherwise rewrite the rows the server lanes are ruling")
    ok(ledger_for("server") == LEDGER,
       "the server's ledger path is unchanged -- other lanes own that file")
    ok(os.path.basename(ledger_for("client")) == "globals-client-ledger.tsv",
       "the client's ledger is docs/globals-client-ledger.tsv")
    ok(set(LEDGER_BY_SIDE) == set(SIDES) and set(RATCHET_BY_SIDE) == set(SIDES),
       "every side the census accepts has a ledger and a ratchet, so "
       "--side <new> cannot silently fall back to the server's")
    ok(ratchet_for("server") != ratchet_for("client"),
       "and the two ratchets are separate too -- one ceiling cannot cap two "
       "populations that differ by 4x")

    # -------------------------------------------------------------------
    # THE CLIENT'S FLOOR IS NOT THE SERVER'S.
    # -------------------------------------------------------------------
    ok(derive(_mkrow(name="g_ShellClientDLL"), False, "client")[0] == "FLOOR",
       "the client's CreateInterface root is FLOOR on the client")
    ok(derive(_mkrow(name="g_ShellClientDLL"), False, "server")[0] == "UNRULED",
       "and is NOT floored on the server, where no such object exists -- the "
       "two lists are different mechanisms in different files")
    ok(derive(_mkrow(name="(anonymous namespace)::s_gameShellDll"),
              False, "client")[0] == "UNRULED",
       "and the server's root is not a floor on the client either")
    ok(derive(_mkrow(name="g_ShellClientDLL"), False)[0] == "UNRULED",
       "derive() still defaults to the server, so every caller written before "
       "the client had a ledger keeps its meaning")
    ok(derive(_mkrow(name="g_ShellClientDLL"), True, "client")[0] == "DEAD",
       "DEAD still wins over the client's named floor -- the linker is "
       "evidence and a name in a list is a claim")
    ok(derive(_mkrow(name="__g_CGameClientExports_singleton",
                     category="iface-registration"), False, "client")[0]
       == "FLOOR",
       "the named floor is tested BEFORE the registration rule: the singleton's "
       "own definition line IS an EXPOSE_SINGLE_INTERFACE, so tested after it "
       "the list entry was dead text nothing would report as unreachable")
    ok("GameUI.so" in derive(_mkrow(name="__g_CGameClientExports_singleton",
                                    category="iface-registration"),
                             False, "client")[1],
       "and the reason names the module that actually resolves the string -- "
       "GameClientExports001 is in GameUI.so and not in the engine")
    ok(derive(_mkrow(category="iface-registration"), False, "client")[0]
       == "UNRULED",
       "a registration node NOT in the list is still UNRULED on the client: "
       "the floor is a grep somebody did, not a shape")
    ok(len(CLIENT_FLOOR_ROOTS) == 4 and len(CLIENT_FLOOR_CHAINS) == 4
       and not (set(CLIENT_FLOOR_ROOTS) & set(CLIENT_FLOOR_CHAINS)),
       "four roots and four chains, disjoint -- the two groups are different "
       "evidence and merging them would hide which was checked how")
    ok(all(CLIENT_FLOOR_REASON[n] for n in CLIENT_FLOOR_BY_NAME),
       "every client floor carries a written reason: a disposition with no "
       "evidence is worse than UNRULED because it looks settled")
    ok(len(CLIENT_FLOOR_BY_NAME) == 8,
       "the client floor is eight names: four CreateInterface roots and four "
       "walked registration chains (got %d; CUserMessageRegister's left with "
       "c_user_message_register.cpp, lane HC 2026-10-04)" % len(CLIENT_FLOOR_BY_NAME))
    ok(len(CLIENT_FLOOR_SUBJECT) == len(CLIENT_FLOOR_BY_NAME)
       and {r[0] for r in CLIENT_FLOOR_SUBJECT} == set(CLIENT_FLOOR_BY_NAME),
       "every client floor name is pinned by a subject row, and no subject "
       "row pins a name that is not floored")
    ok("s_pNonModifiedPointerProxyHead" not in CLIENT_FLOOR_BY_NAME,
       "the server's dt_send.cpp chain is NOT a client floor: that file is "
       "not on the client link edge, and a floor copied across sides is a "
       "claim nobody measured")

    # The guard, driven over a fixture: a guard that has never been shown to
    # fire is a guard nobody has checked.
    ok(check_floor_subject() == [],
       "every client FLOOR still has the mechanism that justifies it")
    ok(len(check_floor_subject(
        (("x", "game/client/shell_clientdll.cpp", "no such text anywhere"),))) == 1,
       "a floor whose mechanism has left the file is reported, not excused")
    ok(len(check_floor_subject(
        (("x", "game/client/there-is-no-such-file.cpp", "anything"),))) == 1,
       "and so is one whose file is gone")
    ok(check_floor_subject(
        (("g_ShellClientDLL", "game/client/shell_clientdll.cpp",
          "EXPOSE_SINGLE_INTERFACE_GLOBALVAR( CShellClientDLL, IBaseClientDLL, "
          "CLIENT_DLL_INTERFACE_VERSION, g_ShellClientDLL )"),)) == [],
       "the root's mechanism is found under the sourcesharp/ prefix as well "
       "as the stock one, so moving the shell tree does not falsify it")

    # audit()'s side, which was hardcoded to "server": a client run with a
    # broken regex sent the reader to look at the edge that still works.
    with tempfile.TemporaryDirectory() as _t:
        _g = _t
        ok("no client link edge" in audit(_g, [], {}, "off", "client")[0],
           "an empty CLIENT link edge names the client in its refusal")
        ok("no server link edge" in audit(_g, [], {}, "off")[0],
           "and the refusal still says server when no side is given")

    ok(ROOT == os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
       "the repo root comes from this file's own location, never a hardcoded "
       "worktree path -- a committed harness outlives its lane")

    sys.stderr.write("\n%d ok, %d FAILED\n" % (len(_PASS), len(_FAIL)))
    return 1 if _FAIL else 0


# ---------------------------------------------------------------------------

def main(argv=None):
    p = argparse.ArgumentParser(
        prog="globals-census",
        description="static-storage state on the server link line")
    p.add_argument("--self-test", "--selftest", dest="self_test",
                   action="store_true", help="run the hermetic self-test")
    p.add_argument("--side", choices=SIDES, default="server")
    p.add_argument("--config", choices=CONFIGS + ("auto",), default="debug",
                   help="'auto' is for `reconcile` only: it picks whichever "
                        "config's graph-built archives are still the ones its "
                        ".so was linked from. At most one ever is.")
    p.add_argument("--mtime-policy", choices=("on", "off"), default="off",
                   help="'on' refuses when an object is older than its source. "
                        "Default off: a regenerated graph makes every object "
                        "look stale and that is not evidence of anything -- "
                        "ninja's own `-n` is the real check. The MISSING "
                        "refusal is unconditional either way.")
    p.add_argument("--out", help="write the census TSV here instead of stdout")
    p.add_argument("--ledger", help="a ledger other than docs/globals-ledger.tsv")
    p.add_argument("--write", action="store_true",
                   help="reseed: actually rewrite the ledger. Without it the "
                        "reconciliation is reported and nothing is changed.")
    p.add_argument("cmd", nargs="?", default="summary",
                   choices=("census", "summary", "reconcile", "gate", "reseed"))
    args = p.parse_args(argv)

    if args.self_test:
        return self_test()

    if args.cmd == "census":
        rows, objs, archives = take_census(args.side, args.config, args.mtime_policy)
        fh = open(args.out, "w") if args.out else sys.stdout
        try:
            for line in provenance((("side", args.side), ("config", args.config),
                                    ("objects", len(objs)),
                                    ("archives", len(archives)))):
                fh.write(line + "\n")
            w = csv.writer(fh, delimiter="\t", lineterminator="\n",
                           quoting=csv.QUOTE_NONE, escapechar="\\")
            w.writerow(COLUMNS)
            for r in rows:
                w.writerow(r)
        finally:
            if args.out:
                fh.close()
        return 0

    if args.cmd == "summary":
        print("\n".join(summary(args.side, args.config, args.mtime_policy)))
        return 0

    if args.cmd == "reconcile":
        cfg = args.config
        if cfg == "auto":
            cfg = reconcilable_config(args.side)
            if cfg is None:
                die("neither config is reconcilable: in both, a graph-built "
                    "archive is newer than the .so it links into. "
                    "lib/public/linux64/*.a is not config-qualified, so "
                    "whichever config was built LAST is the one that can be "
                    "reconciled -- build one and try again.")
        lines, agreed = reconcile(args.side, cfg, args.mtime_policy)
        print("\n".join(lines))
        return 0 if agreed else 1

    if args.cmd == "reseed":
        lines, _ = reseed(args.side, args.config, args.mtime_policy,
                          args.ledger, args.write)
        print("\n".join(lines))
        return 0

    if args.cmd == "gate":
        lines, good = gate(args.side, args.config, args.mtime_policy, args.ledger)
        print("\n".join(lines))
        return 0 if good else 1

    p.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())

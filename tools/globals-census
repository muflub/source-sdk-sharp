LEDGER = os.path.join(ROOT, "docs", "globals-ledger.tsv")
RATCHET = os.path.join(ROOT, "docs", "globals-ratchet.tsv")

# ---------------------------------------------------------------------------
# ONE LEDGER PER SIDE, and the two must not share a file.
#
# The census has taken `--side client` since it was written, but every ledger
# path in it was the server's, so `gate --side client` joined 1,966 client

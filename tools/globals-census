# Method rule 3: a CLOSED set of tokens, matched with `in`, never a regex.
MUTABLE_KINDS = frozenset(("bss", "data", "tls"))
CONSTANT_KINDS = frozenset(("rodata", "relro"))
ALL_KINDS = MUTABLE_KINDS | CONSTANT_KINDS

# ---------------------------------------------------------------------------
# The four header-defined constants with one runtime-constructed copy per TU at
# -O0. 406 rows on this tree, all of which vanish at -O2, so a census that kept
# them would report the debug build's optimisation level rather than the port's
# state.
#
# THE EXCLUSION READS ONLY THE SYMBOL TABLE, AND THAT IS NOT A STYLE CHOICE.
# It was first keyed on the demangled name AND the DWARF file `nm -l` reports,
# which is exact and correct -- on this host. Inside the steamrt sniper
# container, where the native tests actually run, `nm` is binutils 2.35.2 and
# prints NO file:line for these symbols at all. `defined_at` is empty there,
# the header test matched nothing, and `globals_ledger_test` reported 875
# pieces of state against a ceiling of 469 -- the 406 excluded rows, back.
#
# A number that depends on which binutils is installed is not a measurement. So
# the test below is the symbol table only: the demangled name is one of the
# four, the mangled name is the file-local form the header definition must
# produce, and the size is the type's. `_ZL11vec2_origin` at 8 bytes is a
# Vector2D; anything else named vec2_origin is somebody's global and is state.
#
# The SUBJECT is pinned separately, by check_vec_subject(): the four
# definitions must still be in public/mathlib/vector{2,4}d.h. Source text is
# never the instrument here -- it is a GUARD ON THE EXCLUSION, so that when
# mathlib changes the tool refuses rather than going on excusing 406 rows it
# can no longer justify.
# ---------------------------------------------------------------------------

VEC_CONSTANTS = frozenset((
    "vec2_origin", "vec2_invalid", "vec4_origin", "vec4_invalid",
))
VEC_MANGLED = re.compile(r"^_ZL\d+vec([24])_(origin|invalid)$")
VEC_SIZES = {"2": 8, "4": 16}          # sizeof(Vector2D), sizeof(Vector4D)

# Where the four are defined, and what a definition looks like. Both halves
# matter: the file must exist and it must still define the name.
VEC_SUBJECT = (
    ("public/mathlib/vector2d.h", ("const Vector2D vec2_origin",
                                   "const Vector2D vec2_invalid")),
    ("public/mathlib/vector4d.h", ("const Vector4D vec4_origin",
                                   "const Vector4D vec4_invalid")),
)


def is_vec_constant(row):
    if row.name not in VEC_CONSTANTS:
        return False
    m = VEC_MANGLED.match(row.mangled)
    if m is None:
        return False
    return row.size == VEC_SIZES[m.group(1)]


def check_vec_subject(subject=None):
    """[] when the four definitions are where the exclusion says, else the
    complaints. An exclusion whose subject has moved must stop the run.

    `subject` is a seam for --self-test only: a guard that has never been shown
    to fire is a guard nobody has checked, and `check_vec_subject() == []` on a
    healthy tree passes whether or not the function can ever return anything
    else. A mutation that made it `return []` stayed GREEN against exactly that
    assertion.
    """
    bad = []
    for rel, needles in (subject if subject is not None else VEC_SUBJECT):
        path = os.path.join(SRC, rel)
        try:
            text = open(path, errors="replace").read()
        except OSError:
            bad.append("%s is gone, so the four vec constants the census "
                       "excludes have no known definition site" % rel)
            continue
        for n in needles:
            if n not in text:
                bad.append("%s no longer contains `%s`" % (rel, n))
    return bad

# The dispositions docs/globals-ledger.tsv may use.

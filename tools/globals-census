# removes it. 332 of the old table's 619 rows were GONE; none of that shape
# survives the shim close.
#
# UNRULED is the seventh and it is an ADMISSION, not a disposition: the symbol
# has a row, so the gate's membership check passes, but no human has ruled it.
# It is capped in docs/globals-ratchet.tsv and driven to zero, the same shape as
# `shim_reason_none`. A tool must never invent MEMBER, MANAGED or CONST: each
# needs someone to read the code and name a consumer or a managed home.
DISPOSITIONS = ("GONE", "DEAD", "CONST", "MANAGED", "MEMBER", "FLOOR", "UNRULED")

SIDES = ("server", "client")
CONFIGS = ("debug", "release")


def die(msg, code=2):
    sys.stderr.write("globals-census: %s\n" % msg)
    sys.exit(code)


# ---------------------------------------------------------------------------
# provenance -- shared with tools/shim-census in shape; a reading that cannot
# name the tree it came from has produced a wrong "done" verdict here before.
# ---------------------------------------------------------------------------

def git(*args, **kw):
    """`strip=False` matters: --porcelain's status letters live in columns 0-1
    and an unstaged edit is " M path", so .strip() eats the leading space and
    every path afterwards loses its first character."""
    strip = kw.pop("strip", True)
    try:
        out = subprocess.run(["git", "-C", ROOT] + list(args),
                             capture_output=True, text=True, check=False)
    except OSError:
        return ""
    if out.returncode != 0:
        return ""
    return out.stdout.strip() if strip else out.stdout


def tip():
    """(sha, dirty_paths). The PATHS, not a flag: a census written INTO the
    tree makes the tree dirty by existing, and a bare DIRTY would read as an
    unmeasured edit."""
    sha = git("rev-parse", "HEAD") or "UNKNOWN"
    status = git("status", "--porcelain", strip=False)
    return sha, [ln[3:].strip() for ln in status.splitlines() if ln.strip()]


def provenance(extra=()):
    sha, dirty = tip()
    out = ["# globals-census\ttip %s\t%s"
           % (sha, ("DIRTY (%d path%s)" % (len(dirty), "" if len(dirty) == 1 else "s"))
              if dirty else "clean")]
    for k, v in extra:
        out.append("# %s\t%s" % (k, v))
    for d in dirty[:12]:
        out.append("# dirty\t%s" % d)
    if len(dirty) > 12:
        out.append("# dirty\t... and %d more" % (len(dirty) - 12))
    return out


# ---------------------------------------------------------------------------
# the link edge
# ---------------------------------------------------------------------------

def link_edge(bdir, side):
    """(objects, archives) named on the .so's link edge in the CMake build.

    The objects are the edge's explicit inputs; the archives are the .a files
    of its LINK_LIBRARIES (the Valve libraries CMake builds, lib/lib*.a, and
    the prebuilt ones it names by absolute path). Both absolute, both sorted.
    """
    try:
        edge = cmakegraph.link_edge(cmakegraph.SIDES[side], bdir)
        libs = cmakegraph.link_libraries(cmakegraph.SIDES[side], bdir)
    except cmakegraph.GraphError as e:
        die(str(e))
    absolute = lambda t: t if os.path.isabs(t) else os.path.join(bdir, t)
    return (sorted({absolute(t) for t in edge["objects"] if t.endswith(".o")}),
            sorted({absolute(t) for t in libs if t.endswith(".a")}))


def compile_edges(bdir, side):
    """object -> farm-relative source, from compile_commands.json."""
    m = {}
    try:
        for e in cmakegraph.target_entries(cmakegraph.SIDES[side], bdir):
            o = e["output"] if os.path.isabs(e["output"]) else os.path.join(bdir, e["output"])
            m[os.path.normpath(o)] = cmakegraph.farm_relative(e["file"], bdir)
    except cmakegraph.GraphError as e:
        die(str(e))
    return m


def object_name(o):
    """The ledger's `object` column: the object's FILE NAME in VPC's spelling
    (baseviewport.cpp.o -> baseviewport.o). The ledgers were keyed on VPC's
    flat objs/<project>/x.o names; CMake's layout is CMakeFiles/<target>.dir/
    <source path>.o, and a key that moved with the build system would orphan
    every ruling in both ledgers."""
    return re.sub(r"\.(cpp|c)\.o$", ".o", os.path.basename(o))


# ---------------------------------------------------------------------------
# the refusals (method rule 4)
# ---------------------------------------------------------------------------

def audit(ninja_path, objs, srcmap, mtime_policy, side="server"):
    """List of fatal problems. Empty means the reading can be trusted.

    `side` is only in the message, and it was hardcoded to "server": a client
    run with a broken link-edge regex would have told whoever read it to go
    and look at the server edge, which is intact.
    """
    fatal = []
    if not objs:
        fatal.append("the link edge names no objects -- either the build has "
                     "no %s link edge or the reader stopped matching it"
                     % side)
        return fatal
    missing, stale = [], []
    for o in objs:
        p = os.path.join(SRC, o)
        if not os.path.exists(p):
            missing.append(o)
            continue
        if mtime_policy == "on":
            s = srcmap.get(o)
            if s:
                sp = os.path.join(SRC, s)
                try:
                    if os.path.getmtime(sp) > os.path.getmtime(p):
                        stale.append(o)
                except OSError:
                    pass
    if missing:
        fatal.append("MISSING: %d object%s the graph names is not on disk "
                     "(first: %s). An unbuilt tree must not read as zero state."
                     % (len(missing), "" if len(missing) == 1 else "s", missing[0]))
    if stale:
        fatal.append("STALE: %d object%s older than the source the graph "
                     "compiles it from (first: %s). Use --mtime-policy off only "
                     "when ninja itself says there is no work to do."
                     % (len(stale), "" if len(stale) == 1 else "s", stale[0]))
    return fatal


# ---------------------------------------------------------------------------
# the symbol reader
# ---------------------------------------------------------------------------

def sh(*a):
    return subprocess.run(a, capture_output=True, text=True, errors="replace").stdout


_SEC_RE = re.compile(r"\s*\[\s*(\d+)\]\s+(\S+)\s+(\S+)")


def sections(path):
    secs = {}
    for line in sh("readelf", "-SW", path).splitlines():
        g = _SEC_RE.match(line)
        if g:
            secs[int(g.group(1))] = g.group(2)
    return secs


# Order matters: `.tbss`/`.tdata` before `.bss`/`.data` would be harmless, but
# `.data.rel.ro` MUST be tested before `.data` or every vtable counts as state.
_KIND_PREFIXES = (
    (".tbss", "tls"), (".tdata", "tls"),
    (".data.rel.ro", "relro"),
    (".bss", "bss"), (".data", "data"),
    (".rodata", "rodata"),
)


def kind_of(section):
    for prefix, kind in _KIND_PREFIXES:
        if section.startswith(prefix):
            return kind
    return None


def _size(tok):
    return int(tok, 16) if tok.lower().startswith("0x") else int(tok)


def symbols(path):
    """[(name, size, bind, kind, dwarf_loc)] for one object or .so."""
    secs = sections(path)
    lines = {}
    for line in sh("nm", "-l", "--defined-only", path).splitlines():
        if "\t" in line:
            head, loc = line.split("\t", 1)
            lines[head.split()[-1]] = loc.strip()
    rows = []
    for line in sh("readelf", "-sW", path).splitlines():
        p = line.split()
        if len(p) < 8 or not p[0].rstrip(":").isdigit():
            continue
        _, _, size, typ, bind, _, ndx, name = p[:8]
        if typ not in ("OBJECT", "TLS", "GNU_UNIQUE") or not ndx.isdigit():
            continue
        k = kind_of(secs.get(int(ndx), ""))
        if k is None:
            continue
        rows.append((name, _size(size), bind, k, lines.get(name, "")))
    return rows


def demangle(names):
    names = list(names)
    if not names:
        return {}
    p = subprocess.run(["c++filt"], input="\n".join(names),
                       capture_output=True, text=True)
    return dict(zip(names, p.stdout.split("\n")))


# ---------------------------------------------------------------------------
# hints for whoever rules (never verdicts)
# ---------------------------------------------------------------------------

RTTI = re.compile(r"^(vtable|typeinfo|typeinfo name|VTT|construction vtable) for ")

CATS = [
    ("convar", r"\bConVar(Ref)?\b|\bConCommand\b|\bCON_COMMAND|_command$|_command ##|ConVar_"),
    ("iface-registration", r"EXPOSE_(SINGLE_)?INTERFACE|InterfaceReg|__g_Create"),
    ("datatable",
     r"DATADESC|DATAMAP|SERVERCLASS|SEND_TABLE|RECV_TABLE|NETWORK_TABLE|PREDICTION_DATA|"
     r"m_DataMap|m_PredMap|g_SendTable|sendtable|SendProp|typedescription|g_.*_ClassReg|"
     r"_DataDescInit|SAVERESTORE|::m_pClassSendTable"),
    ("entity-factory", r"LINK_ENTITY_TO_CLASS|EntityFactory|PRECACHE_REGISTER|PrecacheRegister"),
    ("usermessage/te", r"UserMessage|TempEnt|\bTE_|g_TE|IMPLEMENT_.*TE"),
    ("gamesystem", r"GameSystem|IGameSystem|CAutoGameSystem"),
    ("engine-iface-ptr",
     r"##.*\b(IV?[A-Z]\w+|CGlobalVars|CSteamAPIContext|ICvar|IFileSystem)\s*\*\s*\w+\s*(=|;)"),
    ("abi-block", r"SourceSharp|engineApi|EngineApi|s_Api|g_Api|g_pManaged|ss_"),
    ("string/symbol-pool", r"StringPool|SymbolTable|CUtlSymbol|g_.*Strings?\b"),
    ("container", r"CUtl(Vector|Map|Dict|RBTree|LinkedList|Memory|Hash|String|Buffer|Queue)"),
    ("math-const",
     r"\bvec[234]?_(origin|invalid|zero)|vec3_angle|quat_identity|g_vecZero|"
     r"\b(Vector|QAngle|Quaternion|matrix3x4_t|VMatrix)\b.*##.*const|"
     r"##.*\bconst (Vector|QAngle|Quaternion|Vector2D|Vector4D|matrix3x4_t)\b"),
]
CATS = [(n, re.compile(r)) for n, r in CATS]


def categorise(demangled, text):
    if RTTI.match(demangled):
        return "rtti"
    if demangled.startswith("guard variable for "):
        return "guard"
    blob = demangled + " ## " + text
    for name, rx in CATS:
        if rx.search(blob):
            return name
    return "other"


def scope_of(demangled):
    """function-local / class-or-namespace / file-or-global.

    A function-local static demangles with `)::` in it -- the enclosing
    FUNCTION's signature, which no class or namespace qualifier can produce.
    That is the shape `tools/statics-audit` could not see and the reason 156
    pieces of state on this tree look like accessors.
    """
    core = re.sub(r"^guard variable for ", "", demangled)
    if re.search(r"\)( const)?::", core):
        return "function-local"
    depth, last = 0, -1
    for i, c in enumerate(core):
        depth += c in "<("
        depth -= c in ">)"
        if depth == 0 and core[i:i + 2] == "::":
            last = i
    return "class-or-namespace" if last >= 0 else "file-or-global"


_src_cache = {}


def _farm_src_prefix(f):
    """The prefix of a DWARF path that stands for the farm's src/: the
    container's, or any farm/<config>/src/ on the host."""
    if f.startswith(CONTAINER_PREFIX):
        return CONTAINER_PREFIX
    m = re.match(r"^/.*?/farm/[^/]+/src/", f)
    return m.group(0) if m else ""


def farm_relative_loc(loc):
    """A DWARF file:line with the build's src/ root stripped."""
    return loc[len(_farm_src_prefix(loc)):]


def src_line(loc):
    if not loc or ":" not in loc:
        return ""
    f, _, n = loc.rpartition(":")
    pre = _farm_src_prefix(f)
    if pre:
        f = os.path.join(SRC, f[len(pre):])
    f = os.path.normpath(f)
    if f not in _src_cache:
        try:
            _src_cache[f] = open(f, errors="replace").read().split("\n")
        except OSError:
            _src_cache[f] = []
    lines = _src_cache[f]
    n = int(n) if n.isdigit() else 0
    return re.sub(r"\s+", " ", lines[n - 1]).strip()[:160] if 0 < n <= len(lines) else ""


# ---------------------------------------------------------------------------
# the census
# ---------------------------------------------------------------------------

COLUMNS = ("object", "tu", "kind", "bind", "scope", "category", "size",
           "mangled", "name", "defined_at", "text")

Row = collections.namedtuple("Row", COLUMNS)


def build_for(config):
    """The CMake build dir of a configuration: farm/<config>/build. ROOT is the
    farm this runs in (farm/<x>), so the other configuration's build is its
    sibling farm's."""
    farms = os.path.dirname(ROOT)
    if os.path.basename(farms) == "farm":
        return os.path.join(farms, config, "build")
    return os.path.join(ROOT, "farm", config, "build")


def take_census(side, config, mtime_policy):
    bdir = build_for(config)
    # The source lists and the compile database must agree, or the link edge
    # below describes a build of some other tree.
    try:
        cmakegraph.compiled_sources(cmakegraph.SIDES[side], bdir)
    except cmakegraph.GraphError as e:
        die(str(e))
    objs, archives = link_edge(bdir, side)
    srcmap = compile_edges(bdir, side)
    fatal = audit(bdir, objs, srcmap, mtime_policy, side)
    if fatal:
        for f in fatal:
            sys.stderr.write("globals-census: %s\n" % f)
        sys.exit(2)

    bad = check_vec_subject()
    if bad:
        for b in bad:
            sys.stderr.write("globals-census: %s\n" % b)
        die("the vec-constant exclusion no longer names its subject. It drops "
            "406 rows from this tree; going on without checking would be a "
            "waiver nobody wrote.")

    # The same discipline for the client's named floor. FLOOR means "stays
    # forever" AND hides the row from the UNRULED count the ratchet drives to
    # zero, so it is the most expensive kind of wrong ruling. Checked here and
    # not in derive() so that `gate` -- the thing CI runs, and the thing that
    # reads a ledger somebody wrote FLOOR into months ago -- refuses too.
    if side == "client":
        bad = check_floor_subject()
        if bad:
            for b in bad:
                sys.stderr.write("globals-census: %s\n" % b)
            die("a client FLOOR no longer has the mechanism that justifies it. "
                "Re-rule the row rather than leaving a claim nothing checks.")

    raw = []
    for o in objs:
        for name, size, bind, kind, loc in symbols(os.path.join(SRC, o)):
            raw.append((o, srcmap.get(os.path.normpath(o), "?"), name, size, bind, kind, loc))

    dm = demangle(sorted({r[2] for r in raw}))
    rows = []
    for o, tu, name, size, bind, kind, loc in raw:
        d = dm.get(name, name)
        text = src_line(loc)
        rows.append(Row(object=object_name(o), tu=tu, kind=kind, bind=bind,
                        scope=scope_of(d), category=categorise(d, text),
                        size=size, mangled=name, name=d,
                        defined_at=farm_relative_loc(loc), text=text))
    return rows, objs, archives


def is_state(row):
    """Method rule 3. `in` against a closed set, never a substring."""
    return (row.kind in MUTABLE_KINDS
            and row.category != "guard"
            and not is_vec_constant(row))


def link_key(row):
    """LOCAL is one piece of state per OBJECT; everything else one per NAME."""
    return (row.object, row.mangled) if row.bind == "LOCAL" else ("", row.mangled)


def link_level(rows):
    """{link_key: representative row} over the state rows."""
    out = {}
    for r in rows:
        if is_state(r):
            out.setdefault(link_key(r), r)
    return out


# ---------------------------------------------------------------------------
# reconciliation -- the second, independent instrument
#
# The claim it makes has to be FALSIFIABLE, and the first version of this was
# not. It defined "came from an archive" as "in the .so and not in any link-line
# object", and then checked objects - dropped + that == so. That identity is
# true by construction: it cannot fail, so it measured nothing. (This repo has
# recorded 51 such checks; this was the 52nd.)
#
# So the claim here is a PARTITION with a residue that must be EMPTY. Every
# mutable symbol instance in the linked .so is attributed to exactly one
# independently-derived source:
#
#     a link-line object   the census's own reading
#     an archive           `nm --defined-only` over the .a files, read from
#                          disk, nothing to do with the .so
#     the C runtime        a NAMED list below -- libgcc's unwinder and
#                          crtstuff's __dso_handle and friends
#
# and `unattributed` is what is left. AGREE means unattributed == 0. A symbol
# the tool cannot source reddens instead of being absorbed into a residue
# bucket that always balances.
# ---------------------------------------------------------------------------

# libgcc + crtstuff, by name. These have no archive on the link line and no
# object: the linker brings them in from the toolchain. Listed rather than
# pattern-matched so a new one shows up as unattributed and has to be read.
CRT_SYMBOLS = frozenset((
    "__dso_handle", "__TMC_END__",
    # libgcc's unwind-dw2-fde-dip.c / unwind-dw2.c statics
    "dwarf_reg_size_table", "frame_hdr_cache", "frame_hdr_cache_head",
    "object_mutex", "seen_objects", "unseen_objects", "any_objects_registered",
    # -fdata-sections local statics libgcc emits with a numeric suffix
    "adds.1", "subs.2", "completed.0", "marker.4", "once_regsizes.0",
    # the host's newer libgcc (gcc 15; the CMake build links on the host since
    # Phase 6b) registers unwind frames in a b-tree, unwind-dw2-fde.c's
    # version-lock statics -- the container's gcc 10 libgcc had none of these
    "version_lock_mutex", "version_lock_cond", "registered_objects",
    "registered_frames", "in_shutdown",
))


def so_path(side, config):
    """The .so the build links (farm/<config>/build/out/<side>.so): the link
    edge's own output, before the deploy step splits or copies it."""
    try:
        return cmakegraph.link_edge(cmakegraph.SIDES[side], build_for(config))["output"]
    except cmakegraph.GraphError as e:
        die(str(e))


def so_state(path):
    """[(mangled, demangled, bind, addr)] of mutable symbols in the linked .so.

    Deduped on (address, name, bind): .symtab and .dynsym both describe the
    same symbol and `readelf -sW` prints both tables. Without the dedup every
    exported global counts twice and the reconciliation is off by the size of
    .dynsym rather than by anything real.

    The four vec constants are excluded here by DEMANGLED name. On the object
    side the exclusion is pinned to public/mathlib/vector{2,4}d.h; here there is
    no per-symbol DWARF file to pin it to, so `reconcile` checks that every
    instance excluded here is a FILE-LOCAL `_ZL<n>vec...`, which is the only
    shape those four header definitions can take, and that the four names have
    exactly one definition site in the tree.
    """
    rows, seen = [], set()
    secs = sections(path)
    for line in sh("readelf", "-sW", path).splitlines():
        p = line.split()
        if len(p) < 8 or not p[0].rstrip(":").isdigit():
            continue
        _, value, size, typ, bind, _, ndx, name = p[:8]
        if typ not in ("OBJECT", "TLS", "GNU_UNIQUE") or not ndx.isdigit():
            continue
        if kind_of(secs.get(int(ndx), "")) not in MUTABLE_KINDS:
            continue
        key = (value, name, bind)
        if key in seen:
            continue
        seen.add(key)
        rows.append((name, bind, value))
    dm = demangle(sorted({n for n, _, _ in rows}))
    kept, excluded_vec = [], []
    for n, b, v in rows:
        d = dm.get(n, n)
        if d.startswith("guard variable for "):
            continue
        if d in VEC_CONSTANTS:
            excluded_vec.append(n)
            continue
        kept.append((n, d, b, v))
    return kept, excluded_vec


# nm type letters that are a DEFINITION OF DATA. `u` is in it because a
# function-local static in an inline template is GNU_UNIQUE, and leaving it out
# left 12 CDmxElement/CDmxAttribute `defaultValue` instantiations looking as
# though nothing on the link line defined them. V/v are weak data. A plain nm
# with no type filter counts undefined rows as definitions
# (memory: nm-without-symbol-type-inflates).
ARCHIVE_DATA_TYPES = frozenset("BbDdGgSsuVv")


def archive_state(archives):
    """{mangled: True} for every mutable symbol any link-line archive defines."""
    out = set()
    env = dict(os.environ, LC_ALL="C")
    for a in archives:
        p = os.path.join(SRC, a)
        if not os.path.exists(p):
            continue
        r = subprocess.run(["nm", "--defined-only", p], capture_output=True,
                           text=True, errors="replace", env=env)
        for line in r.stdout.splitlines():
            f = line.split()
            if len(f) >= 3 and len(f[1]) == 1 and f[1] in ARCHIVE_DATA_TYPES:
                out.add(f[2])
    return out


def built_archives(bdir):
    """The archives the BUILD produces, as opposed to the prebuilt ones.

    Of the six on the server link edge only mathlib and tier1 are
    `build lib/libX.a: CXX_STATIC_LIBRARY_LINKER__...` outputs; dmxloader.a,
    particles.a, tier2.a and tier3.a are Valve's prebuilts in the farm. The
    distinction is the whole point of archives_are_current(): a prebuilt
    archive's mtime says when it was last written, which after any checkout is
    newer than everything and means nothing. Absolute paths.
    """
    out = set()
    try:
        with open(os.path.join(bdir, "build.ninja"), errors="replace") as fh:
            for line in fh:
                m = re.match(r"^build (\S+\.a)\s*:\s*\S*STATIC_LIBRARY_LINKER", line)
                if m:
                    a = m.group(1)
                    out.add(a if os.path.isabs(a) else os.path.join(bdir, a))
    except OSError as e:
        die("cannot read %s/build.ninja: %s" % (bdir, e))
    return out


def archives_are_current(archives, sop, built):
    """The BUILT archives whose mtime is NEWER than the .so they link into.

    Under VPC `lib/public/linux64/*.a` WAS NOT CONFIG-QUALIFIED: the debug and
    the release graph both wrote that one path, so `make debug && make release`
    left the RELEASE archives on disk beside a DEBUG .so. Measured on
    2026-09-21: mathlib.a and tier1.a at 05:39:40, debug server.so at 05:39:17,
    and the reconciliation that resulted left 476 instances unattributed. The
    CMake build writes each config's archives into its own build dir, so that
    route is closed -- but an archive newer than the .so still means the .so
    was linked against something that is gone (an interrupted build), so the
    check stays.

    This is the `gitignored-build-output-decides-a-verdict` shape, so it is a
    REFUSAL and not a warning. Only the BUILT archives can go stale this way;
    the prebuilt ones are the same bytes in both configs.
    """
    try:
        so_mtime = os.path.getmtime(sop)
    except OSError:
        return []
    newer = []
    for a in archives:
        if a not in built:
            continue
        try:
            if os.path.getmtime(a if os.path.isabs(a) else os.path.join(SRC, a)) > so_mtime:
                newer.append(a)
        except OSError:
            pass
    return newer


def reconcilable_config(side, prefer=None):
    """The config whose BUILT archives are not newer than its .so, or None.

    `make debug && make release` writes both configs' archives to the one
    uncoinfig-qualified path lib/public/linux64/*.a, so at most one config is
    ever reconcilable at a time and WHICH ONE depends on which was built last.
    Choosing it here is what keeps a gate from reddening because somebody ran
    `make release`; when NEITHER is reconcilable the refusal still stands,
    because then the measurement really is impossible.
    """
    order = ([prefer] if prefer else []) + [c for c in CONFIGS if c != prefer]
    for cfg in order:
        bdir = build_for(cfg)
        if not os.path.exists(os.path.join(bdir, "build.ninja")):
            continue
        sop = so_path(side, cfg)
        if not os.path.exists(sop):
            continue
        objects, archives = link_edge(bdir, side)
        if not objects:
            continue
        # No archive on the line (server.so since libmathlib.a left it, for
        # mathlib_port.cpp): nothing can be newer than the .so, so the config
        # is reconcilable. Skipping it instead left NEITHER config reconcilable
        # and refused a measurement that had nothing to go stale.
        if not archives or not archives_are_current(archives, sop, built_archives(bdir)):
            return cfg
    return None


def partition_so(so, obj_global, obj_local, arch):
    """(from_objects, from_archives, from_crt, unattributed).

    THE RESIDUE IS THE MEASUREMENT. Each .so symbol is attributed to exactly one
    INDEPENDENTLY derived source, and whatever is left over is reported by name.

    The first draft of the reconciliation defined "from an archive" as "in the
    .so and not in an object", which made `objects - dropped + archives == so`
    true by construction: it could not fail, so it measured nothing. Mutating
    the `elif n in arch` below to `elif True` reproduces that draft, and on a
    healthy tree it leaves UNATTRIBUTED at 0 either way -- which is why
    --self-test drives this function over a fixture rather than trusting the
    live number.
    """
    from_objects = from_archives = from_crt = 0
    unattributed = []
    # The objects own as many copies of a name as they EMIT, not every copy
    # the .so holds: a file-local name that an archive also emits is two
    # pieces of state, one from each (see the self-test's _so3).
    owned = collections.Counter(obj_local)
    for n in obj_global:
        owned[n] += 1
    for n, d, b, v in so:
        if owned[n] > 0:
            owned[n] -= 1
            from_objects += 1
        elif n in arch:
            from_archives += 1
        elif n in CRT_SYMBOLS or d in CRT_SYMBOLS:
            from_crt += 1
        else:
            unattributed.append((n, d))
    return from_objects, from_archives, from_crt, unattributed


def reconcile(side, config, mtime_policy):
    """(report_lines, agreed)."""
    rows, objs, archives = take_census(side, config, mtime_policy)
    link = link_level(rows)

    sop = so_path(side, config)
    if not os.path.exists(sop):
        die("the linked %s is not on disk: %s -- build before reconciling"
            % (os.path.basename(sop), sop))

    newer = archives_are_current(archives, sop, built_archives(build_for(config)))
    if newer:
        die("%d link-line archive%s NEWER than %s (first: %s).\n"
            "    This .so was linked against archives that have since been\n"
            "    rewritten (an interrupted or partial build). Rebuild this\n"
            "    config, then reconcile.\n"
            "    (Only the archives the build produces can go stale this way;\n"
            "    the prebuilt ones are the same bytes in both configs.)"
            % (len(newer), "" if len(newer) == 1 else "s",
               os.path.relpath(sop, SRC), newer[0]))

    so, so_vec = so_state(sop)
    so_names = collections.Counter(n for n, _, _, _ in so)

    obj_local = collections.Counter(r.mangled for r in rows
                                    if is_state(r) and r.bind == "LOCAL")
    obj_global = {r.mangled for r in rows if is_state(r) and r.bind != "LOCAL"}

    dropped = [n for n in sorted(obj_global) if n not in so_names]
    for n, c in sorted(obj_local.items()):
        have = so_names.get(n, 0)
        if have < c:
            dropped.extend([n] * (c - have))

    arch = archive_state(archives)

    from_objects, from_archives, from_crt, unattributed = partition_so(
        so, obj_global, obj_local, arch)

    # The vec exclusion's subject check: on this side it is keyed on the
    # demangled name, so prove every instance it dropped is the file-local
    # shape the mathlib header definitions produce.
    bad_vec = [n for n in so_vec if not re.match(r"^_ZL\d+vec[24]_", n)]

    agreed = not unattributed and not bad_vec
    accounted = from_objects + from_archives + from_crt

    out = provenance((("side", side), ("config", config),
                      ("objects", len(objs)), ("archives", len(archives))))
    out.append("# ---- instrument 1: the link-line objects ----")
    out.append("link_level\t%d" % len(link))
    out.append("linker_dropped\t%d" % len(dropped))
    out.append("# ---- instrument 2: the linked .so, partitioned ----")
    out.append("so_mutable\t%d" % len(so))
    out.append("  from_link_line_objects\t%d" % from_objects)
    out.append("  from_an_archive\t%d" % from_archives)
    out.append("  from_the_c_runtime\t%d" % from_crt)
    out.append("  UNATTRIBUTED\t%d" % len(unattributed))
    out.append("so_vec_constants_excluded\t%d" % len(so_vec))
    out.append("so_vec_not_file_local\t%d" % len(bad_vec))
    out.append("# ---- the identity ----")
    out.append("# link_level - linker_dropped == from_link_line_objects")
    out.append("objects_side\t%d - %d = %d\tvs from_link_line_objects %d\t%s"
               % (len(link), len(dropped), len(link) - len(dropped), from_objects,
                  "AGREE" if len(link) - len(dropped) == from_objects else "DISAGREE"))
    out.append("# every .so symbol has exactly one source")
    out.append("partition\t%d + %d + %d = %d\tvs so_mutable %d\t%s"
               % (from_objects, from_archives, from_crt, accounted, len(so),
                  "AGREE" if accounted == len(so) else "DISAGREE"))
    for n, d in unattributed[:25]:
        out.append("# unattributed\t%s\t%s" % (n, d))
    for n in bad_vec[:10]:
        out.append("# vec_not_file_local\t%s" % n)
    out.append("reconcile\t%s" % ("AGREE" if agreed else "DISAGREE"))
    if len(link) - len(dropped) != from_objects:
        agreed = False
    return out, agreed


# ---------------------------------------------------------------------------
# the ledger and the gate
# ---------------------------------------------------------------------------

# `mangled` and not `name` is the KEY, and the reason is one row: studio.o
# holds two distinct statics that both demangle to
# `CStudioHdr::GroupStudioHdr(int)::__executeCount`. Keyed on the demangled
# name they collapse into one row, the gate reports the other as a symbol with
# no ledger row, and the link level reads 468 instead of 469. `name` is carried
# beside it so the file is readable, but nothing joins on it.
LEDGER_COLUMNS = ("home", "mangled", "name", "tu", "bind", "kind", "scope",
                  "size", "disposition", "owner", "reason")


def read_ledger(path=None):
    """{(home, mangled): rowdict}, keyed exactly as link_key(): `home` is the
    object basename for a LOCAL symbol and the empty string for a folded one."""
    path = path or LEDGER
    out = {}
    if not os.path.exists(path):
        return out
    with open(path, errors="replace") as fh:
        for line in fh:
            if not line.strip() or line.startswith("#"):
                continue
            f = line.rstrip("\n").split("\t")
            if f[0] == "home":
                continue
            row = dict(zip(LEDGER_COLUMNS, f + [""] * len(LEDGER_COLUMNS)))
            out[(row["home"], row["mangled"])] = row
    return out


# ---------------------------------------------------------------------------
# what the instrument may derive, and what it must leave to a human
#
# Only two rules fire, and each is a fact the tree states rather than a reading
# of intent:
#
#   DEAD   the linker DROPPED it. Nothing in the shipped DLL reads it, which is
#          the strongest 0-consumer proof available and is re-derivable at any
#          tip. 33 rows on this tree.
#   FLOOR  it is static-init REGISTRATION, or it belongs to a header outside
#          this port. `__g_Create*_reg` InterfaceReg nodes, the DLL instance
#          whose address EXPOSE_SINGLE_INTERFACE_GLOBALVAR takes at static-init,
#          the two stock chains the engine walks, the Steam SDK's own inline
#          accessor cells under public/steam/, and the unwinder's DW.ref.
#
# Everything else is UNRULED. That is an ADMISSION, not a disposition: MEMBER,
# MANAGED and CONST each need a human to read the code and name a consumer or a
# managed home, and a tool that guessed them would produce a ledger nobody had
# read row by row -- the exact failure `tools/shim-census`'s passthrough
# classifier was caught by. The UNRULED count is capped in
# docs/globals-ratchet.tsv and is the number this plan exists to drive to zero.
# ---------------------------------------------------------------------------


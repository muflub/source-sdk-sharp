def capture_inner(lg, outdir):
    os.makedirs(outdir, exist_ok=True)
    so = os.path.join(REPO, "bin", lg.CONFIG, "bin", "linux64", "server.so")
    exports = subprocess.run(["nm", "-D", "--defined-only", so], stdout=subprocess.PIPE,
                             text=True, check=True).stdout
    names = sorted(l.split()[-1] for l in exports.splitlines() if l.strip())
    with open(os.path.join(outdir, "exports.txt"), "w") as f:
        f.write("\n".join(names) + "\n")

    tmp = tempfile.mkdtemp(prefix="nv-snap-")
    alloc_log = os.path.abspath(os.path.join(outdir, "alloc_check.log"))
    if os.path.exists(alloc_log):
        os.unlink(alloc_log)
    log_path = os.path.join(tmp, "launch.log")
    console = os.path.join(lg.MOD_DIR, "console.log")
    before = os.path.getsize(console) if os.path.isfile(console) else 0
    game, port = lg.launch_with_free_port(lambda p: lg.server_launch(p, "dm_lockdown"),
                                          log_path, tmp,
                                          extra_env={"SOURCESHARP_NOVALVE_SNAPSHOT": "1",
                                                     "SOURCESHARP_ALLOC_CHECK_LOG": alloc_log})
    if game is None:
        print("novalve-snapshot: the game did not come up; see", log_path)
        return 1
    try:
        api = game.api
        if not api.wait_for(lambda: api.census()[0] > 0, 120.0, 1.0):
            print("novalve-snapshot: the map never populated")
            return 1
        census = api.census()
        with open(os.path.join(outdir, "entities.txt"), "w") as f:
            f.write("%s\n" % (census,))
        for name, args, drop in (("convars.txt", ("convars", "all"), ("value",)),
                                 ("commands.txt", ("commands", "all"), ()),
                                 ("nettables.txt", ("nettables",), ())):
            text = api.raw(*args, timeout=60)
            with open(os.path.join(outdir, name), "w") as f:
                f.write(normalise_json(text, drop) + "\n")
            if name == "convars.txt":
                with open(os.path.join(outdir, "convars-contract.txt"), "w") as f:
                    f.write(contract(text, ("default", "help", "min", "max")) + "\n")
            elif name == "commands.txt":
                with open(os.path.join(outdir, "commands-contract.txt"), "w") as f:
                    f.write(contract(text, ("help",)) + "\n")
        # Asked to quit, not killed: the allocation checker's report is written
        # when server.so unloads, and SIGKILL would skip it.
        api.cmd("quit")
        try:
            game.popen.wait(timeout=90)
        except Exception:
            print("novalve-snapshot: the game did not quit within 90s; killed")
    finally:
        game.kill()
    with open(console, errors="replace") as f:
        f.seek(before)
        marks = sorted(m.group(0) for m in (MARKER.search(l) for l in f) if m)
    with open(os.path.join(outdir, "markers.txt"), "w") as f:
        f.write("\n".join(marks) + ("\n" if marks else ""))

    if check_particle_defs(marks):
        return 1
    if check_alloc(so, alloc_log):
        return 1

    empty = [n for n in FILES if n != "markers.txt"
             and os.path.getsize(os.path.join(outdir, n)) < 3]
    if empty:
        print("novalve-snapshot: EMPTY capture:", ", ".join(empty))
        return 1
    print("novalve-snapshot: wrote %s (%d exports, %d marker lines)"
          % (outdir, len(names), len(marks)))
    return 0



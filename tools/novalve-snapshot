        at = api.player("ss_player")["origin"]
        # A spawn point stands a little above the floor and the player drops
        # onto it: horizontal within 2 units, height within 24.
        if distance(at[:2], pose[0][:2]) > 2.0 or abs(float(at[2]) - pose[0][2]) > 24.0:
            print("novalve-snapshot: setpos_exact did not take: at %s, wanted %s" % (at, pose[0]))

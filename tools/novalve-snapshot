             if os.path.getsize(os.path.join(outdir, n)) < 3]
    if empty:
        print("novalve-snapshot: EMPTY capture:", ", ".join(empty))
        return 1
    print("novalve-snapshot: wrote %s (%d exports, %d interfaces)"
          % (outdir, len(names), len(interfaces)))
    return 0


def distance(a, b):
    return sum((float(x) - float(y)) ** 2 for x, y in zip(a, b)) ** 0.5


def numbers(value):
    if isinstance(value, str):
        return [float(x) for x in value.split()]
    return [float(x) for x in value]


SPAWN_PREFIX = "info_player_"


def first_spawn(ents):
    """(origin, angles) of the first entity, in the order given, whose class
    is an info_player_* spawn point, or None. PURE."""
    for e in ents:
        if str(e.get("classname", "")).startswith(SPAWN_PREFIX) and e.get("origin") is not None:
            return numbers(e["origin"]), numbers(e.get("angles") or [0, 0, 0])
    return None


def fixed_pose(api):
    """first_spawn over the live entity list in index order. Not /map/entities:
    dm_lockdown is in the game's VPK, which that route does not read."""
    try:
        ents = sorted(api.ents("*"), key=lambda e: e.get("index", 0))
    except Exception as e:  # ApiError lives in live-gate's module
        print("novalve-snapshot: the entity list did not answer: %s" % e)
        return None
    pose = first_spawn(ents)
    if pose is None:
        print("novalve-snapshot: %d live entities, classes %s"
              % (len(ents), sorted({e.get("classname") for e in ents})[:40]))
    return pose


def diff(a, b):
    bad = 0
    files = FILES if os.path.isfile(os.path.join(a, FILES[0])) else ()
    if os.path.isfile(os.path.join(a, CLIENT_FILES[0])):
        files += CLIENT_FILES
    if not files:
        print("MISSING: %s holds neither a server nor a client snapshot" % a)
        return 1
    if os.path.isfile(os.path.join(a, K6_FILE)):
        pa, pb = os.path.join(a, K6_FILE), os.path.join(b, K6_FILE)
        if not os.path.isfile(pb):
            print("MISSING", K6_FILE)
            bad += 1
        else:
            problems = k6_compare(open(pa).read(), open(pb).read())
            print(("DIFFERS %s\n  " % K6_FILE + "\n  ".join(problems)) if problems
                  else "same    %s (no size fell, no binary left)" % K6_FILE)
            bad += 1 if problems else 0
    for n in files:
        pa, pb = os.path.join(a, n), os.path.join(b, n)
        if not (os.path.isfile(pa) and os.path.isfile(pb)):
            print("MISSING", n)
            bad += 1
            continue
        unmeasured = [p for p in (pa, pb) if open(p).read().startswith(NOT_MEASURED)]
        if unmeasured:
            print("NOT MEASURED %s (%s): two placeholders are not a comparison"
                  % (n, ", ".join(unmeasured)))
            bad += 1
            continue
        p = subprocess.run(["diff", "-u", pa, pb], stdout=subprocess.PIPE, text=True)
        if p.returncode != 0:
            bad += 1
            lines = p.stdout.splitlines()
            print("DIFFERS %s (%d diff lines)" % (n, len(lines)))
            print("\n".join(lines[:40]))
        else:
            print("same    %s" % n)
    return 1 if bad else 0


def main(argv):
    if argv == ["--self-test"]:
        return self_test()
    if len(argv) == 3 and argv[0] == "--diff":
        return diff(argv[1], argv[2])
    if len(argv) == 1 and not argv[0].startswith("-"):
        return capture(argv[0])
    if len(argv) == 2 and argv[0] == "--client":
        return capture_client(argv[1])
    if len(argv) == 2 and argv[0] == "--particle-fixture":
        return capture(argv[1], fixture=True)
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

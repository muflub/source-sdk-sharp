CLIENT_FILES = ("client-exports.txt", "client-interfaces.txt",
                "client-convars-contract.txt", "client-commands-contract.txt",
                "client-nettables.txt", "client-effects.txt")
K6_FILE = "k6-legfloor.txt"
NOT_MEASURED = "# NOT MEASURED"
REGISTRY_SYMBOL = "_ZN12InterfaceReg16s_pInterfaceRegsE"
EFFECTS_HEADER = "effect draws (7a):"
EFFECT_ROW = re.compile(r"^\s{2}([a-z][a-z ]*[a-z])\s+(-?\d+)\s*$")
EFFECT_WINDOW = 6.0


def u64(b):
    return int.from_bytes(b, "little")


def read_cstr(read_mem, addr, limit=512):
    """A NUL-terminated string at addr through read_mem(addr, n). PURE given
    read_mem."""
    out = b""
    while len(out) < limit:
        chunk = read_mem(addr + len(out), 64)
        if not chunk:
            break
        i = chunk.find(b"\0")
        if i >= 0:
            return (out + chunk[:i]).decode("latin-1")
        out += chunk
    raise ValueError("no NUL within %d bytes at %#x" % (limit, addr))


def walk_registry(read_mem, head_addr, limit=4096):
    """The names on tier1's InterfaceReg list whose head pointer is at
    head_addr. InterfaceReg is { m_CreateFn, m_pName, m_pNext } (three
    pointers, public/tier1/interface.h). A cycle or an over-long list is an
    error, never a truncated answer. PURE given read_mem."""
    node = u64(read_mem(head_addr, 8))
    names, seen = [], set()
    while node:
        if node in seen or len(names) >= limit:
            raise ValueError("the InterfaceReg list does not end (node %#x)" % node)
        seen.add(node)
        raw = read_mem(node, 24)
        if len(raw) != 24:
            raise ValueError("short read of an InterfaceReg at %#x" % node)
        names.append(read_cstr(read_mem, u64(raw[8:16])))
        node = u64(raw[16:24])
    return names


def load_bias(maps_text, so_name, first_load):
    """(path, bias) of so_name in a /proc/PID/maps text: the mapping of file
    offset first_load[0] minus first_load's vaddr. None when not mapped. PURE."""
    off, vaddr = first_load
    for line in maps_text.splitlines():
        parts = line.split()
        if len(parts) < 6 or not parts[5].endswith("/" + so_name):
            continue
        start = int(parts[0].split("-")[0], 16)
        if int(parts[2], 16) == off:
            return parts[5], start - vaddr
    return None


def first_load_segment(path):
    """(file offset, vaddr) of the first PT_LOAD in path, by readelf -lW."""
    out = subprocess.run(["readelf", "-lW", path], stdout=subprocess.PIPE, text=True,
                         check=True).stdout
    for line in out.splitlines():
        parts = line.split()
        if parts[:1] == ["LOAD"]:
            return int(parts[1], 16), int(parts[2], 16)
    raise RuntimeError("no PT_LOAD in %s" % path)


def symbol_value(path, name):
    out = subprocess.run(["nm", path], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                         text=True).stdout
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 3 and parts[2] == name:
            return int(parts[0], 16)
    return None


def live_registry(pid, so_name="client.so"):
    """The CreateInterface names so_name registered, read from the running
    game's memory. Raises on anything that would make the answer a guess."""
    with open("/proc/%s/maps" % pid) as f:
        maps = f.read()
    path = next((l.split()[5] for l in maps.splitlines()
                 if len(l.split()) >= 6 and l.split()[5].endswith("/" + so_name)), None)
    if path is None:
        raise RuntimeError("%s is not mapped in process %s" % (so_name, pid))
    where = load_bias(maps, so_name, first_load_segment(path))
    if where is None:
        raise RuntimeError("no mapping of %s's first segment in process %s" % (so_name, pid))
    sym = symbol_value(path, REGISTRY_SYMBOL)
    if sym is None:
        raise RuntimeError("%s has no %s in its symbol table (stripped?)" % (path, REGISTRY_SYMBOL))
    with open("/proc/%s/mem" % pid, "rb", buffering=0) as mem:
        def read_mem(addr, n):
            mem.seek(addr)
            return mem.read(n)
        return walk_registry(read_mem, where[1] + sym)


def client_rows(contract_text):
    """The rows of a *-contract.txt whose flags (the last field) carry
    ClientDll. PURE."""
    out = []
    for line in contract_text.splitlines():
        fields = line.split("\t")
        if len(fields) >= 2 and "ClientDll" in fields[-1].split(","):
            out.append(line)
    return out


def parse_effects(text):
    """{row: count} from the LAST cs_cl_effects_report block in a console
    text; {} when there is none. PURE."""
    i = text.rfind(EFFECTS_HEADER)
    if i < 0:
        return {}
    out = {}
    for line in text[i:].splitlines()[1:]:
        m = EFFECT_ROW.match(line)
        if m:
            out[m.group(1)] = int(m.group(2))
        elif line.strip() and not line.startswith("  "):
            break
        elif "[SourceSharp" in line:
            break
    return out


def effects_files(before, after):
    """(diffed text, raw text) of an effect window: per row, moved or still;
    the raw numbers separately. A row in one reading only is an error. PURE."""
    if not before or set(before) != set(after):
        raise ValueError("the two effect readings name different rows: %s / %s"
                         % (sorted(before), sorted(after)))
    diffed = ["%s\t%s" % (k, "moved" if after[k] > before[k] else "still")
              for k in sorted(after)]
    raw = ["%s\t%d\t%d\t%d" % (k, before[k], after[k], after[k] - before[k])
           for k in sorted(after)]
    return "\n".join(diffed) + "\n", "row\tbefore\tafter\tdelta\n" + "\n".join(raw) + "\n"


def legfloor_snapshot(list_text):
    """The K6 snapshot from tools/leg-floor --list: one line per declaration,
    "floor<TAB>leg<TAB>kind<TAB>op<TAB>N", and per roster entry,
    "roster<TAB>leg<TAB>kind<TAB>name", sorted. The derivation text is dropped:
    it carries the counts behind the floor, which K6 does not compare. PURE."""
    out = []
    for line in list_text.splitlines():
        parts = line.split()
        if len(parts) >= 5 and parts[1] == "[leg-floor]":
            out.append("floor\t%s\t%s\t%s\t%s" % (parts[0], parts[2], parts[3], parts[4]))
        elif len(parts) == 4 and parts[1] == "[leg-roster]":
            out.append("roster\t%s\t%s\t%s" % (parts[0], parts[2], parts[3]))
    return sorted(out)


def parse_legfloor(text):
    """({(leg, kind): (op, value)}, {"leg kind name"}) from a K6 snapshot.
    PURE."""
    floors, roster = {}, set()
    for line in text.splitlines():
        f = line.split("\t")
        if f[0] == "floor" and len(f) == 5:
            floors[(f[1], f[2])] = (f[3], int(f[4]))
        elif f[0] == "roster" and len(f) == 4:
            roster.add(" ".join(f[1:]))
    return floors, roster


def k6_compare(a_text, b_text):
    """K6: problems going from snapshot A to B. A declared size may rise,
    never fall; a roster entry that leaves is named (a deletion needs its
    commit to name it). PURE."""
    fa, ra = parse_legfloor(a_text)
    fb, rb = parse_legfloor(b_text)
    if not fa:
        return ["the baseline declares no leg: nothing to compare"]
    problems = []
    for key, (_, va) in sorted(fa.items()):
        if key not in fb:
            problems.append("%s %s: declared in A, missing in B" % key)
        elif fb[key][1] < va:
            problems.append("%s %s: %d -> %d (fell)" % (key[0], key[1], va, fb[key][1]))
    for gone in sorted(ra - rb):
        problems.append("left the roster: %s" % gone)
    return problems



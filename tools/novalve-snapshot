def check_particle_defs(marks):
    """The native manager's definitions and flags against the managed reader's.

    Only when the build logs both (the P2.1 differential); a list with
    neither is not a failure, a list with one side only is."""
    native = sorted(m.split("] ", 1)[1] for m in marks
                    if m.startswith("[novalve-snapshot:particle-def] "))
    managed = sorted(m.split("] ", 1)[1] for m in marks
                     if m.startswith("[novalve-snapshot:particle-def-managed] "))
    if not native and not managed:
        return 0
    if native != managed:
        only_n = sorted(set(native) - set(managed))
        only_m = sorted(set(managed) - set(native))
        print("novalve-snapshot: particle definitions DIFFER: %d native, %d managed"
              % (len(native), len(managed)))
        for x in only_n[:10]:
            print("   native only:  " + x)
        for x in only_m[:10]:
            print("   managed only: " + x)
        return 1
    flagged = sum(1 for x in native if x.endswith(" 1"))
    print("novalve-snapshot: particle definitions agree: %d, %d always-precache"
          % (len(native), flagged))
    return 0



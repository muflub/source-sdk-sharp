            return 1
        with open(os.path.join(outdir, "client-effects.txt"), "w") as f:
            f.write("# pose %s %s, window %.0fs\n" % (pose[0], pose[1], EFFECT_WINDOW) + diffed)
        with open(os.path.join(outdir, "client-effects-raw.txt"), "w") as f:
            f.write(raw)
        api.cmd("quit")

# that changed level keeps naming the map it booted with. Run B at ae4cdda88
# showed it: three changelevels to pl_badwater, and host_map never left
# ctf_2fort while the console named the truth every load.
LEVEL_INIT_RE = re.compile(r"\[SourceSharp/Server\] level init: (\S+)")


def current_server_map(text):
    """The map name of the LAST level-init line in the console's text (the
    shape read_console_since_launch answers -- a whole string, not a list),
    None if the text holds none (never a zero or a guess: no line is no
    answer). Pure: the self-test holds it."""
    found = None
    for m in LEVEL_INIT_RE.finditer(text or ""):
        found = m.group(1)
    return found


VBSP_IDENT = 0x50534256          # "VBSP" as the header's little-endian int32
ENTITY_LUMP = 0                  # the lump table's first entry
LUMP_DESCRIPTOR_BASE = 8         # version, then 64 descriptors of 16 bytes
# public/tier1/lzmaDecoder.h's lzma_header_t, packed: id, actualSize,
# lzmaSize (3 uint32) and properties[5]. CLZMA::Uncompress hands LzmaDecode
# the stream at pInput + sizeof(lzma_header_t) with LZMA_PROPS_SIZE 5.
LZMA_HEADER_SIZE = 3 * 4 + 5
LZMA_ID = 0x414D5A4C              # ('A'<<24)|('M'<<16)|('Z'<<8)|('L')

try:
    import lzma as _lzma
except ImportError:                            # ancient python: no raw-LZMA decode
    _lzma = None


def lzma_module():
    """The stdlib lzma module or None: a compressed lump needs it, and a
    census that cannot decode the file fails naming that, never passes."""
    return _lzma


def lzma_codec_props(props):
    """(lc, lp, pb) from the 5 LZMA property bytes. The SDK packs the first
    byte as d = (pb*5 + lp)*9 + lc (LzmaDec.h's LzmaDec_SetToDefaults /
    LzmaEnc's props byte), so pb = d // 45, lp = (d % 45) // 9, lc = d % 9.
    Pure: the self-test holds it against Valve's default 0x5D -> (3, 0, 2)."""
    d = props[0]
    pb = d // 45
    d %= 45
    lp = d // 9
    lc = d % 9
    if lc + lp > 4:                              # LzmaDec's own bound (LzmaDec.c)
        raise ValueError("bad LZMA properties byte 0x%02x (lc %d lp %d)" % (props[0], lc, lp))
    return lc, lp, pb


def lzma_decode_entity_stream(props, actual, stream):
    """Decompress one CLZMA entity lump: the 5 LZMA property bytes, the
    uncompressed size and the raw stream. Two container paths, tried in
    order, both grounded in how the bytes are laid out:

      alone  -- props(5) + dict_size(4) + size(8 LE) is exactly the .lzma
                ALONE header (LzmaEnc's own), so the raw stream becomes a
                self-describing ALONE container and needs no filter spec;
      raw    -- FORMAT_RAW with the one LZMA1 filter the header names
                (the CLZMA::Uncompress spelling, LzmaDecode at raw+17).

    The interpreter names its decoder LZMADecoder or LZMADecompressor
    (this box's 3.14 the latter -- its lzma.py's decompress() says so) and
    an old bindings object may want the ALONE arm as an alone=True flag:
    every accepted spelling is tried, and if none decodes the exact size
    the file recorded, it raises -- never a silent zero. Pure enough for
    the self-test, which feeds it a stream the xz CLI really encoded."""
    dec_cls = getattr(_lzma, "LZMADecoder", None) or getattr(_lzma, "LZMADecompressor", None)
    if dec_cls is None:
        raise ValueError("the lzma module answers no decoder class")
    dict_size = int.from_bytes(props[1:5], "little")
    alone = (bytes(props) + dict_size.to_bytes(4, "little")
             + actual.to_bytes(8, "little") + bytes(stream))
    def feed(dec, blob):
        # Two decoder shapes exist in the wild: the streaming one with
        # write/flush, and this box's 3.14 one with decompress/eof (the
        # bz2-style surface its dir() shows). Take whichever it answers.
        if hasattr(dec, "decompress"):
            out = dec.decompress(blob)
            if hasattr(dec, "flush") and not getattr(dec, "eof", False):
                try:
                    out += dec.flush()
                except (EOFError, _lzma.LZMAError):
                    pass                      # an unterminated raw stream:
            return out                          # len is checked by the caller
        out = dec.write(blob)
        if hasattr(dec, "flush"):
            out += dec.flush()
        return out

    last = "no path ran"
    reasons = []
    for attempt in ("auto", "alone", "raw", "raw-marker"):
        try:
            if attempt == "auto":
                dec = dec_cls()                     # FORMAT_AUTO reads the
                blob = alone                        # alone magic itself
            elif attempt == "alone":
                try:
                    dec = dec_cls(format=_lzma.FORMAT_ALONE)
                except (TypeError, ValueError):
                    dec = dec_cls(alone=True)       # the old bindings' flag
                blob = alone
            else:
                lc, lp, pb = lzma_codec_props(props)
                filt = {"id": _lzma.FILTER_LZMA1,
                        "lc": lc, "lp": lp, "pb": pb, "dict_size": dict_size}
                if attempt == "raw":
                    dec = dec_cls(format=_lzma.FORMAT_RAW,
                                  filters=[dict(filt, size=actual)])
                else:                               # decoder hunts the end
                    dec = dec_cls(format=_lzma.FORMAT_RAW, filters=[filt])
                blob = bytes(stream)
            out = feed(dec, blob)
            if len(out) == actual:
                return out
            last = "%s path decoded %d bytes, the file says %d" % (attempt, len(out), actual)
        except (ValueError, TypeError, AttributeError, EOFError,
                _lzma.LZMAError) as why:
            last = "%s path: %s" % (attempt, why)
        reasons.append(last)
    raise ValueError("neither LZMA container path decoded the lump (%s)"
                     % "; ".join(reasons))


def baked_lump_entities(path):
    """The map's baked entities, read inside the gate from the .bsp bytes.

    The dev API's mapents reads only the MOD's own maps directory (where
    dm_lockdown.bsp lives); the TF2 content maps -- pl_badwater among them
    -- live in the content mount gameinfo.txt names, which is where the
    engine reads them and where no route looks (run C at ae4cdda88: mapents
    refused the instance's empty maps dir). So the gate reads the same
    bytes itself. The header check mirrors src/mapgen/BspEntities.cs: the
    VBSP ident, lump 0's descriptor (offset, length, fourCC), and a refusal
    of a compressed lump -- reading a compressed lump as text answers no
    entities at all, the silent pass CLAUDE.md forbids. A file that will
    not open, is not a BSP, or carries no classname RAISES: a census that
    cannot read the map fails, never passes.
    """
    size = os.path.getsize(path)
    with open(path, "rb") as fh:
        head = fh.read(LUMP_DESCRIPTOR_BASE + 16)
    if len(head) < LUMP_DESCRIPTOR_BASE + 16:
        raise ValueError("%s is too short for a BSP header" % path)
    if int.from_bytes(head[0:4], "little") != VBSP_IDENT:
        raise ValueError("%s does not start with VBSP" % path)
    at = LUMP_DESCRIPTOR_BASE + ENTITY_LUMP * 16
    offset = int.from_bytes(head[at:at + 4], "little")
    length = int.from_bytes(head[at + 4:at + 8], "little")
    four_cc = int.from_bytes(head[at + 12:at + 16], "little")
    if length <= 0 or offset + length > size:
        raise ValueError("%s's entity lump is out of bounds (offset %d len %d size %d)"
                         % (path, offset, length, size))
    with open(path, "rb") as fh:
        fh.seek(offset)
        raw = fh.read(length)
    if four_cc != 0:
        # A compressed lump: the engine reads these through CLZMA (its
        # header is 'LZMA' + the uncompressed size + the compressed size +
        # the 5 codec property bytes, then a raw LZMA stream --
        # public/tier1/lzmaDecoder.h's lzma_header_t, decoded in
        # tier1/lzmaDecoder.cpp's Uncompress). The fourCC field carries
        # the UNCOMPRESSED size (the engine's model loader asserts the LZMA header's
        # actualSize equals it, "Lump header disagrees with lzma header"),
        # so the decode is checked against the file's own recording, and
        # the descriptor's length is the compressed span -- as the engine's
        # lump->fileSize/Version pair reads it (bspfile.h).
        if len(raw) < LZMA_HEADER_SIZE or int.from_bytes(raw[0:4], "little") != LZMA_ID:
            raise ValueError("%s's entity lump says compressed (fourCC %d) but holds "
                             "no LZMA header (id %r)" % (path, four_cc, raw[0:4]))
        actual = int.from_bytes(raw[4:8], "little")
        lzma_size = int.from_bytes(raw[8:12], "little")
        if actual != four_cc:
            raise ValueError("%s: LZMA header actualSize %d disagrees with the lump "
                             "fourCC's %d" % (path, actual, four_cc))
        # The stream's own length lives in the LZMA header; feed exactly it
        # (tier1/lzmaDecoder.cpp's Uncompress does the same), so trailing
        # padding inside the descriptor's span cannot upset the decode.
        if LZMA_HEADER_SIZE + lzma_size > size - offset:
            raise ValueError("%s: LZMA header claims %d compressed bytes, only %d exist"
                             % (path, lzma_size, size - offset - LZMA_HEADER_SIZE))
        props = bytes(raw[12:LZMA_HEADER_SIZE])
        if _lzma is None:
            raise ValueError("%s's entity lump is compressed and this python has no lzma"
                             % path)
        out = lzma_decode_entity_stream(props, actual,
                                        raw[LZMA_HEADER_SIZE:LZMA_HEADER_SIZE + lzma_size])
        text = out.decode("latin-1")
    else:
        text = raw.decode("latin-1")                # BSP bytes are Latin-1
    entities = []
    for body in re.findall(r"\{([^{}]*)\}", text, re.DOTALL):
        kv = dict(re.findall(r'"([^"]*)"\s+"([^"]*)"', body))
        if not kv:
            continue
        kv.setdefault("classname", "worldspawn")   # as BspEntities.Parse: no name is the world
        entities.append(kv)
    if len(entities) < 2:
        raise ValueError("%s answered %d entities: not a usable entity lump"
                         % (path, len(entities)))
    return entities


def _content_maps(mapname):
    """Every place a named map's .bsp can live, in the order to try: the
    content mount the game itself reads (bin/debug/content, the tree make
    setup links), the Steam install spelled out, then this repo's own mod
    maps dir (where the committed dm_lockdown.bsp lives and the self-test
    measures the reader against)."""
    return [os.path.join(GAME_DIR, "content", "tf", "maps", mapname + ".bsp"),
            os.path.join(os.path.expanduser("~"), ".steam", "debian-installation",
                         "steamapps", "common", "Team Fortress 2", "tf", "maps",
                         mapname + ".bsp"),
            os.path.join(ROOT, "game", "mod_test", "maps", mapname + ".bsp")]


def baked_entity_counts(run, mapname):
    """(per-classname counts, source) of a map's BAKED entity lump -- the
    record-of-the-map the census compares against. /map/entities reads the
    file the game runs from the mod maps dir, so it answers first for
    dm_lockdown; a map it cannot see (the TF2 content mounts) is read from
    its bytes by baked_lump_counts. The census then holds live world,
    recording and file, and three-way agreement is what it asserts."""
    try:
        data = run.srv.get("mapents", mapname, timeout=60)
    except lg.ApiError:
        data = None
    if isinstance(data, dict) and "entities" in data:
        return count_by_classname(data["entities"]), "mapents"
    tried = []
    for path in _content_maps(mapname):
        if os.path.isfile(path):
            return count_by_classname(baked_lump_entities(path)), path
        tried.append(path)
    raise lg.ApiError("mapents %s answered %r and no content map was readable (%s)"
                      % (mapname, str(data)[:120], ", ".join(tried)))


def count_by_classname(entities):
    """classname -> count for a list of entity dicts (the baked-lump answer
    and, one day, any other listing): the census arithmetic, kept away from
    the dev API call so the self-test can hold it."""
    counts = {}
    for ent in entities:
        counts[ent.get("classname")] = counts.get(ent.get("classname"), 0) + 1
    return counts


def _ui_draws(run, index):
    try:
        return (run.srv.get("client", str(index), "ui") or {}).get("draws", [])
    except lg.ApiError:
        return None


def _ui_text_draw(run, index):
    draws = _ui_draws(run, index)
    if draws is None:
        return None
    return next((d for d in draws if d.get("kind") == "Text"), None)


def _fmt_ui(draws):
    if draws is None:
        return "unreachable"
    return "%d draws, %d Text" % (
        len(draws), sum(1 for d in draws if d.get("kind") == "Text"))


def step_changelevel(run, state):
    """Stage 4.2 step 7: changelevel to pl_badwater -- THE SECOND MAP LOAD,
    which is the point (live-gate's rule: keep a second load in every gate,
    reload bugs are invisible to single-load gates). Asserted: the server
    game's [SourceSharp/Hud] first-paint line appears again for the new
    map, both players are back in the entity list and alive (the joiner's
    client survived and rejoined), the joiner's HUD answers Text draws
    again through the server's proxy, and a census of the managed TF2
    classes equals the counts recorded once from the map file (cite: the
    dev API's baked-entity read, which this step also prints next to the
    live counts, so a row always shows map-against-game)."""
    numbers = {}

    paints_before = run.read_console_since_launch().count(PAINT_NEEDLE)
    draws_before = _ui_draws(run, run.p2)
    numbers["ui_before"] = _fmt_ui(draws_before)

    run.srv.cmd("changelevel %s" % BADWATER)

    # The server game's own first paint again, on the new map. The line
    # repeats per level load (UiRuntime paints once per build, and the
    # build is rebuilt across the level change), so the COUNT rising past
    # its pre-change value is the observation, not another copy of a line
    # that is already in the file.
    repainted = wait_pump(
        run, "changelevel: the server game's first paint on %s" % BADWATER,
        lambda: run.read_console_since_launch().count(PAINT_NEEDLE) > paints_before,
        180.0, 1.0)
    numbers["server_repaint"] = bool(repainted)
    if not repainted:
        numbers["paint_lines_before"] = paints_before
        numbers["paint_lines_now"] = run.read_console_since_launch().count(PAINT_NEEDLE)
        numbers["detail"] = ("the server game never painted again after changelevel %s"
                             % BADWATER)
        return "FAIL", numbers

    # The joiner is back and alive: the entity list shows both players and
    # the server says both are alive. (The engine reconnects its client
    # across a listen server's changelevel; live-gate's map-change step
    # calls this the rejoin, and asserts nothing about the client until it
    # holds -- the plan's rule: assert the join before any client reading.)
    both = wait_pump(
        run, "changelevel: both players back and alive on %s" % BADWATER,
        lambda: (lambda ix: len(ix) == 2 and all(run.is_alive(i) for i in ix) or None)(
            run.player_indices()), 180.0, 1.0)
    numbers["players_after"] = run.player_indices()
    if not both:
        numbers["detail"] = ("both players never came back alive through the changelevel"
                             " (entity list %r)" % (run.player_indices(),))
        return "FAIL", numbers

    # The players are NEW entities across the level change: the indices the
    # earlier steps recorded are the old entity list's. The host's own
    # player exists first after the reload (it is in-process), so -- same
    # reasoning as at launch -- the lowest index is player 1's again.
    players = sorted(run.player_indices())
    run.p1, run.p2 = players[0], players[1]
    numbers["p1_index_after"], numbers["p2_index_after"] = run.p1, run.p2

    # The joiner's HUD: after the rejoin, its ui channel answers Text draws
    # again. The question is asked live through the server's proxy (same
    # read the join step uses); during the load it answers nothing or
    # ApiError, and a draw seen now can only come from a HUD that painted
    # on the new level.
    client_painted = wait_pump(run, "changelevel: the joiner's HUD on %s" % BADWATER,
                               lambda: _ui_text_draw(run, run.p2), 120.0)
    numbers["ui_after"] = _fmt_ui(_ui_draws(run, run.p2))
    if not client_painted:
        numbers["detail"] = ("the joiner's HUD never painted on %s (before: %s, now: %s)"
                             % (BADWATER, numbers["ui_before"], numbers["ui_after"]))
        return "FAIL", numbers

    # -- the census ------------------------------------------------------------
    # The server console's last level-init line names the map the server game
    # is really on: the cheapest positive arm that this is a SECOND LOAD and
    # not a step that measured the old map again (the census classes
    # pl_badwater has and ctf_2fort not would say the same; the pair is the
    # proof). host_map is read beside it but GATES nothing: the engine sets
    # that convar only in Host_NewGame, so after a changelevel it keeps
    # naming the boot map (see LEVEL_INIT_RE's note).
    server_map = current_server_map(run.read_console_since_launch())
    numbers["server_map_after"] = server_map
    try:
        numbers["host_map_read"] = run.srv.convar("host_map").get("value")
    except lg.ApiError as why:
        numbers["host_map_read"] = "unreadable(%s)" % why
    if not (isinstance(server_map, str) and BADWATER in server_map.lower()):
        numbers["detail"] = ("the server's last level-init line does not name %s "
                             "after the changelevel: %r (host_map convar reads %r, "
                             "stale by design)" % (BADWATER, server_map, numbers["host_map_read"]))
        return "FAIL", numbers

    # The new map's own waiting-for-players window ends up front too.
    run.srv.cmd("mp_waitingforplayers_cancel 1")
    # And again once this map's own window is up (the send above can still
    # beat the arming by a round of seconds).
    end_the_wait_when_armed(run)

    # The map file beside the live world: the dev API's mapents answers for
    # the mod's own maps dir; a TF2 content map (pl_badwater is one) is read
    # from its bytes by the gate (see baked_entity_counts). The file is an
    # input: unreadable fails the step, it is never a skipped arm.
    try:
        baked, baked_src = baked_entity_counts(run, BADWATER)
        numbers["baked_source"] = baked_src
    except (lg.ApiError, ValueError, OSError) as why:
        numbers["detail"] = "the baked-entity read of %s failed: %s" % (BADWATER, why)
        return "FAIL", numbers
    numbers["baked_counts"] = ",".join("%s=%s" % (c, baked.get(c, 0))
                                       for c in sorted(BADWATER_COUNTS))

    def census():
        out = {}
        for cls in BADWATER_COUNTS:
            try:
                out[cls] = len(run.srv.ents(cls))
            except lg.ApiError:
                out[cls] = None
        return out

    def settled():
        # Three ways, one number: the live world, the recorded counts and
        # the map file must all answer the same for every class. live-vs-
        # file catches an entity the managed world dropped; file-vs-
        # recording catches the map drifting from what was recorded -- the
        # ratchet the plan's "recorded once from the map file" needs.
        got = census()
        numbers["_last_census"] = got
        if got != {c: BADWATER_COUNTS[c] for c in BADWATER_COUNTS}:
            return None
        if {c: baked.get(c, 0) for c in BADWATER_COUNTS} != {c: BADWATER_COUNTS[c]
                                                             for c in BADWATER_COUNTS}:
            return None
        return got or True

    got = wait_pump(run, "changelevel: the TF2 class census of %s" % BADWATER,
                    settled, 90.0, 2.0)
    final = numbers.pop("_last_census", None) or census()
    numbers["census"] = ",".join("%s=%s" % (c, final.get(c)) for c in sorted(BADWATER_COUNTS))
    numbers["recorded_counts"] = ",".join("%s=%s" % (c, BADWATER_COUNTS[c])
                                           for c in sorted(BADWATER_COUNTS))
    if got is None:
        numbers["detail"] = ("the census of %s disagrees three ways after the changelevel: "
                             "live %s / recorded %s / baked %s from %s"
                             % (BADWATER, numbers["census"], numbers["recorded_counts"],
                                numbers["baked_counts"], numbers.get("baked_source", "-")))
        return "FAIL", numbers

    # Read-only context for the row: which mode the rules picked for the
    # new map (pl_badwater is a payload map; step 9 drives sv_mode itself).
    try:
        numbers["sv_mode_after"] = run.srv.convar("sv_mode").get("value")
    except lg.ApiError:
        numbers["sv_mode_after"] = "unreadable"
    return "PASS", numbers


TRACKTRAIN = "func_tracktrain"

# The step-8 thresholds. A pushed cart on pl_badwater covers hundreds of
# units in ten seconds (the stock cart runs around 100 u/s with a pushing
# attacker); requiring 100 u of progress is far past sampling noise and
# far short of what a stalled watcher could fake. The recede arm needs
# only that the cart came BACK -- 32 u of return over a minute of nobody
# near it, recorded alongside the raw positions either way.
CART_PUSH_U, CART_RECEDE_U = 100.0, 32.0

# The outputs a checkpoint capture owes (TeamControlPoint.InternalSetOwner):
# the true player capture fires OnOwnerChangedToTeam2 for a BLU take; the
# area's plain ownership set fires OnCapTeam2. Either, seen in the entity
# event ring since this step's head, is the owner change.
CP_OWNER_NEEDLES = ("OwnerChangedToTeam2", "OnCapTeam2")


def _d2(a, b):
    """2-D distance between two origins (lists of three floats), or None
    when either read is missing -- an unmeasured distance NEVER passes."""
    if not a or not b:
        return None
    return math.hypot(float(a[0]) - float(b[0]), float(a[1]) - float(b[1]))


def _unit(a, b):
    dx, dy = float(b[0]) - float(a[0]), float(b[1]) - float(a[1])
    n = math.hypot(dx, dy) or 1.0
    return dx / n, dy / n


def _ahead(cart, target, dist):
    """A point `dist` units from the cart on the line toward the target
    (PURE): the pusher's standing spot -- stock counts a capper only while
    he is AHEAD of the train (IsAheadOfTrain)."""
    ux, uy = _unit(cart, target)
    return [float(cart[0]) + ux * dist, float(cart[1]) + uy * dist, float(cart[2])]


def _behind(cart, target, dist):
    """The recede arm's standing spot: `dist` units from the cart AWAY from
    the target -- behind the train is not ahead of it, so the lone BLU must
    not count as a capper and the cart is owed its return."""
    return _ahead(cart, target, -dist)


def _yaw_to(a, b):
    """The yaw (degrees) that faces from origin a toward origin b."""
    return math.degrees(math.atan2(float(b[1]) - float(a[1]),
                                   float(b[0]) - float(a[0])))


def match_outputs(events, needles):
    """Events whose record names one of the CP-owner needles. PURE."""
    return [e for e in events or ()
            if any(n in str(e) for n in needles)]


def parse_warmup_seconds(line):
    """The seconds from "[SourceSharp/Modes] warmup for 5.0s before ...",
    or None. PURE, so --self-test holds it (GameModes.cs SwitchTo's line)."""
    if not line:
        return None
    m = re.search(r"warmup for ([0-9.]+)s", line)
    return float(m.group(1)) if m else None


def events_snapshot(run, needles):
    """(head, owner-hits, raw-probe) from the entity event ring: the last
    500 events filtered to this classname, the owner-changed matches, and a
    printable tail of the raw answer for a FAIL line to be readable by."""
    data = run.srv.get("events", "0", "500", "kind=output",
                       "classname=team_control_point", timeout=60)
    evs = data.get("events") if isinstance(data, dict) else data
    if not isinstance(evs, list):
        evs = []
    head = max([e.get("seq") or e.get("id") or 0 for e in evs] or [0])
    return head, match_outputs(evs, needles), str(evs[-3:])[:400]


def _ents_with_origins(run, classname):
    """[(index, name, origin)] for a class, straight from the entity list."""
    return [(e["index"], e.get("name"), e.get("origin"))
            for e in run.srv.ents(classname)]


def _fmt_ents(items):
    return ",".join("#%s(%s)@%s" % (i, n, o) for i, n, o in items) or "(none)"


def ensure_badwater(run, numbers):
    """The payload map under the games, changing to it if the server's last
    level-init line is not pl_badwater (a step may be selected alone; and
    host_map is NOT this question -- the engine sets it only in
    Host_NewGame, so it names the boot map forever after a changelevel).
    Positive arms, all three: the command, the server's repaint, both
    players back."""
    hm = current_server_map(run.read_console_since_launch())
    if isinstance(hm, str) and BADWATER in hm.lower():
        return True
    numbers["map_before"] = hm
    paints_before = run.read_console_since_launch().count(PAINT_NEEDLE)
    run.srv.cmd("changelevel %s" % BADWATER)
    if not wait_pump(run, "payload: server repaint on %s" % BADWATER,
                     lambda: run.read_console_since_launch().count(PAINT_NEEDLE) > paints_before,
                     180.0, 1.0):
        numbers["detail"] = "the server never repainted after changelevel %s" % BADWATER
        return False
    if not wait_pump(run, "payload: both players back",
                     lambda: len(run.player_indices()) == 2 or None, 180.0, 1.0):
        numbers["detail"] = "both players never came back after changelevel %s" % BADWATER
        return False
    players = sorted(run.player_indices())
    run.p1, run.p2 = players[0], players[1]
    after = current_server_map(run.read_console_since_launch())
    numbers["map_after"] = after
    if not (isinstance(after, str) and BADWATER in after.lower()):
        numbers["detail"] = ("after changelevel %s the server's last level-init line names %r "
                             "(a rotation took the map away, or the load lied)" % (BADWATER, after))
        return False
    return True


def step_payload(run, state):
    """Stage 4.2 step 8, on pl_badwater with the HOST's player as the pusher
    (a BLU player on the cart): the cart's position advances toward the
    first checkpoint while he stands ahead of it; it recedes once he has
    been away for the recede window; and pushing it past checkpoint 1 hands
    that team_control_point to BLU -- the owner change read from the entity
    event ring (the OnOwnerChangedToTeam2 / OnCapTeam2 outputs our
    InternalSetOwner fires). Every read is the SERVER's (the cart is a
    server entity); on every failure the row prints the train and control
    point probes, so a divergence shows as numbers, never as a guess."""
    numbers = {}
    run.mark()
    run.srv.cmd("sv_cheats 1")
    if not ensure_badwater(run, numbers):
        return "FAIL", numbers

    # The BLU pusher and a RED bystander (defenders near the cart would
    # freeze the recede), with classes so both really spawn. Spectate first:
    # arriving here with both still on their teams (the step run alone on a
    # loaded map), a repeat jointeam would print no join line and this wait
    # would time out on players who are already where they should be.
    run.srv.cmd("cmd jointeam spectate")
    run.client.api.cmd("cmd jointeam spectate")
    run.srv.cmd("cmd jointeam blue")
    run.client.api.cmd("cmd jointeam red")
    run.srv.cmd("cmd joinclass scout")
    run.client.api.cmd("cmd joinclass scout")
    joined = wait_pump(
        run, "payload: p1 blue / p2 red join lines",
        lambda: (lambda j: (j.get(run.p1, (None,))[0] == TEAM_BLU
                            and j.get(run.p2, (None,))[0] == TEAM_RED) or None)(
            team_joins(round_lines_since(run, "joined team"))), 60.0)
    if not joined:
        numbers["detail"] = "p1 never became BLU / p2 RED (console: %s)" % run.team_console_tail()
        return "FAIL", numbers
    if not wait_pump(run, "payload: the pusher is alive", lambda: run.is_alive(run.p1), 60.0):
        numbers["detail"] = "p1 never spawned on %s" % BADWATER
        return "FAIL", numbers
    # The joins above move both players again, which re-arms the waiting
    # window (ThinkStartGame arms it whenever the round starts fresh); the
    # boot and change-level sends were spent BEFORE that re-arm, so this
    # window would run its full time and the cart would sit out the pump.
    end_the_wait_when_armed(run)
    if not wait_pump(run, "payload: the round is running",
                     lambda: (round_state(run) or "") == "RoundRunning", 120.0):
        numbers["detail"] = ("the round never ran on %s (state %r); the watcher only "
                             "moves the cart once the round runs" % (BADWATER, round_state(run)))
        return "FAIL", numbers

    trains = [t for t in _ents_with_origins(run, TRACKTRAIN) if t[2]]
    numbers["trains"] = _fmt_ents(_ents_with_origins(run, TRACKTRAIN))
    if len(trains) != 1:
        numbers["detail"] = ("pl_badwater should answer exactly one func_tracktrain (the "
                             "cart); got %s -- re-encode the pick from this row" % (numbers["trains"],))
        return "FAIL", numbers
    cart_index, cart_name, cart0 = trains[0]
    numbers["cart"] = "#%s(%s)@%s" % (cart_index, cart_name, cart0)

    cps = _ents_with_origins(run, "team_control_point")
    cps = [c for c in cps if c[2]]
    numbers["control_points"] = _fmt_ents(cps)
    if not cps:
        numbers["detail"] = "no team_control_point on the map (probes: %s)" % numbers["control_points"]
        return "FAIL", numbers

    def cart_now():
        return (run.srv.entity(index=cart_index) or {}).get("origin")

    # checkpoint 1 = the one nearest the cart at the start (the first the
    # attackers' push reaches); the goal = the farthest (the push direction,
    # so the cart crosses cp1 on its way).
    cps_by_near = sorted(cps, key=lambda c: _d2(cart0, c[2]) if _d2(cart0, c[2]) is not None else 1e12)
    cp1_index, cp1_name, cp1_origin = cps_by_near[0]
    goal_origin = cps_by_near[-1][2]
    numbers["cp1"] = "#%s(%s)@%s" % (cp1_index, cp1_name, cp1_origin)

    # The sampler's fixed indices: the capture volume and the train watcher,
    # read once before the pumps so every tick can name its chain links (c)
    # and (e). The pump phases reuse them; the old mid-step read of the same
    # two lists just moves here.
    areas = [a for a in _ents_with_origins(run, "trigger_capture_area") if a[2]]
    numbers["capture_areas"] = _fmt_ents(areas)
    watchers = [w for w in _ents_with_origins(run, "team_train_watcher") if w[2]]
    watcher_index = watchers[0][0] if watchers else None
    area_index = areas[0][0] if areas else None
    push_rec, rec_rec, cap_rec = phase_rec(), phase_rec(), phase_rec()

    ev_head, _, ev_probe = events_snapshot(run, CP_OWNER_NEEDLES)
    numbers["events_head_at_start"] = ev_head

    # -- the push: ahead of the cart, held there, the position advances ----
    dist0 = _d2(cart0, cp1_origin)
    numbers["cart_to_cp1_start"] = round(dist0, 1) if dist0 is not None else None
    if dist0 is None:
        numbers["detail"] = "the cart or checkpoint 1 has no origin to measure"
        return "FAIL", numbers
    best = {"d": dist0}

    def pushing():
        cur = cart_now()
        if not cur:
            return None
        note_sample(run, push_rec, cur, cart_index, area_index, cp1_index, watcher_index)
        d = _d2(cur, cp1_origin)
        if d is not None:
            best["d"] = min(best["d"], d)
            if dist0 - d >= CART_PUSH_U:
                best["cart"] = cur
                return True
        settle_on(run, run.p1, _ahead(cur, goal_origin, 96.0),
                  (0.0, _yaw_to(cur, goal_origin), 0.0), tries=2, prove=False)
        return None

    pushed = wait_pump(run, "payload: the cart advances %g u toward checkpoint 1" % CART_PUSH_U,
                       pushing, 90.0, 2.5)
    note_phase(numbers, "push", push_rec)
    best_d = round(best["d"], 1)
    numbers["cart_to_cp1_best"] = best_d
    numbers["cart_after_push"] = cart_now()
    if not pushed:
        numbers["detail"] = ("the cart never advanced %g u toward checkpoint 1 (from %s, best "
                             "distance %s of start %s; trains %s cps %s)"
                             % (CART_PUSH_U, cart0, best_d, round(dist0, 1),
                                numbers["trains"], numbers["control_points"]))
        return "FAIL", numbers

    # -- the recede: the pusher off the cart, the cart comes back ------------
    pushed_at = cart_now()
    def away():
        cur = cart_now()
        if not cur:
            return None
        note_sample(run, rec_rec, cur, cart_index, area_index, cp1_index, watcher_index)
        settle_on(run, run.p1, _behind(cur, goal_origin, 500.0),
                  (0.0, _yaw_to(cur, goal_origin), 0.0), tries=2, prove=False)
        d = _d2(cur, pushed_at)
        return cur if (d is not None and d >= CART_RECEDE_U) else None

    receded = wait_pump(run, "payload: the cart recedes without a pusher", away, 60.0, 3.0)
    note_phase(numbers, "rec", rec_rec)
    numbers["cart_after_recede"] = cart_now()
    if not receded:
        numbers["detail"] = ("the cart did not recede %g u after the pusher left it "
                             "(%s -> %s)" % (CART_RECEDE_U, pushed_at, numbers["cart_after_recede"]))
        return "FAIL", numbers

    # -- checkpoint 1: the cappers RIDE the cart to its checkpoint node ----
    # The baked lump (the reader below decodes it from the shipped BSP) says
    # how pl_badwater captures its checkpoints. The map holds exactly ONE
    # trigger_capture_area ("cap_area", area_time_to_cap 99999, PARENTED to
    # the cart): it is the capper volume, not a capturable zone -- its
    # OnNumCappersChanged fires watcher,SetNumTrainCappers, and the watcher's
    # HandleTrainMovement drives the cart from that count. The checkpoint
    # itself is handed over by the track: path_track "minecart_path_33" sits
    # at cap_1's origin and its OnPass fires "cap_1,SetOwner,3" -- and the
    # CP's OnSetOwner needs only PointsMayBeCaptured (no lock, no
    # tf_caplinear). So this arm keeps a BLU capper INSIDE the moving volume
    # -- the push phase proved 96 u ahead of the cart counts -- and waits for
    # the owner output. A cart that stops advancing with the capper held is
    # the real failure the row must show, so on stall it takes the numbers
    # first: who the volume touches, whether the capper is alive, and where
    # the cart stands. (Run C/E at ae4cdda88 deadlocked by teleporting the
    # capper to the CP's origin -- metres from the only volume on the map --
    # and hand-firing SetLocked/caplinear against a capture model the map
    # does not use.)
    probe_box = [ev_probe]
    STALL_U, STALL_PUMPS = 2.0, 3   # held capper, cart unmoving, three pumps
    # (the areas list and its capture_areas number are read ahead of the pumps)

    def capper_diag():
        """The numbers a stall or a timeout is judged by."""
        cur = cart_now()
        d_cart = _d2(cur, cp1_origin) if cur else None
        try:
            touched = ((run.srv.get("touching", areas[0][0]) or {}).get("touching", [])
                       if areas else "no area")
        except lg.ApiError as why:
            touched = "read_error:%s" % str(why)[:40]
        return {"cart": cur,
                "to_cp1": round(d_cart, 1) if d_cart is not None else None,
                "area_index": areas[0][0] if areas else None,
                "area_touch": str(touched)[:160].replace("\t", " "),
                "capper_alive": run.is_alive(run.p1),
                "events_tail": probe_box[0]}

    state = {"last_cart": None, "still": 0, "stalled": None}

    def capped():
        _, hits, probe = events_snapshot(run, CP_OWNER_NEEDLES)
        probe_box[0] = probe
        fresh = [e for e in hits if (e.get("seq") or e.get("id") or 0) > ev_head]
        if fresh:
            numbers["owner_event"] = str(fresh[-1])[:300].replace("\t", " ")
            return True
        cur = cart_now()
        if not cur:
            return None
        note_sample(run, cap_rec, cur, cart_index, area_index, cp1_index, watcher_index)
        if not run.is_alive(run.p1):
            # The cart advances only while the watcher counts a capper; a
            # dead one parks it (run F at this tip stalled at the track's
            # corner with capper_alive False). The same-class joinclass IS
            # the respawn, and the settle below puts him back on the cart.
            run.srv.cmd("cmd joinclass scout")
            state["still"] = 0            # a death costs movement; do not
            state["last_cart"] = None     # count the respawn pumps as a stall
            return None
        moved = (0.0 if state["last_cart"] is None
                 else (_d2(cur, state["last_cart"]) or 0.0))
        state["still"] = state["still"] + 1 if moved <= STALL_U else 0
        state["last_cart"] = cur
        # Hold the capper inside the volume, ON the cart -- the volume is
        # parented to it, so the cart's own position is in it (the cart
        # itself shows in its touch directory). The 96-u-ahead placement of
        # the straight-track push kills the capper at the corner into cp1,
        # where the projection off the track has no floor.
        settle_on(run, run.p1, list(cur),
                  (0.0, _yaw_to(cur, goal_origin), 0.0), tries=2, prove=False)
        if state["still"] >= STALL_PUMPS:
            state["stalled"] = capper_diag()
            numbers["cart_at_stop"] = "%s (%s of cp1, stalled with a held capper)" % (
                cur, round(_d2(cur, cp1_origin), 1)
                if _d2(cur, cp1_origin) is not None else "?")
            return "STALL"
        return None

    capped = wait_pump(run, "payload: checkpoint 1 changes owner", capped, 150.0, 2.5)
    note_phase(numbers, "cap", cap_rec)
    numbers["cart_after_cp1"] = cart_now()
    if not capped or capped == "STALL":
        why = state["stalled"] or capper_diag()
        numbers["stall_diag"] = str(why)[:700].replace("\t", " ")
        numbers["detail"] = (
            "no checkpoint-owner output since the step's head %s (watcher chain: "
            "capper volume #%s touches %s, capper alive %s, cart %s at %s u of "
            "cp1; ring tail %s; areas %s%s)"
            % (ev_head, why.get("area_index"), why.get("area_touch"),
               why.get("capper_alive"), why.get("cart"), why.get("to_cp1"),
               why.get("events_tail"), numbers.get("capture_areas"),
               " -- CART STALLED with the capper held" if state["stalled"]
               else " -- no stall seen before the 150 s window closed"))
        return "FAIL", numbers
    return "PASS", numbers


MODE_SWITCH_WARMUP = 5.0


def step_mode(run, state):
    """Stage 4.2 step 9, on pl_badwater: `sv_mode null` switches with a
    warmup -- the request line, the switch, the open warmup window and its
    close are all logged by the core's mode proxy (SvModeCommand.cs /
    GameModes.cs), and the round machine re-enters PREROUND once the warmup
    ends; `sv_mode pl` switches back and the round runs again; the bare
    `sv_mode` reports which is active. The round read is the same state
    echo step 6 reads (tf2_dev_win's bare echo)."""
    numbers = {}
    run.mark()
    if not ensure_badwater(run, numbers):
        return "FAIL", numbers

    # Teams first: SwitchTo KEEPS the players (the roster is untouched by the
    # flush) but a fresh changelevel leaves them unassigned, and an
    # unassigned Pregame never starts -- that is what pinned the null arm to
    # Pregame in the first run. Same join as the payload step: the pusher
    # BLU, the bystander RED, scouts so both really spawn, and the round
    # running before the switch, so what the switch resets is a RUNNING
    # machine and the states after it are the switch's, not the join's.
    # Spectate first: the payload step may have left both players already on
    # their teams, and a repeat jointeam prints no join line -- spectate then
    # join forces the line team_joins' last-line-wins parse needs, and reads
    # the same however the step arrived here.
    run.srv.cmd("cmd jointeam spectate")
    run.client.api.cmd("cmd jointeam spectate")
    run.srv.cmd("cmd jointeam blue")
    run.client.api.cmd("cmd jointeam red")
    run.srv.cmd("cmd joinclass scout")
    run.client.api.cmd("cmd joinclass scout")
    joined = wait_pump(
        run, "mode: p1 blue / p2 red join lines",
        lambda: (lambda j: (j.get(run.p1, (None,))[0] == TEAM_BLU
                            and j.get(run.p2, (None,))[0] == TEAM_RED) or None)(
            team_joins(round_lines_since(run, "joined team"))), 60.0)
    if not joined:
        numbers["detail"] = "p1 never became BLU / p2 RED before the switch (console: %s)" % run.team_console_tail()
        return "FAIL", numbers
    if not wait_pump(run, "mode: the round runs before the switch",
                     lambda: (round_state(run) or "") == "RoundRunning", 120.0):
        numbers["detail"] = ("the round never ran before sv_mode null (state %r): the switch "
                             "must reset a running machine, not an unstarted one"
                             % (round_state(run),))
        return "FAIL", numbers

    def needle_line(needle):
        return next((l for l in round_lines_since(run, needle) if needle in l), None)

    try:
        numbers["mp_waitingforplayers_time"] = run.srv.convar("mp_waitingforplayers_time").get("value")
    except lg.ApiError as why:
        numbers["mp_waitingforplayers_time"] = "unavailable(%s)" % why

    state_before_null = round_state(run)
    run.srv.convar("sv_mode_switch_warmup", MODE_SWITCH_WARMUP)
    run.srv.cmd("sv_mode null")

    if not wait_pump(run, "mode: the sv_mode null request line",
                     lambda: needle_line("sv_mode null"), 20.0):
        numbers["detail"] = "no '[SourceSharp/Modes] sv_mode null' request line (SvModeCommand)"
        return "FAIL", numbers
    if not wait_pump(run, "mode: switched to 'null'",
                     lambda: needle_line("switched to 'null'"), 20.0):
        numbers["detail"] = "the switch never announced itself (GameModes.SwitchTo)"
        return "FAIL", numbers
    warm_line = wait_pump(run, "mode: the warmup window opens",
                          lambda: needle_line("warmup for"), 20.0)
    warm = parse_warmup_seconds(warm_line)
    numbers["warmup_seconds"] = warm
    if warm is None:
        numbers["detail"] = ("no 'warmup for {s}s before null starts' line -- the switch ran "
                             "with no warmup window (sv_mode_switch_warmup %s / "
                             "mp_waitingforplayers_time %s)"
                             % (MODE_SWITCH_WARMUP, numbers["mp_waitingforplayers_time"]))
        return "FAIL", numbers
    if not wait_pump(run, "mode: the warmup closes",
                     lambda: needle_line("warmup over; 'null' round started"),
                     warm + 30.0, beat=10):
        numbers["detail"] = "the warmup never ended in %.0f s" % (warm + 30.0)
        return "FAIL", numbers

    # -- under null the machine stays RESET, and that IS the correct
    # semantics (run C at ae4cdda88 proved the reading, and the source
    # grounds it): GameRules.Think hands the frame to the ACTIVE MODE's own
    # machine -- while a real mode owns the round its TeamRoundFlow is
    # thought; NullMode's rounds are the core's deathmatch check, so
    # TF2's machine is never thought under null at all (src/server/managed/
    # GameRules.cs, Think: the `Mode is { } mode` arm). The plan's "null ->
    # warmup -> PREROUND" wording does not fit that architecture; what the
    # switch can and must show is its own RESET: RoundRunning before (the
    # wait above, so the switch resets a RUNNING machine), Pregame after,
    # and nothing but Pregame through a round's worth of polls. A machine
    # that advanced under null would be the divergence to flag -- the old
    # arm waited for a transition the architecture cannot produce and
    # called the right game a FAIL.
    numbers["state_before_null"] = state_before_null
    seen = []

    def frozen():
        s = round_state(run)
        if s:
            seen.append(s)
        return True if len(seen) >= 3 and all(x == "Pregame" for x in seen) else None

    if not wait_pump(run, "mode: the null machine stays reset (Pregame)", frozen,
                     40.0, 2.0):
        numbers["states_after_null"] = ",".join(dict.fromkeys(seen)) or "(none)"
        numbers["detail"] = ("the round machine did not stay reset under sv_mode null "
                             "(states after the warmup: %s; the switch's reset leaves it "
                             "Pregame and NullMode never thinks TeamRoundFlow)"
                             % numbers["states_after_null"])
        return "FAIL", numbers
    numbers["states_after_null"] = ",".join(dict.fromkeys(seen)) or "(none)"

    # -- and back: sv_mode pl, the round runs, the bare report names it -------
    # The pl arm is the null arm's mirror: TeamRoundFlow IS thought now, so
    # its own transition lines are the proof -- TeamRoundFlow.Enter logs
    # "[TF2/Rounds] {from} -> {next}" and the console file loses nothing.
    # "-> Preround" (Pregame -> Preround once the warmup gate lifts) and
    # "-> RoundRunning" (the preround timer expiring) are each Enter's own
    # line, not a state word caught mid-poll; the bare state read beside
    # them is the second witness.
    # The match must carry TeamRoundFlow's own prefix: run D at ae4cdda88
    # caught a swallowed PlayerRunCommands exception whose stack dump lost
    # its newline and glued "[TF2/Rounds] StartGame -> Preround" onto it --
    # the transition is real, but a bare "-> Preround" search would also
    # match any other line that merely quotes the state word's transition.
    def rounds_line(transition):
        return next((l for l in round_lines_since(run, "[TF2/Rounds]")
                     if transition in l), None)

    run.srv.cmd("sv_mode pl")
    if not wait_pump(run, "mode: switched back to 'pl'",
                     lambda: needle_line("switched to 'pl'"), 20.0):
        numbers["detail"] = "sv_mode pl never announced the switch (states: %s)" % numbers["states_after_null"]
        return "FAIL", numbers
    prerun = wait_pump(run, "mode: the pl machine enters Preround",
                       lambda: rounds_line("-> Preround"), MODE_SWITCH_WARMUP + 60.0, beat=10)
    numbers["preround_transition"] = (prerun or "(never)")[:120].replace("\t", " ")
    if not prerun:
        numbers["detail"] = ("no '[TF2/Rounds] ... -> Preround' transition after sv_mode pl "
                             "(the machine did not start; states under null were: %s)"
                             % numbers["states_after_null"])
        return "FAIL", numbers
    runline = wait_pump(run, "mode: the pl machine enters RoundRunning",
                        lambda: rounds_line("-> RoundRunning"), 60.0, beat=10)
    numbers["roundrunning_transition"] = (runline or "(never)")[:120].replace("\t", " ")
    if not runline:
        numbers["detail"] = ("no '[TF2/Rounds] ... -> RoundRunning' transition after sv_mode pl "
                             "(preround line: %s)" % numbers["preround_transition"])
        return "FAIL", numbers
    running = wait_pump(run, "mode: the 'pl' round runs again (state read)",
                        lambda: (round_state(run) or "") == "RoundRunning", 60.0)
    if not running:
        numbers["detail"] = ("the round never ran again after sv_mode pl (state %r, transitions %s / %s)"
                             % (round_state(run), numbers["preround_transition"],
                                numbers["roundrunning_transition"]))
        return "FAIL", numbers

    run.srv.cmd("sv_mode")
    report = wait_pump(run, "mode: the bare sv_mode report names pl",
                       lambda: needle_line("active: 'pl'"), 20.0)
    if not report:
        numbers["detail"] = "the bare sv_mode report does not name 'pl' active"
        return "FAIL", numbers
    try:
        numbers["sv_mode_switch_warmup_after"] = run.srv.convar("sv_mode_switch_warmup").get("value")
    except lg.ApiError:
        pass
    run.srv.convar("sv_mode_switch_warmup", 0)
    return "PASS", numbers


def step_teardown(run, state):
    numbers = {}
    numbers["server_threads_after_join"] = state.get("threads_after_join")
    numbers["server_threads_before_exit"] = thread_count(run.server.pid)
    if (numbers["server_threads_after_join"] is None
            or numbers["server_threads_before_exit"] is None):
        # Kill BEFORE the early return: run_gate marks the teardown step as
        # the one that owns the kill (killed=True), so a return that skips
        # kill_all leaks both games onto the box -- run 11 at the settle fix
        # left a server and a client standing on exactly this path.
        run.kill_all()
        numbers["detail"] = "the server's /proc/<pid>/task count could not be read"
        return "FAIL", numbers
    alive_before = (run.client.api.alive(), run.srv.alive())
    run.kill_all()
    # Poll liveness DIRECTLY: Api.wait_for answers None the moment its own
    # process is dead, which is exactly the state being waited for here.
    deadline = time.time() + 30.0
    while time.time() < deadline and (run.client.api.alive() or run.srv.alive()):
        time.sleep(0.5)
    gone_client = not run.client.api.alive()
    gone_server = not run.srv.alive()
    numbers["client_exited"] = bool(gone_client)
    numbers["server_exited"] = bool(gone_server)
    ok = bool(gone_client) and bool(gone_server) and all(alive_before)
    if not ok:
        numbers["detail"] = "both games did not exit from being alive (%r)" % (alive_before,)
    return ("PASS" if ok else "FAIL"), numbers


LIVE_STEPS = {"join": step_join, "teams": step_teams, "classes": step_classes,
              "weapon": step_weapon,
              "combat": step_combat, "heal": step_heal, "respawn": step_respawn, "ctf": step_ctf,
              "changelevel": step_changelevel, "payload": step_payload,
              "mode": step_mode, "teardown": step_teardown}


def joiner_died_during_heal(step, alive_before, alive_after):
    """WHEN the runner may revive the joiner: only the heal step is allowed
    to eat its client (the joiner SIGSEGV is the peer lane tf2-heal's known
    bug); the same death in any other step is a NEW bug and must surface as
    dead games, not be papered over. Pure: the self-test holds all four
    arms."""
    return step == "heal" and bool(alive_before) and not alive_after


def run_gate(selected):
    """Boot, run the selected steps in order, report, and return the exit
    code. Teardown always kills the games, even when a step failed."""
    tip = tip_sha()
    run = Run()
    run_id = "%s-p%d" % (time.strftime("%Y%m%d-%H%M%S"), os.getpid())
    report = Report(os.path.join(REPORT_ROOT, run_id), tip)
    print("== tools/tf2-gate: tip %s, %d step(s), logs in %s"
          % (tip, len(selected), run.scratch), flush=True)
    print("== report: %s" % report.path, flush=True)

    selected = [s for s in STEP_ORDER if s in selected]
    state = {}

    if not run.launch():
        report.record("launch", "FAIL", 0.0, {"detail": "the two games never came up"})
        report.finish(1)
        run.kill_all()
        return 1

    killed = False
    try:
        for step in selected:
            t0 = time.time()
            client_alive_before = run.client is not None and run.client.api.alive()
            if step in NOT_WRITTEN:
                status, numbers = "FAIL", {"detail": "not written yet (a later lane writes step %s)" % step}
            else:
                try:
                    status, numbers = LIVE_STEPS[step](run, state)
                except Exception as exc:
                    status, numbers = "FAIL", {"exception": "%s: %s" % (type(exc).__name__, exc)}
            # The heal step is the one place the JOINER dying is expected:
            # its bug (the joiner SIGSEGVs once it holds the medigun) is
            # owned by the peer lane tf2-heal, and the row must SAY that
            # rather than silently cascade -- and the run must not lose the
            # steps behind it. Revive the joiner ONLY after a death inside
            # heal: the same death in any other step is a NEW bug and must
            # surface as dead games, not be papered over.
            if joiner_died_during_heal(step, client_alive_before, run.client.api.alive()):
                numbers["joiner"] = (
                    "the joiner's game EXITED inside the heal step -- the known heal "
                    "SIGSEGV the peer lane tf2-heal owns (this lane does not touch that "
                    "bug); the joiner is relaunched so the steps behind heal still measure")
                if run.relaunch_joiner():
                    numbers["joiner_relaunched_pid"] = run.client.pid
                else:
                    numbers["joiner_relaunched_pid"] = False
                    numbers["detail"] = ("%s; and the relaunched joiner never came back, "
                                         "so every step behind heal dies with it"
                                         % numbers.get("detail", "(no step detail)"))
            if step == "teardown":
                killed = True
            report.record(step, status, time.time() - t0, numbers)
            print("-- %s: %s %s" % (step, status,
                                    " ".join("%s=%s" % kv for kv in sorted(numbers.items()))),
                  flush=True)
            # A FAIL does not end the run (except the launch, which has no
            # games left to measure with): the heal step is a known open
            # crash owned by another lane, and breaking at its row would
            # hide the measurements of every step behind it. Each step says
            # its own reason; gate_rc decides the exit code over all rows.
    finally:
        if not killed:
            run.kill_all()

    rc = gate_rc(report.rows)
    report.finish(rc)
    print("== tools/tf2-gate rc=%d (report %s)" % (rc, report.path), flush=True)
    return rc


def select_steps(spec):
    if not spec:
        return list(DEFAULT_STEPS)
    wanted = []
    for token in spec.replace(" ", "").split(","):
        if not token:
            continue
        if token in STEP_ORDER:
            wanted.append(token)
        else:
            print("== unknown step %r (known: %s)" % (token, ",".join(STEP_ORDER)))
            return None
    return wanted


# ---------------------------------------------------------------------------
# The self-test: the report writing and the pass/fail arithmetic, no game.
# ---------------------------------------------------------------------------
def self_test():
    """Returns (checked, failures) so the caller prints both."""
    checks = []

    def check(cond, why):
        checks.append((bool(cond), why))

    check(within(400.0, 400.0, 0.05), "exact speed is within")
    check(within(420.0, 400.0, 0.05), "5 % above is within")
    check(not within(421.0, 400.0, 0.05), "past 5 % is NOT within")
    check(not within(379.0, 400.0, 0.05), "below 5 % is NOT within")
    check(within(0.0, 0.0, 0.05), "zero against zero is within")
    check(not within(1.0, 0.0, 0.05), "anything against zero is NOT within")

    check(speed_within(800.0, 2.0, 400.0), "800 u over 2 s is 400 u/s")
    check(not speed_within(600.0, 2.0, 400.0), "300 u/s is NOT within 5 % of 400")
    check(not speed_within(None, 2.0, 400.0), "an unmeasured speed NEVER passes")
    check(not speed_within(800.0, 0.0, 400.0), "a zero-length window never passes")

    check(teams_distinct(2, 3), "2 and 3 are the red/blu pair")
    check(not teams_distinct(2, 2), "two players on one team is NOT a pair")
    check(not teams_distinct(0, 3), "unassigned is not a team")

    check(health_is({"Health": "125"}, 125), "the networked Health reads")
    check(not health_is({"Health": "124"}, 125), "a wrong Health is not confirmed")
    check(not health_is({}, 125), "a missing Health field is NOT a pass")

    # Joiner revival (run_gate): the heal crash (peer lane tf2-heal's
    # SIGSEGV) is the ONLY death the runner may revive. All four arms must
    # answer, or a papered-over new bug or a missed revival is invisible.
    check(joiner_died_during_heal("heal", True, False),
          "a joiner dying inside heal asks for the revival")
    check(not joiner_died_during_heal("payload", True, False),
          "the same death in another step revives NOTHING (it must surface)")
    check(not joiner_died_during_heal("heal", True, True),
          "no death across heal, no revival")
    check(not joiner_died_during_heal("heal", False, False),
          "a joiner already dead entering heal is not heal's to blame")

    tj = team_joins(["[SourceSharp/Teams] #1 joined team 2 (was 0)",
                     "[SourceSharp] a line that only mentions joining a team",
                     "[SourceSharp/Teams] #2 joined team 3 (was 0)",
                     "[SourceSharp/Teams] #1 joined team 3 (was 2)"])
    check(tj.get(1, (None,))[0] == 3, "the last join line per player wins")
    check(tj.get(2, (None,))[0] == 3, "the other player parses too")
    check(len(tj) == 2, "only the two real join lines parse")
    check(tj[2][1].startswith("[SourceSharp/Teams]"), "the raw line rides along as evidence")
    check(not team_joins([]), "no lines, no joins (cannot-measure stays a failure)")
    check(not team_joins(["[SourceSharp/Teams] #1 joined team x (was 0)"]),
          "an unparseable team number is NOT a join")

    cj = class_joins(["[TF2/Player] player 1 joins as Scout now",
                      "[TF2/Player] player 2 will be Heavy at the next spawn",
                      "player 9 joins as nothing (not the game's line)"])
    check(cj.get(1, ("-", "-", ""))[0] == "now" and cj[1][1] == "scout",
          "the game's 'Scout' line canonicalizes to now/scout")
    check(cj.get(2, ("-", "-", ""))[0] == "queued" and cj[2][1] == "heavyweapons",
          "the game's 'Heavy' line canonicalizes to queued/heavyweapons")
    check(len(cj) == 2, "an unanchored lookalike line is NOT a class join")
    check(class_joins(["[TF2/Player] player 1 joins as HeavyWeapons now"])[1][1] == "heavyweapons",
          "an enum-style HeavyWeapons also canonicalizes")
    check(class_joins(["[TF2/Player] player 1 joins as Pyro now"])[1][1] == "Pyro",
          "an unlisted class stays raw (compares unequal, records the line)")

    check(parse_round_state("[TF2/Rounds] state RoundRunning, winner Unassigned, waiting False")
          == "RoundRunning", "the tf2_dev_win echo parses to its state word")
    check(parse_round_state("[TF2/Rounds] state TeamWin, winner Red, waiting False")
          == "TeamWin", "a win echo parses too")
    check(parse_round_state("[TF2/Rounds] RoundRunning -> TeamWin") is None,
          "a transition line is NOT a state echo")
    check(parse_round_state(None) is None and parse_round_state("") is None,
          "no line answers no state, never a guess")
    check(parse_round_wait("[TF2/Rounds] state RoundRunning, winner Unassigned, waiting False")
          == ("RoundRunning", "False"), "the pump sample reads waiting beside its state")
    check(parse_round_wait("[TF2/Rounds] state Pregame, winner Unassigned, waiting True")
          == ("Pregame", "True"), "a waiting echo says waiting True")
    check(parse_round_wait("[TF2/Rounds] RoundRunning -> TeamWin") == (None, None),
          "a transition line is not an echo, for the pair either")
    check(parse_round_wait(None) == (None, None), "no line answers the pair as nothing")

    # current_server_map: the gate's only answer to "which map is loaded",
    # because the engine's host_map names the boot map forever after a
    # changelevel. Empty text is no answer; the LAST load wins, so a rotation
    # cannot be masked by the boot map's line; and the client's own level-init
    # line must not answer the SERVER's question.
    check(current_server_map("") is None and current_server_map(None) is None,
          "no console text answers no map")
    check(current_server_map("[SourceSharp/Server] level init: ctf_2fort\n"
                             "[SourceSharp/Server] level init: pl_badwater\n")
          == "pl_badwater", "the last level-init line wins over the boot map's")
    check(current_server_map("[SourceSharp/Client] level init: pl_badwater\n") is None,
          "the client's level-init line does NOT answer the server's map")
    check(current_server_map("[SourceSharp] server level init pre-entity -> C#: ctf_2fort\n")
          is None, "the pre-entity banner is NOT the level-init line")

    baked = count_by_classname([{"classname": "team_control_point"},
                                {"classname": "team_control_point"},
                                {"classname": "info_player_teamspawn"},
                                {"classname": None},
                                {"not_a_class": 1}])
    check(baked.get("team_control_point") == 2 and baked.get("info_player_teamspawn") == 1,
          "the census counts one map entity lump by classname")
    check(baked.get("team_control_point") != 3 and baked.get(None) == 2
          and "not_a_class" not in baked,
          "a dict with no classname counts once under the missing key, never under a real class")

    # The baked lump reader -- step 7's census and the checkpoint arm's
    # targetname aiming both read real BSP bytes with it. The input is the
    # repo's own committed dm_lockdown.bsp (the one loose bsp this repo
    # keeps), so the self-test parses a real map, not a fixture; a file
    # that is not a usable BSP must RAISE, so a census can never read a
    # silent zero (CLAUDE.md: a missing input is a failure).
    dm = os.path.join(ROOT, "game", "mod_test", "maps", "dm_lockdown.bsp")
    if os.path.isfile(dm):
        dm_ents = baked_lump_entities(dm)
        dm_counts = count_by_classname(dm_ents)
        check(dm_counts.get("worldspawn", 0) == 1,
              "dm_lockdown's lump holds the world once")
        check(sum(dm_counts.values()) > 50,
              "the lump parse finds dm_lockdown's entities (%d)" % sum(dm_counts.values()))
        check(dm_counts.get("info_player_deathmatch", 0) > 0,
              "the deathmatch spawns come out of the lump by name")
        # Two independent ways to count one class over the same parse: the
        # census's helper and a plain walk. They must agree, or the census
        # number is an artefact of the helper.
        check(sum(1 for e in dm_ents if e.get("classname") == "info_player_deathmatch")
              == dm_counts.get("info_player_deathmatch", -3),
              "count_by_classname agrees with an entity walk on the spawns")
    else:
        check(False, "dm_lockdown.bsp missing: the baked lump reader cannot be measured")

    junk = os.path.join(tempfile.gettempdir(), "tf2gate-junk-%d.bsp" % os.getpid())
    try:
        with open(junk, "wb") as fh:
            fh.write(b"not a bsp at all, just bytes")
        try:
            baked_lump_entities(junk)
            check(False, "a non-BSP file must RAISE, never count nothing")
        except ValueError:
            check(True, "a non-BSP file raises; the census reads no silent zero from it")
        with open(junk, "wb") as fh:
            fh.write(b"VBSP" + bytes(4) + bytes(16) + bytes(8))   # header, empty lump 0
        try:
            baked_lump_entities(junk)
            check(False, "a BSP-shaped file whose entity lump is empty must RAISE")
        except ValueError:
            check(True, "a BSP-shaped file with no entity lump raises too")
    finally:
        if os.path.isfile(junk):
            os.unlink(junk)

    # The compressed-lump arm (TF2's shipped maps carry their entities
    # LZMA'd). The round-trip below proves the reader decodes the very
    # container CLZMA writes -- lzma_header_t (id 'LZMA', uncompressed size,
    # compressed size, 5 property bytes) over a raw LZMA1 stream -- and the
    # negative control proves the fourCC/actualSize cross-check can fail.
    check(lzma_codec_props(b"\x5D" + bytes(4)) == (3, 0, 2),
          "the SDK's default property byte splits to lc 3 lp 0 pb 2")
    # LZMADecoder is the common name; this interpreter's lzma calls it
    # LZMADecompressor (see the reader's comment). Either answers.
    _lzma_ready = (_lzma is not None and hasattr(_lzma, "FILTER_LZMA1")
                   and (hasattr(_lzma, "LZMADecoder")
                        or hasattr(_lzma, "LZMADecompressor")))
    if not _lzma_ready:
        check(False, "the lzma module cannot decode (file %r, attrs %s)"
              % (getattr(_lzma, "__file__", None),
                 sorted(a for a in dir(_lzma) if "LZMA" in a or "FILTER" in a)[:40]
                 if _lzma is not None else "None"))
    if _lzma is not None and _lzma_ready:
        zcmp = os.path.join(tempfile.gettempdir(), "tf2gate-zlump-%d.bsp" % os.getpid())
        try:
            ztext = ('{\n"id" "0"\n}\n'
                     '{\n"id" "1"\n"classname" "team_control_point"\n}\n'
                     '{\n"id" "2"\n"classname" "trigger_capture_area"\n}\n')
            zraw = ztext.encode("latin-1")
            # The stream comes from the xz CLI's raw LZMA1, the same bytes
            # Valve's LzmaEnc writes into a map (python's raw-LZMA1 encoder
            # refuses to run here; the DECODER is what the reader uses and
            # is the thing under test). The header declares the lc3/lp0/pb2
            # the SDK uses (props 0x5D) and the dict the encoder was given.
            try:
                zproc = subprocess.run(
                    ["xz", "--format=raw",
                     "--lzma1=preset=9,lc=3,lp=0,pb=2,dict=1MiB", "-c", "-"],
                    input=zraw, stdout=subprocess.PIPE)
            except OSError as why:
                zproc = None
                check(False, "no xz to synthesize the compressed lump: %s" % why)
            if zproc is not None:
                if zproc.returncode != 0:
                    check(False, "xz raw LZMA1 compression failed (rc %d)" % zproc.returncode)
                else:
                    zstream = zproc.stdout
                    zhdr = (LZMA_ID.to_bytes(4, "little")
                            + len(zraw).to_bytes(4, "little")
                            + len(zstream).to_bytes(4, "little")
                            + b"\x5D" + (1 << 20).to_bytes(4, "little"))
                    zlump = zhdr + zstream

                    def zbsp(lump_len, four_cc):
                        desc = (1032).to_bytes(4, "little") \
                            + lump_len.to_bytes(4, "little") \
                            + bytes(4) + four_cc.to_bytes(4, "little")
                        return b"VBSP" + bytes(4) + desc + bytes(1024 - 16) + zlump

                    with open(zcmp, "wb") as fh:
                        fh.write(zbsp(len(zlump), len(zraw)))
                    try:
                        zc = count_by_classname(baked_lump_entities(zcmp))
                        check(zc == {"worldspawn": 1, "team_control_point": 1,
                                     "trigger_capture_area": 1},
                              "the compressed-lump arm decodes what CLZMA's header says "
                              "it holds (counts %s, stream %d bytes)"
                              % (sorted(zc.items()), len(zstream)))
                    except ValueError as why:
                        check(False, "compressed-lump round-trip raised: %s" % why)
                    with open(zcmp, "wb") as fh:
                        fh.write(zbsp(len(zlump), len(zraw) + 7))   # header vs fourCC lie
                    try:
                        baked_lump_entities(zcmp)
                        check(False, "a fourCC that disagrees with the LZMA header must RAISE")
                    except ValueError:
                        check(True, "a fourCC disagreeing with the LZMA header raises (control)")
            # Real Valve-encoded bytes, when this tree has TF2 content (it
            # is per-tree mounted content, like the sandbox map: absent it
            # says so by name; the changelevel run still reads the file).
            real = None
            for cand in _content_maps("pl_badwater"):
                if os.path.isfile(cand):
                    real = cand
                    break
            if real is not None:
                try:
                    rcounts = count_by_classname(baked_lump_entities(real))
                    check(rcounts.get("team_control_point", 0) >= 1
                          and rcounts.get("trigger_capture_area", 0) >= 1
                          and rcounts.get("info_player_teamspawn", 0) >= 1,
                          "the arm reads real TF2 bytes: pl_badwater's lump counts %d CPs, "
                          "%d capture areas, %d teamspawns"
                          % (rcounts.get("team_control_point", 0),
                             rcounts.get("trigger_capture_area", 0),
                             rcounts.get("info_player_teamspawn", 0)))
                except ValueError as why:
                    check(False, "the real pl_badwater lump did not decode: %s" % why)
            else:
                check(True, "no TF2 content on this tree: the real-lump read rides "
                            "on the changelevel run")
        finally:
            if os.path.isfile(zcmp):
                os.unlink(zcmp)
    else:
        check(False, "this python has no lzma: the compressed-lump arm is unmeasured")

    check(_fmt_ui([{"kind": "Text"}, {"kind": "Rect"}, {"kind": "Text"}]) == "3 draws, 2 Text",
          "the ui snapshot counts draws and Text draws apart")
    check(_fmt_ui(None) == "unreachable", "an unreachable ui channel reads as such")

    check(_d2([0, 0, 0], [3, 4, 99]) == 5.0, "the cart distance is the 2-D one")
    check(_d2([0, 0, 0], None) is None, "an unmeasured cart position is None, never a zero")
    ahead = _ahead([0, 0, 0], [100, 0, 0], 96.0)
    check(abs(ahead[0] - 96.0) < 1e-6 and abs(ahead[1]) < 1e-6,
          "the pusher stands ahead of the cart, on the line to the goal")
    check(_behind([0, 0, 0], [100, 0, 0], 96.0)[0] < -95.9,
          "the recede spot is BEHIND the cart -- behind is not ahead")
    check(abs(_yaw_to([0, 0, 0], [0, 100, 0]) - 90.0) < 1e-6, "due +Y faces 90 degrees")
    check(parse_warmup_seconds("[SourceSharp/Modes] warmup for 5.0s before 'null' starts")
          == 5.0, "the warmup line gives its seconds (GameModes.SwitchTo)")
    check(parse_warmup_seconds("switched to 'null'") is None,
          "a line without a warmup window gives no seconds, never a guess")
    check(len(match_outputs([{"name": "OnOwnerChangedToTeam2", "seq": 3},
                             {"name": "OnCapTeam1", "seq": 4}], CP_OWNER_NEEDLES)) == 1,
          "the owner-match keeps the owner output and drops an unrelated one")

    # rendered_ent_indexes: the weapon step's frame read. A real trace line
    # (shell_render_trace_client.cpp: Head\tent=N model=... tabs) counts its
    # ent; the StaticProp/Execute twins do NOT count for a model draw.
    frame = ("render.SetMainView\torigin=0,0,0\n"
             "model.DrawModelEx\tent=7 model=weapons/scout_hand.mdl flags=0x0 skin=0 body=0\n"
             "model.DrawModelExStaticProp\tent=9 model=props/bottle.mdl\n"
             "model.DrawModelExecute\tent=11 model=props/door.mdl\n"
             "render.PopView\n")
    check(rendered_ent_indexes(frame) == {7},
          "one frame names its model draws by ent and only the exact DrawModelEx")
    check(rendered_ent_indexes("") == set(), "an empty frame names nothing, never guesses")
    check(rendered_ent_indexes("no tabs here\n") == set(),
          "a line without a field separator counts as nothing")

    # rendered_draws: the weapon step's pair-read. Both heads carry player
    # content (the viewmodel under DrawModelEx, bodies under Execute), so the
    # pair list keeps both -- and still only the StaticProp stays out.
    check(rendered_draws(frame) == [(7, "weapons/scout_hand.mdl"), (11, "props/door.mdl")],
          "draws pair the ent with its model under either model head")
    check(rendered_draws("") == [], "an empty frame draws nothing")

    check(gate_rc([]) == 1, "no rows is not a pass")
    check(gate_rc([{"status": "PASS"}]) == 0, "all PASS gives rc 0")
    check(gate_rc([{"status": "PASS"}, {"status": "FAIL"}]) == 1, "one FAIL gives rc 1")

    row = {"step": "classes", "status": "FAIL", "seconds": 3.5, "rc": 1, "tip": "abc123",
           "numbers": {"scout_health": "125", "scout_speed": "380.0"}}
    line = format_row(row)
    back = parse_row(line + "\n")
    check(back["step"] == "classes" and back["status"] == "FAIL",
          "a report row survives its round-trip (step and status)")
    check(back["numbers"]["scout_speed"] == "380.0", "a report row keeps its numbers")
    check(len(line.split("\t")) >= 6 and line.split("\t")[4] == "abc123",
          "the tip rides on every row")

    row2 = {"step": "join", "status": "PASS", "seconds": 0.0, "rc": 0, "tip": "abc123",
            "numbers": {"players": 2}}
    check(parse_row(format_row(row2) + "\n")["numbers"]["players"] == "2",
          "an int number round-trips")

    scratch = tempfile.mkdtemp(prefix="tf2g-self-test-")
    report = Report(os.path.join(scratch, "run-1"), "deadbeef")
    report.record("join", "PASS", 1.0, {"players": 2})
    report.record("classes", "FAIL", 2.0, {"scout_speed": "300.0"})
    report.finish(1)
    rows = read_report(report.path)
    check(rows is not None and len(rows) == 2, "the report reads back its two rows")
    check(rows and rows[1]["status"] == "FAIL", "the second row kept its FAIL")
    check(gate_rc(rows) == 1, "the read-back rows compute the failing rc")
    check(read_report(os.path.join(scratch, "nope.tsv")) is None,
          "a missing report reads None (a failure for its reader, never empty PASS)")
    unwritten = Report(os.path.join(scratch, "run-2"), "deadbeef")
    unwritten.record("ctf", "FAIL", 0.0, {"detail": "not written yet (a later lane writes step ctf)"})
    check(gate_rc(unwritten.rows) == 1, "an unwritten step FAILs, never passes")

    # The settle verdict (run 10, tip f8145cb91): the route answered met for
    # a player still 36 u over the corridor floor -- the teleport zeroes his
    # velocity and the ground word it checked was the one he stood on before
    # the move -- and the gate's own hold samples then read 37 -> 4, "still
    # moving, 33 u between them", on every route. Rest must come before the
    # hold samples, for the host exactly as the joiner arm already waited.
    class ScriptedApi:
        """Serves entity(index=...) origins from a script; once the script
        runs dry the last origin repeats (a player resting on it)."""

        def __init__(self, origins):
            self.origins = [list(o) for o in origins]

        def entity(self, index=None):
            if self.origins:
                pos = self.origins.pop(0)
                self._last = pos
            return {"origin": list(self._last)} if getattr(self, "_last", None) else {}

    class SunkApi:
        """A player who never rests: each read sinks 20 u further (a drop
        into an endless shaft), so no two consecutive samples agree."""

        def __init__(self):
            self.n = 0

        def entity(self, index=None):
            self.n += 1
            return {"origin": [-1200.0, 600.0, 40.0 - 20.0 * self.n]}

    class StubRun:
        def __init__(self, api):
            self.srv = api

    held, _ = rests_then_holds(StubRun(ScriptedApi([
        [-1200, 600, 37], [-1200, 600, 4], [-1200, 600, 4], [-1200, 600, 4]])),
        1, TRACK_SPOT, False, rest_seconds=1.0)
    check(held, "the run-10 drop (37 -> 4 between reads) rests before it holds")

    sunk, why = rests_then_holds(StubRun(SunkApi()), 1, TRACK_SPOT, False,
                                 rest_seconds=0.6)
    check(not sunk and "rest" in why,
          "a player who never rests fails the settle, naming the rest")

    checked = sum(1 for ok, _ in checks)
    failed = [why for ok, why in checks if not ok]
    return checked, failed


def main(argv=None):
    ap = argparse.ArgumentParser(prog="tools/tf2-gate")
    ap.add_argument("--steps", default="",
                    help="comma list of step names (default: %s)" % ",".join(DEFAULT_STEPS))
    ap.add_argument("--self-test", action="store_true",
                    help="exercise the report and the arithmetic, no game")
    args = ap.parse_args(argv)

    if args.self_test:
        checked, failed = self_test()
        for why in failed:
            print("SELF-TEST FAILED: %s" % why)
        print("SELF-TEST %d checks, %d failed" % (checked, len(failed)))
        return 1 if failed else 0

    selected = select_steps(args.steps)
    if selected is None:
        return 2
    return run_gate(selected)


if __name__ == "__main__":
    sys.exit(main())

# ---------------------------------------------------------------------------
# Pure arithmetic, so --self-test can reach it without a game.
# ---------------------------------------------------------------------------
def within(value, expected, tolerance):
    """Is `value` within `tolerance` of `expected` (relative)? A zero
    expected only matches a zero value: there is no ratio to compare to."""
    if expected == 0:
        return value == 0
    return abs(value - expected) <= abs(expected) * tolerance


def speed_within(distance_moved, seconds, expected, tolerance=SPEED_TOLERANCE):
    """Did `distance_moved` over `seconds` come within `tolerance` of
    `expected` u/s? A missing measurement or a zero window is NOT within:
    an unmeasured speed is a failure, never a pass."""
    if not seconds or distance_moved is None:
        return False
    return within(distance_moved / float(seconds), expected, tolerance)


def teams_distinct(t1, t2):
    """Are the two team numbers the red/blu pair, one each?"""
    return {t1, t2} == {TEAM_RED, TEAM_BLU}


# The core's own record of a team join, logged by Teams.ChangeTeam in
# src/server/managed/Teams.cs as "[SourceSharp/Teams] #<index> joined team
# <n> (was <old>)" -- #{EntryIndex}, so group 1 is the player's entity index.
# This is the product's logging, not a diagnostic built for the gate: the
# dev-api has no team endpoint (docs/api.md) and its entity detail and event
# rings carry no team, so the join line IS the machine-readable team read.
# The gate keeps the raw line in the report as the evidence it parsed.
TEAM_JOIN_RX = re.compile(r"#(\d+) joined team (\d+) \(was (\d+)\)")


def team_joins(lines):
    """{index: (team, raw_line)} for the managed team-join lines, last line
    per player winning (a player who reteams shows twice). Lines that merely
    mention joining parse as nothing. PURE, so --self-test drives it."""
    found = {}
    for line in lines or ():
        m = TEAM_JOIN_RX.search(line)
        if m:
            # Tabs flattened: the line rides into a TSV report column.
            found[int(m.group(1))] = (int(m.group(2)), line.strip().replace("\t", " "))
    return found


# The core's joinclass announcements (TFJoinClassCommand.cs 176/181):
# "[TF2/Player] player <index> joins as <class> now" when it spawns the
# player on the spot, "... will be <class> at the next spawn" when the class
# is queued behind the current life. Which arm fired decides whether the
# gate must kill the player to see the class, so the gate reads it.
# The <class> is TFClassNames.NonLocalized -- the enum name (Scout, Heavy,
# Medic), NOT the joinclass argument (scout, heavyweapons, medic): run 6's
# real lines read "joins as Scout now" / "joins as Heavy now". Canonicalizing
# through this table is what makes "Heavy" (the line) and "heavyweapons"
# (the expected) comparable without a lowercase match that cannot tell the
# two apart.
CLASS_JOIN_RX = re.compile(r"player (\d+) (joins as|will be) ([A-Za-z]+) (now|at the next spawn)")
CLASS_LINE_CANON = {"scout": "scout", "heavy": "heavyweapons",
                    "heavyweapons": "heavyweapons", "medic": "medic"}


def class_joins(lines):
    """{index: (kind, canonical_class, raw_line)} for the managed joinclass
    lines, kind "now" or "queued", last line per player winning. The class
    name is canonicalized (CLASS_LINE_CANON), so heavyweapons compares equal
    to the line's Heavy. An unlisted class name is NOT canonicalized: it
    compares unequal and the step records the raw line. PURE."""
    found = {}
    for line in lines or ():
        m = CLASS_JOIN_RX.search(line)
        if m:
            kind = "now" if m.group(4) == "now" else "queued"
            raw = m.group(3)
            canon = CLASS_LINE_CANON.get(raw.lower(), raw)
            found[int(m.group(1))] = (kind, canon, line.strip().replace("\t", " "))
    return found


def health_is(fields, want):
    """Is the entity's networked Health exactly `want`? A missing field or an
    unparseable value is False (it cannot be confirmed), not a silent pass."""
    got = (fields or {}).get("Health")
    try:
        return int(float(got)) == want
    except (TypeError, ValueError):
        return False


def rendered_ent_indexes(text):
    """The ent= numbers of one recorded render frame's model.DrawModelEx lines
    (shell_render_trace_client.cpp writes one per draw call). The exact call
    name only: model.DrawModelExStaticProp and model.DrawModelExecute are
    different calls, and their ent= must not stand in for a model draw. PURE,
    so --self-test drives it; an empty frame answers an empty set."""
    hits = set()
    for line in text.split("\n"):
        head, sep, rest = line.partition("\t")
        if head != "model.DrawModelEx" or sep == "":
            continue
        m = re.match(r"^ent=(-?\d+)", rest)
        if m:
            hits.add(int(m.group(1)))
    return hits


def rendered_draws(text):
    """[(ent, model)] for one recorded frame's model draws -- both heads the
    trace records them under (model.DrawModelEx for brush and viewmodel
    calls, model.DrawModelExecute for the studio path; run 20261102-180437:
    the join client's frames name the viewmodel pair under DrawModelEx and a
    body read must see whichever head its draw took, while
    DrawModelExStaticProp stays out like in rendered_ent_indexes). The names
    paired with the ent numbers so a join client's frame can be read without
    knowing how ITS directory numbers entities (its /ents answers empty; the
    server's indices do not transfer). PURE like rendered_ent_indexes, so
    --self-test drives it."""
    draws = []
    for line in text.split("\n"):
        head, sep, rest = line.partition("\t")
        if sep == "" or head not in ("model.DrawModelEx", "model.DrawModelExecute"):
            continue
        m = re.match(r"^ent=(-?\d+) model=(\S+)", rest)
        if m:
            draws.append((int(m.group(1)), m.group(2)))
    return draws


def row_passed(row):
    return row.get("status") == "PASS"


def gate_rc(rows):
    """0 only when every row passed and there was at least one row; a gate
    that measured nothing has not passed."""
    return 0 if rows and all(row_passed(r) for r in rows) else 1


def format_row(row):
    """step<TAB>status<TAB>seconds<TAB>rc<TAB>tip<TAB>numbers(one k=v per TAB)."""
    numbers = "\t".join("%s=%s" % (k, v) for k, v in sorted(row.get("numbers", {}).items()))
    return "\t".join([str(row["step"]), str(row["status"]), "%.2f" % row["seconds"],
                      str(row["rc"]), str(row["tip"]), numbers])


def parse_row(line):
    """Inverse of format_row (self-test: a report the next run cannot re-read
    is a report that cannot be checked)."""
    parts = line.rstrip("\n").split("\t")
    step, status, seconds, rc, tip = parts[:5]
    numbers = {}
    for cell in parts[5:]:
        if not cell:
            continue
        key, _, value = cell.partition("=")
        numbers[key] = value
    return {"step": step, "status": status, "seconds": float(seconds),
            "rc": int(rc), "tip": tip, "numbers": numbers}


def read_report(path):
    """The rows of a report.tsv (comment lines dropped), or None when the
    file is not there -- a missing report is a FAILURE for its reader, never
    an empty pass."""
    if not os.path.exists(path):
        return None
    rows = []
    with open(path, "r", encoding="utf-8") as handle:
        for line in handle:
            if line.startswith("#") or not line.strip():
                continue
            rows.append(parse_row(line))
    return rows


class Report:
    """One run's report.tsv, one row per step, written as each step ends."""

    def __init__(self, directory, tip):
        self.tip = tip
        os.makedirs(directory, exist_ok=True)
        self.path = os.path.join(directory, "report.tsv")
        self.rows = []
        with open(self.path, "w", encoding="utf-8") as handle:
            handle.write("# tools/tf2-gate report\n")
            handle.write("# tip=%s mod=%s map=%s\n" % (tip, MOD, MAP))
            handle.write("# started=%s\n" % time.strftime("%Y-%m-%dT%H:%M:%S"))

    def record(self, step, status, seconds, numbers):
        row = {"step": step, "status": status, "seconds": round(seconds, 2),
               "rc": 0 if status == "PASS" else 1, "tip": self.tip,
               "numbers": dict(numbers)}
        self.rows.append(row)
        with open(self.path, "a", encoding="utf-8") as handle:
            handle.write(format_row(row) + "\n")
        return row

    def finish(self, rc):
        with open(self.path, "a", encoding="utf-8") as handle:
            handle.write("# rc=%d\n" % rc)



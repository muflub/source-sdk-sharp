def thread_count(pid):
    """The server's /proc/<pid>/task count, or None when /proc cannot say
    (None makes its step unmeasurable, which is a failure)."""
    try:
        return len(os.listdir("/proc/%s/task" % pid))
    except OSError:
        return None


def tip_sha():
    """TIP=$(git rev-parse HEAD), run as its own command so its status is its
    own exit code (never behind a pipe)."""
    out = subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT,
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                         text=True)
    return out.stdout.strip() or "unknown"


def fmt_pos(origin):
    return ",".join("%.0f" % v for v in origin) if origin else "?"


def forward_of(yaw):
    """The unit (x, y) a player's +forward drives them at view yaw `yaw`."""
    return (math.cos(math.radians(yaw)), math.sin(math.radians(yaw)))


def entity_origin(api, index):
    ent = api.entity(index=index)
    return ent.get("origin") if ent else None


class Run:
    """The two games and the reads every step needs."""

    def __init__(self, verbose=True):
        self.games = []
        self.scratch = tempfile.mkdtemp(prefix="tf2g-", dir="/tmp")
        self.verbose = verbose

    def say(self, msg):
        if self.verbose:
            print(msg, flush=True)

    def launch(self):
        modarg = ["-mod", MOD]  # '-mod tf2' FIRST on each launch line
        self.console_start = os.path.getsize(CONSOLE) if os.path.exists(CONSOLE) else 0
        self.server, self.port = lg.launch_with_free_port(
            lambda p: modarg + lg.server_launch(p, MAP),
            os.path.join(self.scratch, "server.log"),
            os.path.join(self.scratch, "server"))
        if self.server is None:
            self.say("== the server never opened a dev API socket (log %s)"
                     % os.path.join(self.scratch, "server.log"))
            return False
        self.games.append(self.server)
        self.srv = lg.Api(self.server.pid, root=ROOT)
        self.say("== server pid %s port %d" % (self.server.pid, self.port))

        if not wait_pump(self, "server: its own player in the entity list",
                         lambda: len(self.srv.ents(PLAYER_CLASS)) >= 1, 240.0):
            self.say("== the server's own player never appeared")
            return False
        # The listen server's local player exists first: its index is player
        # 1's, and player 2 is the one that arrives with the join.
        self.p1 = min(e["index"] for e in self.srv.ents(PLAYER_CLASS))

        # The gate's placements (the joiner's setpos_exact) and the heal's
        # hurtme are sv_cheats commands; the integrator's measurement
        # procedure opens with the same line. Set once here so every step
        # can place and hurt without each carrying the cheat flag itself.
        self.srv.cmd("sv_cheats 1")

        self.client, _ = lg.launch_with_free_port(
            lambda p: modarg + lg.client_launch(p),
            os.path.join(self.scratch, "client.log"),
            os.path.join(self.scratch, "client"))
        if self.client is None:
            self.say("== the second client never opened a dev API socket (log %s)"
                     % os.path.join(self.scratch, "client.log"))
            return False
        self.games.append(self.client)
        for api in (self.srv, self.client.api):
            api.convar("net_usesocketsforloopback", 1)
        time.sleep(1.0)
        self.client.api.cmd("connect 127.0.0.1:%d" % self.port)
        self.say("== client pid %s connecting to 127.0.0.1:%d" % (self.client.pid, self.port))
        # A stock test round ends the waiting-for-players window up front
        # (mp_waitingforplayers_time is TF's stock 30 s): the cart and caps idle
        # and the round restarts when it closes. The mode step still reads the
        # waiting time itself. Cleared once read, so each map load re-arms it.
        self.srv.cmd("mp_waitingforplayers_cancel 1")
        # The first send can land before the wait arms; send again once the
        # arming line itself says the window is up.
        end_the_wait_when_armed(self)
        return True

    def relaunch_joiner(self):
        """Bring the joiner back after the heal step's known crash (the joiner
        SIGSEGVs in the heal -- the peer lane tf2-heal owns that bug and this
        gate does not touch it): the same launch as launch()'s client, over a
        fresh instance dir and log, so the steps behind heal still measure a
        live two-player game. The joiner comes back a RED scout, the
        bystander role payload and mode give him anyway (changelevel needs
        him SPAWNED, and an unassigned player never spawns). False, with the
        reason said, when the new game cannot come up: then the later steps
        fail on their own, which is the honest outcome -- a revival that
        hides its own failure would be the silent pass CLAUDE.md forbids."""
        self.client, _ = lg.launch_with_free_port(
            lambda p: ["-mod", MOD] + lg.client_launch(p),
            os.path.join(self.scratch, "client-relaunch.log"),
            os.path.join(self.scratch, "client-relaunch"))
        if self.client is None:
            self.say("== the relaunched joiner never opened a dev API socket "
                     "(log %s)" % os.path.join(self.scratch, "client-relaunch.log"))
            return False
        self.games.append(self.client)
        self.client.api.convar("net_usesocketsforloopback", 1)
        time.sleep(1.0)
        self.client.api.cmd("connect 127.0.0.1:%d" % self.port)
        self.say("== joiner relaunched: pid %s connecting to 127.0.0.1:%d"
                 % (self.client.pid, self.port))
        # The dead joiner's entity can linger a while (run 2 at this tip:
        # the counts waited >=2 off the dead #2's corpse while the new
        # connection landed as #3), so no index is trusted from the count:
        # the revived joiner is found as the LIVE player who is not the
        # host. jointeam/joinclass ride the new client's own console and
        # the wait judges whoever the server really called into play.
        self.client.api.cmd("cmd jointeam red")
        self.client.api.cmd("cmd joinclass scout")

        def fresh():
            for idx in self.player_indices():
                if idx != self.p1 and self.is_alive(idx):
                    return idx
            return None

        new_p2 = wait_pump(self, "relaunch: a second live player beside the host",
                           fresh, 120.0)
        if new_p2 is None:
            self.say("== the relaunched joiner never became a live player (the entity "
                     "list held %s)" % (self.player_indices(),))
            return False
        self.p2 = new_p2
        return True

    def player_indices(self):
        return sorted(e["index"] for e in self.srv.ents(PLAYER_CLASS))

    def buttons_p1(self, text):
        # A plain +/- button on the listen server's console presses player 1's
        # keys; on the joining client it presses player 2's (the pattern
        # tools/live-gate's own second-client step uses).
        self.srv.cmd(text)

    def buttons_p2(self, text):
        self.client.api.cmd(text)

    def health(self, index):
        try:
            return int(float(self.srv.fields(index).get("Health")))
        except (TypeError, ValueError, lg.ApiError):
            return None

    def team(self, index):
        try:
            return int(float(self.srv.fields(index).get("TeamNum")))
        except (TypeError, ValueError, lg.ApiError):
            return None

    def team_lines(self):
        """The server game's console.log since launch -- where the managed
        log lines actually land. (Verified against the dev-api /log ring and
        found missing there: the ring is fed only by the debug api's own
        hooks.Log channel -- src/debug_api/DebugApiServer.cs Start(), and
        grep finds no game publisher on it -- while the game's ILog is
        ConsoleLog over the engine console, CoreServices.cs, which -condebug
        writes to console.log. The server game is the one launched with
        -condebug, which is the file this reads.)"""
        return self.read_console_since_launch().splitlines()

    def team_console_tail(self, limit=12):
        """The console lines mentioning a team join, newest first, capped --
        for the failure record, so an absent command and an unread team tell
        them apart."""
        hits = [l.strip().replace("\t", " ") for l in self.team_lines()
                if "joined team" in l or "jointeam" in l.lower()]
        return " || ".join(hits[-limit:]) or "(none)"

    def is_alive(self, index):
        """fields Alive == \"true\" -- the flag live-gate's second-client step
        waits on before driving a player (a player entity exists on the
        server seconds before that player takes input)."""
        try:
            return self.srv.fields(index).get("Alive") == "true"
        except lg.ApiError:
            return False

    def team_now(self, index):
        """Player `index`'s last joined team number, from the core's own join
        lines (console.log). The /payload fields endpoint serves HL2MP
        CBasePlayer nettable state -- it has no TeamNum (verified against the
        field dump) -- so these lines are the team read."""
        return team_joins(self.team_lines()).get(index, (None, None))[0]

    def class_evidence(self, index):
        """The latest (kind, class, line) TFJoinClassCommand logged for
        player `index`, or None."""
        return class_joins(self.team_lines()).get(index)

    def field_dump(self, index):
        """The /payload field names of an entity, for a failure record: when a
        field read answers nothing, the report must SHOW whether the field is
        absent or the endpoint failed, not leave both as a bare None."""
        try:
            return ",".join(sorted(self.srv.fields(index))) or "(none)"
        except lg.ApiError as why:
            return "unavailable(%s)" % why

    def read_console_since_launch(self):
        try:
            with open(CONSOLE, errors="replace") as handle:
                handle.seek(self.console_start)
                return handle.read()
        except OSError:
            return ""

    def mark(self):
        """The console offset at a step's start. Needles that must be NEW
        (this step's game lines -- a capture, a forced win) are searched
        only past this mark: the console since launch still holds earlier
        steps' lines, and an earlier round win's "round won by" would
        otherwise satisfy a later step's wait before it ever happened."""
        try:
            self._mark = os.path.getsize(CONSOLE)
        except OSError:
            self._mark = self.console_start

    def read_console_since_mark(self):
        start = getattr(self, "_mark", self.console_start)
        try:
            with open(CONSOLE, errors="replace") as handle:
                handle.seek(start)
                return handle.read()
        except OSError:
            return ""

    def read_client_log(self):
        try:
            with open(os.path.join(self.scratch, "client.log"), errors="replace") as handle:
                return handle.read()
        except OSError:
            return ""

    def kill_all(self):
        for game in self.games:
            try:
                game.kill()
            except Exception as exc:
                self.say("== kill failed: %s" % exc)


# ---------------------------------------------------------------------------
# The steps. Each returns (status, numbers); a missing measurement is FAIL.
# ---------------------------------------------------------------------------
def step_join(run, state):
    numbers = {}
    joined = wait_pump(run, "join: a second player in the entity list",
                       lambda: len(run.srv.ents(PLAYER_CLASS)) >= 2, 120.0)
    players = run.player_indices()
    numbers["players"] = len(players)
    if not joined or len(players) != 2:
        return "FAIL", numbers
    run.p2 = players[1]
    numbers["p1_index"], numbers["p2_index"] = run.p1, run.p2

    # The join is asserted BEFORE any client reading (the plan's rule), and
    # both games' paint must be seen: a client that never painted is not a
    # joined client. The listen game's line comes from its own -condebug
    # console.log (one console.log, one game: client_launch carries no
    # -condebug on purpose, so only the server game writes it).
    server_painted = wait_pump(
        run, "server game: first paint line in console.log",
        lambda: run.read_console_since_launch().count(PAINT_NEEDLE) >= 1, 90.0)
    # The joiner's own paint, read the way live-gate's second-client step
    # reads it: the game pushes its UI draws to the server's debug channel,
    # and server.get("client", <player index>, "ui") answers them. A joiner
    # that never painted answers empty draws; its stdout (no -condebug) and
    # its own log ring proved too slow/lossy for this (run 1 of 2026-10-26:
    # the join held while the paint line sat in an unflushed buffer).
    client_painted = wait_pump(
        run, "client game: first HUD text on its ui channel",
        lambda: (lambda draws: next((d for d in draws if d.get("kind") == "Text"), None))(
            (run.srv.get("client", str(run.p2), "ui") or {}).get("draws", [])) or None,
        90.0)
    numbers["server_first_paint"] = bool(server_painted)
    numbers["client_first_paint"] = bool(client_painted)
    if not client_painted:
        # Make the failure readable: what the joiner's stdout did say.
        tail = [l for l in run.read_client_log().splitlines() if l.strip()][-8:]
        numbers["client_log_tail"] = " || ".join(l.replace("\t", " ") for l in tail)
    numbers["both_alive"] = run.srv.alive() and run.client.api.alive()

    state["threads_after_join"] = thread_count(run.server.pid)
    numbers["server_threads_after_join"] = state["threads_after_join"]

    ok = (bool(server_painted) and bool(client_painted)
          and numbers["both_alive"] and state["threads_after_join"] is not None)
    return ("PASS" if ok else "FAIL"), numbers


def step_teams(run, state):
    numbers = {}
    try:
        numbers["mp_teams_unbalance_limit_default"] = \
            run.srv.convar("mp_teams_unbalance_limit").get("value")
    except lg.ApiError as why:
        numbers["mp_teams_unbalance_limit_default"] = "unavailable(%s)" % why
        return "FAIL", numbers

    run.srv.cmd("cmd jointeam auto")
    run.client.api.cmd("cmd jointeam auto")

    # The team numbers are read from the core's own join lines in the server's
    # managed log (see TEAM_JOIN_RX): the dev-api entity detail and event ring
    # carry no team, and TeamNum is not a proven /payload field -- the fields
    # read rides along as a cross-check, and a failure records the field names.
    def both_joined():
        found = team_joins(run.team_lines())
        return found if run.p1 in found and run.p2 in found else None

    got = wait_pump(run, "teams: both players' join lines", both_joined, 60.0)
    last = got or team_joins(run.team_lines())
    t1 = last.get(run.p1, (None, None))[0]
    t2 = last.get(run.p2, (None, None))[0]
    numbers["team_p1"], numbers["team_p2"] = t1, t2
    numbers["team_p1_line"] = last.get(run.p1, (None, None))[1]
    numbers["team_p2_line"] = last.get(run.p2, (None, None))[1]
    numbers["fields_team_p1"], numbers["fields_team_p2"] = \
        run.team(run.p1), run.team(run.p2)
    ok = t1 is not None and t2 is not None and teams_distinct(t1, t2)
    if not ok:
        numbers["field_dump_p1"] = run.field_dump(run.p1)
        numbers["console_team_lines"] = run.team_console_tail()
    if ok:
        state["team_p1"], state["team_p2"] = t1, t2
    return ("PASS" if ok else "FAIL"), numbers


# ---------------------------------------------------------------------------
# The speed run, on an OPEN TRACK. +forward is held on the stretch the
# integrator measured clear at tf2 40fe7a653 (their server-origin/tick
# samples through `debug-api ent index=1`): from -1200 600 40 facing +X,
# clear for ~630 u, the scout at 6.00 u/tick = 400 u/s and the heavy at
# 3.45 = 230. A 0.3 s run-up takes acceleration out of the 1.0 s window.
# The ctf_2fort team spawns are NOT that track: they sit inside the spawn
# rooms, and a run from one hits a wall inside the window on every heading
# (a scout from RED spawn stops 72-200 u later). A run whose speed falls
# between the window's halves stopped at something: that is WALL-BOUND, a
# FAILURE that says so -- never a speed.
# ---------------------------------------------------------------------------
CLASS_NUM = {"scout": 1, "medic": 5, "heavyweapons": 6}   # TFClass, TFSharedDefs.cs


def player_class(run, index):
    """The tf_player_data carrier's PlayerClass for player `index`, read
    through the nettable payload endpoint: the carrier is one-per-player with
    OwnerIndex = the player's entity index (TFPlayerNetState), and the plan's
    step 3 names this exact read ("tf_player_data class 1 / 6"). Health
    cannot tell scout from medic (both 125); this can.
    Returns (class_number_or_None, why_not)."""
    try:
        carriers = run.srv.ents("tf_player_data")
    except lg.ApiError as why:
        return None, "tf_player_data census unavailable(%s)" % why
    for e in carriers:
        try:
            f = run.srv.fields(e["index"])
        except lg.ApiError:
            continue
        if str(f.get("OwnerIndex")) == str(index):
            try:
                return int(float(f.get("PlayerClass"))), None
            except (TypeError, ValueError):
                return None, "carrier %s has PlayerClass=%r" % (e["index"], f.get("PlayerClass"))
    return None, "no tf_player_data carrier with OwnerIndex=%d (%d carriers)" % (
        index, len(carriers))


def _class_is(run, index, want):
    """wait_for predicate: the carrier's class number, truthy only when it
    equals `want`."""
    got, _ = player_class(run, index)
    return got if got == want else None


def team_spawn_spots(run):
    return [e["origin"] for e in run.srv.ents("info_player_teamspawn")
            if e.get("origin") and any(e["origin"])]


def placement_holds(run, index, pos, seconds=0.6, off_target=64.0, drift=4.0,
                    two_d=False):
    """settle_on's own evidence: two SERVER-side origin samples `seconds`
    apart, each within `off_target` of `pos` and agreeing within `drift`.
    The settle response only ever says the server's reads agreed with
    themselves (run 13: settle=True answered while the player sat ~2000 u
    at his parking spot); whether the player is WHERE he was asked is
    decided here, for every route and every player. The predicted joiner's
    only landing evidence the server can see is this placement holding
    (DebugApiTeleportSettleTests: his ground word never speaks).

    `two_d` measures the target distance on the HORIZONTAL axes only: used
    for the declared-unsimulated player, whose placement at a mid-air
    target is followed by the server's per-command gravity walking him
    down to the ground under it (settle_on waits for that rest first). The
    drift check stays 3-D: a drop still moves him, and drift is what says
    he stopped. Returns (True, "") or (False, why)."""
    try:
        now0 = entity_origin(run.srv, index)
    except Exception:
        now0 = None
    time.sleep(seconds)
    try:
        now1 = entity_origin(run.srv, index)
    except Exception:
        now1 = None
    if now0 is None or now1 is None:
        return False, ("origin unreadable after the teleport (%s, then %s)"
                       % (fmt_pos(now0) if now0 else "unreadable",
                          fmt_pos(now1) if now1 else "unreadable"))
    def _off(a):
        a = list(a)
        if two_d:
            a[2] = pos[2]
        return lg.distance(a, list(pos))

    d0 = _off(now0)
    d1 = _off(now1)
    if d0 > off_target or d1 > off_target:
        return False, ("rests %.0f u off the target (at %s, then %s)"
                      % (max(d0, d1), fmt_pos(now0), fmt_pos(now1)))
    moved = lg.distance(list(now0), list(now1))
    if moved > drift:
        return False, ("still moving at the target: %.0f u between the samples (%s -> %s)"
                       % (moved, fmt_pos(now0), fmt_pos(now1)))
    return True, ""


# A teleport's drop is at most a few tenths of a second (the corridor targets
# sit ~36 u over the floor; 0.3 s of fall), so this is how long the rest wait
# before the hold samples needs. A player who never rests inside it -- riding
# a moving cart, or dropped into a pit -- fails the verdict rather than
# waiting out a window sized for a pit (the pit itself is placement_holds's
# off-target check to catch).
REST_SECONDS = 2.0


def rests_then_holds(run, index, pos, two_d, rest_seconds=REST_SECONDS):
    """The verdict one answered route must earn, whichever player he is:
    he comes to rest FIRST, then the placement holds.

    The route's met can answer while the player is still MID-AIR: the
    teleport zeroes his velocity, so his speed reads 0 before gravity has
    moved him, and the ground word the condition checked is the one he
    stood on before the move (LandedCondition's own doc names the teleport
    tick's stale ground; run 10 at tip f8145cb91: met for "on the ground"
    at z=40 with ground=0 -- the track corridor's floor stands at z=4 --
    then the gate's own samples read 37 -> 4 and the hold failed "still
    moving, 33 u between them", on every route). That drop is not the
    predicted joiner's alone; the host rides it too, and samples that
    straddle it are the run-13 lie in miniature. So the rest wait runs
    for BOTH players before the samples. The joiner's placement stays
    judged on the horizontal axes (his ground word never speaks); the
    host's stays 3-D, so a drop into a pit under the target still fails
    the off-target check."""
    rested, where = wait_until_still(run, index, seconds=rest_seconds)
    if not rested:
        return False, ("never came to rest after the route answered met (last read %s)"
                       % (fmt_pos(where) if where else "unreadable"))
    return placement_holds(run, index, pos, two_d=two_d)


def settle_on(run, index, pos, ang, tries=3, prove=True):
    """Teleport player `index` to `pos` facing `ang` and PROVE it landed:
    grounded is not enough -- run 13's combat step got settle=True while
    one player sat ~2000 u away at his parking spot -- so the verdict is
    rests_then_holds's (he comes to rest, then two server-side samples
    each within 64 u of the target and within 4 u of each other), and the
    route's answer rides along as the context on the failure line. A
    caller that discards the verdict passes prove=False and pays for no
    proof; a discarding caller that later needs one is a bug in the caller.

    The slot-based server route runs FIRST for both players: its settle
    arm now answers met for the predicted joiner once the caller declares
    him simulated=0 (his ground word reads -1 wherever he stands -- the
    server-side move publishes no landing for him -- so the old ground
    wait could only ever time out on him: the fact
    DebugApiTeleportSettleTests writes against the route). His move does
    run when a usercmd arrives, and its gravity walks him off a mid-air
    target (runs 21-22), which is what the drop wait below answers. The
    issuer's own console stays as the later attempt: it cannot name the
    wrong player (runs 13-15 showed the slot route ok:true yet never
    moving the joiner), but its answer says only that the command was
    sent, so the same double-sample placement proof decides for it too.
    Every attempt that fails prints which route ran, what it answered,
    both handles, and where the player actually is."""
    try:
        ent_handle = (run.srv.entity(index=index) or {}).get("handle", "?")
    except Exception:
        ent_handle = "?"
    routes = [teleport_player, teleport_by_command, teleport_player][:tries]
    last = None
    for route in routes:
        try:
            if route is teleport_player:
                # Only the server route can name the slot; only the JOINER
                # (not the listen host's local client, whose commands the
                # server does run) is the one it declares unsimulated.
                resp = route(run, index, pos, ang, simulated=(index == run.p1))
            else:
                resp = route(run, index, pos, ang)
        except Exception as exc:
            last = "route %s threw %s: %s" % (route.__name__, type(exc).__name__, exc)
            run.say("    settle p%d at %s: %s" % (index, fmt_pos(pos), last))
            continue
        if not (isinstance(resp, dict) and resp.get("ok")):
            last = ("route %s refused (%s; entity handle=%s)"
                    % (route.__name__, resp, ent_handle))
            # Printed as it happens, not only in the final failure line:
            # which answer sent the joiner to the console route is the
            # evidence step 0's fix lives or dies by.
            run.say("    settle p%d at %s: %s" % (index, fmt_pos(pos), last))
            continue
        if not prove:
            # A caller that discards the verdict (the payload steps re-place
            # the capper every pump and judge the cart's own movement) pays
            # for no proof: the route's ok IS the placement attempt.
            return True
        two_d = index != run.p1
        held, why = rests_then_holds(run, index, pos, two_d)
        tel_handle = resp.get("handle") or resp.get("route") or "no-handle"
        if held:
            # Printed even on success: which route landed the player is the
            # evidence step 0's fix is supposed to be (the joiner must ride
            # the slot route, status met, and never need the console).
            run.say("    settle p%d at %s held (route %s, status=%s, handle=%s)"
                    % (index, fmt_pos(pos), route.__name__, resp.get("status", "ok"),
                       tel_handle))
            return True
        last = ("%s (route %s answered status=%s handle=%s vs entity handle=%s, answered %s)"
                % (why, route.__name__, resp.get("status", "ok"), tel_handle, ent_handle, resp))
        run.say("    settle p%d at %s: %s" % (index, fmt_pos(pos), last))
    run.say("    settle p%d at %s failed: %s" % (index, fmt_pos(pos), last))
    return False


def player_state(run, index):
    """The field values that say WHY a player under +forward answers 0 u:
    Alive (the respawn-mode flag the second-client step at live-gate's 4551
    waits on), ObserverMode, Ducked. For the probe lines, not a verdict."""
    try:
        f = run.srv.fields(index)
        e = run.srv.entity(index=index) or {}
    except lg.ApiError as why:
        return "fields unavailable(%s)" % why
    # MaxSpeed/MoveType from the nettable: MaxSpeed=0 while +forward is held
    # is the movement rules zeroing the class speed; MaxSpeed=400 with speed
    # 0 is the input never arriving. GroundEntity/asleep separate "stuck in
    # geometry / flying" from "simulated but not walking".
    # OldForwardMove separates the two halves of the input path: OldButtons=8
    # (IN_FORWARD) with OldForwardMove=0 is the button arriving and the analog
    # wish amount never being folded from it; both non-zero and speed 0 is the
    # movement rules zeroing the walk. TickBase says whether commands are
    # arriving at all right now.
    parts = ["%s=%s" % (k, f.get(k)) for k in
             ("Alive", "ObserverMode", "Ducked", "MaxSpeed", "MoveType",
              "GroundEntity", "OldButtons", "OldForwardMove", "TickBase")]
    parts.append("asleep=%s" % e.get("asleep"))
    parts.append("conds[" + carrier_conds(run, index) + "]")
    parts.append("client[" + client_input_dump(run, index) + "]")
    return ",".join(parts)


def client_input_dump(run, index):
    """What the CLIENT of this player index (its debug-channel slot, the same
    addressing as live-gate's client_crossings) says about the held key, read
    through the server's proxy at /client/{slot}/input. It splits the
    OldButtons=8/OldForwardMove=0 signature three ways, which the server-side
    reading cannot:
      held[]          -- the managed KeyButton states with state!=0. Empty
                         while +forward is held on that client's console means
                         the press never reached the managed button at all.
      mouseActive=    -- the flag the engine hands CreateMove beside the
                         sequence number (shell_clientdll.cpp). ClientInput.
                         CreateMove computes the wish amounts only when it is
                         true, while GetButtonBits reports buttons either
                         way -- so False with buttons arriving is exactly
                         "button seen, wish never folded".
      lastcmd[fwd=]   -- the analog forward of the newest usercmd as the
                         client recorded sending it. 0 with held[forward=1]
                         locates the loss in the client's CreateMove; 400
                         with OldForwardMove=0 server-side locates it on the
                         wire or in the command loop.
    '-' arms when the route cannot be reached: an unavailable reading is
    printed, never dropped, so a stuck probe always says what it asked."""
    try:
        dump = run.srv.get("client", str(index), "input")
    except lg.ApiError as why:
        return "unavailable(%s)" % str(why)[:60]
    if not isinstance(dump, dict):
        return "unavailable(not a dict)"
    parts = []
    held = ",".join("%s=%s" % (b.get("name"), b.get("state"))
                    for b in (dump.get("buttons") or []) if b.get("state"))
    parts.append("held[%s]" % (held or "-"))
    parts.append("mouseActive=%s" % (dump.get("mouse") or {}).get("active"))
    cmds = dump.get("commands") or []
    if cmds:
        c = cmds[-1]
        parts.append("lastcmd[fwd=%s,side=%s,btn=%s]" % (
            c.get("forward"), c.get("side"), c.get("buttons")))
    else:
        parts.append("lastcmd=-")
    return "|".join(parts)


def wait_pump(run, label, pred, seconds, step=1.0, beat=15.0):
    """wait_for with a printed heartbeat. An ApiError from the predicate is
    NOT swallowed (a game whose socket stops answering must FAIL the step,
    naming the error, not be mistaken for a slow wait); what this adds over
    live-gate's wait_for is the line every `beat` seconds. Run 10 of this
    gate died that way, not as a failure of its own: the join's 120+90+90 s
    waits said nothing for 164 s, the tool call watching the run was reaped
    as hung, the reaper signalled the whole process group, and the games and
    the gate went down with it mid-wait -- silent, exit 2, no report row. A
    gate that waits must say it is waiting.

    Like wait_for it hands back the predicate's truthy VALUE, not a bare
    True -- teams and heal read that value (run 11 learned this the hard
    way, when the teams step got a bool and crashed on .get)."""
    t0 = time.time()
    last_beat = t0
    while True:
        got = pred()
        if got:
            return got
        now = time.time()
        if now - t0 >= seconds:
            return None
        if now - last_beat >= beat:
            run.say("    .. still waiting for %s (%.0f s of %.0f)" % (
                label, now - t0, seconds))
            last_beat = now
        time.sleep(step)


WAITING_LINE = "[TF2/Rounds] waiting for players"


def end_the_wait_when_armed(run):
    """Send mp_waitingforplayers_cancel again once the waiting-for-players
    window is actually UP. The sends beside the joins can land before the
    round machine arms the wait, and stock's cancel arm then spends the
    convar for nothing (teamplayroundbased_gamerules.cpp:948-973: cleared on
    whatever think reads it first). The managed SetInWaitingForPlayers logs
    its arming line to the server console ([TF2/Rounds] waiting for players):
    mark the console, wait for that line to appear AFTER the mark (each map
    load answers for its own window), and send the cancel beside it -- the
    window then closes in seconds instead of running its full time."""
    run.mark()
    wait_pump(run, "waiting-for-players window armed",
              lambda: WAITING_LINE in run.read_console_since_mark() or None,
              40.0, 0.5)
    run.srv.cmd("mp_waitingforplayers_cancel 1")


def carrier_conds(run, index):
    """The carrier's condition words for the stuck-state probe: the
    TFMaxSpeed arms that answer 0 (DisguisedAsDispenser and not stealthed)
    or clamp hard (Aiming) decide from these words, and a condition stuck on
    in the nettable would zero the walk while every other reading stays
    clean. Answer '-' when the carrier itself cannot be found."""
    try:
        for e in run.srv.ents("tf_player_data"):
            try:
                f = run.srv.fields(e["index"])
            except lg.ApiError:
                continue
            if str(f.get("OwnerIndex")) == str(index):
                return ",".join("%s=%s" % (k, f.get(k)) for k in
                                ("PlayerCond", "PlayerCondEx", "PlayerCondEx2",
                                 "PlayerCondEx3", "PlayerCondEx4"))
    except lg.ApiError:
        pass
    return "-"


def carrier_beam(run, index):
    """The medic's beam state on his tf_player_data carrier: what
    TFMedigunWeapon.Publish() writes as HealTargetIndex/ChargeLevel. A
    target index says the beam found its patient (and points the bug at
    the accumulation); -1/None every time says target acquisition never
    hit. Answer (None, None) when the carrier cannot be found."""
    try:
        for e in run.srv.ents("tf_player_data"):
            try:
                f = run.srv.fields(e["index"])
            except lg.ApiError:
                continue
            if str(f.get("OwnerIndex")) == str(index):
                return f.get("HealTargetIndex"), f.get("ChargeLevel")
    except lg.ApiError:
        pass
    return None, None


def services_probe(api, names):
    """Which of the named service contracts the side's container holds:
    the debug-api services view (DebugStatus's rows spell the contract in
    LookedUpBy). '?' when the side cannot be asked."""
    try:
        text = api.raw("services", "type")
    except lg.ApiError:
        return "?"
    return ",".join("%s=%s" % (n, "yes" if n in text else "no") for n in names)


def teleport_player(run, index, pos, ang, settle=True, ticks=330, simulated=True):
    """The server's /player/teleport for player entity `index` (the route
    resolves player=N through PlayerHandle; the CLIENT game's World.Teleport
    is a no-op -- EngineBinding.Client.cs:990 -- so the server is the only
    one that can place the listen game's own player). The settle response
    means only "stood still 3 ticks on the server" (or, for a player
    declared simulated=0, that the placement held on the target: an idle
    predicted joiner's ground word reads -1 wherever he stands, so that is
    the only landing evidence the server has -- DebugApiTeleportSettleTests);
    whether the player is WHERE it was asked to is settle_on's own
    double-sample re-read."""
    params = {"pos": ",".join("%g" % v for v in pos), "player": index}
    if ang is not None:
        params["ang"] = ",".join("%g" % v for v in ang)
    if settle:
        params.update({"settle": 1, "timeout": int(ticks)})
    if not simulated:
        params["simulated"] = 0
    return run.srv.get("teleport", *lg.query(params), timeout=max(30.0, ticks * 0.15) + 20)


def wait_until_still(run, index, seconds=4.0, poll=0.2, still=1.0):
    """Poll the SERVER's origin read of player `index` until two samples
    `poll` s apart agree within `still` u, or the window runs out. The
    joiner's drop after a placement needs it: the route answers met the
    moment the placement holds (stableTicks, speed 0), and only THEN does
    the server's per-command gravity start walking him down to the ground
    under the target. Returns (True, origin) once consecutive samples
    agree, (False, last read) if he never stops within the window."""
    deadline = time.time() + seconds
    try:
        prev = entity_origin(run.srv, index)
    except Exception:
        prev = None
    while time.time() < deadline:
        time.sleep(poll)
        try:
            now = entity_origin(run.srv, index)
        except Exception:
            return False, prev
        if now is None:
            return False, prev
        if prev is not None and lg.distance(list(now), list(prev)) <= still:
            return True, now
        prev = now
    return False, prev


def teleport_by_command(run, index, pos, ang):
    """setpos_exact (+ setang_exact) through the player's OWN console: the
    server dispatches registered names from a client's command with the
    SENDING player as issuer (PlayerCheatCommands.cs's header: registration
    is the only path engine->ServerCommand reaches -- exactly how the
    classes step's client-side joinclass lands as #2), and these two move
    THEIR ISSUER, not a slot number the caller may have mistranslated. The
    server route above resolves player=N through PlayerHandle; runs 13-15
    showed it ok:true every time yet never moved the predicted joiner (all
    four p2 track/park/combat placements read back at his spawn room),
    while the listen game's own player was verified placed repeatedly --
    so for p2 the issuer route is the one that cannot name the wrong
    player. Needs sv_cheats (launch sets it once).

    The slot route is nevertheless FIRST for both players now (runs 21-22
    read what a placement does for the joiner): the route moves the
    server's player to the target, zero velocities him and answers met on
    the placement holding (stableTicks=3, speed 0 -- the simulated=0 arm
    step 0 wrote); and only THEN does the server's per-command gravity
    start walking him down from a mid-air target (met at z=35, sampled at
    z=4 a later instant), dropping him onto the ground under it. Issuing
    setpos_exact from his console in between only re-places him for another
    falling second -- it does not re-anchor his client (run 22: the samples
    sank z=33 -> z=4 right through the re-anchor). So settle_on waits for
    that drop to come to rest and judges the placement horizontally; this
    console route stays as the later whole-attempt fallback, the one that
    cannot name the wrong player, judged the same way."""
    # Each player's commands come from the console he himself owns: the
    # listen host's are the SERVER console (the heal's srv-console hurtme
    # killed exactly that player, run 18), the joiner's are his own client
    # console (the classes joinclass landed as #2). Issuer-based: no slot
    # number, so a stale slot table cannot move the wrong player or nobody.
    api = run.srv if index == run.p1 else run.client.api
    api.cmd("cmd setpos_exact %g %g %g" % tuple(pos))
    if ang is not None:
        api.cmd("cmd setang_exact %g %g 0" % (ang[0], ang[1]))
    return {"ok": True, "route": "issuer-console", "issuer": "#%d" % index}


def report_park(run, index, speed):
    """Where the finished runner stands after his run, as a report number --
    NOT a gate. The two runs share one corridor, so three attempts parked the
    finished runner ahead of the other one:

    <para>
    Run 13 parked p2 on spots[0], the ENEMY team's spawn room: every combat
    teleport ended at his own spawn 1942 u away (func_respawnroom claims a
    player a TELEPORT takes out of its brush). Run 14 parked him on his OWN
    team's spawn, where the game itself had spawned him and the hold verified
    at park time -- STILL claimed, at 3226 u. The room accepts him standing;
    it is the teleport OUT of its volume that meets the return. Runs 14 and 15
    then parked on each runner's own captured spawn point: verified true at
    park time, and combat still found the heavy 3226 u off at a spawn.
    </para>

    <para>
    So the park moved onto the track itself, 550 u along it -- and run 16
    measured why that is wrong ground too: the scout, teleported there with
    the heavy's run still to come, "never stood on ground after the
    teleport", and the settle that did land put him at z=18 for a 40 target,
    70 u down the corridor from where it put him. The corridor floor falls
    away before 550 u; the only ground with a verified settle is the track
    START itself, and a park there would stand the scout in the heavy's lane.
    </para>

    <para>
    What the park was for, though, does not need it. Each runner is teleported
    to the track start and held there by the wait, so the only way the first
    can block the second is by still standing near it when the second arrives
    -- and the runs that this step accepts are full-speed runs that carry him
    hundreds of u away. So the park is REPORTED, not gated, and what gates the
    lane is the next step's own settle_on, which verifies the placement it is
    about to measure against. A gate on the park would be a second, weaker
    claim about the same ground -- and the two parks that verified true are
    exactly what misled runs 14 and 15 into thinking combat's 3226 u was
    something other than a spawn claim.
    </para>
    """
    origin = entity_origin(run.srv, index)
    if not origin:
        return "unreadable"
    fx, fy = forward_of(TRACK_YAW)
    along = ((origin[0] - TRACK_SPOT[0]) * fx + (origin[1] - TRACK_SPOT[1]) * fy)
    return "%d u along the corridor (%s), speed %s" % (
        int(round(along)), fmt_pos(origin),
        "unmeasurable" if speed is None else "%.1f u/s" % speed)


def speed_run_once(run, index, buttons):
    """One +forward run along the open track, as
    (moved_u, elapsed_s, wall_bound_u_or_None, state_when_stuck). Three
    origin samples bracket the 1.0 s window; each read costs its own API
    latency, so elapsed is the SAMPLE timestamps' span, not the sleeps'
    sum, and the speed division uses it. The player is teleported to the
    track facing +X; +forward is held for the 0.3 s run-up before the first
    sample so acceleration is out of the window.

    wall_bound is the distance from the track spot when the run stopped:
    the second half's speed is less than half the first half's after a real
    start -- it moved, then something (a wall, a prop, the other player)
    stopped it. Such a run measures no speed; the caller fails it. A run
    that never moved at all is NOT wall-bound: its state (alive, observer,
    the client's held/lastcmd input dump) rides back instead, read WHILE
    THE BUTTON IS HELD."""
    if not settle_on(run, index, TRACK_SPOT, (0.0, TRACK_YAW, 0.0)):
        return None, None, None, "never settled on the track at %s" % fmt_pos(TRACK_SPOT)
    buttons("+forward")
    time.sleep(SPEED_PREROLL_SECONDS)
    ta = time.time()
    a = entity_origin(run.srv, index)
    time.sleep(SPEED_MEASURE_SECONDS / 2.0)
    tm = time.time()
    m = entity_origin(run.srv, index)
    time.sleep(SPEED_MEASURE_SECONDS / 2.0)
    tb = time.time()
    b = entity_origin(run.srv, index)
    moved = lg.distance(a[:2], b[:2]) if (a and b) else None
    # Read everything that can explain a stuck player WHILE THE BUTTON IS
    # STILL HELD; after -forward the readings rot.
    state = player_state(run, index) if (moved is not None and moved < 1.0) else None
    buttons("-forward")
    if not a or not m or not b:
        return None, None, None, "origin unreadable during the window"
    d1 = lg.distance(a[:2], m[:2])
    d2 = lg.distance(m[:2], b[:2])
    v1 = d1 / max(tm - ta, 1e-3)
    v2 = d2 / max(tb - tm, 1e-3)
    if moved >= 16.0 and v2 < 0.5 * v1:
        return None, None, lg.distance(TRACK_SPOT[:2], b[:2]), None
    return moved, tb - ta, None, state


def measure_speed(run, index, buttons, expected, tag):
    """(u_per_s, detail, home) for the track run, or (None, refusal, None).
    The run-up covers acceleration; one retry covers a window that caught a
    stumble. A wall-bound run is a FAILURE naming the distance it stopped
    at -- the integrator's ruling (run 12's scout "no probe moved" was the
    spawn-room walls, not the game: a scout from RED spawn stops 72-200 u
    later, at a wall). `home` is always the track: combat and heal reuse
    it as the corridor they fight and beam along."""
    if not wait_pump(run, "%s: Alive=true after spawn" % tag,
                     lambda: run.is_alive(index) or None, 30.0):
        return None, "never became Alive=true within 30 s (respawn mode?)", None
    home = (list(TRACK_SPOT), TRACK_YAW)
    best = None
    last_state = None
    for attempt in (1, 2):
        moved, elapsed, wall_u, state = speed_run_once(run, index, buttons)
        if wall_u is not None:
            run.say("    %s track %d: WALL-BOUND after %.0f u (clear stretch ends ~630 u)"
                    % (tag, attempt, wall_u))
            return None, ("wall-bound run: stopped %.0f u along the open track"
                          " -- the window measured a wall, not a speed" % wall_u), None
        if moved is None:
            last_state = state
            run.say("    %s track %d: %s" % (tag, attempt, state))
            continue
        speed = moved / max(elapsed, 1e-3)
        if moved < 1.0:
            last_state = state
        if best is None or moved > best[0]:
            best = (moved, elapsed)
        run.say("    %s track %d: %.0f u over %.2f s = %.1f u/s (want %.0f +- %d%%)%s" % (
            tag, attempt, moved, elapsed, speed, expected, int(SPEED_TOLERANCE * 100),
            (" state[" + state + "]") if state else ""))
        if speed_within(moved, elapsed, expected):
            return speed, "moved %.0f u over %.2f s on the open track" % (
                moved, elapsed), home
    if best is None:
        return None, ("both track runs read no origin (last state: %s)" % last_state), None
    best_moved, best_elapsed = best
    if best_moved < 1.0:
        return best_moved / max(best_elapsed, 1e-3), (
            "the track run never moved (last state: %s)" % last_state), None
    return best_moved / max(best_elapsed, 1e-3), "moved %.0f u over %.2f s (best of 2)" % (
        best_moved, best_elapsed), home


def step_classes(run, state):
    numbers = {}
    run.srv.cmd("cmd joinclass scout")
    run.client.api.cmd("cmd joinclass heavyweapons")

    # The core's own announcement first: a classless player picking a class
    # takes the instant-spawn arm ("joins as <class> now"). The line is the
    # evidence that the RIGHT class took effect -- the health numbers alone
    # cannot tell scout from medic (both 125), and a class queued behind the
    # current life ("will be ... at the next spawn") means the walk and the
    # fight below would run against the wrong player.
    def joined_now(index, want):
        ev = run.class_evidence(index)
        return ev if ev and ev[0] == "now" and ev[1] == want else None

    scout_now = wait_pump(run, "classes: scout join line",
                         lambda: joined_now(run.p1, "scout"), 30.0)
    heavy_now = wait_pump(run, "classes: heavyweapons join line",
                          lambda: joined_now(run.p2, "heavyweapons"), 30.0)
    numbers["scout_join_line"] = (run.class_evidence(run.p1) or ("-", "-", "(no joinclass line)"))[2]
    numbers["heavy_join_line"] = (run.class_evidence(run.p2) or ("-", "-", "(no joinclass line)"))[2]
    if not (scout_now and heavy_now):
        return "FAIL", numbers

    # "max health right after spawn": Api.fields Health, waited for because
    # the joinclass respawns; the value, the expected and the time are all
    # recorded either way.
    t0 = time.time()
    scout_up = wait_pump(
        run, "classes: scout Health up to %d" % CLASS_HEALTH["scout"],
        lambda: health_is(run.srv.fields(run.p1), CLASS_HEALTH["scout"]), 90.0)
    numbers["scout_health"] = run.health(run.p1)
    heavy_up = wait_pump(
        run, "classes: heavyweapons Health up to %d" % CLASS_HEALTH["heavyweapons"],
        lambda: health_is(run.srv.fields(run.p2), CLASS_HEALTH["heavyweapons"]), 90.0)
    numbers["heavy_health"] = run.health(run.p2)
    numbers["scout_health_expected"] = CLASS_HEALTH["scout"]
    numbers["heavy_health_expected"] = CLASS_HEALTH["heavyweapons"]
    numbers["spawn_wait_seconds"] = "%.1f" % (time.time() - t0)
    if not (scout_up and heavy_up):
        # Show which of "the field is absent from /payload" and "the value is
        # wrong" this is, instead of two None's.
        numbers["field_dump_p1"] = run.field_dump(run.p1)
        numbers["field_dump_p2"] = run.field_dump(run.p2)
        return "FAIL", numbers

    # The plan's own class read (step 3: "tf_player_data class 1 / 6"). This
    # is the check that cannot confuse the classes behind the health numbers.
    scout_cls = wait_pump(run, "classes: scout carrier PlayerClass",
                         lambda: _class_is(run, run.p1, CLASS_NUM["scout"]), 30.0)
    heavy_cls = wait_pump(run, "classes: heavyweapons carrier PlayerClass",
                          lambda: _class_is(run, run.p2, CLASS_NUM["heavyweapons"]), 30.0)
    numbers["scout_class_field"] = "%s %s" % (player_class(run, run.p1)[0:2])
    numbers["heavy_class_field"] = "%s %s" % (player_class(run, run.p2)[0:2])
    if not (scout_cls and heavy_cls):
        return "FAIL", numbers

    # Where the game itself put each of them (their own team's spawn room).
    # Not the park spot -- runs 13-15 showed any teleport OUT of a room
    # meets a return (park_off_track's comment) -- but recorded so a later
    # placement that lands at a spawn reads as the claim it is.
    numbers["home_p1"] = (lambda o: fmt_pos(o) if o else "unreadable")(
        entity_origin(run.srv, run.p1))
    numbers["home_p2"] = (lambda o: fmt_pos(o) if o else "unreadable")(
        entity_origin(run.srv, run.p2))

    scout_speed, scout_detail, scout_home = measure_speed(
        run, run.p1, run.buttons_p1, CLASS_SPEED["scout"], "scout")
    # The corridor each runner uses starts with a teleport to the track spot
    # and the settle's 64 u hold there, so a runner standing anywhere but the
    # start cannot block the other: the scout's own 400 u/s run carries him
    # past the heavy's reach. Where the finished runner stands is reported
    # (report_park: runs 13-16 of parks, and why the gate is the next step's
    # settle, not a park here), not gated.
    park_p1 = report_park(run, run.p1, scout_speed)
    heavy_speed, heavy_detail, heavy_home = measure_speed(
        run, run.p2, run.buttons_p2, CLASS_SPEED["heavyweapons"], "heavy")
    park_p2 = report_park(run, run.p2, heavy_speed)
    if heavy_home:
        state["heavy_home"] = heavy_home
    numbers["scout_speed"] = "%.1f" % scout_speed if scout_speed is not None else "unmeasurable"
    numbers["scout_speed_expected"] = CLASS_SPEED["scout"]
    numbers["heavy_speed"] = "%.1f" % heavy_speed if heavy_speed is not None else "unmeasurable"
    numbers["heavy_speed_expected"] = CLASS_SPEED["heavyweapons"]
    numbers["speed_tolerance"] = SPEED_TOLERANCE
    numbers["scout_run"] = scout_detail
    numbers["heavy_run"] = heavy_detail
    numbers["park_p1"] = park_p1
    numbers["park_p2"] = park_p2

    def speed_ok(speed, want):
        return (speed is not None
                and abs(speed - want) <= want * SPEED_TOLERANCE)

    ok = (speed_ok(scout_speed, CLASS_SPEED["scout"])
          and speed_ok(heavy_speed, CLASS_SPEED["heavyweapons"]))
    return ("PASS" if ok else "FAIL"), numbers


def step_weapon(run, state):
    """Stage 4.2 step 3b, the carried weapon in the frame: what two lanes
    could not prove (docs/todo.md, thirdperson's weapon redraw -- the fix is
    f5ac6388a's SetRestingThirdPersonSeen re-ask; this step is its regression
    test). Over the gate's own two boots:

      * Another player's view: the listen game's own client records its next
        frame; the frame names p2's body (the control -- a frame that draws
        nothing proves nothing) and p2's carried ss_weapon entity, matched by
        its srv-side ent index (one process, one numbering). Repeated with
        p2 in each TRIED_CLASSES, every class carrying a different weapon.
      * p1's own view: first person -- only the watched player's body is
        under models/player/; `thirdperson` (a cheat, and sv_cheats is
        already on) -- the owner's own body rejoins it, the resting re-ask
        f5ac6388a's SetRestingThirdPersonSeen drives; `firstperson` -- one
        body again. All three arms on the one player, so the flip is the
        subject and not the scene. If the resting third-person re-ask stops
        happening, the third-person arm goes red with the second body
        missing.

    The frames ride cs_cl_render_trace (RenderPlanHost.cs: records the next
    frame to the file; live-gate's own plan-frame reader waits the same way,
    on the render.PopView line that says the whole frame was written)."""
    numbers = {}
    run.srv.cmd("sv_cheats 1")  # thirdperson is a cheat; the combat step's same insurance

    if not wait_pump(run, "weapon: both players alive",
                     lambda: run.is_alive(run.p1) and run.is_alive(run.p2), 60.0):
        numbers["detail"] = "a player was not alive when the step started (p1 %r, p2 %r)" % (
            run.is_alive(run.p1), run.is_alive(run.p2))
        return "FAIL", numbers

    # The geometry: the listen game's own client records every frame here --
    # one console, one entity numbering (the srv indices), and its setang
    # reaches its own live view angles (run 20261102-181640 proved setang
    # reaches the live view on a join client: after one the recorded frame's
    # prop draws shifted). The observer (the listen game's own player p1)
    # stands on the proven-flat corridor spot facing down its heading, and
    # the SUBJECT (p2, the join client's player) is the observed one: his
    # body and carried weapon must appear in p1's frame, which is the same
    # "another player's view names the carried weapon" the step is about,
    # with roles mirrored because the listen game is the recorder whose
    # numbering the trace answers in. The subject is placed relative to the
    # RECORDED CAMERA, not to the corridor spot: run 20261102-182433 showed
    # a camera still parked at its spawn corner (~2100 u from the corridor)
    # culled the far body from its frame even while aimed at it -- distance,
    # not angle, drops it -- so each attempt reads where the camera actually
    # stood and stands the subject ~120 u ahead of that, facing back.
    spot = list(TRACK_SPOT)
    fx, fy = forward_of(TRACK_YAW)
    front = [spot[0] + fx * 200.0, spot[1] + fy * 200.0, spot[2]]
    if not settle_on(run, run.p1, spot, (0.0, TRACK_YAW, 0.0)):
        numbers["detail"] = ("the observer would not settle at %s facing %s"
                             % (fmt_pos(spot), fmt_pos(front)))
        return "FAIL", numbers
    if not settle_on(run, run.p2, front, (0.0, TRACK_YAW + 180.0, 0.0)):
        numbers["detail"] = ("the subject would not settle at %s facing back at %s"
                             % (fmt_pos(front), fmt_pos(spot)))
        return "FAIL", numbers

    def joined_away(index, want):
        """Any joinclass announcement for `want` -- run 20261102-172410 at
        tip d7dbf6b25: an already-classed live player answers the QUEUED arm
        ("will be Heavy at the next spawn"), not the instant-spawn one the
        classes step's first pick got. Which arm fires is the game's business;
        the class taking effect is measured below by Health, the same
        per-class number the classes step gates on."""
        ev = run.class_evidence(index)
        return ev if ev and ev[1] == want else None

    def srv_weapon(owner_index):
        """(index, listed): the ss_weapon whose networked OwnerIndex names
        `owner_index` in the SERVER directory, with how many weapons were
        listed so a miss says whether the list was empty or only this one's
        owner went unmatched."""
        try:
            listed = run.srv.ents("ss_weapon")
        except lg.ApiError:
            return None, "-"
        for e in listed:
            try:
                owner = run.srv.fields(e["index"]).get("OwnerIndex")
            except lg.ApiError:
                continue
            if str(owner) == str(owner_index):
                return e["index"], len(listed)
        return None, len(listed)

    def handle_of(api, index):
        """The handle `api` shows for entity `index` (None when it does not
        answer). Handles are shared bits across the two sides (the raw
        EntityHandle survives replication), so a handle read through the
        server list joins the same entity in any other side's own numbering --
        which is the numbering that side's render trace answers with (run
        20261102-174410 at tip d7dbf6b25: srv listed the carried weapon at 415
        while the join client's frame named its draws 110..423; the client's
        own /ents list answered empty, so membership must be joined by handle,
        not by comparing indices across sides)."""
        try:
            ent = api.entity(index=index)
        except lg.ApiError:
            return None
        return (ent or {}).get("handle")

    def index_by_handle(api, handle):
        """(index, raw): what `api` calls the entity whose handle is
        `handle`, with the reply for the failure detail."""
        try:
            got = api.entity(handle=str(handle))
        except lg.ApiError as why:
            return None, str(why)[:80]
        if not got:
            return None, "not-found"
        return got.get("index"), repr(got)[:100]

    def trace_frame(api, path, label):
        """Record `api`'s next frame to `path` and wait for the whole file
        (live-gate's marker: the done callback writes the completed frame
        once, so a PopView line says the write finished). None when no frame
        arrives -- an unrecorded frame fails its arm, never skips it.

        The console reaches both games through their own debug-api sockets;
        run 20261102-172937 at tip d7dbf6b25: the plain shape answered ok
        yet wrote nothing on the join client, so after a short beat the
        prefixed shape (the one live-gate's own client-console calls use) is
        sent too. The second write overwrites the first whole; the marker
        only reads a finished frame."""
        answer = api.cmd("cs_cl_render_trace %s" % path)

        def done():
            try:
                with open(path, errors="replace") as handle:
                    text = handle.read()
            except OSError:
                return None
            return text if "\nrender.PopView" in text else None

        text = wait_pump(run, "%s (plain)" % label, done, 8.0, beat=30.0)
        if text is None:
            answer = api.cmd("cmd cs_cl_render_trace %s" % path)
            text = wait_pump(run, "%s (prefixed)" % label, done, 12.0, beat=30.0)
        if text is None:
            # Say what the console answered and what the file holds, so a
            # red row names the missing piece instead of just a timeout.
            try:
                with open(path, errors="replace") as handle:
                    head = handle.read(120)
            except OSError:
                head = "(missing)"
            run.say("    %s: console answered %r, file head %r" % (label, answer, head))
        return text

    def frame_camera(frame_text):
        """(origin, yaw) of the frame's first Push3DView line -- where the
        recorded camera actually stood and which way it looked (the entity's
        server-side position can sit elsewhere a beat after a teleport, run
        20261102-182103, so placement and aim key on the recorded camera)."""
        for line in frame_text.split("\n"):
            if not line.startswith("render.Push3DView\t"):
                continue
            m = re.search(r"origin=(-?[\d.]+),(-?[\d.]+),(-?[\d.]+)", line)
            if not m:
                continue
            origin = [float(m.group(k)) for k in (1, 2, 3)]
            a = re.search(r"angles=(-?[\d.]+),(-?[\d.]+),", line)
            yaw = float(a.group(2)) if a else TRACK_YAW
            return origin, yaw
        return None, None

    def subject_spot(cam, yaw):
        """Where the subject must stand to sit inside `cam`'s frustum and
        well inside its far clip: ~120 u ahead of the recorded camera along
        its heading."""
        if not cam:
            return front
        dx, dy = forward_of(yaw)
        return [cam[0] + dx * 120.0, cam[1] + dy * 120.0, cam[2]]

    # -- another player's view, once per tried class ----------------------------
    # The listen game's own client (p1) watches; the SUBJECT whose class flips
    # and whose weapon must be drawn is p2, the join client's player: his own
    # console answers joinclass and hurtme, and p1's frame is what the trace
    # writes. The subject's weapon is matched by its srv-side ent index (the
    # recorder shares the server's numbering -- run 20261102-174410: only the
    # join client's numbering drifted, inside one process they agree).
    for cls in TRIED_CLASSES:
        run.client.api.cmd("cmd joinclass %s" % cls)
        joined = wait_pump(run, "weapon: p2 joins as %s" % cls,
                           lambda cls=cls: joined_away(run.p2, cls), 30.0)
        # A live player's second pick queues ("will be X at the next spawn",
        # run 20261102-174746: Health sat at the old class through the whole
        # window); the respawn step's own hurtme makes the next spawn now.
        run.client.api.cmd("cmd hurtme 9999")
        up = wait_pump(run, "weapon: %s Health up" % cls,
                       lambda: health_is(run.srv.fields(run.p2), CLASS_HEALTH[cls]), 90.0)
        # The announcement is evidence, not the gate: a same-class pick can
        # answer without one, and Health -- the per-class number the classes
        # step gates on -- is what proves the class took effect.
        numbers["joined_%s" % cls] = bool(joined)
        numbers["health_%s" % cls] = run.health(run.p2)
        if not up:
            numbers["detail"] = ("p2 never settled as %s before the trace (joinclass line %r, "
                                 "Health %s expected %s)"
                                 % (cls, bool(joined), run.health(run.p2), CLASS_HEALTH[cls]))
            return "FAIL", numbers

        # The server pair, for the row: the srv index of p2's weapon and how
        # many weapons the server directory lists.
        wi_srv, listed = srv_weapon(run.p2)
        numbers["weapon_srv_%s" % cls] = "%s/%s" % (wi_srv, listed)

        # Up to three frames. Run 20261102-175725: the frame right after a
        # hurtme respawn drew only props -- the respawned player's models
        # stream in a beat after the spawn, and a control that early reads
        # empty. Each attempt re-reads where the camera stood and re-places
        # the subject ahead of it (a camera that lagged behind its entity at
        # the spawn corner culls the corridor-distance subject otherwise, run
        # 20261102-182433). The last frame read decides.
        text = None
        draws = []
        body_ok = False
        body_model = None
        weapon_model = None
        drawn = False
        view_origin = None
        cam_yaw = TRACK_YAW
        for attempt in range(4):
            # Settle and aim FIRST (from the last recorded camera spot when
            # there is one), then record: run 20261102-184407 showed a frame
            # recorded between the settle and the streamed body reads as an
            # empty scene even when the settle held. The OBSERVER is re-settled
            # every attempt too, not just once before the class loop: a round
            # restart (the waiting-for-players window closing mid-step) moves
            # it back to its spawn corner between attempts, and run
            # 20261102-191731's thin second-class frames are exactly that.
            if not settle_on(run, run.p1, spot, (0.0, TRACK_YAW, 0.0)):
                numbers["detail"] = ("the observer would not re-settle at %s during the %s "
                                     "attempt" % (fmt_pos(spot), cls))
                return "FAIL", numbers
            sub = subject_spot(view_origin, cam_yaw)
            if not settle_on(run, run.p2, sub, (0.0, TRACK_YAW + 180.0, 0.0)):
                numbers["detail"] = ("the subject would not settle at %s after the %s "
                                     "respawn" % (fmt_pos(sub), cls))
                return "FAIL", numbers
            live = entity_origin(run.srv, run.p2) or sub
            aim = lg.angles_to(view_origin or spot, [live[0], live[1], live[2] + 64.0])
            run.srv.cmd("cmd setang %.1f %.1f 0" % aim)
            numbers["p2_setang"] = "%.0f/%.0f" % aim
            # A round restart (the waiting-for-players window closing mid-step)
            # moves the OBSERVER back to its spawn corner between attempts:
            # run 20261102-191731 read the second class's frames from the
            # corner, where nothing but the two viewmodel pairs drew. Re-aim
            # at the subject's live spot every attempt, just as the subject
            # is re-placed every attempt.
            time.sleep(1.5)
            text = trace_frame(run.srv,
                               os.path.join(run.scratch, "weapon-p2-%s.txt" % cls),
                               "weapon: p1's watch (%s)" % cls)
            if text is not None:
                draws = rendered_draws(text)
                view_origin, cam_yaw = frame_camera(text)
                # The body draw is the one under models/player/ and the held
                # weapon the one under models/weapons/ (run 20261102-183046
                # at tip d7dbf6b25: the listen client's frames list props
                # under models/props_*, the watched player's body under
                # models/player/ and the held pair under models/weapons/;
                # ent numbers differ between the passes within even one
                # client -- srv listed p2's weapon at 421 while its viewmodel
                # pair drew at 414/417 -- so the paths, not the indices, are
                # the stable match. The srv ent stays in the row as extra.)
                this_body = any("models/player/" in mdl.lower() for (_ent, mdl) in draws)
                this_wm = next((mdl for (_ent, mdl) in draws
                                if "/weapons/" in mdl.lower()), None)
                this_bm = next((mdl for (_ent, mdl) in draws
                                if "models/player/" in mdl.lower()), None)
                # Keep-best: the last read is no longer the only one that
                # decides (run 20261102-191025: the scout attempt's first two
                # frames drew body and weapon, a later one drew thin). Any
                # frame with the control answers; between good ones the later
                # does. A frame without the control only speaks when none so
                # far had one.
                if this_body and (not body_ok or this_wm):
                    body_ok = True
                    drawn = bool(this_wm)
                    weapon_model = this_wm
                    body_model = this_bm
                if body_ok and drawn:
                    break
            time.sleep(2.0)

        numbers["p2_body_%s" % cls] = body_ok
        numbers["p2_weapon_%s" % cls] = bool(drawn)
        numbers["p2_view_%s" % cls] = fmt_pos(view_origin) if view_origin else "none"
        if weapon_model:
            numbers["weapon_model_%s" % cls] = weapon_model.rsplit("/", 1)[-1]
        if body_model:
            numbers["body_model_%s" % cls] = body_model.rsplit("/", 1)[-1]
        if cls == TRIED_CLASSES[0]:
            # One evidence line so a red row can be read without the file --
            # the whole draw set, not the head: run 20261102-180047 showed the
            # first eight lines can be all props and hide whether any player
            # draw exists at all.
            run.say("    watch frame draws (%s, %d, view=%r): %s" % (
                cls, len(draws), view_origin,
                "; ".join("%d:%s" % d for d in draws)[:600]))
        if text is None:
            numbers["detail"] = ("the listen client recorded no frame within the window (%s)"
                                 % cls)
            return "FAIL", numbers
        if not body_ok:
            numbers["detail"] = ("the watch frame (%s, %d draws) names no player body (no draw "
                                 "under models/player/; draws=%s) -- without the control a "
                                 "missing weapon proves nothing, so the arm fails on the control"
                                 % (cls, len(draws), "; ".join("%d:%s" % d for d in draws)[:320]))
            return "FAIL", numbers
        if not drawn:
            numbers["detail"] = ("the watch frame (%s) draws the body but no carried weapon for "
                                 "p2 (ent %s; draws=%s)"
                                 % (cls, wi_srv, "; ".join("%d:%s" % d for d in draws[:8])[:160]))
            return "FAIL", numbers

    # -- p1's own view: the flips, three arms on the one settled player ---------
    # The frame from the LISTEN game's own client (srv's console reaches it the
    # way the buttons and live-gate's own render-plan step reach theirs), and
    # p2's body is this view's non-empty control: he stands ahead in the same
    # corridor spot, so his absence would mean an empty frame, not a filtered
    # weapon.
    def own_arm(name, present):
        for attempt in range(2):
            text = trace_frame(run.srv,
                               os.path.join(run.scratch, "weapon-%s.txt" % name),
                               "weapon: p1's own frame (%s)" % name)
            if text is None:
                numbers["detail"] = ("p1's client recorded no frame within the window (%s)"
                                     % name)
                return False
            draws = rendered_draws(text)
            # Evidence line on every arm, not just the first: which ent and
            # model answered each count is what a red row must be read from
            # (the viewmodel pair and the carried world weapon share the
            # models/weapons/ root, so the ent numbers tell them apart).
            guns = [(ent, mdl) for (ent, mdl) in draws if "/weapons/" in mdl.lower()]
            run.say("    own frame draws (%s, %d draws, %d gun-path): %s" % (
                name, len(draws), len(guns),
                "; ".join("%d:%s" % (ent, mdl.rsplit("/", 1)[-1])
                          for (ent, mdl) in guns)[:400]))
            # The flip's discriminator is the OWNER'S OWN HELD WORLD WEAPON
            # draw at the ent the srv handle chain resolved for p1 (own_wi):
            # first person hides it, third person (the resting re-ask the fix
            # lands) re-asks every shell and puts it back, first person hides
            # it again. The viewmodel pair cannot answer this: it shares the
            # models/weapons/ root but draws under its attachment ents
            # (run 20261102-192142 at tip ea9eca612: first-person frames list
            # 421/423 and 414/417 under guns, and only the third-person frame
            # adds the carried gun at its own ent 415). The owner's own body
            # under models/player/ is the flip's second half and the watched
            # player's body the non-empty control under both (one body
            # minimum either way, run 20261102-183046).
            bodies = [mdl for (_ent, mdl) in draws if "models/player/" in mdl.lower()]
            matched = [(ent, mdl) for (ent, mdl) in guns if ent == own_wi]
            drawn = bool(matched)
            ctl_ok = len(bodies) >= 1
            if ctl_ok:
                break
            # The control empty means the camera stood somewhere that saw no
            # player: aim once more from the recorded spot at the subject's
            # live position and record again.
            cam, _yaw = frame_camera(text)
            live = entity_origin(run.srv, run.p2)
            if cam and live and attempt == 0:
                aim3 = lg.angles_to(cam, [live[0], live[1], live[2] + 64.0])
                run.srv.cmd("cmd setang %.1f %.1f 0" % aim3)
                time.sleep(1.0)
        numbers["own_%s_bodies" % name] = len(bodies)
        numbers["own_%s_weapon" % name] = bool(drawn)
        numbers["own_%s_p2body" % name] = ctl_ok
        numbers["own_%s_gunents" % name] = ",".join(str(ent) for (ent, _mdl) in guns)
        numbers["own_%s_gunmodels" % name] = ",".join(
            mdl.rsplit("/", 1)[-1] for (_ent, mdl) in guns)[:160]
        numbers["own_%s_wgun" % name] = (
            matched[0][1].rsplit("/", 1)[-1] if matched else "-")
        if not ctl_ok:
            numbers["detail"] = ("p1's own frame (%s) drew no player body under models/player/: "
                                 "the control is empty, so the flip cannot be read from it "
                                 "(draws=%s)"
                                 % (name, "; ".join("%d:%s" % d for d in draws)[:320]))
            return False
        if drawn != present:
            numbers["detail"] = ("p1's own held weapon draw (its ent %s under models/weapons/) "
                                 "was %sfrom the %s frame, expected %s (gun draws=%s)"
                                 % (own_wi, "" if drawn else "NOT ", name, present,
                                    "; ".join("%d:%s" % (ent, mdl.rsplit("/", 1)[-1])
                                              for (ent, mdl) in guns)[:240]))
            return False
        return True

    # Re-resolve after the last respawn in the LISTEN server's own directory:
    # the carried weapon may have been recreated, and every own-view arm must
    # ask about the weapon that is actually carried now. The listen game's own
    # client shares the server's numbering, so the handles resolve back to the
    # srv indices -- the join and classes steps read those same numbers.
    wi_srv, listed = srv_weapon(run.p1)
    hw = handle_of(run.srv, wi_srv) if wi_srv is not None else None
    own_wi, own_raw = index_by_handle(run.srv, hw) if hw else (None, "srv-no-handle")
    numbers["own_weapon_ent"] = "%s/%s hw=%s -> w=%s" % (wi_srv, listed, hw, own_wi)
    if own_wi is None:
        numbers["detail"] = ("the listen server cannot name p1's carried weapon by handle "
                             "(weapon %r; srv pair %s/%s)"
                             % (own_raw, wi_srv, listed))
        return "FAIL", numbers

    run.srv.cmd("firstperson")
    time.sleep(1.0)
    if not own_arm("first_before", False):
        return "FAIL", numbers
    run.srv.cmd("thirdperson")
    time.sleep(1.0)
    if not own_arm("third", True):
        return "FAIL", numbers
    run.srv.cmd("firstperson")
    time.sleep(1.0)
    if not own_arm("first_after", False):
        return "FAIL", numbers

    numbers["classes_tried"] = ",".join(TRIED_CLASSES)
    return "PASS", numbers


def step_combat(run, state):
    numbers = {}
    run.srv.cmd("sv_cheats 1")

    # The heavy (player 2) shoots the scout (player 1) at 200 u, along the
    # corridor the heavy's own speed run proved flat and open: BOTH stand on
    # that corridor -- the heavy at its proven start spot, the scout 200 u
    # ahead down the run's heading (the run itself covered more than 200 u
    # that way) -- and the heavy's view is snapped at the scout's eye
    # (lg.angles_to -- and THE EYE IS NOT THE ORIGIN, so the +64 is added by
    # the caller, as live-gate's own comment demands).
    heavy_home = state.get("heavy_home")
    heavy = entity_origin(run.srv, run.p2)
    if heavy_home:
        spot, yaw = heavy_home
    elif heavy:
        spot, yaw = list(heavy), 0.0
    else:
        return "FAIL", {"detail": "the heavy's origin could not be read"}
    fx, fy = forward_of(yaw)
    scout_at = [spot[0] + fx * 200.0, spot[1] + fy * 200.0, spot[2]]
    if not settle_on(run, run.p1, scout_at, (0.0, yaw, 0.0)):
        return "FAIL", {"detail": "the scout would not settle 200 u down the heavy's corridor at %s@%d" % (fmt_pos(spot), yaw)}
    angle = lg.angles_to([spot[0], spot[1], spot[2] + 64.0],
                         [scout_at[0], scout_at[1], scout_at[2] + 64.0])
    if not settle_on(run, run.p2, spot, angle):
        return "FAIL", {"detail": "the heavy would not settle on its corridor facing the scout"}
    now_a = entity_origin(run.srv, run.p1)
    now_b = entity_origin(run.srv, run.p2)
    if not now_a or not now_b:
        return "FAIL", {"detail": "origins vanished during placement"}
    rng = lg.distance(now_a, now_b)
    numbers["range_actual"] = "%.0f" % rng
    scout_before = run.health(run.p1)
    numbers["scout_health_before"] = scout_before
    if not (190.0 <= rng <= 210.0) or scout_before is None:
        # Run 13 failed here with range 2019 -- the heavy was still where the
        # classes step had parked it while the scout's teleport took. Say
        # where each one ACTUALLY is against where it was put.
        numbers["want_heavy_at"] = fmt_pos(spot)
        numbers["want_scout_at"] = fmt_pos(scout_at)
        numbers["heavy_now"] = fmt_pos(now_b)
        numbers["scout_now"] = fmt_pos(now_a)
        numbers["team_spawns"] = ";".join(fmt_pos(s) for s in team_spawn_spots(run))
        numbers.setdefault("detail", "the two did not end up 200 u apart, or the scout's Health is unreadable")
        return "FAIL", numbers

    # The minigun spins while +attack is held; the spin-up is what buys the
    # accuracy at 200 u, so the attack is held through the whole wait.
    run.buttons_p2("+attack")
    hurt = wait_pump(
        run, "combat: scout Health dropping under fire",
        lambda: (lambda h: h is not None and h < scout_before)(run.health(run.p1)),
        60.0, 0.5)
    run.buttons_p2("-attack")
    scout_after = run.health(run.p1)
    numbers["scout_health_after"] = scout_after
    ok = bool(hurt) and scout_after is not None and scout_after < scout_before
    if not ok:
        numbers["detail"] = ("the heavy's minigun did not move the scout's Health "
                             "(non-zero stimulus required)")
    return ("PASS" if ok else "FAIL"), numbers


def step_heal(run, state):
    numbers = {}
    # Roles here are INVERTED from the classes step: player 1 (the listen
    # host) becomes the heavy and is the patient, player 2 (the joiner)
    # becomes the medic and holds the beam. The reason is the button
    # history: every verb the beam side needs (joinclass, jointeam,
    # hurtme, use, +attack) is PROVEN on the joiner's own console -- the
    # classes step classes him, the join step jointeams him, and combat
    # fires his minigun with buttons_p2 -- while p1's IN_ATTACK has never
    # yet made anything happen (runs 20 and 21 held +attack from the
    # server console with the Arsenal's own deploy line saying the medigun
    # was in hand, and the heavy never healed).
    # The medic heals the heavy from the forced 150 past 300 to the 450
    # overheal cap (the medigun beam only lives across the medic's own
    # team: TFMedigunWeapon's AllowedToHealTarget). The pair stand on the
    # heavy's proven flat corridor.
    run.srv.cmd("sv_cheats 1")  # hurtme is a cheat; standalone-step insurance

    # -- p1: scout -> heavy, the patient --------------------------------------
    # Both players are ALIVE with a class, so TFJoinClassCommand takes the
    # queued arm ("will be X at the next spawn") and the class lands on a
    # respawn. hurtme damages its ISSUER, so each self-kills from the
    # console that issues for him: the server console's issuer is the host
    # (run 18's srv-console hurtme killed #1), the joiner's own console
    # issues for #2 (run 20's client-console hurtme brought him to 150).
    run.srv.cmd("cmd joinclass heavyweapons")
    ev = wait_pump(run, "heal: joinclass heavyweapons line for the scout",
                   lambda: (lambda e: e if e and e[1] == "heavyweapons" else None)(
                       run.class_evidence(run.p1)), 30.0)
    numbers["patient_join_line"] = (ev or ("-", "-", "(no joinclass heavyweapons line)"))[2]
    if ev is None:
        numbers["detail"] = "joinclass heavyweapons logged nothing: the patient change is unconfirmed"
        return "FAIL", numbers
    if ev[0] == "queued":
        run.srv.cmd("cmd hurtme 9999")

    # -- p2: heavy -> medic, the one holding the beam --------------------------
    run.client.api.cmd("cmd joinclass medic")
    ev = wait_pump(run, "heal: joinclass medic line for the joiner",
                   lambda: (lambda e: e if e and e[1] == "medic" else None)(
                       run.class_evidence(run.p2)), 30.0)
    numbers["medic_join_line"] = (ev or ("-", "-", "(no joinclass medic line)"))[2]
    if ev is None:
        numbers["detail"] = "joinclass medic logged nothing: the class change is unconfirmed"
        return "FAIL", numbers
    if ev[0] == "queued":
        run.client.api.cmd("cmd hurtme 9999")
        # Let the kill land BEFORE the pick: the dead-player arm applies
        # the queued class on the spot, but only while the issuer is dead.
        # A pick that arrives first short-circuits as alive-unchanged and
        # the medic stays on the death until the wave (runs heal4/full1:
        # medic_health=-9850 through the whole alive wait; heal3/heal6/
        # hr5 where the pick landed after the kill passed in seconds).
        wait_pump(run, "heal: the queued medic's kill landed",
                  lambda: not run.is_alive(run.p2), 30.0, 0.3)
        run.client.api.cmd("cmd joinclass medic")

    # The medic must land on the heavy's team (TFMedigunWeapon's
    # AllowedToHealTarget). mp_teams_unbalance_limit is 1 (the teams step
    # read that default and gated on it), and the medic's move makes the
    # pair 2-v-0 -- TFTeams refuses it ("That team is full: joining it
    # would unbalance the teams"). The gate does not test that refusal (no
    # such step in the brief); it needs the pair on one team, so it sets
    # the rule to 0 (run 19 proved the move lands with it off). The move
    # rides the joiner's own console, as every other p2 verb does.
    heavy_team = run.team_now(run.p1)
    if heavy_team not in (TEAM_RED, TEAM_BLU):
        numbers["heavy_team"] = heavy_team
        numbers["detail"] = "the heavy's team could not be read: nowhere to move the medic"
        return "FAIL", numbers
    team_name = "red" if heavy_team == TEAM_RED else "blue"
    run.srv.cmd("mp_teams_unbalance_limit 0")
    run.client.api.cmd("cmd jointeam %s" % team_name)
    # The team join shows the joiner's class panel again (the join opens it,
    # the welcome menu's arms re-show it), and a headless joiner has no UI
    # click to close it: the wave loop holds MenuOpen players back every tick
    # until the panel closes. A stock client closes it by picking its class;
    # the same pick, from the joiner's own console, is this resend -- it also
    # takes the queued Medic on the spot through the dead-player arm, so the
    # alive-at-full-Health wait below lands on a respawning medic.
    run.client.api.cmd("cmd joinclass medic")
    same = wait_pump(
        run, "heal: medic alive on the heavy's team at full Health",
        lambda: run.is_alive(run.p2) and run.team_now(run.p2) == heavy_team
        and health_is(run.srv.fields(run.p2), CLASS_HEALTH["medic"]), 90.0)
    numbers["medic_team"] = run.team_now(run.p2)
    numbers["heavy_team"] = heavy_team
    if not same:
        numbers["medic_health"] = run.health(run.p2)
        numbers["detail"] = "the medic never came to rest on the heavy's team, alive"
        return "FAIL", numbers
    # Health is class-shaped; the carrier is the authority.
    medic_cls = wait_pump(run, "heal: carrier PlayerClass=medic",
                          lambda: _class_is(run, run.p2, CLASS_NUM["medic"]), 30.0)
    numbers["medic_class_field"] = "%s %s" % player_class(run, run.p2)[0:2]
    if not medic_cls:
        numbers["detail"] = "the carrier does not report PlayerClass=medic (5)"
        return "FAIL", numbers
    heavy_cls = wait_pump(run, "heal: carrier PlayerClass=heavyweapons",
                          lambda: _class_is(run, run.p1, CLASS_NUM["heavyweapons"]), 30.0)
    numbers["patient_class_field"] = "%s %s" % player_class(run, run.p1)[0:2]
    if not heavy_cls:
        numbers["detail"] = "the carrier does not report PlayerClass=heavyweapons (6)"
        return "FAIL", numbers

    run.srv.cmd("cmd hurtme %d" % (HEAL_BASE_MAX - HEAL_HURT_TO))
    hurt = wait_pump(
        run, "heal: heavy hurt down to %d" % HEAL_HURT_TO,
        lambda: (lambda h: h is not None and h <= HEAL_HURT_TO + 5)(run.health(run.p1)), 30.0)
    numbers["heavy_health_hurt"] = run.health(run.p1)
    numbers["heavy_health_hurt_target"] = HEAL_HURT_TO
    if not hurt:
        numbers["detail"] = "hurtme did not bring the heavy down (non-zero stimulus required)"
        return "FAIL", numbers

    heavy_home = state.get("heavy_home")
    heavy_now = entity_origin(run.srv, run.p1)
    if heavy_home:
        home, yaw = heavy_home
    elif heavy_now:
        home, yaw = list(heavy_now), 0.0
    else:
        numbers["detail"] = "the heavy's origin could not be read"
        return "FAIL", numbers
    fx, fy = forward_of(yaw)
    # 100 u DOWN the track, not behind the heavy: the clear stretch runs
    # +X from the start spot; the -X side of it is unverified. The medic's
    # own angle is computed below, aimed back at the heavy, so the beam
    # points the right way.
    medic = [home[0] + fx * 100.0, home[1] + fy * 100.0, home[2]]
    if not settle_on(run, run.p1, home, (0.0, yaw, 0.0)):
        numbers["detail"] = "the heavy would not settle on his flat corridor"
        return "FAIL", numbers
    angle = lg.angles_to([medic[0], medic[1], medic[2] + 64.0],
                         [home[0], home[1], home[2] + 64.0])
    if not settle_on(run, run.p2, medic, angle):
        numbers["detail"] = "the medic would not settle behind the heavy"
        return "FAIL", numbers

    # The aim is recomputed from where the two ACTUALLY settled, at the
    # heavy's torso: the two settles were two ground requests 100 u apart,
    # and each answered at its own floor height -- run 22's probe read the
    # medic's eye 7.5 u over the heavy's and the requested pitch-0 aim
    # passed over the heavy's crown (both FindNewTargetInSlot traces hit
    # nothing). A player aims at his patient, not at the spot he was asked
    # to stand on.
    heavy_act = entity_origin(run.srv, run.p1)
    medic_act = entity_origin(run.srv, run.p2)
    if not heavy_act or not medic_act:
        numbers["detail"] = "an origin could not be read after the settle"
        return "FAIL", numbers
    numbers["heal_heavy_origin"] = "%s" % (heavy_act,)
    numbers["heal_medic_origin"] = "%s" % (medic_act,)
    angle = lg.angles_to([medic_act[0], medic_act[1], medic_act[2] + 64.0],
                         [heavy_act[0], heavy_act[1], heavy_act[2] + 48.0])
    if not settle_on(run, run.p2, medic_act, angle):
        numbers["detail"] = "the medic would not settle aimed at the heavy"
        return "FAIL", numbers
    # Read the medic's angles back: settle_on only holds the player to the
    # target and grounded, not his facing -- and an unnoticed yaw is one of
    # the ways a medigun beam silently misses (run 21 never measured it).
    # The /entity answer carries "angles" as [pitch, yaw, roll].
    med_ent = run.srv.entity(index=run.p2) or {}
    numbers["medic_aim_want"] = "%.0f,%.0f" % angle
    numbers["medic_aim_read"] = ",".join(
        "%.0f" % a for a in (med_ent.get("angles") or [999, 999, 999]))

    # The spawn deploys the medic's PRIMARY (the syringe gun), so holding
    # +attack here fired syringes at a teammate: no damage, no heal, and
    # nothing logged (run 20: peak 150 through 120 s). The medigun's
    # behaviour runs only while its entity is the player's active weapon
    # (TFMedigunBehaviour: ScriptOf(attack.Type) gates the Heal dispatch).
    # `use <classname>` is the arsenal switch the tools were given for
    # exactly this (shell_standalone_player.cpp's registered ConCommand,
    # routed to OnClientCommand with the issuing player): from the joiner's
    # own console the issuer is this medic, and a refused switch logs
    # itself as "[SourceSharp/Arsenal] ... changed nothing: <reason>".
    run.client.api.cmd("cmd use tf_weapon_medigun")
    numbers["medigun_switch"] = "cmd use tf_weapon_medigun"
    # Hold the attack ONLY after the switch's own deploy line: a hold that
    # starts while the old primary still answers fired one syringe burst and
    # the held button never re-triggered for the medigun (run heal4: peak
    # 150 and carrier target -1 across the whole hold). The Arsenal logs
    # "#<index> deployed tf_weapon_medigun" when the switch takes, so the
    # line is the ready signal.
    deployed = wait_pump(run, "heal: medic's medigun deployed",
                         lambda: ("%d deployed tf_weapon_medigun" % run.p2
                                  in "".join(run.team_lines())) or None,
                         10.0, 0.3)
    numbers["medigun_deploy_seen"] = bool(deployed)

    # The carrier's beam state, sampled on every health poll while the
    # button is held: HealTargetIndex >= 0 says the medigun FOUND its
    # patient (the bug is then the accumulation); -1/None across the whole
    # hold says target acquisition never hit. "peak 150" alone cannot tell
    # these apart -- that discrimination is what runs 20 and 21 lacked.
    peak = {"health": run.health(run.p1) or 0, "target": None, "charge": None}

    def rising(cap):
        h = run.health(run.p1)
        if h is None:
            return None
        peak["health"] = max(peak["health"], h)
        # Re-arm the held button and the settle aim on every poll: under
        # load a single +attack or a single settle can drop before the
        # beam's first tick -- runs heal4/heal5/heal6b read carrier target
        # -1 across the whole hold with the pitch read back 0 (the flat
        # beam passes over the heavy's crown). The re-issue is cheap and
        # idempotent; the finally-arm release still ends the hold.
        run.buttons_p2("+attack")
        settle_on(run, run.p2, medic_act, angle)
        t, c = carrier_beam(run, run.p2)
        if t is not None:
            try:
                peak["target"] = int(t) if peak["target"] is None else max(peak["target"], int(t))
            except ValueError:
                pass
        if c is not None:
            try:
                f = float(c)
                peak["charge"] = f if peak["charge"] is None else max(peak["charge"], f)
            except ValueError:
                pass
        return peak["health"] if peak["health"] >= cap else None

    run.buttons_p2("+attack")
    try:
        # Positive arm first (CLAUDE.md: require a non-zero in the positive
        # arm): the first point above the hurt-to value says a beam reached
        # the heavy at all. Without it, "peak 150" cannot tell a refused
        # switch from a slow heal.
        # 60 s, not 30: under the load several games put on one GPU the
        # joiner's client ticks slow enough that settle + aim + the beam's
        # first tick can pass 30 s (runs hr4/hr5: heavy stuck at the hurt
        # value to the window cap while the same box passed the step in
        # 18 s when quiet). The cap wait below already gets 120 s.
        first = wait_pump(run, "heal: heavy Health first rising above %d" % HEAL_HURT_TO,
                          lambda: rising(HEAL_HURT_TO + 1), 60.0, 0.5)
        over = (wait_pump(run, "heal: heavy Health rising to the %d cap" % HEAL_CAP,
                          lambda: rising(HEAL_CAP), 120.0, 0.5)
                if first else None)
    finally:
        run.buttons_p2("-attack")

    numbers["heavy_health_peak"] = peak["health"]
    numbers["heal_base_max"] = HEAL_BASE_MAX
    numbers["heal_cap"] = HEAL_CAP
    numbers["medic_heal_target_seen"] = peak["target"]
    numbers["medic_charge_peak"] = peak["charge"]
    ok = bool(over) and peak["health"] >= HEAL_CAP
    if not ok:
        if not first:
            arsenal = [l for l in run.team_lines() if "Arsenal" in l][-3:]
            # A silent heal dispatch has two candidate causes: the effect
            # seam was never composed (NoTFWeaponEffects answers nothing),
            # or it is composed and its target trace never hits. The
            # carrier's target split those; this splits the first half by
            # asking the server's own container.
            numbers["heal_services"] = services_probe(
                run.srv, ["ITFWeaponEffects", "TFWeaponEffects",
                          "ITFHealEffects", "TFMedigunWeapon"])
            numbers["detail"] = ("no heal at all from the medigun (peak %d, aim want %s read %s, "
                                 "carrier target %s charge %s, services %s); last Arsenal lines %s"
                                 % (peak["health"], numbers["medic_aim_want"],
                                    numbers["medic_aim_read"], peak["target"], peak["charge"],
                                    numbers["heal_services"], arsenal or "(none)"))
        else:
            numbers["detail"] = ("the medic could not heal the heavy to the "
                                 "overheal cap (peak %d)" % peak["health"])
    return ("PASS" if ok else "FAIL"), numbers


def step_respawn(run, state):
    """A wave respawn (team wipe): the active weapon deploys once per
    spawn and the viewmodel attachment is reused, not created anew -- two
    waves counted against the console log. The round gate's "duplicate
    deploys after each respawn" did not reproduce at this tip: two back-
    to-back respawns (a queued-class death, then a jointeam respawn) each
    deploying once is what the console showed twice for one player."""
    numbers = {}

    def counts():
        lines = run.team_lines()
        return (len([l for l in lines if "[SourceSharp/C#] player spawned" in l]),
                len([l for l in lines if "deployed" in l]),
                len([l for l in lines if "creating 'ss_viewmodel_attachment'" in l]))

    rounds = []
    for rnd in (1, 2):
        s0, d0, a0 = counts()
        run.client.api.cmd("cmd hurtme 9999")
        run.srv.cmd("cmd hurtme 9999")
        # Same reason heal resends the pick after its jointeam: the team
        # join shows the joiner its class panel again, and the wave loop
        # holds a MenuOpen player back every tick. A stock client closes
        # the panel by picking its class, so the same pick from the
        # joiner's own console both closes it and takes the dead-instant
        # respawn arm; the heavy (the server's own player, whose panel
        # never reopens under load) does not need the resend. Runs hr3/
        # hr4 without it read p1=300 p2=-9849 through the whole window.
        run.client.api.cmd("cmd joinclass medic")
        dead = wait_pump(run, "respawn %d: the team wiped" % rnd,
                         lambda: not run.is_alive(run.p1) and not run.is_alive(run.p2), 30.0, 0.3)
        if not dead:
            numbers["detail"] = "round %d: the team never died" % rnd
            numbers["respawn_rounds"] = str(rounds)
            return "FAIL", numbers
        back = wait_pump(run, "respawn %d: both at full Health" % rnd,
                         lambda: (lambda h1, h2:
                                  h1 == CLASS_HEALTH["heavyweapons"]
                                  and h2 == CLASS_HEALTH["medic"])(run.health(run.p1),
                                                                   run.health(run.p2)),
                         90.0, 1.0)
        s1, d1, a1 = counts()
        deploys = [l.strip() for l in run.team_lines() if "deployed" in l][d0:d1]
        rounds.append({"spawns": s1 - s0, "deploys": d1 - d0, "attachments": a1 - a0,
                       "deploy_lines": deploys})
        if not back:
            # Name the missing side on fail: which player the wait never
            # saw at full Health, and what Health it did read (a dead
            # negative value vs a wrong-but-positive one split a held
            # respawn from a miscounted class).
            numbers["detail"] = ("round %d: the team never came back, p1=%r p2=%r"
                                 % (rnd, run.health(run.p1), run.health(run.p2)))
            numbers["respawn_rounds"] = str(rounds)
            return "FAIL", numbers

    numbers["respawn_rounds"] = " || ".join(str(r) for r in rounds)
    ok = all(r["spawns"] == 2 and r["deploys"] == 2 and r["attachments"] == 0 for r in rounds)
    if not ok:
        numbers["detail"] = ("the wave respawn did not deploy once per spawn and reuse "
                             "the attachment: %s" % numbers["respawn_rounds"])
    return ("PASS" if ok else "FAIL"), numbers


ROUND_STATE_PREFIX = "[TF2/Rounds] state "
CTF_PICKED_UP = "picked up by player "
CTF_CAPTURED = "captured by player "


def parse_round_state(line):
    """The state word of a tf2_dev_win bare echo ("[TF2/Rounds] state
    RoundRunning, winner Unassigned, waiting False"), or None. Pure, so
    --self-test holds it without a game."""
    if not line or ROUND_STATE_PREFIX not in line:
        return None
    rest = line.split(ROUND_STATE_PREFIX, 1)[1]
    word = rest.split(",", 1)[0].strip()
    return word or None


def parse_round_wait(line):
    """(state, waiting) of a tf2_dev_win bare echo -- the waiting word is the
    InWaitingForPlayers flag the echo already prints (TFDevWinCommand.cs), so
    the pump samples read the whole round half of the chain from one line.
    PURE, so --self-test holds it without a game."""
    state = parse_round_state(line)
    waiting = None
    if line and ROUND_STATE_PREFIX in line and "waiting " in line:
        waiting = line.rsplit("waiting ", 1)[1].strip() or None
    return state, waiting


def round_echo(run):
    """One fresh tf2_dev_win echo read by the pump sampler: (state, waiting)
    of the newest echo line, the same reads round_state makes."""
    run.srv.cmd("tf2_dev_win")
    lines = [l for l in run.team_lines() if ROUND_STATE_PREFIX in l]
    return parse_round_wait(lines[-1] if lines else None)


def _pick(fields, keys):
    """The first of `keys` the field dump answers, or '-' -- so a sample
    names what the field really holds without one key guess hiding a second."""
    for k in keys:
        v = fields.get(k)
        if v not in (None, ""):
            return str(v)
    return "-"


def _safe_fields(srv, index):
    try:
        return srv.fields(index) or {}
    except lg.ApiError:
        return {}


def chain_sample(run, p1, cur, cart_index, area_index, cp_index, watcher_index):
    """One pump tick of the cart chain, as (line, waiting): the round state
    and the waiting-for-players flag from one tf2_dev_win echo (a); the
    pusher's alive/team/class/origin and his distance to the cart (b); the
    capture volume's index, touch count, BLU count and the field dump's own
    enabled/cap-time answers (c); the checkpoint's locked field and the
    derived PointsMayBeCaptured -- round running-or-stalemate and not waiting,
    ControlPointRules.PointsMayBeCaptured (d); the watcher's index, speed and
    disabled answers (e). Every read is the SERVER's, each wrapped: a sampler
    that throws would make the pump itself the thing that fails. The field
    names the dump really answers for the area and the watcher ride along in
    the first-sample line, so a wrong key guess shows instead of silently
    reading '-' forever."""
    parts = []
    rs, wt = round_echo(run)
    parts.append("rs=%s" % rs)
    parts.append("w=%s" % wt)
    # (e)'s observable half: the watcher drives the cart through its speed,
    # so the cart's own speed answer names whether the watcher ever applied it.
    try:
        ce = (run.srv.entity(index=cart_index) or {}) if cart_index is not None else {}
    except lg.ApiError:
        ce = {}
    parts.append("cs=%s" % ce.get("speed"))
    # (b) the pusher: alive, team, class, origin, distance to the cart
    f1 = _safe_fields(run.srv, p1)
    parts.append("pu_al=%s" % f1.get("Alive"))
    parts.append("tm=%s" % run.team_now(p1))
    cjn = run.class_evidence(p1)
    parts.append("cl=%s" % (cjn[1] if cjn and len(cjn) > 1 else "-"))
    try:
        pe = run.srv.entity(index=p1) or {}
    except lg.ApiError:
        pe = {}
    po = pe.get("origin")
    parts.append("po=%s" % (po,))
    d = _d2(po, cur) if po and cur else None
    parts.append("pd=%s" % (round(d, 1) if d is not None else None))
    # (c) the capture volume: touch directory, BLU count, dump's own answers
    fa = _safe_fields(run.srv, area_index) if area_index is not None else {}
    parts.append("ar=%s" % area_index)
    try:
        touch = (run.srv.get("touching", area_index) or {}).get("touching", []) \
            if area_index is not None else []
    except lg.ApiError:
        touch = ["read_error"]
    # The touch directory answers either shape: a bare entity index, or the
    # entity's raw handle ((gen<<16)|index). Mask the low 16 bits so both
    # shapes name the same entry, so "how many BLU players the volume counts"
    # names the player once rather than hiding him behind a shape guess.
    def _entry_index(t):
        v = t.get("index") if isinstance(t, dict) else t
        try:
            return int(str(v), 0) & 0xFFFF
        except (TypeError, ValueError):
            return None
    blu = sum(1 for t in touch if _entry_index(t) == p1)
    parts.append("touch=%d blu=%d" % (len(touch), blu))
    # The raw first entries, so the shape behind blu is readable from the row
    # itself and the comparison above can be pinned to what the endpoint says.
    parts.append("tr=%.70s" % str(list(touch)[:3]))
    parts.append("en=%s ct=%s" % (_pick(fa, ("Enabled", "Disabled")),
                                  _pick(fa, ("CapTime", "area_time_to_cap"))))
    parts.append("ar_f=%s" % ",".join(sorted(fa))[:80])
    # (d) the checkpoint: locked field, PointsMayBeCaptured as the rules answer it
    fc = _safe_fields(run.srv, cp_index) if cp_index is not None else {}
    lock = _pick(fc, ("Locked", "IsLocked"))
    pmb = "True" if rs in ("RoundRunning", "Stalemate") and wt == "False" else "False"
    parts.append("cp=%s lock=%s pmb=%s" % (cp_index, lock, pmb))
    # (e) the watcher: its speed and the dump's disabled answer
    fw = _safe_fields(run.srv, watcher_index) if watcher_index is not None else {}
    try:
        we = (run.srv.entity(index=watcher_index) or {}) if watcher_index is not None else {}
    except lg.ApiError:
        we = {}
    parts.append("wat=%s spd=%s dis=%s" % (watcher_index, we.get("speed"),
                                           _pick(fw, ("Disabled", "IsDisabled", "start_disabled"))))
    parts.append("wat_f=%s" % ",".join(sorted(fw))[:80])
    return " ".join(parts).replace("\t", " ")[:700], wt


def phase_rec():
    """A pump's sampler state: count, first and last line, the first sample
    whose waiting flag reads False (what sample the wait went off at)."""
    return {"n": 0, "first": None, "last": None, "wait_off": None}


def note_sample(run, rec, cur, cart_index, area_index, cp_index, watcher_index):
    """Read one chain sample and keep first/last/count/wait-off in the rec."""
    line, wt = chain_sample(run, run.p1, cur, cart_index, area_index, cp_index, watcher_index)
    rec["n"] += 1
    if rec["first"] is None:
        rec["first"] = line
    rec["last"] = line
    if wt == "False" and rec["wait_off"] is None:
        rec["wait_off"] = str(rec["n"])
    return line


def note_phase(numbers, prefix, rec):
    """Put a pump's sampler into the report numbers; the lines stay, so a
    failing step names its own broken link and a passing one proves the chain
    end to end."""
    numbers[prefix + "_s_first"] = rec["first"] or "(no sample)"
    numbers[prefix + "_s_last"] = rec["last"] or "(no sample)"
    numbers[prefix + "_s_n"] = rec["n"]
    numbers[prefix + "_s_waitoff"] = rec["wait_off"] or "never"


def round_state(run):
    """The round machine's state word, read the way the existing steps read
    state: the server's console.log. tf2_dev_win with no argument only logs
    (TFDevWinCommand: state, winner, waiting) -- this asks for a fresh echo
    and hands back the newest one's state."""
    run.srv.cmd("tf2_dev_win")
    lines = [l for l in run.team_lines() if ROUND_STATE_PREFIX in l]
    return parse_round_state(lines[-1]) if lines else None


def round_lines_since(run, needle):
    """Console lines containing `needle`, written after the step's run.mark().
    Tabs folded to spaces so a line quoted into a report number cannot
    break the row's columns."""
    return [l.strip().replace("\t", " ") for l in run.read_console_since_mark().splitlines()
            if needle in l]


def _entity_probe(run, index):
    """Everything the reads can say about one entity index, for a FAIL
    record: the /entity answer and the /payload field dump."""
    try:
        ent = run.srv.entity(index=index) or {}
    except lg.ApiError as why:
        ent = {"error": str(why)}
    try:
        fields = run.srv.fields(index)
    except lg.ApiError as why:
        fields = {}
        ent.setdefault("fields_error", str(why))
    ent["fields"] = fields
    return ent


def step_ctf(run, state):
    """Stage 4.2 step 6 (docs/plans/tf2/stage4_milestone.md): the host's own
    player is teleported to the ENEMY intel, takes the flag, is teleported
    to his own capture zone -- the game logs the capture, the team's flag
    captures reach 1, the flag is home again, the round keeps running
    (tf_flag_caps_per_round defaults to 3, so one cap is not a win). Then
    tf2_dev_win forces the round: TEAM_WIN holds the bonus time and yields
    through RESTART into PREROUND.

    Every placement here is the HOST's player (run.p1): the joiner's
    teleport flow belongs to another lane and nothing here may drive it.
    The teleports ride settle_on; the pickups and captures ride a short
    +forward, because the server's trigger touches fire in the player's
    move (stock Touch reaches a player once per command, ProcessImpacts)
    and a placement alone never runs one."""
    numbers = {}
    run.mark()  # the game's own needles below must be NEW lines
    run.srv.cmd("sv_cheats 1")  # tf2_dev_win is a cheat; standalone insurance

    # -- the round must be mid-round before any of this -----------------------
    # ItemTeamFlag's pickup, FuncCaptureZone's capture (FlagsMayBeCapped)
    # and the win all refuse outside ROUND_RUNNING.
    running = wait_pump(run, "ctf: ROUND_RUNNING (tf2_dev_win echo)",
                        lambda: round_state(run) == "RoundRunning", 120.0)
    numbers["round_state_before"] = "RoundRunning" if running else (round_state(run) or "unreadable")
    if not running:
        numbers["detail"] = ("the round never reached ROUND_RUNNING; last echo %r"
                             % (round_lines_since(run, ROUND_STATE_PREFIX)[-1:] or None,))
        return "FAIL", numbers

    # A dead carrier is touched by nothing: earlier steps hurt and killed
    # players, and a placement never wakes a body. tf2's mp_forcerespawn
    # cycle brings him back by itself; the step only waits for it.
    alive = wait_pump(run, "ctf: the carrier alive", lambda: run.is_alive(run.p1), 30.0)
    if not alive:
        numbers["carrier_alive"] = False
        numbers["carrier_health"] = run.health(run.p1)
        numbers["detail"] = "the host player never came back alive to carry the flag"
        return "FAIL", numbers

    team = run.team_now(run.p1)
    numbers["carrier_team"] = team
    if team not in (TEAM_RED, TEAM_BLU):
        numbers["detail"] = "the host player's team could not be read"
        return "FAIL", numbers

    # -- the flags: two item_teamflags, one per intel -------------------------
    try:
        flags = run.srv.ents("item_teamflag")
    except lg.ApiError as why:
        numbers["detail"] = "/entities?class=item_teamflag failed: %s" % why
        return "FAIL", numbers
    numbers["flags_found"] = len(flags)
    if len(flags) != 2:
        numbers["detail"] = ("ctf_2fort expects two item_teamflags, the entity "
                             "list answered %r" % ([f.get("index") for f in flags],))
        return "FAIL", numbers

    # Which flag is the enemy's. Run of 2026-10-27 (.scratch/ctf-red.log):
    # the /payload fields of an item_teamflag answer {} (no TeamNum), but
    # /entity names them -- ctf_2fort bakes flag_red / flag_blue -- so the
    # NAME carries the owning team. If names ever stop answering, the
    # fall-back is to settle on each intel and let the game's own pickup
    # line name the enemy flag (a same-team player never picks up his own).
    team_word = "red" if team == TEAM_RED else "blue"

    def _named_team(ent):
        name = (ent.get("name") or "").lower()
        if "flag_red" in name or name.endswith("_red"):
            return "red"
        if "flag_blue" in name or name.endswith("_blue"):
            return "blue"
        return None

    def _flag_reads():
        """Fresh /entity answers for the two flags (origins and names)."""
        out = {}
        for f in flags:
            try:
                out[f["index"]] = run.srv.entity(index=f["index"]) or {}
            except lg.ApiError:
                out[f["index"]] = {}
        return out

    flag_ents = _flag_reads()
    names_read = {idx: (e.get("name") or "-") for idx, e in flag_ents.items()}
    numbers["flag_names"] = ",".join("%s=%s" % kv for kv in sorted(names_read.items(),
                                                                    key=lambda kv: str(kv[0])))
    named = [f for f in flags if _named_team(flag_ents[f["index"]]) in ("red", "blue")]
    if len(named) == 2:
        enemy = [f for f in named if _named_team(flag_ents[f["index"]]) != team_word]
        own_flags = [f for f in named if _named_team(flag_ents[f["index"]]) == team_word]
        numbers["flag_teams"] = numbers["flag_names"]
        if len(enemy) != 1 or len(own_flags) != 1:
            numbers["detail"] = ("the two flags do not split one-per-team by name: %s"
                                 % numbers["flag_names"])
            return "FAIL", numbers
    else:
        # Names unreadable: try BOTH intel origins and let the pickup line
        # decide (the game refuses a same-team pickup, run of 2026-10-27:
        # settling on flag_red logged nothing, on flag_blue logged the pick).
        enemy = list(flags)
        own_flags = list(flags)
        numbers["flag_field_dump"] = {str(f["index"]): _entity_probe(run, f["index"])
                                       for f in flags}

    # The chosen flag's home position, recorded BEFORE the pickup: "the flag
    # is home" is re-asserted against this, not against a re-read of the
    # flag after it moved (Capture's Reset sends it back; the proof is that
    # it comes back HERE).
    carrier = enemy[0]
    carrier_index = carrier["index"]
    flag_home = carrier.get("origin") or entity_origin(run.srv, carrier_index)
    if not flag_home:
        numbers["detail"] = "the enemy flag's origin could not be read (index %s)" % carrier_index
        return "FAIL", numbers
    numbers["flag_index"] = carrier_index
    numbers["flag_home"] = fmt_pos(flag_home)

    pickup_needle = "%s%d" % (CTF_PICKED_UP, run.p1)

    def carried():
        return round_lines_since(run, pickup_needle)

    # -- intel run: settle on the enemy flag, step, and be holding it --------
    if not settle_on(run, run.p1, list(flag_home), (0.0, 0.0, 0.0)):
        numbers["detail"] = "the carrier would not settle on the enemy intel at %s" % fmt_pos(flag_home)
        return "FAIL", numbers
    # The touch that takes the flag fires in the player's own move: a held
    # +forward of a third of a second starts him inside the flag's box and
    # gives the server one ProcessImpacts pass with him moving through it.
    run.buttons_p1("+forward")
    time.sleep(0.3)
    run.buttons_p1("-forward")
    picked = wait_pump(run, "ctf: the enemy flag picked up by player %d" % run.p1,
                       carried, 15.0, 0.5)
    if picked is None and len(enemy) > 1:
        # The first intel answered nothing: try the other flag (the
        # TeamNum-blind path only; with a named enemy flag there is no
        # second candidate).
        other = [f for f in enemy if f["index"] != carrier_index]
        if other:
            carrier = other[0]
            carrier_index = carrier["index"]
            flag_home = carrier.get("origin") or entity_origin(run.srv, carrier_index)
            numbers["flag_index"] = carrier_index
            numbers["flag_home"] = fmt_pos(flag_home) if flag_home else "unreadable"
            if flag_home and settle_on(run, run.p1, list(flag_home), (0.0, 0.0, 0.0)):
                run.buttons_p1("+forward")
                time.sleep(0.3)
                run.buttons_p1("-forward")
                picked = wait_pump(run, "ctf: the other intel's flag picked up", carried, 15.0, 0.5)
    numbers["pickup_line"] = (picked or ["(no pickup line)"])[-1]
    if not picked:
        numbers["round_state_after_touch"] = round_state(run) or "unreadable"
        numbers["flag_field_dump"] = {str(carrier_index): _entity_probe(run, carrier_index)}
        numbers["detail"] = ("no '%s' line after settling on the flag at %s: "
                             "the intel touch never reached the game"
                             % (pickup_needle, numbers["flag_home"]))
        return "FAIL", numbers

    # -- return run: settle inside his own team's capture zone ---------------
    try:
        zones = run.srv.ents("func_capturezone")
    except lg.ApiError as why:
        numbers["detail"] = "/entities?class=func_capturezone failed: %s" % why
        return "FAIL", numbers
    numbers["zones_found"] = len(zones)
    if not zones:
        numbers["zone_probes"] = {c: "(none)" for c in ["func_capturezone"]}
        numbers["detail"] = "the map answers no func_capturezone entities"
        return "FAIL", numbers

    # Which zone is his own. Run of 2026-10-27 (.scratch/ctf-red.log): a
    # func_capturezone's /entity origin is its ORIGIN BRUSH's -- (0,0,0) for
    # both zones on ctf_2fort, so position decides nothing -- but the names
    # are baked (capturezone_red / capturezone_blue), and the zone's brush
    # sits at its team's intel, where that team's own flag stands. So the
    # zone is chosen by NAME and the placement target is the flag the
    # carrier did NOT pick up: his own flag still stands on his own intel,
    # inside this zone's brush. (Teleporting to the zone's (0,0,0) "origin"
    # is exactly what the red-first run did: settle held him in mid-map
    # where no brush of his zone reaches, and no capture line came.)
    zone_ents = {}
    for z in zones:
        try:
            zone_ents[z["index"]] = run.srv.entity(index=z["index"]) or {}
        except lg.ApiError:
            zone_ents[z["index"]] = {}
    numbers["zone_names"] = ",".join(
        "%s=%s" % (z["index"], (zone_ents[z["index"]].get("name") or "-"))
        for z in sorted(zones, key=lambda z: str(z["index"])))
    mine = [z for z in zones if team_word in (zone_ents[z["index"]].get("name") or "").lower()]
    if len(mine) != 1:
        numbers["zone_probes"] = {str(z["index"]): _entity_probe(run, z["index"]) for z in zones}
        numbers["detail"] = ("no single func_capturezone names the carrier's team %r: %s"
                             % (team_word, numbers["zone_names"]))
        return "FAIL", numbers
    zone = mine[0]
    numbers["zone_index"] = zone["index"]
    numbers["zone_name"] = zone_ents[zone["index"]].get("name")
    numbers["zone_brush_origin"] = fmt_pos(zone_ents[zone["index"]].get("origin")
                                           or [0, 0, 0])
    own = [f for f in flags if f["index"] != carrier_index]
    zone_origin = None
    if own:
        zone_origin = own[0].get("origin")
        if not zone_origin:
            try:
                zone_origin = (run.srv.entity(index=own[0]["index"]) or {}).get("origin")
            except lg.ApiError:
                zone_origin = None
    numbers["zone_origin"] = fmt_pos(zone_origin) if zone_origin else "unreadable"
    if not zone_origin:
        numbers["detail"] = ("the carrier's own flag (the one inside %s's brush, "
                             "index %s) has no readable position"
                             % (numbers["zone_name"], zone["index"]))
        return "FAIL", numbers
    if not settle_on(run, run.p1, list(zone_origin), (0.0, 0.0, 0.0)):
        numbers["detail"] = "the carrier would not settle in the capture zone at %s" % numbers["zone_origin"]
        return "FAIL", numbers

    capture_needle = "%s%d" % (CTF_CAPTURED, run.p1)
    run.buttons_p1("+forward")
    time.sleep(0.3)
    run.buttons_p1("-forward")
    capped = wait_pump(run, "ctf: flag captured by player %d" % run.p1,
                       lambda: round_lines_since(run, capture_needle), 15.0, 0.5)
    if capped is None:
        # TouchEveryTick should catch an overlap the move missed; a second
        # step from the other way covers a carrier stopped flush against a
        # wall.
        run.buttons_p1("+back")
        time.sleep(0.3)
        run.buttons_p1("-back")
        capped = wait_pump(run, "ctf: flag captured (second step)",
                           lambda: round_lines_since(run, capture_needle), 15.0, 0.5)
    numbers["capture_line"] = (capped or ["(no capture line)"])[-1]
    if not capped:
        numbers["round_state_after_zone"] = round_state(run) or "unreadable"
        numbers["zone_probe"] = _entity_probe(run, zone["index"])
        numbers["flag_probe"] = _entity_probe(run, carrier_index)
        numbers["detail"] = "no '%s' line inside the zone at %s" % (capture_needle,
                                                                    numbers["zone_origin"])
        return "FAIL", numbers
    cap_line = capped[-1]
    # "team score 1": with tf_flag_caps_per_round 3 (the stock default) the
    # capture lands as the team's first flag capture -- the game's own
    # capture line counts it, and the tf_team_resource read backs it when
    # the nettable answers (field names recorded red-first, not guessed).
    if "flag captures 1" not in cap_line:
        numbers["detail"] = "the capture line does not count the team's first capture: %r" % cap_line
        return "FAIL", numbers

    # -- the flag is home again, and the round keeps running ------------------
    def flag_home_again():
        now = entity_origin(run.srv, carrier_index)
        if not now:
            return None
        return now if lg.distance(list(now), list(flag_home)) <= 16.0 else None
    rested_home = wait_pump(run, "ctf: the flag back at its intel",
                            flag_home_again, 20.0, 0.5)
    numbers["flag_now"] = fmt_pos(entity_origin(run.srv, carrier_index) or []) if not rested_home \
        else fmt_pos(rested_home)
    if not rested_home:
        numbers["detail"] = ("the captured flag never came home (at %s, home was %s)"
                             % (numbers["flag_now"], numbers["flag_home"]))
        return "FAIL", numbers
    still_running = wait_pump(run, "ctf: the round still running after the cap",
                              lambda: round_state(run) == "RoundRunning", 10.0, 0.5)
    numbers["round_state_after_capture"] = "RoundRunning" if still_running \
        else (round_state(run) or "unreadable")
    if not still_running:
        numbers["detail"] = ("the round left ROUND_RUNNING after one capture (caps_per_round 3): %s"
                             % numbers["round_state_after_capture"])
        return "FAIL", numbers

    # -- the forced win: TEAM_WIN, through RESTART, into PREROUND -------------
    win_needles = ("tf2_dev_win %d (in RoundRunning)" % team,
                   "round won by",
                   "RoundRunning -> TeamWin")
    run.srv.cmd("tf2_dev_win %d" % team)
    for needle in win_needles:
        got = wait_pump(run, "ctf: win line %r" % needle,
                        lambda n=needle: round_lines_since(run, n), 20.0, 0.5)
        numbers["win_%s" % needle.split(" ")[0]] = (got or ["(absent)"])[-1]
        if got is None:
            numbers["round_state_at_win"] = round_state(run) or "unreadable"
            numbers["detail"] = "the forced win never logged %r" % needle
            return "FAIL", numbers
    numbers["won_line"] = (round_lines_since(run, "round won by") or ["(absent)"])[-1]

    # TEAM_WIN holds mp_bonusroundtime (15 s), then yields through RESTART
    # (EnterRestart: the round-restart announce, and -- a round's end is not
    # a game restart -- no score or map-time clear) into PREROUND. 40 s of
    # patience covers the bonus plus the transition thinks.
    for edge in ("TeamWin -> Restart", "Restart -> Preround"):
        got = wait_pump(run, "ctf: the win yields %r" % edge,
                        lambda e=edge: round_lines_since(run, e), 40.0, 0.5)
        numbers["yield_%s" % edge.split(" ")[0]] = (got or ["(absent)"])[-1]
        if got is None:
            numbers["detail"] = "TEAM_WIN never reached PREROUND through RESTART (%r absent)" % edge
            return "FAIL", numbers

    return "PASS", numbers



def stand_in_the_open(g):
    """Put the player where the scenario says there is floor and headroom.

    EVERY CLAUSE THAT SPAWNS A PROP DOES THIS FIRST, and it is not tidiness.
    `ent_create` spawns where the player LOOKS, so the subject's position is
    whatever the camera inherited -- and two runs of this gate produced
    OPPOSITE arms of clause 3 for that reason alone: the pre-reload arm passed
    and the post-reload one failed, then the fix to the pre-reload arm swapped
    them, because after a reload the player stands on an arbitrary spawn point
    facing an arbitrary way. A clause whose verdict depends on which spawn
    point the map chose is measuring the map.

    live-gate's own shoot step teleports to this exact place for this exact
    reason, and the coordinates come from the scenario file rather than from
    here so there is one copy of them.
    """
    g.cheats()
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.5)


#=============================================================================
# reading the managed log -- FROM A CURSOR, NEVER FROM THE DEFAULT WINDOW
#=============================================================================
def log_cursor(g, command):
    """Run a console command and return the log sequence it was run AT.

    `tools/debug-api log` WITH NO `since` RETURNS THE OLDEST 500 LINES, NOT THE NEWEST.
    Measured on a live game here: `next` read 554 and the window came back as
    seq 0..499, ending on a line printed minutes earlier. A reader that pipes
    the default window into `reversed()` is reading the game's START-UP, and
    goes on reading it for the rest of the process's life whatever it has just
    run -- so it answers about a command it never saw. The `cmd` endpoint hands
    back `logFrom` for exactly this, and every reading here starts there.
    """
    # RETURNS None WHEN IT COULD NOT ASK, NEVER 0.
    #
    # This returned 0 on any failure, and 0 is a VALID cursor -- the start of
    # the ring -- so a `debug-api cmd` that timed out silently turned into a read
    # of the OLDEST 500 lines, which is precisely the bug this function exists
    # to prevent. It bit while a second game instance was launching and
    # starving the first of frames: six paired arms in a row read no prediction
    # line and voided themselves, on a build that answered perfectly a minute
    # later. A sentinel that is also a legal value is not a sentinel.
    try:
        answer = g.api.cmd(command)
    except Exception:
        return None
    if isinstance(answer, dict) and "logFrom" in answer:
        return int(answer.get("logFrom") or 0)
    return None


def log_since(g, since, limit=400):
    if since is None:
        return []
    try:
        return g.api.log_from(since, limit)
    except Exception:
        return []


#=============================================================================
# preconditions -- nothing below runs if these do not hold
#=============================================================================
def client_sample_passes(g):
    """`cs_cl_interp`'s SAMPLE count, read from the managed debug-api log.

    Interpolation.cs registers cs_cl_interp and prints through the managed log,
    so this is a debug-api-log read and not a console.log scrape.
    """
    since = log_cursor(g, "cs_cl_interp")
    time.sleep(2.0)
    for text in reversed(log_since(g, since)):
        m = re.search(r"(\d+)\s+sample pass", text)
        if m:
            return int(m.group(1))
    return None


def free_walk(g, hold=2.0):
    """Walk IN THE OPEN and return how far the player got.

    THE CONTROL EVERY CLAUSE BELOW LEANS ON. A client that never joined and a
    player who cannot move both report every clause here as a miss, and they
    are not the finding this gate exists to make.

    IT STANDS THE PLAYER SOMEWHERE FIRST, and that is the control being a
    control rather than a coin flip: a walk taken from wherever the map's
    respawn happened to put the player runs into whatever is in front of it. A
    run of this gate covered 4.5 units and voided itself for that alone, on the
    same build that walked 693.6 the run before.
    """
    stand_in_the_open(g)
    began = g.player_origin()
    if began is None:
        return None
    g.api.cmd("+forward")
    time.sleep(hold)
    g.api.cmd("-forward")
    time.sleep(0.6)
    ended = g.player_origin()
    if ended is None:
        return None
    return lg.distance(began, ended)


#=============================================================================
# CLAUSE 1 -- ragdolls retire under the LRU past its cap
#=============================================================================
def clause_lru(g, rep):
    """Kill the player past the cap and watch the OLDEST body go.

    THE READING IS AN IDENTITY, NOT A COUNT. "twelve bodies are standing" is
    also what a gate reads when the thirteenth was never made, so the entity
    index of the FIRST body is remembered and its disappearance is the
    assertion. A count alone cannot tell "the oldest was retired" from "the
    newest was refused", and those are opposite bugs.
    """
    label1 = "bodies are made at all"
    label2 = "the cap holds past it"
    label3 = "and the OLDEST body is the one that went"

    cap = None
    made = []

    player = g.api.player(g.scen["playerClass"])
    if not player:
        rep.skip(label1, "no player to kill")
        rep.skip(label2, "no player")
        rep.skip(label3, "no player")
        return
    who = player["index"]

    # THE CURSOR FOR THE CORPSE LINES, taken BEFORE the first kill. `next` is
    # the ring's end whatever limit is asked for -- checked on a live game:
    # `log 0 1` and `log 0 0` both answered next=554.
    try:
        corpse_cursor = max(0, int(g.api.get("log", 0, 1).get("next", 0)))
    except Exception:
        corpse_cursor = 0

    # A BODY PER DEATH, and the respawn is PRESSED. Death is not automatic on
    # this build (step_respawn's own comment), so a loop that merely waited
    # would kill a corpse fifteen times and make one body.
    rounds = 16
    for _ in range(rounds):
        for b in g.api.ents(RAGDOLL_CLASS):
            if b["index"] not in made:
                made.append(b["index"])

        g.api.get("hurtclass", g.scen["playerClass"], 500)
        g.api.wait_for(
            lambda: g.api.fields(who).get("Alive") == "false", 10.0)
        time.sleep(1.0)

        for b in g.api.ents(RAGDOLL_CLASS):
            if b["index"] not in made:
                made.append(b["index"])

        alive = None
        for _try in range(8):
            g.hold("attack", 0.3)
            time.sleep(1.0)
            if g.api.fields(who).get("Alive") == "true":
                alive = True
                break
        if not alive:
            break

    for b in g.api.ents(RAGDOLL_CLASS):
        if b["index"] not in made:
            made.append(b["index"])

    # THE CAP AS THE GAME HOLDS IT, read from the game's own report line rather
    # than typed in here -- Corpses.cs prints "(N of LIMIT)" per body. Read from
    # a cursor taken BEFORE the killing started, for the reason in log_cursor.
    for text in reversed(log_since(g, corpse_cursor, 500)):
        m = CORPSE_LINE.search(text)
        if m:
            cap = int(m.group(2))
            break

    standing = [e["index"] for e in g.api.ents(RAGDOLL_CLASS)]
    rep.note("cap=%s  distinct bodies made=%d  standing now=%d %s"
             % (cap, len(made), len(standing), standing[:16]))

    if cap is None:
        rep.skip(label1, "the game never printed a corpse line, so the cap it "
                         "is holding is unknown -- nothing below was measured")
        rep.skip(label2, "no cap")
        rep.skip(label3, "no cap")
        return

    if len(made) == 0:
        rep.skip(label1, "not one ss_ragdoll was ever created; there is no LRU "
                         "behaviour to observe")
        rep.skip(label2, "no bodies")
        rep.skip(label3, "no bodies")
        return

    if len(standing) <= cap and len(made) <= cap:
        # NOT A RED, AND NOT A THING MORE ROUNDS WOULD FIX. Bodies expire on
        # SsRagdoll.Lifetime (15 seconds, Entities/Players/SsRagdoll.cs:57) and
        # a kill/respawn cycle takes about five, so the STANDING count settles
        # at three or four whatever the loop does -- measured here over 16
        # rounds and again by hand over five. The cap is 12 and
        # Corpses.Limit is assigned nowhere in the tree, so it cannot be
        # lowered to meet the bodies either.
        rep.ok(label1, "%d body/bodies were created" % len(made))
        rep.skip(label2, "%d bodies made, %d standing, cap %d -- the cap was "
                         "NEVER REACHED and cannot be with one player: bodies "
                         "expire on SsRagdoll.Lifetime (15s) faster than a "
                         "kill/respawn cycle (~5s) can pile them up"
                         % (len(made), len(standing), cap))
        rep.skip(label3, "the cap was never reached; see above")
        return

    rep.ok(label1, "%d distinct bodies were created, past a cap of %d"
           % (len(made), cap))

    if len(standing) <= cap:
        rep.ok(label2, "%d standing, cap %d" % (len(standing), cap))
    else:
        rep.bad(label2, "%d bodies are standing against a cap of %d -- the LRU "
                        "is not retiring" % (len(standing), cap))

    oldest = made[0]
    if oldest not in standing:
        rep.ok(label3, "body #%d, the first one made, is gone while %d newer "
                       "ones stand" % (oldest, len(standing)))
    else:
        rep.bad(label3, "body #%d, the FIRST one made, is still standing after "
                        "%d were made against a cap of %d -- something other "
                        "than the oldest was retired"
                % (oldest, len(made), cap))


#=============================================================================
# CLAUSE 2 -- a frozen prop unfreezes
#=============================================================================
def moveable_bit(g, where):
    """vphysics' own `IsMoveable()` for the crate, and how far away the object
    that answered was.

    `ss_physworld_object` takes a CLASSNAME substring, so `prop_physics` names
    all of dm_lockdown's. The nearest object to where the entity list puts our
    crate wins, and the distance travels with the reading -- a crate shoved
    into a cluster of the map's own props would otherwise hand back one of
    THOSE, and it would be indistinguishable from a pass.
    """
    objects = phys_objects(g.api, None, "prop_physics")
    if not objects or where is None:
        return None, None
    # nearest_object returns a LIST of one, or an empty list.
    near = nearest_object(objects, where)
    if not near:
        return None, None
    return near[0].get("moveable"), near[0].get("awayFromCrate")


def clause_unfreeze(g, rep):
    """DisableMotion pins it, EnableMotion lets it go again -- and the FALL is
    the reading.

    THE UNFREEZE IS THE CLAUSE. A gate that only checked the freeze passes on a
    build in which nothing can ever move again, which is the worse of the two
    bugs. So the prop is frozen, LIFTED, held (it must hang), released, and
    must then fall -- with the moveable bit read at all three moments as a
    second, independent witness that does not depend on the drop at all.
    """
    lift = 200.0

    stand_in_the_open(g)
    index, resting, fell = lg.spawn_prop(g)
    if index is None or resting is None:
        rep.skip("a prop was spawned to freeze", "ent_create made no prop")
        rep.skip("it hangs while frozen", "no prop")
        rep.skip("and it FALLS once unfrozen", "no prop")
        return
    if fell < 1.0:
        # A prop that did not fall on spawn is a physics system that is not
        # running, which is a larger failure than this clause and makes every
        # reading below meaningless.
        rep.skip("a prop was spawned to freeze",
                 "the prop fell %.1f units on spawn -- physics is not running, "
                 "so a prop that does not fall proves nothing" % fell)
        rep.skip("it hangs while frozen", "physics not running")
        rep.skip("and it FALLS once unfrozen", "physics not running")
        lg.kill_prop(g)
        return
    rep.ok("a prop was spawned to freeze",
           "#%d fell %.1f units under gravity and settled" % (index, fell))

    try:
        live_bit, live_far = moveable_bit(g, resting)
        if live_bit is not None and live_far is not None and live_far > 24.0:
            rep.skip("it hangs while frozen",
                     "vphysics' nearest prop_physics body is %.1f units from "
                     "the crate -- the reading is of another prop" % live_far)
            rep.skip("and it FALLS once unfrozen", "wrong body")
            return
        rep.note("before the freeze: moveable=%s (%.1f units away)"
                 % (live_bit, live_far if live_far is not None else -1))

        # FREEZE, then LIFT. The lift is what makes hanging observable: a
        # frozen prop sitting on the floor is indistinguishable from a live one
        # sitting on the floor, and that is the check-that-cannot-fail shape.
        g.api.fire(lg.PROP_NAME, "DisableMotion")
        time.sleep(1.0)
        frozen_bit, _ = moveable_bit(g, resting)

        up = [resting[0], resting[1], resting[2] + lift]
        g.api.cmd("cs_sv_teleport_probe jump %s %.2f %.2f %.2f"
                  % (lg.PROP_NAME, up[0], up[1], up[2]))
        time.sleep(4.0)
        hung_at = lg.prop_origin(g, index)
        if hung_at is None:
            rep.skip("it hangs while frozen", "the prop left the entity list")
            rep.skip("and it FALLS once unfrozen", "the prop left the entity list")
            return

        lifted = hung_at[2] - resting[2]
        dropped_while_frozen = up[2] - hung_at[2]
        rep.note("frozen: moveable=%s, lifted to +%.1f, fell %.1f in 4s"
                 % (frozen_bit, lifted, dropped_while_frozen))

        if lifted < lift * 0.5:
            # The teleport did not take, so "it did not fall" is about a prop
            # that was never up there.
            rep.skip("it hangs while frozen",
                     "the lift put it only +%.1f of the %.0f asked for; it was "
                     "never up there to hang" % (lifted, lift))
            rep.skip("and it FALLS once unfrozen", "the lift did not take")
            return

        if dropped_while_frozen < 8.0 and frozen_bit == 0:
            rep.ok("it hangs while frozen",
                   "+%.1f up, fell %.1f in four seconds, and vphysics reads "
                   "moveable=0" % (lifted, dropped_while_frozen))
        elif frozen_bit != 0:
            rep.bad("it hangs while frozen",
                    "DisableMotion left vphysics reading moveable=%s"
                    % frozen_bit)
        else:
            rep.bad("it hangs while frozen",
                    "it fell %.1f units in four seconds with motion disabled"
                    % dropped_while_frozen)

        # THE UNFREEZE.
        g.api.fire(lg.PROP_NAME, "EnableMotion")
        time.sleep(0.6)
        thawed_bit, _ = moveable_bit(g, hung_at)
        time.sleep(5.0)
        landed = lg.prop_origin(g, index)
        if landed is None:
            rep.skip("and it FALLS once unfrozen", "the prop left the entity list")
            return
        dropped_after = hung_at[2] - landed[2]
        rep.note("unfrozen: moveable=%s, fell %.1f in 5s"
                 % (thawed_bit, dropped_after))

        # THE READING IS "IT CAME BACK TO THE FLOOR IT LEFT", not a fixed
        # distance. The lift can put the crate against a ceiling or on a ledge,
        # and then a live crate correctly falls only as far as the thing under
        # it -- one run fell 200.0 and the next 9.7 from the same code for that
        # reason. Where it STARTED is a place a crate is known to rest, so
        # returning to within a crate's height of it is the unfreeze, whatever
        # the lift met on the way up.
        back_to_start = abs(landed[2] - resting[2])
        if thawed_bit != 1:
            rep.bad("and it FALLS once unfrozen",
                    "EnableMotion left vphysics reading moveable=%s" % thawed_bit)
        elif back_to_start < 24.0:
            rep.ok("and it FALLS once unfrozen",
                   "EnableMotion put moveable back to 1 and it fell %.1f, back "
                   "to within %.1f of the floor it was lifted off"
                   % (dropped_after, back_to_start))
        elif dropped_after > 16.0:
            rep.ok("and it FALLS once unfrozen",
                   "EnableMotion put moveable back to 1 and it fell %.1f (it "
                   "came to rest %.1f above where it started, so something is "
                   "under it -- but it is falling)"
                   % (dropped_after, back_to_start))
        else:
            rep.bad("and it FALLS once unfrozen",
                    "moveable came back to 1 and it fell only %.1f, still %.1f "
                    "above the floor it was lifted off -- it is pinned in "
                    "practice" % (dropped_after, back_to_start))
    finally:
        lg.kill_prop(g)


#=============================================================================
# CLAUSE 3 -- the spatial partition answers a trace AFTER a reload
#=============================================================================
def aim_hit(g):
    """`debug-api aim` -- what the player's trace found, and where.

    THE KEYS ARE {player, eye, aim, hit, hitClass} and there is no `point`,
    no `endpos` and NO ENTITY INDEX. DebugApiServer.PlayerAim, and measured on a
    live game:

        {"player":1,"eye":[...],"aim":[-2752.03,5622.00,65.59],
         "hit":true,"hitClass":"worldspawn"}

    Because there is no index, identity is a CLASS plus a DISTANCE: the aim
    point has to land on the prop this gate put there, and how far off it was
    travels with the reading.
    """
    try:
        data = g.api.get("aim")
    except Exception:
        return None
    if not isinstance(data, dict) or not data.get("hit"):
        return None
    if not isinstance(data.get("aim"), list):
        return None
    return data


def trace_finds_our_prop(g, rep, label):
    """Put a prop where the player is looking and require the trace to NAME it.

    A TRACE THAT HITS THE WORLD IS NOT THIS CLAUSE. The world is BSP and the
    engine finds it without ever asking the partition; what
    `CDirtySpatialPartitionEntityList` exists for is finding ENTITIES along a
    ray. So the assertion is that the trace comes back with our own named prop
    -- a thing that did not exist when the map loaded -- and not merely that it
    came back with something.
    """
    stand_in_the_open(g)
    index, resting, fell = lg.spawn_prop(g)
    if index is None or resting is None:
        rep.skip(label, "ent_create made no prop to trace against")
        return
    try:
        # LOOK AT IT WHERE IT LANDED. `ent_create` puts the prop at the aim
        # point and the prop then FALLS -- 211 units on the open floor here --
        # so the camera that spawned it is pointing well above the settled
        # crate. Without this the trace sails over the prop, names worldspawn,
        # and the arm reports the partition failing to find an entity that IS
        # there. live-gate's shoot step calls face(resting, lift=8.0) for
        # exactly this.
        g.face(resting, lift=8.0)
        hit = aim_hit(g)
        if not hit:
            rep.skip(label, "debug-api aim did not answer")
            return
        klass = hit.get("hitClass") or ""
        point = hit.get("aim")
        far = lg.distance(point, resting)
        if klass == "prop_physics" and far < 96.0:
            rep.ok(label, "the trace named a prop_physics and stopped %.1f "
                          "units from the prop this gate spawned at %s -- an "
                          "ENTITY the map did not have, found along the ray"
                   % (far, [round(x, 1) for x in resting]))
        elif klass == "prop_physics":
            rep.bad(label, "the trace named a prop_physics but stopped %.1f "
                           "units from the one standing in front of the player "
                           "-- the partition answered with a different entry"
                    % far)
        else:
            rep.bad(label, "a prop_physics was spawned at the aim point and the "
                           "trace came back with %r, stopping %.1f units from "
                           "it -- the partition did not find an entity that is "
                           "there" % (klass, far))
    finally:
        lg.kill_prop(g)


def clause_partition(g, rep, want_entities):
    """The RELOAD is the whole clause. One map load hides this bug class."""
    trace_finds_our_prop(g, rep, "a trace finds an entity BEFORE the reload")

    g.api.cmd("changelevel dm_lockdown")
    settled = g.api.wait_map(want_entities, 240.0)
    census = g.api.census()
    if not settled:
        rep.skip("the reloaded map settled",
                 "%d of %d entities after 240s -- the map never finished "
                 "spawning, which is a timeout and not a missing entity"
                 % (census[0], want_entities))
        rep.skip("a trace finds an entity AFTER the reload", "map never settled")
        return
    rep.ok("the reloaded map settled", "%d entities / %d classes" % census)

    samples = client_sample_passes(g)
    if not samples:
        rep.skip("the client rejoined the reloaded map",
                 "0 interpolation sample passes -- the client never received a "
                 "net update on the new map")
        rep.skip("a trace finds an entity AFTER the reload", "client did not rejoin")
        return
    rep.ok("the client rejoined the reloaded map", "%d sample pass(es)" % samples)

    walked = free_walk(g)
    if walked is None or walked < FREE_WALK:
        rep.skip("the player can walk on the reloaded map",
                 "covered %s units in a free walk (want >= %.0f)"
                 % ("no reading" if walked is None else "%.1f" % walked,
                    FREE_WALK))
        rep.skip("a trace finds an entity AFTER the reload", "no free walk")
        return
    rep.ok("the player can walk on the reloaded map", "%.1f units" % walked)

    trace_finds_our_prop(g, rep, "a trace finds an entity AFTER the reload")



#=============================================================================
# reporting
#=============================================================================
class Report(object):
    def __init__(self):
        self.passed = 0
        self.failed = 0
        self.discarded = 0

    def ok(self, label, why):
        self.passed += 1
        print("  ok        %-56s %s" % (label, why))

    def bad(self, label, why):
        self.failed += 1
        print("  FAIL      %-56s %s" % (label, why))

    def skip(self, label, why):
        self.discarded += 1
        print("  DISCARD   %-56s %s" % (label, why))

    def note(self, text):
        print("            %s" % text)

    def exit_code(self):
        if self.failed:
            return 1
        if self.discarded:
            return 2
        return 0


def box():
    """Sampled DURING the run. `pgrep -c` exits 1 and prints zero, so this
    counts lines out of `ps` instead and tolerates the empty case."""
    import subprocess
    try:
        names = subprocess.run(["ps", "-eo", "comm", "--no-headers"],
                               capture_output=True, text=True).stdout.split()
        games = sum(1 for n in names if n == "hl2_linux64")
    except Exception:
        games = -1
    try:
        with open("/proc/loadavg") as fh:
            load = fh.read().split()[0]
    except Exception:
        load = "?"
    avail = "?"
    try:
        with open("/proc/meminfo") as fh:
            for line in fh:
                if line.startswith("MemAvailable:"):
                    avail = "%.1fGB" % (int(line.split()[1]) / 1048576.0)
                    break
    except Exception:
        pass
    return "hl2_linux64=%d load=%s avail=%s" % (games, load, avail)



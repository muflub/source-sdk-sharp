# main
#=============================================================================
def run(g, want_entities, rep):
    print("== lane c8-clientsystems: the three clauses its box would not give it")
    print("   [box %s]" % box())

    samples = client_sample_passes(g)
    if not samples:
        rep.skip("the CLIENT joined",
                 "0 interpolation sample passes -- it never received a net "
                 "update. NOTHING BELOW WAS MEASURED.")
        print("   [box %s]" % box())
        return
    rep.ok("the CLIENT joined", "%d interpolation sample pass(es)" % samples)

    census = g.api.census()
    if census[0] < want_entities:
        rep.skip("the map settled", "%d of %d entities" % (census[0], want_entities))
        print("   [box %s]" % box())
        return
    rep.ok("the map settled", "%d entities / %d classes" % census)

    walked = free_walk(g)
    if walked is None or walked < FREE_WALK:
        rep.skip("the player walks (the free-walk control)",
                 "covered %s units (want >= %.0f); a client that never joined "
                 "and a frozen player both read this way"
                 % ("no reading" if walked is None else "%.1f" % walked, FREE_WALK))
        print("   [box %s]" % box())
        return
    rep.ok("the player walks (the free-walk control)", "%.1f units" % walked)

    print("\n-- clause 1: ragdolls retire under the LRU past its cap")
    clause_lru(g, rep)
    print("   [box %s]" % box())

    print("\n-- clause 2: a frozen prop unfreezes")
    clause_unfreeze(g, rep)
    print("   [box %s]" % box())

    print("\n-- clause 3: the spatial partition answers a trace AFTER a reload")
    clause_partition(g, rep, want_entities)
    print("   [box %s]" % box())


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--map", default="dm_lockdown")
    args = parser.parse_args(argv)

    pid = os.environ.get("DEBUG_API_PID")
    if not pid:
        print("c8-clientsystems-gate: DEBUG_API_PID must name the game to drive "
              "-- run tools/live-gate --keep first, or tools/debug-api list",
              file=sys.stderr)
        return 2

    scen = lg.load_scenario(args.map)
    api = lg.Api(pid)
    g = lg.Gate(api, scen, verbose=False)

    rep = Report()
    try:
        run(g, scen["entities"], rep)
    except lg.ApiError as exc:
        rep.skip("the game answered", "%s" % exc)

    print("\n== passed %d  failed %d  discarded %d"
          % (rep.passed, rep.failed, rep.discarded))
    return rep.exit_code()


if __name__ == "__main__":
    sys.exit(main())

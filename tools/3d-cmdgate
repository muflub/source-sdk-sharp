#!/usr/bin/env python3
"""
plan_entity.md step 3d's own gate: N COMMANDS, ONE CROSSING — MEASURED LIVE, AT
TWO VERY DIFFERENT N.

WHY IT IS NOT ENOUGH TO COUNT THE CROSSING. `ServerPlayerCommands` counts one
transition per ProcessUsercmds. A build that queued commands and never ran a
single one would post exactly the same number, and the "one crossing per packet"
claim would read as proved by a game whose players cannot move. So the gate
hangs on the RATIO — commands actually run, divided by crossings that carried
them — and `ran` comes from inside the managed run loop
(PlayerCommandQueue.Run), printed by cs_sv_playercmds. Zero commands is a
FAILURE here, not a pass with a small number.

TWO ARMS, because one N cannot separate "batched" from "one per packet". The
client sends a packet at cl_cmdrate and generates a command per tick, so
cl_cmdrate 66 on a 66-tick server is about one command per packet and
cl_cmdrate 10 is about six. If the crossing were per COMMAND the two arms would
report the same ratio; if it is per PACKET the ratio moves with cl_cmdrate. That
is the falsifiable half.

AND THE THREE CROSSINGS THIS STEP REMOVED MUST BE AT ZERO on the server:
ServerOnStandalonePlayerCommand (phase 0 and phase 1) and ServerOnPlayerRunCommand.
They were three per command; if any of them is non-zero during a walk, the loop
is still reaching managed code per command and the step did not land.

  tools/3d-cmdgate               run it
  tools/3d-cmdgate --self-test   the parsing and the pass rules, hermetically

Honours DEBUG_API_DIR, as every launcher in this tree must: the socket
directory is machine-wide and a gate that adopts "whichever socket appeared"
adopts another lane's game.
"""

import json
import os
import re
import subprocess
import sys
import time

# The flags every local game carries (+sv_lan 1 unless STEAM_AUTH=1, +fps_max
# 60): tools/local_launch.py, the Makefile's LOCAL_GAME_ARGS.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import local_launch  # noqa: E402

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# The game this configuration built, and the mod in it. bin/<config> holds the
# launcher and the shared bin/; the mod is bin/<config>/mods/test, handed to the
# launcher with -game, and -condebug writes console.log there.
# SOURCESHARP_CONFIG picks the configuration; debug when unset.
CONFIG = os.environ.get("SOURCESHARP_CONFIG") or "debug"
GAME_DIR = os.path.join(ROOT, "bin", CONFIG)
MOD_DIR = os.path.join(GAME_DIR, "mods", "test")

def launch_command(mod_dir):
    """source#, run from the game directory. No -game: it takes the mod from
    mods.yaml beside it, so every launch proves the file supplies it. `#` is
    quoted, so no shell reads it as a comment (tools/launcher-name-test)."""
    return "./'source#'"
SOCKET_DIR = os.environ.get("DEBUG_API_DIR", "/tmp/sourcesharp-debug-api")
MAP = os.environ.get("MAP", "dm_lockdown")
SETTLE = float(os.environ.get("SETTLE", "12"))
LOG = os.path.join(ROOT, "tools", ".3d-cmdgate.log")
CONSOLE_LOG = os.path.join(MOD_DIR, "console.log")

# The three the step removed. Server-side names; the client's own replay path is
# untouched and keeps ClientOnStandalonePlayerCommand.
REMOVED_OPS = ("ServerOnStandalonePlayerCommand", "ServerOnPlayerRunCommand")

FAILURES = []
CHECKS = [0]


def ok(text):
    CHECKS[0] += 1
    print("  ok    %s" % text)


def bad(text):
    CHECKS[0] += 1
    FAILURES.append(text)
    print("  FAIL  %s" % text)


def check(cond, text):
    ok(text) if cond else bad(text)


# --------------------------------------------------------------------------
# Parsing, which is what --self-test exercises.
# --------------------------------------------------------------------------

PLAYERCMDS = re.compile(
    r"\[playercmds\]\s+batches=(\d+)\s+queued=(\d+)\s+ran=(\d+)\s+ranPerBatch=([0-9.]+)")


def parse_playercmds(text):
    """The LAST [playercmds] line in the text, as (batches, queued, ran, ratio).

    THE LAST and not the first: the console log is appended to for the whole
    run, so the first line in it belongs to whatever the gate measured before
    this arm. Reading the first is how a two-arm gate reports arm one's numbers
    under arm two's heading — which has actually happened in this tree
    (movemath-gate wrote one prediction.json three times).
    """
    found = PLAYERCMDS.findall(text)
    if not found:
        return None
    b, q, r, ratio = found[-1]
    return (int(b), int(q), int(r), float(ratio))


def arm_verdict(name, batches, queued, ran, removed):
    """The pass rules for one arm, as a list of (bool, text)."""
    out = []
    out.append((ran > 0,
                "%s: the loop RAN commands (%d) — a queue nobody drains costs "
                "one crossing per packet too" % (name, ran)))
    out.append((batches > 0, "%s: the queueing crossing happened (%d)" % (name, batches)))
    out.append((queued >= ran,
                "%s: queued %d >= ran %d" % (name, queued, ran)))
    for op, count in removed.items():
        out.append((count == 0,
                    "%s: %s is zero (was three per command); read %d" % (name, op, count)))
    return out


def ratio_verdict(a, b):
    """Arm A is ~one command per packet; arm B bundles. The claim is that the
    crossing is per PACKET, so B's ratio must be materially higher than A's."""
    return [
        (a > 0 and b > 0, "both arms ran commands (%.3f, %.3f per crossing)" % (a, b)),
        (b > a * 1.5,
         "a lower cl_cmdrate bundles MORE commands into one crossing: "
         "%.3f -> %.3f per crossing (needs > 1.5x)" % (a, b)),
        (b > 2.0,
         "the bundled arm carries more than two commands per crossing (%.3f) — "
         "the old path cost THREE crossings per command" % b),
    ]


# --------------------------------------------------------------------------

def self_test():
    print("== SELF-TEST")

    p = parse_playercmds("noise\n[playercmds] batches=12 queued=40 ran=40 ranPerBatch=3.333\nmore")
    check(p == (12, 40, 40, 3.333), "a playercmds line parses")

    check(parse_playercmds("nothing here") is None, "no line parses as None")

    two = ("[playercmds] batches=1 queued=1 ran=1 ranPerBatch=1.000\n"
           "[playercmds] batches=9 queued=90 ran=90 ranPerBatch=10.000\n")
    check(parse_playercmds(two)[0] == 9, "the LAST line wins, not the first")

    check(any(not c for c, t in arm_verdict("x", 0, 0, 0, {})),
          "an arm with no crossing at all fails")
    check(any(not c for c, t in arm_verdict("x", 5, 3, 20, {})),
          "an arm that ran more than it queued fails — the two counters are "
          "read from one loop and cannot disagree that way")
    check(any(not c for c, t in arm_verdict("x", 5, 20, 0, {})),
          "an arm that ran NOTHING fails — the check that can fail")
    check(all(c for c, t in arm_verdict("x", 5, 20, 20, {})),
          "an arm that ran its commands passes")
    check(any(not c for c, t in arm_verdict("x", 5, 20, 20, {"ServerOnPlayerRunCommand": 7})),
          "a surviving per-command crossing fails the arm")
    check(all(c for c, t in arm_verdict("x", 5, 20, 20, {"ServerOnPlayerRunCommand": 0})),
          "a per-command crossing at zero passes the arm")

    check(all(c for c, t in ratio_verdict(1.0, 6.0)), "1 -> 6 per crossing passes")
    check(any(not c for c, t in ratio_verdict(1.0, 1.05)),
          "a ratio that did NOT move fails — which is what a per-command "
          "crossing would look like")
    check(any(not c for c, t in ratio_verdict(0.0, 0.0)), "two dead arms fail")
    check(any(not c for c, t in ratio_verdict(0.5, 1.9)),
          "a bundled arm under two commands per crossing fails")

    print()
    if FAILURES:
        print("== SELF-TEST FAILED (%d of %d)" % (len(FAILURES), CHECKS[0]))
        return 1
    print("== SELF-TEST PASSED (%d check(s))" % CHECKS[0])
    return 0


# --------------------------------------------------------------------------

def sockets():
    try:
        return sorted(f for f in os.listdir(SOCKET_DIR) if f.endswith(".sock"))
    except OSError:
        return []


def debug_api(pid, *args, timeout=30):
    env = dict(os.environ, DEBUG_API_PID=str(pid), DEBUG_API_DIR=SOCKET_DIR)
    out = subprocess.run([os.path.join(ROOT, "tools", "debug-api")] + list(args),
                         capture_output=True, text=True, env=env, timeout=timeout)
    return out.stdout


def box(tag):
    """The load on the box, DURING the run and not only at its ends. `pgrep -c`
    prints 0 AND exits 1, so the exit status is not read."""
    games = subprocess.run(["pgrep", "-c", "-x", "hl2_linux64"],
                           capture_output=True, text=True).stdout.strip() or "0"
    free = subprocess.run(["free", "-g"], capture_output=True, text=True).stdout.splitlines()
    mem = free[1] if len(free) > 1 else "?"
    print("  [box %s] hl2_linux64=%s  %s" % (tag, games, mem))


def run():
    os.makedirs(SOCKET_DIR, exist_ok=True)
    known = set(sockets())
    run_tmp = "/tmp/sourcesharp-3d-cmdgate-%d" % os.getpid()
    os.makedirs(run_tmp, exist_ok=True)

    print("== launching %s (log: %s)" % (MAP, LOG))
    box("before launch")

    cmd = (". '%s/tools/gpu-offload'; cd '%s'; exec %s "
           "-debugapi -debugapisocket -condebug -nomessagebox -nocrashdialog -assertlog "
           "-novid -windowed -w 640 -h 480 %s +map %s"
           % (ROOT, GAME_DIR, launch_command(MOD_DIR), " ".join(local_launch.local_args()), MAP))
    log = open(LOG, "w")
    # setsid so the whole tree is a process GROUP and kill -TERM -pid reaches it.
    # A negative pid naming a group that does not exist reads exactly like a kill
    # that worked.
    child = subprocess.Popen(["bash", "-lc", cmd], stdout=log, stderr=subprocess.STDOUT,
                             env=dict(os.environ, TMPDIR=run_tmp,
                                      DEBUG_API_DIR=SOCKET_DIR),
                             start_new_session=True)

    def pick():
        best = None
        for name in sockets():
            if name in known:
                continue
            pid = name[:-5]
            if debug_api(pid, "status").strip().startswith("{"):
                best = pid
        return best

    game = None
    for _ in range(180):
        game = pick()
        if game:
            break
        time.sleep(1)

    time.sleep(SETTLE)
    game = pick() or game

    try:
        if not game:
            print("== NO SOCKET. Read %s, and the 'Device :' line in it first "
                  "(tools/gpu-offload)." % LOG)
            return 1

        print("== game pid %s" % game)
        box("game up")
        return measure(game)
    finally:
        try:
            os.killpg(os.getpgid(child.pid), 15)
            time.sleep(2)
            os.killpg(os.getpgid(child.pid), 9)
        except OSError:
            pass
        try:
            child.wait(timeout=20)
        except Exception:
            pass
        # pgrep -c prints 0 AND exits 1, so a sample taken the instant after the
        # signal reads "1" about a process that is on its way out. Wait for the
        # count to actually fall before sampling, with a bound.
        for _ in range(30):
            live = subprocess.run(["pgrep", "-c", "-x", "hl2_linux64"],
                                  capture_output=True, text=True).stdout.strip()
            if live in ("", "0"):
                break
            time.sleep(1)
        box("after cleanup")


def measure(game):
    def d(*args):
        return debug_api(game, *args)

    def status():
        try:
            return json.loads(d("status"))
        except Exception:
            return {}

    def ops():
        return status().get("crossings", {}).get("ops", {})

    def log_size():
        total = 0
        for path in (CONSOLE_LOG, LOG):
            try:
                total += os.path.getsize(path)
            except OSError:
                pass
        return {path: os.path.getsize(path) if os.path.exists(path) else 0
                for path in (CONSOLE_LOG, LOG)}

    def playercmds(since):
        """The readout, read from ONLY what was written after `since`.

        NOT "the last line in the file". The console log is appended to for the
        whole run, so arm B reading the whole file and taking the last match
        gets arm A's line whenever arm B's own has not been flushed yet — which
        is exactly what happened the first time this gate ran: both arms
        reported batches=471 to the digit. Reading from a recorded offset makes
        "arm B printed nothing" a MISSING reading rather than a stale one.
        """
        d("cmd", "cs_sv_playercmds")
        time.sleep(1.5)
        text = ""
        for path, offset in since.items():
            try:
                with open(path, errors="replace") as fh:
                    fh.seek(offset)
                    text += fh.read()
            except OSError:
                pass
        return parse_playercmds(text)

    d("cmd", "sv_cheats 1")

    # THE LOOPBACK IGNORES cl_cmdrate UNLESS THIS IS ON.
    #
    # host_limitlocal -- its help text is "Apply cl_cmdrate and cl_updaterate
    # to loopback connection", default 0. On a listen server the local client
    # and the server share a process, so without this the send rate is the frame
    # rate and every packet carries exactly one command whatever cl_cmdrate
    # says. The first run of this gate reported 1.000 commands per crossing in
    # BOTH arms because of it, which reads as "the batching does not work" and
    # was really "the two arms were the same arm".
    #
    # sv_mincmdrate clamps cl_cmdrate up to 10 by default, so the
    # bundled arm is set through the floor rather than under it.
    d("cmd", "host_limitlocal 1")
    d("cmd", "sv_mincmdrate 0")
    time.sleep(0.5)

    results = {}

    for key, cmdrate in (("A", 66), ("B", 8)):
        name = "%s cl_cmdrate %d" % (key, cmdrate)
        print("\n== arm %s" % name)
        d("cmd", "cl_cmdrate %d" % cmdrate)
        d("cmd", "cl_updaterate %d" % cmdrate)
        time.sleep(1.0)

        # The readout is reset FIRST and the crossings SECOND, so a packet that
        # slips between the two resets is counted by the readout and not by the
        # crossing counter. The comparison below is one-sided for that reason
        # and says so.
        d("cmd", "cs_sv_playercmds reset")
        d("cmd", "cs_sv_crossings reset")
        since = log_size()
        time.sleep(0.5)

        d("cmd", "+forward")
        for _ in range(6):
            time.sleep(0.5)
        box("mid-walk %s" % name[0])
        for _ in range(6):
            time.sleep(0.5)
        d("cmd", "-forward")
        time.sleep(0.5)

        after = ops()
        removed = {op: after.get(op, 0) for op in REMOVED_OPS}
        counters = playercmds(since)

        if counters is None:
            bad("%s: cs_sv_playercmds printed nothing since this arm started — "
                "the readout is the whole gate and it is not there" % name)
            results[key] = None
            continue

        batches, queued, ran, ratio = counters
        crossing = after.get("ServerPlayerCommands", 0)
        runs = after.get("ServerPlayerRunCommands", 0)

        print("  crossings ServerPlayerCommands=%d ServerPlayerRunCommands=%d" % (crossing, runs))
        print("  readout   batches=%d queued=%d ran=%d ranPerBatch=%.3f"
              % (batches, queued, ran, ratio))
        print("  removed:  %s" % removed)
        print("  total crossings for the command path per command: %.3f"
              % ((crossing + runs) / ran if ran else float("nan")))

        for cond, text in arm_verdict(name, batches, queued, ran, removed):
            check(cond, text)

        check(abs(crossing - batches) <= 3,
              "%s: the crossing counter (%d) and the loop's own batch count (%d) "
              "agree within the reset race (<=3) — two instruments, one number"
              % (name, crossing, batches))

        results[key] = ratio

    a = results.get("A")
    b = results.get("B")

    print("\n== the claim")
    if a is None or b is None:
        bad("both arms produced a ratio")
    else:
        for cond, text in ratio_verdict(a, b):
            check(cond, text)

    print()
    if FAILURES:
        print("== FAILED (%d of %d)" % (len(FAILURES), CHECKS[0]))
        for f in FAILURES:
            print("   - %s" % f)
        return 1
    print("== PASSED (%d check(s))" % CHECKS[0])
    return 0


if __name__ == "__main__":
    sys.exit(self_test() if "--self-test" in sys.argv else run())

#!/usr/bin/env python3
"""tools/3f-shadow-ab -- the player's physics shadow, measured against its own absence.

ONE PROCESS, TWO ARMS. `sourcesharp_player_shadow` is honoured live (the shadow
is taken out of the solver at the next command), so arm B is the build before
step 3f without being a second build -- which is what makes the comparison a
comparison rather than two runs on a box whose load moved in between.

It measures the two things the live gate reads about a crate, N times each way:

    place   where a freshly spawned prop_physics SETTLES relative to the player.
            `projectile` needs it more than 150 units downrange and started
            failing when the shadow landed. If the shadow is why, arm A is
            shorter than arm B; if it is not, the two arms are the same
            distribution and the flake was always there.

    push    how far a two-second walk moves it, and how far the player ends up
            from it. `push` wants moved > 4 and the gap < 64; the first landing
            of the shadow moved it 245 units and left a gap of 76.

    tools/3f-shadow-ab [--rounds 4]
    DEBUG_API_PID=<pid> tools/3f-shadow-ab --attach

A PROBE, NOT A GATE: it prints a table, it does not assert.
"""
import argparse
import importlib.machinery
import importlib.util
import math
import os
import statistics
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
spec = importlib.util.spec_from_file_location(
    "livegate", os.path.join(HERE, "live-gate"),
    loader=importlib.machinery.SourceFileLoader("livegate", os.path.join(HERE, "live-gate")))
lg = importlib.util.module_from_spec(spec)
spec.loader.exec_module(lg)


def set_shadow(g, on):
    """Turn the shadow on or off, and make sure the change has TAKEN.

    Off is immediate -- UpdateVCollision destroys the body at the next command.
    ON IS NOT: InitVCollision is only called from SsPlayer.OnSpawn, so a player
    who lost their shadow keeps having none until they respawn. The first
    version of this probe missed that and reported four "shadow" rounds that had
    no shadow in them, which read exactly like the feature not working.
    """
    g.api.cmd("sourcesharp_player_shadow %d" % (1 if on else 0))
    time.sleep(0.3)
    if on:
        g.api.cmd("kill")
        time.sleep(2.5)
        g.api.wait_for(lambda: (g.api.player("ss_player") or {}).get("health", 0) > 0, 20.0)
        time.sleep(0.5)


def one_round(g, shadow):
    """One SHOOT, one placement and one push -- the gate's own order.

    The shoot is not decoration. In the live gate `projectile` runs after
    `shoot`, so the crate whose settling distance it measures is placed into a
    yard that already has a destroyed crate's gibs lying in it -- and it is
    THAT placement, not the one this probe first measured in a clean yard, that
    started failing when the shadow landed.
    """
    set_shadow(g, shadow)
    g.cheats()

    # 1. SHOOT ONE TO BITS, exactly as step_shoot does before step_projectile.
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)
    index, resting, _ = lg.spawn_prop(g)
    if index is None or resting is None:
        return None
    g.face(resting, lift=8.0)
    g.api.cmd("impulse 101")
    time.sleep(0.6)
    g.api.cmd("use %s" % g.scen["ammoWeapon"])
    time.sleep(0.6)
    g.hold("attack", 2.0)
    time.sleep(1.5)
    lg.kill_prop(g)

    # 2. PLACE, and what the aim trace hit before it was placed.
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)
    try:
        aim = g.api.get("aim", 1)
    except Exception:
        aim = {}
    index, resting, fell = lg.spawn_prop(g)
    if index is None or resting is None:
        return None

    place = lg.distance(g.player_origin(), resting)

    # 3. PUSH, exactly what step_push_prop does.
    here = g.player_origin()
    dx, dy = resting[0] - here[0], resting[1] - here[1]
    span = math.hypot(dx, dy) or 1.0
    g.teleport([resting[0] - dx / span * 64.0,
                resting[1] - dy / span * 64.0,
                resting[2]], settle=1.2)
    g.face(resting, lift=64.0)

    walked_from = g.player_origin()
    g.hold("forward", 2.0)
    time.sleep(0.8)
    walked_to = g.player_origin()
    moved_to = lg.prop_origin(g, index)
    lg.kill_prop(g)

    row = dict(place=place, fell=fell, aimClass=aim.get("hitClass"),
               aimDist=aim.get("distance"),
               walked=lg.distance(walked_from, walked_to))
    if moved_to is None:
        row.update(moved=None, gap=None)
    else:
        row.update(moved=lg.distance(resting, moved_to),
                   gap=lg.distance(walked_to, moved_to))
    return row


def report(name, rows):
    def col(key):
        vals = [r[key] for r in rows if r and r.get(key) is not None]
        if not vals:
            return "  --  "
        return "%7.1f  (min %6.1f max %6.1f)" % (statistics.median(vals), min(vals), max(vals))
    print("%-9s n=%d" % (name, len(rows)))
    for key in ("place", "fell", "walked", "moved", "gap", "aimDist"):
        print("    %-7s %s" % (key, col(key)))


def main(argv):
    ap = argparse.ArgumentParser()
    ap.add_argument("--rounds", type=int, default=4)
    ap.add_argument("--attach", action="store_true")
    args = ap.parse_args(argv)

    scen = lg.load_scenario("dm_lockdown")
    scratch = os.path.join("/tmp", "ss-3f-ab-%d" % os.getpid())
    os.makedirs(scratch, exist_ok=True)
    game = None
    if args.attach:
        api = lg.Api(os.environ["DEBUG_API_PID"])
    else:
        port = lg.free_udp_port(*lg.GATE_PORT_RANGE)
        log = os.path.join(HERE, ".3f-shadow-ab.log")
        print("== launching dm_lockdown on port %d (log %s)" % (port, log))
        game = lg.Game.launch(lg.server_launch(port, scen["map"]), log,
                              os.path.join(scratch, "server"))
        if game is None:
            print("== NO SOCKET; read %s" % log)
            return 1
        api = game.api
        print("== game pid %s" % api.pid)
        api.wait_for(lambda: api.player("ss_player"), 90.0)

    g = lg.Gate(api, scen, verbose=False)
    arms = {"A shadow": [], "B no shadow": []}
    try:
        # INTERLEAVED, not one arm then the other: a box whose load changes
        # halfway would otherwise show up as an arm difference.
        for i in range(args.rounds):
            for name, shadow in (("A shadow", True), ("B no shadow", False)):
                row = one_round(g, shadow)
                arms[name].append(row)
                print("  %-12s round %d: %s" % (name, i + 1, row), flush=True)
        print()
        for name in ("A shadow", "B no shadow"):
            report(name, arms[name])
        print()
        print(api.raw("cmd", "cs_sv_playershadow"))
    finally:
        if game is not None:
            game.kill()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

    #               bolt that never moves is still 68.4 units from the
    #               player's origin. That is not a hypothetical: 68.4 is what
    #               was measured with EntityMotion's pass disabled.
    #   too HIGH -- over `recordedTravel`, and it can never pass, because 367
    #               is where this yard's far wall is.
    #
    # A threshold outside that interval is a check that cannot fail or a check
    # that cannot pass, and both look exactly like a working gate from the
    # outside. So the interval is asserted rather than commented.
    proj = scenario["projectile"]
    g_dm_lockdown_walk_pitch = scenario["openFloorAngles"][0]
    for key in ("weapon", "class", "pitch", "fireSeconds", "settleSeconds",
                "minTravel", "minTargetRange", "stationary", "recordedTravel",
                "targetPitch"):

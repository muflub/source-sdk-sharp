        return
    sitting = server.ents(scen["playerClass"])
    if len(sitting) != 1:
        g.check(False, "the server holds %d players before the second client; this step starts from one" % len(sitting))
        return
    first = sitting[0]["index"]

    tmpdir = os.path.join(g.scratch, "client2")
    log = os.path.join(g.scratch, "live-gate-client2.log")
    client, _ = launch_with_free_port(client_launch, log, tmpdir)
    if client is None:
        g.note(keep_log(log, SECONDCLIENT_KEPT_LOG))
        g.check(False, "a second instance never opened a dev API socket")
        return
    failures_before = len(g.failures)
    try:
        for api in (server, client.api):
            api.convar("net_usesocketsforloopback", 1)
        time.sleep(1.0)
        client.api.cmd("connect 127.0.0.1:%d" % port)
        if not server.wait_for(lambda: len(server.ents(scen["playerClass"])) >= 2, 90.0, 1.0):
            g.check(False, "the second client never joined -- %s" % join_state(
                server, client.api, len(server.ents(scen["playerClass"])), log, port))
            return
        second = next(p["index"] for p in server.ents(scen["playerClass"]) if p["index"] != first)

        def heard(slot):
            return server.get("client", str(slot), "status").get("userMessages", {}).get("SayText2", 0)

        server.wait_for(lambda: server.get("client", str(second), "status").get("side") or None, 60.0)
        time.sleep(1.0)

        def say(api, line, label):
            before = (heard(first), heard(second))
            logged = g.count_console(line)
            api.cmd(line)
            server.wait_for(lambda: (heard(first), heard(second)) != before or None, 5.0)
            time.sleep(0.8)
            after = (heard(first), heard(second))
            return (after[0] - before[0], after[1] - before[1]), g.count_console(line.split(" ", 1)[0] + " \"" ) , logged

        def hud_texts():
            return [d.get("text", "") for d in server.get("client", str(first), "ui").get("draws", [])
                    if d.get("kind") == "Text"]

        marker = "chat%d" % (int(time.time()) % 100000)
        g.check(marker not in hud_texts(), "control: no chat line %s on client 1 before" % marker)
        d, _, _ = say(client.api, "say hello %s" % marker, "say")
        g.check(d == (1, 1), "client 2 says a line: both clients receive SayText2 (%s)" % (d,))
        logged = g.last_console_line('say "hello %s"' % marker) or ""
        g.check(logged.startswith('"') and not logged.startswith('"unconnected<'),
                "and the server logs it as stock does, under the player's name (%s)" % logged)
        speaker = logged[1:].split("<", 1)[0]
        drawn = server.wait_for(lambda: any(marker in t for t in hud_texts()) or None, 10.0)
        texts = hud_texts()
        g.check(bool(drawn) and any(speaker and speaker in t for t in texts),
                "client 1 draws the line: %s, then the text" % speaker)
        g.check(sum(marker in t for t in texts) == 2,
                "exactly one line (its text and shadow: %d)" % sum(marker in t for t in texts))

        def send(kind, code=0, char=0):
            server.get("client", str(first), "ui/event?e=%d,0,0,%d,%d" % (kind, code, char))

        server.cmd("messagemode")
        opened = server.wait_for(lambda: (lambda m: m if "chatinput" in m.get("open", []) else None)(ui_menu(g, first)), 10.0)
        g.check(bool(opened), "messagemode opened client 1's chat input line")
        typed = "hi" + marker
        before = (heard(first), heard(second))
        for c in typed:
            send(5, 0, ord(c))
        time.sleep(0.3)
        send(4, 64)
        server.wait_for(lambda: (heard(first), heard(second)) != before or None, 5.0)
        time.sleep(0.8)
        d = (heard(first) - before[0], heard(second) - before[1])
        g.check(d == (1, 1), "Enter sent say \"%s\": both clients receive it (%s)" % (typed, d))
        closed = server.wait_for(lambda: (lambda m: m if "chatinput" not in m.get("open", []) else None)(ui_menu(g, first)), 10.0)
        g.check(bool(closed), "the input line closed")

        d, _, _ = say(client.api, "say_team team words", "say_team")
        g.check(d == (0, 1), "client 2 says to the team: HL2MP without teamplay has no teammates, only client 2 sees it (%s)" % (d,))

        d, _, _ = say(client.api, "say", "say")
        g.check(d == (0, 0), "an empty say sends nothing (the control) (%s)" % (d,))

        client.api.cmd("disconnect")
    finally:
        if len(g.failures) > failures_before:
            g.note(keep_log(log, SECONDCLIENT_KEPT_LOG))
        client.kill()
        server.wait_for(lambda: len(server.ents(scen["playerClass"])) == 1, 30.0)


def transmitted_to_self(g, server, recipient, tries=5):
    """Whether the server's transmit set for client `recipient` holds that
    client's own player edict, read with cs_sv_transmitset (debug server.so):
    armed for that client, a frame later dumped. True/False, or
    None when no capture named that recipient (or the build has no command)."""
    for _ in range(tries):
        server.cmd("cs_sv_transmitset arm %d" % recipient)
        time.sleep(0.15)
        server.cmd("cs_sv_transmitset")
        time.sleep(0.15)
        lines = [l.split("TRANSMITSET:", 1)[1].strip() for l in g.console_lines("TRANSMITSET:")]
        heads = [i for i, l in enumerate(lines) if l.startswith("recipient=")]
        if not heads:
            continue
        block = lines[heads[-1]:]
        head = dict(kv.split("=", 1) for kv in block[0].split())
        if int(head.get("recipient", -1)) != recipient:
            continue
        sent = {int(x) for x in block[1:] if x.isdigit()}
        return recipient in sent
    return None


def step_spectate(g):
    """
    STOCK HL2MP: A DEAD PLAYER STAYS IN THE DEATH CAM; SPECTATE IS THE WAY IN.

    Two clients (frag-credit's second). Read off client 2's networked
    m_iObserverMode / m_hObserverTarget (PlayerNetState ObserverMode /
    ObserverTarget) on the server, and as client 2 decoded them. The dead
    player control: killed, it stays mode NONE with no target past
    DEATH_ANIMATION_TIME, and spec_next does nothing
    (CHL2MP_Player::StartObserverMode refuses a death timeout). Respawned,
    `spectate` puts it in roaming; spec_next picks the only valid target, the
    first player; spec_mode moves to in-eye on that target; `jointeam 2` ends
    it: mode NONE, no target, alive. The team itself does not change yet.

    AND CLIENT 2 LOOKS FROM IT (C7 item 5, ObserverCamera): in-eye, the view
    is the first player's eye; chase (one more spec_mode), it is behind the
    first player's head, more than 8 and at most 96 units back.

    AND CLIENT 2 DRAWS IT (lane ui, IObserverSource over those fields): no
    spectator bar while playing (the control); roaming draws the bar's mode
    ("Free look") and the map; in-eye draws "First person" and names the
    watched player (the first player's name); jointeam takes both away.
    """
    if g.no_second_client:
        g.skip("--no-second-client was given")
    scen, server = g.scen, g.api
    port = getattr(g, "server_port", None)
    if not port:
        g.check(False, "the gate could not tell which UDP port its own server bound")
        return
    sitting = server.ents(scen["playerClass"])
    if len(sitting) != 1:
        g.check(False, "the server holds %d players before the second client; this step starts from one" % len(sitting))
        return
    first = sitting[0]["index"]

    tmpdir = os.path.join(g.scratch, "client2")
    log = os.path.join(g.scratch, "live-gate-client2.log")
    client, _ = launch_with_free_port(client_launch, log, tmpdir)
    if client is None:
        g.note(keep_log(log, SECONDCLIENT_KEPT_LOG))
        g.check(False, "a second instance never opened a dev API socket")
        return
    failures_before = len(g.failures)
    try:
        for api in (server, client.api):
            api.convar("net_usesocketsforloopback", 1)
        time.sleep(1.0)
        client.api.cmd("connect 127.0.0.1:%d" % port)
        if not server.wait_for(lambda: len(server.ents(scen["playerClass"])) >= 2, 90.0, 1.0):
            g.check(False, "the second client never joined -- %s" % join_state(
                server, client.api, len(server.ents(scen["playerClass"])), log, port))
            return
        second = next(p["index"] for p in server.ents(scen["playerClass"]) if p["index"] != first)

        def decoded():
            # The fields as client 2 decoded them: /client/{slot}/entity/{n}.
            try:
                blob = server.get("client", str(second), "entity/%d" % second)
            except ApiError:
                return {}
            return {f["name"]: f["value"] for b in blob.get("states", []) for f in b.get("fields", [])}

        def watch(api=server):
            f = api.fields(second) if api is server else decoded()
            try:
                return f.get("Alive") == "true", int(f.get("ObserverMode", "-1")), int(f.get("ObserverTarget", "-1")) & 0xFFFFFFFF
            except ValueError:
                return None, None, None

        def spec_texts():
            # Client 2's HUD draws, proxied over the debug channel.
            try:
                return [d.get("text", "") for d in server.get("client", str(second), "ui").get("draws", [])
                        if d.get("kind") == "Text"]
            except ApiError:
                return []

        def drawn(*needles):
            texts = [t.lower() for t in spec_texts()]
            return all(any(n.lower() in t for t in texts) for n in needles)

        def drawn_none(*needles):
            texts = [t.lower() for t in spec_texts()]
            return not any(n.lower() in t for n in needles for t in texts)

        first_name = (server.convar("name") or {}).get("value", "")
        mapname = scen["map"]

        def respawn():
            def pressed():
                client.api.cmd("+jump")
                time.sleep(0.3)
                client.api.cmd("-jump")
                return watch()[0] or None
            return server.wait_for(pressed, 20.0, 1.0)

        NOBODY = 0xFFFFFFFF
        g.check(bool(server.wait_for(lambda: watch()[0] or None, 60.0)), "client 2 is alive")
        g.check(watch() == (True, 0, NOBODY), "alive: mode NONE, no target (%s)" % (watch(),))
        # Client 2's HUD paints a moment after it is alive: wait for its first
        # draws, so an empty list (not yet painted) is not read as "no bar".
        hud_up = server.wait_for(lambda: bool(spec_texts()) or None, 15.0, 0.25)
        g.check(bool(hud_up) and drawn_none("Free look", "First person"),
                "control: client 2 draws its HUD and no spectator bar while playing (%s)"
                % ([t for t in spec_texts() if t][:8],))
        client.api.cmd("cmd spec_next")
        time.sleep(1.0)
        g.check(watch() == (True, 0, NOBODY), "spec_next while alive changes nothing (the control) (%s)" % (watch(),))

        # No attacker: a kill by the first player would score it a frag, and
        # round-end (after this step) counts the first player's frags to its
        # mp_fraglimit 2 from where the run left them.
        server.get("hurt", "#%d" % second, FRAG_KILL, "", "")
        died = server.wait_for(lambda: watch()[0] is False or None, 5.0)
        g.check(bool(died), "client 2 is killed (no attacker)")
        g.check(watch() == (False, 0, NOBODY), "client 2 is in the death cam: dead, mode NONE, no target (%s)" % (watch(),))
        time.sleep(4.5)    # past DEATH_ANIMATION_TIME (3 s)
        client.api.cmd("cmd spec_next")
        time.sleep(1.0)
        cam = watch()
        g.check(cam == (False, 0, NOBODY),
                "4.5 s later and after spec_next it is still mode NONE: HL2MP never observes on a death (%s)" % (cam,))
        g.check(bool(respawn()), "client 2 respawned")

        client.api.cmd("cmd spectate")
        observing = server.wait_for(lambda: watch()[1] > 3 or None, 5.0, 0.25)
        mode = watch()
        g.check(bool(observing) and mode[1] == 7 and mode[2] == NOBODY,
                "spectate: client 2 observes, roaming with no target (%s)" % (mode,))
        seen = server.wait_for(lambda: watch(None)[1] == mode[1] or None, 5.0)
        if not seen:
            g.say("    note  client 2 decoded: %s" % str(sorted(decoded().items()))[:600])
        g.check(bool(seen), "and client 2 decoded the same mode (%s)" % (watch(None),))
        bar = server.wait_for(lambda: drawn("Free look", mapname) or None, 5.0, 0.25)
        g.check(bool(bar), "client 2 draws the spectator bar: Free look and the map %s (%s)"
                % (mapname, [t for t in spec_texts() if t][:12]))

        client.api.cmd("cmd spec_next")
        picked = server.wait_for(lambda: watch()[2] != NOBODY or None, 5.0)
        target = watch()[2]
        g.check(bool(picked) and (target & 0xFFFF) == first,
                "spec_next changes the target to the first player, slot %d (%s)" % (first, hex(target)))

        client.api.cmd("cmd spec_mode")
        server.wait_for(lambda: watch()[1] != 7 or None, 5.0)
        g.check(watch()[1] == 4 and watch()[2] == target,
                "spec_mode moves roaming to in-eye on the same target (%s)" % (watch(),))
        # Stock's FullObserverMove puts an in-eye observer at its target every
        # command (gamemovement.cpp OBS_MODE_IN_EYE): the server's own origins,
        # observer against target, within a second.
        def origins():
            by = {p["index"]: p["origin"] for p in server.ents(scen["playerClass"])}
            return by.get(second), by.get(first)
        def on_target():
            o, t = origins()
            return (o and t and distance(o, t) < 2.0) or None
        moved = server.wait_for(on_target, 2.0, 0.1)
        g.check(bool(moved), "the in-eye observer stands at its target on the server (observer %s, target %s)"
                % origins())
        named = server.wait_for(lambda: (bool(first_name) and drawn("First person", first_name)) or None, 5.0, 0.25)
        g.check(bool(named), "client 2 draws First person and names the watched player %r (%s; client 2 decoded %s)"
                % (first_name, [t for t in spec_texts() if t][:12], watch(None)))
        if not named:
            g.say("    note  the transmit set for client %d holds its own player: %s"
                  % (second, transmitted_to_self(g, server, second)))

        # C7 item 5: client 2 LOOKS FROM the watched player. In-eye: the
        # observer camera's view is the first player's drawn origin plus the
        # view height, so within a few units of the first player's eye.
        def observer_view():
            try:
                return server.get("client", str(second), "render").get("observer") or {}
            except ApiError:
                return {}

        first_origin = (server.player(scen["playerClass"]) or {}).get("origin") or [0, 0, 0]
        for p in server.ents(scen["playerClass"]):
            if p["index"] == first:
                first_origin = p.get("origin") or first_origin

        def looks_from_first():
            o = observer_view()
            v = o.get("origin") or []
            if not o.get("active") or len(v) != 3:
                return None
            d = math.sqrt((v[0] - first_origin[0]) ** 2 + (v[1] - first_origin[1]) ** 2 + (v[2] - first_origin[2] - 64) ** 2)
            return d if d < 8.0 else None
        ineye = server.wait_for(looks_from_first, 10.0, 0.25)
        second_origin = next((p.get("origin") for p in server.ents(scen["playerClass"]) if p["index"] == second), None)
        g.check(ineye is not None, "in-eye: client 2's view is the first player's eye (observer view %s, first player at %s, "
                "client 2 on the server at %s)" % (observer_view(), first_origin, second_origin))

        client.api.cmd("cmd spec_mode")
        server.wait_for(lambda: watch()[1] != 4 or None, 5.0)
        chase_mode = watch()[1]

        def chasing():
            o = observer_view()
            v = o.get("origin") or []
            if not o.get("active") or len(v) != 3:
                return None
            d = math.sqrt((v[0] - first_origin[0]) ** 2 + (v[1] - first_origin[1]) ** 2 + (v[2] - first_origin[2] - 64) ** 2)
            return d if 8.0 < d <= 97.0 else None
        chase = server.wait_for(chasing, 10.0, 0.25)
        g.check(chase_mode == 5 and chase is not None,
                "spec_mode moves in-eye to chase, and client 2's view backs off the first player's head (mode %d, %s)"
                % (chase_mode, observer_view()))

        client.api.cmd("cmd jointeam 2")
        server.wait_for(lambda: watch()[1] == 0 or None, 5.0)
        ended = server.wait_for(lambda: watch()[0] or None, 5.0)
        g.check(bool(ended) and watch() == (True, 0, NOBODY),
                "jointeam 2 ends observing: alive, mode NONE, no target (%s)" % (watch(),))
        gone = server.wait_for(lambda: drawn_none("Free look", "First person") or None, 5.0, 0.25)
        g.check(bool(gone), "and client 2's spectator bar is gone")
        client.api.cmd("disconnect")
    finally:
        if len(g.failures) > failures_before:
            g.note(keep_log(log, SECONDCLIENT_KEPT_LOG))
        client.kill()
        server.wait_for(lambda: len(server.ents(scen["playerClass"])) == 1, 30.0)



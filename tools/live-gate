    # three readings of one commit disagree. Large, and the range assertion
    # stops being able to fail: enough draws will eventually clear any floor,
    # which is precisely the shape of "a check that cannot fail" this tree
    # keeps finding. 4 is what is calibrated; the window is what is policed.
    ok(2 <= PROJECTILE_TARGET_TRIES <= 6,
       "the projectile target is resampled between 2 and 6 times (it is %d): "
       "once is a coin flip, and unbounded retries make the range check "
       "unfalsifiable" % PROJECTILE_TARGET_TRIES)
    ok(proj["pitch"] != scenario["openFloorAngles"][0],
       "the projectile step sets its own pitch: openFloorAngles looks 25 "
       "degrees down and a bolt fired down it is in the floor at 123.9 units, "
       "under minTravel")
    ok(proj["weapon"] != scenario["ammoWeapon"],
       "and it does NOT fire `shoot`'s weapon, which is the hitscan one this "
       "step exists because of")


    #-- shutdown_faults ------------------------------------------------------
    clean = ("[SourceSharp] ServerALC unloaded\n"
             "[SourceSharp/Server] 0 managed-built objects released at shutdown\n")
    ok(shutdown_faults(clean) == {}, "a clean shutdown log has no shutdown fault")
    ok(shutdown_faults("[SourceSharp] ServerALC did NOT unload \u2014 something still "
                       "references it.\n") == {"ALC unload": 1},
       "an ALC that did not unload is a fault")
    ok(shutdown_faults("[SourceSharp] ClientALC did NOT unload\n") == {"ALC unload": 1},
       "the client's ALC counts too")
    ok(shutdown_faults("[SourceSharp] System.ObjectDisposedException: IServerRuntime was "
                       "released twice\n" * 2) == {"double release": 2},
       "each double release is counted")
    ok(shutdown_faults("[SourceSharp/Server] 3 managed-built object(s) were still bound at "
                       "shutdown; native should release what it acquires\n")
       == {"still bound": 1}, "objects still bound at shutdown are a fault")

    bad = [name for good, name in checks if not good]
    for good, name in checks:
        print("  %s  %s" % ("ok  " if good else "FAIL", name))
    print("\n%d check(s), %d failed" % (len(checks), len(bad)))
    return 1 if bad else 0


def load_scenario(name):
    path = os.path.join(SCENARIOS, "%s.json" % name)
    if not os.path.exists(path):
        raise SystemExit("live-gate: no scenario for %r. Write %s -- the driver "
                         "holds the checks and the scenario holds the map's "
                         "coordinates." % (name, path))
    with open(path, "r", encoding="utf-8") as handle:
        return json.load(handle)



        def cmd(self, _line):
            return ""

        def get(self, what, seq, limit):
            assert what == "log"
            # /log's shape: the window's lines from `seq`, and the next seq.
            if seq == 999999:
                return {"lines": [], "next": 0}
            batch = self.log[seq:seq + limit]
            return {"lines": [{"text": t} for t in batch], "next": seq + len(batch)}

        def crossings(self):
            self.server_reads += 1
            return {"total": 99999, "serverFrames": 40, "ops": {}}


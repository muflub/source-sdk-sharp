def saveload_launch(port, mapname):
    """SAVELOAD_LAUNCH plus the two things that cannot be constants.

    A function rather than a list because the port is chosen per run -- and a
    function so that --self-test can assert the port flag is on the line at
    all. It was not, until 2026-09-06, and this instance sitting on 27015 is
    how a PEER lane's second client ends up connected to a game with one player
    slot in it. strict_port_flags() here too, for server_launch's reason.
    """
    return (SAVELOAD_LAUNCH + ["-port", str(port)]
            + strict_port_flags() + ["+map", mapname])


#-----------------------------------------------------------------------------
# Pure arithmetic, so --self-test can reach it without a game.
#-----------------------------------------------------------------------------
def per_frame(total, frames):
    """Crossings per server frame. Zero frames is zero, not a division fault.

    A stage that ran no frames (a shutdown, an attach that never ticked) has no
    rate, and inventing one -- or crashing -- both end with a number in a
    budget file that describes nothing.
    """
    return 0.0 if frames <= 0 else total / float(frames)


def ceiling_for(measured):
    """The ceiling recorded beside a measurement. See the header for the 1.5."""
    return round(measured * 1.5 + 10.0, 3)


def ceiling_total_for(total):
    """The ceiling for a stage too short to have a rate. Same 1.5, plus a
    constant that keeps a stage of a dozen crossings from failing on one.

    `total` is the MAXIMUM of the recorded samples, not one of them: see
    MIN_SAMPLES_FOR_TOTAL for why a single sample of a short stage's total is
    not a measurement of anything.
    """
    return int(total * 1.5 + 200)


def angles_to(eye, target):
    """(pitch, yaw) that points a player's view from `eye` at `target`.

    THE EYE IS NOT THE ORIGIN. A player's shots leave from origin + (0,0,64),
    and `debug-api aim`'s reply calls the ORIGIN "eye" -- so a caller that trusts
    that field aims 64 units low at every range and lands its shots in the
    floor. Callers here add the view offset themselves; this function only does
    the trigonometry, and takes the eye it is given.
    """
    dx = target[0] - eye[0]
    dy = target[1] - eye[1]
    dz = target[2] - eye[2]
    flat = math.hypot(dx, dy)
    return (-math.degrees(math.atan2(dz, flat)) if flat > 0 else 0.0,
            math.degrees(math.atan2(dy, dx)))


def distance(a, b):
    return math.dist(a, b)


def ops_total(api, names):
    """How many times, so far this stage, any of `names` was crossed.

    A SUM over the named ops and not a dict, because every caller wants the
    delta across an action and a delta of one number is harder to get wrong
    than a delta of seven.
    """
    ops = api.crossings().get("ops", {})
    return sum(ops.get(name, 0) for name in names)


def numbers_in(text):
    """Every number in a string, in order.

    The dev API formats a networked Vector as "(x, y, z)" and a QAngle the same
    way with different labels. A step that wants the three floats back should
    not also be asserting the punctuation: the formatting belongs to
    NetSchema.FormatVector and a step that pinned it would go red on a cosmetic
    change to a debugging view.
    """
    return [float(found) for found in
            re.findall(r"-?\d+(?:\.\d+)?(?:[eE][-+]?\d+)?", text or "")]


#-----------------------------------------------------------------------------
# The budget file. TSV with a comment header, because it is read by people at
# least as often as by this script and a JSON blob of eighteen rows is not.
#-----------------------------------------------------------------------------
BUDGET_HEADER = """\
# tools/live-gate-budget.tsv -- the crossing budget of plan_entity.md §5.
#
# One row per stage of the live gate, RECORDED FROM A BUILD rather than chosen:
# `tools/live-gate --record` writes this file from the run it just did.
#
# INBOUND ONLY. These are native->managed thunk entries (Crossings' own
# qualifier); the managed->engine direction belongs to step 0e's probes.
#
# ===========================================================================
# TWO KINDS OF ROW, AND THE `gated_on` COLUMN SAYS WHICH
# ===========================================================================
#
# gated_on=rate   the stage ran >= %d server frames, so it HAS a rate. Enforced
#                 on ceiling_per_frame = recorded_per_frame*1.5 + 10, from ONE
#                 sample. A rate over that many frames is stable, so one sample
#                 is an estimate and this ceiling is TIGHT: hot-reload runs at
#                 97%% of its ceiling and is meant to.
#
# gated_on=total  the stage is too short for a rate (5 frames is nearly all
#                 fixed cost, and one frame either way moves a rate by tens).
#                 Enforced on ceiling_total = total_max*1.5 + 200, where
#                 total_max is the LARGEST of `samples` measurements, not one
#                 of them. This ceiling is DELIBERATELY LOOSE and the columns
#                 say by how much: total_min..total_max is the observed spread.
#                 `die` has been measured between 481 and 1403 with no code
#                 change behind it -- 2.9x. A ceiling built from 1.5x one draw
#                 from that sits below the stage's own median, which is exactly
#                 the bug this schema replaced.
#
# So: to tell a loose ceiling from a tight one, read `gated_on`, then
# total_min..total_max against ceiling_total. A row whose spread is a factor of
# three is loose because the quantity is, and it says so in its own columns.
#
# ===========================================================================
# THE §5 RATCHET, AND WHAT IT RATCHETS ON
# ===========================================================================
#
# §5: "the initial budget is whatever Phase 0 measures on today's build; each
# phase may only lower it." A row may move DOWN freely. Moving one UP is
# governed by evidence, not by prohibition, because the two directions are not
# symmetric:
#
#   * a rate ceiling never rises. --record rewrites it from one sample and
#     --record-totals does not touch it at all.
#   * a total ceiling rises only when `samples` >= %d. Below that --record
#     KEEPS the ceiling already on disk and prints why, so a lane cannot widen
#     a short stage as a side effect of the run that failed on it. One 2-pass
#     run is 2 samples; a raise takes at least two deliberate runs merged with
#     `tools/live-gate --record-totals`.
#
# That distinction is the whole point. Relaxing a limit because your change
# cost more is what §5 forbids. Correcting a ceiling that was computed from a
# bad measurement -- one draw from a 2.9x-wide distribution -- is not relaxing
# a limit, because there was never a measurement there to relax. The sample
# count in each row is what lets a reader tell those two apart.
#
# The ratchet has a FLOOR under it in the other direction, or "down is free"
# would walk a total ceiling straight back into the bug: record on a quiet
# night, draw N low samples, and the ceiling sinks below the stage's own
# population again. tools/live-gate's SHORT_STAGE_FLOOR holds the largest total
# this project has ever measured for a stage, and a ceiling is never recorded
# below it. For `die` that is 1403, from the eighteen busy-box measurements in
# .claude/entity-port/status/diag-saveload.md.
#
# ===========================================================================
# WHAT A TOTAL-GATED CEILING CAN AND CANNOT CATCH -- SAY IT RATHER THAN IMPLY IT
# ===========================================================================
#
# `die` costs between 481 and 1403 inbound crossings with no code change behind
# it. Any ceiling that does not fail on that spread cannot detect a regression
# smaller than the spread. That is a property of the measurement, not a choice
# made here, and no formula fixes it:
#
#   CAN catch    a gross regression -- a per-entity crossing appearing where a
#                per-frame one used to be, an added round trip per ragdoll
#                bone. Those are 3x-and-up and go straight through the ceiling.
#   CANNOT catch a 20%% rise. Nothing gated on an 8-frame total can.
#
# So what else guards these four stages? Honestly: less than guards the other
# thirteen, and that is worth knowing rather than papering over.
#
#   * the PER_FRAME_OPS invariants (ServerGameFrame and friends, exactly one per
#     server frame) do NOT apply: they need >= 30 frames, and a 1/8 reset
#     artefact is bigger than their 0.05 tolerance.
#   * the four stages' WORK is nearly all counted somewhere else. `join`'s
#     entity creation shows up in the map load the gate waits on; `die`'s
#     ragdoll and `damage`'s traces recur inside `shoot` and `respawn`, which
#     are rate-gated over hundreds of frames at 270.120 and 221.149. A change
#     that made dying expensive would move those too.
#   * the steps' own PASS/FAIL assertions are unaffected by any of this. A
#     ragdoll that stops spawning fails `die` on behaviour, not on budget.
#
# And one hole, named rather than hidden: `die` is BIMODAL. It ran 8 server
# frames in 14 of this lane's 16 calibration passes and 28-30 in the other two.
# A long pass is checked against ceiling_per_frame, which for a total-gated row
# came from the SHORT run -- 735/8 = 91.875 -> 147.812 -- while the stage
# actually runs at 710/30 = 23.7 when it is long. So a long `die` is checked
# against a ceiling six times its own rate and cannot fail. The gate PRINTS a
# note when that happens rather than a silent tick. Fixing it properly means
# recording two ceilings for a bimodal stage, and nothing has needed that yet.
#
# The one thing that would make these tight is more frames per stage, and that
# is a change to what the steps DO, which belongs to whoever owns them.
#
# WOULD A RATE BE BETTER AFTER ALL? MEASURED, NOT ASSUMED.
# The premise of MIN_FRAMES_FOR_RATE is that a short stage's total is the more
# stable of its two normalisations. Over 78 short passes from this lane's ten
# gate runs that is true for two of the four stages and false for the other two:
#
#   stage      n   total spread     rate spread    ceiling / typical cost
#   join      20   112..703 6.3x    20..54  2.7x    total 9.6x   rate 4.0x
#   damage    20   517..1160 2.2x   37..290 7.9x    total 2.6x   rate 2.3x
#   die       18   848..1695 2.0x   106..173 1.6x   total 2.0x   rate 2.1x
#   shutdown  20   597..732 1.2x    102..305 3.0x   total 2.0x   rate 1.6x
#
# `join` and `die` scale with frames (per-frame work); `damage` and `shutdown`
# are fixed cost, so more frames only means more idle ones. But the number that
# decides whether a gate is strict -- ceiling over TYPICAL cost -- lands within
# a fifth of 2x for both normalisations on three of the four, and `join` is loose
# either way because its cost genuinely varies six-fold. Picking a
# normalisation per stage off n=20 would be over-fitting for no measurable
# gain, so the total is kept for all four. Recorded here so the next person
# does not have to re-derive it.
#
# columns:
# stage\tgated_on\tceiling_per_frame\tceiling_total\trecorded_per_frame\trecorded_total\trecorded_frames\tsamples\ttotal_min\ttotal_max
""" % (MIN_FRAMES_FOR_RATE, MIN_SAMPLES_FOR_TOTAL)


# The columns of one budget row, in file order after `stage`. A namedtuple
# rather than a bare tuple so a column added in the middle cannot silently
# renumber a caller's index -- which is how `budget[step][1]` would have
# started reading `gated_on` as a ceiling.
BudgetRow = collections.namedtuple(
    "BudgetRow",
    "ceiling_rate ceiling_total gated_on rate total frames samples "
    "total_min total_max")


def read_budget(path):
    """stage -> BudgetRow.

    A missing file is an empty budget rather than an error: the first run on a
    tree is the one that records it.
    """
    budget = {}
    if not os.path.exists(path):
        return budget

    with open(path, "r", encoding="utf-8") as handle:
        for number, line in enumerate(handle, 1):
            line = line.rstrip("\n")
            if not line or line.startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) < 10:
                # NOT `continue`. The old reader skipped a row it could not
                # parse, so the 6-column file this schema replaced would have
                # read back as an EMPTY budget -- and an empty budget is not a
                # loud failure here, it is "no budget file; this run only
                # records one". Every stage would have stopped being gated and
                # the gate would still have exited 0. That is the exact failure
                # mode the skip ledger exists to stop, and it gets the same
                # treatment: a row this reader cannot parse is an error.
                raise SystemExit(
                    "live-gate: %s line %d has %d column(s), not 10: %r\n"
                    "  The budget schema gained gated_on/samples/total_min/"
                    "total_max. Re-record with `tools/live-gate --record`;\n"
                    "  do NOT hand-edit, and do not let it read as an empty "
                    "budget, which silently gates nothing."
                    % (path, number, len(parts), line))
            budget[parts[0]] = BudgetRow(
                ceiling_rate=float(parts[2]), ceiling_total=int(parts[3]),
                gated_on=parts[1], rate=float(parts[4]), total=int(parts[5]),
                frames=int(parts[6]), samples=int(parts[7]),
                total_min=int(parts[8]), total_max=int(parts[9]))
    return budget


def collect_samples(recorded):
    """recorded: [(stage, total, frames)], one entry per stage PER PASS.

    -> (order, {stage: [(total, frames), ...]}) with the passes kept apart.
    The old code took only the first pass and threw the rest away, which for a
    short stage threw away half the evidence it had just paid five minutes to
    collect.
    """
    order = []
    samples = {}
    for stage, total, frames in recorded:
        if stage not in samples:
            samples[stage] = []
            order.append(stage)
        samples[stage].append((total, frames))
    return order, samples


_RATE_NOTES = []


def budget_row(stage, samples, existing=None, merge=False):
    """The row for one stage. -> (BudgetRow, note or None).

    `samples` is this run's [(total, frames)], in pass order. `existing` is the
    row already on disk, if any. `merge` folds this run's totals into that row
    rather than replacing it, which is how a total ceiling accumulates the
    MIN_SAMPLES_FOR_TOTAL measurements it needs.

    The note, when it is not None, is a sentence for the operator: the ratchet
    refused a raise, or the row is short of evidence.
    """
    first_total, first_frames = samples[0]
    rate = per_frame(first_total, first_frames)
    gated_on = "rate" if first_frames >= MIN_FRAMES_FOR_RATE else "total"

    # ONLY THE SHORT PASSES FEED A TOTAL. `die` normally runs 8 server frames,
    # but one pass of run 5 ran 31 of them and crossed 729 -- which the gate
    # correctly checked as a RATE (23.516 against 147.812) and which, folded
    # into the totals, would have been a 31-frame total masquerading as an
    # 8-frame one. A long pass tells you nothing about a short stage's total
    # except that the stage was not short that time.
    short = [(total, frames) for total, frames in samples
             if frames < MIN_FRAMES_FOR_RATE]
    totals = [total for total, _frames in (short or samples)]
    count = len(totals)
    low, high = min(totals), max(totals)

    if merge and existing is not None:
        # --record-totals is a re-measurement of the SHORT stages, and of
        # nothing else. A rate-gated row is carried through byte for byte:
        # hot-reload sits at 97% of its ceiling and that number is the live
        # evidence for a cost step 5b has not repaid, so this mode must not be
        # able to widen it even by accident.
        if existing.gated_on == "rate":
            return existing, None
        if not short:
            # Every pass ran long. There is no new short-stage evidence, so the
            # row keeps exactly the evidence it had rather than absorbing a
            # long pass's total as if it were a short one.
            return existing, ("%s: ran >= %d frames in every pass; no new "
                              "short-stage sample, row unchanged"
                              % (stage, MIN_FRAMES_FOR_RATE))
        count += existing.samples
        low = min(low, existing.total_min)
        high = max(high, existing.total_max)
        rate = existing.rate
        ceiling_rate = existing.ceiling_rate
        gated_on = existing.gated_on
        first_total, first_frames = existing.total, existing.frames
    else:
        ceiling_rate = ceiling_for(rate)

        # A RATE CEILING NEVER RISES. This file's own header says so, and
        # before this clamp `--record` recomputed it from ONE run with no
        # ratchet at all: on 2026-09-20 a plain --record took hot-reload from
        # 65,748 to 443,064, a 6.7x widening, because that run landed in the
        # busy one of the two regimes the header documents (6.3x between runs
        # on an unchanged build). Down is still free.
        if existing is not None and existing.gated_on == "rate":
            if ceiling_rate > existing.ceiling_rate:
                note_rate = ("%s: keeping ceiling_rate %s; this run measured "
                             "%s and a rate ceiling never rises (the two "
                             "regimes in the header's 2026-09-06 note are 6.3x "
                             "apart, so one run cannot widen it)"
                             % (stage, existing.ceiling_rate, ceiling_rate))
                ceiling_rate = existing.ceiling_rate
                _RATE_NOTES.append(note_rate)

    ceiling_total = ceiling_total_for(high)
    note = None

    # The floor first, so the ratchet below compares against a number that has
    # already been clamped. A stage whose samples all landed below something
    # this project measured for real does not get to forget that measurement.
    floor = SHORT_STAGE_FLOOR.get(stage)
    if gated_on == "total" and floor is not None and high < floor:
        ceiling_total = ceiling_total_for(floor)

    # THE RATCHET. Down is free; up costs evidence.
    if existing is not None and ceiling_total > existing.ceiling_total:
        if count < MIN_SAMPLES_FOR_TOTAL:
            note = ("%s: keeping ceiling_total %d; %d sample(s) is short of "
                    "the %d a RAISE to %d needs (§5). Merge more runs with "
                    "--record-totals."
                    % (stage, existing.ceiling_total, count,
                       MIN_SAMPLES_FOR_TOTAL, ceiling_total))
            ceiling_total = existing.ceiling_total
        else:
            note = ("%s: raising ceiling_total %d -> %d on %d samples spanning "
                    "%d..%d (§5: a measurement corrected, not a limit relaxed)"
                    % (stage, existing.ceiling_total, ceiling_total, count,
                       low, high))
    elif existing is None and gated_on == "total" and count < MIN_SAMPLES_FOR_TOTAL:
        note = ("%s: total-gated on %d sample(s); %d wanted. Re-run with "
                "--record-totals before trusting this ceiling."
                % (stage, count, MIN_SAMPLES_FOR_TOTAL))

    return (BudgetRow(ceiling_rate=ceiling_rate, ceiling_total=ceiling_total,
                      gated_on=gated_on, rate=round(rate, 3), total=first_total,
                      frames=first_frames, samples=count, total_min=low,
                      total_max=high),
            note)


def write_budget(path, recorded, existing=None, merge=False):
    """recorded: [(stage, total, frames)], one entry per stage per pass.

    -> the list of operator notes, so the caller can print them. `existing` is
    the budget already on disk (read_budget's dict) and `merge` folds into it.
    """
    order, samples = collect_samples(recorded)
    existing = existing or {}
    del _RATE_NOTES[:]
    notes = []

    # KEEP THE PROSE THAT IS ALREADY ON DISK. This used to stamp BUDGET_HEADER
    # unconditionally, which on 2026-09-20 deleted 46 lines of accumulated
    # findings -- including the 2026-09-06 measurement that rate rows swing
    # 6.3x between two regimes, which is the evidence for the clamp in
    # budget_row above. The tool that writes this file must not be able to
    # delete the reasons the file exists. Same failure as
    # `tools/entity-census --write`, which has destroyed committed prose in six
    # lanes.
    header = BUDGET_HEADER
    if os.path.exists(path):
        with open(path, encoding="utf-8") as handle:
            kept = []
            for line in handle:
                if line.strip() and not line.startswith("#"):
                    break
                kept.append(line)
        if kept:
            header = "".join(kept)

    with open(path, "w", encoding="utf-8") as handle:
        handle.write(header)
        for stage in order:
            row, note = budget_row(stage, samples[stage],
                                   existing.get(stage), merge)
            if note:
                notes.append(note)
            handle.write("%s\t%s\t%s\t%d\t%s\t%d\t%d\t%d\t%d\t%d\n"
                         % (stage, row.gated_on, row.ceiling_rate,
                            row.ceiling_total, row.rate, row.total, row.frames,
                            row.samples, row.total_min, row.total_max))

    # A row on disk for a stage this run never reached would be dropped by the
    # rewrite above. In --record-totals that is a silent loss of budget, so the
    # rows are carried across instead and named.
    kept = [stage for stage in existing if stage not in samples]
    if kept:
        with open(path, "a", encoding="utf-8") as handle:
            for stage in kept:
                row = existing[stage]
                handle.write("%s\t%s\t%s\t%d\t%s\t%d\t%d\t%d\t%d\t%d\n"
                             % (stage, row.gated_on, row.ceiling_rate,
                                row.ceiling_total, row.rate, row.total,
                                row.frames, row.samples, row.total_min,
                                row.total_max))
        notes.append("carried %d row(s) this run never reached: %s"
                     % (len(kept), ", ".join(sorted(kept))))
    notes.extend(_RATE_NOTES)
    return notes


#-----------------------------------------------------------------------------
# THE SERVER'S UDP PORT, WHICH IS NOT 27015 BECAUSE THE LAUNCH LINE SAYS SO.
#
# THIS IS WHAT BROKE `second-client` ON 2026-09-06, and nothing about it is
# specific to this port. The engine opens the server socket on `hostport`,
# and when that port is taken (EADDRINUSE) it walks UPWARD, up to 32 ports,
# until a bind succeeds.
#
# So a SECOND gate on this box gets a server on 27016 while its second client
# still runs `connect 127.0.0.1:27015` -- which reaches the FIRST gate's
# server. The newcomer joins somebody else's game, our server holds one player
# for the full 90-second wait, and the step reported "the second client never
# joined (server holds 1 player(s))".
#
# AND THE ENGINE SAYS NOTHING. Its "Socket bound to non-default port" message
# is developer-level, so at the gate's spew level that line is never printed.
# Both strings are in the engine this mod links against:
#
#     strings bin/linux64/engine.so | grep -c "Socket bound to non-default port" -> 1
#     strings bin/linux64/engine.so | grep -c -- "-strictportbind"               -> 1
#
# Measured, 2026-09-06, five hl2_linux64 across THREE worktrees on this box:
#
#     ss -ulnp | grep 2701
#       27015 pid 387564  ...worktrees/<lane-a>/game/mod_sharp
#       27016 pid 374002  ...worktrees/<lane-b>/game/mod_sharp
#       27017 pid 391595  ...worktrees/<lane-b>/game/mod_sharp
#       27018 pid 396747  ...worktrees/<lane-a>/game/mod_sharp
#       27019 pid 397477  ...worktrees/<lane-c>/game/mod_sharp
#
# DEBUG_API_DIR does not help: it isolates SOCKETS, and this is a UDP
# PORT. Neither does flock /tmp/ss-livegate.lock, which only serialises the
# lanes that take it. So the gate takes a port of its OWN, well away from the
# engine's default, and then MEASURES WHICH PORT IT ACTUALLY GOT rather than
# assuming -port was honoured: a flag that silently failed to apply is exactly
# the shape being fixed here.
#
# PROVED, not argued. 2026-09-06, one server and one squatter socket, two dials
# (the run is in this lane's handover):
#
#   squatter holds UDP 27838; server launched with -port 27838
#   hostport convar says 27838          <- what -port ASKED for
#   /proc says the process holds 27006, 27021, 27839
#   the server socket is therefore on 27839
#   the engine's own word for it, in the log: 0 lines
#   dial 27838 (what the launch line asked for) -> server holds 1 player
#   dial 27839 (what /proc measured)            -> server holds 2 players
#
# -strictportbind ON ITS OWN KILLS THE GAME, AND THE FIX IS TWO MORE FLAGS.
#
# The strict flag applies to every socket the engine opens and not only to the
# one this gate asked for. The engine opens three:
#
#     server      hostport      27015     <- the only one -port moves
#     client      clientport    27005
#     SourceTV    tv_port       27020
#
# Any other game on this box already holds 27005 and 27020, those two walk to
# 27006 and 27021, and the engine exits during the map load.
# That is what "with the flag the server reached 'steam game server activated'
# and vanished" was, measured 2026-09-06, and it is why this file said NOT
# -strictportbind for two days.
#
# BOTH OF THOSE ARE CONVARS, AND `+name value` REACHES THEM IN TIME. `-port` is
# read at start-up; the other two are read when the sockets open, which a
# listen server does not do until the map load -- long after the command
# line's `+` arguments have run. So they can
# simply be moved out of the way.
#
# MEASURED, four arms, lane loose-ends, 2026-09-08, with a squatter deliberately
# holding UDP 27005 and 27020 for the whole run (scratchpad/loose-ends-portbind):
#
#   A  -port P                                       LOADED   /proc 27006 27021 P
#   B  -port P -strictportbind                       DIED     /proc (none)
#   C  -port P -strictportbind +clientport C +tv_port T
#                                                    LOADED   /proc P C T
#   D  -port P -strictportbind -nohltv +clientport C LOADED   /proc P C
#
# Arm A is what this gate did: it loads, and the two other sockets silently walk.
# Arm B is the recorded killer, reproduced. Arm C is what the gate does now --
# every socket on a port nothing held, and /proc holds EXACTLY the three that
# were asked for. Arm D works too and opens one fewer socket; C is preferred
# because it moves a socket rather than removing one, which is the smaller
# change to what the engine does.
#
# SO THE FLAG IS BELT AND THE /proc READING IS BRACES, and both are kept. The
# strict arm makes a lost port an immediate exit with a message; the measurement
# is what caught the silent move in the first place and is what proves the flag
# applied at all. A `should` is not a check.
#
# WHAT THE FLAG COSTS: a port race that USED to be survived silently (the engine
# walked, /proc found it, the gate dialled what it measured) is now a dead game.
# launch_with_free_port below is the answer to that -- it recognises the strict
# exit in the log and retries on a fresh port, so the loud failure is loud
# without being fragile.
#-----------------------------------------------------------------------------
# Away from 27015-27020, which every stock Source client and server list probes.
GATE_PORT_RANGE = (27300, 27899)

# How far above `hostport` the engine may silently have landed (it tries 32
# ports), and therefore how far this file has to look.
PORT_TRY_MAX = 32


def free_udp_port(low, high, tries=200, exclude=()):
    """A UDP port nothing on this box holds, in [low, high), and not in `exclude`.

    Bound and released rather than picked at random: two lanes rolling dice in
    the same 600-port range collide about as often as birthdays do, and the
    whole point of this is not to collide.

    THE WINDOW BETWEEN THE RELEASE AND THE ENGINE'S OWN BIND IS STILL OPEN and
    nothing here closes it -- this docstring claimed -strictportbind did, on a
    gate that deliberately did not pass -strictportbind, which was one of the
    three places this file contradicted its own code. What the flag does now
    that it IS passed is turn a lost race from a silent move to port+1 into an
    exit; launch_with_free_port is what then retries on a fresh port.
    """
    import random
    import socket as _socket
    for _ in range(tries):
        port = random.randrange(low, high)
        if port in exclude:
            continue
        sock = _socket.socket(_socket.AF_INET, _socket.SOCK_DGRAM)
        try:
            sock.bind(("0.0.0.0", port))
        except OSError:
            continue
        finally:
            sock.close()
        return port
    raise RuntimeError("no free UDP port in [%d, %d) after %d tries"
                       % (low, high, tries))


def strict_port_flags():
    """-strictportbind, and the two free ports that stop it killing the game.

    ONE FUNCTION FOR ALL THREE LAUNCH LINES, because the failure it prevents is
    per PROCESS and every instance this gate starts opens the same three
    sockets. A launch line that took the flag without the other two would die on
    any box with another game on it, which is exactly the shape the port block
    above records; keeping them together is what makes that impossible to write
    by accident.

    A FRESH PORT EACH CALL, not a constant: two instances of this gate's own run
    (the server, the second client, the save/load one) are on the box at the
    same time, so a shared clientport would collide with itself and, with the
    strict flag on, kill the second one.
    """
    return ["-strictportbind",
            "+clientport", str(free_udp_port(*GATE_PORT_RANGE)),
            "+tv_port", str(free_udp_port(*GATE_PORT_RANGE))]


def strict_bind_exit(log_path):
    """Did this launch die because -strictportbind lost a port race?

    The engine's own words, as it prints them on the way out:

        ERROR: Port 27321 was unavailable - quitting due to "-strictportbind"
        command-line flag!

    Matched on the flag name rather than on the whole sentence: the port number
    is interpolated and the wording is the engine's, not ours. A launch that
    failed for any OTHER reason must NOT match -- a retry that fires on a
    missing libhostfxr would turn one clear failure into three slow ones.
    """
    try:
        with open(log_path, "rb") as fh:
            return b"strictportbind" in fh.read()
    except OSError:
        return False


def launch_with_free_port(build, log_path, tmpdir, tries=3, **kwargs):
    """Launch on a free port, retrying only a -strictportbind port race.

    Returns (Game or None, the port that was asked for last).

    THE RETRY IS THE PRICE OF THE FLAG. Without -strictportbind a lost race was
    survived in silence and the /proc reading picked up the pieces; with it the
    process exits. That is the improvement -- a port this gate did not get is
    now impossible rather than merely reported -- but it would be a REGRESSION
    in a tool that has to run beside three other lanes if one unlucky draw out
    of a 600-port range failed the whole gate. So: recognise that one cause,
    redraw, and let every other launch failure through on the first attempt.
    """
    port = None
    tried = []
    for _ in range(max(1, tries)):
        # Every port this launch already lost is excluded: a fresh draw from
        # the range alone can land on the port it just lost (27582 twice).
        port = free_udp_port(*GATE_PORT_RANGE, exclude=tried)
        tried.append(port)
        game = Game.launch(build(port), log_path, tmpdir, **kwargs)
        if game is not None:
            return game, port
        if not strict_bind_exit(log_path):
            return None, port
        print("== the launch on port %d lost the port race and -strictportbind "
              "exited it; redrawing" % port)
    return None, port


def udp_ports_of(pid):
    """Every UDP port `pid` holds a socket on, read out of /proc.

    /proc, not `ss`: this has to answer about ONE process, and `ss -ulnp`
    answers about the box and then has to be parsed back down to a pid. The
    socket inodes come from /proc/<pid>/fd and the ports from /proc/net/udp,
    which is the same pair `ss` itself joins.
    """
    inodes = set()
    try:
        names = os.listdir("/proc/%s/fd" % pid)
    except OSError:
        return set()
    for name in names:
        try:
            link = os.readlink("/proc/%s/fd/%s" % (pid, name))
        except OSError:
            continue
        if link.startswith("socket:["):
            inodes.add(link[len("socket:["):-1])

    ports = set()
    for table in ("/proc/net/udp", "/proc/net/udp6"):
        try:
            with open(table, "r", encoding="utf-8") as handle:
                next(handle, None)
                for line in handle:
                    parts = line.split()
                    if len(parts) < 10 or parts[9] not in inodes:
                        continue
                    ports.add(int(parts[1].split(":")[1], 16))
        except OSError:
            continue
    return ports


def bound_server_port(api, wanted=None, seconds=60.0):
    """The port the server's socket ACTUALLY ended up on.

    `hostport` is what was ASKED FOR -- `-port` writes it at start-up and the
    convar keeps that value whether or not the bind succeeded on it. The bind
    loop only ever walks UPWARD, so the real port is the lowest port at or above
    hostport that the process holds, within PORT_TRY_MAX.

    Waited for, not sampled: the socket is opened during start-up and the dev
    API answers before the whole of startup is done on a loaded box.
    """
    if wanted is None:
        try:
            wanted = int(api.convar("hostport").get("value"))
        except (ApiError, TypeError, ValueError):
            return None

    deadline = time.time() + seconds
    while True:
        candidates = sorted(p for p in udp_ports_of(api.pid)
                            if wanted <= p < wanted + PORT_TRY_MAX)
        if candidates:
            return candidates[0]
        if time.time() >= deadline or not api.alive():
            return None
        time.sleep(1.0)


#-----------------------------------------------------------------------------
# THE SKIP LEDGER -- the gate may not silently lose coverage.
#
# A skip used to be free. run_step caught Skipped, printed a banner, counted it,
# and main() exited 0 unless --strict was passed by hand -- which nothing does,
# not the Makefile and not any lane. So a step could go from PASS PASS to
# SKIP SKIP between two merges and the gate would still say it passed, which is
# precisely what happened to `second-client` on 2026-09-06.
#
# tools/live-gate-skips.tsv is now the recorded set, and the two rules below are
# both directions of it: an unlisted skip fails (a regression), and a listed
# step that stops skipping fails too (a stale row, which would otherwise mask
# the NEXT regression in that step for as long as it sat there). That second
# rule is the one tools/entity-gates spells "stale allowlist entries" and
# tools/dead-conditionals spells "stale pending".
#-----------------------------------------------------------------------------
SKIP_LEDGER = os.path.join(ROOT, "tools", "live-gate-skips.tsv")


def read_skip_ledger(path, config=None):
    """step -> (owner, reason), plus the malformed rows.

    Returns (entries, errors). A MISSING FILE IS AN ERROR and not an empty
    ledger -- the opposite of read_budget, deliberately. An absent budget means
    "nothing recorded yet, record one"; an absent ledger would mean "every skip
    is unexpected", which sounds strict and is not: it makes deleting the file
    the cheapest way to change the gate's mind, and a guard that a deletion
    disarms is a guard that will be deleted.
    """
    config = config or CONFIG
    entries, errors = {}, []
    if not os.path.exists(path):
        return entries, ["the skip ledger is missing: %s. It is tracked; "
                         "restore it rather than running without it." % path]

    with open(path, "r", encoding="utf-8") as handle:
        for number, raw in enumerate(handle, 1):
            line = raw.rstrip("\n")
            if not line.strip() or line.startswith("#"):
                continue
            parts = line.split("\t")
            kind = parts[0] if parts else ""
            if (len(parts) < 4 or not parts[1].strip()
                    or not (kind == "skip" or kind.startswith("skip@"))):
                errors.append("%s:%d is not a `skip[@config]<TAB>step<TAB>owner<TAB>"
                              "reason` row: %r" % (path, number, line))
                continue
            # `skip@<config>` waives a skip in that configuration only, so a
            # release-only skip is neither stale nor waived in a debug run.
            if kind != "skip" and kind != "skip@" + config:
                continue
            entries[parts[1].strip()] = (parts[2].strip(),
                                         "\t".join(parts[3:]).strip())
    return entries, errors


def skip_findings(verdicts, ledger, step_ids):
    """The three ways a run's skips break the gate. PURE, so --self-test drives it.

    `verdicts` is {step_id: [verdict per pass]}; `ledger` is read_skip_ledger's
    first return; `step_ids` is every step this build knows about.

    Returns (unexpected, stale, unknown):

      unexpected  a step skipped on at least one pass and is not in the ledger.
                  ONE PASS IS ENOUGH. A step that skips on pass 1 and passes on
                  pass 2 is not two-thirds fine, it is the flakiest possible
                  version of the thing this file exists to catch.
      stale       a ledger row whose step RAN and never skipped, on any pass.
                  A step that did not run at all is not stale: the run has no
                  evidence about it, and calling that stale would make an early
                  crash delete the ledger.
      unknown     a ledger row naming a step that does not exist. A typo'd step
                  id would otherwise be a permanently-unusable row that silently
                  waives nothing while looking as if it waives something.
    """
    unexpected = sorted(step for step, got in verdicts.items()
                        if "skip" in got and step not in ledger)
    stale = sorted(step for step in ledger
                   if verdicts.get(step) and "skip" not in verdicts[step])
    unknown = sorted(step for step in ledger if step not in set(step_ids))
    return unexpected, stale, unknown


#-----------------------------------------------------------------------------
# Talking to a game. Through tools/debug-api and nothing else -- the same client a
# person debugging this would use, so a step that passes here is a step that
# can be reproduced by hand.
#-----------------------------------------------------------------------------
class ApiError(Exception):
    pass


def query(params):
    """key=value words for tools/debug-api's query subcommands, None dropped."""
    return ["%s=%s" % (k, v) for k, v in params.items() if v is not None]


class Api:
    def __init__(self, pid, root=ROOT):
        self.pid = str(pid)
        self.root = root
        self.debug_api = os.path.join(root, "tools", "debug-api")

    def raw(self, *args, timeout=25):
        """One tools/debug-api call, and it CANNOT hang.

        subprocess.run(timeout=) is not enough here, and this cost a run. The
        debug-api client is a bash script that execs curl: run()'s timeout kills
        the bash, curl survives holding the inherited stdout pipe, and the
        communicate() that follows the kill blocks forever on a pipe that will
        not close. The gate sat in one of those for twenty minutes with a
        perfectly healthy game answering everything asked of it by hand.

        So the child gets its own process GROUP, and the whole group is killed.
        """
        env = dict(os.environ, DEBUG_API_PID=self.pid)
        child = subprocess.Popen([self.debug_api, *[str(a) for a in args]],
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                 text=True, env=env, start_new_session=True)
        try:
            out, _ = child.communicate(timeout=timeout)
            return out
        except subprocess.TimeoutExpired:
            try:
                os.killpg(os.getpgid(child.pid), signal.SIGKILL)
            except OSError:
                pass
            try:
                child.communicate(timeout=5)
            except Exception:
                pass
            raise ApiError("debug-api %s timed out" % (args,))

    def get(self, *args, timeout=30):
        text = self.raw(*args, timeout=timeout)
        try:
            return json.loads(text)
        except Exception:
            # A game shutting down is still ALIVE for a few seconds after it
            # stops answering, so give it the time to finish going before
            # deciding which of the two this is.
            for _ in range(20):
                if not self.alive():
                    raise ApiError("debug-api %s: the game process %s has exited" % (args, self.pid))
                time.sleep(0.5)
            raise ApiError("debug-api %s did not answer JSON: %r" % (args, text[:120]))

    #-- the handful of shapes every step wants -------------------------------
    def alive(self):
        try:
            os.kill(int(self.pid), 0)
            return True
        except OSError:
            return False

    def cmd(self, text):
        return self.get("cmd", text)

    def convar(self, name, value=None):
        return self.get("convar", name, value) if value is not None \
            else self.get("convar", name)

    def status(self):
        return self.get("status")

    def crossings(self):
        return self.status().get("crossings", {})

    def client_crossings(self, slot):
        """One client's own counters, through this server's proxy.

        THE ROUTE FOR CLIENT COUNTERS. Each side's ABI counts its own crossings
        (plan_side_isolation), so a client's ClientLevelInit is not in this
        server's /status; it is answered by that client at
        /client/{slot}/status. An empty dict while the client has not attached.
        """
        return self.get("client", str(slot), "status").get("crossings", {})

    def ents(self, classname):
        return self.get("ents", classname).get("entities", [])

    def census(self):
        """(entities, distinct classes). (0,0) when the game did not answer --
        every caller here tells that apart from a real zero, because a
        disconnected game answers a REAL zero and that is step 16's evidence."""
        try:
            entities = self.ents("*")
        except ApiError:
            return (0, 0)
        return (len(entities), len({e["classname"] for e in entities}))

    def census_by_class(self):
        """{classname: count}, or None when the game did not answer."""
        try:
            entities = self.ents("*")
        except ApiError:
            return None
        return dict(collections.Counter(e["classname"] for e in entities))

    def player(self, klass="ss_player"):
        """The local player: the lowest entity index of the player class.

        By index rather than 'the only one', because the two-client step puts a
        second one in the list and every other step would then be reading
        whichever the server happened to enumerate first.
        """
        players = self.ents(klass)
        return min(players, key=lambda e: e["index"]) if players else None

    def fields(self, index):
        """One entity's networked fields by name. `debug-api payload <index>`."""
        blob = self.get("payload", index)
        return {f["name"]: f["value"] for f in blob.get("fields", [])}

    def fire(self, target, inp, param="", delay=""):
        return self.get("fire", target, inp, param, delay)

    def heads(self):
        """{events, log, console}: where each ring stands now (/events/head)."""
        return self.get("heads")

    def events_next(self):
        """The sequence a fresh event would take. The 'since' for a step."""
        return self.heads().get("events", 0)

    def events(self, since, limit=500, **filters):
        """Events at or after `since`, FILTERED BY THE GAME: kind, name,
        classname (globs), handle, index. See docs/api.md."""
        return self.get("events", since, limit, *query(filters)).get("events", [])

    def events_all(self, since, page=2000, **filters):
        """Every matching event after `since`, every page of it.

        A map reload, a round of the bisect tool or a busy sensor puts more
        than a page of events between a step's `since` and the one it wants:
        the trigger step once read the first 500 of 1,776 and called the
        OnStartTouch at seq 4868 missing. The filter is the game's now, so a
        step asking for one entity's outputs reads those and nothing else, and
        `next` resumes past what was looked at rather than past the last match.
        """
        seen, cur = [], since
        while True:
            reply = self.get("events", cur, page, *query(filters))
            batch = reply.get("events", [])
            seen += batch
            if len(batch) < page:
                return seen
            cur = reply.get("next", batch[-1]["seq"] + 1)

    #-- the API's own waits and reads (docs/api.md) ----------------------------
    def wait(self, condition, ticks, wall=None):
        """GET /wait: until `condition` (a dict of /wait's query, e.g.
        {"settled": 1, "index": 40}) holds, checked by the game ONCE PER SERVER
        TICK, within `ticks` server ticks. The reply: status (met, timeout,
        wallclock, failed, cancelled), waitedTicks, tick, seq, value.

        Ticks, not seconds: a box running the game six times slower still
        waits the same amount of GAME, which is what every one of these waits
        means. `wall` is the API's safety cap for a game that stopped ticking.
        """
        params = dict(condition, timeout=int(ticks))
        if wall is not None:
            params["wall"] = wall
        cap = wall if wall is not None else max(30.0, min(600.0, ticks * 0.15))
        return self.get("wait", *query(params), timeout=cap + 20)

    def wait_ticks(self, ticks):
        """N server ticks: what a `time.sleep` in this file meant by "let the
        game run a while". The reply's waitedTicks says it happened."""
        ticks = max(0, int(round(ticks)))
        if ticks == 0:
            return None
        return self.wait({"ticks": ticks}, ticks)

    def entity(self, **selector):
        """GET /entity: one entity by index=, handle= or name= -- origin,
        velocity, speed, asleep, ground -- or None when nothing live matches."""
        got = self.get("ent", *query(selector))
        return got if got.get("found") else None

    def counters(self, group):
        """GET /counters?group=: {name: number}, or None when the group's
        source is absent. The numbers cs_sv_physics_events and
        cs_sv_playershadow print, read from the same objects -- not parsed out
        of their text."""
        groups = self.get("counters", group).get("groups", [])
        if not groups or not groups[0].get("available"):
            return None
        return groups[0].get("counters", {})

    def capture(self, command):
        """POST /command?capture=1: the console lines `command` printed, scoped
        by markers around it. None when the capture was not complete (no
        -condebug file, or the closing marker never reached it)."""
        captured = self.get("capture", command).get("captured", {})
        return captured.get("console") if captured.get("complete") else None

    def teleport(self, position, angles=None, settle=False, ticks=330, player=1):
        """GET /player/teleport: setpos_exact's teleport and setang's snap, no
        cheats needed; with settle, answered once the player stands on
        something and has stopped (3 ticks), within `ticks`."""
        params = {"pos": ",".join("%g" % v for v in position), "player": player}
        if angles is not None:
            params["ang"] = ",".join("%g" % v for v in angles)
        if settle:
            params.update({"settle": 1, "timeout": int(ticks)})
        return self.get("teleport", *query(params), timeout=max(30.0, ticks * 0.15) + 20)

    def remove(self, ticks=60, **selector):
        """GET /entities/remove: name= or class= (globs), index= or handle=;
        answered once every one is gone, or a timeout if the engine never
        frees them."""
        return self.get("remove", *query(dict(selector, timeout=int(ticks))),
                        timeout=max(30.0, ticks * 0.15) + 20)

    def place(self, entities, placement="origin"):
        """POST /entities/spawn at EXACT origins and angles; the reply's
        entities, each with index, handle and the origin read back."""
        group = {"placement": placement, "entities": entities}
        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
            json.dump(group, f)
            path = f.name
        try:
            return self.get("place", path).get("entities", [])
        finally:
            os.unlink(path)

    def log_from(self, sequence, limit=40):
        return [l["text"].rstrip()
                for l in self.get("log", sequence, limit).get("lines", [])]

    #-- waiting ---------------------------------------------------------------
    def wait_for(self, predicate, seconds=20.0, step=0.4):
        """Poll until `predicate()` returns something truthy, or give up.

        Returns the truthy value, or None. Every step that waits does it
        through here so that 'it did not happen' and 'it happened later than I
        looked' cannot be confused -- the second is the shape that makes a live
        gate flaky and then makes it ignored.
        """
        deadline = time.time() + seconds
        while time.time() < deadline:
            if not self.alive():
                return None
            try:
                got = predicate()
            except ApiError:
                got = None
            if got:
                return got
            time.sleep(step)
        return None

    def wait_map(self, want_entities, seconds=90.0):
        """Until the census is `want_entities`: /wait?census=, checked by the
        game every tick from the moment the level ticks, instead of listing all
        473 entities as JSON once a second. Ticks stall while a map loads, so
        the bound is the wall-clock cap; a wait the API could not hold (a
        managed reload cancels it) falls back to the poll for what is left."""
        started = time.time()
        try:
            reply = self.wait({"census": want_entities, "op": "eq"},
                              int(seconds / TICK_SECONDS) * 4, wall=seconds)
            if reply.get("status") == "met":
                return True
        except ApiError:
            pass
        left = seconds - (time.time() - started)
        if left <= 0:
            return None
        return self.wait_for(lambda: self.census()[0] == want_entities, left, 1.0)


#-----------------------------------------------------------------------------
# Launching. The pid that owns the socket is hl2_linux64's, NOT the pid bash
# gets back from source# -- that is the launcher, which waits on the engine, and
# waiting on it waits for the wrong process and then reports "no socket" about a game that
# is running perfectly well. So a game is identified by a socket that APPEARED
# while it was starting AND whose process is a descendant of the one we spawned.
#
# THE SECOND HALF OF THAT SENTENCE IS NEW AND IT IS NOT BELT AND BRACES.
# SOCKET_DIR is /tmp/sourcesharp-debug-api -- one directory for the whole machine,
# shared by every worktree. "Whichever socket appeared" therefore means
# "whichever socket appeared ANYWHERE", and this tree routinely has two or three
# live-gate runs going at once in different worktrees. Two of them launching
# inside the same second is all it takes: both compute the same `fresh` set,
# both adopt the SAME pid, both drive it, and the first one to finish its step
# calls Game.kill() on the other one's game. The victim then reports exactly the
# shape a port regression reports -- the world never came back, the census is
# 0/0, the dev API stopped answering -- with nothing in any log to say why.
#
# Measured rather than argued: three probes started together on 2026-09-05
# each printed the same six pids (3602821, 3602986, 3603502, 3604017, 3604572,
# 3605621) and reported five "PROCESS GONE" between them. Six instances were
# launched by each of the three, eighteen games, and all three drove the same
# six.
#
# is_descendant closes it. The pid that owns the socket is the game's, and the
# game is a descendant of the bash we spawned (bash execs source#, which spawns
# hl2_linux64 and waits), so the ancestry walk is a step or two and it is the only thing that distinguishes OUR instance from a peer's.
#-----------------------------------------------------------------------------
def is_descendant(pid, ancestor, limit=16):
    """Is `pid` `ancestor`, or below it in the process tree?

    Walks /proc/<pid>/stat's ppid field upward. Answers False rather than
    raising for a pid that has already gone -- a process that exited between
    the socket listing and this call is not ours to adopt either.

    `limit` bounds the walk: a ppid chain that loops (it cannot, but a corrupt
    read of the stat line could make it look as if it did) must terminate, and
    16 is far more than the three steps a real launch takes.
    """
    try:
        pid = int(pid)
        ancestor = int(ancestor)
    except (TypeError, ValueError):
        return False

    for _ in range(limit):
        if pid == ancestor:
            return True
        if pid <= 1:
            return False
        try:
            with open("/proc/%d/stat" % pid) as handle:
                stat = handle.read()
        except OSError:
            return False
        # The comm field is parenthesised and may contain spaces AND
        # parentheses, so the fields are counted from the LAST ')' and never by
        # splitting the whole line -- a game called "hl2 (linux64)" would move
        # every field after it otherwise. ppid is the second field after comm.
        close = stat.rfind(")")
        if close < 0:
            return False
        rest = stat[close + 1:].split()
        if len(rest) < 2:
            return False
        try:
            pid = int(rest[1])
        except ValueError:
            return False

    return False

#-----------------------------------------------------------------------------
def live_sockets():
    """The sockets whose owning process is still alive.

    A socket file outlives a crash, so the directory listing alone would let a
    dead instance be adopted -- and it would answer nothing, forever.
    """
    out = set()
    if not os.path.isdir(SOCKET_DIR):
        return out
    for name in os.listdir(SOCKET_DIR):
        if not name.endswith(".sock"):
            continue
        pid = name[:-len(".sock")]
        try:
            os.kill(int(pid), 0)
        except (OSError, ValueError):
            continue
        out.add(pid)
    return out


def adoptable(sockets, known, ancestor):
    """The sockets that are NEW and OURS, lowest pid first.

    Split out of Game.launch so --self-test can reach it: the descendant filter
    is the whole of the fix for cross-worktree adoption, and a filter that lives
    inline in a method that needs a real game to run is a filter nothing checks.
    """
    return sorted(p for p in set(sockets) - set(known)
                  if is_descendant(p, ancestor))


class Game:
    """One launched instance, and the temp directory it owns."""

    def __init__(self, pid, popen=None, tmpdir=None, log=None):
        self.pid = pid
        self.popen = popen
        self.tmpdir = tmpdir
        self.log = log
        self.api = Api(pid)

    @classmethod
    def launch(cls, args, log_path, tmpdir, extra_env=None, wait=240):
        os.makedirs(tmpdir, exist_ok=True)
        os.makedirs(SOCKET_DIR, exist_ok=True)
        known = live_sockets()

        # tools/gpu-offload is sourced by every launch path in this tree and
        # this is one. Without it DXVK picks the wrong card and the process
        # dies before server.so loads, with ZERO [SourceSharp] lines in the log
        # -- which reads as a broken port and is not one.
        quoted = " ".join("'%s'" % a.replace("'", "'\\''") for a in args)
        line = (". '%s/tools/gpu-offload'; cd '%s' && exec %s %s"
                % (ROOT, GAME_DIR, launch_command(MOD_DIR), quoted))

        env = dict(os.environ, TMPDIR=tmpdir)
        if extra_env:
            env.update(extra_env)

        handle = open(log_path, "wb")
        popen = subprocess.Popen(["bash", "-c", line], stdout=handle,
                                 stderr=subprocess.STDOUT, env=env,
                                 start_new_session=True)

        deadline = time.time() + wait
        while time.time() < deadline:
            # OURS, not merely NEW: see the block above this class. A peer
            # live-gate in another worktree writes into the same SOCKET_DIR, and
            # adopting its game means driving and then KILLING it.
            fresh = adoptable(live_sockets(), known, popen.pid)
            if fresh:
                return cls(fresh[0], popen, tmpdir, log_path)
            if popen.poll() is not None:
                break
            time.sleep(1.0)

        # THE GROUP HERE TOO. This is the arm that gives up on a game that
        # never opened a socket -- and a game that never opened a socket is
        # very often a game that is still starting. popen.kill() alone kills
        # the bash and leaves the rest of the tree running with nobody holding
        # a handle to it, which is a leaked game per failed launch.
        try:
            os.killpg(os.getpgid(popen.pid), signal.SIGKILL)
        except OSError:
            pass
        popen.kill()
        try:
            popen.wait(timeout=10)
        except Exception:
            pass
        handle.close()
        return None

    def kill(self):
        """Kill the whole launch, and REAP it.

        THE PROCESS GROUP, NOT THE TWO PIDS WE HAPPEN TO KNOW, and this leaked
        fourteen games onto one box before it was written down. A launch is
        bash -> source# -> hl2_linux64: signalling
        `self.pid` and `self.popen.pid` leaves hl2.sh standing, and leaves the
        GAME standing on any path where self.pid is not the game (a launch that
        adopted the wrong socket, an --attach). Every launch here is already
        start_new_session=True, so it has a process group of its own and the
        group is exactly this launch and nothing else.

        The individual signals are kept after the group kill for the --attach
        shape, where there is no popen and no group of ours to name.
        """
        if self.popen is not None:
            try:
                os.killpg(os.getpgid(self.popen.pid), signal.SIGKILL)
            except OSError:
                pass

        for pid in (self.pid, self.popen.pid if self.popen else None):
            if pid is None:
                continue
            try:
                os.kill(int(pid), signal.SIGKILL)
            except OSError:
                pass

        # WAIT, or the launcher stays a zombie for the life of the gate and
        # `os.kill(pid, 0)` -- which is how live_sockets() and Api.alive() ask
        # whether a game is still there -- keeps answering yes about it.
        if self.popen is not None:
            try:
                self.popen.wait(timeout=10)
            except Exception:
                pass

        if self.tmpdir and os.path.isdir(self.tmpdir):
            shutil.rmtree(self.tmpdir, ignore_errors=True)


#-----------------------------------------------------------------------------
# The checklist framework.
#
# A step is a function that makes assertions through `gate`. It may raise
# Skipped, which is LOUD and never counts as a pass -- plan_entity.md step 0d
# is explicit that a step that could not be driven is a finding, and the whole
# reason tools/leg-floor exists elsewhere in this tree is that a thing which
# did not run must never report as a thing that passed.
#-----------------------------------------------------------------------------
class Skipped(Exception):
    pass


def console_lost_line(api):
    """THE CONSOLE FEED'S LOSSES (console-batch), as the budget output says them:
    engine lines the server's native line buffer could not hold since the
    managed load began (/status consoleLinesLost). A readout, not a check -- a
    budget line is gated on crossings, and a loss already prints its own
    warning into the log. But a readout that could not be read SAYS
    "unavailable" and why, never a quiet zero or nothing: a missing input is
    not a pass."""
    try:
        status = api.status()
    except ApiError as why:
        return "consoleLinesLost: unavailable (/status did not answer: %s)" % why
    except AttributeError:
        return "consoleLinesLost: unavailable (this api has no status())"
    lost = status.get("consoleLinesLost") if isinstance(status, dict) else None
    if lost is None:
        return "consoleLinesLost: unavailable (/status carries no consoleLinesLost)"
    return "console %s engine line(s) lost to a full buffer since the load" % lost


def crossings_mark(api):
    """The start of a crossing-count window. A debug build resets the counters
    (cs_sv_crossings reset); a release build has no such command, so the window
    starts at a snapshot and crossings_since subtracts it."""
    if DEBUG_COMMANDS:
        try:
            api.cmd("cs_sv_crossings reset")
        except ApiError:
            pass
        return {"total": 0, "serverFrames": 0, "ops": {}}
    try:
        snap = api.crossings()
    except ApiError:
        snap = {}
    return {"total": snap.get("total", 0), "serverFrames": snap.get("serverFrames", 0),
            "ops": dict(snap.get("ops", {}))}


def crossings_since(api, mark):
    """The counts accumulated since crossings_mark: as read in a debug build
    (the mark was a reset), the difference from the snapshot in a release one."""
    now = api.crossings()
    ops = {k: v - mark["ops"].get(k, 0) for k, v in now.get("ops", {}).items()}
    return {"total": now.get("total", 0) - mark["total"],
            "serverFrames": now.get("serverFrames", 0) - mark["serverFrames"],
            "ops": ops}


# The server's tick (ServerGameDll.cs): what a wall-clock wait in this file
# meant in game time, converted to /wait?ticks=.
TICK_SECONDS = 0.015


class Gate:
    def __init__(self, api, scenario, verbose=True):
        self.api = api
        self.scen = scenario
        self.verbose = verbose
        self.failures = []
        self.notes = []
        self._step = None
        # A step's own scratchpad ACROSS PASSES. The two passes run against one
        # Gate object, so a step that wants to compare what it read the second
        # time with what it read the first has nowhere else to keep it. Used by
        # map-change, whose whole point is that the second visit to a map must
        # read the same census as the first.
        self.state = {}

    def say(self, text=""):
        if self.verbose:
            print(text, flush=True)

    def check(self, ok, message):
        if ok:
            self.say("    ok    %s" % message)
        else:
            self.say("    FAIL  %s" % message)
            self.failures.append((self._step, message))
        return bool(ok)

    def mark(self, label):
        """Where a long step is, in wall seconds since it began: a step whose
        total is two minutes says which of its waits took them."""
        self.say("    @%6.1f s  %s" % (time.time() - getattr(self, "began", time.time()), label))

    def note(self, message):
        self.say("    --    %s" % message)
        self.notes.append((self._step, message))

    def skip(self, reason):
        raise Skipped(reason)

    #-- things more than one step does --------------------------------------
    def cheats(self):
        self.api.cmd("sv_cheats 1")

    def teleport(self, position, angles=None, settle=1.0):
        """setpos_exact's teleport (the player's physics shadow goes with
        them; plain setpos leaves it behind for a tick, and stock's
        VPhysicsShadowUpdate then reconciles the player towards where they
        were -- in stock too, and the trigger step pins the difference) and
        setang's view snap, through /player/teleport.

        `settle` WAS A SLEEP, of that many wall seconds, guessing that the
        player would have landed by then -- an under-wait on a busy box, an
        over-wait on an idle one. Now any settle > 0 means "answer once the
        player stands on something and has stopped", counted in server ticks,
        with three times the old guess in ticks as the budget. A teleport
        into the air on purpose passes settle=0 and returns at once."""
        ticks = max(60, int(settle / TICK_SECONDS * 3))
        reply = self.api.teleport(position, angles, settle=settle > 0, ticks=ticks)
        if settle > 0 and not reply.get("ok"):
            self.say("    (teleport to %s: the player had not landed after %s tick(s): %s)"
                     % (position, reply.get("waitedTicks"), reply.get("value")))
        if settle > 0 and angles is not None:
            self.settle_view(angles[1])
        return reply

    def settle_view(self, yaw, hold=8, budget=120):
        """Until the player's yaw is `yaw` and has STAYED it for `hold` ticks.

        The snap is fixangle: the server sets the view at once, but a usercmd
        the client sent before it heard carries the old view and puts it back
        for a tick, and only then does the client adopt the new one. The old
        1.2 s sleep after setang covered that round trip; a settle that
        answers once the player stands does not. Measured: a push round's
        crate was made 650 units behind the player, at the aim point of the
        spawn's view, because the aim was read inside that round trip."""
        me = self.api.player(self.scen["playerClass"])
        if not me:
            return False
        since = None
        first = None
        while True:
            e = self.api.entity(index=me["index"])
            if e is None:
                return False
            first = e["tick"] if first is None else first
            off = abs((e["angles"][1] - yaw + 180.0) % 360.0 - 180.0)
            if off <= 1.0:
                since = e["tick"] if since is None else since
                if e["tick"] - since >= hold:
                    return True
            else:
                since = None
            if e["tick"] - first >= budget:
                self.say("    (the view never held yaw %.1f: it reads %.1f)" % (yaw, e["angles"][1]))
                return False

    def ticks(self, seconds):
        """Let the GAME run what `seconds` of it is at the 15 ms tick: a
        /wait?ticks=, not a sleep, so a slow box waits the same game time."""
        return self.api.wait_ticks(seconds / TICK_SECONDS)

    def player_origin(self):
        player = self.api.player(self.scen["playerClass"])
        return player["origin"] if player else None

    def face(self, target, lift=0.0):
        """Point the player at `target`, from the EYE and not the origin."""
        origin = self.player_origin()
        eye = (origin[0], origin[1], origin[2] + 64.0)
        pitch, yaw = angles_to(eye, (target[0], target[1], target[2] + lift))
        self.api.cmd("setang %.3f %.3f 0" % (pitch, yaw))
        # The snap reaches the client with fixangle in the next snapshot, and
        # its next usercmds carry it: game time, so ticks.
        self.ticks(0.4)

    def hold(self, button, seconds):
        """+button, wait, -button. Buttons are the client's, and on a listen
        server the console reaches them: this is how a usercmd gets made
        without a human on the keyboard. The hold is GAME time: a walk of 1.5 s
        is 100 ticks of usercmds however slowly the box runs them."""
        self.api.cmd("+%s" % button)
        self.ticks(seconds)
        self.api.cmd("-%s" % button)
        self.ticks(0.4)



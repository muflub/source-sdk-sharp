def keep_log(src, dst):
    """Copy a scratch log somewhere that survives the run, and say where.

    Returns the sentence to print, so a caller cannot copy the file and forget
    to say so -- a preserved log nobody is told about is a deleted one.
    """
    try:
        shutil.copyfile(src, dst)
    except OSError as why:
        return "its log could NOT be kept (%s -> %s): %s" % (src, dst, why)
    return ("this step failed; its instance's log is kept at %s (%d bytes). "
            "It has no -condebug, so this is the only copy: read it before "
            "console.log, and read `journalctl -k` and `coredumpctl list` too "
            "-- the last failure here was a segfault the log never saw."
            % (dst, os.path.getsize(dst)))


class ConsoleMirror:
    """This game's console as /console serves it, kept since the API started.

    count() and last() answer what count_in() and last_line_in() answered over
    console.log, but over THIS game's lines only (the file holds every run's)
    and without re-reading a growing file on every poll: each call fetches only
    what is new since the last. A managed reload replaces the server and its
    ring -- /console's `epoch` changes and its sequences start again -- and the
    mirror carries on from the new ring's start; what the old ring held stays.
    """

    PAGE = 2000

    def __init__(self, api):
        self.api = api
        self.lines = []
        self.cursor = 0
        self.epoch = None
        self.lost = 0

    def refresh(self):
        while True:
            reply = self.api.get("console", self.cursor, self.PAGE)
            if reply.get("epoch") != self.epoch:
                if self.epoch is not None and self.cursor:
                    self.cursor = 0
                    self.epoch = reply.get("epoch")
                    continue
                self.epoch = reply.get("epoch")
            batch = reply.get("lines", [])
            if batch and batch[0]["seq"] > self.cursor:
                # The ring wrapped past what was last read.
                self.lost += batch[0]["seq"] - self.cursor
            self.lines += [l["text"] for l in batch]
            self.cursor = batch[-1]["seq"] + 1 if batch else max(self.cursor, reply.get("next", 0))
            if len(batch) < self.PAGE:
                return

    def count(self, needle):
        try:
            self.refresh()
        except ApiError:
            pass
        return sum(1 for line in self.lines if needle in line)

    def last(self, needle):
        try:
            self.refresh()
        except ApiError:
            pass
        for line in reversed(self.lines):
            if needle in line:
                return line.rstrip("\n")
        return None

    def matching(self, needle):
        """Every line of this game's console carrying `needle`, oldest first."""
        try:
            self.refresh()
        except ApiError:
            pass
        return [line.rstrip("\n") for line in self.lines if needle in line]


def attach_console(g, api):
    """Points `g`'s console readers at THIS game's console, through /console.

    Never at a path worked out here: the game's console is console.log, or
    the file +con_logfile moved it to, in a game dir of its own under
    -instance. The launcher names the file to the game
    (SOURCESHARP_CONSOLE_LOG) and /console follows it, so a tool that asks
    /console reads the right file however the game was launched.
    """
    mirror = ConsoleMirror(api)
    g.count_console = mirror.count
    g.last_console_line = mirror.last
    g.console_lines = mirror.matching
    return mirror


def console_file(api):
    """The file this game's console is written to, as /console follows it.

    For a reader that needs byte offsets rather than lines. A game whose
    /console names no file has no console to read: that is an error, never
    a guess at bin/<config>/mods/test/console.log.
    """
    path = api.get("console", 0, 1).get("path") or ""
    if not path:
        raise ApiError("/console names no console file")
    return path


def count_in(path, needle):
    """How many lines of `path` carry `needle`.

    Its own function because `grep -c` prints 0 AND exits 1 when nothing
    matches, so the obvious shell version yields the two-line string "0\\n0" and
    reports the ABSENCE of a symptom as the symptom. The bash live-gate's first
    run did exactly that.
    """
    if not path or not os.path.exists(path):
        return 0
    total = 0
    with open(path, "rb") as handle:
        for line in handle:
            if needle.encode() in line:
                total += 1
    return total


def last_line_in(path, needle):
    """The LAST line of `path` carrying `needle`, or None.

    Its own function for count_in's reason and one more: the gate runs its
    steps twice in one process, so a readout printed per pass appears more than
    once and the first match is the OLDER one. A check reading the first would
    be asserting about pass 1 while claiming to be pass 2.
    """
    if not path or not os.path.exists(path):
        return None
    found = None
    with open(path, "rb") as handle:
        for line in handle:
            if needle.encode() in line:
                found = line.decode("utf-8", "replace").rstrip("\r\n")
    return found


def probe_calls(gate, method):
    """`calls=N` off the boundary probe's row for `method`, or None.

    The row is `<name padded> calls=N null=N nonnull=N callers=...`
    (shell_boundary_probe.h, FormatLine).

    Read out of the CONSOLE log and not the launcher's stdout -- see
    gate.count_console.
    """
    line = gate.last_console_line(method)
    if not line:
        return None
    found = re.search(r"calls=(\d+)", line)
    return int(found.group(1)) if found else None


# A STEP FAILS ON A MANAGED EXCEPTION OR A REFUSED ACQUISITION IN ITS LOG,
# whatever its own checks say. Both used to be read, if at all, as "map
# warning(s), not gated": at e814cd6d3 the movement loop threw on every tick
# (269,840 "EXCEPTION IN" lines, the engine trace unserved) and at bd894daf1
# the server fired no game event ("could not acquire GAMEEVENTSMANAGER002"),
# and every step that did not look for that one effect passed.
FAULTS = (
    ("a managed exception", re.compile(r"EXCEPTION IN ")),
    ("a refused interface acquisition", re.compile(r'could not acquire "')),
)
# (step id, pattern) for a step that provokes one of the above on purpose. A row
# names the step and the line, so an exemption cannot spread past its reason.
FAULT_EXEMPT = ()


def faults_in(lines, step_id, exempt=FAULT_EXEMPT):
    """[(kind, line)] for every line of `lines` that is a fault and is not
    exempt for `step_id`. PURE, so --self-test drives it."""
    found = []
    for line in lines:
        for kind, pattern in FAULTS:
            if pattern.search(line):
                if not any(sid == step_id and re.search(rx, line) for sid, rx in exempt):
                    found.append((kind, line))
                break
    return found


def log_next(api):
    """The managed log's next sequence number: where a step's window starts."""
    return api.get("log", 999999, 1).get("next", 0)


def log_since(api, seq, page=500, pages=200):
    """Every managed log line from `seq` on, paged. Returns (lines, complete):
    complete is False when the window held more than `pages` pages, or the
    log restarted under it (a relaunched game), so the caller can say what it
    did not read rather than read it as clean."""
    lines, cur, complete = [], seq, True
    for _ in range(pages):
        reply = api.get("log", cur, page)
        batch = reply.get("lines", [])
        if not batch and reply.get("next", 0) < cur:
            # The log is shorter than where the step began: a new game.
            cur, complete = 0, False
            continue
        lines += [l.get("text", "").rstrip() for l in batch]
        if len(batch) < page:
            return lines, complete
        cur = reply.get("next", cur + len(batch))
    return lines, False


def run_step(gate, step_id, budget, recorded, report):
    _, title, func = BY_ID[step_id]
    gate._step = step_id
    gate.say("\n-- %s (%s)" % (title, step_id))

    try:
        log_mark = log_next(gate.api)
    except ApiError:
        log_mark = None

    # Scoped to THIS step. Crossings.Reset's own docstring says this is what it
    # is for: counters that only accumulate would make every stage's budget a
    # subtraction, and a subtraction of two numbers taken a frame apart is
    # where an off-by-one frame hides.
    mark = crossings_mark(gate.api)
    began = time.time()
    gate.began = began
    # A step may measure its own window (step_render: the CLIENT's counters,
    # per client frame) and hand it over here in place of the server's.
    gate._window = None

    failures_before = len(gate.failures)
    verdict = "pass"
    try:
        func(gate)
    except Skipped as why:
        verdict = "skip"
        gate.say("    SKIPPED  %s" % why)
        report.setdefault("skips", []).append((step_id, str(why)))
    except ApiError as why:
        verdict = "fail"
        gate.say("    FAIL  the dev API stopped answering: %s" % why)
        gate.failures.append((step_id, "dev API stopped answering: %s" % why))

    if verdict != "skip":
        if log_mark is None:
            gate.check(False, "the managed log could not be read at the step's start, so its "
                              "exceptions and refused acquisitions were not looked for")
        else:
            try:
                lines, complete = log_since(gate.api, log_mark)
                faults = faults_in(lines, step_id)
                gate.check(not faults,
                           "no managed exception or refused acquisition in the step's log "
                           "(%d line(s) read%s)%s"
                           % (len(lines), "" if complete else ", NOT ALL",
                              "" if not faults else ": %d, e.g. %s"
                              % (len(faults), ["%s: %s" % (k, l[:120]) for k, l in faults[:3]])))
                if not complete:
                    gate.note("the step's log was not read whole (a relaunch, or over %d lines)"
                              % len(lines))
            except ApiError as why:
                gate.check(False, "the managed log stopped answering after the step: %s" % why)

    if verdict == "pass" and len(gate.failures) > failures_before:
        verdict = "fail"

    #-- the crossing budget --------------------------------------------------
    total = frames = 0
    unit = "server frames"
    try:
        crossings = gate._window or crossings_since(gate.api, mark)
        total = crossings.get("total", 0)
        frames = crossings.get("serverFrames", 0)
        ops = crossings.get("ops", {})
        unit = crossings.get("unit", unit)
    except ApiError:
        ops = {}
    if not DEBUG_COMMANDS:
        gate.say("    note  %s build: no cs_sv_crossings reset, so this window is a "
                 "snapshot delta" % CONFIG)

    # THE PLAYER'S HEALTH AFTER EVERY STEP, as a trail. A player who dies
    # between steps fails every later step that needs one -- c7's pass 1 at
    # d673dea lost 90 health somewhere between pickup and prop-hurts-player
    # and nine checks failed downstream of it -- and without a trail the
    # step that killed them cannot be named. Read, never checked.
    try:
        who = gate.api.player(gate.scen["playerClass"])
        gate.say("    player  health %s after this step" % (who["health"] if who else None))
    except (ApiError, KeyError, TypeError):
        gate.say("    player  health unreadable after this step")

    # WALL SECONDS AND SERVER TICKS, per step. The gate printed only frames,
    # so nobody could say where a two-minute step's time went: a step slow in
    # ticks is slow in the game; one slow in seconds and not ticks waited on
    # something else -- a load, a sleep, the box.
    wall = time.time() - began
    report.setdefault("times", []).append((step_id, wall, frames))
    gate.say("    time    %.1f s wall, %d server ticks (%.1f s of game)"
             % (wall, frames, frames * TICK_SECONDS))

    rate = per_frame(total, frames)
    recorded.append((step_id, total, frames))
    gate.say("    budget  %d crossings / %d %s = %.3f per frame"
             % (total, frames, unit, rate))
    # WHERE THE CROSSINGS WENT. A stage over budget is a question about which
    # op grew; without the breakdown the only answer was a bisect.
    top = sorted(ops.items(), key=lambda kv: -kv[1])[:6]
    if top:
        gate.say("    ops     %s" % ", ".join("%s %d" % kv for kv in top))
    gate.say("    " + console_lost_line(gate.api))

    if step_id not in budget:
        # A STAGE WITH NO ROW IS GATED ON NOTHING, AND SAYING SO IS THE POINT.
        # The line above prints a per-frame number for every stage whether or
        # not anything checks it, and a reader seeing `budget 53647 crossings /
        # 1520 frames = 35.294 per frame` has no way to tell an enforced
        # ceiling from a readout. The `projectile` step ran exactly that way
        # for its first two gate runs -- printing a budget, gated on nothing --
        # which is the skip ledger's failure mode wearing the budget's clothes.
        gate.say("    note  %s has NO ROW in the budget file, so this stage is "
                 "gated on nothing. `tools/live-gate --record` writes one."
                 % step_id)

    if step_id in budget:
        row = budget[step_id]
        if frames >= MIN_FRAMES_FOR_RATE and row.gated_on == "total":
            # `die` IS BIMODAL: 8 server frames in 14 of this lane's 16
            # calibration passes and 28-30 in the other two. When it runs long
            # it falls under ceiling_per_frame -- which for a total-gated row
            # was derived from the SHORT run (735/8 = 91.875 -> 147.812) and is
            # about six times the rate it actually shows when it runs long
            # (710/30 = 23.7). That is not a constraint, and a check that
            # cannot fail should say so rather than print a tick.
            gate.say("    note  %s is recorded total-gated but ran %d frames, "
                     "so it is checked against ceiling_per_frame %.3f -- a "
                     "number derived from a %d-frame run, not a real ceiling "
                     "for a %d-frame one."
                     % (step_id, frames, row.ceiling_rate, row.frames, frames))
        if frames >= MIN_FRAMES_FOR_RATE:
            if rate > row.ceiling_rate:
                gate.say("    FAIL  over budget: %.3f per frame, ceiling %.3f "
                         "(§5: each phase may only lower this)" % (rate, row.ceiling_rate))
                gate.failures.append((step_id, "crossings over budget: %.3f > %.3f per frame"
                                      % (rate, row.ceiling_rate)))
                verdict = "fail"
        elif total > row.ceiling_total:
            # The ceiling names its own evidence, because the first question
            # asked of a red short stage is "is that a regression or is that
            # the calibration again": 8 samples spanning 481..1403 answers it
            # in the failure line rather than in a status file nobody reads.
            gate.say("    FAIL  over budget: %d crossings in %d frame(s), ceiling %d "
                     "(too few frames for a rate; ceiling is %d samples spanning "
                     "%d..%d, x1.5+200; §5: each phase may only lower this)"
                     % (total, frames, row.ceiling_total, row.samples,
                        row.total_min, row.total_max))
            gate.failures.append((step_id, "crossings over budget: %d > %d total"
                                  % (total, row.ceiling_total)))
            verdict = "fail"

    # The four ops the plan states as exactly one per frame. A rate of 2.0
    # here is not a budget overrun, it is a frame dispatched twice. Server
    # ops over server frames only: a client window (step_render) has neither.
    if frames >= 30 and unit == "server frames":
        for op in PER_FRAME_OPS:
            got = per_frame(ops.get(op, 0), frames)
            if abs(got - 1.0) > PER_FRAME_TOLERANCE:
                gate.say("    FAIL  %s ran %.3f times per server frame, not once" % (op, got))
                gate.failures.append((step_id, "%s is %.3f/frame, not 1.0" % (op, got)))
                verdict = "fail"

    return verdict, rate


def log_checks(gate, before_decals):
    """The native half, which has no dev API surface at all.

    Not the evidence for any of the sixteen -- every one of those asserts
    through tools/debug-api -- but an assert, a refused worldspawn or a FATAL is a
    real defect that a passing checklist would otherwise walk straight past.
    -assertlog means a fired assertion is a log line rather than a halt, which
    is precisely how 284 of them went unnoticed.
    """
    if not gate.own_log:
        gate.say("    --    attached, so this process did not capture a log to read")
        return

    gate._step = "log"
    refused = gate.count_log("a second one was asked for while one exists")
    gate.check(refused == 0,
               "no worldspawn was refused (a world that outlived its level "
               "refuses the next one, three lines before the fault)")

    decals = gate.count_log("map decals:")
    if before_decals > 0 or decals > 0:
        gate.check(decals > before_decals,
                   "the map's decals painted again on this load (%d -> %d): the "
                   "decal pass is the first thing after level init that traces "
                   "against the world" % (before_decals, decals))
    else:
        gate.say("    --    this map places no decals; that leg is not measured")

    gate.check(gate.count_log("SourceSharp] FATAL") == 0, "nothing FATAL in the log")
    asserts = gate.count_log("Assertion Failed")
    gate.check(asserts == 0,
               "no assertion fired (%d found; -assertlog means an assert does "
               "not stop the game, not that it does not matter)" % asserts)
    return decals


#=============================================================================
# --self-test: the parts that can be checked without a game.
#
# The tree's rule is a test per behaviour, and a bash-or-python tool has
# neither an xUnit fact nor a gtest to live in -- so the arithmetic, the budget
# file's round trip and the registry's agreement with §5 are checked here, and
# `tools/live-gate --self-test` is the command that runs them. Each one has
# been mutation-verified: break the thing under test, watch the assert fire.
#=============================================================================
def self_test():
    checks = []

    def ok(condition, name):
        checks.append((bool(condition), name))

    #-- faults_in: a step fails on a managed exception or a refused acquisition --
    exc = "[SourceSharp] ===== EXCEPTION IN IManagedPlayerCommands.MoveProcessMovement (managed)"
    acq = ('[SourceSharp/Server] game events: no IGameEventManager2 (could not acquire '
           '"GAMEEVENTSMANAGER002" from the AppSystem factory: ...)')
    clean = "[SourceSharp] listening for game event 'player_death'"
    ok(faults_in([clean], "join") == [], "a clean line is no fault")
    ok([k for k, _ in faults_in([exc], "join")] == ["a managed exception"],
       "an EXCEPTION IN line is a managed exception")
    ok([k for k, _ in faults_in([acq], "kill-feed")] == ["a refused interface acquisition"],
       "a could-not-acquire line is a refused acquisition")
    ok(len(faults_in([exc, clean, acq, exc], "join")) == 3, "every fault line is counted")
    ok(faults_in([exc], "join", exempt=(("join", r"MoveProcessMovement"),)) == [],
       "an exemption row excuses its own step's line")
    ok(len(faults_in([exc], "door", exempt=(("join", r"MoveProcessMovement"),))) == 1,
       "and no other step's")
    ok(len(faults_in([acq], "join", exempt=(("join", r"MoveProcessMovement"),))) == 1,
       "and no other line in its own step")
    ok(FAULT_EXEMPT == (), "no step is exempt today")

    #-- reload_vanish_allowance / reload_excused: a self-removal in the span --
    before = {"booked.ss_ragdoll": 1, "dueMs.ss_ragdoll.0": 2500,
              "booked.item_healthkit": 1, "dueMs.item_healthkit.0": 20000,
              "booked.prop_physics:Fade": 1, "dueMs.prop_physics:Fade.0": 900}
    allow = reload_vanish_allowance(before, 3.0)
    ok(allow == {"ss_ragdoll": 1, "prop_physics": 1},
       "a booking due inside the span lets its class lose one entity (%s)" % allow)
    ok(reload_excused(["ss_ragdoll"], allow) == (["ss_ragdoll"], []),
       "a corpse whose removal came due inside the reload is excused")
    ok(reload_excused(["item_healthkit"], allow) == ([], ["item_healthkit"]),
       "an entity whose class had nothing due is still lost")
    ok(reload_excused(["ss_ragdoll", "ss_ragdoll"], allow) == (["ss_ragdoll"], ["ss_ragdoll"]),
       "a class loses no more than it had due")
    ok(reload_vanish_allowance(before, 1.0) == {"prop_physics": 1},
       "a booking due after the span excuses nothing")
    # spectate then hot-reload (2026-10-12, 2 of 2): the corpse was due 0.5 s
    # after the census read and gone by the think reads 1.7 s later.
    census = ({"booked.ss_ragdoll": 1, "dueMs.ss_ragdoll.0": 500,
               "booked.item_healthkit": 1, "dueMs.item_healthkit.0": 20000}, 63.3)
    later = ({"booked.item_healthkit": 1, "dueMs.item_healthkit.0": 18300}, 65.0)
    ok(reload_vanish_allowance_over([census, later], 67.1) == {"ss_ragdoll": 1},
       "a removal due between the census read and the think reads is excused (%s)"
       % reload_vanish_allowance_over([census, later], 67.1))
    ok(reload_vanish_allowance_over([later], 67.1) == {},
       "and the think reads alone cannot see it (the control)")
    ok(reload_vanish_allowance_over([census, ({"booked.ss_ragdoll": 1, "dueMs.ss_ragdoll.0": 100}, 63.7)],
                                    67.1) == {"ss_ragdoll": 1},
       "one booking in two reads excuses one entity, not two")

    #-- fall_drop_origin: impact-damage's crate does not follow a falling player --
    planned = 0.0 + 120.0
    ok(fall_drop_origin((-3843.0, 3263.97, 184.0), (-3843.0, 2894.0, 120.0), planned)
       == (-3843.0, 3263.97, 184.0 + PROP_DROP_LIFT),
       "a player where the teleport put it makes the crate over the aim")
    ok(fall_drop_origin((-3843.0, 3263.97, 157.0), (-3843.0, 2894.0, 93.0), planned)
       == (-3843.0, 3263.97, 184.0 + PROP_DROP_LIFT),
       "a player 27 units into its fall makes it at the same height (the 189.0 red)")
    ok(fall_drop_origin((1.0, 2.0, 3.0), None, planned) == (1.0, 2.0, 3.0 + PROP_DROP_LIFT),
       "no origin in the reply falls back to the aim")

    #-- blast_side_spot / blast_floor_spot: damage-message's blast and stand --
    # dm_lockdown's openFloor blast and the physics props round it, read live
    # (2026-10-12): the fixed +X stand was 17 units from #30, inside it, and
    # every side of the blast has a prop within 72.
    blast = (-3841.84, 2894.0, -2.09)
    lockdown = [(-3830.0, 2810.0, 0.0), (-3784.0, 2752.0, 27.07), (-3788.0, 2852.0, 0.0),
                (-3842.92, 2984.11, -1.0), (-3858.76, 2998.44, -1.0), (-3829.04, 3009.57, -1.0),
                (-3959.0, 2952.0, -1.0), (-3980.0, 2972.0, -1.0)]
    ok(blast_side_spot(blast, []) == ((-3841.84, 2798.0), 0.0),
       "with no prop near, the stand is 96 units to the blast's right facing +X (%s)" % (blast_side_spot(blast, []),))
    spot = blast_side_spot(blast, lockdown[:1])
    ok(spot == ((-3841.84, 2990.0), 180.0),
       "a prop 17 units from the +X stand sends the player to the -X side (%s)" % (spot,))
    ok(blast_side_spot(blast, lockdown) is None,
       "at openFloor every side of the blast has a prop within 72 units")
    ok(blast_floor_spot((-3843.0, 2894.0, 0.0), []) == [-3843.0, 2894.0, 0.0],
       "with no prop near, the blast is made at openFloor itself")
    floor = blast_floor_spot((-3843.0, 2894.0, 0.0), lockdown)
    stand = floor and blast_side_spot(floor, lockdown)
    ok(floor is not None and stand is not None
       and all(math.hypot(p[0] - floor[0], p[1] - floor[1]) > 72.0 for p in lockdown)
       and all(math.hypot(p[0] - stand[0][0], p[1] - stand[0][1]) > 72.0 for p in lockdown),
       "round openFloor the blast and its stand are both 72 units from every prop (%s, %s)" % (floor, stand))
    for yaw in (0.0, 180.0, 90.0, 270.0):
        r = math.radians(yaw)
        sx, sy = blast[0] + math.sin(r) * 96.0, blast[1] - math.cos(r) * 96.0
        others = [q for q in ((blast[0], blast[1] - 96.0), (blast[0], blast[1] + 96.0),
                              (blast[0] - 96.0, blast[1]), (blast[0] + 96.0, blast[1]))
                  if math.hypot(q[0] - sx, q[1] - sy) > 1.0]
        got = blast_side_spot(blast, others)
        left = got and (-math.sin(math.radians(got[1])) * (blast[0] - got[0][0])
                        + math.cos(math.radians(got[1])) * (blast[1] - got[0][1]))
        ok(got is not None and got[1] == yaw and abs(left - 96.0) < 0.01,
           "with only the yaw-%g stand clear, it is chosen and the blast is 96 units on its left (%s, %s)"
           % (yaw, got, left))
    ring = [(blast[0], blast[1] - 96.0), (blast[0], blast[1] + 96.0),
            (blast[0] - 96.0, blast[1]), (blast[0] + 96.0, blast[1])]
    ok(blast_side_spot(blast, ring) is None, "with every side taken there is no spot")

    #-- reload_player_clear_of: the hot-reload door never opens through the player
    # The flake (plan_physics_bones_perf C7): the aimed door's origin stood
    # 56.4 and 67.7 units from the player in the failing passes, 75.6 in the
    # passing ones (openFloor, player at y 2894).
    you = [-3843.0, 2894.0, 0.0]
    for door_y in (2950.42, 2961.66, 2969.63):
        to = reload_player_clear_of([-3843.0, door_y, 51.0], you)
        ok(to is not None and abs(math.hypot(to[0] + 3843.0, to[1] - door_y) - RELOAD_DOOR_CLEARANCE) < 1e-6
           and to[1] < you[1] and to[0] == you[0] and to[2] == you[2],
           "a door %.1f units ahead sends the player back to %.0f units from it, along the same line (%s)"
           % (door_y - you[1], RELOAD_DOOR_CLEARANCE, to))
    ok(reload_player_clear_of([-3843.0, 3034.11, 0.0], you) is None,
       "a door already clear of the player moves nobody")
    ok(reload_player_clear_of(you, you) is not None,
       "a door right on the player still sends them somewhere")

    #-- think_survival: the hot-reload step's think-heap verdict --------------
    # The race this exists for (1 in 5-10 runs, 2026-10-11): item_ammo_pistol's
    # one-shot 20 s respawn came due inside the reload's span, ran, and was
    # gone -- read as a booking the reload lost.
    first = {"booked.item_ammo_pistol": 1, "dueMs.item_ammo_pistol.0": 2100,
             "booked.point_spotlight": 2, "due1.point_spotlight": 2,
             "dueMs.point_spotlight.0": 15, "dueMs.point_spotlight.1": 15}
    before = {"booked.item_ammo_pistol": 1, "dueMs.item_ammo_pistol.0": 600, "due1.item_ammo_pistol": 1,
              "booked.point_spotlight": 2, "due1.point_spotlight": 2,
              "dueMs.point_spotlight.0": 15, "dueMs.point_spotlight.1": 15,
              "booked.item_healthkit": 1, "dueMs.item_healthkit.0": 20000}
    after = {"booked.point_spotlight": 2, "booked.item_healthkit": 1}
    req, have, short = think_survival(first, before, after, 3.0)
    ok(req == 3 and have == 3 and not short,
       "a one-shot due inside the reload's span that ran is not counted lost (%s %s %s)" % (req, have, short))
    req, have, short = think_survival(first, before, {"booked.point_spotlight": 2}, 3.0)
    ok(have < req and short == ["item_healthkit 0 of 1"],
       "a booking due after the span that the reload dropped is caught (%s)" % short)
    req, have, short = think_survival(first, before, {"booked.item_healthkit": 1}, 3.0)
    ok(have < req and short == ["point_spotlight 0 of 2"],
       "a recurring thinker the reload dropped is caught (%s)" % short)
    req, have, short = think_survival(first, before, {}, 3.0)
    ok(req == 3 and have == 0, "the 8 -> 0 shape: everything dropped is caught (%s of %s)" % (have, req))
    #-- compare_noise (C7 step 2) ---------------------------------------------
    ok(compare_noise({"sceneDifference": "scene 0 entry 17: group 1 ent 329 against group 1 ent 66",
                      "stock": "render.DrawBrushModelEx\tmodel=*37 mode=0",
                      "plan": "render.SetColorModulation\t1,1,1"}) is not None,
       "frames whose lists differ part as input noise")
    ok(compare_noise({"sceneDifference": None, "stock": "ctx.SetGoalToneMappingScale\t1.32",
                      "plan": "ctx.SetGoalToneMappingScale\t1.33"}) is not None,
       "auto exposure's goal parting is input noise")
    ok(compare_noise({"sceneDifference": None, "stock": "render.DrawBrushModelEx\tmodel=*37 mode=0",
                      "plan": "render.SetColorModulation\t1,1,1"}) is None,
       "the same inputs parting is the plan's difference")
    ok(compare_noise({"sceneDifference": "scene 0: 115 entries against 226", "stock": "render.SetMainView\torigin=-4116,4600,65.9 angles=0,-90,0",
                      "plan": "render.SetMainView\torigin=-3800.08,2500,63.77 angles=0,-90,0"}) is None,
       "two frames that looked from different places are the plan's difference, not noise")
    ok(compare_noise({"sceneDifference": None, "stock": "ctx.SetGoalToneMappingScale\t1.32",
                      "plan": "render.SetBlend\t1"}) is None,
       "a clock-driven call against a different call is the plan's difference")

    #-- client_reload_caches_verdict ------------------------------------------
    ok(client_reload_caches_verdict({"cachesDropped": 0})[0],
       "a client unload that reached Forget and found nothing bound passes")
    ok(not client_reload_caches_verdict({"cachesDropped": -1})[0],
       "cachesDropped -1 (Forget never ran) fails")
    ok(not client_reload_caches_verdict({"cachesDropped": 3})[0],
       "a route that outlived the client's Shutdown fails")
    ok(not client_reload_caches_verdict({})[0], "a record with no cachesDropped fails")
    ok(not client_reload_caches_verdict({"cachesDropped": None})[0], "a null cachesDropped fails")
    ok(not client_reload_caches_verdict(None)[0], "no leak block at all fails")

    #-- the effect readouts rope-settle and beam-ring parse -------------------
    m = ROPE_SPANS_RE.search("[SourceSharp] cs_cl_rope_spans: 4 span(s), 956 step(s), "
                             "912 strip(s) drawn, 4 update(s)")
    ok(m and m.groups() == ("4", "956", "912"), "the rope tally parses: spans, steps, strips")
    m = ROPE_ROW_RE.search("  [0] #78 5 nodes hung  start (-4037.0 2929.0 254.6) end (-3601.0 2816.0 "
                           "254.6)  e0 0.00 e1 0.00  chord 450.41  sag 143.19  owner 0.00  thinks 239 draws 235")
    ok(m and m.group(2) == "hung" and m.group(3) == "143.19", "a hung span's row parses, sag included")
    m = BEAMS_RE.search("[SourceSharp] cs_cl_beams: 2 active, 7 created, 1 refused, 300 update(s), "
                        "40 draw(s), 12 strip(s), 28 mesh(es)")
    ok(m and m.groups() == ("2", "7", "1", "300", "40", "12", "28"), "the beam tally parses, meshes last")
    ok(not BEAMS_RE.search("[SourceSharp] cs_cl_beams: 2 active"), "a truncated beam tally does not parse")

    #-- rope_bookings / lost_recurring_bookings ------------------------------
    th = {"total": 7, "booked.keyframe_rope": 2, "booked.move_rope": 1,
          "booked.point_spotlight": 4, "due1.keyframe_rope": 2,
          "due1.move_rope": 1, "due1.point_spotlight": 4}
    ok(rope_bookings(th) == {"booked.keyframe_rope": 2, "booked.move_rope": 1},
       "rope_bookings picks the rope's bookings out of a think read")
    ok(rope_bookings(None) == {}, "no counters answer no rope bookings")
    ok(lost_recurring_bookings(th, th, th) == [],
       "an after-read holding every recurring class reads nothing lost")
    gone = {k: v for k, v in th.items() if "rope" not in k}
    ok(lost_recurring_bookings(th, th, gone)
       == ["keyframe_rope 2->0", "move_rope 1->0"],
       "a recurring class the after-read lost is named with its counts")
    ok(lost_recurring_bookings(th, th, {**th, "booked.keyframe_rope": 1})
       == ["keyframe_rope 2->1"], "a recurring class one booking short is named")
    # A class with nothing due within a second of BOTH reads may have run its
    # one-shot in between: the total's subtraction governs it, not this.
    first_wo = {k: v for k, v in th.items() if k != "due1.move_rope"}
    ok(lost_recurring_bookings(first_wo, th, gone) == ["keyframe_rope 2->0"],
       "a class not due-within-1s in the FIRST read is a one-shot, not named")
    ok(lost_recurring_bookings(None, None, None) == [],

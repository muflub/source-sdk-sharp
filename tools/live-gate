    def _fake_launch(monkey, log_path):
        """Swap Game.launch for the duration of one fact. A closure rather than
        a stub class: the retry is about how many times launch is CALLED and
        with what, which a fake that records its ports answers directly."""
        original = Game.launch
        Game.launch = staticmethod(monkey)
        try:
            return launch_with_free_port(lambda port: ["-port", str(port)],
                                         log_path, os.path.join(scratch, "t"))
        finally:
            Game.launch = original


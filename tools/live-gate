def step_join(g):
    """1. join -- the map is up and a player is in it."""
    # The map's own physics props, by handle, as the level placed them: what
    # clear_debris never touches.
    g.state["map_props"] = {e["handle"] for klass in PROP_CLASSES_ALL for e in g.api.ents(klass)}
    entities, classes = g.api.census()
    g.say("    %d entities / %d classes" % (entities, classes))
    g.check(entities == g.scen["entities"],
            "entities = %d (expected %d)" % (entities, g.scen["entities"]))
    g.check(classes == g.scen["classes"],
            "classes = %d (expected %d)" % (classes, g.scen["classes"]))

    player = g.api.wait_for(lambda: g.api.player(g.scen["playerClass"]), 60.0)
    if not player:
        # Not a skip. A gate whose subject never joined has failed, and the
        # fifteen steps behind this one are about a player that does not exist.
        g.check(False, "no %s ever appeared -- the local client never joined"
                % g.scen["playerClass"])
        return

    fields = g.api.fields(player["index"])
    g.check(player["health"] > 0, "the player joined alive (health %d)" % player["health"])
    g.check(fields.get("Alive") == "true", "the player's networked Alive is true")
    g.check(player["origin"] != [0.0, 0.0, 0.0],
            "the player stands at a spawn point %s" % (player["origin"],))
    g.cheats()

    join_playerinfo(g)
    join_motd(g, player["index"])


def join_motd(g, slot):
    """The joined client was shown the message of the day (VGUIMenu "info",
    stock's FinishClientPutInServer, lane player-msgs) and dismisses it, as a
    player does: the server hides the panel (cs_sv_showpanel <slot> info 0,
    a cheat) so the steps after this one read the HUD, not the MOTD."""
    opened = g.api.wait_for(lambda: (lambda m: m if m.get("menuInput") else None)(ui_menu(g, slot)), 15.0)
    g.check(bool(opened), "the joined client was shown the message of the day (open %s)"
            % ((opened or {}).get("open"),))
    g.cheats()
    g.api.cmd("cs_sv_showpanel %d info 0" % slot)
    closed = g.api.wait_for(lambda: (lambda m: m if not m.get("menuInput") else None)(ui_menu(g, slot)), 10.0)
    g.check(bool(closed), "and dismissing it gave the mouse back")


def join_playerinfo(g):
    """step 3c's two native readouts, taken while a player is standing.

    Part of `join` rather than a step of its own because both readouts are ABOUT
    a joined player and neither needs anything else to have happened: the
    engine has been calling GetPlayerState every tick since the signon, and the
    plugin-facing view answers or it does not.

    NEITHER READOUT HAS A DEV API SURFACE. They are Msg() from native code, and
    the memory of this project is explicit that native output lands in
    console.log and never in the debug-api log -- so an attached run, which
    captured no log of its own, cannot read either and says so instead of
    passing.
    """
    if not DEBUG_COMMANDS:
        # The readout is a debug-only console command (ss_boundary_probe_*).
        # The join itself is still the step's verdict.
        g.say("    note  %s build: the boundary-probe readout is a debug-only "
              "command; not checked here" % CONFIG)
        return
    if not g.own_log:
        g.note("attached, so this process captured no log: step 3c's "
               "GetPlayerState and IPlayerInfo readouts cannot be read")
        return

    # ZEROED FIRST, so the number below is calls made in a KNOWN window with a
    # player standing. Without the reset it would include the whole signon and
    # would be non-zero on a build where the arm never fired again.
    # THE REPORT'S LAST ROW, not its header. The game's stdout reaches this log
    # through a pipe that is not flushed per line, and the report is 40-odd
    # lines long: the first cut of this step slept 0.6s and read nothing, and
    # the second waited for the HEADER and read a report whose rows had not
    # arrived yet. GetMaxEntities is the last id in BoundaryProbeId_t, so a log
    # that has it has the whole table.
    #
    # A NEW one, counted: the gate runs its steps twice in one process, so pass
    # 1's report is already in the log when pass 2 asks.
    tail_rows = g.count_console("IClientEntityList::GetMaxEntities")
    g.api.cmd("ss_boundary_probe_reset")
    g.ticks(1.5)
    g.api.cmd("ss_boundary_probe_report")

    if not g.api.wait_for(
            lambda: g.count_console("IClientEntityList::GetMaxEntities") > tail_rows, 60.0):
        g.check(False, "the boundary probe report never reached console.log")
        return

    block = probe_calls(g, "GetPlayerState -> the player's engine block")
    sdk   = probe_calls(g, "GetPlayerState -> SDK arm")

    if block is None or sdk is None:
        g.check(False, "the boundary probe printed no GetPlayerState rows "
                       "(block=%s sdk=%s)" % (block, sdk))
        return

    # THE STEP'S OWN GATE, and 0e's probe is what shows it: every player state
    # the engine read in that window came out of the player's engine block.
    g.check(block > 0,
            "GetPlayerState answered out of the player's engine block %d times "
            "in a 1.5s window" % block)
    g.check(sdk == 0,
            "the SDK arm answered none of them (%d) -- it is deleted, and this "
            "row is the one that would show it coming back" % sdk)

    # THE PLUGIN-STYLE QUERY WENT WITH THE PLUGIN ABI (plan_server_native_min
    # P1, Decision 1): cs_sv_playerinfo asked PlayerInfoManager002 by name, and
    # server.so exposes neither the interface nor the command now. Its
    # "         origin x y z" console line (shell_playerinfo_debug.cpp, deleted
    # at 393cb1bdb) went with it, and this row read that line: from that
    # commit the row found no line and failed on every pass (62's lane,
    # 33 of 33 at 71d2be26d). The position is read from the dev API instead:
    # /entity for the local player, which answers out of the same engine block
    # the probe above counted. A missing player, or a player standing at the
    # world origin, is the failure this row exists for.

    player = g.api.player()
    origin = player.get("origin") if player else None
    g.check(origin is not None and any(abs(float(c)) > 0.5 for c in origin),
            "and the player's position out of the block is the player's, not "
            "the world origin (%s)" % (origin if origin is not None else "no ss_player"))

    # `status`, WHICH IS THE THIRD READOUT plan_entity.md's 3c gate NAMES and
    # the only one that goes through the ENGINE rather than through this DLL's
    # own command. Everything above asks the game a question the game answers;
    # `status` is the engine walking its own client list and printing it, and
    # the family of engine listings that walk it read GetPlayerState
    # (the one an rcon `status` reaches does). A server that had started
    # answering nothing about its players would pass every check above.
    #
    # TWO HALVES, and they fail for different reasons:
    #
    #   * `players : N humans` is the ENGINE's line. N >= 1 says the joined
    #     player is in the list the engine walks.
    #   * `sourcesharp : map ...` is OURS, printed from
    #     IServerGameDLL::Status -> ServerGameDll.StatusLines. The engine calls
    #     it only on a game DLL interface version >= 10, so its absence is a
    #     real finding and not a formatting one.
    players_before = g.count_console("players :")
    ours_before = g.count_console("sourcesharp : map")
    g.api.cmd("status")

    if not g.api.wait_for(
            lambda: g.count_console("players :") > players_before, 60.0):
        g.check(False, "`status` printed no players line at all")
        return

    listed = g.last_console_line("players :")
    counted = re.search(r"players\s*:\s*(\d+)", listed or "")
    g.check(counted is not None and int(counted.group(1)) >= 1,
            "`status` lists the joined player (%s)"
            % (listed.strip() if listed else "no readout line"))

    # NOT wait_for: the engine prints its own lines and the game DLL's in ONE
    # call, so the line above having arrived means this one has too or is not
    # coming. A wait here would turn "the DLL said nothing" into a 60s stall.
    g.check(g.count_console("sourcesharp : map") > ours_before,
            "and the game DLL answered IServerGameDLL::Status inside it, which "
            "is the half that crosses into managed code")


def step_move(g):
    """2. move -- a usercmd moves the player through the movement code."""
    g.cheats()
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)
    before = g.player_origin()

    # THE DELTA ACROSS THE HOLD, not the total for the stage. The teleport
    # above drops the player a few units and a landing clips a velocity, so a
    # total would be satisfied by the settle and nobody would have walked
    # anywhere. See WALKING_OPS for what these two are and how they were
    # picked.
    walk_ops_before = ops_total(g.api, WALKING_OPS)

    # SAMPLED DURING THE HOLD, not only at its ends. This is the half of the
    # step that is ZERO for a standing player: the old needle got that from two
    # leaf crossings, and step 3e made every leaf crossing unreachable by moving
    # the whole loop into C#. A mid-hold displacement cannot be satisfied by a
    # settle, by a fall, or by a player who was already somewhere else.
    g.api.cmd("+forward")
    mid_hold_a = g.player_origin()
    g.ticks(0.75)
    mid_hold_b = g.player_origin()
    g.ticks(0.75)
    g.api.cmd("-forward")
    g.ticks(0.4)

    mid_hold = distance(mid_hold_a, mid_hold_b) if (mid_hold_a and mid_hold_b) else 0.0
    walk_ops = ops_total(g.api, WALKING_OPS) - walk_ops_before
    after = g.player_origin()

    moved = distance(before, after)
    g.say("    %s -> %s" % (before, after))
    g.check(moved > 64.0, "walking forward moved the player %.1f units" % moved)

    # THE OTHER HALF OF THE TITLE'S CLAIM. `moved` says the player is somewhere
    # else; this says the MANAGED MOVEMENT CODE is what put them there. Step 3
    # has proved its own claim this way since it was written
    # (ServerOnPlayerJump); step 2 asserted it in its title only.
    g.check(mid_hold > 8.0,
            "and they were STILL moving in the middle of the hold (%.1f units "
            "between two samples 0.75s apart) -- which is zero for a player who "
            "settled, fell, or was teleported" % mid_hold)

    g.check(walk_ops > 0,
            "and the managed movement loop is what ran those commands: %s "
            "crossed %d time(s) during the walk. ONE crossing per command since "
            "step 3e, so this says the loop ran and not that it walked; the "
            "sample above says it walked" % ("+".join(WALKING_OPS), walk_ops))

    # AND THE SAME MOVE OFF THE WIRE. This was `"Origin" in fields`, which is a
    # membership test on the payload schema: true whether the player moved or
    # not, true whether the networked value tracks the server's origin or is
    # stuck at the spawn, and true on a build with no movement code at all. It
    # printed the message below and could not fail. Now it reads the DECODED
    # networked vector and asks the same question of it that `moved` asks of
    # the server's copy -- against `before`, so it needs no tolerance for the
    # frame between the two reads.
    fields = g.api.fields(g.api.player(g.scen["playerClass"])["index"])
    networked = numbers_in(fields.get("Origin", ""))
    g.check(len(networked) == 3,
            "the origin is a networked field, not only a getter (payload says %r)"
            % fields.get("Origin"))
    if len(networked) == 3:
        g.check(distance(networked, before) > 64.0,
                "and the WIRE carries the moved one: the networked origin is "
                "%.1f units from where the walk started, %.1f from the "
                "server's copy of it"
                % (distance(networked, before), distance(networked, after)))


def step_jump(g):
    """3. jump -- and the jump crosses into managed code once."""
    g.cheats()
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)
    start = g.player_origin()[2]

    # The counter, not the height, is the primary evidence: ServerOnPlayerJump
    # is the managed hook the movement code calls, so a jump that raises the
    # player without entering it is a jump the port is no longer running.
    g.api.cmd("+jump")
    peak = start
    for _ in range(12):
        g.ticks(0.15)
        here = g.player_origin()
        if here:
            peak = max(peak, here[2])
    g.api.cmd("-jump")
    g.ticks(0.5)

    # THE JUMP DECISION IS NO LONGER A CROSSING, and that is step 3e rather
    # than a regression: CheckJumpButton asks it from inside the movement loop,
    # the loop is in C#, so the question and the answer are both managed and
    # nothing crosses. ServerOnPlayerJump is ZERO on a working port.
    #
    # What is read instead is the loop's own crossing -- the commands the jump
    # was made of ran in C# -- plus the height, which is the thing the step is
    # named after. The stronger claim, that the managed jump predicts exactly as
    # the stock one did, is tools/movemath-gate's and is made bit-for-bit there.
    jumps = ops_total(g.api, WALKING_OPS)
    g.check(jumps >= 1,
            "the managed movement loop ran the jump's commands (%s crossed %d "
            "time(s))" % ("+".join(WALKING_OPS), jumps))
    g.check(peak - start > 8.0, "the player left the ground (peak +%.1f)" % (peak - start))


def step_take_damage(g):
    """5. take damage -- through the damage path, which needs no cheats."""
    player = g.api.player(g.scen["playerClass"])
    reply = g.api.get("hurtclass", g.scen["playerClass"], 40)
    hit = reply.get("hit", [{}])[0]

    before = hit.get("healthBefore")
    after = hit.get("healthAfter")
    g.say("    health %s -> %s" % (before, after))
    g.check(before is not None and after is not None and before - after == 40,
            "40 damage took exactly 40 health (%s -> %s)" % (before, after))

    # Read back off the entity too. The reply is what the damage call returned;
    # this is what the server now holds, and a damage path that answers
    # correctly and stores nothing would pass on the reply alone.
    live = g.api.player(g.scen["playerClass"])
    g.check(live is not None and live["health"] == after,
            "the entity now reads %s" % (live["health"] if live else "gone"))
    g.check(live is not None and live["index"] == player["index"],
            "and it is the same player, not a replacement")


def step_pickup(g):
    """6. pick up health and ammo."""
    g.cheats()
    scen = g.scen

    #-- health ---------------------------------------------------------------
    player = g.api.player(scen["playerClass"])
    hurt = player["health"]
    if hurt >= 100:
        g.check(False, "the player is at %d health, so a healthkit has nothing "
                       "to give -- the damage step is supposed to run first" % hurt)
        return

    kits = g.api.ents(scen["healthItemClass"])
    if not kits:
        g.skip("this map has no %s to walk onto" % scen["healthItemClass"])

    nearest = min(kits, key=lambda e: distance(e["origin"], player["origin"]))
    g.teleport(nearest["origin"], settle=0.0)
    healed = g.api.wait_for(
        lambda: (lambda p: p and p["health"] > hurt)(g.api.player(scen["playerClass"])),
        10.0)
    now = g.api.player(scen["playerClass"])["health"]
    # "teleported onto", not "walked onto". The player is SET on top of the
    # item; what this exercises is the touch and the pickup, and nothing of the
    # movement code -- which is step 2's subject and is checked there.
    g.check(bool(healed), "teleported onto %s healed %d -> %d"
            % (scen["healthItemClass"], hurt, now))

    #-- ammo -----------------------------------------------------------------
    # Reserve only reports the pool of the ACTIVE weapon's ammo type, so the
    # gun has to be given AND selected before the number means anything.
    g.api.cmd("give %s" % scen["ammoWeapon"])
    g.ticks(0.6)
    g.api.cmd("use %s" % scen["ammoWeapon"])
    g.ticks(0.6)

    weapons = g.api.ents(scen["weaponClass"])
    if not weapons:
        g.skip("no %s entity exists, so there is no Reserve to read"
               % scen["weaponClass"])
    weapon = weapons[0]["index"]
    before = int(g.api.fields(weapon).get("Reserve", "-1"))

    boxes = g.api.ents(scen["ammoItemClass"])
    if not boxes:
        g.skip("this map has no %s to walk onto" % scen["ammoItemClass"])

    player = g.api.player(scen["playerClass"])
    box = min(boxes, key=lambda e: distance(e["origin"], player["origin"]))
    g.teleport(box["origin"], settle=0.0)
    took = g.api.wait_for(
        lambda: int(g.api.fields(weapon).get("Reserve", "-1")) > before, 10.0)
    after = int(g.api.fields(weapon).get("Reserve", "-1"))
    g.check(bool(took), "teleported onto %s took the pool %d -> %d"
            % (scen["ammoItemClass"], before, after))


# The crate's height (wood_crate001a: its origin rests about 28 above its base).
CRATE_HEIGHT = 56.0

# Where a crate is made above the surface it is aimed at: ent_create's drop
# point (DevCommandsLive.cs EntCreateCommand: stock's twelve units of air under
# the crate's base). MEASURED against ent_create, not derived from the model:
# aimed at the same wall from the same spot, ent_create's crate hung at z
# 245.6-245.8 and one made 40 above the aim point at 253.3, close enough under
# the yard's roof (about z 288) to catch it when released -- prop-hurts-player
# then missed the player 9 rounds in 10. 32 puts it where ent_create did.
PROP_DROP_LIFT = 32.0


PROP_CLASSES_ALL = ("prop_physics", "prop_physics_multiplayer", "prop_physics_respawnable")


def clear_debris(g, center, radius, spare=()):
    """Remove every physics prop within `radius` of `center` (horizontally)
    that the map did not place -- earlier steps' crates and the gibs they broke
    into -- and answer once they are gone. Returns how many.

    A crate dropped onto gibs lands on them: impact-damage's crate came to
    rest unhurt on five gibs an earlier step left on its landing spot (a
    gate-prefix round, 2026-10-05) and the step failed. The map's own props
    (Gate.state["map_props"], taken at join) are left where they are, and so
    is every entity index in `spare` (a step's own prop)."""
    keep = g.state.get("map_props")
    if keep is None:
        return 0
    gone = 0
    for klass in PROP_CLASSES_ALL:
        for e in g.api.ents(klass):
            if e["handle"] in keep or e["index"] in spare:
                continue
            if math.hypot(e["origin"][0] - center[0], e["origin"][1] - center[1]) <= radius:
                g.api.remove(handle=e["handle"])
                gone += 1
    if gone:
        g.say("    cleared %d prop(s) earlier steps left within %.0f of %s"
              % (gone, radius, [round(v) for v in center[:2]]))
    return gone


# THE PLAYER'S SPOT in prop-hurts-player: the step checks a square of this
# half-width around it for props earlier steps left, and clears a circle that
# covers the whole square first (its corner is at hypot(48, 48) = 67.9).
PLAYER_SPOT_HALF = 48.0
PLAYER_SPOT_CLEAR = 70.0


def clear_player_spot(g, spot, crate):
    """clear_debris over the square prop-hurts-player checks around `spot`,
    sparing the step's own crate (entity index `crate`), which hangs about 45
    units away and inside the circle.

    Its own clearing is around the AIM POINT (the wall the crate is made on),
    and the player stands about 290 units from it. A gib of the previous
    pass's impact-damage crate lay at the player's spot, outside that circle,
    in pass 2 of a 3-pass gate at 72abbb1a2 (prop 401): the check below named
    it, and the crate never reached the player (health 100 -> None) -- the
    one-pass-in-nine failure of 2026-10-18, which a join,prop-hurts-player
    subset never shows because no impact-damage runs between its passes."""
    return clear_debris(g, spot, PLAYER_SPOT_CLEAR, spare=(crate,))


def aim_point(g):
    """Where the player is looking: the trace's end, or None for no hit."""
    aim = g.api.get("aim")
    return aim.get("aim") if aim.get("hit") else None


def facing_away(g):
    """ent_create's angles for what it makes: level, turned to face away from
    the player (EntCreateCommand's FacingAwayFrom, eye yaw + 180), from the
    player's position and the aim point, so a crate made here starts turned
    the way ent_create's did."""
    aim = g.api.get("aim")
    eye, at = aim.get("eye"), aim.get("aim")
    if not eye or not at:
        return (0.0, 0.0, 0.0)
    return (0.0, math.degrees(math.atan2(at[1] - eye[1], at[0] - eye[0])) + 180.0, 0.0)


def place_prop(g, name, origin, angles=(0, 0, 0), keyvalues=None):
    """One prop_physics made at an EXACT origin and angles through
    /entities/spawn; (index, handle, origin read back) or (None, None, None).

    The reply names the index and the HANDLE, so nothing lists every
    prop_physics before and after to find the new one -- which is what every
    ent_create in this file did, polling a 100-prop listing until a new index
    showed up."""
    kv = {"model": g.scen["propModel"]}
    kv.update({k: str(v) for k, v in (keyvalues or {}).items()})
    made = g.api.place([{"classname": "prop_physics", "targetname": name,
                         "origin": list(origin), "angles": list(angles), "keyvalues": kv}])
    made = [e for e in made if e.get("created")]
    if not made:
        return (None, None, None)
    return (made[0]["index"], made[0]["handle"], made[0].get("origin"))


def spawn_prop(g, settle=3.0, name=PROP_NAME, keyvalues=None):
    """Put one named physics prop where the player looks, and let it land.

    A prop of OUR OWN rather than one of the map's hundred, and named rather
    than found by index: the map's props have been standing since level init,
    they are what the census counts, and breaking one would make the reload
    comparison two steps later a comparison against a map this gate had edited.

    WHERE THE PLAYER LOOKS, BUT AT AN EXACT POINT: the aim trace's end lifted
    by ent_create's drop (PROP_DROP_LIFT), made there by /entities/spawn. The
    player was put and pointed by an exact teleport, so the point is the same
    every round; ent_create re-aimed from whatever view the client had sent
    last.

    Returns (index, resting origin, how far it fell). The fall is the push
    step's control: a prop that does not fall is a physics system that is not
    running, which is a different and much larger failure than the one that
    step reports.
    """
    kill_prop(g, name)
    aim = aim_point(g)
    if aim is None:
        return (None, None, 0.0)
    index, _handle, made_at = place_prop(g, name, (aim[0], aim[1], aim[2] + PROP_DROP_LIFT),
                                         facing_away(g), keyvalues=keyvalues)
    if index is None:
        return (None, None, 0.0)
    return wait_settled(g, index, made_at, settle)


def wait_settled(g, index, made_at, settle=3.0):
    """(index, resting origin, how far it fell) once the prop stops moving.

    Settled, not slept on: a prop still falling would read as "it moved" in
    the step that follows, which is the one thing these steps must not be able
    to mistake for a push. /wait?settled= is the game's own reading: speed
    under 1 u/s for ten consecutive ticks, or its physics object asleep. It
    replaces two 0.5 s position samples less than 0.05 apart."""
    budget = int((settle + 6.0) / TICK_SECONDS)
    reply = g.api.wait({"settled": 1, "index": index, "eps": 1, "for": 10}, budget)
    origin = prop_origin(g, index)
    if origin is None:
        return (index, None, 0.0)
    if reply.get("status") != "met":
        g.say("    (prop %s had not settled after %s tick(s): %s)"
              % (index, reply.get("waitedTicks"), reply.get("value")))
    return (index, origin, distance(made_at, origin) if made_at else 0.0)


def prop_origin(g, index):
    """One entity's origin by index (/entity), or None when nothing is there."""
    e = g.api.entity(index=index)
    return e["origin"] if e else None


def kill_prop(g, name=PROP_NAME):
    """Remove the gate's own prop, if one is standing. Idempotent. Answered
    once it is GONE (/entities/remove waits for the frame that frees it),
    not 0.4 s after a Kill nobody watched land."""
    g.api.remove(name=name)


def touching_of(g, index):
    """The entity indices `index` is linked to in the managed touch directory."""
    return g.api.get("touching", index).get("touching", [])


def physics_prop_origins(g):
    """Every physics prop's origin, of the three classes the map places."""
    return [e["origin"] for klass in ("prop_physics", "prop_physics_multiplayer",
                                      "prop_physics_respawnable")
            for e in g.api.ents(klass)]


def blast_side_spot(blast, props, distance=96.0, clear=72.0):
    """Where to stand `distance` units from a blast with it on the left, and
    the yaw to face: the first of +X, -X, +Y and -Y whose spot has no prop
    within `clear` units across, or None.

    A player facing yaw has their left along (-sin, cos), so the spot is the
    blast less that. +X first is the old fixed choice, (bx, by - 96)."""
    for yaw in (0.0, 180.0, 90.0, 270.0):
        r = math.radians(yaw)
        x = blast[0] + math.sin(r) * distance
        y = blast[1] - math.cos(r) * distance
        if all(math.hypot(p[0] - x, p[1] - y) > clear for p in props):
            return (round(x, 3), round(y, 3)), yaw
    return None


def blast_floor_spot(floor, props, clear=72.0):
    """Where on the floor around `floor` to make the blast: the nearest point
    of a 64-unit grid out to 192 with no prop within `clear` units across and
    a clear side (blast_side_spot) to stand at, or None. dm_lockdown's
    openFloor has props on all four sides of it at 96 units."""
    steps = (0.0, 64.0, -64.0, 128.0, -128.0, 192.0, -192.0)
    grid = sorted(((dx, dy) for dx in steps for dy in steps), key=lambda d: (math.hypot(*d), d))
    for dx, dy in grid:
        x, y = floor[0] + dx, floor[1] + dy
        if all(math.hypot(p[0] - x, p[1] - y) > clear for p in props) \
                and blast_side_spot((x, y), props, clear=clear) is not None:
            return [x, y, floor[2]]
    return None


def contact_spots(g):
    """Points on the player's line ahead of openFloor, away from every prop.

    Along the facing, at the distances the aim point lies around, and to
    either side; each lifted by ent_create's drop above the player's own floor.
    A point with any prop within 72 units across is not offered."""
    here = g.player_origin()
    if here is None:
        return []
    yaw = math.radians(g.scen["openFloorAngles"][1])
    fx, fy = math.cos(yaw), math.sin(yaw)
    props = physics_prop_origins(g)
    spots = []
    # A grid, nearest the line first: on a busy floor only one point of the
    # old nine was clear, and the crate made there rested tilted (a SETUP skip).
    for ahead in (96.0, 144.0, 192.0, 240.0, 288.0):
        for side in (0.0, 48.0, -48.0, 96.0, -96.0, 144.0, -144.0):
            x = here[0] + fx * ahead - fy * side
            y = here[1] + fy * ahead + fx * side
            if all(math.hypot(p[0] - x, p[1] - y) > 72.0 for p in props):
                spots.append((x, y, here[2] + PROP_DROP_LIFT))
    return spots[:8]


def segment_distance(p, a, b):
    """Horizontal distance from point p to the segment a-b."""
    ax, ay, bx, by = a[0], a[1], b[0], b[1]
    dx, dy = bx - ax, by - ay
    length = dx * dx + dy * dy
    t = 0.0 if length == 0 else max(0.0, min(1.0, ((p[0] - ax) * dx + (p[1] - ay) * dy) / length))
    return math.hypot(p[0] - (ax + t * dx), p[1] - (ay + t * dy))


def rests_alone(g, index):
    """Is the prop touching nothing but the world, and level?"""
    others = [i for i in touching_of(g, index) if i != 0]
    e = g.api.entity(index=index)
    if e is None:
        return False
    pitch, _yaw, roll = e["angles"]
    level = lambda a: min(abs(a) % 360.0, 360.0 - abs(a) % 360.0) <= 2.0
    return not others and level(pitch) and level(roll)


def step_contact_touch(g):
    """Two physics props in contact are touching each other.

    Stock: CCollisionEvent::StartTouch buffers the contact and
    PhysicsMarkEntitiesAsTouchingEventDriven (physics_main_shared.cpp:1060)
    links BOTH entities to each other, so each gets StartTouch/Touch and later
    EndTouch, exactly as an AABB overlap would. Ours recorded the contact into
    the event ring and then dropped it on the dead pBase arm, so two managed
    props resting on each other never touched (physics stock parity, case E1).

    The pair is named, not counted: crate B is dropped onto crate A and each
    one's touch links must name the other. A control first: B came to rest ON
    A, so the two really are in contact.
    """
    g.cheats()
    a_name, b_name = CONTACT_NAMES
    kill_prop(g, b_name)
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)

    # A ON CLEAR FLOOR, EXACTLY, AND CHECKED. Made at the aim point it came to
    # rest against the map's own crates #61 and #65 in all 20 rounds the verify
    # lane measured, raised and tilted, and B slid off that top in 2 of them --
    # a setup failure the step reported as "B touches []"
    # (docs/plans/gate_flakes_findings.md section 3). So A is made at the first
    # of a few points along the player's line, away from every prop standing
    # there, and kept only if it comes to rest touching nothing but the world
    # and level (pitch and roll within 2 degrees). Bounded: a run that never
    # finds clear floor SKIPS with the setup named, never fails as touch.
    # And the floor ahead cleared of what earlier steps left on it, so the
    # spots are not ruled out by gibs (a SETUP skip in 1 of 10 prefix rounds).
    here = g.player_origin()
    if here is not None:
        clear_debris(g, here, 300.0)
    a = a_rest = None
    for spot in contact_spots(g):
        kill_prop(g, a_name)
        a, _handle, made_at = place_prop(g, a_name, spot)
        if a is None:
            continue
        a, a_rest, _ = wait_settled(g, a, made_at)
        if a_rest is not None and rests_alone(g, a):
            break
        g.say("    A at %s is not alone and level (touching %s): another spot"
              % (a_rest, touching_of(g, a)))
        a_rest = None
    if a is None or a_rest is None:
        kill_prop(g, a_name)
        g.skip("SETUP: no spot near openFloor where crate A rests alone and level")

    # B made EXACTLY above A's resting origin, with a crate's height and
    # stock's twelve units of air between them, by /entities/spawn. It used to
    # be ent_create with the player stood 160 units above A looking down and
    # moved away again -- an aim, a setpos and a race with the player landing
    # on the pair.
    #
    # ONE RE-DROP, reported. Straight after a map load the props around the
    # point are still settling, and B can bounce off A (measured: round 1 of a
    # bisect run with this step first, 3 of 3 runs, never later rounds or the
    # full gate). B landing on A is this step's precondition, not its subject.
    def drop_b(rest_a):
        kill_prop(g, b_name)
        index, _handle, made_at = place_prop(
            g, b_name, (rest_a[0], rest_a[1], rest_a[2] + CRATE_HEIGHT + 12.0))
        if index is None:
            return None, None
        index, rest, _ = wait_settled(g, index, made_at)
        return index, rest

    def on_a(rest_b, rest_a):
        return (rest_b is not None and rest_a is not None and rest_b[2] > rest_a[2] + 8.0
                and math.hypot(rest_b[0] - rest_a[0], rest_b[1] - rest_a[1]) < 48.0)

    b, b_rest = drop_b(a_rest)
    if b is None:
        g.skip("/entities/spawn made no second crate")
    a_now = prop_origin(g, a)
    if not on_a(b_rest, a_now):
        g.say("    B came to rest at %s, off A at %s: dropping it again" % (b_rest, a_now))
        b, b_rest = drop_b(a_now)
        a_now = prop_origin(g, a)

    # THE PRECONDITION, as a precondition: B not on A after the re-drop is a
    # setup that did not hold, and the touch check below would only report it
    # again as "B touches []". Named and skipped, not counted as touch.
    if not on_a(b_rest, a_now):
        kill_prop(g, a_name)
        kill_prop(g, b_name)
        g.skip("SETUP: the second crate did not stay on the first after a re-drop "
               "(A at %s, B at %s)" % (a_now, b_rest))
    g.check(True, "the second crate came to rest on the first (A at %s, B at %s)"
            % (a_now, b_rest))

    linked = g.api.wait_for(
        lambda: (b in touching_of(g, a) and a in touching_of(g, b)) or None, 5.0)
    names = {e["index"]: e["classname"] for e in g.api.ents("*")}
    for who, idx in (("A", a), ("B", b)):
        g.say("    %s(%d) touches %s" % (who, idx, ", ".join(
            "%s#%d" % (names.get(i, "?"), i) for i in touching_of(g, idx)) or "nothing"))
    g.check(bool(linked),
            "two crates in contact touch each other: A(%d) touches %s, B(%d) touches %s"
            % (a, touching_of(g, a), b, touching_of(g, b)))

    kill_prop(g, a_name)
    kill_prop(g, b_name)


def step_start_asleep(g):
    """A start-asleep prop fires OnAwakened once, the first time it wakes.

    Stock: CPhysicsProp::CreateVPhysics creates a SF_PHYSPROP_START_ASLEEP
    prop's object asleep (props.cpp:2547); the first VPhysicsUpdate with it
    awake fires OnAwakened and drops the flag (props.cpp:2917), so it never
    fires again. Physics stock parity B4.

    ent_create teleports what it makes clear of the surface, as stock's
    CC_Ent_Create does, and a teleport wakes the object: so the crate wakes as
    it is made, and that is the first wake. A second wake must not fire it
    again. "Hangs until woken" needs a map-placed prop with no teleport, which
    is the sandbox map's to carry.
    """
    g.cheats()
    kill_prop(g, ASLEEP_NAME)
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)

    def awakened(since, index):
        # Filtered by the game: this crate's OnAwakened outputs and nothing
        # else, every page of them.
        return g.api.events_all(since, kind="output", index=index, name="OnAwakened*")

    updates_before = physics_counter(g, "updates delivered")
    since = g.api.events_next()
    # /entities/spawn makes it the way ent_create does -- created, then
    # teleported to its point -- so the teleport is still its first wake.
    index, _rest, _fell = spawn_prop(g, name=ASLEEP_NAME, keyvalues={"spawnflags": 1})
    if index is None:
        g.skip("/entities/spawn made nothing")

    # The crate fell, so it was awake for frames, and every awake frame is an
    # OnPhysicsUpdate (stock's VPhysicsUpdate), which OnOutOfWorld rides on.
    updates_after = physics_counter(g, "updates delivered")
    g.check(updates_before is not None and updates_after is not None
            and updates_after > updates_before,
            "the falling crate's awake frames reached OnPhysicsUpdate: updates delivered %s -> %s"
            % (updates_before, updates_after))

    first = awakened(since, index)
    g.check(len(first) == 1,
            "the start-asleep crate fired OnAwakened once when it first woke (%d)" % len(first))

    again = g.api.events_next()
    g.api.fire(ASLEEP_NAME, "Sleep")
    g.ticks(0.5)
    g.api.fire(ASLEEP_NAME, "Wake")
    # A wrongly fired OnAwakened would arrive on the next awake frame; the
    # wait answers at once if it does, and 100 ticks of nothing is the pass.
    g.api.wait({"event": "output", "index": index, "name": "OnAwakened*", "since": again}, 100)
    g.check(len(awakened(again, index)) == 0,
            "a second wake does not fire OnAwakened again (the flag was cleared)")

    kill_prop(g, ASLEEP_NAME)


def penetration_counts(g):
    """(asks, pastGuard): managed's IPhysicsCollisionSolver counters
    (plan_physics_bones_native_zero 2.1; /counters?group=solver, which
    cs_sv_physics_solver prints), or None when the group is not available."""
    counters = g.api.counters("solver")
    if counters is None:
        return None
    return (counters.get("penetrationAsks"), counters.get("penetrationPastGuard"))


def step_penetration(g):
    """Two props made in one place interpenetrate, and the pair reaches stock's
    penetrate rules.

    Stock: CCollisionEvent::ShouldSolvePenetration ledgers every
    interpenetrating pair of entities (FVPHYSICS_PENETRATING on both, a
    three-second give-up that puts a stuck pair to sleep). Ours turned every
    pair away behind the dead pBase arm, so `pastGuard` never left zero
    (physics stock parity H). Two crates created at the same aim point overlap
    by construction. The answers are managed's since 2.1, and so are the
    counters read here: no debug-only command, so release runs it too.
    """
    g.cheats()
    for name in OVERLAP_NAMES:
        kill_prop(g, name)
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)

    before = penetration_counts(g)
    # Both at ONE exact point, so they overlap by construction.
    aim = aim_point(g)
    if aim is None:
        g.skip("the player is looking at nothing to make the crates on")
    for name in OVERLAP_NAMES:
        place_prop(g, name, (aim[0], aim[1], aim[2] + PROP_DROP_LIFT), facing_away(g))
    g.ticks(1.5)
    after = penetration_counts(g)

    g.check(before is not None and after is not None and after[0] > before[0],
            "the overlapping crates were asked about: penetration asks %s -> %s"
            % (before and before[0], after and after[0]))
    g.check(before is not None and after is not None and after[1] > before[1],
            "and the pair reached stock's penetrate rules: past the guard %s -> %s"
            % (before and before[1], after and after[1]))

    # GONE BEFORE THE NEXT STEP, not just told to go: the next step drops its
    # own crate at this same aim point, and two crates still being removed
    # there knocked it aside (measured: contact-touch's control failed in round
    # 1 after this step with the ledger bypassed too, so not the port).
    for name in OVERLAP_NAMES:
        kill_prop(g, name)   # answered once each is gone


def fall_drop_origin(aim, origin, planned_z):
    """Where impact-damage makes its crate: PROP_DROP_LIFT over the aim point,
    at the height the aim WOULD have had from where the step put the player.
    `origin` is /player/aim's "eye", which is the player's ORIGIN
    (Entities.GetOrigin, DebugApiGoldenWorldTests' aim row), not the eye:
    measured, the aim on the level look at the far wall reads it plus 64.

    The player is teleported 120 units up with no settle, so it is falling
    when the aim is read, and the crate made at the aim followed it down: 30
    passes at 6fc08d40e made it at z 189.0 to 214.9, and the three made
    under 199 (189.0, 198.72, 198.72) all landed unhurt, every one over 204
    was hurt (196.49 once) -- too slow a landing for the damage table's first
    step, as stock rules (docs/todo.md, impact-damage). The wall the aim found
    keeps x and y; the fall the player made since the teleport is put back on
    z."""
    if not origin:
        return (aim[0], aim[1], aim[2] + PROP_DROP_LIFT)
    return (aim[0], aim[1], aim[2] + (planned_z - origin[2]) + PROP_DROP_LIFT)


def step_impact_damage(g):
    """A crate dropped from height is hurt by landing.

    Stock: CPhysicsProp::VPhysicsCollision takes CalculateDefaultPhysicsDamage
    (physics_impact_damage.cpp) with static damage allowed, so a breakable prop
    that hits the floor hard enough loses health, and may break. Ours had no
    per-entity collision dispatch and no impact damage (physics stock parity
    C6). The player is put 120 units above the open floor looking level
    along +Y, so ent_create makes the crate on the yard's far wall at that
    height and the fall to the floor is the impact; the prop's OnHealthChanged
    or OnBreak says it was hurt.

    Not straight up: the yard has a roof at about z 288, and ent_create put the
    crate ON it, at rest (measured: still at z 292 four seconds later). A crate
    that lands from the ceiling's height loses about 108 in/s, under the npc
    table's first step of 150, and stock rightly does no damage for that.

    physdamagescale 1, as dm_lockdown's own crates carry: without it the scale
    is stock's 0.1 (CPhysicsProp::Spawn), and this fall (measured: 437 -> 293,
    then 284 -> 70 in/s) is a tenth of the first step's energy, so stock does no
    damage either. At 1 the second landing alone clears the first step.
    """
    g.cheats()
    kill_prop(g, FALL_NAME)
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)
    drop_lift = 120.0

    def hurt(since, index):
        seen = g.api.events_all(since, kind="output", index=index)
        return [e for e in seen
                if str(e.get("name", "")).startswith(("OnHealthChanged", "OnBreak"))]

    sounds_before = physics_counter(g, "impact sounds")
    floor = g.scen["openFloor"]
    g.teleport((floor[0], floor[1], floor[2] + drop_lift), (0, 90, 0), settle=0.0)
    # The landing spot clear of what earlier steps left there (clear_debris),
    # and then the player put back up: the clearing takes ticks, and the
    # player falls while it runs, which lowered the crate 30 units.
    aim = aim_point(g)
    if aim is not None and clear_debris(g, aim, 160.0):
        g.teleport((floor[0], floor[1], floor[2] + drop_lift), (0, 90, 0), settle=0.0)
    since = g.api.events_next()
    # Where ent_create would have made it -- the aim point on the far wall,
    # lifted -- but at that exact point, read back by the reply, and at the
    # height the teleport put the player (fall_drop_origin).
    looked = g.api.get("aim")
    aim = looked.get("aim") if looked.get("hit") else None
    if aim is None:
        g.skip("the player is looking at nothing to make the crate on")
    drop_at = fall_drop_origin(aim, looked.get("eye"), floor[2] + drop_lift)
    index, _handle, made_at = place_prop(g, FALL_NAME, drop_at,
                                         facing_away(g), keyvalues={"physdamagescale": 0.5})
    if index is None:
        g.skip("/entities/spawn made nothing")
    g.say("    the crate was made at %s (the player at %s, the aim at %s)"
          % (made_at, looked.get("eye"), aim))
    g.check(made_at[2] > floor[2] + drop_lift / 2,
            "the crate was made high enough to fall: z %.1f" % made_at[2])

    # OnHealthChanged, answered on the tick it fires (a break fires it first);
    # then both kinds read, filtered by the game.
    reply = g.api.wait({"event": "output", "index": index, "name": "OnHealthChanged*", "since": since},
                       int(8.0 / TICK_SECONDS))
    g.ticks(3.0)
    # READ AFTER THE SETTLE, not when the wait returned: a gate run at load 57
    # had the wait end before the outputs arrived, and the read three
    # seconds later found OnHealthChanged and OnBreak -- the old gate carried
    # the same race on a wall clock.
    events = hurt(since, index)
    g.say("    DIAGEV %s (the wait: %s after %s tick(s))"
          % ([e.get("name") for e in events], reply.get("status"), reply.get("waitedTicks")))
    g.check(len(events) >= 1,
            "the crate dropped from height was hurt by landing: %s"
            % [e.get("name") for e in events])

    # AND IT MADE A NOISE (physics stock parity C3): the response queues each
    # managed side's impact sound into the engine's batch, as stock's
    # VPhysicsCollision -> PhysCollisionSound did. Here rather than in push,
    # because this crate lands from about 190 units, far over the threshold.
    sounds_after = physics_counter(g, "impact sounds")
    g.check(sounds_before is not None and sounds_after is not None
            and sounds_after > sounds_before,
            "the crate's landing queued an impact sound: %s -> %s"
            % (sounds_before, sounds_after))

    kill_prop(g, FALL_NAME)


def step_prop_hurts_player(g):
    """A crate that falls on the player hurts them.

    Stock: CBaseCombatCharacter::VPhysicsShadowCollision takes
    CalculatePhysicsImpactDamage with the player table when a moving VPHYSICS
    prop hits the player's shadow (physics stock parity C10). Ours had no
    shadow-collision dispatch and no player answer. The player's health is
    the answer, read before and after.

    PINNED, THEN DROPPED. The crate is made high on the yard's far wall, as
    impact-damage makes it, and pinned in the air at once (DisableMotion); the
    player is put under its path, and only then is it let go (EnableMotion,
    Wake), so it falls from rest on the same path every round. The first
    version put the player under a crate already falling, and missed 2 rounds
    in 9: the teleport raced the fall.
    """
    g.cheats()
    kill_prop(g, FALL_NAME)
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)
    floor = g.scen["openFloor"]

    # 150 up, not impact-damage's 120: at 120 every hit that landed did 5,
    # the player table's first step, and 2 rounds in 8 did nothing -- an
    # impact just under it. The yard's roof is at about z 288, so 150 is
    # near the most there is.
    g.teleport((floor[0], floor[1], floor[2] + 150.0), (0, 90, 0), settle=0.0)
    # Made at the aim point on the far wall, exactly, and pinned in the same
    # breath: the spawn and the input both run on the game thread before the
    # next tick, so it has not fallen a frame.
    aim = aim_point(g)
    if aim is not None and clear_debris(g, aim, 160.0):
        # The clearing took ticks and the player fell: put them back and aim
        # again, or the crate is made lower on the wall.
        g.teleport((floor[0], floor[1], floor[2] + 150.0), (0, 90, 0), settle=0.0)
        aim = aim_point(g)
    if aim is None:
        g.skip("the player is looking at nothing to make the crate on")
    index, _handle, _made = place_prop(g, FALL_NAME, (aim[0], aim[1], aim[2] + PROP_DROP_LIFT),
                                       facing_away(g))
    g.api.fire(FALL_NAME, "DisableMotion")
    if index is None:
        g.skip("/entities/spawn made nothing")

    # Where it hangs NOW, after the pin, not where it was made. And not
    # straight under it: released from rest it still leaves the wall it was
    # placed against, back into the yard -- measured at y -18 by z 188, -37 by
    # z 112, landing -51 -- so its path crosses head height about 45 units out.
    g.ticks(0.5)
    hanging = prop_origin(g, index)
    if hanging is None:
        g.skip("the pinned crate is gone")
    clear_player_spot(g, (hanging[0], hanging[1] - 45.0), index)
    g.teleport((hanging[0], hanging[1] - 45.0, floor[2]), (-89, 90, 0), settle=0.5)
    me = g.api.player(g.scen["playerClass"])
    before = me["health"] if me else None
    g.say("    the crate hangs at %s; the player is under it at %s health"
          % (hanging, before))
    g.check(hanging[2] > floor[2] + 150.0,
            "the crate hangs well above the player's head: z %.1f" % hanging[2])

    # THE PLAYER'S SPOT IS CLEAR. impact-damage breaks its crate into gibs
    # right here (measured: one at the player's feet, three more within 60
    # units), and with them lying there the falling crate never hurt the
    # player in 2 rounds of 2. RUN_ORDER puts this step before impact-damage
    # for that reason; this says so if the order ever changes.
    # Debris is what earlier steps left -- clear_debris above removed it, and
    # this checks that took. The map's own crates are not debris: one an
    # earlier step pushed here is reported, not failed (prop #60 stood here
    # in one gate pass and the crate hurt the player regardless).
    keep = g.state.get("map_props", set())
    near = [e for e in g.api.ents("prop_physics")
            if e["index"] != index
            and abs(e["origin"][0] - hanging[0]) < PLAYER_SPOT_HALF
            and abs(e["origin"][1] - (hanging[1] - 45.0)) < PLAYER_SPOT_HALF]
    debris = [e["index"] for e in near if e["handle"] not in keep]
    if len(near) > len(debris):
        g.note("the map's own prop(s) %s stand where the player is"
               % [e["index"] for e in near if e["handle"] in keep])
    g.check(not debris,
            "nothing else lies where the player stands (props %s; impact-damage's "
            "gibs land here, which is why this step runs before it)" % debris)

    g.api.fire(FALL_NAME, "EnableMotion")
    g.api.fire(FALL_NAME, "Wake")

    # Health below what it was, answered on the tick it drops.
    after = None
    if me is not None and before is not None:
        reply = g.api.wait({"field": "health", "index": me["index"], "op": "lt", "value": before},
                           int(4.0 / TICK_SECONDS))
        if reply.get("status") == "met":
            after = int(float(reply.get("value")))
    g.check(after is not None,
            "the crate that fell on the player hurt them: health %s -> %s"
            % (before, after))

    kill_prop(g, FALL_NAME)


def step_knock_loose(g):
    """A pinned crate is knocked loose by the player walking into it.

    Stock: CPhysicsProp with "forcetoenablemotion" starts pinned
    (CreateVPhysics) and, in VPhysicsCollision, lets go once the other object's
    mass x collision speed reaches the key, firing OnMotionEnabled
    (physics stock parity C8). Ours never read the key. The player's shadow is
    85 kg, so a walk's contact clears a key of 1000 at 12 in/s; even a walk that
    jams against the crate (the push jam) has touched it.
    """
    g.cheats()
    kill_prop(g, KNOCK_NAME)
    # pushFloor, as the push step: openFloor's walk line crosses the map's
    # concrete chunks (gate_flakes_findings section 4; the scenario's _pushFloor).
    g.teleport(g.scen["pushFloor"], g.scen["openFloorAngles"], settle=1.2)

    def enabled(since, index):
        return g.api.events_all(since, kind="output", index=index, name="OnMotionEnabled*")

    since = g.api.events_next()
    # THE CRATE WHERE IT ALWAYS WAS -- the aim point from openFloor -- after
    # clearing what earlier steps left around it (clear_debris). Not a spot of
    # its own on clear floor: tried (2026-10-05), the knocked crate then sits
    # flat and the walk pushes it at the jam's 1-12 u/s, too slow to scrape,
    # and the step failed in 3 of 4 gate runs (the 4th skipped). At the aim
    # point it rests on the map's own crates #60-#65 and falls off them when
    # knocked loose, which is the slide the scrape check was written against.
    # Those crates also lie across the walk (docs/plans/gate_flakes_findings.md
    # section 4); that is the step's known flake, at its historical rate.
    aim = aim_point(g)
    if aim is not None:
        clear_debris(g, aim, 160.0)
    index, resting, _fell = spawn_prop(g, name=KNOCK_NAME, keyvalues={"forcetoenablemotion": 1000})
    if index is None or resting is None:
        g.skip("/entities/spawn made nothing")

    # THE CONTROL: nothing has touched it, and it has not let go.
    g.check(not enabled(since, index),
            "the pinned crate stays pinned until something hits it")

    here = g.player_origin()
    dx, dy = resting[0] - here[0], resting[1] - here[1]
    span = math.hypot(dx, dy) or 1.0
    g.teleport([resting[0] - dx / span * 64.0, resting[1] - dy / span * 64.0, resting[2]],
               settle=1.2)

    # BEFORE impact-damage in RUN_ORDER: that step breaks its crate into gibs
    # on this floor, and a gib between the player and the crate absorbs the
    # walk -- 42 measured 13 of 14 here against 24 of 24, the one failure
    # right after impact-damage. (A "nothing in the path" check was tried and
    # dropped: the floor already holds earlier steps' crates within 48 units
    # of the walk, props 60-63, and the knock passed through them both passes.)
    g.face(resting, lift=64.0)
    scrapes_before = physics_counter(g, "scrapes started")
    g.hold("forward", 1.5)

    g.api.wait({"event": "output", "index": index, "name": "OnMotionEnabled*", "since": since},
               int(3.0 / TICK_SECONDS))
    events = enabled(since, index)
    g.check(len(events) == 1,
            "walking into the pinned crate knocked it loose, once: %d OnMotionEnabled"
            % len(events))

    # AND IT SCRAPED (physics stock parity D2): the knocked crate slides across
    # the floor, and stock's VPhysicsFriction -> PhysFrictionSound starts a
    # looping scrape for it. A difference across the walk, not a total: the
    # map's own props settle and scrape too.
    scrapes_after = physics_counter(g, "scrapes started")
    g.check(scrapes_before is not None and scrapes_after is not None
            and scrapes_after > scrapes_before,
            "the loosed crate scraped across the floor: scrapes started %s -> %s"
            % (scrapes_before, scrapes_after))

    kill_prop(g, KNOCK_NAME)


def step_shoot(g):
    """4. shoot and hit -- WITH A HITSCAN WEAPON, AND ONLY THAT.

    §5's wording and this step's own title both read as coverage of "the
    shooting path". They are not. The SMG's shot is one trace, the damage is
    applied the same tick, and nothing is ever in the air -- so everything a
    projectile does (plan_entity.md step 2f: MOVETYPE_FLY/TOSS/NOCLIP/FOLLOW,
    the step trace, the impact, the removal) is invisible here. Step 2f
    measured that a build with the integrator unregistered passes this step
    unchanged.

    The title cannot be changed -- --self-test asserts §5's own words are in
    the registry, and they are what §5 says -- so the step SAYS it in its
    output instead, once per pass. The `projectile` step is the other half.
    """
    g.cheats()
    g.note("this step is HITSCAN: %s fires a trace and nothing is ever in the "
           "air. The flight integrator is the `projectile` step's subject, not "
           "this one's." % g.scen["ammoWeapon"])
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)

    index, resting, _fell = spawn_prop(g)
    if index is None:
        g.skip("ent_create prop_physics made nothing to shoot at")
    if resting is None:
        g.skip("the target prop was gone before a shot was fired")

    g.api.cmd("use %s" % g.scen["ammoWeapon"])
    g.ticks(0.6)
    weapons = g.api.ents(g.scen["weaponClass"])
    if not weapons:
        g.skip("no %s entity, so nothing can be fired" % g.scen["weaponClass"])
    weapon = weapons[0]["index"]

    def ammo():
        fields = g.api.fields(weapon)
        return int(fields.get("Clip", "0")) + int(fields.get("Reserve", "0"))

    # +8 aims at the crate's body rather than the seam where it meets the
    # floor. The 64-unit eye offset is applied inside face().
    g.face(resting, lift=8.0)
    aim = g.api.get("aim", 1)
    g.check(aim.get("hitClass") == "prop_physics",
            "the player is looking at the target (aim says %r)" % aim.get("hitClass"))

    before = ammo()
    g.hold("attack", 1.4)
    after_ammo = ammo()
    landed = prop_origin(g, index)

    # Two halves, and both are needed. Ammo going down without the prop moving
    # is a gun that fires into nothing; the prop moving without ammo going down
    # is physics settling, which is what the rest step above rules out.
    g.check(after_ammo < before,
            "the gun fired: %d -> %d rounds carried" % (before, after_ammo))

    if landed is None:
        g.check(True, "the shots destroyed the target")
    else:
        moved = distance(resting, landed)
        g.check(moved > 2.0, "the shots moved the target %.1f units" % moved)

    kill_prop(g)



def step_projectile(g):
    """See _projectile: and then the gibs its target broke into are removed.

    THE TARGET BREAKS ABOUT 320 UNITS DOWNRANGE, which is prop-hurts-player's
    spot (the player under the hanging crate, y 3219): in one gate pass four
    of its gibs lay there and that step failed both its debris check and the
    hurt. Every prop_physics that did not exist before this step is this
    step's own, so those are removed by handle, and answered once gone."""
    before = {e["handle"] for e in g.api.ents("prop_physics")}
    try:
        _projectile(g)
    finally:
        for e in g.api.ents("prop_physics"):
            if e["handle"] not in before:
                g.api.remove(handle=e["handle"])


def _projectile(g):
    """17. a projectile flies -- and `shoot` is the reason this step exists.

    `shoot` HAS BEEN IN THE CHECKLIST SINCE PHASE 0 AND ITS NAME OVERSELLS IT.
    It fires the SMG, which is hitscan: the shot is one trace, the damage lands
    the same tick, and nothing is ever in the air. So the whole of
    plan_entity.md step 2f -- MOVETYPE_FLY/TOSS/NOCLIP/FOLLOW, moved out of
    native `UpdateFlight` into managed `EntityMotion.cs` -- is invisible to it.
    2f measured that: a build with the integrator unregistered passes `shoot`
    unchanged. It probed a projectile separately, found ss_bolt and ss_rocket
    both reaching 367 units downrange and both gone afterwards, and correctly
    declined to edit this file. This step is that probe made into a check.

    THREE ASSERTIONS, AND EACH ONE GOES RED ON ITS OWN when the integrator is
    not run. Verified by doing it -- see the lane's handover for the red output:

      1. IT WENT DOWNRANGE. The furthest sighting is more than
         `projectile.minTravel` from the shooter. The threshold is not "more
         than nothing": a bolt leaves from the EYE, 64 units above the player's
         origin, so one that never moves still reads 68.4 units away. That
         number is in the scenario as `stationary`, it was measured with the
         pass disabled rather than reasoned about, and --self-test refuses a
         threshold that does not sit above it.

      2. IT HIT SOMETHING THAT FAR AWAY. A crate `minTargetRange`+ units
         downrange is destroyed or moved. Deterministic -- it needs no sighting
         of a thing in flight at all -- and it covers what (1) and (3) together
         still would not: an integrator that moved projectiles and removed them
         on a timer without ever tracing the step would satisfy both.

      3. IT RESOLVED. Nothing of the class is left in the air afterwards. An
         unmoved bolt is never removed either -- nothing in FlyingProjectile
         expires on time, so removal is the impact -- and the map fills up.

    The sighting COUNT is deliberately a note and not a check. A build that
    flies nothing still makes projectiles; "at least one existed" is the
    precondition for reading the other numbers, not evidence for any of them,
    and printing it as an `ok` would be the fourth tick in this file that
    cannot fail.
    """
    g.cheats()
    proj = g.scen["projectile"]
    klass = proj["class"]

    # Pitch 0, and the yaw the open floor was chosen for. NOT openFloorAngles:
    # that looks 25 degrees down, which is right for putting a crate on the
    # ground in front of the player and wrong for a projectile -- a bolt fired
    # down it is in the floor after 123.9 units, which is under minTravel, so
    # the step would fail on the aim rather than on the flight.
    g.teleport(g.scen["openFloor"],
               [proj["pitch"], g.scen["openFloorAngles"][1], 0.0], settle=1.2)
    g.api.cmd("impulse 101")
    g.ticks(0.8)
    g.api.cmd("use %s" % proj["weapon"])
    g.ticks(0.6)

    shooter = g.player_origin()
    if shooter is None:
        g.skip("no %s to fire from" % g.scen["playerClass"])

    #-- (1) it went downrange --------------------------------------------
    # Sampled as fast as tools/debug-api will answer, which on this box is ~15ms --
    # about two server frames, and a bolt covers 37.5 units in one. Held down
    # for `fireSeconds` rather than fired once: the crossbow's interval is 1.5s
    # and three shots' worth of samples is what stops a slow box turning this
    # into a flake.
    seen = {}
    g.api.cmd("+attack")
    deadline = time.time() + proj["fireSeconds"]
    while time.time() < deadline:
        try:
            flying = g.api.ents(klass)
        except ApiError:
            flying = []
        for entity in flying:
            seen.setdefault(entity["index"], []).append(
                distance(shooter, entity["origin"]))
    g.api.cmd("-attack")
    g.ticks(proj["settleSeconds"])

    if not seen:
        # A FAILURE AND NOT A SKIP. The weapon was given and the trigger was
        # held; a build in which no %s ever exists has a broken shot, not an
        # undrivable step. (A skip here would also be an unrecorded one and
        # would fail the run anyway -- but it would fail it as a gate problem
        # rather than as the game problem it is.)
        g.check(False, "the %s was fired for %.1fs and no %s ever existed"
                % (proj["weapon"], proj["fireSeconds"], klass))
        return

    sightings = sum(len(d) for d in seen.values())
    furthest = max(max(d) for d in seen.values())
    span = max(max(d) - min(d) for d in seen.values())
    g.note("%d sighting(s) of %d %s; the furthest travelled %.1f units along "
           "its own flight, and step 2f's independent probe recorded %.1f here"
           % (sightings, len(seen), klass, span, proj["recordedTravel"]))

    g.check(furthest > proj["minTravel"],
            "a %s reached %.1f units downrange (> %.1f; a %s that is never "
            "flown sits at %.1f, because it leaves from the eye 64 units up)"
            % (klass, furthest, proj["minTravel"], klass, proj["stationary"]))

    #-- (2) it hit something that far away -------------------------------
    g.api.cmd("impulse 101")
    g.ticks(0.6)
    # THE TARGET IS PLACED BY GEOMETRY, NOT BY AN EJECTION -- lane diag-gateseq.
    #
    # `openFloorAngles` looks 25 degrees down, and from a 64-unit eye that puts
    # the aim point 140 units out on a flat floor. `ent_create` places what it
    # makes AT that point, so 140 is the whole of the distance this fixture can
    # honestly have -- and minTargetRange is 150.
    #
    # For most of this step's life the extra hundred units came from a BUG.
    # `ent_create` set the crate's ORIGIN to the aim point, which for a model
    # whose origin is 28 units above its base buried it in the floor, and
    # vphysics threw it 29 to 164 units clear. That ejection was the fixture,
    # and it is why three readings of one commit disagreed: it varied with
    # whatever else was near the aim point, it collapsed to nothing when lane
    # 3f-shadow's `shoot` debris was in the way, and once per three rounds it
    # came out the WRONG SIDE and the crate rested at z = -5935. The calibration
    # numbers in the scenario file, 269.7 and 338.3, are readings of that bug.
    # It is fixed (SpawningCommand.DropPointFor), and with it gone a crate drawn
    # at openFloorAngles settles at 141 and this step can never pass again.
    #
    # So the fixture is built the way a fixture should be: the step LOOKS
    # FURTHER DOWNRANGE. `targetPitch` is shallower than openFloorAngles' 25,
    # the aim point is therefore further out, and --self-test asserts the
    # geometry -- 64 / tan(targetPitch) -- clears minTargetRange with margin.
    # Measured on dm_lockdown, 11 degrees puts the aim point 324.1 units out on
    # flat floor (z 1.02) and the crate settles at 322.8, twice the floor, and
    # identically on every draw.
    #
    # THE THRESHOLD IS UNTOUCHED. 150 is what makes "it reached the crate" mean
    # flight rather than muzzle blast; a build that cannot put a crate downrange
    # still goes red on the same assertion, and now it goes red for a reason
    # that is about the build.
    proj_angles = [proj["targetPitch"], g.scen["openFloorAngles"][1], 0.0]
    g.teleport(g.scen["openFloor"], proj_angles, settle=1.0)

    # THE DRAW IS STILL BOUNDED-RESAMPLED, for a different reason than before.
    # It is not the distance that varies any more -- it is whether the fixture's
    # own spot is CLEAR. `shoot` runs before this step, spawns its target with
    # the same spawn_prop at the same open floor, and "the shots destroyed the
    # target" leaves SEVEN wood-crate gibs standing there; measured, the aim
    # trace then reads `prop_physics` at 121 units instead of the world at 324
    # and the crate is built on the rubble. That is a contaminated fixture, not
    # a game failure, so it is rejected and named -- exactly like a sunk draw --
    # and the loop is BOUNDED so a run that can never find clear ground fails
    # rather than spinning.
    attempts = []
    sunk = []
    fouled = []
    index = resting = None
    target_range = 0.0

    for _ in range(PROJECTILE_TARGET_TRIES):
        # ASKED BEFORE THE CRATE EXISTS, because after it the crate is what the
        # aim hits. `ent_create` puts what it makes at THIS point, so what the
        # trace ended on is what the fixture will be standing on.
        standing_on = g.api.get("aim", 1).get("hitClass")
        if standing_on != "worldspawn":
            fouled.append(standing_on)
            g.ticks(1.0)
            continue

        idx, rest, _fell = spawn_prop(g)
        if idx is None:
            g.skip("ent_create prop_physics made nothing to shoot at")
        if rest is None:
            g.skip("the target prop was gone before a shot was fired")

        here = g.player_origin()

        # A DRAW THAT WENT THROUGH THE FLOOR IS NOT A DRAW.
        #
        # `distance` is math.dist, which is THREE-DIMENSIONAL, and a spawned
        # prop that falls through the map reads thousands of units from the
        # player on the z axis alone. Taken at face value that is the furthest
        # draw and it clears minTargetRange trivially -- so a naive "keep the
        # best" would PREFER the failure and report it as a good fixture.
        #
        # This is not hypothetical: lane 3f-shadow measured exactly this shape
        # on this step ("one newly spawned prop falls, and then every one after
        # it in that game"), and it is the open bug this gate most needs to be
        # able to SEE. So a sunk draw is rejected, recorded, and -- if every
        # draw sinks -- reported as itself rather than as a range failure.
        if rest[2] < here[2] - PROJECTILE_SUNK_BELOW:
            sunk.append(here[2] - rest[2])
            continue

        # HORIZONTAL, for the same reason: "downrange" is a distance along the
        # ground, and letting the z axis into it lets a prop that merely fell
        # off a ledge pass a check about how far the bolt had to fly.
        rng = math.hypot(rest[0] - here[0], rest[1] - here[1])
        attempts.append(rng)

        if index is None or rng > target_range:
            index, resting, target_range = idx, rest, rng
        if target_range > proj["minTargetRange"]:
            break

    drawn = len(sunk) + len(fouled) + len(attempts)

    if sunk:
        g.note("%d of %d target draw(s) went THROUGH THE FLOOR (%s units below "
               "the player) and were rejected rather than counted as distance"
               % (len(sunk), drawn, ", ".join("%.0f" % d for d in sunk)))

    if fouled:
        g.note("%d of %d target draw(s) had something other than the world at "
               "the aim point (%s) and were rejected: `ent_create` would have "
               "built the fixture ON it. `shoot` runs before this step and "
               "leaves seven wood-crate gibs on this floor."
               % (len(fouled), drawn, ", ".join(repr(k) for k in fouled)))

    g.check(bool(attempts),
            "at least one target draw stayed on the map and had clear ground "
            "under it (%d of %d sank, %d were built on something that is not "
            "the world; a spawned prop falling through the floor is lane "
            "3f-shadow's bug and a fixture built on an earlier step's rubble "
            "is not a fixture)"
            % (len(sunk), drawn, len(fouled)))

    if not attempts:
        return

    if len(attempts) > 1:
        g.note("the target crate was resampled %d time(s); it settled at %s "
               "units downrange and the furthest was taken (see the step's "
               "prose for why one draw is not enough)"
               % (len(attempts), ", ".join("%.1f" % a for a in attempts)))

    g.check(target_range > proj["minTargetRange"],
            "the target crate settled %.1f units downrange (> %.1f), so "
            "reaching it is a flight and not a muzzle blast"
            % (target_range, proj["minTargetRange"]))

    g.face(resting, lift=8.0)
    aim = g.api.get("aim", 1)
    g.check(aim.get("hitClass") == "prop_physics",
            "the player is looking at the target (aim says %r)" % aim.get("hitClass"))

    g.api.cmd("use %s" % proj["weapon"])
    g.ticks(0.6)
    g.hold("attack", 1.6)
    g.ticks(proj["settleSeconds"])

    # ONE check with two acceptable outcomes, not `check(True)` in the branch
    # that succeeded. `shoot` next door is written the other way and it reads
    # as a free tick even though the branch it sits in is the evidence; in a
    # file being audited for checks that cannot fail, a literal `check(True)`
    # should not have to be reasoned about before it can be cleared.
    landed = prop_origin(g, index)
    moved = None if landed is None else distance(resting, landed)
    g.check(landed is None or moved > 2.0,
            "a %s crossed %.1f units and %s"
            % (klass, target_range,
               "destroyed the crate" if landed is None
               else "moved the crate %.1f units" % moved))

    #-- (3) it resolved ---------------------------------------------------
    left = g.api.ents(klass)
    g.check(not left,
            "every %s resolved: %d still in the air %.1fs after the last shot "
            "(nothing in FlyingProjectile expires on a timer, so a %s still "
            "standing there is one that never hit anything)"
            % (klass, len(left), proj["settleSeconds"], klass))

    kill_prop(g)


CRUSH_NAME = "ss_livegate_crush"


def place_crate(g, name, origin, spawnflags=0):
    """One prop_physics made at an exact origin through /entities/spawn,
    and its index, from the reply."""
    index, _handle, _at = place_prop(g, name, origin, keyvalues={"spawnflags": spawnflags})
    if index is None:
        g.skip("/entities/spawn made no prop_physics")
    return index


def step_stress(g):
    """A crate resting on the player's head is felt as stress, and is too light to crush.

    Stock: CBasePlayer::VPhysicsUpdate takes CalculateObjectStress over the
    awake shadow's contacts each physics frame, and past five body weights at
    1/8 scale with a large non-static pusher deals 200 DMG_CRUSH from the world
    (physics stock parity B5). This reads the facts reaching the player: a
    30 kg crate on their head is a moving, non-friendly pusher, so the hull
    reports non-static stress -- and 30 kg is far under the crush line, so
    nothing crushes and the player lives.

    NOT A CRUSH, AND STOCK COULD NOT STAGE ONE THIS WAY EITHER. A crush needs
    about 3,400 kg of received stress at the player's 1/8 scale, and nothing
    over the player's 350 kg push-mass limit rests on an idle player: bisected
    by mass, 300 and 330 kg rest on the head and 390 kg and up fall through it
    without waking the sleeping shadow. The limit and the vphysics behind it
    are stock's (player.cpp's SetPushMassLimit, the same vphysics.so), so a
    resting crush takes something pinning a heavy object onto the player. The
    crush arithmetic is held by PlayerStressDamageTests.

    SET DOWN, NOT DROPPED: the crate is measured at rest on the open floor once,
    then made again pinned, its base a unit above the standing player's head,
    and let go.
    """
    g.cheats()
    kill_prop(g, CRUSH_NAME)
    floor = g.scen["openFloor"]

    probe = place_crate(g, CRUSH_NAME, (floor[0] + 160.0, floor[1], floor[2] + 64.0))
    g.ticks(2.5)
    rest = [e["origin"] for e in g.api.ents("prop_physics") if e["index"] == probe][0]
    base = rest[2] - floor[2]
    kill_prop(g, CRUSH_NAME)
    g.check(0.0 < base < 64.0, "the crate rests %.1f units above its base" % base)

    g.teleport(floor, g.scen["openFloorAngles"], settle=1.2)
    feet = g.player_origin()
    felt_before = physics_counter(g, "stress felt")
    crushed_before = physics_counter(g, "stress crushes")
    index = place_crate(g, CRUSH_NAME, (feet[0], feet[1], feet[2] + 72.0 + base + 1.0),
                        spawnflags=8)
    g.ticks(0.5)
    me = g.api.player(g.scen["playerClass"])
    g.api.fire(CRUSH_NAME, "EnableMotion")
    g.api.fire(CRUSH_NAME, "Wake")
    g.ticks(2.0)

    on_head = [e["origin"] for e in g.api.ents("prop_physics") if e["index"] == index]
    g.check(bool(on_head) and on_head[0][2] > feet[2] + 72.0,
            "the crate rests on the player's head: z %s over feet %.1f"
            % (on_head[0][2] if on_head else None, feet[2]))
    felt_after = physics_counter(g, "stress felt")
    crushed_after = physics_counter(g, "stress crushes")
    g.check(felt_before is not None and felt_after is not None and felt_after > felt_before,
            "the player's hull felt it as non-static stress: stress felt %s -> %s"
            % (felt_before, felt_after))
    g.check(crushed_before is not None and crushed_after == crushed_before,
            "and 30 kg is far under five body weights: stress crushes %s -> %s"
            % (crushed_before, crushed_after))
    g.check(me is not None and g.api.fields(me["index"]).get("Alive") == "true",
            "the player is alive under it")
    kill_prop(g, CRUSH_NAME)


SHADOW_PLAN = " plan cmd "
# A teleport lands at the next physics step, after up to a few queued commands:
# 0-6 measured over 40 trigger rounds (physics-managed, 2026-10-05; the plain
# setpos 2-6). A shadow dragged ~3,000 units would take hundreds; 16 leaves the
# load headroom the measured tail needs.
SHADOW_CATCHES_UP_IN = 16
SHADOW_REACH = 24.0   # vphysics teleports a shadow further than this from its target


def _plan_positions(line):
    """(origin, shadow) from one cs_sv_playershadow_trace plan line, or None."""
    o = re.search(r"origin \(([^)]*)\)", line or "")
    s = re.search(r"shadow \(([^)]*)\)", line or "")
    if not o or not s:
        return None
    return ([float(v) for v in o.group(1).split(",")], [float(v) for v in s.group(1).split(",")])


def shadow_catch_up(g, jump, destination, timeout=3.0):
    """How many commands after the player arrives at `destination` their shadow
    takes to be within SHADOW_REACH of them, read from cs_sv_playershadow_trace;
    None if the trace never showed that.

    vphysics teleports a shadow more than 24 units from its target, which is why
    there is no managed snap (plan_physics_managed A18): a jump is caught up in a
    command or two (400-unit setpos across dm_lockdown's chunks: 1 command, no
    chunk moved). A shadow dragged along the line would still be hundreds of
    units back. Within a unit is the wrong test: a player dropping onto the
    floor leads their shadow by less than one for several commands."""
    # The trace is managed output, so it is read from the debug API's log from
    # where the command started, not from a console file whose path depends on
    # how the game was launched.
    start = (g.api.cmd("cs_sv_playershadow_trace 1") or {}).get("logFrom", 0)
    try:
        jump()
        deadline = time.time() + timeout
        while time.time() < deadline:
            plans = [l for l in g.api.log_from(start, 2000) if SHADOW_PLAN in l]
            arrived_at = None
            for i, line in enumerate(plans):
                pos = _plan_positions(line)
                if not pos or distance(pos[0][:2], destination[:2]) >= 2.0:
                    continue
                if arrived_at is None:
                    arrived_at = i
                if distance(pos[0], pos[1]) <= SHADOW_REACH:
                    return i - arrived_at
            time.sleep(0.05)
        return None
    finally:
        g.api.cmd("cs_sv_playershadow_trace 0")


# cs_sv_physics_events' printed labels -> /counters' physics names. The
# labels are kept at the call sites: they are what a reader greps the log for.
PHYSICS_COUNTER_NAMES = {
    "responded": "responded",
    "updates delivered": "updatesDelivered",
    "impact sounds": "impactSounds",
    "scrapes started": "scrapesStarted",
    "shadow moves": "shadowMoves",
    "stress felt": "stressFelt",
    "stress crushes": "stressCrushes",
}


def physics_counter(g, label):
    """One of `cs_sv_physics_events`' counters, or None when the group is not
    available. /counters?group=physics reads the same objects the command
    prints from: no command, no log page, no regex over its text."""
    counters = g.api.counters("physics")
    if counters is None:
        return None
    return counters.get(PHYSICS_COUNTER_NAMES[label])


def physics_responded(g):
    """The impact response's `responded` counter."""
    return physics_counter(g, "responded")


def step_push_prop(g):
    """10. push a physics prop -- by walking into it, not by breaking it.

    IT PASSES NOW, AND FOR MOST OF THIS PROJECT IT DID NOT. It was the last
    recorded skip in tools/live-gate-skips.tsv, and the reason recorded there
    was right: measured per tick, the player walked into a crate, was stopped
    dead by it, and the crate moved 0.000 units. `CBasePlayer::InitVCollision` /
    `SetupVPhysicsShadow` (src/game/server/player.cpp:8569, :8269) give a stock
    player the physics shadow that pushes objects and the managed `ss_player`
    had no equivalent. plan_entity.md step 3f ported it.

    THREE CHECKS, and the first is a control rather than decoration: a prop
    that does not FALL is a physics system that is not running, which is a
    much larger failure than any this step could otherwise report. Then that
    the player reached the prop, and only then that the prop moved.

    WHY THE REACH IS SAMPLED AND NOT READ ONCE AT THE END is the one thing in
    here that changed with the shadow, and it is written up at the sampling
    loop: a prop that moves is a prop the player can shove aside, so the final
    gap stopped meaning "did they reach it".
    """
    g.cheats()
    # pushFloor, not openFloor: openFloor's path crosses the map's concrete
    # chunks (the scenario's _pushFloor says how that was measured).
    g.teleport(g.scen["pushFloor"], g.scen["openFloorAngles"], settle=1.2)

    responded_before = physics_responded(g)
    shadow_moves_before = physics_counter(g, "shadow moves")

    index, resting, fell = spawn_prop(g)
    if index is None or resting is None:
        g.skip("/entities/spawn made nothing to push")

    g.say("    prop %d fell %.1f units and rests at %s" % (index, fell, resting))

    # The control, and it is a real check: if a spawned prop does not fall,
    # physics is not simulating props at all and the skip below would be
    # hiding a much bigger failure than the one it names.
    g.check(fell > 2.0, "physics moves props: the crate fell %.1f units under "
                        "gravity before it settled" % fell)

    # THE CRATE'S LANDING REACHED THE MANAGED IMPACT RESPONSE. A falling crate
    # hits the floor, and stock answers that in CBaseEntity::VPhysicsCollision,
    # gated on a MOVETYPE_VPHYSICS side. Ours is PhysicsCollisionRules.Responds,
    # and until physics stock parity step C2 the collision record carried
    # MOVETYPE_NONE for every managed entity, so this counter stayed at 0 for
    # the life of every game and the response never ran. A DIFFERENCE across
    # this crate's fall, not a total: the counter is per level and other
    # props' landings would satisfy a total.
    responded_after = physics_responded(g)
    g.check(responded_before is not None and responded_after is not None
            and responded_after > responded_before,
            "the crate's landing reached the managed impact response: "
            "cs_sv_physics_events responded %s -> %s"
            % (responded_before, responded_after))

    # The impact SOUND (physics stock parity C3) is impact-damage's check now:
    # this crate falls 7-8 units, a landing at the sound's own threshold, and
    # the check failed on it in 3 of 18 passes (nine gate runs, 2026-10-02)
    # with nothing about sound changed.

    # STAND NEXT TO IT rather than trusting the walk to arrive. A crate spawned
    # at the aim point bounces before it settles, and where it settles is not
    # where it was made: the first version of this step walked forward from a
    # fixed spot, the crate had come to rest 264 units away, and the step
    # reported "the prop moved 0.0 units" about a player who never reached it.
    here = g.player_origin()
    dx, dy = resting[0] - here[0], resting[1] - here[1]
    span = math.hypot(dx, dy) or 1.0
    stand = [resting[0] - dx / span * 64.0,
             resting[1] - dy / span * 64.0,
             resting[2]]
    g.teleport(stand, settle=1.2)
    g.face(resting, lift=64.0)   # level: only the yaw steers a walk

    # SAMPLED DURING THE HOLD, AND THE CLOSEST APPROACH IS WHAT COUNTS.
    #
    # This used to read the gap ONCE, after the walk, and assert it was under
    # 64 -- "so what stopped them was the prop". That check was written for a
    # build in which the prop could not move, and plan_entity.md step 3f gave
    # the player the VPhysics shadow that moves it. A pushed prop slides away
    # from the player and can be shoved aside, so the FINAL gap is now a
    # measure of how well the push worked, and the step failed with the prop
    # moved 110 units and the gap at 103 -- a success, reported as "nobody
    # walked into it".
    #
    # The closest approach is the question that was always being asked, and it
    # is a HARDER one than the final gap, not a softer: a player who never got
    # near the prop has no small sample anywhere in the walk, whereas one who
    # stopped 63 units short of it by accident used to pass.
    walked_from = g.player_origin()
    closest = distance(walked_from, resting)

    # THE WALK IS BIMODAL AND THE STEP USED TO REPORT ONLY ITS RESULT.
    #
    # lane defect-shadow measured 89 holds of exactly this walk, in ten
    # processes. `moved` is not a measure of how hard the crate was pushed; it is
    # a measure of HOW FAR THE PLAYER GOT, and the player's walk has two modes
    # with nothing in between:
    #
    #   JAM   the player walks 18-109 units, meets the crate and STOPS, and
    #         neither moves again while +forward is held. 66 of 89 holds.
    #   FREE  the player covers 199-286 units and shoves the crate the whole
    #         way. 23 of 89.
    #
    # It is a real deadlock and not a slow push: at two and a half times the
    # hold the jam-mode walk is unchanged (18-109 at 2 s, 30-70 at 5 s). During
    # a jam the player's own VPhysics shadow sits a median 2.15 units IN FRONT
    # of them and during a free walk 0.62 (n=15 vs 7, exact permutation
    # p=0.0043) -- which is PlayerShadow.Plan's softened aim,
    # `0.5 * wishVel * frameTime`, parked at a fixed overhang because the
    # player's blocked origin never advances to move the target on. Stock closes
    # that gap in CBasePlayer::VPhysicsShadowUpdate (player.cpp:8505,
    # `SetAbsOrigin( newPosition )`) and this port does not carry that path. The
    # port's only shadow-to-player reconciliation is PlayerShadow's SNAP at 36.8
    # units, seventeen times the gap a jam makes, so it almost never fires:
    # `snaps` read 0 in 50 of the 52 holds that counted them.
    #
    # So the tracks are kept, and the mode is REPORTED. The thresholds below are
    # deliberately unchanged -- a jam is a real deficiency and a gate that
    # sometimes catches it is doing its job; what was wrong was that the report
    # blamed the push. See .claude/entity-port/status/defect-shadow.md.
    peak = 0.0
    walk_peak = 0.0

    # TWO SECONDS OF GAME, not of wall clock: the hold ends when the server
    # has run 133 ticks of it, read off each sample's own tick, so a busy box
    # walks the same distance an idle one does.
    me = g.api.player(g.scen["playerClass"])
    g.api.cmd("+forward")
    start_tick = None
    while True:
        here_e = g.api.entity(index=me["index"]) if me else None
        there = prop_origin(g, index)
        here = here_e["origin"] if here_e else None
        if here is not None and there is not None:
            closest = min(closest, distance(here, there))
            peak = max(peak, distance(resting, there))
            walk_peak = max(walk_peak, distance(walked_from, here))
        if here_e is None:
            break
        start_tick = here_e["tick"] if start_tick is None else start_tick
        if here_e["tick"] - start_tick >= int(2.0 / TICK_SECONDS):
            break
    g.api.cmd("-forward")
    g.ticks(0.8)

    walked_to = g.player_origin()

    moved_to = prop_origin(g, index)
    if moved_to is None:
        g.check(False, "the prop vanished instead of being pushed")
        kill_prop(g)
        return

    # The player's own travel is checked FIRST and separately, because "the
    # prop did not move" and "nobody walked into it" are different defects and
    # the second one wearing the first one's message is how an afternoon goes.
    walked = distance(walked_from, walked_to)
    g.check(walked > 8.0, "the player walked %.1f units towards it" % walked)
    g.check(closest < 64.0,
            "and got right up against it -- %.1f units at the closest, from 64 "
            "at the start; two seconds of walking covers six hundred, so what "
            "stopped them was the prop" % closest)

    moved = distance(resting, moved_to)
    kill_prop(g)

    # WHICH MODE THIS HOLD DREW, said out loud. A note and not a check: both
    # modes are things the build really does, and a gate that failed on the
    # common one would fail three runs in four.
    if walk_peak >= 150.0:
        g.note("a FREE walk: the player covered %.1f units and shoved the crate "
               "the whole way (%.1f at its furthest)" % (walk_peak, peak))
    else:
        g.note("a JAM: the player covered %.1f units, met the crate and stopped "
               "-- the crate reached %.1f during the hold and settled at %.1f. "
               "Both modes are this build's; see status/defect-shadow.md"
               % (walk_peak, peak, moved))

    # A CHECK AND NOT A SKIP ANY MORE. It used to skip here with the finding
    # that the player had no physics shadow, and tools/live-gate-skips.tsv
    # carried the row that made the skip survivable. plan_entity.md step 3f
    # built the shadow; the row is gone, and a build in which the crate stops
    # moving again is a FAILURE rather than a recorded limitation. That is the
    # ledger's own rule -- "getting coverage back takes an edit too".
    g.check(moved > 4.0,
            "walking into the prop moved it %.1f units, %.1f at its furthest "
            "DURING the hold, on a walk of %.1f (the crate fell %.1f under "
            "gravity first, so the thing being pushed is a simulated one)"
            % (moved, peak, walk_peak, fell))

    # AND THE SOLVER ANSWERED BACK (physics stock parity B7): stock's
    # VPhysicsShadowUpdate runs once per physics frame after the step, and a
    # player leaning on a crate is out of tolerance with their shadow, so it
    # brings them to it. A difference across the push, not a total.
    shadow_moves_after = physics_counter(g, "shadow moves")
    g.check(shadow_moves_before is not None and shadow_moves_after is not None
            and shadow_moves_after > shadow_moves_before,
            "the solver's shadow update moved the pushing player: shadow moves %s -> %s"
            % (shadow_moves_before, shadow_moves_after))


def step_trigger(g):
    """7. enter and leave a trigger.

    IN STILL AIR. The scenario's wind (a trigger_push over the trigger's floor)
    blows a player in the room towards the fan, as stock's does: the landed
    player is not where they landed, and one teleported out carries the wind's
    velocity on arrival, so neither shadow catch-up ever sees them arrive. It
    pushed nobody until trigger_push reached players (2026-10-20). Off for the
    step, and back on after: the fan's sensor turned it on at level start.

    AND THEN IT MUST BLOW, or turning it off proves nothing: on for certain
    (Enable, not the fan's say-so), a player dropped into the room at the
    inside point is carried WIND_CARRIES units or more across the floor. At
    c5c8df3d2 they fell straight down: trigger_push's impulse landed on the
    player's shadow. LAST, because a player blown against the fan slows it and
    its sensor turns the wind back on when it spins up again: the still-air
    half would not stay still after it."""
    g.cheats()
    trigger = g.scen["trigger"]
    wind = trigger.get("wind")
    if wind:
        g.api.fire(wind, "Disable")
    try:
        _trigger_in_still_air(g, trigger)
        if wind:
            # From outside: a volume switched on does not take in who was
            # already standing in it (TriggerVolume keeps no occupant it was
            # off for; stock's Enable re-touches, docs/todo.md), so the
            # player crosses into it.
            g.api.fire(wind, "Enable")
            g.teleport(trigger["outside"], settle=1.5)
            g.teleport(trigger["inside"], settle=0.0)
            time.sleep(1.5)
            here = g.player_origin()
            carried = distance(here[:2], trigger["inside"][:2]) if here else None
            g.check(carried is not None and carried >= WIND_CARRIES,
                    "the room's wind (%s, a trigger_push) carried the player %s units (>= %d)"
                    % (wind, "%.1f" % carried if carried is not None else None, WIND_CARRIES))
            # Out of the room and at rest, so no later step inherits the
            # wind's velocity (a teleport keeps it).
            g.api.fire(wind, "Disable")
            g.teleport(trigger["outside"], settle=1.5)
    finally:
        if wind:
            g.api.fire(wind, "Enable")


# How far dm_lockdown's fan_wind (speed 800, pushdir 30 180 0) must carry a
# player in 1.5 s. Measured at 98db7cb6f: from x -3395 to about -3535 against
# the fan, 134 to 145 units over three passes; at c5c8df3d2, 0. A quarter of
# it is the bar.
WIND_CARRIES = 32


def _trigger_in_still_air(g, trigger):
    """step_trigger's body, with the scenario's wind off."""
    g.teleport(trigger["outside"], settle=1.5)
    since = g.api.events_next()
    g.teleport(trigger["inside"], settle=0.0)

    # Each answered on the tick its output fires, filtered by the game.
    entered = g.api.wait({"event": "output", "classname": trigger["class"],
                          "name": "OnStartTouch*", "since": since}, int(12.0 / TICK_SECONDS))
    entry = entered.get("value") if entered.get("status") == "met" else None
    g.check(bool(entry), "entering fired %s.OnStartTouch" % trigger["class"])
    if not entry:
        return
    handle = entry.get("handle")
    # Landed: "inside" is 88 units over the floor. Standing still, not a guess.
    me = g.api.player(g.scen["playerClass"])
    if me:
        g.api.wait({"settled": 1, "index": me["index"], "eps": 1, "for": 5}, int(2.0 / TICK_SECONDS))
    # Where the trigger's floor is, MEASURED: the landed player's origin is
    # its feet. The control below needs a point in open air over it.
    landed = g.player_origin()
    since = g.api.events_next()
    exact = shadow_catch_up(g, lambda: g.teleport(trigger["outside"], settle=0.0), trigger["outside"])

    left = g.api.wait({"event": "output", "handle": handle, "name": "OnEndTouch*", "since": since},
                      int(12.0 / TICK_SECONDS))
    exit_event = left.get("value") if left.get("status") == "met" else None
    g.check(bool(exit_event),
            "leaving fired OnEndTouch on the SAME trigger (handle %s)" % handle)

    # THE SHADOW WENT WITH THE PLAYER, floor to floor, ~3,000 units: g.teleport
    # is setpos_exact, stock's Teleport, which re-aims the shadow.
    g.check(exact is not None and exact <= SHADOW_CATCHES_UP_IN,
            "setpos_exact carried the player's shadow with them: caught up in %s command(s)" % exact)
    # AND A PLAIN SETPOS, which does not re-aim it: vphysics teleports a shadow
    # that far from its target, so it is caught up as fast, with no managed
    # snap (plan_physics_managed A18; stock has none).
    # IN OPEN AIR, eight units over the floor the player just landed on (main's
    # measured floor; z 0 was four units INTO it, gate_flakes_findings section 2).
    floor_z = landed[2] if landed else trigger["inside"][2] - 88.0
    target = [trigger["inside"][0], trigger["inside"][1], floor_z + 8.0]
    plain = shadow_catch_up(g, lambda: g.api.cmd("setpos %s %s %s" % tuple(target)), target)
    g.check(plain is not None and plain <= SHADOW_CATCHES_UP_IN,
            "and a plain setpos's shadow caught up too: in %s command(s)" % plain)


def step_door(g):
    """8. open a door -- both kinds this map has."""
    g.cheats()
    door = g.scen["door"]
    rotating = g.scen["rotatingDoor"]

    before = {e["index"]: e["origin"] for e in g.api.ents("func_door")}
    before_yaw = {e["index"]: e["angles"] for e in g.api.ents("func_door_rotating")}

    if not before:
        g.skip("this map has no func_door")

    # THE FIRE'S OWN REPLY, CHECKED. `slid()` below looks for ANY func_door
    # that moved, which is a needle wider than its subject: nothing else on
    # dm_lockdown opens a door by itself so it holds today, but "a door moved"
    # is not "the door I named moved". The reply narrows it from the other end
    # -- matched BY NAME (not by falling back to the classname, which would
    # mean firing at every func_door on the map), exactly one target, and that
    # target ACCEPTED the input rather than merely being sent it.
    for name in (door["name"], rotating["name"]):
        reply = g.api.fire(name, "Open")
        g.check(reply.get("matchedBy") == "name" and reply.get("targets") == 1,
                "Open reached exactly one entity NAMED %s (matchedBy %r, %s "
                "target(s)) -- not a classname fallback across every door"
                % (name, reply.get("matchedBy"), reply.get("targets")))
        g.check(reply.get("accepted", 0) >= 1,
                "and %s ACCEPTED it (%s accepted); an input an entity does not "
                "implement is the other thing that looks like nothing happening"
                % (name, reply.get("accepted")))

    def slid():
        now = {e["index"]: e["origin"] for e in g.api.ents("func_door")}
        moved = [(i, distance(before[i], now[i]))
                 for i in before if i in now and distance(before[i], now[i]) >= door["minMove"]]
        return moved or None

    moved = g.api.wait_for(slid, 12.0)
    g.check(bool(moved), "the sliding door travelled %s"
            % (["%d: %.0f units" % m for m in (moved or [])],))

    def turned():
        now = {e["index"]: e["angles"] for e in g.api.ents("func_door_rotating")}
        spun = [(i, abs(now[i][1] - before_yaw[i][1]))
                for i in before_yaw
                if i in now and abs(now[i][1] - before_yaw[i][1]) >= rotating["minYaw"]]
        return spun or None

    if before_yaw:
        spun = g.api.wait_for(turned, 12.0)
        g.check(bool(spun), "the rotating door turned %s"
                % (["%d: %.0f degrees" % s for s in (spun or [])],))
    else:
        g.note("this map has no func_door_rotating; only the sliding kind is measured")


def step_lift(g):
    """9. ride a lift.

    dm_lockdown has no lift. No func_plat, no func_tracktrain, no vertical
    func_door: its three doors slide sideways (movedir "0 90 0", "0 180 0")
    and its brush models are 2-to-4-unit plates. So the gate BUILDS one -- a
    func_movelinear wearing one of the map's own brush models, pointed up --
    and that mover WORKS: told to Open it travels its full distance, which
    this step measures before it does anything else.

    IT SKIPPED FOR TWO REASONS AND ONE OF THEM WAS THIS FILE'S. The recorded
    skip said "a managed brush mover is not solid to the player: dropped onto
    the platform they fall through it". Measured again by lane 2g, per tick:
    the player LANDS on it and GroundEntity reads the lift -- and then walks
    off the far edge, because the usercmd this step sent to get them simulated
    was +forward. That half is fixed in the drop loop below.

    The other half was real and is plan_entity.md step 2g's: a managed mover
    carried nobody. Riders.Carry was called by four hand-written classes and
    func_movelinear was not one of them, so the platform rose THROUGH its
    passenger, who became its own blocker; measured before the fix, the lift
    crawled at 3 units a second instead of 60 and the player ended up embedded
    in the plate. The integrator carries every mover now.

    movedir IS A QANGLE, not a vector. "0 0 1" reads as yaw 0 and sends the
    lift sideways; the first version of this step did exactly that, watched a
    platform slide out from under a stationary player, and called it a pass.
    """
    g.cheats()
    lift = g.scen["lift"]
    g.api.remove(name=lift["name"])   # answered once it is gone

    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)
    g.api.cmd('ent_create func_movelinear model %s targetname %s '
              'movedir "-90 0 0" speed %s movedistance %s startposition 0'
              % (lift["brushModel"], lift["name"], lift["speed"], lift["distance"]))

    made = g.api.wait_for(lambda: g.api.ents("func_movelinear"), 10.0)
    if not made:
        g.skip("ent_create func_movelinear made nothing to ride")

    index = made[0]["index"]
    base = made[0]["origin"]

    #-- the mover itself, before anybody tries to stand on it ---------------
    # WAITED OUT, not sampled the moment it clears the threshold. Reading the
    # position of a platform that is still travelling gives a "top" that is not
    # the top, and everything after it -- where the player is dropped, what
    # "came to rest above it" means -- is then measured against a height the
    # platform left. The first version did that and reported the player resting
    # 44 units ABOVE a platform they had been dropped onto.
    def where():
        now = [e for e in g.api.ents("func_movelinear") if e["index"] == index]
        return now[0]["origin"] if now else None

    g.api.fire(lift["name"], "Open")

    top = base
    still = 0
    for _ in range(int(lift["distance"] / float(lift["speed"]) * 4) + 20):
        g.ticks(0.5)
        here = where()
        if here is None:
            break
        still = still + 1 if abs(here[2] - top[2]) < 0.05 else 0
        top = here
        if still >= 3 and top[2] - base[2] >= lift["minRise"]:
            break

    rose = top[2] - base[2]
    g.check(rose >= lift["minRise"],
            "the mover travelled %.1f units up when told to Open, and stopped there" % rose)

    if rose < lift["minRise"]:
        g.api.fire(lift["name"], "Kill")
        g.skip("the mover would not move, so nothing could have been ridden")

    #-- boarding ------------------------------------------------------------
    # Dropped onto the RAISED platform, so that falling through it is
    # distinguishable from standing on it: the floor is a long way below.
    #
    # THREE HEIGHTS, and the LAST of them never works on this map: a player
    # teleported to 28 units above the raised plate is allsolid against the
    # geometry up there and is not simulated at all (velocity -4.5 for ever,
    # which is one half-tick of gravity applied to something that cannot
    # move). 16 and 6 both board on every attempt, and the loop breaks on the
    # first, so the third is a fall-back that costs nothing.
    def aboard():
        who = g.api.player(g.scen["playerClass"])
        return (who is not None
                and g.api.fields(who["index"]).get("GroundEntity") == str(index))

    landed_at = None
    on_it = None
    for drop in (16, 6, 28):
        g.teleport([top[0], top[1], top[2] + drop], settle=0.3)
        # A teleported player is not simulated until a usercmd arrives, so one
        # is sent; a sixth of a second is enough to make the engine run
        # movement and put a ground entity under them.
        #
        # +use AND NOT +forward, and the difference is the whole of why this
        # step read as a build failure for two months. A sixth of a second of
        # +forward is 320 units a second, the plate is 114 long, and the coast
        # after the release carries them another sixty -- so the player LANDED
        # ON THE PLATFORM and walked off the far edge before the first `aboard`
        # poll, every time. Measured on lane 2g's build, before its own change:
        # 0 of 18 attempts saw the player aboard, deterministically, and a
        # per-tick sample showed GroundEntity = the lift for the first ~0.6s of
        # each one. +use makes a usercmd with a button change in it and no
        # movement, which is all this line was ever for: 12 of 18 with the same
        # build, and 12 of 12 on the two drops the loop reaches.
        g.hold("use", 0.15)
        on_it = g.api.wait_for(aboard, 5.0)
        landed_at = g.player_origin()
        if on_it:
            break

    if not on_it:
        ground = g.api.fields(g.api.player(g.scen["playerClass"])["index"]).get("GroundEntity")
        fell_through = landed_at is not None and landed_at[2] < top[2] - 8.0
        g.api.fire(lift["name"], "Kill")
        g.skip("the mover moves but the player cannot stand on it: dropped onto "
               "the platform at z %.1f they came to rest at z %.1f with "
               "GroundEntity %s (%s). dm_lockdown carries no func_plat, no "
               "func_tracktrain and no vertical func_door either, so there is "
               "nothing on this map on this build that a player can ride."
               % (top[2], landed_at[2] if landed_at else float("nan"), ground,
                  "fell through it onto the world" if fell_through
                  else "did not settle onto it"))

    #-- the ride, for the build where boarding works -----------------------
    g.api.fire(lift["name"], "Close")
    g.ticks(max(4.0, lift["distance"] / float(lift["speed"])))

    start_player = g.player_origin()[2]
    start_lift = [e for e in g.api.ents("func_movelinear") if e["index"] == index][0]["origin"][2]

    g.api.fire(lift["name"], "Open")
    peak_player = start_player
    peak_lift = start_lift
    carried = False
    for _ in range(30):
        g.ticks(0.4)
        who = g.api.player(g.scen["playerClass"])
        if who:
            peak_player = max(peak_player, who["origin"][2])
            if g.api.fields(who["index"]).get("GroundEntity") == str(index):
                carried = True
        now = [e for e in g.api.ents("func_movelinear") if e["index"] == index]
        if now:
            peak_lift = max(peak_lift, now[0]["origin"][2])

    g.say("    lift +%.1f, player +%.1f"
          % (peak_lift - start_lift, peak_player - start_player))
    g.check(peak_lift - start_lift >= lift["minRise"],
            "the lift rose %.1f units with the player on it" % (peak_lift - start_lift))
    g.check(peak_player - start_player >= 16.0,
            "and carried them up %.1f units" % (peak_player - start_player))
    g.check(carried, "the player's GroundEntity was the lift while it moved")

    g.api.fire(lift["name"], "Kill")
    gone = g.api.wait_for(lambda: not g.api.ents("func_movelinear"), 10.0)
    g.check(bool(gone), "the gate's lift was removed again, so the census is the map's")


def step_die(g):
    """11. die and ragdoll."""
    ragdolls = len(g.api.ents(g.scen["ragdollClass"]))
    player = g.api.player(g.scen["playerClass"])
    if not player:
        g.check(False, "no player to kill")
        return

    g.api.get("hurtclass", g.scen["playerClass"], 500)

    dead = g.api.wait_for(
        lambda: g.api.fields(player["index"]).get("Alive") == "false", 10.0)
    fields = g.api.fields(player["index"])
    g.check(bool(dead), "the player's networked Alive went false")
    g.check(int(fields.get("Health", "1")) <= 0,
            "and its health is %s" % fields.get("Health"))

    more = g.api.wait_for(
        lambda: len(g.api.ents(g.scen["ragdollClass"])) > ragdolls, 10.0)
    now = len(g.api.ents(g.scen["ragdollClass"]))
    g.check(bool(more), "a %s was created for the corpse (%d -> %d)"
            % (g.scen["ragdollClass"], ragdolls, now))


def step_respawn(g):
    """12. respawn.

    Not automatic on this build: the player lies dead until a button is
    pressed, which is stock deathmatch behaviour and is why this presses one
    rather than waiting longer and reporting a timeout as a defect.
    """
    player = g.api.player(g.scen["playerClass"])
    if not player:
        g.check(False, "no player to respawn")
        return

    alive = None
    for _ in range(8):
        g.hold("attack", 0.3)
        g.ticks(1.2)
        if g.api.fields(player["index"]).get("Alive") == "true":
            alive = True
            break

    fields = g.api.fields(player["index"])
    g.check(bool(alive), "the player came back alive")
    g.check(int(fields.get("Health", "0")) > 0,
            "with health back at %s" % fields.get("Health"))

    live = g.api.player(g.scen["playerClass"])
    g.check(live is not None and live["origin"] != [0.0, 0.0, 0.0],
            "and standing at a spawn point %s" % (live["origin"] if live else None,))


def newcomer_ops(api, seconds=90.0, step=1.0):
    """The newcomer client's crossing counters, WAITED FOR rather than sampled.

    THE SERVER SEES THE NEWCOMER BEFORE THE NEWCOMER HAS LOADED ANYTHING. The
    engine creates the server-side player -- the entity
    `server.ents(playerClass)` counts -- and calls ClientPutInServer when it
    activates the player, without waiting for the client. The newcomer only
    goes fully connected when the NEXT snapshot arrives, and only then does
    the engine call the client's `LevelInitPostEntity()` -- the ordering
    measured below -- which is the one thing that raises the managed
    `ClientLevelInit` crossing, and the same snapshot is what raises
    `ClientStandaloneCreate`.

    So "the server holds two players" is STRICTLY EARLIER than "the newcomer
    loaded the level", on every run and every machine. Reading the newcomer's
    counters the instant the server sees it join is a check that is racing the
    engine's own handshake by construction, and it is Api.wait_for's docstring
    verbatim: 'it did not happen' and 'it happened later than I looked' are not
    the same fact, and confusing them is the shape that makes a live gate flaky
    and then makes it ignored. On 2026-09-05 it lost that race and reported
    `ClientLevelInit 0` -- a healthy game called broken, and an afternoon of
    bisecting a port that had not changed.

    A DEADLINE, NOT A SLEEP, and it still fails. A newcomer that really never
    loads returns the counters it really has and the step goes red on them, so
    this cannot turn a broken client green -- it can only stop calling a slow
    one broken. Returns (ops, waited) so the caller can SAY how late it was:
    a run that needed 30 of the 90 seconds is a finding even when it passes.
    """
    began = time.time()
    seen = {}

    def loaded():
        seen.clear()
        seen.update(api.crossings().get("ops", {}))
        return (seen.get("ClientLevelInit", 0) >= 1
                and seen.get("ClientStandaloneCreate", 0) >= 2)

    # Api.wait_for UNBOUND, so that the one polling loop in this file is the one
    # that runs here AND the stand-in in --self-test needs only crossings() and
    # alive(). A fake that had to supply its own wait_for would be a fake that
    # reimplemented the thing under test, and the check would prove nothing.
    Api.wait_for(api, loaded, seconds, step)
    return dict(seen), time.time() - began


# The convars the header names as the two things that cost an afternoon when
# they are absent, plus the one the save/load step turns off. Read from BOTH
# instances, because "on both" is precisely the requirement and a value read
# from one side cannot show that the other side missed it.
JOIN_CONVARS = ("net_usesocketsforloopback", "sv_lan", "sv_cheats",
                "cl_LocalNetworkBackdoor")


def join_state(server, client, players, log, port=None):
    """One sentence describing WHY a second client might not have joined.

    Built from what the two games answer rather than from what the launch line
    asked for: `-maxplayers 4` on the command line and maxClients 1 in the
    running server look identical from outside, and a convar that silently
    failed to apply looks exactly like a regression in the port.

    `maxplayers` is deliberately NOT read as a convar. On this engine it is a
    COMMAND, and `debug-api convar maxplayers` answers "no convar of that name" --
    which is why the message this replaced could never have carried it, and why
    the server's own reported maxClients is used instead.
    """
    bits = ["server holds %d player(s)" % players,
            "our server's UDP port is %s" % port]

    try:
        status = server.status()
        for key in ("maxClients", "maxPlayers", "players", "map"):
            if key in status:
                bits.append("%s=%s" % (key, status[key]))
    except ApiError as why:
        bits.append("the server's status could not be read (%s)" % why)

    for name, api in (("server", server), ("client", client)):
        for convar in JOIN_CONVARS:
            try:
                bits.append("%s.%s=%s" % (name, convar,
                                          api.convar(convar).get("value")))
            except ApiError as why:
                bits.append("%s.%s=UNREADABLE (%s)" % (name, convar, why))

    bits.append("its log is kept at %s" % SECONDCLIENT_KEPT_LOG)
    return "; ".join(bits)


def step_second_client(g):
    """13. a second client joins, and both see each other.

    A WHOLE SECOND GAME, because there is no other kind of second client: this
    engine has no splitscreen and a bot is not a client. The instance gets its
    own TMPDIR (the engine takes one lock per user under
    $TMPDIR/source_engine_<uid>) and NO -condebug (both instances would write
    bin/<config>/mods/test/console.log and neither log would then be about one game).

    net_usesocketsforloopback 1 ON BOTH IS NOT OPTIONAL. Without it the engine
    short-circuits every packet addressed to 127.0.0.1 into its own internal
    loopback queue: with net_showudp 1 the server can be watched receiving the
    client's query, sending the reply, and then RECEIVING ITS OWN REPLY. No
    error, no drop, no log line -- the packet simply never leaves the process,
    and the client reports "Connection failed after 4 retries" exactly as it
    would against a server that was not there.

    "Both see each other" is measured on both sides:
      * the server holds two players, at two different origins;
      * the newcomer's client built the world and the entities in it
        (ClientLevelInit, ClientStandaloneCreate), so it can see the first
        player;
      * the FIRST instance's client made new entities when the newcomer
        arrived, so it can see the second player;
      * and input from the second client moves the second player ON THE SERVER,
        which is the round trip nothing else here covers.
    """
    if g.no_second_client:
        g.skip("--no-second-client was given")

    scen = g.scen
    server = g.api

    # THE PORT THIS RUN'S SERVER ACTUALLY BOUND, never the literal 27015. See
    # the port block near the top of this file: 27015 on a box with two live
    # gates on it is the OTHER gate's server, and connecting there is how this
    # step spent 2026-09-06 reporting "the second client never joined" about a
    # newcomer that had joined somebody else's game perfectly well.
    port = getattr(g, "server_port", None)
    if not port:
        g.check(False, "the gate could not tell which UDP port its own server "
                       "bound, so it will not guess at 27015")
        return

    # NOBODY ELSE'S CLIENT IS IN HERE. The reciprocal of the same collision,
    # and this gate produced it on 2026-09-06 while holding 27015: a PEER
    # lane's second client connected to us, the server held two players, and
    # the step then reported that OUR newcomer's input moved its player 0.0
    # units and that the server never went back to one when it left. Both of
    # those read as a broken port and neither was one. Checked BEFORE the
    # launch, so the diagnosis is one line rather than two confusing failures.
    sitting = server.ents(scen["playerClass"])
    if len(sitting) != 1:
        g.check(False, "the server already holds %d player(s) %s before a "
                       "second client is launched, on port %d. This step needs "
                       "to start from one. A player that is not ours is "
                       "another gate's client that reached us -- check "
                       "`ss -ulnp | grep 270` and `pgrep -a hl2_linux64`."
                % (len(sitting), [p["index"] for p in sitting], port))
        return

    # The first instance's own client, in the sitting player's slot.
    first_slot = sitting[0]["index"]
    before_created = server.client_crossings(first_slot).get("ops", {}).get("ClientStandaloneCreate", 0)

    tmpdir = os.path.join(g.scratch, "client2")
    log = os.path.join(g.scratch, "live-gate-client2.log")
    client, _ = launch_with_free_port(client_launch, log, tmpdir)

    if client is None:
        # A FAILURE, for the same reason the never-joined arm below is one: a
        # second instance that will not start is this gate's subject going
        # missing, not a thing the game cannot do yet. The log is kept by hand
        # here because there is no Game to hand to the `finally`.
        g.note(keep_log(log, SECONDCLIENT_KEPT_LOG))
        g.check(False, "a second instance never opened a dev API socket; "
                       "its log is kept at %s" % SECONDCLIENT_KEPT_LOG)
        return

    # ITS LOG IS KEPT WHEN IT FAILS, exactly as the save/load instance's is and
    # for the same reason: this instance has no -condebug (only ONE may have it;
    # both would write bin/<config>/mods/test/console.log), so its stdout in the scratch
    # directory is the only copy -- and main()'s finally rmtree's that directory.
    # When this step went red on 2026-09-05 the whole of the evidence about the
    # newcomer had been deleted before anyone read the report.
    failures_before = len(g.failures)
    kept = False

    try:
        for api in (server, client.api):
            api.convar("net_usesocketsforloopback", 1)
        time.sleep(1.0)

        client.api.cmd("connect 127.0.0.1:%d" % port)

        joined = server.wait_for(
            lambda: len(server.ents(scen["playerClass"])) >= 2, 90.0, 1.0)
        players = server.ents(scen["playerClass"])

        if not joined:
            # NOT A SKIP. Exactly step_join's reasoning, applied to the second
            # client: a gate whose subject never joined has FAILED. `lift` and
            # `push` skip because the GAME cannot do the thing yet and the
            # capability was never there; a second client joining is a
            # capability that exists and has passed on every previous run, so
            # its absence is a regression and not a limitation. This was a
            # g.skip until 2026-09-06, and it downgraded silently: the step had
            # been PASS PASS all day, went SKIP SKIP, and the gate still exited
            # 0. Nothing failed and nobody was told.
            #
            # The convars are read back on BOTH sides and NAMED CORRECTLY. The
            # skip this replaced read sv_lan into a variable called
            # `maxplayers` -- so the one number the header says costs an
            # afternoon when absent was never in the message at all, and the
            # number that was there was labelled as something else.
            g.check(False, "the second client never joined -- %s" % join_state(
                server, client.api, len(players), log, port))
            return

        g.check(len(players) == 2, "the server holds 2 players %s"
                % [p["index"] for p in players])
        g.check(len({p["index"] for p in players}) == 2,
                "at two different entity indices")
        origins = [tuple(p["origin"]) for p in players]
        g.check(len(set(origins)) == 2, "standing in two different places")

        # WAITED FOR. See newcomer_ops: the server holds the newcomer's player
        # a full snapshot before the newcomer has run LevelInitPostEntity, so
        # these two counters are zero at this point on every run and the only
        # question is whether they are still zero when we look.
        # The newcomer is the player who was not sitting before the join, and
        # its counters are read through the server's proxy for its slot.
        newcomer_slot = next(p["index"] for p in players if p["index"] != first_slot)
        client_ops, waited = newcomer_ops(ClientView(server, newcomer_slot, client.api))
        g.check(client_ops.get("ClientLevelInit", 0) >= 1,
                "the newcomer's client loaded the level (ClientLevelInit %d, "
                "%.1fs after the server saw it join)"
                % (client_ops.get("ClientLevelInit", 0), waited))
        g.check(client_ops.get("ClientStandaloneCreate", 0) >= 2,
                "and built %d networked entities from the server, so it sees the world"
                % client_ops.get("ClientStandaloneCreate", 0))

        after_created = server.client_crossings(first_slot).get("ops", {}).get("ClientStandaloneCreate", 0)
        g.check(after_created > before_created,
                "the first instance's client built %d new entities when the "
                "newcomer arrived, so it sees the second player"
                % (after_created - before_created))

        # The round trip: the newcomer's own input, through the wire, into the
        # server's copy of its player.
        #
        # AFTER IT IS ALIVE AND STILL. A player entity exists on the server
        # from the moment the client is put in the server, several seconds
        # before that client is out of its loading screen and sending usercmds
        # -- so a walk driven the instant the second player appears moves
        # nothing, and reports the wire as broken when it is merely early.
        newcomer = max(players, key=lambda p: p["index"])

        def newcomer_alive():
            fields = server.fields(newcomer["index"])
            return fields.get("Alive") == "true"

        server.wait_for(newcomer_alive, 30.0)

        moved = 0.0
        for _ in range(3):
            was = [p for p in server.ents(scen["playerClass"])
                   if p["index"] == newcomer["index"]]
            if not was:
                break
            client.api.cmd("+forward")
            time.sleep(3.0)
            client.api.cmd("-forward")
            time.sleep(1.0)
            now = [p for p in server.ents(scen["playerClass"])
                   if p["index"] == newcomer["index"]]
            moved = distance(was[0]["origin"], now[0]["origin"]) if now else 0.0
            if moved > 16.0:
                break

        g.check(moved > 16.0,
                "the newcomer's own input moved its player %.1f units on the server" % moved)

        client.api.cmd("disconnect")
        left = server.wait_for(
            lambda: len(server.ents(scen["playerClass"])) == 1, 30.0)
        g.check(bool(left), "and the server is back to one player when it leaves")
    except ApiError:
        # Its own arm, for save-load's reason: run_step turns an ApiError into
        # a failure only AFTER this function returns, so the count the finally
        # tests has not moved yet.
        kept = True
        g.note(keep_log(log, SECONDCLIENT_KEPT_LOG))
        raise
    finally:
        if not kept and len(g.failures) > failures_before:
            g.note(keep_log(log, SECONDCLIENT_KEPT_LOG))
        client.kill()


FRAG_KILL = 500      # more than anyone's health and armour


def frag_board(g):
    """{slot: (score, deaths)} off the server's player_manager (the scoreboard's source)."""
    managers = g.api.ents("player_manager")
    if not managers:
        return None
    fields = g.api.fields(managers[0]["index"])
    board = {}
    for name, value in fields.items():
        kind, _, slot = name.partition(".")
        if kind in ("Score", "Deaths") and slot.isdigit():
            row = board.setdefault(int(slot), [0, 0])
            row[0 if kind == "Score" else 1] = int(value)
    return {k: tuple(v) for k, v in board.items()}


def step_frag_credit(g):
    """
    A KILL IS SCORED AS STOCK'S HL2MP SCORES IT, ON THE SCOREBOARD.

    Two players: this run's own and a second client. Through the dev API's
    damage route, each kill read off the player resource (Score, Deaths):
      * no attacker (the control): the victim's death, -1 frag; nobody else moves;
      * the first player kills the newcomer: +1 to the killer, a death to the victim;
      * a prop (an item_healthkit as attacker) kills: -1 to the victim, nobody credited;
      * the first player kills themselves: -1 and a death.
    That is CMultiplayRules::PlayerKilled with IPointsForKill 1 and the suicide
    penalty. Then: no "no route" refusal in console.log and no managed warning.
    """
    if g.no_second_client:
        g.skip("--no-second-client was given")
    scen, server = g.scen, g.api
    port = getattr(g, "server_port", None)
    if not port:
        g.check(False, "the gate could not tell which UDP port its own server bound")
        return
    sitting = server.ents(scen["playerClass"])
    if len(sitting) != 1:
        g.check(False, "the server holds %d players before the second client; this step starts from one" % len(sitting))
        return
    first = sitting[0]["index"]
    refusals = g.count_console("no route from that face back to a handle")
    warn_from = server.get("log", 999999, 1).get("next", 0)

    tmpdir = os.path.join(g.scratch, "client2")
    log = os.path.join(g.scratch, "live-gate-client2.log")
    client, _ = launch_with_free_port(client_launch, log, tmpdir)
    if client is None:
        g.note(keep_log(log, SECONDCLIENT_KEPT_LOG))
        g.check(False, "a second instance never opened a dev API socket")
        return
    failures_before = len(g.failures)
    try:
        for api in (server, client.api):
            api.convar("net_usesocketsforloopback", 1)
        time.sleep(1.0)
        client.api.cmd("connect 127.0.0.1:%d" % port)
        joined = server.wait_for(lambda: len(server.ents(scen["playerClass"])) >= 2, 90.0, 1.0)
        if not joined:
            g.check(False, "the second client never joined -- %s" % join_state(
                server, client.api, len(server.ents(scen["playerClass"])), log, port))
            return
        newcomer = next(p["index"] for p in server.ents(scen["playerClass"]) if p["index"] != first)

        def alive(slot):
            return server.fields(slot).get("Alive") == "true"

        def respawn(slot, api):
            # Dead players come back on a button after the respawn wait.
            def pressed():
                api.cmd("+jump")
                time.sleep(0.3)
                api.cmd("-jump")
                return alive(slot) or None
            return server.wait_for(pressed, 20.0, 1.0)

        g.check(bool(server.wait_for(lambda: alive(newcomer) or None, 60.0)), "the newcomer is alive")

        def kill(victim, attacker=None):
            before = frag_board(g)
            args = ["hurt", "#%d" % victim, FRAG_KILL, "", ""]
            if attacker is not None:
                args.append("#%d" % attacker)
            reply = server.get(*args)
            server.wait_for(lambda: not alive(victim) or None, 5.0)
            time.sleep(0.5)    # the player resource's next think
            after = frag_board(g)
            delta = {s: (after[s][0] - before[s][0], after[s][1] - before[s][1])
                     for s in (first, newcomer)}
            return reply, delta

        reply, d = kill(newcomer)
        g.check(d[newcomer] == (-1, 1) and d[first] == (0, 0),
                "no attacker (control): the victim -1 frag and a death, nobody credited (%s)" % d)
        g.check(bool(respawn(newcomer, client.api)), "the newcomer respawned")

        def deaths_heard():
            return server.get("client", str(first), "status").get("gameEvents", {}).get("player_death", 0)

        heard_before, scored_before = deaths_heard(), g.count_console("[SourceSharp/Score]")
        reply, d = kill(newcomer, first)
        g.check(d[first] == (1, 0) and d[newcomer] == (0, 1),
                "player %d killing player %d: +1 frag to the killer, a death to the victim (%s)" % (first, newcomer, d))
        # player_death through the ENGINE's game events (DeathNotice): the
        # client hears it, and the server's rules score it off the same event.
        heard = server.wait_for(lambda: deaths_heard() > heard_before or None, 5.0)
        g.check(bool(heard), "the client received player_death (%d -> %d)" % (heard_before, deaths_heard()))
        g.check(g.count_console("[SourceSharp/Score]") > scored_before,
                "the server's rules scored it off the event (a [SourceSharp/Score] line)")
        g.check(bool(respawn(newcomer, client.api)), "the newcomer respawned")

        props = server.ents(scen["healthItemClass"])
        if props:
            reply, d = kill(newcomer, props[0]["index"])
            g.check(d[newcomer] == (-1, 1) and d[first] == (0, 0),
                    "a %s killing the newcomer: -1 to the victim, the prop scores nothing (%s)" % (props[0]["classname"], d))
            g.check(bool(respawn(newcomer, client.api)), "the newcomer respawned")
        else:
            g.check(False, "this map has no %s to kill with" % scen["healthItemClass"])

        reply, d = kill(first, first)
        g.check(d[first] == (-1, 1) and d[newcomer] == (0, 0),
                "player %d killing themselves: -1 frag and a death (%s)" % (first, d))
        g.check(bool(respawn(first, server)), "the first player respawned")

        g.check(g.count_console("no route from that face back to a handle") == refusals,
                "no handle refusal in console.log (%d before, %d after)"
                % (refusals, g.count_console("no route from that face back to a handle")))
        # The damage path's warnings fail the step. The map's own (a rope with
        # no next key, a bash trigger aimed at an entity dm_lockdown lacks)
        # fire when the newcomer loads and moves, whatever the scoring does:
        # they are named, not gated (2026-10-05, 6 a pass, none about damage).
        warnings = [l["text"].rstrip() for l in server.get("log", warn_from, 500).get("lines", []) if l.get("warning")]
        damage = [w for w in warnings if re.search(r"attacker|handle|damage|frag|score|kill|refus", w, re.I)
                  and "unhandled input" not in w]
        g.check(not damage, "no damage-path warning during the step (%d): %s" % (len(damage), damage[:3]))
        if len(warnings) > len(damage):
            g.say("    note  %d map warning(s) during the step, not gated: %s"
                  % (len(warnings) - len(damage), [w[:80] for w in warnings if w not in damage][:3]))
        client.api.cmd("disconnect")
        server.wait_for(lambda: len(server.ents(scen["playerClass"])) == 1, 30.0)
        # THE BODIES GO WITH THE STEP. Each kill left a ragdoll that times out
        # on its own (SsRagdoll.Lifetime, 15 s) -- a few seconds into whatever
        # runs next. hot-reload's census is an equality across its reload, so
        # a body expiring inside it read as three entities "lost" and the
        # census never "back" (a 90 s wait, 2026-10-05). Removed here,
        # answered once gone.
        bodies = server.ents(scen["ragdollClass"])
        if bodies:
            server.remove(**{"class": scen["ragdollClass"]})
            g.check(not server.ents(scen["ragdollClass"]),
                    "the %d body(ies) this step's kills left are removed before the next step" % len(bodies))
    finally:
        if len(g.failures) > failures_before:
            g.note(keep_log(log, SECONDCLIENT_KEPT_LOG))
        client.kill()


def step_round_end(g):
    """
    THE FRAG LIMIT ENDS THE ROUND AS STOCK HL2MP ENDS IT, AND THE LEVEL CHANGES.

    Two players (frag-credit's second client). mp_fraglimit two frags above
    the first player's score as the run left it, mp_chattime 3. The first
    kill is under the limit: no scoreboard (the control). The
    last, scored off player_death, sends the rules to the intermission: the
    UI's scoreboard opens on the client (the server's VGUIMenu "scores"), and
    mp_chattime later the server changes level ("CHANGE LEVEL: dm_lockdown":
    no map cycle, so the current map), the level loads again, and the player
    rejoins alive. A second map load in one process, which this step keeps.
    """
    if g.no_second_client:
        g.skip("--no-second-client was given")
    scen, server = g.scen, g.api
    port = getattr(g, "server_port", None)
    if not port:
        g.check(False, "the gate could not tell which UDP port its own server bound")
        return
    sitting = server.ents(scen["playerClass"])
    if len(sitting) != 1:
        g.check(False, "the server holds %d players before the second client; this step starts from one" % len(sitting))
        return
    first = sitting[0]["index"]

    tmpdir = os.path.join(g.scratch, "client2")
    log = os.path.join(g.scratch, "live-gate-client2.log")
    client, _ = launch_with_free_port(client_launch, log, tmpdir)
    if client is None:
        g.note(keep_log(log, SECONDCLIENT_KEPT_LOG))
        g.check(False, "a second instance never opened a dev API socket")
        return
    failures_before = len(g.failures)
    try:
        for api in (server, client.api):
            api.convar("net_usesocketsforloopback", 1)
        time.sleep(1.0)
        client.api.cmd("connect 127.0.0.1:%d" % port)
        if not server.wait_for(lambda: len(server.ents(scen["playerClass"])) >= 2, 90.0, 1.0):
            g.check(False, "the second client never joined -- %s" % join_state(
                server, client.api, len(server.ents(scen["playerClass"])), log, port))
            return
        newcomer = next(p["index"] for p in server.ents(scen["playerClass"]) if p["index"] != first)

        def alive(slot):
            return server.fields(slot).get("Alive") == "true"

        def respawn(slot, api):
            def pressed():
                api.cmd("+jump")
                time.sleep(0.3)
                api.cmd("-jump")
                return alive(slot) or None
            return server.wait_for(pressed, 20.0, 1.0)

        def scores_open():
            return "scoreboard" in ui_menu(g, first).get("open", [])

        server.wait_for(lambda: alive(newcomer) or None, 60.0)
        server.cmd("mp_chattime 3")
        server.cmd("nextlevel %s" % scen["map"])   # the cycle stays where it is; this run stays on its map
        server.cmd("cs_sv_fraglimit 0")
        # Two frags from WHERE THE RUN LEFT THE FIRST PLAYER: earlier steps
        # (die, frag-credit's suicide) leave its score below zero in the full
        # gate, and stock's limit is the player's frag count, so a bare
        # mp_fraglimit 2 was never reached there (the 2026-10-11 squash gate,
        # 2 of 2 red; green in every subset run).
        # A limit must be positive to be on, so a score below -1 takes more.
        start = ((frag_board(g) or {}).get(first) or (0, 0))[0]
        limit = max(start + 2, 1)
        server.cmd("mp_fraglimit %d" % limit)
        changes = g.count_console("CHANGE LEVEL:")

        server.get("hurt", "#%d" % newcomer, 500, "", "", "#%d" % first)
        time.sleep(1.5)
        g.check(not scores_open(), "a frag under the limit (score %d, mp_fraglimit %d): the round goes on and no scoreboard opens (the control)" % (start, limit))
        g.check(bool(respawn(newcomer, client.api)), "the newcomer respawned")
        for _ in range(limit - start - 2):     # only from a score below -1
            server.get("hurt", "#%d" % newcomer, 500, "", "", "#%d" % first)
            time.sleep(1.5)
            g.check(bool(respawn(newcomer, client.api)), "the newcomer respawned")

        server.get("hurt", "#%d" % newcomer, 500, "", "", "#%d" % first)
        opened = server.wait_for(lambda: scores_open() or None, 5.0)
        g.check(bool(opened), "the frag that reaches mp_fraglimit opens the client's scoreboard")
        g.check(g.count_console("[SourceSharp/Rules] intermission:") > 0, "the server is in intermission")

        changed = server.wait_for(lambda: g.count_console("CHANGE LEVEL:") > changes or None, 15.0)
        g.check(bool(changed), "mp_chattime later the server changes level (%s)"
                % g.last_console_line("CHANGE LEVEL:"))
        reached = server.wait_for(lambda: server.census()[0] >= scen["entities"], 180.0, 1.0)
        g.check(bool(reached), "the level loaded again (%d entities)" % server.census()[0])
        back = server.wait_for(lambda: (lambda p: p and p["health"] > 0)(server.player(scen["playerClass"])), 90.0, 1.0)
        g.check(bool(back), "the player rejoined it alive")
        if back:
            rejoined = server.player(scen["playerClass"])["index"]
            # Stock's game_newmap hides every viewport panel: the intermission's
            # scoreboard does not follow the player into the new level.
            g.check("scoreboard" not in ui_menu(g, rejoined).get("open", []),
                    "the new level hid the intermission's scoreboard (open %s)" % (ui_menu(g, rejoined).get("open"),))
            join_motd(g, rejoined)
    finally:
        try:
            server.cmd("mp_fraglimit 0")
            server.cmd('nextlevel ""')
            client.api.cmd("disconnect")
        except ApiError:
            pass
        if len(g.failures) > failures_before:
            g.note(keep_log(log, SECONDCLIENT_KEPT_LOG))
        client.kill()
        server.wait_for(lambda: len(server.ents(scen["playerClass"])) == 1, 30.0)


def step_chat(g):
    """
    SAY REACHES EVERY CLIENT AND DRAWS ONE CHAT LINE; SAY_TEAM ONLY THE TEAM;
    EMPTY NOTHING (stock Host_Say on the server, CBaseHudChat on the client).

    Two clients (frag-credit's second). The server half is read as each
    client's received SayText2 count; the client half as client 1's chat
    lines (its UI's Text draws). Client 2 says a marked line: both clients
    receive it, the server logs it as stock's '"name<userid><id><team>" say
    "text"', and client 1 draws ONE line, the speaker's name and the text
    (the control first: none before). Client 1 says one through messagemode:
    the input line opens, typed characters and Enter send `say`, both
    clients receive it and the input closes. Client 2 says one to the team:
    HL2MP without teamplay has no teammates, so only client 2 sees its own
    line. An empty say sends nothing (the control).
    """

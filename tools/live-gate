    # only the two pids the object happens to hold -- the launcher and the game
    # -- leaves hl2.sh standing. The stand-in below has the same shape and the
    # same middle: outer bash -> middle bash -> sleep, with the middle holding
    # work of its own so that it does not simply exit when its child dies.
    outer = subprocess.Popen(
        ["bash", "-c", "bash -c 'sleep 40; sleep 40'; true"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True)
    try:
        pgid = os.getpgid(outer.pid)
        middle = wait_for_child(outer.pid)
        deep = wait_for_child(middle) if middle else None
        ok(deep is not None, "the three-deep stand-in for a launch really was built")

        Game(deep, outer, None, None).kill()

        left = []
        deadline = time.time() + 5.0
        while time.time() < deadline:
            left = subprocess.run(["ps", "-o", "pid=", "-g", str(pgid)],
                                  capture_output=True, text=True).stdout.split()
            if not left:
                break
            time.sleep(0.1)
        ok(not left,
           "Game.kill leaves NOTHING in the launch's process group -- killing "
           "only the launcher and the game leaves the middle standing, which "
           "is one leaked game per launch (left: %r)" % (left,))
    finally:
        try:

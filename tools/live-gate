ALLOC_UNLOAD = re.compile(r"unload: (\d+) allocations, (\d+) releases, (\d+) mismatches, "
                          r"(\d+) foreign frees, (\d+) live")


def server_carries_alloc_check():
    so = os.path.join(MOD_DIR, "bin", "linux64", "server.so")
    try:
        syms = subprocess.run(["nm", "--defined-only", so], stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, text=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return False
    return any(l.split()[-1] == "__wrap_malloc" for l in syms.splitlines() if l.strip())


# HOW THE GAME WENT AWAY, when the gate did not ask it to. A dead game used
# to surface as "the dev API stopped answering" and then "the game died",
# which reads the same for a crash, a kill and the user closing the window,
# and only the first is the build's fault. source# returns the game's own
# exit code, and .NET reports a child killed by signal N as 128 + N; a
# launch's popen is source# itself (bash execs it), so its returncode is that.
KILL_SIGNALS = {1: "SIGHUP", 2: "SIGINT", 9: "SIGKILL", 15: "SIGTERM"}
CRASH_SIGNALS = {4: "SIGILL", 6: "SIGABRT", 7: "SIGBUS", 8: "SIGFPE", 11: "SIGSEGV"}
FATAL_EXIT = 253   # the launcher's FatalExitCode: Error() or a fatal assert
ORDERLY_SHUTDOWN = ("Host_WriteConfiguration", "UnloadSide(")


def exit_record(pid, socket_dir=None):
    """The exit record the game wrote on its way out
    (<DEBUG_API_DIR>/<pid>.exit.json; docs/api.md "How a game ended"), or
    None. It names WHO asked: a dev API quit, a signal and its sender's pid
    and command line, a window close, a typed quit, a fatal stop."""
    path = os.path.join(socket_dir or SOCKET_DIR, "%s.exit.json" % pid)
    try:
        with open(path) as handle:
            return json.load(handle)
    except (IOError, ValueError):
        return None


def describe_exit_record(record):
    """One line from an exit record: the reason and who sent it."""
    if not record:
        return "no exit record (it ended before the dev API came up, or died without a shutdown)"
    detail = record.get("detail") or {}
    reason = record.get("reason")
    if reason == "signal":
        return ("exit record: %s from pid %s (%s), at map %s tick %s"
                % (detail.get("signal"), detail.get("senderPid"),
                   detail.get("sender") or "sender gone", record.get("map"), record.get("tick")))
    if reason == "api-command":
        return "exit record: %r sent through the dev API (request %s)" % (
            detail.get("command"), detail.get("requestSeq"))
    if reason == "fatal":
        return "exit record: fatal %s: %s" % (record.get("kind"), str(record.get("message", "")).strip())
    return "exit record: %s %s" % (reason, json.dumps(detail))


def classify_exit(returncode, log_tail):
    """(kind, why) for a game that exited without being asked to.

    kind is "closed" (an orderly engine shutdown nobody here requested: the
    window closed, or `quit` typed at the console), "killed" (a signal from
    outside), "crashed" (a crash signal or a fatal stop) or "unknown". Only
    "crashed" is a failure of the build; the other two interrupt the run.
    """
    if returncode is None:
        return "unknown", "the exit status could not be collected"
    code = returncode
    if code < 0:          # the launcher itself died of a signal
        code = 128 - code
    if code == FATAL_EXIT:
        return "crashed", "it stopped on a fatal error (exit %d)" % FATAL_EXIT
    if code > 128:
        sig = code - 128
        if sig in CRASH_SIGNALS:
            return "crashed", "it died of %s (exit %d)" % (CRASH_SIGNALS[sig], code)
        if sig in KILL_SIGNALS:
            return "killed", "it was killed by %s (exit %d) from outside the gate" % (KILL_SIGNALS[sig], code)
        return "unknown", "it died of signal %d (exit %d)" % (sig, code)
    if code == 0 and any(m in log_tail for m in ORDERLY_SHUTDOWN):
        return "closed", ("it shut down in order (exit 0) without the gate asking: "
                          "the window was closed, `quit` was typed, or it was sent SIGTERM "
                          "(which the engine turns into an orderly quit)")
    return "unknown", "it exited with code %d" % code


def log_tail(path, lines=400):
    try:
        with open(path, errors="replace") as f:
            return "".join(f.readlines()[-lines:])
    except OSError:
        return ""


def check_alloc_boundary(gate, log_path):
    """The user's rule (plan_server_novalve.md 3.6): memory is never freed across
    the engine/mod boundary. A debug server.so carries the allocation checker,
    and its last word at unload counts every block server.so freed that it did
    not allocate. The gate is where the engine's own calls (sounds, joins, map
    reloads) exercise that, so the gate reads it: a foreign free or a mismatch
    fails, and a checker build that left no report fails too."""
    if not server_carries_alloc_check():
        print("    note  server.so carries no allocation checker (release): boundary not measured")
        return
    try:
        with open(log_path, errors="replace") as f:
            reports = ALLOC_UNLOAD.findall(f.read())
    except OSError as e:
        reports = []
        print("    FAIL  cannot read %s: %s" % (log_path, e))
    if not reports:
        gate.failures.append(("alloc-boundary", "no allocation checker report at unload"))
        print("    FAIL  server.so carries the allocation checker but left no unload report")
        return
    allocs, _, mismatches, foreign, live = (int(x) for x in reports[-1])
    if allocs == 0:
        gate.failures.append(("alloc-boundary", "the checker saw no allocation"))
        print("    FAIL  the allocation checker saw no allocation")
    elif mismatches or foreign:
        gate.failures.append(("alloc-boundary", "%d mismatches, %d foreign frees" % (mismatches, foreign)))
        print("    FAIL  memory crossed the engine/mod boundary: %d mismatches, %d foreign frees "
              "(the report and backtraces are in %s)" % (mismatches, foreign, log_path))
    else:
        print("    ok    no memory crossed the boundary: %d allocations, 0 mismatches, 0 foreign "
              "frees (%d live at unload; the snapshot holds those to docs/alloc-live-allow.tsv)"
              % (allocs, live))


# A clean shutdown says nothing of these, and each is a leak or a double release
# that the gate's steps cannot see: the module's load context pinned past its
# unload (Entry.UnloadModule), a managed-built object released by both sides
# (ManagedVtable), and objects native never released (ServerModule.Shutdown).
# Each pattern is the whole message, so a reworded line cannot slip past as a
# substring of something else.
SHUTDOWN_FAULTS = [
    ("ALC unload", re.compile(r"\b(?:Server|Client)ALC did NOT unload\b")),
    ("double release", re.compile(r"System\.ObjectDisposedException: \w+ was released twice")),
    ("still bound", re.compile(r"\d+ managed-built object\(s\) were still bound at shutdown")),
]


def shutdown_faults(text):
    """{name: count} of the SHUTDOWN_FAULTS lines in a game log. PURE, so
    --self-test drives it."""
    found = {}
    for name, pattern in SHUTDOWN_FAULTS:
        n = len(pattern.findall(text))
        if n:
            found[name] = n
    return found


def check_shutdown_faults(gate, log_path):
    """The game's own log, read after it quit: any of SHUTDOWN_FAULTS fails the
    gate. An unreadable log fails too -- it is the only place these lines go,
    since they print after console.log has closed."""
    try:
        with open(log_path, errors="replace") as f:
            text = f.read()
    except (OSError, TypeError) as e:
        gate.failures.append(("shutdown-faults", "cannot read the game log"))
        print("    FAIL  cannot read the game log %s: %s" % (log_path, e))
        return
    found = shutdown_faults(text)
    if found:
        what = ", ".join("%s x%d" % kv for kv in sorted(found.items()))
        gate.failures.append(("shutdown-faults", what))
        print("    FAIL  the game log reports a leak or double release: %s (see %s)"
              % (what, log_path))
    else:
        print("    ok    no unload pin, double release or object still bound at shutdown")


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="the live gate of plan_entity.md §5",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__)
    parser.add_argument("--map", default="dm_lockdown")
    # --ents / --classes are the bash live-gate's flags and the Makefile's
    # comment still documents them, so they keep working. They OVERRIDE the
    # scenario file rather than replacing it: a different map needs its own
    # scenario for the fifteen steps that are not a census.
    parser.add_argument("--ents", type=int, default=None)
    parser.add_argument("--classes", type=int, default=None)
    parser.add_argument("--passes", type=int, default=2,
                        help="how many times to run the whole checklist in ONE "
                             "process. The gate is 2; one pass is not the gate.")
    parser.add_argument("--record", action="store_true",
                        help="write tools/live-gate-budget.tsv from this run")
    parser.add_argument("--record-totals", action="store_true",
                        help="merge this run's SHORT-stage samples into the "
                             "budget already on disk and re-derive only the "
                             "total-gated ceilings; every rate-gated ceiling "
                             "is carried across untouched. Run it more than "
                             "once: a raise needs %d samples."
                             % MIN_SAMPLES_FOR_TOTAL)
    parser.add_argument("--budget", default=BUDGET)
    parser.add_argument("--attach", action="store_true",
                        help="gate a game that is already up; needs DEBUG_API_PID")
    parser.add_argument("--keep", action="store_true",
                        help="leave the game running afterwards")
    parser.add_argument("--no-second-client", action="store_true",
                        help="do not run the second-client step. Its skip is "
                             "NOT in the ledger, so this still fails the gate: "
                             "dropping a step is a thing you may do, not a "
                             "thing you may do and still be told you passed.")
    parser.add_argument("--skips", default=SKIP_LEDGER,
                        help="the recorded-skip ledger (tools/live-gate-skips.tsv)")
    parser.add_argument("--strict", action="store_true",
                        help="EVERY skipped step fails, the recorded ones too")
    parser.add_argument("--self-test", action="store_true",
                        help="check the parts that need no game, and exit")
    parser.add_argument("--steps", default=None,
                        help="comma-separated step ids: run only these (in the "
                             "gate's order, after `join`, which every step "
                             "needs). For confirming and bisecting a failure "
                             "(tools/daily-gate); a subset is NOT the gate")
    parser.add_argument("--verdicts", default=None,
                        help="write this run's verdicts as JSON here: steps "
                             "run, each step's verdict per pass, the failures "
                             "and the exit code -- whatever way the run ends")
    args = parser.parse_args(argv)

    order = RUN_ORDER
    if args.steps:
        wanted = [s for s in args.steps.split(",") if s]
        unknown = [s for s in wanted if s not in RUN_ORDER]
        if unknown or not wanted:
            print("live-gate: --steps names no step of this gate: %s (have: %s)"
                  % (" ".join(unknown) or "(none)", " ".join(RUN_ORDER)), file=sys.stderr)
            return 64
        order = [s for s in RUN_ORDER if s == "join" or s in wanted]

    state = {"verdicts": {}, "failures": [], "skip_failures": []}
    rc = 70   # an exception escaping _run is a failure, never a pass
    try:
        rc = _run(args, order, state)
        return rc
    finally:
        if args.verdicts:
            write_verdicts(args.verdicts, order, args.passes, state, rc)


def write_verdicts(path, order, passes, state, rc):
    """The run's verdicts as JSON (tools/daily-gate reads it). Written however
    the run ended; `exit` is the gate's own exit code."""
    doc = {"steps": list(order), "passes": passes, "exit": rc,
           "verdicts": state["verdicts"],
           "failures": [[str(step), str(msg)] for step, msg in state["failures"]],
           "skip_failures": list(state["skip_failures"])}
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(doc, f, indent=1, sort_keys=True)
    os.replace(tmp, path)


def _run(args, order, state):

    if args.self_test:
        return self_test()

    # READ BEFORE ANYTHING IS LAUNCHED. A malformed or missing ledger is a
    # reason not to start: discovering it at the end costs the whole run, and a
    # gate that announces after forty minutes that its own configuration is
    # broken is a gate people learn to run without.
    ledger, ledger_errors = read_skip_ledger(args.skips)
    if ledger_errors:
        for problem in ledger_errors:
            print("live-gate: %s" % problem, file=sys.stderr)
        return 64
    print("== skip ledger %s: %d recorded skip(s) %s"
          % (args.skips, len(ledger), sorted(ledger)))

    scenario = load_scenario(args.map)
    if args.ents is not None:
        scenario["entities"] = args.ents
    if args.classes is not None:
        scenario["classes"] = args.classes
    scratch = os.path.join("/tmp", "sourcesharp-live-gate-%d" % os.getpid())
    os.makedirs(scratch, exist_ok=True)

    game = None
    log_path = None
    own_log = False

    if args.attach:
        pid = os.environ.get("DEBUG_API_PID")
        if not pid:
            print("live-gate: --attach needs DEBUG_API_PID -- which game is never "
                  "guessed at", file=sys.stderr)
            return 64
        api = Api(pid)
        print("== attached to pid %s" % pid)
    else:
        log_path = os.path.join(ROOT, "tools", ".live-gate.log")
        own_log = True
        print("== launching %s (log: %s)" % (scenario["map"], log_path))

        # -maxplayers, or maxClients is 1 and the second client has no slot to
        # join; net_usesocketsforloopback, or its packets never leave this
        # process. Both are in the header; both cost an afternoon when absent.
        #
        # -port, +clientport, +tv_port AND -strictportbind -- see the port
        # block above for the day the first cost and the four-arm run that
        # showed the other three are one flag. Without them this server takes
        # 27015 if it is free and 27016 IN SILENCE if it is not, while step 13's
        # second client goes on connecting to 27015 -- which is then another
        # lane's game. With them a port this gate did not get is an exit, and
        # launch_with_free_port redraws once rather than failing the run.
        game, wanted_port = launch_with_free_port(
            lambda port: server_launch(port, scenario["map"]),
            log_path, os.path.join(scratch, "server"))
        print("== this run's server port is %d (NOT 27015; see the port block "
              "in this file)" % wanted_port)

        if game is None:
            print("== NO SOCKET. The port asked for was %d." % wanted_port)
            print("== NO SOCKET. The game never came up; read %s, and read the "
                  "'Device :' line in it before anything else "
                  "(tools/gpu-offload). If it says 'no bundled libhostfxr', run "
                  "tools/worktree-setup." % log_path)
            return 1

        api = game.api
        print("== game pid %s" % api.pid)

    gate = Gate(api, scenario)
    state["failures"] = gate.failures
    gate.no_second_client = args.no_second_client

    # WHICH PORT DID IT ACTUALLY GET. Asked of /proc rather than assumed from
    # the launch line: -strictportbind IS passed now and should make this
    # unnecessary, and a should is not a check -- for two days this comment said
    # the same thing about a flag the gate was not passing at all. Discovered
    # even under --attach, where there was no launch line of ours at all.
    gate.server_port = bound_server_port(api, None if args.attach else wanted_port)
    print("== the server's UDP port is %s (hostport asked for %s)"
          % (gate.server_port,
             api.convar("hostport").get("value") if api.alive() else "?"))
    if not args.attach and gate.server_port != wanted_port:
        # LOUD. Not fatal -- the gate dials what it measured and carries on --
        # but a run that had to move is a run that raced somebody, and the next
        # person reading this output should know the box was not theirs alone.
        print("!! the server asked for %d and is on %s: something else on this "
              "box held it. The engine's bind loop walks upward in silence "
              "(a developer-level message). Step 13 will dial %s. Check "
              "`ss -ulnp | grep 270` and `pgrep -a hl2_linux64`."
              % (wanted_port, gate.server_port, gate.server_port))
    gate.scratch = scratch
    gate.own_log = own_log
    gate.count_log = lambda needle: count_in(log_path, needle)

    # THE LAST LINE OF THE LOG CARRYING `needle`, or None.
    #
    # count_log answers HOW MANY and step 3c's two native readouts need WHAT:
    # "GetPlayerState answered out of the block" is a NUMBER printed on a line,
    # and a gate that could only count lines would have to match the number as
    # text -- which is how a check ends up asserting a spacing.
    #
    # The LAST match and not the first, because the gate runs twice in one
    # process and both passes print the same report.
    gate.last_log_line = lambda needle: last_line_in(log_path, needle)

    # THE ENGINE'S OWN CONSOLE LOG, WHICH IS NOT THE SAME FILE, and step 3c
    # needed both to find out. -condebug writes bin/<config>/mods/test/console.log and
    # the launcher's stdout is captured separately; MOST Msg() output reaches
    # both, but not all of it does. The boundary probe's forty rows and
    # cs_sv_playerinfo's readout appear in console.log and NOT in stdout, on the
    # same run, measured -- so a check reading count_log for them reports
    # "nothing was printed" about output that was printed.
    #
    # Only the gate's own server carries -condebug (client_launch says why), so
    # this file is that instance's and no other's. It ACCUMULATES across runs,
    # which is why every reader below counts a before and waits for an increase
    # rather than trusting an absolute number.
    #
    # READ THROUGH /console NOW, not by re-reading the file. The file
    # accumulates across runs and every poll read all of it; the API follows
    # it from this game's start, and ConsoleMirror keeps what it has read.
    attach_console(gate, api)

    budget = read_budget(args.budget)
    if not budget:
        print("== no budget file at %s; this run only records one" % args.budget)


    report = {}
    recorded = []
    verdicts = state["verdicts"]
    decals = 0
    exit_code = 0
    died_early = False   # the game went away before the gate asked it to

    try:
        if not api.wait_map(scenario["entities"], 240.0):
            print("== the map never reached %d entities; giving up"
                  % scenario["entities"])
            entities, classes = api.census()
            print("   the server answers %d entities / %d classes" % (entities, classes))
            return 1

        for pass_number in range(1, args.passes + 1):
            print("\n" + "=" * 70)
            print("PASS %d of %d" % (pass_number, args.passes))
            print("=" * 70)

            for step_id in order:
                verdict, _rate = run_step(gate, step_id, budget, recorded, report)
                verdicts.setdefault(step_id, []).append(verdict)

                if not api.alive():
                    returncode = None
                    if game and game.popen:
                        try:
                            returncode = game.popen.wait(timeout=15)
                        except Exception:
                            pass
                    kind, why = classify_exit(returncode, log_tail(log_path))
                    # WHO ASKED, from the game itself: classify_exit can only
                    # say "closed, typed or SIGTERM" from a status and a tail.
                    print("\n== %s" % describe_exit_record(exit_record(api.pid)))
                    if kind == "crashed":
                        print("\n== the game CRASHED during %r: %s. Nothing after it ran."
                              % (step_id, why))
                        gate.failures.append((step_id, "the game crashed: " + why))
                    elif kind in ("closed", "killed"):
                        print("\n== the game was %s OUTSIDE THE GATE during %r: %s. Nothing "
                              "after it ran: this run was INTERRUPTED, not failed by the "
                              "build -- rerun it." % (kind.upper(), step_id, why))
                        gate.failures.append((step_id, "interrupted: the game was %s outside "
                                                       "the gate (%s)" % (kind, why)))
                    else:
                        print("\n== the game died during %r: %s. Nothing after it ran."
                              % (step_id, why))
                        gate.failures.append((step_id, "the process died: " + why))
                    died_early = True
                    raise KeyboardInterrupt

            print("\n-- the log")
            decals = log_checks(gate, decals) or decals

            if pass_number < args.passes:
                # The shutdown step left no world. Put one back, so the next
                # pass is the whole checklist over again rather than a shorter
                # one -- which is the entire point of running it twice.
                print("\n== reloading %s for pass %d"
                      % (scenario["map"], pass_number + 1))
                api.cmd("map %s" % scenario["map"])
                if not api.wait_map(scenario["entities"], 240.0):
                    gate.failures.append(("between passes",
                                          "the map would not load again"))
                    break
    except KeyboardInterrupt:
        pass
    finally:
        if game and not args.keep and died_early:
            print("\n    note  the process had already exited before the quit (see above)")
            game.kill()
        elif game and not args.keep:
            # The quit is itself the last of step 16, when this process owns
            # the game: "clean shutdown" is not only an empty entity list, it
            # is a process that goes away when asked.
            try:
                api.cmd("quit")
            except ApiError:
                pass
            for _ in range(60):
                if not api.alive():
                    break
                time.sleep(1.0)
            if api.alive():
                gate.failures.append(("shutdown", "the process did not quit when asked"))
                print("\n    FAIL  the process did not exit within 60s of `quit`")
            else:
                print("\n    ok    the process exited when asked to quit")
                check_alloc_boundary(gate, log_path)
                check_shutdown_faults(gate, log_path)
            game.kill()
        shutil.rmtree(scratch, ignore_errors=True)

    #-- the report -----------------------------------------------------------
    print("\n" + "=" * 70)
    print("THE SIXTEEN STEPS, in plan_entity.md §5's order")
    print("=" * 70)
    for step_id, title, _func in STEPS:
        got = verdicts.get(step_id, [])
        marks = " ".join(v.upper() for v in got) if got else "NOT RUN"
        print("  %-14s %-46s %s" % (step_id, title, marks))

    print("\nAND WHAT IS NOT IN §5")
    for step_id, title, _func in EXTRA_STEPS:
        got = verdicts.get(step_id, [])
        marks = " ".join(v.upper() for v in got) if got else "NOT RUN"
        print("  %-14s %-46s %s" % (step_id, title, marks))
    print("  %-14s %s" % ("hltv/replay", COVERAGE_HLTV))

    times = report.get("times", [])
    if times:
        print("\nWHERE THE TIME WENT (wall seconds / server ticks, per pass)")
        by_step = collections.OrderedDict()
        for step_id, wall, ticks in times:
            by_step.setdefault(step_id, []).append((wall, ticks))
        for step_id, rows in by_step.items():
            print("  %-18s %s" % (step_id, "  ".join("%7.1f s %6d t" % row for row in rows)))
        print("  %-18s %7.1f s %6d t  (all passes)"
              % ("total", sum(t[1] for t in times), sum(t[2] for t in times)))

    skips = report.get("skips", [])
    if skips:
        print("\n" + "!" * 70)
        print("%d STEP(S) SKIPPED -- these did NOT run and are NOT passes" % len(skips))
        for step_id, why in skips:
            print("  %-14s %-9s %s"
                  % (step_id,
                     "recorded" if step_id in ledger else "UNRECORDED", why))
        print("!" * 70)

    #-- the skip ledger, both directions -------------------------------------
    unexpected, stale, unknown = skip_findings(
        verdicts, ledger, [step[0] for step in ALL_STEPS])
    skip_failures = state["skip_failures"]

    for step_id in unexpected:
        why = next((w for s, w in skips if s == step_id), "")
        skip_failures.append(
            "%s SKIPPED and is not in %s. A step that skips did not run. If the "
            "game genuinely cannot do this yet, record it there with an owner "
            "and a reason; otherwise this is a regression. Reason given: %s"
            % (step_id, args.skips, why))

    for step_id in stale:
        owner, reason = ledger[step_id]
        skip_failures.append(
            "%s is recorded as an expected skip and DID NOT SKIP (%s). Delete "
            "its row from %s -- a row left standing waives the NEXT regression "
            "in this step for as long as it sits there. Owner %s, recorded "
            "reason: %s"
            % (step_id, " ".join(v.upper() for v in verdicts[step_id]),
               args.skips, owner, reason))

    for step_id in unknown:
        skip_failures.append(
            "%s is in %s and is not a step of this gate. A row naming a step "
            "that does not exist waives nothing while looking as if it does."
            % (step_id, args.skips))

    if args.strict:
        for step_id, why in skips:
            if step_id not in unexpected:
                skip_failures.append(
                    "%s skipped and --strict was given: %s" % (step_id, why))

    if skip_failures:
        print("\n" + "!" * 70)
        print("THE SKIP LEDGER (%s) DISAGREES WITH THIS RUN" % args.skips)
        for problem in skip_failures:
            print("  - %s" % problem)
        print("!" * 70)

    if args.record or args.record_totals:
        # A RATE row is still taken from the FIRST pass: the later passes run
        # on a world that has already been torn down once, and a rate recorded
        # from those would bake that in. A TOTAL row takes every pass, because
        # for a short stage the run-to-run spread IS the quantity being
        # measured and one pass cannot see it.
        notes = write_budget(args.budget, recorded, budget,
                             merge=args.record_totals)
        print("\n== recorded the crossing budget of this build into %s%s"
              % (args.budget, " (short stages merged)" if args.record_totals else ""))
        for note in notes:
            print("   %s" % note)

    print("\nCROSSING BUDGET, per stage, this run")
    print("  %-14s %10s %8s %11s %11s %10s"
          % ("stage", "crossings", "frames", "per frame", "ceiling", "gated on"))
    on_disk = read_budget(args.budget)
    for stage, total, frames in recorded:
        row = on_disk.get(stage)
        rated = frames >= MIN_FRAMES_FOR_RATE
        ceiling = ("%.3f" % row.ceiling_rate if rated
                   else "%d" % row.ceiling_total) if row else "-"
        print("  %-14s %10d %8d %11.3f %11s %10s"
              % (stage, total, frames, per_frame(total, frames), ceiling,
                 "rate" if rated else "total"))

    # The total-gated rows carry their own evidence, and a reader deciding
    # whether a ceiling is loose on purpose or loose by accident needs the
    # sample count next to it rather than in the file.
    short = [(stage, on_disk[stage]) for stage, _t, frames in recorded
             if frames < MIN_FRAMES_FOR_RATE and stage in on_disk]
    if short:
        seen = set()
        print("\n  total-gated stages: the ceiling is total_max*1.5+200 over N "
              "samples (%d wanted for a raise)" % MIN_SAMPLES_FOR_TOTAL)
        for stage, row in short:
            if stage in seen:
                continue
            seen.add(stage)
            print("    %-14s ceiling %6d from %d sample(s) spanning %d..%d%s"
                  % (stage, row.ceiling_total, row.samples, row.total_min,
                     row.total_max,
                     "" if row.samples >= MIN_SAMPLES_FOR_TOTAL
                     else "   <- under-sampled, see --record-totals"))

    print()
    if gate.failures or skip_failures:
        print("LIVE GATE FAILED -- %d check(s), %d skip-ledger problem(s)"
              % (len(gate.failures), len(skip_failures)))
        for step_id, message in gate.failures:
            print("  %-14s %s" % (step_id, message))
        for problem in skip_failures:
            print("  %-14s %s" % ("skip-ledger", problem))
        exit_code = 1
    else:
        # THE COUNT, NOT THE WORD "sixteen". §5's sixteen plus the extras is
        # eighteen today and was seventeen last week; a line that says sixteen
        # while running eighteen is how a reader stops reading it. STEPS is
        # still pinned at sixteen by --self-test -- that is the number that
        # must not drift, and this is not it.
        if args.steps:
            print("LIVE GATE SUBSET PASSED -- %d pass(es) of %s. A subset is NOT "
                  "the gate." % (args.passes, ", ".join(order)))
            return exit_code
        print("LIVE GATE PASSED -- %d pass(es) of %d step(s) (§5's %d and %d "
              "beyond it) in ONE process, %d skipped"
              % (args.passes, len(ALL_STEPS), len(STEPS), len(EXTRA_STEPS),
                 len(skips)))
        if args.passes < 2:
            print("  ...but %d pass is NOT the gate. plan_entity.md step 0d asks "
                  "for the checklist twice in one process: one map load hides a "
                  "whole bug class." % args.passes)

    return exit_code


if __name__ == "__main__":
    sys.exit(main())

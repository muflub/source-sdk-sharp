# input-usercmd (plan_client_novalve §5.3, lane c6-input).
#-----------------------------------------------------------------------------
INPUT_ROUNDS = 3
INPUT_DX = 100


def client_input(g, slot):
    """The client's input: key states, the sensitivity chain, the last 16 commands."""
    return g.api.get("client", str(slot), "input")


def latest_yaw(answer):
    commands = answer.get("commands") or []
    return commands[-1]["angles"][1] if commands else None


def yaw_delta(after, before):
    d = (after - before) % 360.0
    return d - 360.0 if d > 180.0 else d


def step_input_usercmd(g):
    """
    A SCRIPTED MOUSE DELTA TURNS THE VIEW BY THE SENSITIVITY-SCALED AMOUNT
    (plan_client_novalve §5.3's input-usercmd, lane c6-input).

    The input is managed (ClientInput). /client/{slot}/input/inject adds a raw
    delta of INPUT_DX counts to the mouse's next read; the next command's yaw
    must have moved by -(m_yaw * sensitivity * INPUT_DX), mod 360, with
    m_customaccel and m_filter off. THE CONTROL, each round, is the same wait
    with nothing injected: the yaw must not move, so a view that drifts on its
    own cannot pass the positive arm. Alternating signs, three rounds.
    """
    slot = ui_slot(g)
    if slot is None:
        return
    g.cheats()
    g.api.cmd("m_customaccel 0")
    g.api.cmd("m_filter 0")
    time.sleep(0.5)

    first = g.api.wait_for(lambda: (lambda a: a if a.get("commands") else None)(client_input(g, slot)), 15.0)
    g.check(bool(first), "the client answers /client/%d/input with commands" % slot)
    if not first:
        return
    chain = first.get("sensitivity", {})
    sens = chain.get("hud") or chain.get("sensitivity")
    m_yaw = chain.get("yaw")
    g.check(chain.get("customAccel") == 0 and not chain.get("filter"),
            "m_customaccel 0 and m_filter 0 took (%s, %s)" % (chain.get("customAccel"), chain.get("filter")))
    g.check(any(b.get("name") == "forward" for b in first.get("buttons", [])),
            "the route lists the key buttons (%d)" % len(first.get("buttons", [])))

    for r in range(INPUT_ROUNDS):
        dx = INPUT_DX if r % 2 == 0 else -INPUT_DX

        # THE CONTROL: nothing injected, the view stays where it is.
        before = latest_yaw(client_input(g, slot))
        time.sleep(0.5)
        still = latest_yaw(client_input(g, slot))
        g.check(before is not None and still is not None and abs(yaw_delta(still, before)) < 1e-3,
                "round %d: with nothing injected the view did not turn (%s -> %s)" % (r + 1, before, still))

        # An injected delta is read whether or not the window holds the mouse
        # (the engine releases it every frame a headless window lacks focus),
        # so the round does not depend on the window manager.
        answer = client_input(g, slot)
        applied = answer.get("inject", {}).get("applied", 0)
        before = latest_yaw(answer)
        inject = g.api.get("client", str(slot), "input/inject?e=%d,0" % dx)
        g.check(inject.get("accepted"), "round %d: the inject was accepted (%s)" % (r + 1, inject.get("reason")))
        landed = g.api.wait_for(lambda: (lambda a: a if a.get("inject", {}).get("applied", 0) > applied
                                         and a.get("inject", {}).get("pending", 1) == 0 else None)(client_input(g, slot)), 10.0)
        g.check(bool(landed), "round %d: the delta reached the mouse's read" % (r + 1))
        if not landed:
            continue
        time.sleep(0.3)
        read = client_input(g, slot)
        after = latest_yaw(read)
        # THE READ THAT TOOK THE INJECT also carries whatever the device
        # reported in it (a real mouse on this desktop, when the window holds
        # it), and the turn is their sum, as stock's is. The daily gate's one
        # red round (2026-10-11, a4bc36394: +100 counts -> -1.914 deg) is what
        # made the route report the device's share; the inject itself must
        # still have arrived whole.
        last = read.get("inject", {})
        device = last.get("deviceX", 0)
        g.check(last.get("lastX") == dx,
                "round %d: the read took the whole inject (%s of %+d counts)" % (r + 1, last.get("lastX"), dx))
        if device:
            g.say("    round %d: the device moved %+d counts in the same read; the turn includes them" % (r + 1, device))
        want = -(m_yaw * sens * (dx + device))
        got = yaw_delta(after, before)
        recent = [c.get("mouseDx") for c in (read.get("commands") or [])[-6:]]
        g.check(abs(got - want) < 0.01,
                "round %d: %+d counts turned the view %.4f deg (want %.4f = -m_yaw %.3f * sensitivity %.3f * (dx %+d device %+d); last commands' mouseDx %s)"
                % (r + 1, dx, got, want, m_yaw, sens, dx, device, recent))



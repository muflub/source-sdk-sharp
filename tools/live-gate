    ok(proj["minTravel"] < proj["recordedTravel"],
       "and BELOW what a flown one reaches here (%s): above it, the step can "
       "never pass" % proj["recordedTravel"])
    ok(proj["stationary"] > 0,
       "the unflown distance is not zero -- the shot leaves from the eye, 64 "
       "units above the origin, and a threshold picked as if it were zero is "
       "the whole trap this constant exists for")
    #-- targetPitch: the fixture's distance, asserted as GEOMETRY -----------
    #
    # THE FIXTURE USED TO BE AN EJECTION AND IS NOW A LOOK ANGLE, so the number
    # that decides whether the step can pass is a pitch and it is checkable
    # here, off a live game entirely: `ent_create` places what it makes at the
    # aim point, and on flat floor the aim point is EYE_HEIGHT / tan(pitch)
    # units downrange.
    #
    # openFloorAngles' own 25 degrees gives 137, which is UNDER minTargetRange
    # -- so drawing the target at the scenario's walking angle can never pass
    # once the crate stops being thrown out of the floor it was buried in. That
    # is asserted too, in the direction that matters: targetPitch must be
    # shallower, and its reach must clear the floor with room.
    eye_reach = lambda degrees: 64.0 / math.tan(math.radians(degrees))

    ok(0 < proj["targetPitch"] < g_dm_lockdown_walk_pitch,
       "the projectile step's target pitch (%s) looks SHALLOWER than the "
       "scenario's walking angle (%s), which is what puts the target further "
       "downrange than the walking angle can reach"
       % (proj["targetPitch"], g_dm_lockdown_walk_pitch))
    ok(eye_reach(proj["targetPitch"]) > proj["minTargetRange"] * 1.5,
       "and it reaches %.1f units on flat floor, comfortably over the %s the "
       "crate has to stand at -- a target pitch that only just clears the "
       "floor is one bump of terrain away from an unfalsifiable step"
       % (eye_reach(proj["targetPitch"]), proj["minTargetRange"]))
    ok(eye_reach(g_dm_lockdown_walk_pitch) < proj["minTargetRange"],
       "and the walking angle does NOT reach it (%.1f < %s): this is the fact "
       "that made the old fixture depend on a physics ejection, and it is "
       "recorded so nobody quietly puts the draw back on openFloorAngles"
       % (eye_reach(g_dm_lockdown_walk_pitch), proj["minTargetRange"]))
    ok(eye_reach(proj["targetPitch"]) < proj["recordedTravel"],
       "and a bolt that flies %s units can still reach it (%.1f): a target "
       "beyond the yard is one nothing can hit"
       % (proj["recordedTravel"], eye_reach(proj["targetPitch"])))


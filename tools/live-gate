        # A SECOND, HIGHER port on the same process, which is the shape a real
        # server has (the server socket and the lan/hltv sockets above it).
        # The answer must be the LOWEST at or above hostport, because the
        # engine's bind loop only ever walks upward.
        for offset in range(1, 20):

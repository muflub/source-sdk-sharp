RELOAD_MOVER_SLACK = 2.0


def reload_vanish_allowance(before, elapsed):
    """{class: n}: how many entities of a class may have removed themselves
    across a reload of `elapsed` seconds -- the bookings of that class due
    inside the span (dueMs.<class>[:context].<n>, a tenth of a second slack),
    read before it. A corpse's removal think (ss_ragdoll's 15 s Lifetime)
    that comes due during the swap runs and the entity is gone: the schedule
    working, not the reload losing it (2026-10-11, after spectate's kill)."""
    span_ms = max(0.0, elapsed) * 1000.0 + 100.0
    out = {}
    for k, v in before.items():
        if k.startswith("dueMs.") and v <= span_ms:
            cls = k[len("dueMs."):].rsplit(".", 1)[0].split(":", 1)[0]
            out[cls] = out.get(cls, 0) + 1
    return out


def reload_vanish_allowance_over(reads, now):
    """reload_vanish_allowance over several think reads, each (counters,
    game time it was read at), every one judged from its own time to `now`
    and kept per class at the largest. The census before the reload is read
    BEFORE the think reads it is compared with (2.5 s of game earlier), so a
    booking that came due and ran in that gap -- spectate's ss_ragdoll, whose
    15 s Lifetime ended in it, 2 of 2 passes (docs/todo.md, 2026-10-12) -- is
    in no later read, and only the read taken with the census can excuse it."""
    out = {}
    for counters, at in reads:
        for cls, n in reload_vanish_allowance(counters or {}, now - at).items():
            out[cls] = max(out.get(cls, 0), n)
    return out


def reload_excused(lost_classes, allowance):
    """(excused, unexcused): the lost entities' classes, split by the
    allowance. A class gets no more excuses than it had bookings due."""
    left = dict(allowance)
    excused, unexcused = [], []
    for cls in lost_classes:
        if left.get(cls, 0) > 0:
            left[cls] -= 1
            excused.append(cls)
        else:
            unexcused.append(cls)
    return excused, unexcused


def think_survival(first, before, after, elapsed):
    """What the reload must have kept of the think heap: (required, have,
    short), from the think counters read twice before the reload (`first`,
    then `before`, 1.5 s apart), once after (`after`), and the seconds of game
    from `before` to `after`.

    A booking due INSIDE that span may have come due and run: a one-shot (an
    item's respawn) is then gone, which is the schedule working, not the
    reload losing it. So per class only these must still be booked: every
    booking due AFTER the span (dueMs.<class>.<n>, plus a tenth of a second
    either way), and of those due inside it, the recurring ones -- a class
    booked within a second in BOTH before-reads runs and books again. A
    booking the reload drops is due after the span or recurring, and is
    missed. `short` names the classes with fewer than they must have."""
    span_ms = max(0.0, elapsed) * 1000.0 + 100.0
    due = {}
    for k, v in before.items():
        if k.startswith("dueMs."):
            due.setdefault(k[len("dueMs."):].rsplit(".", 1)[0], []).append(v)
    required, have, short = 0, 0, []
    for k, booked in sorted(before.items()):
        if not k.startswith("booked.") or booked <= 0:
            continue
        cls = k[len("booked."):]
        times = due.get(cls, [])
        later = min(booked, sum(1 for t in times if t > span_ms))
        inside = booked - later
        recurring = min(first.get("due1." + cls, 0), before.get("due1." + cls, 0))
        need = later + min(inside, max(0, recurring))
        got = after.get(k, 0)
        required += need
        have += min(got, booked)
        if got < need:
            short.append("%s %d of %d" % (cls, got, need))
    return required, have, short


def think_count(g, reads=9):
    """The think heap's booking count, as the MOST COMMON of `reads` reads a
    few ticks apart. One read can land between a per-tick thinker running and
    re-booking (one short), or in the few ticks something books briefly (one
    over); neither is the schedule. Sampled every 35 ticks across a reload the
    count read 9 9 9 9 9 8 9 9; the peak of reads failed the other way, 6 of 7,
    in 2 of 3 rounds (2026-10-05)."""
    seen = []
    for i in range(reads):
        seen.append(g.api.status().get("think", {}).get("pending", 0))
        if i + 1 < reads:
            g.ticks(0.06)
    return max(set(seen), key=lambda v: (seen.count(v), v))


def reload_probe(g, name):
    """One func_movelinear the step owns, at the player's feet, pointing up."""
    g.api.cmd('ent_create func_movelinear model %s targetname %s '
              'movedir "-90 0 0" speed %d movedistance %d startposition 0'
              % (g.scen["lift"]["brushModel"], name,
                 RELOAD_PROBE_SPEED, RELOAD_PROBE_DISTANCE))

    # BY NAME, through /wait?exists= and /entity, answered the tick it exists.
    # This waited ten seconds on a listing that carries no names (AppendEntity
    # never did), every time, twice a pass -- and then fell back to "the newest
    # func_movelinear". Twenty seconds of hot-reload's unexplained time.
    g.api.wait({"exists": 1, "name": name}, int(10.0 / TICK_SECONDS))
    return g.api.entity(name=name)


def reload_door(g, name):
    """One func_door the step owns, opened and left standing open."""
    g.api.cmd('ent_create func_door model %s targetname %s '
              'movedir "-90 0 0" speed %d movedistance %d wait "-1"'
              % (g.scen["lift"]["brushModel"], name,
                 RELOAD_PROBE_SPEED, RELOAD_PROBE_DISTANCE))
    g.api.wait({"exists": 1, "name": name}, int(10.0 / TICK_SECONDS))
    return g.api.entity(name=name)



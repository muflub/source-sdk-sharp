    #-- is_descendant --------------------------------------------------------
    # Against REAL pids, because the whole point of this predicate is that it
    # reads /proc: a fake tree would test the arithmetic and not the thing that
    # was wrong. And every subject is located with `ps`, never with the function
    # under test -- a check that found its own subject with is_descendant would
    # pass whatever is_descendant did.
    def children_of(pid):
        return subprocess.run(["ps", "-o", "pid=", "--ppid", str(pid)],
                              capture_output=True, text=True).stdout.split()

    def wait_for_child(pid, seconds=6.0):
        deadline = time.time() + seconds
        while time.time() < deadline:
            kids = children_of(pid)
            if kids:
                return kids[0]
            time.sleep(0.1)
        return None

    ok(is_descendant(os.getpid(), os.getpid()), "a process is its own descendant")
    ok(is_descendant(os.getpid(), os.getppid()),
       "and it is a descendant of its parent")
    ok(not is_descendant(os.getppid(), os.getpid()),
       "but a parent is NOT a descendant of its child")
    ok(not is_descendant(1, os.getpid()), "init is nobody's descendant here")
    ok(is_descendant(os.getpid(), 1),
       "everything IS a descendant of init, which is why the ancestor asked "
       "about must be the pid we spawned and never a constant")
    ok(not is_descendant("nonsense", os.getpid()), "a non-numeric pid is refused")

# damage step is what makes a healthkit takeable; the ammo step is what puts
# rounds in the gun the shooting step fires) and the three terminal ones have
# to be last or there is nothing left to test.
#=============================================================================
#=============================================================================
# WHAT EACH STEP WOULD HAVE TO SEE BREAK -- THE 2026-09-06 AUDIT
#
# `shoot` sat in this checklist from Phase 0 reading like coverage of the
# shooting path, and step 2f measured that a build with the whole flight
# integrator unregistered passes it: it fires the SMG, which is hitscan.
# A step whose NAME implies more than its assertions deliver is the same defect
# as a check that cannot fail, and it hides longer, because the checklist looks
# complete. So every step was asked one question -- WHAT WOULD HAVE TO BREAK
# FOR THIS TO GO RED -- and the answers are here rather than in a status file.
#
# FIXED IN THIS PASS (each landed with the mutation that proves it red):
#   move        "through the movement code" was in the TITLE and in nothing
#               else. `moved > 64` is satisfied by a player who fell, who was
#               pushed, or whose movement math went back to native. It now
#               reads WALKING_OPS across the hold, the way `jump` has always
#               read ServerOnPlayerJump.
#   move        `"Origin" in fields` was a membership test on the payload
#               SCHEMA, true whether the player moved or not. It now decodes
#               the networked vector and asks it the same question.
#   shoot       says out loud, once per pass, that it is hitscan and that the
#               flight path is `projectile`'s subject. The title cannot change
#               -- it is §5's own words and --self-test pins them.
#   door        fired two names and then accepted ANY func_door moving. The
#               fire's own reply is now checked: matched by NAME, one target,
#               and that target accepted the input.
#   pickup      said "walking onto"; it teleports. The touch path is what it
#               exercises and the message now says so.
#   shutdown    (0, 0) is its PASS condition and is also what census() answers
#               when the dev API has stopped answering. It was already saved by
#               the status() call after it -- an ApiError there is a failure --
#               but nothing said the ORDER was load-bearing. Now it does.
#   run_step    printed a budget line for every stage and enforced one only for
#               stages with a row, saying nothing about the difference. The
#               `projectile` step ran ungated that way for two whole gate runs.
#   the summary line said "the sixteen steps" while running eighteen.
#
# HONEST AND UNCHANGED -- these deliver what their names say:
#   jump        two independent halves, one of them a crossing counter. The
#               model the rest of this file is being pulled towards.
#   trigger     OnEndTouch is matched on the SAME HANDLE as OnStartTouch, so a
#               second trigger firing cannot satisfy it.
#   damage      the reply AND the entity read back AND the same index.
#   second-client  a real second process, its own ClientLevelInit, entities
#               built in both directions, and the newcomer's OWN input moving
#               its server-side player. Nothing here is satisfied by absence.
#   hot-reload  states its own limits in its docstring and prints a note for
#               the leak it deliberately does not gate.
#   map-reload  census equality against the map's own numbers.
#   save-load   the save and the load each proved by a crossing op, and the
#               RESTORED state made different from the pre-load state first, so
#               "a load that did nothing" cannot pass.
#   projectile  see step_projectile: three assertions, each verified red.
#
# GAPS LEFT OPEN, WITH OWNERS. Each is a real narrowing of what the step's name
# claims; none is cheap to close from this file alone.
#   join,       "the player stands at a spawn point" checks only that the
#   respawn     origin is not [0, 0, 0]. A player spawned inside a wall, in the
#               map's centre, or at last frame's position passes both.
#               Closing it means comparing against the map's own
#               info_player_deathmatch origins (debug-api mapents has them) with a
#               tolerance nobody has measured. OWNER: whoever ports spawn
#               selection (§3, players).
#   damage      the player is only ever hurt by `debug-api hurtclass`, which calls
#               the damage path directly -- no weapon, no trace, no attacker.
#               NOTHING IN THIS CHECKLIST DAMAGES A PLAYER WITH A GUN. `shoot`
#               and `projectile` damage a crate; `die` uses hurtclass too.
#               OWNER: whoever owns weapons and damage (§3f / 2h).
#   door        the fire is now tied to one named entity, but the entity that
#               MOVED is still only "some func_door". The live /entities
#               listing carries no targetname, so tying the two ends together
#               needs a dev API change. OWNER: whoever owns the dev API's
#               entity listing.
#   die         "a ss_ragdoll was created for the corpse" is the COUNT going
#               up, not that the ragdoll is this player's. True today because
#               there is one player. OWNER: this file, when a step has two.
#   pickup      health rising satisfies the health half; if this build ever
#               grows regeneration, that check stops being about the kit.
#               OWNER: whoever adds regeneration.
#   push        a recorded skip (tools/live-gate-skips.tsv). Its assertions
#               are real when they run; they are not running.
#=============================================================================
#=============================================================================
# STEP 6c's TWO STEPS: the client's bone pipeline, live.
#
# plan_entity.md 6c's gate names them -- "the skinned-model and viewmodel-merge
# steps of the live gate" -- and neither existed. §5's sixteen are all about the
# server or about a player, and every one of them passes with the client's bone
# build deleted outright: a crate is a STATIC_PROP, its whole skeleton is one
# copy of the entity transform, and nothing in join/move/shoot/die ever asks a
# skinned model where its elbow is.
#
# They are EXTRA_STEPS rather than STEPS, for the reason that list exists: §5's
# checklist is sixteen and stays sixteen, so "the plan asked for this" and
# "somebody found a hole" do not blur.
#
# THE NUMBERS ARE THE GATE'S AND THE FACTS ARE THE GAME'S. cs_cl_bonerecord
# (skinned) and cs_cl_boneprobe report (merge) print one row per fact and no
# verdict; the thresholds are here. A probe that printed PASS would make this
# file a rubber stamp over a judgement nobody can read.
#=============================================================================
SKINNED_MODEL = "models/humans/group03/male_01.mdl"


def boneprobe_rows(g, kind):
    """The last value the probe printed for each fact of `kind`.

    Read out of the game's console (through /console, g.console_lines) rather
    than the dev API log, and that is still right now that the `skinned` rows
    come from MANAGED code (cs_cl_bonerecord) while the `merge` rows are still
    the native probe's. The recorder prints through Log.Msg, which crosses to
    the engine's own Msg -- so both kinds land in the console, and neither
    lands in the dev API log. The same reason g.count_console exists. Never
    mods/test/console.log by path: a game launched with +con_logfile writes
    another file (tools/3f-gatebisect).

    The LAST occurrence, so a step that runs twice in a two-pass run reads its
    own pass and not the previous one. Note this also means the merge step's
    `cs_cl_boneprobe report` re-prints the NATIVE skinned rows after the skinned
    step has already read the managed ones -- harmless, because the skinned step
    registers first and reads before the merge step runs, and useful, because it
    leaves both answers in one log to diff.
    """
    out = {}
    for line in g.console_lines("SS6CGATE\t"):
        i = line.find("SS6CGATE\t")
        f = line[i:].rstrip("\r\n").split("\t")
        if len(f) >= 4 and f[1] == kind:
            out[f[2]] = f[3]
    return out


def spawn_skinned(g, count):
    """`count` skinned standalone entities on the open floor, spread apart.

    ss_barrel because that is the standalone class cs_standalone_spawn takes and
    the class is irrelevant here: what is under test is the model's skeleton.

    WAITED FOR RATHER THAN SLEPT AT. A fixed settle is a race, and the race was
    observed: one run of tools/6c-gate-probe had only one of the two arrive, and
    the merge step then read the map's own one-bone view model -- which fails
    `bones > 1` rather than passing wrongly, but fails it for a reason that has
    nothing to do with the code. Returns how many the server actually holds, so
    a caller can say so instead of asserting into the dark.
    """
    floor = g.scen["openFloor"]
    before = len(g.api.ents("ss_barrel"))

    for n in range(count):
        g.api.cmd("cs_standalone_spawn %d %d %d ss_barrel %s"
                  % (floor[0] + 96, floor[1] + 96 * n, floor[2] + 40, SKINNED_MODEL))
        g.ticks(0.4)

    deadline = time.time() + 20.0
    live = before
    while time.time() < deadline:
        try:
            live = len(g.api.ents("ss_barrel"))
        except ApiError:
            live = before
        if live >= before + count:
            break
        g.ticks(0.5)

    # A beat after the last one arrives, so the client has decoded it and built
    # a C_StandaloneEntity for it -- the server holding the entity is the
    # precondition for that, not the same fact.
    g.ticks(1.5)
    return live - before


def step_skinned_model(g):
    """18. a skinned model's bones are built on the client.

    THE FACT THAT SEPARATES A POSED SKELETON FROM AN UNPOSED ONE IS NOT THE BONE
    COUNT. BoneLibrary_BuildBones' static-prop branch writes ONE transform into
    every bone a model declares, count and all, so "68 bones" is satisfied by a
    build that never ran bone_setup at all. What cannot be is bones that DIFFER
    from the entity's own transform, and that is what is counted.

    And the same fact again through the other half of the pipeline: an
    attachment hangs off a bone, so an unposed skeleton puts every one of them
    exactly on the entity's origin. A build that posed the bones and then
    composed the attachments off the wrong matrix would satisfy one of these
    and not the other.
    """
    if not DEBUG_COMMANDS:
        g.skip("%s build: needs cs_standalone_spawn and cs_sv_boneprobe, debug-only console commands" % CONFIG)
    g.cheats()
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)

    if spawn_skinned(g, 1) < 1:
        g.check(False, "cs_standalone_spawn made no ss_barrel to look at")
        return

    # A real sequence at a real cycle. Sampled a beat after it is set, because a
    # sequence started and read back in the same breath is at cycle zero -- the
    # one input at which the accumulate arm cannot be told from the reference
    # pose.
    g.api.cmd("cs_sv_boneprobe seq 3")
    g.ticks(1.0)
    # THE SKINNED ROWS ARE MANAGED NOW (lane 7b-soundscape). cs_cl_bonerecord is
    # SourceSharp.Client.Standalone.ClientBoneRecorder, and it prints the same
    # six facts under the same SS6CGATE\tskinned tag that
    # ClientBoneProbe::ReportSkinned printed them under -- same subject choice,
    # same arithmetic, same row format, so this step's checks below are
    # unchanged.
    #
    # The native probe is still there and still answers `cs_cl_boneprobe
    # report`, which is the MERGE step's driver below and is also the oracle:
    # run both on one join and diff the skinned rows.
    g.api.cmd("cs_cl_bonerecord")
    g.ticks(0.8)

    rows = boneprobe_rows(g, "skinned")

    if not rows:
        g.check(False, "cs_cl_bonerecord printed nothing to console.log")
        return

    bones = int(rows.get("bones", 0))
    posed = int(rows.get("posed", 0))
    written = int(rows.get("written", 0))
    attachments = int(rows.get("attachments", 0))
    moved = int(rows.get("movedattachments", 0))

    g.say("    %s: %d bones, %d written, %d posed, %d/%d attachments off the origin"
          % (rows.get("model", "?"), bones, written, posed, moved, attachments))

    g.check(bones > 1,
            "the client found a poseable multi-bone model (%d bones); a build "
            "in which the skinned spawn never reached the client, or in which "
            "BoneLibrary_IsPoseable answered no, reads 0 or 1 here" % bones)

    g.check(written > 1,
            "%d of its bones were actually written by the build. Studio_BuildMatrices "
            "writes only what its mask names and leaves the rest of the buffer as "
            "it found it, so this is the count BoneLibrary_BoneIsWritten vouches "
            "for and not the model's own" % written)

    # ALL OF THEM, NOT "MORE THAN ONE", AND THE LOOSE VERSION WAS MEASURED TO BE
    # USELESS. `posed > 1` was the first spelling. tools/6c-gate-probe was then
    # pointed at a build whose ordinary bones were all written as the entity
    # transform -- the exact defect this check is for -- and it read
    # posed=31/56 and movedattachments=3/7, because the procedural bones and the
    # IK-solved ones are written by something else and survive. Both would have
    # passed `> 1` and `> 0`. So the assertion is EVERY written bone and EVERY
    # attachment, which the control run reads as 56/56 and 7/7.
    #
    # A bone whose local pose happened to be exactly identity would sit on the
    # entity transform legitimately and fail this. Male_01 at this sequence has
    # none; if a model change ever produces one, this says so loudly rather than
    # a looser threshold saying nothing about the 25 bones that went wrong.
    g.check(posed == written and written > 1,
            "ALL %d written bones differ from the entity's own transform, so the "
            "pose branch ran for every one of them. A build whose ordinary bones "
            "are written as the entity transform still reads 31 here -- the "
            "procedural and IK-solved ones survive -- which is why this is an "
            "equality and not a floor" % posed)

    g.check(attachments > 0 and moved == attachments,
            "ALL %d attachments are off the entity's origin, so every one was "
            "composed off a posed bone rather than collapsed onto the entity "
            "(the same defect reads 3 of 7 here)" % moved)


def step_viewmodel_merge(g):
    """19. a bone-merged model follows its source's skeleton.

    EF_BONEMERGE is how a view model's hands hold a weapon and how a weapon
    follows a hand: the follower's bone i takes the matrix of the SOURCE's bone
    with the same name, and every bone the source never heard of keeps the
    follower's own pose. Both halves matter and only the first is obvious --
    a merge that overwrote everything would put a weapon's world model at the
    world origin.

    Two entities wearing the SAME model, which is the view-model case: every
    bone name matches, so the map is full rather than the handful two different
    skeletons share. That makes `matched == bones` a real assertion here, where
    on two different models it would be a number nobody could predict.
    """
    if not DEBUG_COMMANDS:
        g.skip("%s build: needs cs_standalone_spawn, debug-only console commands" % CONFIG)
    g.cheats()
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)

    # BOTH OF THEM, ASSERTED. The merge needs a PAIR, and with only one the
    # report falls back to whatever else on the map is merging -- the local view
    # model, one bone -- and the step fails on a spawn rather than on the merge.
    arrived = spawn_skinned(g, 2)
    if arrived < 2:
        g.check(False, "only %d of the 2 ss_barrels the merge needs arrived" % arrived)
        return

    # RETRIED UNTIL THE PAIR IS ON THE CLIENT, and the command itself is what
    # says so. `arrived` above is the SERVER's count, and the client having
    # decoded both is a different fact -- a fixed settle between them is a race,
    # and the race was observed on tools/6c-gate-probe: the report then read the
    # map's own one-bone view model, which fails `bones > 1` for a reason that
    # has nothing to do with the merge. mergeauto answers about the CLIENT's
    # list and is idempotent.
    paired_before = g.count_console("mergeauto: entity")
    paired = False

    for _ in range(8):
        g.api.cmd("cs_cl_boneprobe mergeauto male_01 male_01")
        g.ticks(1.5)
        if g.count_console("mergeauto: entity") > paired_before:
            paired = True
            break

    g.check(paired,
            "the two skinned entities paired on the CLIENT, so what follows is "
            "about the merge this step set up and not about whatever else on "
            "the map happens to be merging")

    if not paired:
        return

    g.api.cmd("cs_cl_boneprobe report")
    g.ticks(0.8)

    rows = boneprobe_rows(g, "merge")

    if not rows:
        g.check(False, "cs_cl_boneprobe report printed no merge rows to console.log")
        return

    bones = int(rows.get("bones", 0))
    matched = int(rows.get("matched", 0))
    follows = int(rows.get("follows", 0))

    g.say("    follower has %d bones, %d matched the source by name, %d hold "
          "the source's matrix" % (bones, matched, follows))

    g.check(bones > 1,
            "a poseable follower was merged onto a source (%d bones)" % bones)

    g.check(matched == bones,
            "%d of its %d bones matched a source bone BY NAME. The two wear the "
            "same model, so anything short of all of them is a name lookup that "
            "stopped working rather than two skeletons that genuinely differ"
            % (matched, bones))

    g.check(follows == matched,
            "%d of the %d matched bones hold the SOURCE's matrix, so the "
            "follower follows. A map that matched every bone and copied none of "
            "them satisfies the check above and fails this one, which is why "
            "they are two" % (follows, matched))


def step_render(g):
    """
    THE CLIENT'S INBOUND CROSSINGS PER RENDERED FRAME, AT ONE FIXED STAND.

    plan_client_novalve.md 3.3's render budget, C0 item 6: the number every
    later move of the renderer (the render plan, the bone batch, the effect
    draws) is measured against. Recorded, not chosen: tools/live-gate-budget.tsv
    holds the row this step's window feeds.

    The window is the CLIENT's, not the server's. Each side's ABI counts its
    own crossings (plan_side_isolation), so this step reads
    /client/{slot}/status twice, client frames apart, with the player standing
    where `join` left them, and hands run_step that delta in place of the
    server's. Its row is therefore per CLIENT frame -- the one row in the
    budget file that is, and the file says so beside it.

    THE STAND IS FIXED: the scenario's renderStand, dm_lockdown's spawn at
    (-4116, 4600) looking south (yaw -90), set with setpos_exact/setang and
    settled before the window. The window was taken wherever `join` left the
    player, a random one of the map's spawns, and the rate moved with what was
    in view: 21 to 32 client crossings per frame over three spawns
    (2026-10-05), ClientStandaloneDraw alone 16 a frame at this one -- a
    budget that is not a reproducible instrument. This is the busiest of the
    three, so the ceiling covers the worst view a spawn gives.

      clientFrames > 0   the client rendered in the window (a stimulus that
                         reached the counter), and total > 0 with it
    """
    players = g.api.ents(g.scen["playerClass"])
    if len(players) != 1:
        g.check(False, "the render window needs exactly our one player; the "
                       "server holds %d" % len(players))
        return
    slot = players[0]["index"]
    stand = g.scen.get("renderStand")
    if not stand:
        g.check(False, "the scenario names no renderStand: the render window has no fixed place to stand")
        return
    g.cheats()
    # Put back where the step found them afterwards: the steps after this one
    # were written for the player `join` left, and a stand that moves them
    # moves what they pick up and when it respawns -- hot-reload's think check
    # read an item_ammo_pistol respawn as lost in pass 2 of 2 of 2 runs until
    # it was (2026-10-05).
    me = g.api.player(g.scen["playerClass"]) or {}
    home = (me.get("origin"), me.get("angles"))
    g.teleport(stand["position"], stand["angles"], settle=1.0)
    here = g.player_origin()
    g.check(math.hypot(here[0] - stand["position"][0], here[1] - stand["position"][1]) < 8.0,
            "the player stands at renderStand %s (%s)" % (stand["position"][:2], [round(v, 1) for v in here]))
    before = g.api.wait_for(lambda: g.api.client_crossings(slot) or None, 30.0)
    if not before:
        g.check(False, "the local client's counters are not answered at "
                       "/client/%d/status" % slot)
        return
    want = RENDER_WINDOW_FRAMES

    def enough():
        now = g.api.client_crossings(slot)
        return now if now.get("clientFrames", 0) - before.get("clientFrames", 0) >= want else None
    after = g.api.wait_for(enough, 60.0)
    if not after:
        after = g.api.client_crossings(slot)
    frames = after.get("clientFrames", 0) - before.get("clientFrames", 0)
    total = after.get("total", 0) - before.get("total", 0)
    resets = after.get("resets", 0) - before.get("resets", 0)
    ops = {}
    for op, n in after.get("ops", {}).items():
        d = n - before.get("ops", {}).get(op, 0)
        if d:
            ops[op] = d
    g.check(resets == 0, "the client's counters were not reset inside the "
                         "window (%d resets)" % resets)
    g.check(frames >= want, "the client rendered %d frames in the window "
                            "(%d wanted)" % (frames, want))
    g.check(total > 0, "and crossed into managed while it did (%d)" % total)
    top = sorted(ops.items(), key=lambda kv: -kv[1])[:6]
    g.say("    render  %d client crossings / %d client frames; top ops %s"
          % (total, frames, ", ".join("%s %d" % kv for kv in top)))
    g._window = {"total": total, "serverFrames": frames, "ops": ops,
                 "unit": "client frames"}
    if home[0]:
        g.teleport(home[0], home[1], settle=1.0)


def step_engine_vectors(g):
    """
    VECTORS THE ENGINE FILLS FOR US GO BACK TO THE ALLOCATOR THAT GREW THEM.

    engine_heap.h's live half. cs_sv_engine_vectors has engine.so grow two
    out-parameters on the loaded map (IEngineTrace::GetBrushesInAABB and
    IStaticPropMgrServer::GetAllStaticProps over the whole map), reads them
    through ss::EngineUtlVector and releases them through the g_pMemAlloc of the
    libtier0.so the engine loaded. Run in both passes, so the second reads a
    map loaded again. Its one line:

      heap same     the allocator it found IS the one engine.so resolves
      brushes > 0   the engine really filled one (a stimulus that reached it),
                    every index non-negative, and allocated >= count
      props         static props, none NULL
      foreign 0 / mismatch 0
                    the allocation checker's counters across the releases, in a
                    build that carries it: a release through server.so's own
                    free() would be a foreign free, because the checker never
                    saw those blocks allocated. -1 means the build has no
                    checker, and then only in release is that acceptable.

    Native output, so it is read from console.log (an attached run cannot).
    """
    if not DEBUG_COMMANDS:
        g.skip("%s build: needs cs_sv_engine_vectors, debug-only console commands" % CONFIG)
    if not g.own_log:
        g.note("attached, so this process captured no log: the engine-vector "
               "readout cannot be read")
        return

    needle = "[SourceSharp] engine vectors:"
    before = g.count_console(needle)
    g.api.cmd("cs_sv_engine_vectors")
    if not g.api.wait_for(lambda: g.count_console(needle) > before, 60.0):
        g.check(False, "cs_sv_engine_vectors printed nothing to console.log")
        return

    line = g.last_console_line(needle) or ""
    m = re.search(r"heap (\S+) \((\S+), engine\.so (\S+)\) brushes (-?\d+) "
                  r"\(allocated (-?\d+), negative (\d+)\) props (-?\d+) \(null (\d+)\) "
                  r"foreign (-?\d+) mismatch (-?\d+)", line)
    if not m:
        g.check(False, "the engine-vector readout did not parse: %r" % line.strip())
        return
    heap, _, _, brushes, allocated, negative, props, nulls, foreign, mismatch = m.groups()
    brushes, allocated, negative = int(brushes), int(allocated), int(negative)
    props, nulls, foreign, mismatch = int(props), int(nulls), int(foreign), int(mismatch)

    g.check(heap == "same",
            "the allocator found is the one engine.so resolves (%s)" % line.strip())
    g.check(brushes > 0,
            "the engine filled the brush vector (%d brushes)" % brushes)
    g.check(allocated >= brushes and negative == 0,
            "and it reads back whole through the view (allocated %d, negative %d)"
            % (allocated, negative))
    g.check(props >= 0 and nulls == 0,
            "the static prop vector reads back (%d props, %d NULL)" % (props, nulls))
    if foreign < 0 or mismatch < 0:
        g.check(CONFIG != "debug",
                "a debug server.so carries the allocation checker (foreign %d)" % foreign)
    else:
        g.check(foreign == 0 and mismatch == 0,
                "releasing them crossed no allocator (foreign %d, mismatch %d)"
                % (foreign, mismatch))


def census_drift(before, after, switched_pairs):
    """[(classname, delta)] for every class whose count differs between two
    per-class censuses, except a switched pair moving TOGETHER. PURE.

    `switched_pairs` maps a child class to its partner, {"spotlight_end":
    "ss_beam"}: a lit point_spotlight owns exactly one of each, so lighting or
    dousing one moves both by the same amount and is the lamp's STATE, not a
    leak. Only that equal movement is forgiven -- a spotlight_end without its
    beam, or a beam without its end, still reads as drift, and so does every
    other class.
    """
    deltas = {k: after.get(k, 0) - before.get(k, 0)
              for k in set(before) | set(after)}
    for child, partner in switched_pairs.items():
        moved = deltas.get(child, 0)
        if moved and deltas.get(partner, 0) == moved:
            deltas[child] = 0
            deltas[partner] = 0
    return sorted((k, d) for k, d in deltas.items() if d)


# The two effect readouts rope-settle and beam-ring parse (managed log lines,
# which reach console.log). PURE regexes, held by --self-test.
ROPE_SPANS_RE = re.compile(r"cs_cl_rope_spans: (\d+) span\(s\), (\d+) step\(s\), (\d+) strip\(s\) drawn")
ROPE_ROW_RE = re.compile(r"\] \S+ (\d+) nodes (hung|NOT SIMULATING YET) .* sag (-?[0-9.]+)")
BEAMS_RE = re.compile(r"cs_cl_beams: (\d+) active, (\d+) created, (\d+) refused, (\d+) update\(s\), "
                      r"(\d+) draw\(s\), (\d+) strip\(s\), (\d+) mesh\(es\)")
EFFECT_ROUNDS = 3


def read_readout(g, command, needle, regex, seconds=30.0):
    """Run a client readout and parse the line it printed; None if it did not."""
    before = g.count_console(needle)
    g.api.cmd(command)
    if not g.api.wait_for(lambda: g.count_console(needle) > before, seconds):
        return None
    m = regex.search(g.last_console_line(needle) or "")
    return [int(x) for x in m.groups()] if m else None


def step_rope_settle(g):
    """
    THE ROPES HANG AND DRAW (plan_client_novalve 5.3, cluster 6).

    The map's ropes are managed spans (ClientRopeSystem) drawn through the
    native executor. From ropePose, where the courtyard cables are in view:

      spans > 0, every one hung and sagging   the simulation ran and settled
                                              (a taut zero-sag span is the
                                              failure the initial hang exists
                                              to prevent)
      r_drawropes 1: strips grow              the executor was reached
      r_drawropes 0: strips flat              ...and the counter is the
                                              draw's, not a clock's

    Three rounds of the A/B; the flat side is what proves the step can fail.
    """
    if not g.own_log:
        g.note("attached, so this process captured no log: the rope readout cannot be read")
        return
    pose = g.scen.get("ropePose")
    if not pose:
        g.skip("the scenario names no ropePose")
    g.cheats()
    g.teleport(pose["position"], pose["angles"], settle=2.0)

    needle = "[SourceSharp] cs_cl_rope_spans:"
    hung_before = g.count_console("nodes hung")
    first = read_readout(g, "cs_cl_rope_spans", needle, ROPE_SPANS_RE)
    if not first:
        g.check(False, "cs_cl_rope_spans printed no tally")
        return
    g.check(first[0] > 0, "the map's ropes are managed spans (%d)" % first[0])
    # The rows follow the tally line; console.log accumulates, so count the new ones.
    g.api.wait_for(lambda: g.count_console("nodes hung") - hung_before >= first[0], 10.0)
    hung = g.count_console("nodes hung") - hung_before
    g.check(hung == first[0], "and every span hangs (%d of %d)" % (hung, first[0]))
    row = ROPE_ROW_RE.search(g.last_console_line("nodes hung") or "")
    g.check(bool(row) and float(row.group(3)) > 0.0,
            "and sags: the last span's sag is %s, not the taut zero the initial hang prevents"
            % (row.group(3) if row else "unread"))

    for r in range(EFFECT_ROUNDS):
        g.api.cmd("r_drawropes 1")
        time.sleep(0.3)
        on0 = read_readout(g, "cs_cl_rope_spans", needle, ROPE_SPANS_RE)
        time.sleep(1.0)
        on1 = read_readout(g, "cs_cl_rope_spans", needle, ROPE_SPANS_RE)
        g.api.cmd("r_drawropes 0")
        time.sleep(0.3)
        off0 = read_readout(g, "cs_cl_rope_spans", needle, ROPE_SPANS_RE)
        time.sleep(1.0)
        off1 = read_readout(g, "cs_cl_rope_spans", needle, ROPE_SPANS_RE)
        if not (on0 and on1 and off0 and off1):
            g.check(False, "round %d: a rope readout did not print" % (r + 1))
            break
        g.check(on1[2] > on0[2], "round %d: r_drawropes 1 draws strips (%d -> %d)" % (r + 1, on0[2], on1[2]))
        g.check(off1[2] == off0[2], "round %d: r_drawropes 0 draws none (%d -> %d)" % (r + 1, off0[2], off1[2]))
        g.check(off1[1] > off0[1], "round %d: and the simulation steps either way (%d -> %d)"
                % (r + 1, off0[1], off1[1]))
    g.api.cmd("r_drawropes 1")


def step_beam_ring(g):
    """
    A TEMP ENTITY RING IS CREATED AND DRAWN (plan_client_novalve 5.3, cluster 5).

    cs_te_fire beamringpoint at beamRing, seen from beamPose. The ring goes
    CTEBeamRingPoint -> ClientTeBeamRingPoint -> the managed beam system ->
    a native leaf renderable -> IManagedBeamsClient::BeamsDraw -> the executor's
    BeamDrawMesh. Read through cs_cl_beams:

      created grows                          the player reached the system
      r_DrawBeams 1: meshes grow             the renderable was drawn and the
                                             ring's mesh reached the executor
      r_DrawBeams 0: meshes flat, created    the counter is the draw's, and the
                     still grows             creation is not the draw switch's

    Three rounds of the A/B; the flat side is what proves the step can fail.
    """
    if not g.own_log:
        g.note("attached, so this process captured no log: the beam readout cannot be read")
        return
    pose, ring = g.scen.get("beamPose"), g.scen.get("beamRing")
    if not pose or not ring:
        g.skip("the scenario names no beamPose/beamRing")
    g.cheats()
    g.teleport(pose["position"], pose["angles"], settle=1.0)

    needle = "[SourceSharp] cs_cl_beams:"
    fire = "cs_te_fire beamringpoint %s %s %s" % tuple(ring)
    for r in range(EFFECT_ROUNDS):
        for draw in (1, 0):
            g.api.cmd("r_DrawBeams %d" % draw)
            time.sleep(0.3)
            before = read_readout(g, "cs_cl_beams", needle, BEAMS_RE)
            g.api.cmd(fire)
            time.sleep(0.8)
            after = read_readout(g, "cs_cl_beams", needle, BEAMS_RE)
            if not (before and after):
                g.check(False, "round %d: cs_cl_beams printed no tally" % (r + 1))
                g.api.cmd("r_DrawBeams 1")
                return
            created = after[1] - before[1]
            meshes = after[6] - before[6]
            g.check(created > 0, "round %d, r_DrawBeams %d: the ring was created (%d)" % (r + 1, draw, created))
            if draw:
                g.check(meshes > 0, "round %d: r_DrawBeams 1 draws its mesh (%d meshes)" % (r + 1, meshes))
            else:
                g.check(meshes == 0, "round %d: r_DrawBeams 0 draws none (%d meshes)" % (r + 1, meshes))
    g.api.cmd("r_DrawBeams 1")
    # Let the last rings die before the next step counts anything.
    time.sleep(2.5)


# The material proxies (plan_client_novalve 5.3, cluster 1, lane c5-proxies).
PROXY_ROUNDS = 3
PROXY_SAMPLES = 5


def proxy_reading(g, slot):
    """/client/{slot}/proxies: AnimatedTexture's binds in all, and the bubble sprite proxies' last frames."""
    p = g.api.get("client", str(slot), "proxies")
    binds = sum(n.get("binds", 0) for n in p.get("names", []) if n.get("name") == "AnimatedTexture")
    frames = [x.get("lastOutput", [""])[0] for x in p.get("proxies", [])
              if x.get("name") == "AnimatedTexture" and "bubble" in x.get("material", "") and x.get("lastOutput")]
    return binds, frames


def particle_sphere_reading(g, slot):
    """/client/{slot}/proxies: ParticleSphereProxy's binds in all, and the last
    outputs of the ones on particle/smokestack."""
    p = g.api.get("client", str(slot), "proxies")
    binds = sum(n.get("binds", 0) for n in p.get("names", []) if n.get("name") == "ParticleSphereProxy")
    outputs = [x.get("lastOutput") or [] for x in p.get("proxies", [])
               if x.get("name") == "ParticleSphereProxy" and "smokestack" in x.get("material", "").lower()]
    return binds, outputs


def check_particle_sphere_proxy(g, slot, name):
    """
    THE SMOKESTACK'S LIGHT REACHES ITS MATERIAL THROUGH THE MANAGED PROXY (C7
    particles phase 1). env_smokestack's particle/SmokeStack.vmt names
    ParticleSphereProxy (particle_proxies.cpp, now C#'s): each bind writes the
    particle manager's directional light into $light_position and
    $light_color. Facing the sandbox's stack, A/B on mat_proxy:

      mat_proxy 0: its binds grow, and the last bind wrote two vectors
      mat_proxy 1: its binds stay flat (the counter is the binds')
    """
    stacks = g.api.ents("env_smokestack")
    if len(stacks) != 1:
        g.check(False, "%s holds one env_smokestack for the particle sphere proxy (%d)" % (name, len(stacks)))
        return
    o = [float(v) for v in stacks[0]["origin"]]
    seated(g, {"position": [o[0], o[1] - 224.0, o[2] + 36.0], "angles": [0.0, 90.0, 0.0]})
    try:
        for proxies in (0, 1):
            g.api.cmd("mat_proxy %d" % proxies)
            time.sleep(1.0)
            before, _ = particle_sphere_reading(g, slot)
            time.sleep(1.0)
            after, outputs = particle_sphere_reading(g, slot)
            grown = after - before
            if proxies == 0:
                g.check(grown > 0, "%s, mat_proxy 0: ParticleSphereProxy was bound facing the smokestack (%d binds)"
                        % (name, grown))
                last = outputs[0] if outputs else []
                g.check(len(last) == 2, "%s: its last bind wrote $light_position and $light_color (%s)" % (name, last))
            else:
                g.check(grown == 0, "%s, mat_proxy 1: ParticleSphereProxy is not bound (%d binds)" % (name, grown))
    finally:
        g.api.cmd("mat_proxy 0")
        time.sleep(1.0)


def step_proxy_animated(g):
    """
    AN ANIMATED TEXTURE'S FRAME ADVANCES THROUGH THE MANAGED PROXY (plan_client_novalve 5.3).

    cs_te_fire bubbles in front of the player: the bubble sprites' material
    carries an AnimatedTexture proxy, which native's trampoline binds through
    MaterialProxyHost. Read through /client/{slot}/proxies:

      mat_proxy 0: AnimatedTexture's binds grow     the material system bound it,
                   and the bubbles' frames (the     and the managed proxy set a
                   Int setter's value) take two     frame that moves with time
                   or more values over a second
      mat_proxy 1: AnimatedTexture's binds flat     the counter is the binds',
                                                    not something that grows anyway

    Three rounds of the A/B; the flat side is what proves the step can fail.
    """
    players = g.api.ents(g.scen["playerClass"])
    if len(players) != 1:
        g.check(False, "proxy-animated needs exactly our one player; the server holds %d" % len(players))
        return
    slot = players[0]["index"]
    who = g.api.player(g.scen["playerClass"])
    origin = [float(v) for v in who["origin"]]
    yaw = math.radians(float((who.get("angles") or [0, 0, 0])[1]))
    at = (origin[0] + 80.0 * math.cos(yaw), origin[1] + 80.0 * math.sin(yaw), origin[2])
    g.cheats()
    fire = "cs_te_fire bubbles %.1f %.1f %.1f" % at
    try:
        for r in range(PROXY_ROUNDS):
            for proxies in (0, 1):
                g.api.cmd("mat_proxy %d" % proxies)
                time.sleep(0.5)
                before, _ = proxy_reading(g, slot)
                g.api.cmd(fire)
                seen = set()
                for _ in range(PROXY_SAMPLES):
                    time.sleep(0.25)
                    _, frames = proxy_reading(g, slot)
                    seen.update(frames)
                after, _ = proxy_reading(g, slot)
                grown = after - before
                if proxies == 0:
                    g.check(grown > 0, "round %d, mat_proxy 0: AnimatedTexture was bound (%d binds)" % (r + 1, grown))
                    g.check(len(seen) >= 2, "round %d: the bubbles' frame advanced over a second (%s)"
                            % (r + 1, sorted(seen)))
                else:
                    g.check(grown == 0, "round %d, mat_proxy 1: no proxy is bound (%d binds)" % (r + 1, grown))
    finally:
        g.api.cmd("mat_proxy 0")
        time.sleep(2.0)
VIEWCAM_RE = re.compile(r"cs_cl_viewcam: (\d+) pass\(es\), (\d+) requested, (\d+) queued, (\d+) refused, "
                        r"(\d+) drawn; target (\d+)x(\d+) texture (\d+)")


def step_view_camera(g):
    """
    THE SECOND CAMERA DRAWS INTO ITS TARGET WHEN ON AND NOT WHEN OFF (lane
    camproto, ahead of plan_client_novalve C7).

    cs_cl_overview picks the camera (ViewCameraService); the native executor
    (shell_view_targets.cpp) draws the queued view into _rt_SSView0 from the
    client mode's PreRender. Read through cs_cl_viewcam, whose `drawn` is the
    executor's own count (ViewTargetInfo), not managed's request count:

      target WxH, texture > 0      the engine made the target at load
                                   (ClientRenderTargets001) and the UI has a
                                   vgui texture over it
      mode 1 and 2: drawn grows,   the view reached RenderView, once per
        queued grows, none refused request
      mode 0: drawn and queued     ...and the counter is the camera's, not a
        flat                       frame clock's

    Three rounds of the A/B; the flat side is what proves the step can fail.
    """
    if not g.own_log:
        g.note("attached, so this process captured no log: the camera readout cannot be read")
        return
    # A debug camera (user ruling 2026-10-11): its convars are cheats and the
    # camera stays off without sv_cheats 1.
    g.cheats()
    needle = "[SourceSharp] cs_cl_viewcam:"
    first = read_readout(g, "cs_cl_viewcam", needle, VIEWCAM_RE)
    if not first:
        g.check(False, "cs_cl_viewcam printed no tally")
        return
    g.check(first[5] > 0 and first[6] > 0 and first[7] > 0,
            "the view target exists and the UI has a texture over it (%dx%d, texture %d)"
            % (first[5], first[6], first[7]))
    players = g.api.ents(g.scen["playerClass"])
    slot = players[0]["index"] if len(players) == 1 else None

    def viewcam_snapshot():
        # C7 item 6: on the plan path the view is the plan's monitor pass. The
        # plan's count and native's drawn count are read in ONE game-thread
        # snapshot (/client/{slot}/viewcam), so both cover the same frames:
        # they move together within one RenderView. Read through two routes at
        # two moments (the console readout and /render) the windows differed
        # by a few frames, which a quarter tolerance did not always cover
        # (daily gate, 466d9e12c: 27 of 34).
        if slot is None:
            return None
        try:
            v = g.api.get("client", slot, "viewcam")
        except ApiError:
            return None
        return (v.get("monitorPasses", -1), v.get("drawn", -1)) if "monitorPasses" in v else None
    for r in range(EFFECT_ROUNDS):
        for mode in (1, 2, 0):
            g.api.cmd("cs_cl_overview %d" % mode)
            time.sleep(0.3)
            snap_before = viewcam_snapshot()
            before = read_readout(g, "cs_cl_viewcam", needle, VIEWCAM_RE)
            time.sleep(1.0)
            after = read_readout(g, "cs_cl_viewcam", needle, VIEWCAM_RE)
            snap_after = viewcam_snapshot()
            if not (before and after):
                g.check(False, "round %d: cs_cl_viewcam printed no tally" % (r + 1))
                g.api.cmd("cs_cl_overview 0")
                return
            queued, refused, drawn = after[2] - before[2], after[3] - before[3], after[4] - before[4]
            if mode:
                g.check(drawn > 0 and queued > 0 and refused == 0,
                        "round %d, cs_cl_overview %d: views queued and drawn (%d queued, %d drawn, %d refused)"
                        % (r + 1, mode, queued, drawn, refused))
                if not (snap_before and snap_after):
                    g.check(False, "round %d: /client/%s/viewcam answered no monitor passes" % (r + 1, slot))
                else:
                    passes = snap_after[0] - snap_before[0]
                    drawn_same = snap_after[1] - snap_before[1]
                    g.check(passes > 0 and passes == drawn_same,
                            "round %d, cs_cl_overview %d: the render plan drew them as monitor passes "
                            "(%d passes, %d drawn, one snapshot)" % (r + 1, mode, passes, drawn_same))
            else:
                g.check(drawn == 0 and queued == 0,
                        "round %d, cs_cl_overview 0: nothing queued or drawn (%d queued, %d drawn)"
                        % (r + 1, queued, drawn))
    g.api.cmd("cs_cl_overview 0")


def render_compare(g, slot, mutate, frozen):
    """Asks /client/{slot}/render/compare and waits for its answer at /client/{slot}/render:
    the frozen stock frame at `frozen` (a render-stock recording) against the
    next plan frame (C7 step 3; the live stock compare left with the stock path)."""
    arg = "?mutate=" + ("frozen-mutate:" if mutate else "frozen:") + frozen
    asked = g.api.get("client", slot, "render/compare" + arg)
    if not asked.get("accepted"):
        g.check(False, "the client accepted render/compare: %r" % asked)
        return None
    seq = asked.get("sequence")

    def done():
        c = g.api.get("client", slot, "render").get("compare", {})
        return c if c.get("sequence") == seq and c.get("state") == "done" else None
    c = g.api.wait_for(done, 20.0)
    if not c:
        g.check(False, "the compare (sequence %s) finished within 20 s" % seq)
    return c


RENDER_PLAN_WINDOW_FRAMES = 120


# A compare between two adjacent frames can part because the frames were asked
# different questions, not because the plan answers differently: the leaf
# system listed a view's renderables in another order (dm_lockdown pose 3: two
# entities swap places in a bucket on alternate frames, seen on BOTH paths,
# 2026-10-11), the frames looked from different places, or a call's argument
# follows the clock (auto exposure's goal). Such a try is NOISE and is
# retried; a try that parts with the same scenes on any other call is the
# plan's difference, and fails at once.
RENDER_PLAN_NOISE_TRIES = 8
TIME_VARYING_CALLS = ("ctx.SetGoalToneMappingScale\t",)


def compare_noise(c):
    """Why a parted compare is input noise, or None when it is the plan's."""
    stock, plan = c.get("stock") or "", c.get("plan") or ""
    if stock.startswith("render.SetMainView\t") or plan.startswith("render.SetMainView\t"):
        return None
    if c.get("sceneDifference"):
        return "scenes differ: " + c["sceneDifference"]
    # Two frames that look from different places are NOT noise: the plan
    # frame looking from the last stock frame's spot was the executor leaving
    # CViewRender's m_CurrentView unset (2026-10-11).
    for head in TIME_VARYING_CALLS:
        if stock.startswith(head) and plan.startswith(head):
            return "a clock-driven argument (%s)" % head.strip()
    return None


# The frozen stock frames the live plan frames are held to (C7 step 3: user
# ruling "freeze recordings"): src/test/client/Fixtures/render-stock, recorded
# at the scenario's renderStand and renderPoses (its README).
FROZEN_RENDER_DIR = os.path.join(ROOT, "src", "test", "client", "Fixtures", "render-stock")
FROZEN_RENDER_MODE = (1280, 720)
# Seconds between frozen compares whose scenes differ by a renderable: HL2MP
# items respawn within 30 s, and 8 tries at this spacing cover it.
FROZEN_RESPAWN_WAIT = 5.0
GATE_VIDEO_MODE = (640, 480)   # the launch's -w/-h


def frozen_frame(g, name):
    """The frozen frame's path, or None (checked) when it is missing."""
    path = os.path.join(FROZEN_RENDER_DIR, name)
    if not os.path.isfile(path):
        g.check(False, "the frozen frame %s is there to hold the plan to" % path)
        return None
    return path


def seated(g, pose):
    """Teleports to `pose` and lets the props near it come to rest."""
    g.teleport(pose["position"], pose["angles"], settle=1.0)
    time.sleep(0.5)


def equal_compare(g, slot, label, pose, frozen):
    """A plain compare at the pose the player is at, retried while the two frames
    differ only by input noise. Returns the equal compare, or None (checked).
    With `pose`, a try whose frames looked from different places seats the
    player again before the next (the shadow had not caught up)."""
    noise = 0
    for t in range(RENDER_PLAN_NOISE_TRIES):
        c = render_compare(g, slot, mutate=False, frozen=frozen)
        if not c:
            return None
        if c.get("equal") and pose is not None:
            view = c.get("mainView") or ""
            m = re.search(r"origin=([-0-9.e]+),([-0-9.e]+),", view)
            g.check(bool(m) and abs(float(m.group(1)) - pose["position"][0]) < 1.0
                    and abs(float(m.group(2)) - pose["position"][1]) < 1.0,
                    "%s: both frames looked from the pose (%s)" % (label, view.split("\t", 1)[-1]))
        if c.get("equal"):
            g.check(c.get("stockCalls", 0) > 50 and c.get("planCalls") == c.get("stockCalls")
                    and str(c.get("planNote", "")).startswith("ops="),
                    "%s: the frozen frame and a plan frame made the same %d calls, the plan frame the plan's (%r)%s"
                    % (label, c.get("planCalls", 0), c.get("planNote"),
                       "" if noise == 0 else ", after %d noisy tries" % noise))
            # The copy texture each frame began with is session history (a
            # visit to ss_sandbox leaves _rt_fullframefb); say both, so a pass
            # that held across different starts shows it did.
            g.say("    (%s: the frames began with copy texture %r and %r)"
                  % (label, c.get("stockCopyStart"), c.get("planCopyStart")))
            return c
        why = compare_noise(c)
        g.say("    (%s try %d: parted at call %s: stock %r, plan %r; %s)"
              % (label, t + 1, c.get("index"), c.get("stock"), c.get("plan"), why or "THE SAME INPUTS"))
        if why is None:
            g.check(False, "%s: the plan parted from stock with the same inputs (call %s: stock %r, plan %r)"
                    % (label, c.get("index"), c.get("stock"), c.get("plan")))
            return None
        noise += 1
        # Against a frozen frame, a scene with a renderable more or fewer is the
        # world, not the frame: an item the gate's player picked up is gone
        # until it respawns. Give it the time to come back.
        if frozen and "entries against" in why:
            time.sleep(FROZEN_RESPAWN_WAIT)
    g.check(False, "%s: %d tries, and the two frames' inputs never held still" % (label, noise))
    return None


def control_compare(g, slot, label, frozen):
    """The mutate control: the plan frame drops DrawLights, and the two frames
    must part exactly there. A try that parts earlier on input noise
    (compare_noise) is retried; the control must still see the drop."""
    for t in range(RENDER_PLAN_NOISE_TRIES):
        m = render_compare(g, slot, mutate=True, frozen=frozen)
        if not m:
            return None
        if m.get("mutated") and not m.get("equal") and m.get("stock") == "render.DrawLights":
            g.check(True, "%s, the control: with DrawLights dropped the frames part there (call %s)%s"
                    % (label, m.get("index"), "" if t == 0 else ", after %d noisy tries" % t))
            return m
        why = None if m.get("equal") else compare_noise(m)
        g.say("    (%s control try %d: parted at call %s: stock %r, plan %r; %s)"
              % (label, t + 1, m.get("index"), m.get("stock"), m.get("plan"), why or "NOT AT THE DROP"))
        if why is None:
            break
        if frozen and "entries against" in why:
            time.sleep(FROZEN_RESPAWN_WAIT)
    g.check(False, "%s, the control: with DrawLights dropped the frames part there" % label)
    return None


def view_program_counts(g, slot):
    r = g.api.get("client", slot, "render")
    return (r.get("viewPrograms", -1), r.get("viewProgramsDeclined", -1), r.get("viewDecisions", -1))


def check_view_programs(g, slot, before, label):
    """C7 step 2's stimulus: the plan frames drew their world views from
    managed's view programs, and no view fell back to stock's primitives.
    C7 step 3: managed decided each frame's view (view.cpp's SetUpViews and
    Render, ViewFrame), which CShellViewRender carried out."""
    after = view_program_counts(g, slot)
    g.check(before[0] >= 0 and after[0] - before[0] > 0,
            "%s: plan frames drew %d world views from managed's view programs"
            % (label, after[0] - before[0]))
    g.check(after[1] - before[1] == 0,
            "%s: no world view fell back to stock's primitives (%d did)" % (label, after[1] - before[1]))
    g.check(before[2] >= 0 and after[2] - before[2] > 0,
            "%s: managed decided %d frames' views" % (label, after[2] - before[2]))


def render_plan_costs(g, slot):
    """The plan's cost at the stand: the client's crossings per frame
    (/client/{slot}/status) and CViewRender::Render's wall time
    (/client/{slot}/render's planTimes), over one window. Reported, and checked
    only for a stimulus: the window drew frames. (Stock's side left with the
    stock path, C7 step 3.)"""
    g.api.get("client", slot, "render?reset=1")
    before = g.api.client_crossings(slot)

    def enough():
        now = g.api.client_crossings(slot)
        return now if now.get("clientFrames", 0) - before.get("clientFrames", 0) >= RENDER_PLAN_WINDOW_FRAMES else None
    after = g.api.wait_for(enough, 30.0) or g.api.client_crossings(slot)
    times = g.api.get("client", slot, "render").get("planTimes", {})
    frames = after.get("clientFrames", 0) - before.get("clientFrames", 0)
    total = after.get("total", 0) - before.get("total", 0)
    g.check(times.get("frames", 0) > 0 and frames > 0,
            "the plan window drew %d client frames (%d timed)" % (frames, times.get("frames", 0)))
    g.say("    plan   %.2f crossings / client frame (%d / %d); Render %.3f ms avg, %.3f ms max over %d frames"
          % (total / max(frames, 1), total, frames, times.get("msAvg", 0), times.get("msMax", 0), times.get("frames", 0)))


def plan_frame_invariants(g, slot, label):
    """A recorded plan frame holds together without an oracle (C7 step 3: the
    sandbox's moving props make a frozen frame noisy there): it is the plan's
    (`plan ops=N`, not declined), it opens with the main view, and every view
    it pushes it pops. Returns the frame's calls, or None (checked)."""
    where = tempfile.mkdtemp(prefix="ss-plan-frame-")
    path = os.path.join(where, "frame.txt")
    try:
        g.api.cmd("cs_cl_render_trace %s" % path)
        text = g.api.wait_for(lambda: (lambda t: t if t and "\nrender.PopView" in t else None)(
            open(path).read() if os.path.isfile(path) else None), 20.0, 0.25)
    finally:
        shutil.rmtree(where, ignore_errors=True)
    if not text:
        g.check(False, "%s: a plan frame was recorded to %s" % (label, path))
        return None
    lines = text.split("\n")
    calls = [l for l in lines if l and not l.split("\t", 1)[0] in ("frame", "plan", "cvar", "env", "q", "in", "inbytes", "scene", "scenebytes")]
    planned = any(l.startswith("plan\tops=") for l in lines)
    declined = any(l.startswith("plan\tdeclined") for l in lines)
    pushes = sum(1 for c in calls if c.startswith(("render.Push3DView\t", "render.Push2DView\t")))
    pops = sum(1 for c in calls if c.startswith("render.PopView"))
    g.check(planned and not declined and calls and calls[0].startswith("render.SetMainView\t") and pushes > 1 and pushes == pops,
            "%s: the plan frame is the plan's, opens with the main view, and pops every view it pushes "
            "(%d calls, %d pushed, %d popped%s)" % (label, len(calls), pushes, pops, ", DECLINED" if declined else ""))
    return calls


def step_render_plan(g):
    """
    THE RENDER PLAN DRAWS WHAT STOCK DREW, CALL FOR CALL (plan_client_novalve 5.3,
    C7; since step 3 against the FROZEN stock frames, user ruling "freeze
    recordings": the live stock path is gone).

    At 1280x720 (the frames' mode), at the scenario's renderStand and both
    renderPoses, /client/{slot}/render/compare?mutate=frozen:PATH holds the next
    plan frame to src/test/client/Fixtures/render-stock/dm_lockdown-poseN.txt:
    every call client.so makes on the engine's render interfaces, with each
    frame's entities numbered by first appearance (the two sessions numbered
    them apart).

      plain:   equal, over 50 calls, the plan frame the plan's     the plan draws what stock drew
      control: with DrawLights dropped from the plan frame, the    the compare can see one
               two part exactly there (pose 1)                     missing call

    A plain compare that differs is retried while the difference is input noise
    (compare_noise: the scenes differ -- an item the player picked up is gone
    until it respawns, so those tries wait -- or a clock-driven argument does),
    up to RENDER_PLAN_NOISE_TRIES; one that parts with the same inputs fails at
    once. Then the debug overlays (no frozen frame has them) are held to the
    plan frame's own invariants, the views drew from managed's programs with
    none declined, the view decisions and their oracle ran, and the plan's cost
    at the stand is reported.
    """
    players = g.api.ents(g.scen["playerClass"])
    if len(players) != 1:
        g.check(False, "render-plan needs exactly our one player; the server holds %d" % len(players))
        return
    slot = players[0]["index"]
    stand = g.scen.get("renderStand")
    if not stand:
        g.check(False, "the scenario names no renderStand")
        return
    g.cheats()
    me = g.api.player(g.scen["playerClass"]) or {}
    home = (me.get("origin"), me.get("angles"))
    g.teleport(stand["position"], stand["angles"], settle=1.0)
    programs = view_program_counts(g, slot)
    # NOT phys_timescale 0: frozen physics leaves the player's physics shadow
    # where it was and the shadow update pulls the player back there on
    # alternate frames (every other frame looked from another spot,
    # 2026-10-11). A pose must stand clear of props instead (renderPoses).
    seated(g, stand)
    try:
        # C7 step 3: the plan frame held to the FROZEN stock frame at each
        # recorded pose, and the control parts them at the dropped DrawLights.
        frozen_poses = [(stand, "dm_lockdown-pose1.txt")] + list(zip(g.scen.get("renderPoses", []),
                                                                      ["dm_lockdown-pose2.txt", "dm_lockdown-pose3.txt"]))
        g.check(len(frozen_poses) == 3, "dm_lockdown has a frozen frame for the stand and each render pose (%d)" % len(frozen_poses))
        # The frozen frames were drawn at 1280x720 (their README); the gate
        # runs at 640x480, so the compares run at the frames' own mode.
        g.api.cmd("mat_setvideomode %d %d 1" % FROZEN_RENDER_MODE)
        try:
            moded = g.api.wait_for(lambda: (lambda m: m if (m.get("w"), m.get("h")) == FROZEN_RENDER_MODE else None)(ui_menu(g, slot)), 20.0)
            g.check(bool(moded), "the client is at the frozen frames' %dx%d" % FROZEN_RENDER_MODE)
            for pose, name in frozen_poses:
                path = frozen_frame(g, name)
                if not path:
                    continue
                seated(g, pose)
                equal_compare(g, slot, "frozen %s" % name, pose, frozen=path)
                if name.endswith("pose1.txt"):
                    control_compare(g, slot, "frozen %s" % name, frozen=path)
        finally:
            g.api.cmd("mat_setvideomode %d %d 1" % GATE_VIDEO_MODE)
            g.api.wait_for(lambda: (lambda m: m if (m.get("w"), m.get("h")) == GATE_VIDEO_MODE else None)(ui_menu(g, slot)), 20.0)
        # C7 step 2: the 2D debug overlays are the plan's ops. No frozen frame
        # has them on, so with the ones that make recorded calls switched on the
        # plan frame is held to its own invariants, and draws more than without.
        g.teleport(stand["position"], stand["angles"], settle=1.0)
        plain = plan_frame_invariants(g, slot, "debug overlays off")
        overlays = ("mat_showframebuffertexture", "mat_showwatertextures", "cl_drawshadowtexture", "mat_showcamerarendertarget")
        try:
            for name in overlays:
                g.api.cmd("%s 1" % name)
            time.sleep(0.3)
            shown = plan_frame_invariants(g, slot, "debug overlays on (%s)" % ", ".join(overlays))
            if plain is not None and shown is not None:
                g.check(len(shown) > len(plain),
                        "the debug overlays drew through the plan (%d calls against %d)" % (len(shown), len(plain)))
        finally:
            for name in overlays:
                g.api.cmd("%s 0" % name)
        check_view_programs(g, slot, programs, "dm_lockdown")
        g.teleport(stand["position"], stand["angles"], settle=1.0)
        render_plan_costs(g, slot)
    finally:
        if home[0]:
            g.teleport(home[0], home[1], settle=1.0)


def step_render_plan_sandbox(g):
    """
    THE RENDER PLAN AND THE DRAW BATCH ON A SECOND MAP (plan_client_novalve C7
    step 2). Every other render step runs on dm_lockdown, whose view lists hold
    only entities; ss_sandbox's hold renderables that are not (detail sprites,
    particle systems: CDefaultClientRenderable, whose GetRefEHandle is a null
    dereference). The draw batch asked every one for its handle and ss_sandbox's
    first frame died there (b4eec29fb), with no render step to see it.

    Changes to the scenario's otherMap (skipped when the map was not built in
    this tree: it is per-tree output) and, with the draw batch on:

      the game survives the change and the client rejoins (the batch's crash
      was on the first frame)
      at the spawn and each of otherMap's renderPoses, the plan frame holds
      together on its own (C7 step 3: the sandbox's moving props make a frozen
      frame noisy): the plan's, not declined, opening with the main view,
      every pushed view popped
      the plan frames drew from managed's view programs, none fell back; the
      view decisions and their oracle ran
      cs_cl_effects_report printed: the batch ran (draw batches > 0)
      facing the smokestack, ParticleSphereProxy binds through the managed
      proxy with mat_proxy 0 and not with 1 (check_particle_sphere_proxy)

    and changes back.
    """
    other = g.scen.get("otherMap")
    if not other or not other.get("renderPoses"):
        g.skip("the scenario names no otherMap with renderPoses")
        return
    name = other["map"]
    if not os.path.exists(os.path.join(MOD_DIR, "maps", name + ".bsp")):
        g.skip("%s.bsp was not built in this tree (make map MAP=%s): per-tree output" % (name, name))
        return
    g.cheats()
    g.api.cmd("cs_cl_draw_batch 1")
    g.api.cmd("map %s" % name)
    g.api.wait_for(lambda: g.api.census()[0] >= other["minEntities"], 180.0, 1.0)
    if not g.api.alive():
        g.check(False, "the process survived the change to %s with the plan path and the draw batch on" % name)
        g.say("       attribute the core:  coredumpctl info %s" % g.api.pid)
        return
    try:
        player = g.api.wait_for(lambda: g.api.player(g.scen["playerClass"]), 60.0)
        g.check(bool(player), "the client joined %s" % name)
        if not player:
            return
        g.cheats()
        players = g.api.ents(g.scen["playerClass"])
        slot = players[0]["index"] if len(players) == 1 else None
        if slot is None:
            g.check(False, "render-plan-sandbox needs exactly our one player; the server holds %d" % len(players))
            return
        attached = g.api.wait_for(lambda: "error" not in g.api.get("client", slot, "render"), 60.0, 0.5)
        g.check(bool(attached), "the client in slot %d answers /render on %s" % (slot, name))
        if not attached:
            return
        time.sleep(1.0)
        programs = view_program_counts(g, slot)
        effects = effects_counts(g)
        # C7 step 3: plan-only invariants here (the sandbox's moving props make
        # a frozen frame noisy): the frame is the plan's and balanced, at the
        # spawn and at each pose.
        plan_frame_invariants(g, slot, "%s spawn" % name)
        for i, pose in enumerate(other["renderPoses"]):
            seated(g, pose)
            plan_frame_invariants(g, slot, "%s pose %d %s" % (name, i + 1, pose["position"]))
        check_view_programs(g, slot, programs, name)
        check_particle_sphere_proxy(g, slot, name)
        after = effects_counts(g)
        g.check(effects is not None and after is not None and after["draw batches"] > effects["draw batches"],
                "%s: the draw batch ran over its views (%s draw batches)"
                % (name, None if after is None or effects is None else after["draw batches"] - effects["draw batches"]))
        g.check(g.api.alive(), "the process is alive after %s's frames" % name)
    finally:
        if g.api.alive():
            g.api.cmd("map %s" % g.scen["map"])
            g.api.wait_for(lambda: g.api.census()[0] == g.scen["entities"], 180.0, 1.0)
            g.api.wait_for(lambda: g.api.player(g.scen["playerClass"]), 60.0)


#-----------------------------------------------------------------------------
# phys-convert (plan_physics_bones_native_zero, the last server physics lane).
#-----------------------------------------------------------------------------
# ss_sandbox's physbrush station: two phys_converts, each with one target hung
# in the air, and a control of the same class nothing targets. The names are
# the generator's (Site.Name: station slug + "_" + suffix).
PHYS_CONVERT_KINDS = [
    # (converter, target, the class it is, the class stock makes of it)
    ("physbrush_convertslab", "physbrush_slab", "func_brush", "simple_physics_brush"),
    # The map places the crate as prop_dynamic_override: on a physics prop's
    # model a plain prop_dynamic is deleted as it spawns, in stock and here.
    # Stock renames the override prop_dynamic after spawning; this mod keeps
    # the map's classname (docs/todo.md), so that is the class it is here.
    ("physbrush_convert", "physbrush_scenery0", "prop_dynamic_override", "simple_physics_prop"),
]
PHYS_CONVERT_CONTROL = ("physbrush_scenery1", "prop_dynamic_override")
PHYS_CONVERT_FALL = 16.0      # units a converted copy drops below where it hung
PHYS_CONVERT_SECONDS = 3.0    # how long it is given to fall


def phys_convert_fell(hung_z, samples_z, fall=PHYS_CONVERT_FALL):
    """PURE. Whether a copy that started at hung_z went down by at least `fall`
    in any of samples_z. None in the samples (not found that read) is skipped;
    no sample at all is not a fall."""
    seen = [z for z in samples_z if z is not None]
    return bool(seen) and min(seen) <= hung_z - fall


def step_phys_convert(g):
    """
    PHYS_CONVERT CONVERTS, LIVE (plan_physics_bones_native_zero). phys_convert
    was ported to managed at c0283726a (stock's InputConvertTarget,
    CreateSimplePhysicsObject and TransferPhysicsObject, PhysicsConversion) and
    nothing fired one live: ss_sandbox's station held hand-placed stand-ins for
    the two classes the conversion makes, because it used to make none.

    Changes to the scenario's otherMap (skipped when the map was not built in
    this tree: it is per-tree output), fires each of the physbrush station's two
    converters, and checks for each target -- a func_brush and a prop_dynamic,
    both hanging in the air:

      before: the target is there by its name, as the class the map placed;
      the map holds no simple_physics_brush or simple_physics_prop at all (the
      control: any found after are the conversion's)
      after: the ORIGINAL is gone (its handle answers nothing)
      the NAME moved across: the name now answers a different entity, of the
      class stock makes of that kind
      it is SIMULATED: it falls at least PHYS_CONVERT_FALL units from where the
      original hung within PHYS_CONVERT_SECONDS
      and the control, a prop_dynamic nothing targets, is still there and
      still hanging where it was

    and changes back.
    """
    other = g.scen.get("otherMap")
    if not other:
        g.skip("the scenario names no otherMap")
        return
    name = other["map"]
    if not os.path.exists(os.path.join(MOD_DIR, "maps", name + ".bsp")):
        g.skip("%s.bsp was not built in this tree (make map MAP=%s): per-tree output" % (name, name))
        return
    g.cheats()
    g.api.cmd("map %s" % name)
    g.api.wait_for(lambda: g.api.census()[0] >= other["minEntities"], 180.0, 1.0)
    if not g.api.alive():
        g.check(False, "the process survived the change to %s" % name)
        g.say("       attribute the core:  coredumpctl info %s" % g.api.pid)
        return
    try:
        player = g.api.wait_for(lambda: g.api.player(g.scen["playerClass"]), 60.0)
        g.check(bool(player), "the client joined %s" % name)
        if not player:
            return

        # -- before ---------------------------------------------------------
        for made in ("simple_physics_brush", "simple_physics_prop"):
            g.check(len(g.api.ents(made)) == 0,
                    "%s holds no %s before the converters fire (%d), so any after are theirs"
                    % (name, made, len(g.api.ents(made))))
        originals = {}
        for converter, target, kind, _made in PHYS_CONVERT_KINDS:
            found = g.api.entity(name=target)
            g.check(bool(found) and found.get("classname") == kind,
                    "%s is there by its name as the %s the map placed (%s)"
                    % (target, kind, None if not found else found.get("classname")))
            if not found:
                return
            originals[target] = found
        control = g.api.entity(name=PHYS_CONVERT_CONTROL[0])
        g.check(bool(control) and control.get("classname") == PHYS_CONVERT_CONTROL[1],
                "the control %s is there as a %s" % PHYS_CONVERT_CONTROL)

        # -- convert --------------------------------------------------------
        for converter, target, kind, _made in PHYS_CONVERT_KINDS:
            reply = g.api.fire(converter, "ConvertTarget")
            g.check(reply.get("matchedBy") == "name" and reply.get("targets") == 1
                    and reply.get("accepted", 0) >= 1,
                    "ConvertTarget reached and was accepted by exactly one %s (matchedBy %r, "
                    "%s target(s), %s accepted)"
                    % (converter, reply.get("matchedBy"), reply.get("targets"), reply.get("accepted")))

        # -- after: the copy falls ------------------------------------------
        samples = {target: [] for _c, target, _k, _m in PHYS_CONVERT_KINDS}
        copies = {}
        deadline = time.time() + PHYS_CONVERT_SECONDS
        while time.time() < deadline:
            g.api.wait_ticks(6)
            for _c, target, _k, _m in PHYS_CONVERT_KINDS:
                now = g.api.entity(name=target)
                if now and now.get("handle") != originals[target]["handle"]:
                    copies[target] = now
                    samples[target].append(now["origin"][2])

        for _c, target, kind, made in PHYS_CONVERT_KINDS:
            before = originals[target]
            gone = g.api.entity(handle=before["handle"])
            g.check(gone is None,
                    "the original %s %s (handle %s) is gone after the conversion"
                    % (kind, target, before["handle"]))
            copy = copies.get(target)
            g.check(bool(copy) and copy.get("classname") == made,
                    "the name %s moved across to a new %s (%s)"
                    % (target, made, None if not copy else "%s, handle %s" % (copy.get("classname"), copy.get("handle"))))
            hung = before["origin"][2]
            g.check(phys_convert_fell(hung, samples[target]),
                    "the %s made of %s is simulated: it fell from z %.1f to %s within %.1fs (at least %.0f units)"
                    % (made, target, hung,
                       "%.1f" % min(samples[target]) if samples[target] else "nothing read",
                       PHYS_CONVERT_SECONDS, PHYS_CONVERT_FALL))

        still = g.api.entity(name=PHYS_CONVERT_CONTROL[0])
        g.check(bool(control) and bool(still) and still.get("handle") == control.get("handle")
                and abs(still["origin"][2] - control["origin"][2]) < 1.0,
                "the control %s is the same entity, still hanging where it was" % PHYS_CONVERT_CONTROL[0])
        g.check(g.api.alive(), "the process is alive after the conversions")
    finally:
        if g.api.alive():
            g.api.cmd("map %s" % g.scen["map"])
            g.api.wait_for(lambda: g.api.census()[0] == g.scen["entities"], 180.0, 1.0)
            g.api.wait_for(lambda: g.api.player(g.scen["playerClass"]), 60.0)


# The custom-draw batch (plan_client_novalve C7 item 7).
DRAW_BATCH_ROUNDS = 3
DRAW_BATCH_LABELS = ("sprite quads", "draw batches", "batched sprites", "batch fallbacks")


def effects_counts(g):
    """cs_cl_effects_report's draw counters, read off the console; None if it did not print."""
    before = g.count_console("  batch fallbacks")
    g.api.cmd("cs_cl_effects_report")
    if not g.api.wait_for(lambda: g.count_console("  batch fallbacks") > before, 20.0):
        return None
    counts = {}
    for label in DRAW_BATCH_LABELS:
        m = re.search(r"%s\s+(-?\d+)" % re.escape(label), g.last_console_line("  " + label) or "")
        if not m:
            return None
        counts[label] = int(m.group(1))
    return counts


def step_draw_batch(g):
    """
    A VIEW'S CUSTOM DRAWS COST ONE CROSSING, NOT ONE EACH (plan_client_novalve C7
    item 7).

    At the renderStand, where the map's env_sprites and point_spotlight beams are
    in view, a 120-frame window with cs_cl_draw_batch 1 and one with 0, three
    rounds, read through cs_cl_effects_report and /client/{slot}/status:

      batch 1:  views batched (> 0), sprites drawn from their prepared plans
                (> 0), fallbacks a few at most
      batch 0:  native still asks once a view and managed prepares nothing:
                no sprite draws from a prepared plan, every custom draw
                crosses on its own (the fallback counter grows) -- the
                counters are the batch's
      both:     the same sprite quads a view (within 10%): the same sprites
                draw either way
      and:      batch 1 crosses at least 5 times fewer a client frame
    """
    if not g.own_log:
        g.note("attached, so this process captured no log: the effects readout cannot be read")
        return
    players = g.api.ents(g.scen["playerClass"])
    if len(players) != 1:
        g.check(False, "draw-batch needs exactly our one player; the server holds %d" % len(players))
        return
    slot = players[0]["index"]
    stand = g.scen.get("renderStand")
    if not stand:
        g.check(False, "the scenario names no renderStand")
        return
    g.cheats()
    me = g.api.player(g.scen["playerClass"]) or {}
    home = (me.get("origin"), me.get("angles"))
    g.teleport(stand["position"], stand["angles"], settle=1.0)
    try:
        for r in range(DRAW_BATCH_ROUNDS):
            seen = {}
            for on in (1, 0):
                g.api.cmd("cs_cl_draw_batch %d" % on)
                time.sleep(0.5)
                c0 = effects_counts(g)
                x0 = g.api.client_crossings(slot)

                def enough():
                    now = g.api.client_crossings(slot)
                    return now if now.get("clientFrames", 0) - x0.get("clientFrames", 0) >= RENDER_PLAN_WINDOW_FRAMES else None
                x1 = g.api.wait_for(enough, 30.0) or g.api.client_crossings(slot)
                c1 = effects_counts(g)
                if not c0 or not c1:
                    g.check(False, "round %d: cs_cl_effects_report printed its draw counters" % (r + 1))
                    return
                frames = max(x1.get("clientFrames", 0) - x0.get("clientFrames", 0), 1)
                d = {k: c1[k] - c0[k] for k in DRAW_BATCH_LABELS}
                seen[on] = (d, (x1.get("total", 0) - x0.get("total", 0)) / frames, frames)
                g.say("    round %d batch %d: %d frames, %.2f crossings/frame, %s"
                      % (r + 1, on, frames, seen[on][1], ", ".join("%s %d" % kv for kv in d.items())))
            on_d, on_x, on_f = seen[1]
            off_d, off_x, off_f = seen[0]
            g.check(on_d["draw batches"] > 0 and on_d["batched sprites"] > 0,
                    "round %d, batch 1: %d views batched, %d sprites drawn from their plans"
                    % (r + 1, on_d["draw batches"], on_d["batched sprites"]))
            g.check(on_d["batch fallbacks"] * 20 <= max(on_d["batched sprites"], 1),
                    "round %d, batch 1: %d fallbacks against %d batched" % (r + 1, on_d["batch fallbacks"], on_d["batched sprites"]))
            g.check(off_d["batched sprites"] == 0 and off_d["batch fallbacks"] > 0,
                    "round %d, batch 0: no sprite drew from a prepared plan (%d); every custom draw crossed on its own (%d)"
                    % (r + 1, off_d["batched sprites"], off_d["batch fallbacks"]))
            # Per view, not per client frame: the views a frame draws vary
            # between windows (1.03 to 1.29 a frame at the stand, 2026-10-11,
            # with the second camera's lane landed), and a per-frame ratio
            # failed 2 of 6 rounds on that alone while every window drew
            # exactly 7.0 quads a view. Both modes ask once a view.
            q_on = on_d["sprite quads"] / float(max(on_d["draw batches"], 1))
            q_off = off_d["sprite quads"] / float(max(off_d["draw batches"], 1))
            g.check(q_on > 0 and abs(q_on - q_off) <= 0.1 * max(q_on, q_off),
                    "round %d: the same sprite quads a view either way (%.2f batched, %.2f not)" % (r + 1, q_on, q_off))
            g.check(off_x - on_x >= 5.0,
                    "round %d: the batch saves crossings (%.2f a frame batched, %.2f not)" % (r + 1, on_x, off_x))
    finally:
        g.api.cmd("cs_cl_draw_batch 1")
        if home[0]:
            g.teleport(home[0], home[1], settle=1.0)


# The UI's menu layer (plan_client_ui U3), read through the client's routes.
UI_ROUNDS = 3


def ui_menu(g, slot):
    """The client's menu layer: open screens, whether it has the input, its draws."""
    return g.api.get("client", str(slot), "ui/menu")


def ui_texts(menu):
    return [d.get("text", "") for d in menu.get("draws", []) if d.get("kind") == "Text"]


def ui_slot(g):
    players = g.api.ents(g.scen["playerClass"])
    if len(players) != 1:
        g.check(False, "the UI steps need exactly our one player; the server holds %d" % len(players))
        return None
    slot = players[0]["index"]
    if not g.api.wait_for(lambda: ui_menu(g, slot).get("built") is not None or None, 30.0):
        g.check(False, "the client answers /client/%d/ui/menu (launched with -debuguiserve -debugui?)" % slot)
        return None
    # The server sends the MOTD on every join (lane player-msgs): out of the
    # way first, or it holds the mouse and covers what a step reads.
    if "motd" in ui_menu(g, slot).get("open", []):
        g.api.cmd("cs_ui_close motd")
        g.api.wait_for(lambda: "motd" not in ui_menu(g, slot).get("open", []) or None, 10.0)
    return slot


def step_ui_scoreboard(g):
    """
    THE SCOREBOARD IS THE UI'S AND +SHOWSCORES HOLDS IT (plan_client_ui U3).

    +showscores reaches the viewport's ShowPanel("scores"), which the UI takes:
    the menu layer opens `scoreboard` and draws its rows (the PLAYER column
    header among them); -showscores closes it and the layer draws nothing.
    Three rounds; the released side, with no draws, is what proves the held
    side's draws are the scoreboard's.
    """
    slot = ui_slot(g)
    if slot is None:
        return
    for r in range(UI_ROUNDS):
        g.api.cmd("+showscores")
        held = g.api.wait_for(lambda: (lambda m: m if "scoreboard" in m.get("open", []) else None)(ui_menu(g, slot)), 10.0)
        g.check(bool(held), "round %d: +showscores opened the UI's scoreboard" % (r + 1))
        if held:
            texts = ui_texts(held)
            g.check("PLAYER" in texts and len(held.get("draws", [])) > 10,
                    "round %d: it drew its rows (%d draws, PLAYER header %s)"
                    % (r + 1, len(held.get("draws", [])), "PLAYER" in texts))
            g.check(not held.get("menuInput"), "round %d: holding it does not take the mouse" % (r + 1))
        g.api.cmd("-showscores")
        gone = g.api.wait_for(lambda: (lambda m: m if "scoreboard" not in m.get("open", []) else None)(ui_menu(g, slot)), 10.0)
        g.check(bool(gone), "round %d: -showscores closed it" % (r + 1))
        if gone:
            time.sleep(0.3)
            g.check(len(ui_menu(g, slot).get("draws", [])) == 0, "round %d: released, the menu layer draws nothing" % (r + 1))


def step_ui_teammenu(g):
    """
    THE SERVER'S TEAM MENU IS THE UI'S, AND A CLICK REACHES THE SERVER (U3).

    cs_sv_showpanel sends stock's VGUIMenu "team"; the UI opens `teammenu` and
    takes the mouse. An injected click (/client/{slot}/ui/event) on AUTO ASSIGN
    sends `jointeam 0`, which the server hears: stock HL2MP's
    HandleCommand_JoinTeam refuses team 0 with its "invalid team index"
    warning (hl2mp_player.cpp), and the menu closes and gives the mouse back.
    The control: the same click with no menu open sends nothing. (The needle
    was "jointeam 0 from player N" until the team service replaced that
    placeholder line.)
    """
    slot = ui_slot(g)
    if slot is None:
        return
    g.cheats()
    needle = "HandleCommand_JoinTeam( 0 ) - invalid team index."

    def click(x, y):
        for kind, code in ((0, 0), (1, 107), (2, 107)):
            g.api.get("client", str(slot), "ui/event?e=%d,%d,%d,%d" % (kind, x, y, code))

    for r in range(UI_ROUNDS):
        g.api.cmd("cs_sv_showpanel %d team" % slot)
        menu = g.api.wait_for(lambda: (lambda m: m if "teammenu" in m.get("open", []) else None)(ui_menu(g, slot)), 10.0)
        g.check(bool(menu), "round %d: the server's VGUIMenu team opened the UI's team menu" % (r + 1))
        if not menu:
            return
        time.sleep(0.3)
        menu = ui_menu(g, slot)
        g.check(menu.get("menuInput"), "round %d: the team menu took the mouse" % (r + 1))
        auto = [d for d in menu.get("draws", []) if d.get("kind") == "Text" and d.get("text") == "AUTO ASSIGN"]
        g.check(bool(auto), "round %d: AUTO ASSIGN is drawn" % (r + 1))
        if not auto:
            return
        x, y = auto[-1]["x0"] + 12, auto[-1]["y0"] + 8
        before = g.count_console(needle)
        click(x, y)
        heard = g.api.wait_for(lambda: g.count_console(needle) > before or None, 10.0)
        g.check(bool(heard), "round %d: the click sent jointeam 0 and the server heard it" % (r + 1))
        closed = g.api.wait_for(lambda: (lambda m: m if "teammenu" not in m.get("open", []) and not m.get("menuInput") else None)(ui_menu(g, slot)), 10.0)
        g.check(bool(closed), "round %d: the menu closed and gave the mouse back" % (r + 1))

        # The control: the same click with nothing open sends nothing.
        before = g.count_console(needle)
        click(x, y)
        time.sleep(1.0)
        g.check(g.count_console(needle) == before, "round %d: the same click with no menu sends nothing" % (r + 1))


# The Damage message (lane player-msgs): read on the client, not the server.
DAMAGE_ROUNDS = 3
DAMAGE_QUIET = 1.5      # seconds of no hurt the control watches
DAMAGE_HIT = 5          # small, so five hits leave the player standing


def damage_received(g, slot):
    """How many Damage user messages the client has received (its status's userMessages)."""
    return g.api.get("client", str(slot), "status").get("userMessages", {}).get("Damage", 0)


def vignette_edges(ui):
    """(left, right): the UI's draws spanning the full height at the left or right edge."""
    w, h = ui.get("w", 0), ui.get("h", 0)
    left = right = 0
    for d in ui.get("draws", []):
        if d.get("y0", 1) > 0 or d.get("y1", 0) < h:
            continue
        if d.get("x0", 1) <= 0 and d.get("x1", w) < w // 2:
            left += 1
        if d.get("x1", 0) >= w and d.get("x0", 0) > w // 2:
            right += 1
    return left, right


def ui_frame(g, slot):
    return g.api.get("client", str(slot), "ui")


def lit(g, slot, want, seconds=0.9):
    """The vignette's edges once `want(left, right)` holds, polled for under its one-second fade."""
    end = time.time() + seconds
    edges = (0, 0)
    while time.time() < end:
        edges = vignette_edges(ui_frame(g, slot))
        if want(*edges):
            return edges, True
        time.sleep(0.05)
    return edges, False


def step_damage_message(g):
    """
    A HIT REACHES THE CLIENT AS ONE DAMAGE MESSAGE, AND THE VIGNETTE LIGHTS.

    Since CBasePlayer retired the server sent no Damage message (the HUD's
    damage indicator never lit), then one per hit. Stock sends the frame's
    hits summed at the client-data update, and the frame after a hit one empty
    report (the remembered kinds changed): exactly TWO per isolated hit, read
    off the client's received count (/client/{slot}/status userMessages).
    The control: no hurt, no message, over the same window, and no vignette.
    Each round's hit comes FROM an entity (the nearest health item), so it has
    an origin: stock's CHudDamageIndicator::MsgFunc_Damage drops a Damage
    message with no origin (unless it is drowning), and so does ours since the
    HUD took that rule -- a hit with no attacker is the closing control, which
    sends the message and draws nothing. Then a hit FROM an entity placed 90
    degrees to the left lights the left edge and not the right, and to the
    right the right and not the left.
    """
    slot = ui_slot(g)
    if slot is None:
        return
    cls = g.scen["playerClass"]
    items = g.api.ents(g.scen["healthItemClass"])
    if not items:
        g.check(False, "this map has no %s to be hit from" % g.scen["healthItemClass"])
        return
    source = min(items, key=lambda e: distance(e["origin"], g.player_origin()))
    hit_from = "#%d" % source["index"]

    for r in range(DAMAGE_ROUNDS):
        # The control first: a quiet window sends nothing and draws no vignette.
        before = damage_received(g, slot)
        time.sleep(DAMAGE_QUIET)
        quiet = damage_received(g, slot) - before
        g.check(quiet == 0, "round %d: no hurt, no Damage message in %.1f s (%d)" % (r + 1, DAMAGE_QUIET, quiet))
        g.check(vignette_edges(ui_frame(g, slot)) == (0, 0), "round %d: and no vignette drawn" % (r + 1))

        before = damage_received(g, slot)
        reply = g.api.get("hurtclass", cls, DAMAGE_HIT, "", "", hit_from)
        hit = (reply.get("hit") or [{}])[0]
        g.check(hit.get("healthBefore", 0) - hit.get("healthAfter", 0) == DAMAGE_HIT,
                "round %d: the hurt landed (%s -> %s)" % (r + 1, hit.get("healthBefore"), hit.get("healthAfter")))
        edges, shown = lit(g, slot, lambda left, right: left + right > 0)
        g.check(shown, "round %d: the vignette is drawn after the hit (left %d, right %d draws)" % ((r + 1,) + edges))
        arrived = g.api.wait_for(lambda: damage_received(g, slot) > before or None, 5.0)
        g.check(bool(arrived), "round %d: the client received a Damage message" % (r + 1))
        time.sleep(0.5)
        got = damage_received(g, slot) - before
        g.check(got == 2, "round %d: exactly two for one hit, the hit and stock's empty follow-up (%d)" % (r + 1, got))

    # NO ORIGIN, NO VIGNETTE: a hit with no attacker reaches the client and
    # stock's handler drops it (MsgFunc_Damage: no origin and not drowning).
    time.sleep(1.2)   # the last round's vignette fades
    before = damage_received(g, slot)
    g.api.get("hurtclass", cls, DAMAGE_HIT)
    arrived = g.api.wait_for(lambda: damage_received(g, slot) > before or None, 5.0)
    g.check(bool(arrived), "a hit with no attacker still sends the Damage message")
    edges, drawn = lit(g, slot, lambda left, right: left + right > 0)
    g.check(not drawn, "and draws no vignette, as stock drops a Damage message with no origin (left %d, right %d draws)" % edges)

    # FROM A KNOWN ORIGIN: the attacker is an entity the player turns side-on to.
    g.cheats()
    origin = g.player_origin()
    eye = (origin[0], origin[1], origin[2] + 64.0)
    _, bearing = angles_to(eye, source["origin"])
    for side, yaw, want in (("left", bearing - 90.0, lambda left, right: left > 0 and right == 0),
                            ("right", bearing + 90.0, lambda left, right: right > 0 and left == 0)):
        g.api.cmd("setang 0 %.3f 0" % yaw)
        time.sleep(1.2)   # the last vignette fades and the new view reaches the client
        reply = g.api.get("hurtclass", cls, DAMAGE_HIT, "", "", "#%d" % source["index"])
        g.check(reply.get("ok") is True, "hit from %s #%d: %s" % (source["classname"], source["index"], reply))
        edges, shown = lit(g, slot, want)
        g.check(shown, "a hit from the %s lights the %s edge only (left %d, right %d draws)" % ((side, side) + edges))

    # A BLAST FROM ITS INFLICTOR. /entities/spawn's env_explosion lands at the
    # AIM POINT whatever origin it is given (it has no edict, and the
    # spawner's teleport does not move it), so: look straight down, make it
    # at our feet, step 96 units to its right, face along the axis that puts
    # it on our left. Fired by class: the spawner's AddOutput targetname is
    # refused by env_explosion, so no name lands.
    #
    # THE STEP GOES TO A SIDE CLEAR OF EVERY PHYSICS PROP (2026-10-12, red
    # every pass on main from 1c64bf833). The fixed +X spot, (bx, by - 96),
    # put the hull 17 units from dm_lockdown's prop_physics_respawnable #30 at
    # (-3830, 2810): inside it. The first shadow update after the teleport
    # (dist 0.135, dv 9, penetrated by a vphysics mover) took stock's stuck
    # arm, VPhysicsShadowUpdate's lastValidPosition = m_oldOrigin, and put the
    # player back at openFloor. Before 1c64bf833 the update reached the player
    # a step late, when the prop had pushed the shadow to dv 13.6: the impulse
    # arm, the player left hung inside the prop (settle status "stuck") at the
    # spot the check wanted. The shadow update now runs in the step, as
    # stock's PhysFrame runs it, so the spot is chosen clear and the landing is
    # checked.
    #
    # ON THE SCENARIO'S OPEN FLOOR, NOT WHEREVER THE ROUNDS LEFT US (2026-10-05,
    # 2 of 8 passes red, probed per round). The rounds end at a random spawn.
    # Where the player stands on a spawn pad (origin z 3.6 to 12 over floor at
    # 0), the aim trace put the blast on the floor UNDER the pad, which then
    # stood between it and the player: no damage at all. And after the 96-unit
    # step the client's view could still be at the old spot -- its eye read
    # (-3667, 3439) with the player at (-3666, 3343) -- so the HUD worked the
    # side out from where the blast WAS, straight below: no left or right edge.
    # The player was never moved by the blast (A30's force), and the Damage
    # message carried the blast's origin and 7 health every time. So: open
    # floor, the blast checked to be on the floor we stand on, and the hit
    # fired only once the client's own view stands where the server put it,
    # facing +X.
    g.cheats()
    props = physics_prop_origins(g)
    floor = blast_floor_spot(g.scen["openFloor"], props)
    if floor is None:
        g.check(False, "a floor spot near openFloor for the blast, with a side clear of every physics prop (%d props)"
                % len(props))
        return
    g.teleport(floor, [0, 0, 0], settle=1.2)
    g.api.cmd("setang 89 0 0")
    time.sleep(0.6)
    feet = g.player_origin()
    group = {"placement": "origin", "entities": [{
        "classname": "env_explosion", "targetname": "ss_lg_boom", "origin": feet, "angles": [0, 0, 0],
        "keyvalues": {"iMagnitude": "12", "iRadiusOverride": "256", "spawnflags": "0"}}]}
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
        json.dump(group, f)
        path = f.name
    try:
        g.api.get("place", path)
    finally:
        os.unlink(path)
    booms = g.api.wait_for(lambda: g.api.ents("env_explosion") or None, 5.0) or []
    if len(booms) != 1:
        g.check(False, "exactly our one env_explosion stands (%d)" % len(booms))
        return
    b = booms[0]["origin"]
    g.check(abs(b[2] - feet[2]) < 3.0,
            "the blast is on the floor the player stands on (blast z %.1f, feet z %.1f)" % (b[2], feet[2]))
    side = blast_side_spot(b, props)
    if side is None:
        g.check(False, "a spot 96 units from the blast with no physics prop within 72 units (%d props)" % len(props))
        return
    (sx, sy), face = side
    landed = g.teleport([sx, sy, b[2] + 4.0], angles=[0, face, 0], settle=1.2)
    here = g.player_origin()
    g.check(landed.get("ok") is True, "the player landed beside the blast, clear of every prop (%s)" % landed.get("status"))
    g.check(math.hypot(here[0] - sx, here[1] - sy) < 8.0,
            "the player stands 96 units to the blast's right, facing %g (%s vs blast %s)" % (face, here, b))

    def view_here():
        pose = (g.api.get("client", str(slot), "frame") or {}).get("pose") or {}
        eye, yaw = pose.get("eye"), pose.get("yaw")
        if not pose.get("known") or not eye or yaw is None:
            return None
        ok = math.hypot(eye[0] - here[0], eye[1] - here[1]) < 2.0 and abs(((yaw - face + 180.0) % 360.0) - 180.0) < 2.0
        return pose if ok else None
    pose = g.api.wait_for(view_here, 5.0)
    g.check(bool(pose), "the client's view stands where the server put the player, facing %g, before the blast (%s)"
            % (face, (g.api.get("client", str(slot), "frame") or {}).get("pose")))
    before = damage_received(g, slot)
    g.api.fire("env_explosion", "Explode")
    edges, shown = lit(g, slot, lambda left, right: left > 0 and right == 0)
    g.check(damage_received(g, slot) > before, "the explosion hurt the player (a Damage message arrived)")
    g.check(shown, "an env_explosion to the left lights the left edge only (left %d, right %d draws)" % edges)

def step_ui_resize(g):
    """
    THE SCOREBOARD FOLLOWS THREE VIDEO MODES (plan_client_ui U3).

    With +showscores held, three mat_setvideomodes; after each the menu layer
    is laid out at the new size (its w and h, which must move), the scoreboard
    is still open and still drawn. The viewport's rebuild hides "all", which
    the UI takes rather than closing its screens. Back to the first mode after.
    """
    slot = ui_slot(g)
    if slot is None:
        return
    g.api.cmd("+showscores")
    first = g.api.wait_for(lambda: (lambda m: m if "scoreboard" in m.get("open", []) and m.get("w") else None)(ui_menu(g, slot)), 10.0)
    if not first:
        g.check(False, "+showscores opened the scoreboard to resize")
        g.api.cmd("-showscores")
        return
    home = (first["w"], first["h"])
    for w, h in ((1280, 720), (1024, 768), (1600, 900)):
        if (w, h) == home:
            continue
        g.api.cmd("mat_setvideomode %d %d 1" % (w, h))
        now = g.api.wait_for(lambda: (lambda m: m if (m.get("w"), m.get("h")) == (w, h) else None)(ui_menu(g, slot)), 20.0)
        g.check(bool(now), "the menu layer is laid out at %dx%d" % (w, h))
        if now:
            time.sleep(0.5)
            now = ui_menu(g, slot)
            g.check("scoreboard" in now.get("open", []) and len(now.get("draws", [])) > 10,
                    "at %dx%d the scoreboard is still open and drawn (%d draws)" % (w, h, len(now.get("draws", []))))
    g.api.cmd("mat_setvideomode %d %d 1" % home)
    g.api.wait_for(lambda: (lambda m: m if (m.get("w"), m.get("h")) == home else None)(ui_menu(g, slot)), 20.0)
    g.api.cmd("-showscores")


def step_ui_form(g):
    """
    A FORM CHANGES A CONVAR, AND CANCEL DOES NOT (plan_client_ui U4).

    `cs_ui_open mouseoptions` opens the mouse options form over the engine's
    convars. An injected press on the Sensitivity slider's track, then OK,
    writes `sensitivity`, read back through the server's /convar route (one
    process, one convar table). The control: the form reopened, the track
    pressed elsewhere, then Cancel, leaves the value where OK put it. The
    original value is put back after.
    """
    slot = ui_slot(g)
    if slot is None:
        return
    original = g.api.convar("sensitivity").get("value")

    def send(kind, x, y, code):
        g.api.get("client", str(slot), "ui/event?e=%d,%d,%d,%d" % (kind, x, y, code))

    def click(x, y):
        for kind, code in ((0, 0), (1, 107), (2, 107)):
            send(kind, x, y, code)

    def opened():
        return g.api.wait_for(lambda: (lambda m: m if "mouseoptions" in m.get("open", []) and ui_texts(m).count("Sensitivity") else None)(ui_menu(g, slot)), 10.0)

    def closed():
        return g.api.wait_for(lambda: (lambda m: m if "mouseoptions" not in m.get("open", []) else None)(ui_menu(g, slot)), 10.0)

    def track(menu):
        """The widest fill right of the Sensitivity label, on its row.

        A text draw's x0/y0 is where its run starts (x1/y1 equal them), so the
        row is the band just below the label's start, not a span it sits in.
        """
        label = [d for d in menu.get("draws", []) if d.get("kind") == "Text" and d.get("text") == "Sensitivity"]
        if not label:
            return None
        x, y = label[-1]["x0"], label[-1]["y0"]
        bars = [d for d in menu.get("draws", []) if d.get("kind") == "Fill" and d["x0"] > x + 40
                and abs((d["y0"] + d["y1"]) / 2.0 - y) < 20 and d["x1"] - d["x0"] > 60]
        return max(bars, key=lambda d: d["x1"] - d["x0"]) if bars else None

    def button(menu, text):
        hits = [d for d in menu.get("draws", []) if d.get("kind") == "Text" and d.get("text") == text]
        return (hits[-1]["x0"] + 4, hits[-1]["y0"] + 6) if hits else None

    def press_and(fraction, text):
        menu = opened()
        if not menu:
            return "the form did not open"
        time.sleep(0.3)
        menu = ui_menu(g, slot)
        bar, at = track(menu), button(menu, text)
        if not bar or not at:
            dump = os.path.join(ROOT, "tools", ".live-gate-ui-form.json")
            with open(dump, "w") as f:
                json.dump(menu, f, indent=1)
            return "no Sensitivity track (%s) or %s button (%s); the menu is in %s" % (bool(bar), text, bool(at), dump)
        x = bar["x0"] + fraction * (bar["x1"] - bar["x0"])
        click(x, (bar["y0"] + bar["y1"]) / 2.0)
        time.sleep(0.3)
        click(*at)
        return None if closed() else "%s did not close the form" % text

    try:
        for r in range(UI_ROUNDS):
            # Away from the current value, so a write that did not happen cannot look like one.
            before = float(g.api.convar("sensitivity").get("value"))
            fraction = 0.25 if before > 8.0 else 0.75
            want = 0.1 + fraction * (20.0 - 0.1)
            g.api.cmd("cs_ui_open mouseoptions")
            why = press_and(fraction, "OK")
            g.check(why is None, "round %d: open, press the track, OK (%s)" % (r + 1, why or "closed"))
            if why:
                return
            got = g.api.wait_for(lambda: (lambda v: v if abs(v - want) < 0.35 else None)(float(g.api.convar("sensitivity").get("value"))), 5.0)
            now = float(g.api.convar("sensitivity").get("value"))
            g.check(got is not None, "round %d: OK wrote sensitivity %.2f -> %.2f (pressed for ~%.2f)" % (r + 1, before, now, want))

            # The control: Cancel discards the press.
            g.api.cmd("cs_ui_open mouseoptions")
            why = press_and(1.0 - fraction, "CANCEL")
            g.check(why is None, "round %d: open, press elsewhere, Cancel (%s)" % (r + 1, why or "closed"))
            if why:
                return
            time.sleep(0.5)
            after = float(g.api.convar("sensitivity").get("value"))
            g.check(after == now, "round %d: Cancel left sensitivity at %.2f (reads %.2f)" % (r + 1, now, after))
    finally:
        g.api.convar("sensitivity", original)


def step_ui_keys(g):
    """
    THE KEY BINDINGS FORM BINDS A KEY, AND CANCEL DOES NOT (plan_client_ui §6).

    `cs_ui_open keybindings`; a click on the Move forward field arms it, an
    injected key (KEY_F, ButtonCode 16) is taken, OK applies: the form's
    store unbinds the old key and binds F through the engine's console. Read
    back by reopening the form, whose field reads the engine's
    Key_LookupBinding("+forward"). The control: armed again, KEY_G, Cancel,
    and the field still reads F. Stock's W is put back after.
    """
    slot = ui_slot(g)
    if slot is None:
        return
    key_f, key_g, key_kind = 16, 17, 4

    def send(kind, x, y, code):
        g.api.get("client", str(slot), "ui/event?e=%d,%d,%d,%d" % (kind, x, y, code))

    def click(x, y):
        for kind, code in ((0, 0), (1, 107), (2, 107)):
            send(kind, x, y, code)

    def open_form():
        g.api.cmd("cs_ui_open keybindings")
        m = g.api.wait_for(lambda: (lambda m: m if "keybindings" in m.get("open", []) and "Move forward" in ui_texts(m) else None)(ui_menu(g, slot)), 10.0)
        time.sleep(0.3)
        return ui_menu(g, slot) if m else None

    def field(menu):
        label = [d for d in menu.get("draws", []) if d.get("kind") == "Text" and d.get("text") == "Move forward"]
        if not label:
            return None, None
        x, y = label[-1]["x0"], label[-1]["y0"]
        boxes = [d for d in menu.get("draws", []) if d.get("kind") == "Fill" and d["x0"] > x + 40
                 and abs((d["y0"] + d["y1"]) / 2.0 - y) < 20 and d["x1"] - d["x0"] > 60]
        if not boxes:
            return None, None
        b = max(boxes, key=lambda d: d["x1"] - d["x0"])
        shown = [d.get("text") for d in menu.get("draws", []) if d.get("kind") == "Text"
                 and b["x0"] <= d["x0"] <= b["x1"] and b["y0"] - 4 <= d["y0"] <= b["y1"]]
        return ((b["x0"] + b["x1"]) / 2.0, (b["y0"] + b["y1"]) / 2.0), (shown[-1] if shown else None)

    def button(menu, text):
        hits = [d for d in menu.get("draws", []) if d.get("kind") == "Text" and d.get("text") == text]
        return (hits[-1]["x0"] + 4, hits[-1]["y0"] + 6) if hits else None

    def closed():
        return g.api.wait_for(lambda: (lambda m: m if "keybindings" not in m.get("open", []) else None)(ui_menu(g, slot)), 10.0)

    try:
        menu = open_form()
        at, shown = field(menu) if menu else (None, None)
        g.check(bool(at), "the key bindings form opened with a Move forward field (shows %r)" % shown)
        if not at:
            return
        click(*at)
        time.sleep(0.3)
        send(key_kind, 0, 0, key_f)
        time.sleep(0.3)
        _, now = field(ui_menu(g, slot))
        g.check(now == "F", "the armed field took KEY_F (shows %r)" % now)
        click(*button(ui_menu(g, slot), "OK"))
        g.check(bool(closed()), "OK closed the form")

        menu = open_form()
        _, back = field(menu) if menu else (None, None)
        g.check(back == "F", "reopened, the field reads the engine's binding for +forward: %r" % back)

        click(*field(menu)[0])
        time.sleep(0.3)
        send(key_kind, 0, 0, key_g)
        time.sleep(0.3)
        click(*button(ui_menu(g, slot), "CANCEL"))
        closed()
        menu = open_form()
        _, still = field(menu) if menu else (None, None)
        g.check(still == "F", "KEY_G then Cancel left +forward on F (%r)" % still)
        click(*button(ui_menu(g, slot), "CANCEL"))
        closed()
    finally:
        g.api.cmd("unbind f")
        g.api.cmd("unbind g")
        g.api.cmd("bind w +forward")


def step_kill_feed(g):
    """
    A DEATH IS ONE LINE OF THE KILL FEED, AND NO DEATH IS NONE (C3; stock
    CHudDeathNotice).

    Until the server fires player_death (lane player-msgs), the death is raised
    on the client alone (cs_cl_death me me, a cheat): our player as victim
    and attacker, a suicide, which stock draws as the skull and the
    victim. The client's console line ("NAME suicided.", stock's) names the
    victim; the HUD route's draws are then counted for that name in the top
    right quarter. Before: none. One death: one. A second: two. With
    hud_deathnotice_time 0 a third adds none (stock's off switch), and at 1
    the lines are gone within two seconds.
    """
    slot = ui_slot(g)
    if slot is None:
        return
    g.cheats()

    def hud():
        return g.api.get("client", str(slot), "ui")

    def lines(name):
        h = hud()
        w, ht = h.get("w", 0), h.get("h", 0)
        return sum(1 for d in h.get("draws", []) if d.get("kind") == "Text" and d.get("text") == name
                   and d["x0"] > w / 2 and d["y0"] < ht / 3) // 2   # each text is drawn with its shadow

    try:
        g.api.cmd("hud_deathnotice_time 6")
        time.sleep(7.0)                                 # a feed from an earlier step expires

        # THE REAL EVENT (the server fires player_death since df8808cc): our
        # player killed by itself through the hurt route, a suicide. One line.
        def heard():
            return g.api.get("client", str(slot), "status").get("gameEvents", {}).get("player_death", 0)

        events, said_before = heard(), g.count_console("suicided.")
        g.api.get("hurt", "#%d" % slot, "500", "", "", "#%d" % slot)
        got = g.api.wait_for(lambda: heard() > events or None, 10.0)
        g.check(bool(got), "the server's player_death reached the client (%d -> %d)" % (events, heard()))
        said = g.api.wait_for(lambda: g.count_console("suicided.") > said_before or None, 10.0)
        if said:
            name = g.last_console_line("suicided.").strip()[:-len(" suicided.")]
            time.sleep(0.5)
            real = lines(name)
            g.check(real == 1, "the real death is one line for %s (%d)" % (name, real))
        else:
            g.check(False, "the real death wrote stock's console line")
        for _ in range(20):
            g.api.cmd("+jump")
            time.sleep(0.3)
            g.api.cmd("-jump")
            time.sleep(0.7)
            if g.api.fields(str(slot)).get("Alive") == "true":
                break
        g.check(g.api.fields(str(slot)).get("Alive") == "true", "the player respawned")
        g.api.cmd("hud_deathnotice_time 1")
        g.api.wait_for(lambda: lines(name) == 0 or None, 10.0) if said else None
        g.api.cmd("hud_deathnotice_time 6")

        before = g.count_console("suicided.")
        g.api.cmd("cs_cl_death me me smg1")
        said = g.api.wait_for(lambda: g.count_console("suicided.") > before or None, 10.0)
        g.check(bool(said), "the client wrote stock's console line for the death")
        if not said:
            return
        line = g.last_console_line("suicided.")
        name = line.strip()[:-len(" suicided.")]
        g.check(len(name) > 0, "the console line names the victim (%r)" % line)
        time.sleep(0.5)
        g.check(lines("__nobody__") == 0, "control: a name nobody has draws no line")
        one = lines(name)
        g.check(one == 1, "one death, one line for %s (%d)" % (name, one))
        h = hud()
        icons = [d for d in h.get("draws", []) if d.get("kind") == "Texture"
                 and d["x0"] > h.get("w", 0) / 2 and d["y0"] < h.get("h", 0) / 3]
        g.check(len(icons) == 1 and icons[0]["x1"] > icons[0]["x0"],
                "and its icon is drawn from the icon atlas through the surface's texture (%d textured quads)" % len(icons))

        g.api.cmd("cs_cl_death me me smg1")
        time.sleep(0.5)
        two = lines(name)
        g.check(two == 2, "a second death, a second line (%d)" % two)

        g.api.cmd("hud_deathnotice_time 0")
        time.sleep(0.3)
        g.api.cmd("cs_cl_death me me smg1")
        time.sleep(0.5)
        g.check(lines(name) == 2, "with hud_deathnotice_time 0 a death adds no line (%d)" % lines(name))

        g.api.cmd("hud_deathnotice_time 1")
        gone = g.api.wait_for(lambda: lines(name) == 0 or None, 10.0)
        g.check(bool(gone), "past hud_deathnotice_time the lines are gone")
    finally:
        g.api.cmd("hud_deathnotice_time 6")


def step_ui_motd(g):
    """
    THE MOTD READS THE INFOPANEL TABLE (VGUIMenu info type 1, as HL2MP's join
    sends it; stock CTextWindow::ShowIndex).

    The server loads cfg/motd_default.txt (HTML) into InfoPanel "motd" and
    motd_text_default.txt into "motd_text". `cs_sv_showpanel <slot> info 1
    Title @motd` sends stock's type 1 for "motd"; the UI has no web view, so as
    stock with HTML disallowed it shows "motd_text": its first line, read from
    the base game's file here, must be drawn. The control: type 0 with
    literal text draws that text and not the table's.
    """
    slot = ui_slot(g)
    if slot is None:
        return
    g.cheats()
    first = None
    candidate = os.path.expanduser("~/.steam/debian-installation/steamapps/common/"
                                   "Source SDK Base 2013 Multiplayer/hl2mp/cfg/motd_text_default.txt")
    if os.path.isfile(candidate):
        with open(candidate, errors="replace") as f:
            first = next((l.strip() for l in f if l.strip()), None)
    g.check(bool(first), "the base game's motd_text_default.txt has a first line to look for (%r)" % first)
    if not first:
        return

    def shown(text):
        return g.api.wait_for(lambda: (lambda m: m if "motd" in m.get("open", []) and text in ui_texts(m) else None)(ui_menu(g, slot)), 10.0)

    g.api.cmd("cs_sv_showpanel %d info 1 Lockdown @motd" % slot)
    m = shown(first)
    g.check(bool(m), "type 1 @motd drew the InfoPanel's motd_text: %r" % first)
    g.api.cmd("cs_sv_showpanel %d info 0" % slot)
    g.api.wait_for(lambda: (lambda m: m if "motd" not in m.get("open", []) else None)(ui_menu(g, slot)), 10.0)

    g.api.cmd("cs_sv_showpanel %d info 1 Lockdown control-literal-text" % slot)
    m = shown("control-literal-text")
    g.check(bool(m) and first not in ui_texts(m), "control: type 0 draws its own text and not the table's")
    g.api.cmd("cs_sv_showpanel %d info 0" % slot)


def step_text_msg(g):
    """
    TEXTMSG AS STOCK PRINTS IT (C3; CBaseHudChat::MsgFunc_TextMsg, ruled port of
    text_message.cpp).

    `cs_sv_textmsg` sends HUD_PRINTCENTER with #GameUI_BonusMapsGoal and a
    name: the client localises the token through the engine's tables
    (GameUI's "Goal: %s1"; this mod's client loads no hl2mp_english.txt, so
    stock's #Game_connected stays a token here as it would in stock), puts the
    name in its place and the centre print draws it; the control first: before
    the message, no such text. Then
    HUD_PRINTCONSOLE with plain text reaches the client's console.
    """
    slot = ui_slot(g)
    if slot is None:
        return
    g.cheats()

    def hud_texts():
        return [d.get("text", "") for d in g.api.get("client", str(slot), "ui").get("draws", []) if d.get("kind") == "Text"]

    marker = "Breen%d" % (int(time.time()) % 100000)
    g.check(not any(marker in t for t in hud_texts()), "control: no %s on the HUD before the message" % marker)
    g.api.cmd("cs_sv_textmsg %d 4 #GameUI_BonusMapsGoal %s" % (slot, marker))
    shown = g.api.wait_for(lambda: next((t for t in hud_texts() if marker in t), None), 10.0)
    g.check(shown == "Goal: " + marker,
            "the centre print drew the localised, substituted line: %r" % shown)

    before = g.count_console("textmsg-console-%s" % marker)

def step_map_change(g):
    """15b. map CHANGE -- a DIFFERENT map, and back. NOT one of §5's sixteen.

    WHY IT IS HERE. The COVERAGE note at the top of this file lists changelevel
    as a declared blind spot: "The map-reload step reloads the SAME map; a
    transition to a different one carries entities across in a way a reload
    does not." That note was written about entity carry-over. What made it
    urgent is a different thing.

    Lane `f-list` deleted the one line that binds a C_StandaloneEntity into the
    stock client entity list -- which was, until the teardown beside it
    existed, the ONLY thing that destroyed a shell at level shutdown -- and the
    game segfaulted in the client shadow manager on the SECOND MAP LOAD, 0 of 5
    runs, against 3 of 3 passing on the untouched tip. A level-shutdown defect
    is invisible on the first map by construction. So the gate wants every
    level transition it can get, and `map <other>` is a strictly harder one
    than `map <same>`: the entity set, the class set, the brush models and the
    precache table all change, so nothing that survived a shutdown can be
    mistaken for something the next level rebuilt identically.

    ss_sandbox IS THE HARDEST MAP THIS MOD HAS, which is why it is the target
    rather than a second deathmatch map. `make map MAP=ss_sandbox` builds it
    from Sandbox.cs and its own gate asserts that EVERY class the mod registers
    has an instance in it and that every temp entity it sends has a station
    that fires it. Changing to it and back is a teardown of one of everything.

    WHAT IT ASSERTS, every one of them positively:
      * the OTHER map reached a census of its own, over floors an empty or
        half-loaded level cannot clear;
      * named classes of the other map are really present -- "a census with a
        number in it" and "the map changed" are not the same claim, and a game
        that answered about the map it never left would clear the floors;
      * the client REJOINED the other map;
      * changing BACK reproduces this scenario's own census exactly, which is
        what an entity leaked across either transition disturbs;
      * and the client rejoined that too.

    THE CROSS-PASS EQUALITY IS THE OTHER HALF. The gate runs twice in one
    process, so the second pass compares the other map's census against what
    the first pass read rather than against a floor. A count that drifts
    between two visits to one map in one process is a leak -- the reading the
    reload step was built for, taken across a harder transition.
    """
    other = g.scen.get("otherMap")
    if not other:
        g.skip("the scenario names no otherMap, so there is no second map to "
               "change to. That is a scenario gap, not a passing check.")
        return

    name = other["map"]
    floor_ents = other["minEntities"]
    floor_classes = other["minClasses"]

    home_entities = g.scen["entities"]
    home_classes = g.scen["classes"]

    #-- over there ----------------------------------------------------------
    g.api.cmd("map %s" % name)

    reached = g.api.wait_for(lambda: g.api.census()[0] >= floor_ents, 180.0, 1.0)

    if not g.api.alive():
        g.check(False, "the process did not survive the change to %s -- a "
                       "level-shutdown defect shows up on the NEXT level init, "
                       "never on the one that leaked" % name)
        g.say("       attribute the core:  coredumpctl info %s" % g.api.pid)
        g.say("       the -game path in a core names a DIRECTORY, not the commit in it.")
        return

    entities, classes = g.api.census()
    g.say("    %s: %d entities / %d classes" % (name, entities, classes))

    g.check(bool(reached),
            "%s reached its entity count: %d entities, floor %d"
            % (name, entities, floor_ents))
    g.check(classes >= floor_classes,
            "and %d distinct classes, floor %d" % (classes, floor_classes))

    for klass in other["mustHold"]:
        found = g.api.ents(klass)
        g.check(len(found) > 0,
                "%s holds %d %s, so this really is %s and not the map before it"
                % (name, len(found), klass, name))

    player = g.api.wait_for(lambda: g.api.player(g.scen["playerClass"]), 60.0)
    g.check(bool(player), "the client rejoined %s" % name)

    # THE CROSS-VISIT READING IS TAKEN HERE, AFTER THE REJOIN, AND PER CLASS.
    # It used to be the reading above, taken the first second the census
    # cleared the floor -- which on ss_sandbox lands about 0.6s before the
    # weighed drum presses its plate and about 1.1s before the client rejoins
    # (medians over 40 visits, reload-probe at f48aeb1). A visit polled late
    # read +1 ss_player, ss_weapon, ss_viewmodel and +1 spotlight_end, ss_beam:
    # the "1239 / 274 against 1234 / 271" drift, 2 visits in 40 here. After the
    # rejoin the client's entities are always there; the lamps that physics or
    # I/O switch are compared as PAIRS (see census_drift), because a drum that
    # lands, or leaves the plate at ~8s, decides whether one is lit.
    settled = g.api.census_by_class() if player else None
    seen = g.state.get("mapChangeCensus")
    if settled is None:
        g.check(False, "a per-class census of %s after the rejoin" % name)
    elif seen is None:
        g.state["mapChangeCensus"] = settled
        g.note("%s census after the rejoin recorded as %d / %d; the next pass "
               "compares against it" % (name, sum(settled.values()), len(settled)))
    else:
        drift = census_drift(seen, settled, other.get("switchedPairs", {}))
        g.check(not drift,
                "the second visit to %s reads the same census as the first, "
                "%d / %d against %d / %d -- anything that survived a level "
                "change reads here as drift%s"
                % (name, sum(settled.values()), len(settled),
                   sum(seen.values()), len(seen),
                   "" if not drift else ": " + ", ".join(
                       "%s %+d" % (k, d) for k, d in drift)))

    #-- and back ------------------------------------------------------------
    g.api.cmd("map %s" % g.scen["map"])

    back = g.api.wait_for(lambda: g.api.census()[0] == home_entities, 180.0, 1.0)

    if not g.api.alive():
        g.check(False, "the process did not survive the change back to %s"
                       % g.scen["map"])
        g.say("       attribute the core:  coredumpctl info %s" % g.api.pid)
        return

    entities, classes = g.api.census()
    g.say("    %s: %d entities / %d classes" % (g.scen["map"], entities, classes))

    g.check(bool(back) or entities == home_entities,
            "survived the change back to %s" % g.scen["map"])
    g.check(entities == home_entities,
            "the census is %s's again: %d entities (expected %d)"
            % (g.scen["map"], entities, home_entities))
    g.check(classes == home_classes,
            "and %d classes (expected %d)" % (classes, home_classes))

    player = g.api.wait_for(lambda: g.api.player(g.scen["playerClass"]), 60.0)
    g.check(bool(player), "the client rejoined %s" % g.scen["map"])



def reload_player_clear_of(door_origin, player_origin):
    """Where the player stands so the door does not open through them, or None
    when they already do.

    PURE, so --self-test holds it. THE DOOR IS AIMED, AND THE AIM DRIFTS
    (plan_physics_bones_perf C7, 2026-10-12): ent_create builds at the point the
    client's LAST-SENT view looks at, and the door's travel is fixed from that
    spawn origin, so it cannot simply be built elsewhere (/entities/spawn goes
    through ent_create too and moves the entity after its ends are fixed). In 4
    of 18 passes it landed 8-19 units nearer the player, overlapping them; the
    wait -1 door was then blocked at once, bounced between open and close (a
    reversal stock does not make: fixed in MovingBrush) and never rose:
    "timeout in 399 of 399 ticks". So the player steps back along the line
    from the door to where they stand, to the clearance, and nothing the aim
    does can put the door on them."""
    dx, dy = player_origin[0] - door_origin[0], player_origin[1] - door_origin[1]
    d = math.hypot(dx, dy)
    if d >= RELOAD_DOOR_CLEARANCE:
        return None
    if d < 1e-3:
        dx, dy, d = 0.0, -1.0, 1.0
    k = RELOAD_DOOR_CLEARANCE / d
    return [door_origin[0] + dx * k, door_origin[1] + dy * k, player_origin[2]]


def reload_probe_height(g, index):
    e = g.api.entity(index=index)
    return e["origin"][2] if e else None


def rope_bookings(th):
    """A think-counter read's rope bookings: the keys a keyframe_rope /
    move_rope's unresolved-NextKey retry loop holds while it re-asks every
    0.5s for ten seconds (Ropes.ResolveAttemptLimit at 2026-10-06). PURE."""
    return {k: v for k, v in (th or {}).items()
            if k.startswith("booked.") and "rope" in k}


def lost_recurring_bookings(first, before, after):
    """Which recurring thinkers the after-read lost, as `class n->m` strings.

    PURE, so --self-test drives it. A class with a booking due within a
    second of BOTH before-reads is a recurring thinker (it runs and books
    again), so it cannot simply have ended: the after-read must hold it at
    its before count. It names what the total check cannot see — a run read
    13 = 13 green while keyframe_rope and move_rope were gone from the heap
    (2026-10-06 at 10a5e638). It does not GATE in the step: a mover the step
    drove thinks every frame while it travels and StopThink's at the end of
    its run, and no observation at the after-read tells that from a reload
    that dropped a still-live booking. The checks that NAME an entity gate
    a real loss."""
    lost = []
    for k, v in sorted((before or {}).items()):
        if not k.startswith("booked.") or v <= 0:
            continue
        cls = k[len("booked."):]
        if min((first or {}).get("due1." + cls, 0),
               (before or {}).get("due1." + cls, 0)) <= 0:
            continue
        if (after or {}).get(k, 0) < v:
            lost.append("%s %d->%d" % (cls, v, (after or {}).get(k, 0)))
    return lost


def reload_rebuild_verdict(tally):
    """Whether a reload left an entity standing with no managed half.

    PURE, so --self-test can drive it with no game -- which is the point. The
    thing this answers is what step 14 could not answer for the whole of its
    life: it asserted the census, the world's geometry and the player's health,
    every one of which is held by the NATIVE half and is therefore just as true
    of an entity whose managed half was dropped.

    Returns (has_block, count, first).

      has_block   whether the build reports the number at all. An old build
                  answers nothing here, and "no answer" must not read as "zero
                  failures" -- that is the shape of hole this function exists to
                  close, arriving from the tooling side instead.
      count       records whose entity is STILL STANDING and whose managed half
                  could not be put back.
      first       the class name of the first of them, or "".

    Deliberately NOT `saved - restored`. Those two also differ when a record's
    entity died between the save and the restore, which is the reload working.
    """
    if not isinstance(tally, dict) or "failed" not in tally:
        return (False, 0, "")

    failed = tally.get("failed")

    # A null or a number where the block should be is NOT an answer either.
    # `or {}` here would have turned None into an empty dict and reported "zero
    # failures", which is the reading this function exists to refuse.
    if not isinstance(failed, dict):
        return (False, 0, "")

    return (True, failed.get("entities", 0) or 0, failed.get("first", "") or "")


HOT_RELOAD_HUD_SECTION = "client.service:SourceSharp.Client.IHudMessages"


def client_reload_caches_verdict(leak):
    """Whether the client's unload reached ManagedCaches.Forget and found
    nothing of the client's still bound. PURE, so --self-test drives it.

    Returns (passed, why). ZERO IS THE PASS, not a non-zero count as
    plan_client_novalve §3.8 first had it: since statics-to-zero (79d3b8af)
    the type caches are each composition's own, and Forget's only entries are
    the three entity routes the SERVER's ScriptedEntityRegistry binds, which
    the server's Shutdown detaches first. The client binds none of them, so
    no client stimulus can add one: measured 0 on the client and 0 on the
    server at 32e063f5 (UnloadSide(...): ABI forgot 0 in console.log).

      -1 or absent   Forget never ran at this unload (ReloadStore's sentinel):
                     the forgetting stopped working.
      > 0            something of the client's outlived its Shutdown and only
                     Forget's net caught it: a teardown that did not get there.
    """
    if not isinstance(leak, dict) or not isinstance(leak.get("cachesDropped"), int) \
            or isinstance(leak.get("cachesDropped"), bool):
        return (False, "the reload record carries no cachesDropped: %r" % (leak,))
    n = leak["cachesDropped"]
    if n < 0:
        return (False, "ManagedCaches.Forget never ran at the client's unload (cachesDropped %d)" % n)
    if n > 0:
        return (False, "%d route(s) of the client's outlived its Shutdown; only "
                       "ManagedCaches.Forget dropped them" % n)
    return (True, "the client's unload reached ManagedCaches.Forget, and nothing "
                  "of the client's was still bound (cachesDropped 0)")


def hot_reload_client_arm(g):
    """The CLIENT's reload, through its own routes (plan_client_novalve §3.8).

    cs_cl_reload had no gate at all: nothing in tools/ ran it. This asks the
    local client for one at /client/{slot}/reload/trigger (a write: cheats are
    on from the step above) and reads /client/{slot}/reload until its sequence
    moves, then holds the record to:

      the LEAK ARM      the old build's load context was collected (the new
                        build awaited a weak handle to it; "alive" is the old
                        build pinned, which every later reload leaks again)
      the service tier  the HUD's message queue was carried and restored, no
                        participant section failed, was orphaned or missing
      the entity tier   as many client entities restored as saved, and more
                        than none (a stimulus that reached the subject)

    and reads the client's entity list after it, which must not be empty.
    and the caches the ABI dropped at the unload to zero, through
    client_reload_caches_verdict (which says why zero, not non-zero).
    """
    players = g.api.ents(g.scen["playerClass"])
    if len(players) != 1:
        g.check(False, "the client reload arm needs exactly our one player; the "
                       "server holds %d" % len(players))
        return
    slot = str(players[0]["index"])

    before = g.api.get("client", slot, "reload")
    if "sequence" not in before:
        g.check(False, "the local client answers /client/%s/reload: %r" % (slot, before))
        return
    sequence = before["sequence"]

    asked = g.api.get("client", slot, "reload/trigger")
    g.check(bool(asked.get("accepted")),
            "the client accepted reload/trigger: %r" % asked)
    if not asked.get("accepted"):
        return

    def moved():
        try:
            r = g.api.get("client", slot, "reload", timeout=15)
        except ApiError:
            return None
        return r if r.get("sequence", 0) > sequence else None

    after = g.api.wait_for(moved, 90.0, 1.0)
    g.check(bool(after), "the client reloaded: /client/%s/reload sequence moved from %d"
                         % (slot, sequence))
    if not after:
        return

    leak = after.get("leak", {})
    parts = after.get("participants", {})
    ents = after.get("entities", {})
    carried = [c.get("section") for c in after.get("carried", [])]

    g.check(leak.get("oldContext") == "collected",
            "the LEAK ARM: the old client build's load context was collected "
            "(%s after %s collection(s))" % (leak.get("oldContext"), leak.get("collections")))
    g.check(HOT_RELOAD_HUD_SECTION in carried and parts.get("restored", 0) >= 1,
            "the HUD's message queue crossed as a participant (%d restored; carried %s)"
            % (parts.get("restored", 0), carried))
    g.check(not parts.get("failed") and not parts.get("orphans") and not parts.get("missing"),
            "no participant section failed, was orphaned or went missing: %r" % parts)
    g.check(ents.get("saved", 0) > 0 and ents.get("restored") == ents.get("saved"),
            "every client entity carried came back: %s saved, %s restored"
            % (ents.get("saved"), ents.get("restored")))
    caches_ok, caches_why = client_reload_caches_verdict(leak)
    g.check(caches_ok, caches_why)
    g.check(after.get("milliseconds", 0) > 0, "the full client reload says how long it took")
    g.note("full client reload: %.1f ms from the old build's save to the new build's restore"
           % after.get("milliseconds", 0))

    listed = g.api.get("client", slot, "entities").get("count", 0)
    g.check(listed > 0, "the client still lists its entities after its reload (%d)" % listed)


def hot_reload_ui_arm(g):
    """The UI's OWN reload (plan_client_ui U5): its toolkit, screens and host
    swapped in their own load context without the client's core.

    With +showscores held, `cs_ui_reload`; /client/{slot}/reload's `ui` section
    must move its sequence, say ui-only, and judge the old context collected
    (on the frame after the swap). The scoreboard must still be open and draw
    the same rows: every text that is not a number (ping and score move on
    their own). The reload's own time is noted beside the full client reload's
    (the client arm after this one), which is what U5 is for.
    """
    slot = ui_slot(g)
    if slot is None:
        return
    g.api.cmd("+showscores")
    held = g.api.wait_for(lambda: (lambda m: m if "scoreboard" in m.get("open", []) and len(m.get("draws", [])) > 10 else None)(ui_menu(g, slot)), 10.0)
    g.check(bool(held), "the scoreboard is open and drawn before the UI reload")
    if not held:
        g.api.cmd("-showscores")
        return

    def words(menu):
        return sorted(t for t in ui_texts(menu) if t and not t.replace("-", "").replace(".", "").isdigit())

    # THE MOTD IS NOT THE SCOREBOARD. The server pushes the MOTD panel on a
    # timer after spawn, and its screen shares the menu ledger: a run that
    # read `rows` before the push and `after` after it compared a scoreboard
    # against a scoreboard plus a MOTD, and failed on 20 texts nobody changed
    # (2026-10-06, --steps hot-reload at the door-check run). Dismiss it with
    # the UI's own Esc - which closes the top thing that wants the keyboard,
    # teammenu first and the MOTD second, so it is sent ONLY while the MOTD
    # is open: an unguarded Esc would close the scoreboard itself.
    def dismiss_motd():
        if "motd" in ui_menu(g, slot).get("open", []):
            g.api.get("client", str(slot), "ui/event?e=4,0,0,70")  # Key, Escape
            g.api.wait_for(lambda: "motd" not in ui_menu(g, slot).get("open", []) or None, 2.0)

    def stable_words(tries=8):
        """The rows, once nothing else is arriving. The MOTD push can land
        BETWEEN any two reads (the first run's dismissal beat it by one
        round-trip and still lost), so read twice a third of a second apart
        and only trust a pair that agrees; dismiss on every pass."""
        for _ in range(tries):
            dismiss_motd()
            w1 = words(ui_menu(g, slot))
            time.sleep(0.33)
            w2 = words(ui_menu(g, slot))
            if w1 == w2 and "motd" not in ui_menu(g, slot).get("open", []):
                return w2
        return None

    rows = stable_words()
    g.check(rows is not None,
            "the scoreboard's rows settle before the UI reload (the MOTD "
            "push would not stop coming; open %r)"
            % (ui_menu(g, slot).get("open", [])))
    if rows is None:
        rows = words(ui_menu(g, slot))   # report what it did hold
    before = (g.api.get("client", str(slot), "reload").get("ui") or {}).get("sequence", 0)
    g.api.cmd("cs_ui_reload")

    def judged():
        ui = g.api.get("client", str(slot), "reload").get("ui") or {}
        return ui if ui.get("sequence", 0) > before and ui.get("oldContext") != "pending" else None

    ui = g.api.wait_for(judged, 20.0)
    g.check(bool(ui), "the UI reloaded: /client/%s/reload ui.sequence moved from %d and was judged" % (slot, before))
    if ui:
        g.check(ui.get("kind") == "ui-only", "it was UI-only (%s)" % ui.get("kind"))
        g.check(ui.get("oldContext") == "collected",
                "the LEAK ARM: the old UI context was collected (%s after %s collection(s))"
                % (ui.get("oldContext"), ui.get("collections")))
        g.note("UI-only reload: %.1f ms (carry %d bytes, %d screen(s) reopened; the old context's "
               "collections %.1f ms apart)" % (ui.get("milliseconds", 0), ui.get("carriedBytes", 0),
                                                ui.get("reopened", 0), ui.get("collectMilliseconds", 0)))

    after_menu = stable_words()
    after_open = ui_menu(g, slot).get("open", [])
    g.check(after_menu is not None,
            "the rows settle again after the reload (the MOTD push would not "
            "stop coming; open %r)" % after_open)
    g.check("scoreboard" in after_open, "the scoreboard is still open after the UI reload")
    g.check(after_menu == rows and len(rows) > 3,
            "and draws the same rows (%d texts that are not numbers; %s)"
            % (len(rows), "same" if after_menu == rows
                          else "before %r, after %r" % (rows[:8], (after_menu or [])[:8])))
    g.api.cmd("-showscores")


def step_hot_reload(g):
    """14. hot reload with the world intact.

    `cs_sv_reload` swaps the managed load context under a native half that does
    not go with it: the entity factory dictionary, the ammo table and the
    string tables all outlive the CLR, so everything C# declares has to be
    RE-declarable. For 284 entity classes it was not, and one reload fired
    `Assertion Failed: FindFactory( pClassName ) == NULL` 284 times. Four plans
    reproduced that and all four carried it, because no gate ever loaded a map
    AND reloaded the managed side -- so the assertions went to a log nothing
    read, which is one-map-load blindness with a different name on it.

    =========================================================================
    THIS STEP USED TO ASSERT FOUR THINGS AND ALL FOUR COULD BE TRUE OF A
    QUIETLY BROKEN WORLD.
    =========================================================================

    It checked that the process survived, that `entities >= before`, that
    `classes == before` and that the player's health was above zero. Measured
    on dm_lockdown while every one of those passed:

        think.pending   8 -> 0      the entire think schedule, gone. Every
                                    door that auto-closes, every respawn
                                    timer, every logic_timer, stopped -- with
                                    the world still rendering and nothing in
                                    any log.
        entities      473 -> 483    ten ss_pickup MORE than the map has,
                                    because Pickups._placed is a field of a
                                    service the unload destroys, so the
                                    level's spawn points were populated a
                                    second time.

    The second is the leak this step's own comment used to describe, and it is
    why the census check was `>=` rather than `==`. Both are fixed, so the
    check is `==` again -- a tolerance that exists to accommodate a bug outlives
    the bug and then hides the next one.

    So the step asserts IDENTITY, not counts: the same entities at the same
    handles, the schedule still booked, the wiring still wired, and -- the part
    a counter cannot reach -- an output posted before the reload arriving after
    it, travelling down a connection made before the reload, carrying its
    parameter, and spending the one firing it was given.

    THE TWO PROBES. The wire under test has to be one this step MADE, or the
    assertion is about whatever dm_lockdown happens to have wired up. So it
    builds two func_movelinear, wires a's OnFullyOpen to b's SetPosition with a
    parameter and a times-to-fire of one, posts a long-delayed Open at a, and
    reloads. Everything after the reload then follows from state that had to
    survive it:

        a rises          <- the queued event was carried and delivered
        b moves HALF way <- the connection was carried, WITH its parameter
        connections -1   <- TimesToFire was carried as 1 and not reset to
                            unlimited, which every other check here would pass

THE DOOR THAT STOOD OPEN. The two movers prove a queued event and a carried
connection. The door proves the entity's OWN spawn-time state came back: it
is built and opened before the reload and left standing open with no think
booking, and after the reload it has to come down when told and go back up.
An uncarried State comes back Closed and makes Close() a no-op forever; an
uncarried ClosedPosition sends the close at the world origin. Neither is
visible to the mover checks: FuncMoveLinear declares its own travel ends,
and a door's are MovingBrush's.
    """
    g.cheats()

    # A clean slate: a previous PASS built these too, and --passes 2 is the
    # gate. Killing by name is safe when there is nothing of that name.
    for name in (RELOAD_PROBE_A, RELOAD_PROBE_B, RELOAD_DOOR):
        g.api.remove(name=name)   # answered once it is gone

    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.0)

    probe_a = reload_probe(g, RELOAD_PROBE_A)
    probe_b = reload_probe(g, RELOAD_PROBE_B)

    if not probe_a or not probe_b or probe_a["index"] == probe_b["index"]:
        g.check(False, "the step could not build the two func_movelinear probes "
                       "its wiring assertions are about")
        return

    a_index, b_index = probe_a["index"], probe_b["index"]
    b_base = probe_b["origin"][2]

    #-- the wire, made before the reload ------------------------------------
    # TWO FIRINGS, not one, and the number is the assertion. The first is spent
    # BEFORE the reload; if TimesToFire comes back as 1 the second is spent
    # after it and the connection unlinks, and if it comes back as "unlimited"
    # -- which every other check on this step would pass -- it never does.
    g.mark("the two probes are built")
    map_conns = g.api.status().get("io", {}).get("connections", 0)

    wired = g.api.get("connect", RELOAD_PROBE_A, "OnFullyOpen",
                      RELOAD_PROBE_B, "SetPosition", str(RELOAD_HALFWAY),
                      str(RELOAD_OUTPUT_DELAY), "2")

    made = g.api.wait_for(
        lambda: True if g.api.status().get("io", {}).get("connections", 0)
                        == map_conns + 1 else None, 8.0)

    g.check(bool(made) and bool(wired.get("ok")),
            "wired %s.OnFullyOpen -> %s.SetPosition %s after %.0fs, twice: "
            "%d connection(s), was %d"
            % (RELOAD_PROBE_A, RELOAD_PROBE_B, RELOAD_HALFWAY, RELOAD_OUTPUT_DELAY,
               g.api.status().get("io", {}).get("connections", 0), map_conns))

    if not made:
        g.check(False, "without the connection this step cannot say anything "
                       "about wiring surviving the reload")

    #-- and the output that has to outlive the swap -------------------------
    # THE PROBE'S OWN TRAVEL POSTS IT. A raises, arrives, fires OnFullyOpen, and
    # the connection posts a delayed event into the MANAGED queue. `ent_fire`
    # with a delay would NOT do -- measured on this build: it goes into the
    # engine's own event queue and never reaches io.pending, so a step built on
    # it would be reloading with an empty managed queue and asserting nothing.
    g.api.fire(RELOAD_PROBE_A, "Open")

    pending = g.api.wait_for(lambda: g.api.status().get("io", {}).get("pending", 0) or None, 30.0)
    g.check(bool(pending),
            "and the probe's arrival posted a %.0f-second output into the "
            "managed queue before the reload (io.pending %s)"
            % (RELOAD_OUTPUT_DELAY, pending))

    # Where a's travel ENDS, read now that it has arrived (its arrival is what
    # posted the output). Not its origin at creation plus the travel:
    # ent_create puts the brush at the aim point after Spawn has fixed the ends
    # from the spawn origin, as stock's does, so the two differ by a few units.
    a_top = reload_probe_height(g, a_index)

    #-- the door that has to stand open across the reload --------------------
    # Built like the movers and opened the same way, with wait -1 so it holds
    # the top of its travel with nothing booked in the think heap. What the
    # reload brings back of it is only what the save carry brings.
    door = reload_door(g, RELOAD_DOOR)
    g.check(bool(door),
            "the step could not build the %s func_door probe its close "
            "assertion is about" % RELOAD_DOOR)
    door_base = door["origin"] if door else None
    door_index = door["index"] if door else None
    door_top = None
    travel = int(RELOAD_PROBE_DISTANCE / float(RELOAD_PROBE_SPEED) / TICK_SECONDS)
    if door:
        # HALF the travel, not the whole of it: ent_create drops or lifts the
        # brush AFTER OnSpawn fixed the ends, so its resting line is a few
        # units off the origin the travel is computed from, and a full-height
        # target timed out on exactly that (first run of this check). Half is
        # far outside either drift and still proves the door was made to STAND
        # open; the settle read below is what proves it STAYED open (a
        # mis-parsed wait would have the auto-close pulling it down here).
        me = g.api.player(g.scen["playerClass"])
        step_back = me and reload_player_clear_of(door_base, me["origin"])
        if step_back:
            g.say("    note  the player stood %.1f units from the door's origin; stepped back to %s"
                  % (math.hypot(me["origin"][0] - door_base[0], me["origin"][1] - door_base[1]),
                     ["%.1f" % v for v in step_back]))
            g.api.teleport(step_back, g.scen["openFloorAngles"], settle=True)
        door_since = g.api.events_next()
        g.say("    note  door %s built at %s; probe a %s at %s, b %s at %s; player %s"
              % (door_index, door_base, a_index, (g.api.entity(index=a_index) or {}).get("origin"),
                 b_index, (g.api.entity(index=b_index) or {}).get("origin"),
                 (g.api.player(g.scen["playerClass"]) or {}).get("origin")))
        g.api.fire(RELOAD_DOOR, "Open")
        rose = g.api.wait({"field": "origin.z", "index": door_index, "op": "ge",
                           "value": door_base[2] + RELOAD_PROBE_DISTANCE / 2},
                          RELOAD_MOVER_BUDGET * travel)
        if rose.get("status") != "met":
            # WHY, for the flake (docs/todo.md: the door never moves, about
            # 2 in 15 passes): what the door did with the Open, where it and
            # everything named like it stand, and where the player is.
            now = g.api.entity(index=door_index)
            named = g.api.entity(name=RELOAD_DOOR)
            outs = [(e.get("name"), e.get("output") or e.get("kind"), e.get("index"))
                    for e in g.api.events(door_since, limit=200)
                    if e.get("index") == door_index or e.get("name") == RELOAD_DOOR]
            me = g.api.player(g.scen["playerClass"])
            g.say("    diag  door %s built at %s, now %s (velocity %s); by name: index %s at %s; "
                  "its events: %s; player at %s; probes a %s b %s"
                  % (door_index, door_base, now and now.get("origin"), now and now.get("velocity"),
                     named and named.get("index"), named and named.get("origin"), outs[:12],
                     me and me.get("origin"), reload_probe_height(g, a_index),
                     reload_probe_height(g, b_index)))
        g.check(rose.get("status") == "met",
                "the door rose to stand open before the reload (%s in %s of "
                "%d ticks)" % (rose.get("status"), rose.get("waitedTicks"),
                               RELOAD_MOVER_BUDGET * travel))
        g.ticks(1.0)
        door_top = reload_probe_height(g, door_index)
        # Wait -1 means no auto-close think was ever booked: a second after
        # arrival the door has to STILL be up at the top. If `wait` had not
        # reached WaitBeforeClose, OnThink's Close would already have pulled
        # it back down, and every check after the reload would pass vacuously
        # on a CLOSED door (found: the first run's full-height rise wait timed
        # out while the door stood open; this closes the mirror loophole).
        g.check(door_top is not None
                and door_top >= door_base[2] + RELOAD_PROBE_DISTANCE / 2 - RELOAD_MOVER_SLACK,
                "the door was still standing open a second after it rose "
                "(z %s against a base of %s; an auto-close think means `wait` "
                "did not reach the entity)" % (door_top, door_base[2]))

    #-- everything the reload has to preserve -------------------------------
    # SAMPLED AFTER THE PROBES ARE BUILT, so both sides of every comparison
    # include them and `classes == before` stays an honest equality rather
    # than one that has to know about this step's own two entities.
    # The think heap and the clock read WITH the census, just before it: what
    # comes due between here and the reads below and removes itself is in
    # neither of those (reload_vanish_allowance_over).
    census_by_think = g.api.counters("think") or {}
    census_time = g.api.status().get("time", 0.0)
    before_list = g.api.ents("*")
    before_entities = len(before_list)
    before_classes = len({e["classname"] for e in before_list})
    before_by_handle = {e["handle"]: e for e in before_list}

    player = g.api.player(g.scen["playerClass"])
    before_fields = g.api.fields(player["index"]) if player else {}

    # THE ROPE'S RETRIES SETTLE BEFORE THE READS. A keyframe_rope /
    # move_rope whose NextKey has not spawned yet re-asks every 0.5s for ten
    # seconds (Ropes.ResolveAttemptLimit at 2026-10-06), then gives up and
    # StopThink's. If the reload lands inside that window the booking was
    # live in the before-reads and is gone at the after-read, which the
    # check below reads as a lost booking: measured, the rope's six bookings
    # (keyframe_rope 5, move_rope 1) were in both before-reads and gone
    # after, and `--steps hot-reload` read red or green on where the reload
    # happened to fall (2026-10-06, run at 10a5e638). Wait by game time for
    # the rope's bookings to drain, so the reads hold only bookings that are
    # supposed to still be booked after the reload. Minutes into the full
    # gate this is a no-op: the ropes settled long before.
    rope_wait_start = g.api.status().get("time", 0.0)
    rope_still_booked = {}
    for _ in range(60):
        rope_still_booked = rope_bookings(g.api.counters("think"))
        if not rope_still_booked:
            break
        g.ticks(0.5)
    if rope_still_booked:
        # The retry loop outlasted even the wait (a rope that never resolves
        # and keeps re-booking): say so, and let the check below judge its
        # disappearance like any other booking's.
        g.say("    note  rope bookings still live after %.1f s of game: %s"
              % (g.api.status().get("time", 0.0) - rope_wait_start,
                 rope_still_booked))
    else:
        g.mark("the rope's retry bookings drained after %.1f s of game"
               % (g.api.status().get("time", 0.0) - rope_wait_start))

    # THE THINK HEAP, COUNTED AS THE MOST COMMON OF NINE READS OVER HALF A
    # SECOND OF GAME (think_count), before and after. One read can land in a frame where a per-tick thinker has
    # run and not yet re-booked: sampled every 35 ticks across a reload, the
    # count read 9 9 9 9 9 8 9 9 (2026-10-05), and a single read on each side
    # failed this check as 9 of 10 in 4 of 8 gate passes. A booking the
    # reload really lost (the 8 -> 0 this check exists for) is missing from
    # every read.
    before_status = g.api.status()
    # And by class, with what comes due soon: a booking due before the
    # after-read runs and ends -- an item's respawn think fell inside the
    # reload in 3 of 5 rounds and read as a lost booking (/counters?group=think
    # named it: item_ammo_pistol, 2026-10-05).
    #
    # AND A SECOND READ, a second and a half of game later, keeping per class
    # the fewer: what came due inside that gap and was a one-shot (the
    # pistol ammo's respawn, due within a second in 2 of 3 gate-prefix
    # rounds) is gone from it, and a recurring thinker (the spotlights, the
    # player manager) is in both and must still be there after the reload.
    first_by_think = g.api.counters("think") or {}
    g.ticks(1.5)
    before_by_think = g.api.counters("think") or {}
    before_think = think_count(g)
    before_time = g.api.status().get("time", 0.0)
    for key in list(before_by_think):
        if key.startswith("booked."):
            before_by_think[key] = min(before_by_think[key], first_by_think.get(key, 0))
    kept = sum(v for k, v in before_by_think.items() if k.startswith("booked."))
    before_touch = before_status.get("touch", {}).get("pairs", 0)
    before_conns = before_status.get("io", {}).get("connections", 0)

    g.check(before_conns > 0,
            "the map's I/O wiring is standing before the reload (%d connections)"
            % before_conns)

    before_asserts = g.count_log("Assertion Failed")


    #========================================================================
    def epoch():
        try:
            return g.api.get("console", 0, 1).get("epoch")
        except ApiError:
            return None

    epoch_before = epoch()
    g.api.cmd("cs_sv_reload")
    g.mark("cs_sv_reload sent")
    #========================================================================

    # THE NEW MODULE FIRST, THEN ITS CENSUS. The census poll's first answer
    # could come from the module the reload was about to replace -- 481 of
    # 481, "back" -- and the reads after it then met the swap: a gate pass
    # read 0 entities and a dead dev API (2026-10-05). The dev API is rebuilt
    # with the module, and /console's epoch says which one answered.
    g.api.wait_for(lambda: (epoch() not in (None, epoch_before)) or None, 90.0, 0.25)
    g.mark("the reloaded module answers")
    # A corpse (or any entity) whose own removal think came due inside the
    # swap is gone by design (reload_vanish_allowance): the census is waited
    # for less those, and the checks below excuse them by class, no more than
    # each class had due.
    def allowance():
        return reload_vanish_allowance_over([(census_by_think, census_time), (before_by_think, before_time)],
                                            g.api.status().get("time", before_time))
    back = g.api.wait_for(lambda: g.api.census()[0] >= before_entities - sum(allowance().values()), 90.0, 0.25)
    if not g.api.alive():
        g.check(False, "the process did not survive cs_sv_reload")
        return

    # A SECOND OF GAME before the reads, as the old 1 s census poll always
    # gave. Read the moment the census is back, the think heap held 2 of 7
    # bookings (2026-10-05) and the step failed: the reloaded module's
    # thinkers book again over its first frames. The census alone is not
    # "the world is restored".
    g.ticks(1.0)
    g.mark("the census is back")
    after_list = g.api.ents("*")
    entities = len(after_list)
    classes = len({e["classname"] for e in after_list})
    after_by_handle = {e["handle"]: e for e in after_list}

    g.say("    %d entities / %d classes (was %d / %d)"
          % (entities, classes, before_entities, before_classes))

    g.check(bool(back), "the server answered again after the managed reload")

    lost_all = sorted(set(before_by_handle) - set(after_by_handle))
    excused, _unexcused = reload_excused([before_by_handle[h]["classname"] for h in lost_all], allowance())
    gone_by_schedule = []
    for h in lost_all:
        cls = before_by_handle[h]["classname"]
        if cls in excused:
            excused.remove(cls)
            gone_by_schedule.append(h)
    if gone_by_schedule:
        g.say("    --    %d entit(ies) removed themselves on a think due inside the reload, not counted lost: %s "
              "(due at the census read, %.2f s of game before the after-read: %s)"
              % (len(gone_by_schedule), ["%s %s" % (h, before_by_handle[h]["classname"]) for h in gone_by_schedule],
                 g.api.status().get("time", census_time) - census_time,
                 {k: v for k, v in census_by_think.items() if k.startswith("dueMs.")
                  and k[len("dueMs."):].rsplit(".", 1)[0].split(":", 1)[0]
                  in {before_by_handle[h]["classname"] for h in gone_by_schedule}}))
    vanished_classes = {before_by_handle[h]["classname"] for h in gone_by_schedule} - {e["classname"] for e in after_list}

    #-- the census, as an EQUALITY ------------------------------------------
    g.check(entities == before_entities - len(gone_by_schedule),
            "the census is unchanged: %d entities, was %d less %d gone on their own schedule. `>=` used to be "
            "enough here because Pickups._placed did not survive the reload "
            "and the map's kits were placed twice" % (entities, before_entities, len(gone_by_schedule)))
    g.check(classes == before_classes - len(vanished_classes),
            "every class the map placed is still built (%d)" % classes)

    #-- IDENTITY, which is what a census cannot say -------------------------
    lost = [h for h in lost_all if h not in gone_by_schedule]
    gained = sorted(set(after_by_handle) - set(before_by_handle))

    # DIAGNOSTIC, not a check (2026-10-05): the daily gate saw 2 ss_weapon
    # gained at new handles in both passes and no subset reproduced it. Each
    # gained or lost handle is described here so the next run names what they
    # are; the checks below are unchanged. Owner and spawnflags are read from
    # the networked payload where it carries them (keys named like owner or
    # spawnflags); a lost handle is gone, so it shows what the census before
    # held. No creation tick is readable through the dev API.
    if lost or gained:
        try:
            now = g.api.status()
            g.say("    diag  server time %.2f, tick %s" % (now.get("time", 0.0), now.get("ticks")))
        except ApiError:
            pass
    for h in lost:
        e = before_by_handle[h]
        g.say("    diag  LOST   handle %s index %s %s at %s" % (
            h, e.get("index"), e.get("classname"), [round(v, 1) for v in e.get("origin", [])]))
    for h in gained:
        e = after_by_handle[h]
        detail, extra = {}, {}
        try:
            detail = g.api.entity(handle=h) or {}
        except ApiError:
            pass
        try:
            extra = {k: v for k, v in g.api.fields(e.get("index")).items()
                     if re.search(r"owner|spawnflag", k, re.I)}
        except (ApiError, KeyError, TypeError):
            pass
        g.say("    diag  GAINED handle %s index %s %s name %r at %s; %s" % (
            h, e.get("index"), e.get("classname"), detail.get("name"),
            [round(v, 1) for v in e.get("origin", [])], extra or "no owner/spawnflags field"))

    g.check(not lost,
            "every entity is still at the handle it had: %d lost%s"
            % (len(lost), "" if not lost
               else " (first %s, a %s)" % (lost[0], before_by_handle[lost[0]]["classname"])))
    g.check(not gained,
            "and nothing appeared at a new handle: %d gained%s"
            % (len(gained), "" if not gained
               else " (first %s, a %s)" % (gained[0], after_by_handle[gained[0]]["classname"])))

    reclassed = [h for h in before_by_handle if h in after_by_handle
                 and before_by_handle[h]["classname"] != after_by_handle[h]["classname"]]
    g.check(not reclassed,
            "and every handle still names the same CLASS (%d changed)" % len(reclassed))

    # A moved entity is not necessarily wrong -- the world keeps running across
    # the swap and physics props settle -- so this is a NOTE with a number
    # rather than a check. What it is here to catch is a restore that put every
    # entity back somewhere, which reads as hundreds moved rather than a few.
    moved = [h for h in before_by_handle if h in after_by_handle
             and distance(before_by_handle[h]["origin"], after_by_handle[h]["origin"]) > 1.0]
    g.note("%d of %d entities are more than a unit from where they were"
           % (len(moved), len(before_by_handle)))
    g.check(len(moved) * 4 <= len(before_by_handle),
            "and the world did not move under the reload: %d of %d entities "
            "shifted" % (len(moved), len(before_by_handle)))

    #-- the subsystems that had no counter here at all ----------------------
    # The heap refills over the reloaded module's first frames: up to two
    # seconds of game for its count to reach the one before the reload.
    start_tick = g.api.status().get("ticks", 0)

    # What must survive is per booking: think_survival keeps every booking due
    # AFTER the reload's span and the recurring ones inside it, and lets a
    # one-shot that came due inside the span go (its self-test pins both
    # halves). The heap refills over the reloaded module's first frames, so
    # this waits up to two seconds of game for the classes to come back.
    def survival():
        counters = g.api.counters("think") or {}
        elapsed = g.api.status().get("time", before_time) - before_time
        return counters, think_survival(first_by_think, before_by_think, counters, elapsed)

    after_by_think, (must_survive, _kept, short) = survival()
    after_think = think_count(g)
    while after_think < must_survive and g.api.status().get("ticks", 0) - start_tick < 133:
        after_by_think, (must_survive, _kept, short) = survival()
        after_think = think_count(g)
    missing = sorted(k[len("booked."):] for k, v in before_by_think.items()
                     if k.startswith("booked.") and after_by_think.get(k, 0) < v)

    # PER-CLASS DIAGNOSTIC. The total below can be satisfied by OTHER
    # bookings refilling the heap while one class is lost: a run measured
    # the rope's two classes gone from the after-read (missing:
    # ['keyframe_rope', 'move_rope']) with the verdict reading 13 = 13 and
    # staying green (2026-10-06 at 10a5e638). `due1.<class>` is booked by
    # the module: a class due within a second of BOTH before-reads is a
    # recurring thinker, so its disappearance is not "a one-shot that ran
    # in between" and gets named. It does not GATE: a mover the step drove
    # (the func_movelinear probe thinks every frame while it travels, then
    # StopThink's at the end of its run) is recurring at the reads and
    # legitimately gone at the after-read, and no observation at that point
    # can tell that from a reload that dropped the booking. The checks that
    # NAME an entity — the mover's arrival, the carry probes — are the
    # ones that gate a real loss.
    lost_recurring = []
    for k, v in sorted(before_by_think.items()):
        if not k.startswith("booked.") or v <= 0:
            continue
        cls = k[len("booked."):]
        if min(first_by_think.get("due1." + cls, 0),
               before_by_think.get("due1." + cls, 0)) <= 0:
            continue
        if after_by_think.get(k, 0) < v:
            lost_recurring.append("%s %d->%d" % (cls, v, after_by_think.get(k, 0)))
    if lost_recurring:
        g.say("    diag  recurring thinkers absent after the reload (the "
              "total can hide this): %s" % ", ".join(lost_recurring))

    after_status = g.api.status()
    after_touch = after_status.get("touch", {}).get("pairs", 0)
    after_conns = after_status.get("io", {}).get("connections", 0)

    # GATED ON THE TOTAL, as it always was: a mover the step drove thinks
    # every frame while it travels and legitimately stops (see the per-class
    # diagnostic above), so a class short is named, not failed on alone.
    g.check(after_think >= must_survive,
            "the think schedule survived: %d booking(s), was %d, of which %d had "
            "to survive (the rest came due inside the reload and ran once); "
            "classes short: %s; fewer now: %s. This read 8 -> 0 with every other "
            "check on this step green"
            % (after_think, before_think, must_survive, short or "none", missing or "none"))

    g.check(after_conns == before_conns,
            "every I/O connection survived, the map's %d and this step's one: "
            "%d, was %d" % (map_conns, after_conns, before_conns))

    # A NOTE AND NOT A CHECK, and the reason is worth writing down because the
    # obvious version of this line is a check that cannot fail.
    #
    # The touch table IS module-scoped and IS destroyed by the unload -- but the
    # next frame's overlap report re-derives it, so its COUNT comes back either
    # way. Measured: with the carry deliberately dropped, this read 38 pairs
    # before and 38 after, exactly as it does with the carry in place.
    #
    # What the carry actually buys is the EDGES, which no count can see: without
    # it every pair the player is standing in takes the START arm instead of the
    # STAY arm and re-fires OnStartTouch, and every pair that SEPARATED during
    # the swap is simply absent from the new table and never gets the OnEndTouch
    # it is owed. Both are pinned by ReloadSubsystemTests, where an edge can be
    # observed; here the number is reported and nothing is claimed of it.
    g.note("the touch table reads %d pair(s), was %d -- re-derived by the next "
           "overlap report either way; what the carry buys is the EDGES, and "
           "those are ReloadSubsystemTests' subject" % (after_touch, before_touch))

    #-- the readout, which is the thing that makes a loss visible at all ----
    tally = after_status.get("reload", {})
    saved = tally.get("saved", {})
    restored = tally.get("restored", {})

    g.say("    carried: %s entit(ies) of %s class(es), %s field(s), %s byte(s); "
          "%s subsystem record(s), %s field(s); %s pending output(s), "
          "%s connection(s), %s shell-less"
          % (saved.get("entities"), saved.get("classes"), saved.get("fields"),
             saved.get("bytes"), saved.get("parts"), saved.get("partFields"),
             saved.get("ioEvents"), saved.get("ioConnections"), saved.get("shellLess")))

    g.check(saved.get("entities", 0) > 0 and saved.get("fields", 0) > 0,
            "the reload report says state was carried (%s entities, %s fields)"
            % (saved.get("entities"), saved.get("fields")))
    g.check(restored.get("entities", 0) == saved.get("entities", 0),
            "and that every carried entity was put back (%s restored of %s saved)"
            % (restored.get("entities"), saved.get("entities")))

    #-- THE ASSERTION THIS STEP DID NOT HAVE ---------------------------------
    #
    # THIS STEP PASSED ON A RELOAD THAT DROPPED THE PLAYER, twice, in two
    # separate live runs. The console said, both times:
    #
    #   reload: ss_player '' (281477122) could not be rebuilt (PlayerNetState
    #     needs 692 byte(s) and entity 2 ('ss_player') offers 0)
    #   reload: 480 of 481 entit(ies) restored; 1 FAILED to rebuild, first
    #     'ss_player'
    #
    # and every check above was true anyway: the census was unchanged, the
    # world had not moved, the player's health was 100 -- all of which are just
    # as true of a player whose managed half is gone, because the native half
    # is what holds every one of those. The equality one line above this was
    # ALSO true, and could not have been anything else: the restored tally was
    # measured from the list the store handed over rather than from the records
    # that came back (ScriptedEntityRegistry.LastRestored), so it was the saved
    # tally under a second name.
    #
    # `failed` is the number that cannot be derived from the other two. It is
    # NOT `saved - restored`: a record whose entity DIED between the save and
    # the restore is dropped, and that is the reload working rather than
    # failing. This counts the entity still STANDING in the world with no
    # managed half -- which stops thinking, stops taking inputs and stops
    # firing outputs, and looks completely normal to every other reading here.
    has_failed_block, failed_count, failed_first = reload_rebuild_verdict(tally)

    g.check(has_failed_block,
            "the reload report says how many entities FAILED to rebuild -- a "
            "build whose status has no `reload.failed` block cannot answer "
            "this step's own question, and must not read as zero")
    g.check(has_failed_block and failed_count == 0,
            "and NO entity was left standing in the world without its managed "
            "half (%s failed%s)"
            % (failed_count,
               "" if not failed_first else ", first '%s'" % failed_first))
    g.check(restored.get("parts", 0) == saved.get("parts", 0),
            "and every subsystem record that was carried was taken back "
            "(%s of %s)" % (restored.get("parts"), saved.get("parts")))
    g.check(saved.get("parts", 0) > 0 and saved.get("partFields", 0) > 0,
            "the subsystem records were carried too (%s record(s), %s field(s)) "
            "-- this is the parent links, the schedule, the touch pairs, the "
            "movers and the pickup ledger"
            % (saved.get("parts"), saved.get("partFields")))
    g.check(saved.get("ioEvents", 0) >= 1,
            "and the queued output is in the record (%s event(s))"
            % saved.get("ioEvents"))
    g.check(saved.get("ioConnections", 0) == before_conns,
            "and every connection is (%s, and the live table held %d)"
            % (saved.get("ioConnections"), before_conns))

    #-- the player -----------------------------------------------------------
    after = g.api.player(g.scen["playerClass"])
    g.check(after is not None and after["health"] > 0,
            "the player survived the reload with %s health"
            % (after["health"] if after else "no"))

    if after and player:
        g.check(after["index"] == player["index"],
                "and it is the same player entity (#%d)" % after["index"])
        g.check(after["handle"] == player["handle"],
                "at the same HANDLE (%d), which an index alone cannot say"
                % after["handle"])
        g.check(distance(after["origin"], player["origin"]) <= 8.0,
                "standing where they were (%.1f units away)"
                % distance(after["origin"], player["origin"]))

        after_fields = g.api.fields(after["index"])

        for field in ("Health", "Armor", "Clip", "Reserve"):
            if field in before_fields and field in after_fields:
                g.check(after_fields[field] == before_fields[field],
                        "with the same %s (%s, was %s)"
                        % (field, after_fields[field], before_fields[field]))

    #-- THE WIRE, end to end, entirely after the reload ---------------------
    # Nothing below can happen unless the queued event, the connection, its
    # parameter and its firing budget all crossed.
    # DELIVERED, WHICH IS THE ASSERTION -- and it is read off the queue rather
    # than off a brush that moved, deliberately.
    #
    # THE DIRECTORY THE RELOAD BUILT HAS DELIVERED NOTHING OF ITS OWN: it is a
    # fresh object, its counters start at zero, and the map's own parse does not
    # run again on a hot reload. So `pending` falling to zero while
    # `deliveredTotal` rises is the queued output leaving the queue and reaching
    # an entity, after the reload, having been posted before it.
    #
    # NOT THE TARGET'S TRAVEL. A func_movelinear told SetPosition 0.5 moves half
    # its travel, which is the parameter made visible -- and whether it CAN move
    # is the map's geometry, not this step's subject. (The 0.3 units this wire
    # once moved the probe in the yard was NOT the floor: it was the reload
    # dropping FuncMoveLinear's travel ends, which sent b for the world origin
    # -- see "a mover that stood across the reload still moves" below.) A gate assertion
    # that depends on where a console command happened to drop a brush is a
    # flaky check, and a flaky check is one everybody learns to ignore. The
    # PARAMETER is pinned hermetically instead, by
    # AddOutputTests.AConnectionMadeAtRuntimeCarriesItsDelayAndFiringBudget and
    # ...StillDeliversAfterAReload, and the travel is reported here as a number.
    def delivered():
        io = g.api.status().get("io", {})
        return io if io.get("pending", 1) == 0 and io.get("deliveredTotal", 0) >= 1 else None

    # The queue empty, answered on the tick it empties (/wait?io=empty), and
    # then read: polling /status once a second lost up to a second a wait.
    try:
        g.api.wait({"io": "empty"}, int((RELOAD_OUTPUT_DELAY + 90.0) / TICK_SECONDS),
                   wall=RELOAD_OUTPUT_DELAY + 90.0)
    except ApiError:
        pass
    io_now = g.api.wait_for(delivered, 5.0)
    g.mark("the carried output was delivered")

    g.check(bool(io_now),
            "the output posted BEFORE the reload was delivered AFTER it, down a "
            "connection made BEFORE it: %s pending, %s delivered by a directory "
            "the reload built, which had delivered nothing of its own"
            % (g.api.status().get("io", {}).get("pending"),
               g.api.status().get("io", {}).get("deliveredTotal")))

    a_travelled = abs((reload_probe_height(g, a_index) or 0.0) - probe_a["origin"][2])
    b_travelled = abs((reload_probe_height(g, b_index) or 0.0) - b_base)

    g.note("%s travelled %.1f units on Open and %s %.1f on SetPosition %s; the "
           "second is the parameter made visible, and how far a brush can "
           "actually move here is the map's business"
           % (RELOAD_PROBE_A, a_travelled, RELOAD_PROBE_B, b_travelled,
              RELOAD_HALFWAY))

    # TIMES-TO-FIRE. The connection was given TWO firings and spent one before
    # the reload. Stock unlinks an action when its count reaches zero, so
    # spending the second must take the table back to what the map declared --
    # and a restore that put the count back as 2, or as unlimited, reads one
    # higher here forever. Every other check on this step passes either way.
    before_second = g.api.status().get("io", {}).get("connections", 0)

    #-- A MOVER THAT STOOD ACROSS THE RELOAD STILL MOVES ---------------------
    # Close it and Open it again, each answered on the tick it arrives
    # (/wait field=origin.z). FuncMoveLinear's travel ends are computed once,
    # in OnSpawn, which a reload does not run: before they were [SaveField]
    # the rebuilt probe held Vector.Zero for both and every move after the
    # reload headed for the WORLD ORIGIN, flat along the floor, at 64 u/s --
    # z never changed, so a sampler of z read "never moves again", and the
    # second firing below came ~76 s later when the probe reached (0,0,0),
    # 4,896 units away (2026-10-05). The xy check is what that looked like.
    base = probe_a["origin"]
    top = a_top if a_top is not None else base[2] + RELOAD_PROBE_DISTANCE
    travel_ticks = int(RELOAD_PROBE_DISTANCE / float(RELOAD_PROBE_SPEED) / TICK_SECONDS)

    def arrive(op, z):
        reply = g.api.wait({"field": "origin.z", "index": a_index, "op": op, "value": z},
                           RELOAD_MOVER_BUDGET * travel_ticks)
        return reply.get("status") == "met", reply.get("waitedTicks")

    g.api.fire(RELOAD_PROBE_A, "Close")
    closed, close_ticks = arrive("le", top - RELOAD_PROBE_DISTANCE + RELOAD_MOVER_SLACK)
    g.api.fire(RELOAD_PROBE_A, "Open")
    opened, open_ticks = arrive("ge", top - RELOAD_MOVER_SLACK)
    a_now = g.api.entity(index=a_index)
    drift = distance([base[0], base[1], 0.0],
                     [a_now["origin"][0], a_now["origin"][1], 0.0]) if a_now else -1.0
    g.mark("the probe closed and opened after the reload")

    g.check(closed and opened and 0.0 <= drift <= RELOAD_MOVER_SLACK,
            "a mover that stood across the reload still moves: %s closed %d units "
            "in %s tick(s) and opened again in %s (budget %d each), %.1f units "
            "off its line. Uncarried travel ends sent it for the world origin"
            % (RELOAD_PROBE_A, RELOAD_PROBE_DISTANCE, close_ticks if closed else "no",
               open_ticks if opened else "no", RELOAD_MOVER_BUDGET * travel_ticks, drift))

    # The arrival fires OnFullyOpen on the tick it lands, so the connection is
    # spent within a few ticks of the Open above. The 90 s this wait used to
    # allow was the broken probe's trip to the world origin.
    spent = g.api.wait_for(
        lambda: True if g.api.status().get("io", {}).get("connections", 0)
                        == map_conns else None, 5.0, 0.1)
    now_conns = g.api.status().get("io", {}).get("connections", 0)
    g.mark("the second firing spent the connection")

    g.note("%s ended %.1f units from where it started; the table went %d -> %d"
           % (RELOAD_PROBE_A,
              abs((reload_probe_height(g, a_index) or 0.0) - probe_a["origin"][2]),
              before_second, now_conns))

    g.check(bool(spent),
            "and it came back with ONE firing left, not two and not unlimited: "
            "spending it took the table to %d, the map's own %d"
            % (now_conns, map_conns))

    #-- THE DOOR THAT STOOD OPEN ACROSS THE RELOAD COMES DOWN -----------------
    # Two ways this reads red on the bug it is about, and they are different
    # bugs. An uncarried State comes back Closed and Close() is a no-op
    # forever: the door stands at the top and `down` is never met. An
    # uncarried ClosedPosition sends the close at the WORLD ORIGIN
    # (OnSpawnFieldReloadTests): z does fall, but thousands of units of travel
    # at 64 u/s never land inside the budget, and the line check sees the rest.
    if door and door_top is not None:
        def arrive_door(op, z):
            reply = g.api.wait({"field": "origin.z", "index": door_index,
                                "op": op, "value": z},
                               RELOAD_MOVER_BUDGET * travel)
            return reply.get("status") == "met", reply.get("waitedTicks")

        g.api.fire(RELOAD_DOOR, "Close")
        door_down, down_ticks = arrive_door(
            "le", door_top - RELOAD_PROBE_DISTANCE + RELOAD_MOVER_SLACK)
        g.api.fire(RELOAD_DOOR, "Open")
        door_up, up_ticks = arrive_door("ge", door_top - RELOAD_MOVER_SLACK)
        d_now = g.api.entity(index=door_index)
        d_drift = distance([door_base[0], door_base[1], 0.0],
                           [d_now["origin"][0], d_now["origin"][1], 0.0]) if d_now else -1.0
        g.mark("the door that stood open came down and went back up")

        g.check(door_down and door_up and 0.0 <= d_drift <= RELOAD_MOVER_SLACK,
                "a door left OPEN across the reload still works: it closed %d "
                "units in %s tick(s) and opened again in %s (budget %d each), "
                "%.1f units off its line. An uncarried State makes the close "
                "a no-op; an uncarried ClosedPosition sends it for the world "
                "origin"
                % (RELOAD_PROBE_DISTANCE, down_ticks if door_down else "no",
                   up_ticks if door_up else "no",
                   RELOAD_MOVER_BUDGET * travel, d_drift))

    #-- put the map back ----------------------------------------------------
    for name in (RELOAD_PROBE_A, RELOAD_PROBE_B, RELOAD_DOOR):
        g.api.remove(name=name)   # answered once it is gone

    fired = g.count_log("Assertion Failed") - before_asserts
    if g.own_log:
        g.check(fired == 0,
                "no assertion fired across the reload (this is where the 284 "
                "FindFactory asserts lived)")

    hot_reload_ui_arm(g)
    hot_reload_client_arm(g)

    if not g.api.status().get("map"):
        g.note("KNOWN DEFECT: debug-api status reports no map after cs_sv_reload. "
               "The map is loaded and its entities are standing; the managed "
               "side's idea of the CURRENT MAP NAME does not survive the "
               "reload. Not gated here -- it is SourceSharp.Server's "
               "CurrentMapName, not this step's subject.")


def step_map_reload(g):
    """15. map reload -- THE CHECK THIS FILE WAS BUILT FOR.

    Everything before this line is a gate that has been run before; this is the
    part that had never been run when the CWorld::Release crash lived on the
    integration branch for weeks. The census is compared rather than merely
    surviving: a reload of the same map must produce the same census, so
    anything that leaked across the level change shows up here as a count that
    drifted, BEFORE it is a crash. An entity that survived a shutdown reads as
    one too many; a registration that was not remade reads as one too few.

    It is also what puts the 10 entities the hot reload leaked back where they
    belong, which is why this step's expectation is the MAP's numbers and not
    the ones the step before it left behind.
    """
    want_entities = g.scen["entities"]
    want_classes = g.scen["classes"]

    # THE MESSAGE OF THE DAY rides on every level load (ServerGameDll.LevelInit,
    # after the LoadMessageOfTheDay marker), so this reload is where it is
    # observed. Counted before and after: console.log accumulates across runs.
    motd_set = g.count_console("Set motd from file")
    motd_refused = (g.count_console("message of the day 'motd'")
                    + g.count_console("the InfoPanel table did not take"))

    g.api.cmd("map %s" % g.scen["map"])

    back = g.api.wait_for(lambda: g.api.census()[0] == want_entities, 150.0, 1.0)

    if not g.api.alive():
        g.check(False, "the process did not survive the level reload -- THIS is "
                       "the check this file exists for")
        g.say("       attribute the core:  coredumpctl info %s" % g.api.pid)
        g.say("       the -game path in a core names a DIRECTORY, not the commit in it.")
        return

    entities, classes = g.api.census()
    g.say("    %d entities / %d classes" % (entities, classes))
    g.check(bool(back) or entities == want_entities, "survived the level reload")
    g.check(entities == want_entities,
            "the census is the map's again: %d entities (expected %d)"
            % (entities, want_entities))
    g.check(classes == want_classes,
            "and %d classes (expected %d)" % (classes, want_classes))

    player = g.api.wait_for(lambda: g.api.player(g.scen["playerClass"]), 60.0)
    g.check(bool(player), "the client rejoined the reloaded map")

    if g.own_log:
        g.check(g.count_console("Set motd from file") > motd_set,
                "the reload loaded the message of the day (a 'Set motd from file' line)")
        g.check(g.count_console("message of the day 'motd'")
                + g.count_console("the InfoPanel table did not take") == motd_refused,
                "and the InfoPanel string table took it (no 'not written' or "
                "'did not take' line)")


def step_shutdown(g):
    """16. clean shutdown with every entity destroyed.

    `disconnect` is a level shutdown with the process still running, which is
    what makes "every entity destroyed" a thing that can be ASKED rather than
    inferred from a clean exit: the dev API answers a real, measured zero.
    A world that outlived its level -- the exact bug this whole file was built
    around -- reads here as a census that will not go to zero.

    On the last pass the process is then asked to quit, and the exit itself is
    checked; on any earlier pass the map is loaded again for the next one.
    """
    g.api.cmd("disconnect")

    empty = g.api.wait_for(lambda: g.api.census() == (0, 0), 60.0, 1.0)
    entities, classes = g.api.census()

    g.check(g.api.alive(), "the process is still up after the level shutdown")
    g.check(bool(empty) and entities == 0,
            "every entity was destroyed: the server holds %d" % entities)
    g.check(classes == 0, "and no class is left standing")

    # THE ORDER BELOW IS LOAD-BEARING AND NOTHING SAID SO.
    #
    # (0, 0) is this step's PASS condition and it is also what Api.census()
    # answers when the dev API stops answering at all -- so the two checks
    # above, read alone, are satisfied by a game that died during the
    # disconnect exactly as well as by one that tidied up properly.
    # `Api.alive()` does not close it: it is os.kill(pid, 0), which answers yes
    # about a hung process and about an unreaped zombie.
    #
    # What closes it is this call. `status()` cannot be answered by a dead dev
    # API -- an ApiError here is turned into a failure by run_step -- so
    # reaching the check below at all is the evidence that the (0, 0) above was
    # a real census and not a silence. Do not reorder it above them, and do not
    # wrap it in a try.
    status = g.api.status()
    g.check(status.get("ticking") is True,
            "and the game is still running frames with no world in it -- which "
            "is also what proves the 0/0 above was a census and not a dead API")


def step_sigterm_shutdown(g):
    """SIGTERM ends the game with exit code 0 and an exit record -- the shape
    every OTHER step here never takes, because Game.kill() SIGKILLs.

    The regression for docs/todo.md's SIGTERM-exits-139 fault: the exit
    recorders (signals + SDL's quit watch) lived in server.so with no way to
    be removed; after managed shutdown the last SDL pump dispatched the
    freed OnSdlEvent and the process died with 139 on a jump to unmapped
    code. The fix (ExitWatch_Disarm, called from DebugApiServer.Dispose) is
    invisible to a gtest process, which has no SDL: only a live game takes
    the crashing path, and only SIGTERM (not the gate's SIGKILLs) takes it.

    IT IS THE FAULT'S EXACT SHAPE: SIGTERM to the ENGINE's pid, the one the
    repro measured. A group-TERM hits the launcher too and the launcher then
    hard-kills the game, which hides the exit code behind a 137.

    Its own instance, saveload_launch's shape (no -condebug: only the main
    game may have it), because the assertion is about a PROCESS ENDING and
    the gate's main game has to survive for every other step.
    """
    failures_before = len(g.failures)
    tmpdir = os.path.join(g.scratch, "sigterm")
    log = os.path.join(g.scratch, "live-gate-sigterm.log")
    single, _ = launch_with_free_port(
        lambda port: saveload_launch(port, g.scen["map"]), log, tmpdir)
    if single is None:
        g.note(keep_log(log, SIGTERM_KEPT_LOG))
        g.check(False, "the SIGTERM instance never opened a dev API socket; "
                       "its log is kept at %s" % SIGTERM_KEPT_LOG)
        return

    try:
        if not single.api.wait_map(g.scen["entities"], 240.0):
            g.skip("the SIGTERM instance never loaded %s" % g.scen["map"])

        # The record the run must NOT leave behind is this exact path; a
        # stale one from an earlier pid collision would fake the pass.
        record = os.path.join(SOCKET_DIR, "%s.exit.json" % single.pid)
        try:
            os.unlink(record)
        except OSError:
            pass

        os.kill(int(single.pid), signal.SIGTERM)

        # Gone within the engine's own shutdown budget (45 s: the repro's, and
        # a game that outlives it is hanging, which is also this step failing).
        deadline = time.time() + 45
        while time.time() < deadline and os.path.exists("/proc/%s" % single.pid):
            time.sleep(0.2)
        g.check(not os.path.exists("/proc/%s" % single.pid),
                "the game exited within 45 s of SIGTERM to the engine's own "
                "pid (a game still up is the hang this step also gates)")

        rc = None
        try:
            rc = single.popen.wait(timeout=30)
        except Exception:
            pass
        # The 139 fault, exactly: the launcher propagates the game's signal
        # death, so 139 (or any signal death) here IS the crash. A clean
        # shutdown exits 0.
        g.check(rc is not None and rc == 0,
                "the game ended on its own with exit code 0 under SIGTERM, "
                "not %s (139 is the freed-SDL-watch crash; see docs/todo.md)"
                % ("still running" if rc is None else rc))

        # The record proves the recorder chain ran to the end: the SIGTERM
        # reached our handler (reason "signal", signo 15) AND managed
        # shutdown still got to write the file after disarming.
        if not os.path.exists(record):
            g.check(False, "no exit record at %s: the shutdown never ran, "
                           "or died before writing it" % record)
        else:
            try:
                with open(record) as handle:
                    doc = json.load(handle)
            except (OSError, ValueError) as why:
                doc = None
                g.check(False, "the exit record at %s does not parse: %s" % (record, why))
            if doc is not None:
                g.check(doc.get("reason") == "signal",
                        "the record blames a signal, not %r" % doc.get("reason"))
                g.check((doc.get("detail") or {}).get("signo") == 15,
                        "and names SIGTERM as the one that ended it")
                g.check(doc.get("writtenBy") == "managed shutdown",
                        "and managed shutdown wrote it after disarming")
    finally:
        single.kill()   # idempotent SIGKILL; the pass path already reaped it
        if len(g.failures) > failures_before:
            g.note(keep_log(log, SIGTERM_KEPT_LOG))


def step_save_load(g):
    """17. save and load -- NOT one of §5's sixteen, and here on purpose.

    plan_entity.md's checklist does not mention save/load, and step 0e's
    engine-boundary probes recorded `BaseEntityToEdict` as "never called" over
    three map loads because none of them saved. A load-game reaches it
    through `CGameTrace::GetEdict()` when it reapplies decals. Same shape as the
    reload bug this whole file was built around -- a checklist measures the
    paths it takes and says nothing about the rest -- so the path is taken
    here.

    IT NEEDS ITS OWN GAME, and that is the engine's rule rather than a choice:
    `save` answers "Can't save multiplayer games." whenever maxClients > 1,
    this mod's server comes up at maxClients 16 by default, and the
    second-client step needs a server with room for two. maxClients cannot be
    lowered at runtime -- `maxplayers 1` followed by a map change leaves it
    where the command line put it -- so the only way to have both in one gate
    run is a second instance launched with -maxplayers 1. It costs one boot.

    What it asserts, all through tools/debug-api:
      * the save happened  (ServerSaveWriteBody crossed into managed code)
      * the load happened  (ServerMapLoadSaveGame and ServerSaveReadBody did)
      * the world came back at the map's own census
      * and the RESTORED state is the saved one, not the current one: the
        player is hurt after saving and is whole again after loading, which is
        the difference between a load and a map reload.

    ITS LOG IS KEPT WHEN IT FAILS, and that is not tidiness either. This
    instance is launched without -condebug (only ONE instance may have it; both
    write bin/<config>/mods/test/console.log), so everything it prints goes to its
    stdout in the scratch directory -- and the scratch directory is rmtree'd in
    main()'s finally. When this step went red on 2026-09-05 the whole of the
    evidence had been deleted by the time anyone read the report, and the cause
    had to be recovered from a kernel segfault line and a systemd core dump.
    So: any failure here copies the instance's log to SAVELOAD_KEPT_LOG and
    says where it went.
    """
    if g.no_second_client:
        g.skip("--no-second-client was given, and this step needs its own instance")

    failures_before = len(g.failures)
    kept = False
    tmpdir = os.path.join(g.scratch, "saveload")
    log = os.path.join(g.scratch, "live-gate-saveload.log")
    # ITS OWN PORT TOO, for the port block's reason -- not because anything
    # connects to this instance (nothing does; it is -maxplayers 1), but
    # because an instance sitting on 27015 is one that a PEER lane's second
    # client will connect to, and then that lane spends an afternoon on it.
    # A gate that is only unbreakable from the inside is half a gate.
    single, _ = launch_with_free_port(
        lambda port: saveload_launch(port, g.scen["map"]), log, tmpdir)

    if single is None:
        # A FAILURE, not a skip: save/load is step 0e's declared blind spot and
        # an instance that will not start is this step losing its subject, not
        # the game being unable to do the thing. Same reasoning as step_join's
        # and step_second_client's.
        g.note(keep_log(log, SAVELOAD_KEPT_LOG))
        g.check(False, "a single-player instance never opened a dev API "
                       "socket; its log is kept at %s" % SAVELOAD_KEPT_LOG)
        return

    try:
        api = single.api
        if not api.wait_map(g.scen["entities"], 240.0):
            g.skip("the single-player instance never loaded %s" % g.scen["map"])

        api.cmd("sv_cheats 1")

        # THE FLAG ON THE COMMAND LINE, READ BACK OFF THE LIVE PROCESS. A
        # +convar the engine did not apply -- a rename, a FCVAR that refuses it
        # from the command line, a typo -- is silent, and this one is the whole
        # of what stopped this step taking the process down (SAVELOAD_LAUNCH).
        # An assertion on the args list alone cannot see any of that.
        backdoor = api.convar("cl_localnetworkbackdoor").get("value")
        g.check(str(backdoor) == "0",
                "the local network backdoor is OFF in the live process "
                "(cl_localnetworkbackdoor = %r); it is the only instance here "
                "that would otherwise install it, and EntState crashed through "
                "it -- see SAVELOAD_LAUNCH" % (backdoor,))

        mark = crossings_mark(api)
        api.wait_ticks(0.5 / TICK_SECONDS)

        api.cmd("save %s" % SAVE_NAME)
        saved = api.wait_for(
            lambda: crossings_since(api, mark)["ops"].get("ServerSaveWriteBody", 0) > 0, 30.0)
        g.check(bool(saved), "save crossed into managed code (ServerSaveWriteBody %d)"
                % crossings_since(api, mark)["ops"].get("ServerSaveWriteBody", 0))

        # Change the world AFTER saving, so a load that does nothing and a load
        # that works cannot both look like a pass.
        api.get("hurtclass", g.scen["playerClass"], 40)
        hurt = api.player(g.scen["playerClass"])
        g.check(hurt is not None and hurt["health"] < 100,
                "the player was hurt to %s after the save"
                % (hurt["health"] if hurt else "gone"))

        mark = crossings_mark(api)
        api.wait_ticks(0.5 / TICK_SECONDS)
        api.cmd("load %s" % SAVE_NAME)

        back = api.wait_for(lambda: api.census()[0] == g.scen["entities"], 150.0, 1.0)
        entities, classes = api.census()
        g.check(bool(back), "the world came back after the load")
        g.check(entities == g.scen["entities"] and classes == g.scen["classes"],
                "at the map's own census: %d entities / %d classes" % (entities, classes))

        ops = crossings_since(api, mark)["ops"]
        g.check(ops.get("ServerMapLoadSaveGame", 0) >= 1,
                "the level came up as a SAVED GAME, not a fresh map "
                "(ServerMapLoadSaveGame %d)" % ops.get("ServerMapLoadSaveGame", 0))
        g.check(ops.get("ServerSaveReadBody", 0) >= 1,
                "and the managed side restored its entities (ServerSaveReadBody %d)"
                % ops.get("ServerSaveReadBody", 0))

        healed = api.wait_for(
            lambda: (lambda who: who and who["health"] >= 100)(api.player(g.scen["playerClass"])),
            30.0)
        who = api.player(g.scen["playerClass"])
        g.check(bool(healed), "and the player is the SAVED one, whole again at %s health"
                % (who["health"] if who else "gone"))

        asserts = count_in(log, "Assertion Failed")
        g.check(asserts == 0, "no assertion fired across the save and the load")
    except ApiError:
        # THE ONE THAT ACTUALLY HAPPENED, and it needs its own arm: run_step
        # turns an ApiError into a failure only AFTER this function returns, so
        # the count the finally below tests has not moved yet. The instance is
        # gone by definition on this path -- that is what an ApiError from its
        # own dev API means -- so its log is the only thing left.
        kept = True
        g.note(keep_log(log, SAVELOAD_KEPT_LOG))
        raise
    finally:
        if not kept and len(g.failures) > failures_before:
            g.note(keep_log(log, SAVELOAD_KEPT_LOG))
        single.kill()


    # ONE PROCESS GROUP AND KILLPG AT THE END. `outer.kill()` alone kills the
    # bash and leaves its children running under init for the next thirty
    # seconds -- and the next --self-test then finds THOSE and asks about a tree
    # that is no longer anybody's. That made this leg fail two runs in three.
    #
    # The tree is  outer bash -> "a)b" -> sleep,  and the odd name is not
    # decoration: /proc/<pid>/stat puts comm in parentheses and comm may contain
    # one, so the ppid column has to be counted from the LAST ')'. The odd-named
    # process must sit BETWEEN the pid asked about and the ancestor or the walk
    # never reads its line. The trailing `; true` on each -c is what stops bash
    # exec'ing the single command it was given and collapsing a level out.
    odd_dir = tempfile.mkdtemp()
    outer = None
    try:
        odd = os.path.join(odd_dir, "a)b")
        os.symlink("/bin/bash", odd)
        outer = subprocess.Popen(
            ["bash", "-c", "'%s' -c 'sleep 30; true'; true" % odd],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            start_new_session=True)

        odd_pid = wait_for_child(outer.pid)
        comm = ""
        if odd_pid:
            try:
                with open("/proc/%s/comm" % odd_pid) as handle:
                    comm = handle.read().strip()
            except OSError:
                pass
        ok(comm == "a)b",
           "the middle process really is named with a ')' in it (comm %r)" % comm)

        deep = wait_for_child(odd_pid) if odd_pid else None
        ok(deep is not None, "and it really has a child below it")
        ok(deep is not None and is_descendant(deep, outer.pid),
           "the walk finds a GRANDCHILD -- the shape a launch has (bash -> "
           "source# -> hl2_linux64) -- and crosses a comm "
           "with a ')' in it, which is why stat's fields are counted from the "
           "LAST one and never by splitting the line")
        ok(not is_descendant(os.getpid(), outer.pid),
           "and a LIVE pid outside the spawned tree is refused -- which is the "
           "peer live-gate's game, and the whole reason this exists")

        #-- adoptable, against those same real pids --------------------------
        # `mine` stands for our own game's socket and `theirs` for a peer
        # live-gate's: both are new, both are live, and exactly one is ours.
        mine, theirs = str(deep), str(os.getpid())
        ok(adoptable([mine, theirs], set(), outer.pid) == [mine],
           "adoptable takes the socket below the pid we spawned and leaves the "
           "peer's -- the whole of the cross-worktree fix")
        ok(adoptable([theirs], set(), outer.pid) == [],
           "a directory holding only a peer's socket adopts NOTHING rather "
           "than adopting the peer")
        ok(adoptable([mine], {mine}, outer.pid) == [],
           "and a socket that was already there before the launch is not new")
    finally:
        if outer is not None:
            try:
                os.killpg(os.getpgid(outer.pid), signal.SIGKILL)
            except OSError:
                pass
            outer.wait()
        shutil.rmtree(odd_dir, ignore_errors=True)

    #-- the newcomer is WAITED for, never sampled ------------------------------
    # The 2026-09-05 failure, as a check that has the shape of the bug: a client
    # whose counters are zero for the first few polls and real afterwards. That
    # is not a hypothetical -- it is what every second client does, because the
    # server holds its player one whole snapshot before the client reaches
    # fully connected and runs LevelInitPostEntity (see newcomer_ops). A
    # single read of `crossings()` at the moment the server sees two players
    # answers `ClientLevelInit 0` and calls a healthy game broken.
    class LateClient(object):
        """A newcomer that is still not fully connected for `at - 1` polls."""

        def __init__(self, at):
            self.at = at
            self.polls = 0

        def alive(self):
            return True

        def crossings(self):
            self.polls += 1
            if self.polls < self.at:
                return {"ops": {"ClientFrame": 4}}
            return {"ops": {"ClientLevelInit": 1, "ClientStandaloneCreate": 52}}

    class ProxyServer(object):
        """A server whose proxy answers only for slot 2."""

        def __init__(self):
            self.asked = []

        def client_crossings(self, slot):
            self.asked.append(slot)
            return {"ops": {"ClientLevelInit": 1, "ClientStandaloneCreate": 3}} if slot == 2 else {}

    proxy = ProxyServer()
    via = newcomer_ops(ClientView(proxy, 2, LateClient(1)), seconds=1.0, step=0.0)[0]
    ok(via.get("ClientLevelInit", 0) == 1 and proxy.asked and set(proxy.asked) == {2},
       "a newcomer's counters are read through the server's proxy for ITS slot "
       "(plan_side_isolation), not from the newcomer's own process")

    late = LateClient(3)
    ops, waited = newcomer_ops(late, seconds=10.0, step=0.0)
    ok(ops.get("ClientLevelInit", 0) == 1,
       "the newcomer's ClientLevelInit is WAITED for -- read once, a client "
       "that is not yet fully connected answers 0 while the server "
       "already holds two players")
    ok(ops.get("ClientStandaloneCreate", 0) == 52,
       "and so is its entity count, which arrives on the same snapshot")
    ok(late.polls == 3,
       "it polled until the answer arrived (%d polls) rather than sampling once"
       % late.polls)
    ok(waited >= 0.0, "and it reports how long it waited, so a slow join is "
                      "visible in a run that passes")

    never = LateClient(10 ** 6)
    stuck, _ = newcomer_ops(never, seconds=0.05, step=0.01)
    ok(never.polls > 0, "a client that never loads is really asked")
    ok(stuck.get("ClientLevelInit", 0) == 0,
       "and the wait GIVES UP at its deadline with the counters it really "
       "found, so a newcomer that never loads still fails the step -- the wait "

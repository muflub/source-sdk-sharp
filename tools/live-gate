#-----------------------------------------------------------------------------
def debug_channel_server_flags():
    """The server's end of the debug channel, on ANY free port.

    A client's own counters (ClientLevelInit, ClientStandaloneCreate) are read
    through the server's dev API at /client/{slot}/status, which proxies the
    question over this channel to that player's client (plan_side_isolation
    rulings 11-12). Port 0: concurrent gates on one box must not collide, and
    the invitation carries the port the listener really bound.
    """
    return ["-debuguiserve", "-debuguiport", "0"]


def debug_channel_client_flags():
    """A client that accepts the server's debug channel invitation."""
    return ["-debugui"]


class ClientView:
    """One client's counters as newcomer_ops polls them: crossings() through
    the server's /client/{slot}/status, alive() from that client's process."""

    def __init__(self, server, slot, process_api):
        self.server = server
        self.slot = slot
        self.process_api = process_api

    def crossings(self):
        return self.server.client_crossings(self.slot)

    def alive(self):
        return self.process_api.alive()



#!/usr/bin/env python3
"""Copy the files the ledger moves here, from the fork at the ledger's tip.

    tools/move-copy [--ledger docs/move/ledger.tsv] --fork ../source-sdk-2013
    tools/move-copy --verify ...     compare, change nothing

Every OURS, OURS-OVERLAY and MOD-COPY row is written to its `dest` with the
bytes of the fork's blob at the tip named in the ledger header (untracked plan
files come from the fork's working tree). --verify checks each dest against
the row's sha256; a file whose only difference is the attribution header
(tools/valve-header) is reported as `header` and passes.
"""

import argparse
import hashlib
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import valvetext as vt  # noqa: E402

MOVING = ("OURS", "OURS-OVERLAY", "MOD-COPY")


def load(ledger):
    tip = None
    rows = []
    cols = None
    with open(ledger) as f:
        for line in f:
            if line.startswith("# move-ledger at fork tip "):
                tip = line.split()[-1]
            if line.startswith("#"):
                continue
            parts = line.rstrip("\n").split("\t")
            if cols is None:
                cols = parts
                continue
            rows.append(dict(zip(cols, parts)))
    return tip, rows


def strip_header(data):
    header = open(os.path.join(HERE, "valve-header.txt"), "rb").read()
    if data.startswith(header):
        return data[len(header):]
    return None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--ledger", default="docs/move/ledger.tsv")
    ap.add_argument("--fork", required=True)
    ap.add_argument("--root", default=".")
    ap.add_argument("--verify", action="store_true")
    a = ap.parse_args()
    tip, rows = load(a.ledger)
    moving = {r["path"]: r for r in rows if r["class"] in MOVING}
    dests = [r["dest"] for r in moving.values()]
    if len(set(dests)) != len(dests):
        print("two rows share a dest", file=sys.stderr)
        return 1
    modes = {}
    ls = subprocess.run(["git", "-C", a.fork, "ls-tree", "-r", "-z", tip],
                        check=True, capture_output=True).stdout
    for rec in ls.split(b"\0"):
        if rec:
            meta, p = rec.split(b"\t", 1)
            modes[p.decode()] = meta.split()[0]
    got = {}
    for path, data in vt.iter_blobs(a.fork, tip, set(moving)):
        got[path] = data
    for path in moving:
        if path not in got:
            with open(os.path.join(a.fork, path), "rb") as f:
                got[path] = f.read()
    same = header = bad = 0
    for path, r in sorted(moving.items()):
        data = got[path]
        if hashlib.sha256(data).hexdigest() != r["sha256"]:
            print(f"source changed since the ledger: {path}")
            bad += 1
            continue
        dest = os.path.join(a.root, r["dest"])
        if a.verify:
            if not os.path.exists(dest):
                print(f"missing: {r['dest']}")
                bad += 1
                continue
            have = open(dest, "rb").read()
            if have == data:
                same += 1
            elif r["valve_header"] == "yes":
                header += 1  # checked byte-exact by tools/valve-header check
            else:
                print(f"differs: {r['dest']}")
                bad += 1
            continue
        os.makedirs(os.path.dirname(dest) or ".", exist_ok=True)
        with open(dest, "wb") as f:
            f.write(data)
        mode = 0o755 if modes.get(path) == b"100755" or (
            path not in modes and data.startswith(b"#!")) else 0o644
        os.chmod(dest, mode)
        same += 1
    verb = "verified" if a.verify else "copied"
    print(f"{verb}: {same} identical, {header} header-rewritten, "
          f"{bad} problems (of {len(moving)})")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())

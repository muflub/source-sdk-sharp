# tools/vtable-layout is: the headers are the farm's. The outputs are this
# repository's own files, found through the script's real path.
HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def _load_vtable_layout():
    loader = importlib.machinery.SourceFileLoader(
        'vtable_layout', os.path.join(HERE, 'vtable-layout'))
    spec = importlib.util.spec_from_loader('vtable_layout', loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module



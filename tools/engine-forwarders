PREFIX = 'SSFwd_'


class Refusal(Exception):
    """A FORWARD row this script cannot honour; the message says why."""


def interface_entry(struct):
    for entry in VL.INTERFACES:
        if entry['struct'] == struct:
            return entry
    raise Refusal('FORWARD names %s, which tools/vtable-layout has no INTERFACES row for'
                  % struct)


# Our own headers, named by the farm path tools/vtable-layout records, are
# included by their path under this repo's src/ (the forwarder libraries put
# src/ on their include path), so the libraries need no farm.
OWN_HEADER_DIRS = (('src/sourcesharp/game/server/', 'server/native/'),
                   ('src/sourcesharp/game/client/', 'client/native/'),
                   ('src/sourcesharp/game/shared/', 'shared/native/'),
                   ('src/sourcesharp/host/', 'host/native/'))


def include_of(header):
    if header.startswith('src/public/'):
        return header[len('src/public/'):]
    for farm, repo in OWN_HEADER_DIRS:
        if header.startswith(farm):
            return repo + header[len(farm):]
    return header[len('src/'):]


def resolved(row):
    """The row with its derived fields filled in: table, self_type, include,
    side."""
    entry = interface_entry(row['struct'])
    out = dict(row)
    out.setdefault('table', row['struct'][:-len('Vtbl')] if row['struct'].endswith('Vtbl')
                   else row['struct'])
    out.setdefault('self_type', entry['chain'][-1])
    out.setdefault('include', include_of(entry['header']))
    out.setdefault('side', 'both')
    if out['side'] not in SIDES:
        raise Refusal('%s names side %s; the sides are %s'
                      % (row['struct'], out['side'], ', '.join(SIDES)))
    if row.get('every') and not row.get('resolved'):
        if 'methods' in row:
            raise Refusal('%s says every=True and names methods: an every row forwards '
                          'each slot in the header\'s order, so it names none' % row['struct'])
        out['methods'] = list(slots_of(entry))
    out['resolved'] = True
    return out


def slots_of(entry):
    """{field name: (class, method, parameters, returns)} for one interface,
    named as tools/vtable-layout's walk names its fields, in declaration order."""
    rows, why = VL.derive_chain(VL.chain_steps(entry))

    if rows is None:
        raise Refusal('%s: %s' % (entry['struct'], why))

    named = {}
    used = {}

    for cls, name, parameters, returns, _slot in rows:
        if name == '~destructor':
            continue

        seen = used.get(name, 0) + 1
        used[name] = seen
        field = name if seen == 1 else '%s_%d' % (name, seen)
        named[field] = (cls, name, parameters, returns)

    return named


def parameter_types(parameters):
    """The header's parameter list as types, `( void )` as none."""
    declared = parameters.strip()

    if declared == 'void':
        return []

    return [part.strip() for part in declared.split(',') if part.strip()]


def printf_fixed(parameters):
    """A printf-style list's fixed parameters (`..., const char *format,
    ...` without the `...`), or None for a list that is not varargs. Varargs
    after anything but a format string is refused: there is no text to fix."""
    declared = (parameters or '').strip()
    if not declared.endswith('...'):
        return None

    fixed = declared[:-3].rstrip().rstrip(',').rstrip()
    last = fixed.split(',')[-1] if fixed else ''
    if not re.search(r'\bchar\s*\*', last):
        raise Refusal('a varargs method is forwarded only after a format string; '
                      'this one ends ( %s )' % declared)
    return fixed


def forwarders_of(row):
    """[(field, cpp return, cpp parameter types, C# function-pointer type,
    C++ declaration)] for one FORWARD row, in the row's order."""
    row = resolved(row)
    entry = interface_entry(row['struct'])
    named = slots_of(entry)

    unknown = [m for m in row['methods'] if m not in named]
    if unknown:
        raise Refusal('%s forwards %s, which %s not a method of %s (the names are '
                      'the header walk\'s fields: an overload\'s second is Name_2)'
                      % (row['table'], ', '.join(unknown),
                         'is' if len(unknown) == 1 else 'are', ' / '.join(entry['chain'])))

    if len(set(row['methods'])) != len(row['methods']):
        raise Refusal('%s names a method twice' % row['table'])

    out = []

    for field in row['methods']:
        cls, name, parameters, returns = named[field]

        # A PRINTF-STYLE METHOD IS FORWARDED WITH ITS FORMAT FIXED. Managed
        # cannot issue a varargs call, and it never needs to: it formats in C#,
        # and the forwarder passes the text as the one argument of "%s". So the
        # typed signature is the fixed parameters, the last of which (the
        # format) carries the text, and the body says `"%s", text`.
        typed = printf_fixed(parameters)

        try:
            kind = VL.signature_of(returns, typed if typed is not None else parameters)
        except VL.Inexpressible as error:
            raise Refusal('%s::%s cannot be forwarded as typed: %s' % (cls, name, error))

        if name in set(entry.get('suppress', ())):
            kind = kind.replace('delegate* unmanaged<',
                                'delegate* unmanaged[SuppressGCTransition]<', 1)

        declaration = '%s %s::%s( %s )' % (returns, cls, name, parameters or 'void')
        out.append((field, returns, parameter_types(typed if typed is not None else parameters),
                    kind, declaration))

    return out


def hand_forwarders(row):
    """forwarders_of's tuples for one HAND row, in its order: the C# type is
    the signature without the `self` a method's has."""
    if row.get('side', 'both') not in SIDES:
        raise Refusal('%s names side %s; the sides are %s'
                      % (row['table'], row.get('side'), ', '.join(SIDES)))

    fields = [field for field, _returns, _parameters in row['slots']]
    if len(set(fields)) != len(fields):
        raise Refusal('%s names a slot twice' % row['table'])

    out = []

    for field, returns, parameters in row['slots']:
        try:
            kind = VL.signature_of(returns, parameters or 'void')
        except VL.Inexpressible as error:
            raise Refusal('%s.%s cannot be laid out as typed: %s' % (row['table'], field, error))

        # signature_of answers a method's, whose first argument is the object.
        kind = kind.replace('delegate* unmanaged<void*, ', 'delegate* unmanaged<', 1)
        declaration = '%s %s%s_%s( %s )' % (returns, PREFIX, row['table'], field, parameters or 'void')
        out.append((field, returns, parameter_types(parameters or 'void'), kind, declaration))

    return out


def all_tables():
    """[(row, forwarders)] for every FORWARD and HAND row, FORWARD's first."""
    tables = [(row, forwarders_of(row)) for row in (resolved(row) for row in FORWARD)]
    tables += [(dict(row, hand=True, side=row.get('side', 'both')), hand_forwarders(row))
               for row in HAND]
    return tables


GENERATED = 'GENERATED by `tools/engine-forwarders --write`. DO NOT EDIT.'


def emit_native(tables, library='server'):
    # The forwarders call Valve's methods through the SDK headers, so the file
    # carries the attribution header (CLAUDE.md, "Valve attribution").
    if tables and all(row.get('hand') for row, _forwarders in tables):
        about = [
            '// %s: the SSForwarderTable (src/fwd/native/ss_fwd.h) of the functions' % LIBRARIES[library]['binary'],
            '// fwd_%s.cpp writes by hand, in the order tools/engine-forwarders\' HAND' % library,
            '// row names them. Included by fwd_%s.cpp, after them.' % library,
        ]
    else:
        about = [
            '// %s: one forwarder per method %s managed code calls, and one' % (LIBRARIES[library]['binary'], LIBRARIES[library]['what']),
            '// SSForwarderTable per interface (src/fwd/native/ss_fwd.h). Each forwarder is a',
            '// direct call to the method through the object\'s own vtable, compiled for',
            '// this ABI, so the slot numbering is the compiler\'s and never written here.',
            '// A HAND table lays out functions another source of the library writes.',
            '// Included by fwd_%s.cpp.' % library,
        ]
    out = read(VALVE_HEADER).rstrip('\n').split('\n') + ['// ' + GENERATED, '//'] + about + ['']

    includes = sorted(set(row['include'] for row, _forwarders in tables if row.get('include')))
    for include in includes:
        out.append('#include "%s"' % include)
    if includes:
        out.append('')

    for row, forwarders in tables:
        name = row['table']
        out.append('//-----------------------------------------------------------------------------')
        if row.get('hand'):
            out.append('// %s: %d function(s) over %s, declared in %s.'
                       % (name, len(forwarders), row['self_type'], row.get('include', 'the library')))
            out.append('//-----------------------------------------------------------------------------')
            for _field, _returns, _types, _kind, declaration in forwarders:
                out.append('// %s' % declaration)
        else:
            out.append('// %s: %d forwarder(s) over %s.' % (name, len(forwarders), row['self_type']))
            out.append('//-----------------------------------------------------------------------------')

        for field, returns, types, _kind, declaration in ([] if row.get('hand') else forwarders):
            params = ''.join(', %s a%d' % (t, i) for i, t in enumerate(types))
            args = ', '.join('a%d' % i for i in range(len(types)))
            if '...' in declaration:
                # printf_fixed: the last typed argument is the text.
                args = ', '.join(['a%d' % i for i in range(len(types) - 1)]
                                 + ['"%s"', 'a%d' % (len(types) - 1)])
            call = 'self->%s( %s )' % (declaration.split('::', 1)[1].split('(', 1)[0],
                                       args) if args else \
                   'self->%s()' % declaration.split('::', 1)[1].split('(', 1)[0]
            body = '%s%s;' % ('' if returns.strip() == 'void' else 'return ', call)
            condition = row.get('conditional', {}).get(field)
            out.append('// %s' % declaration)
            if condition:
                out.append('#if defined( %s )' % condition)
            out.append('static %s %s%s_%s( %s *self%s ) { %s }'
                       % (returns, PREFIX, name, field, row['self_type'], params, body))
            if condition:
                out.append('#endif')

        out.append('')
        out.append('static void *const s_%sSlots[] = {' % name)
        for field, *_ in forwarders:
            condition = row.get('conditional', {}).get(field)
            if condition:
                out.append('#if defined( %s )' % condition)
            out.append('\treinterpret_cast< void * >( &%s%s_%s ),' % (PREFIX, name, field))
            if condition:
                out.append('#else')
                out.append('\tnullptr, // the engine is built without %s and has no %s' % (condition, field))
                out.append('#endif')
        out.append('};')
        out.append('')
        out.append('static const SSForwarderTable s_%sTable = { s_%sSlots, %d };'
                   % (name, name, len(forwarders)))
        out.append('')

    out.append('// The tables by the name managed asks for, SSFwd_<table>.')
    out.append('static const SSForwarderNamed s_ForwarderTables[] = {')
    for row, _forwarders in tables:
        out.append('\t{ "%s%s", &s_%sTable },' % (PREFIX, row['table'], row['table']))
    out.append('};')
    out.append('')

    return '\n'.join(out)


def emit_managed(tables, side='both'):
    out = [
        '// ' + GENERATED,
        '//',
        '// One struct per forwarder table (src/fwd/native) in %s:' % SIDE_FILES[side]['where'],
        '// plain function-pointer fields in the table\'s order, so field N is slot N',
        '// on every ABI. The first argument of a forwarder is the OBJECT, not the',
        '// table: `_fwd->GetModel(_self, index)`. Slots only append, so',
        '// Forwarders.TryAcquire holds only that native serves at least as many',
        '// slots as the struct has fields.',
        '',
        'using System.Runtime.CompilerServices;',
        'using System.Runtime.InteropServices;',
        '',
        'namespace SourceSharp.Abi;',
        '',
    ]

    for row, forwarders in tables:
        name = row['table']
        out.append('/// <summary>')
        if row.get('hand'):
            out.append('/// <c>%s</c>\'s functions (%s%s): %d slot(s), none of them a method,'
                       % (row['self_type'], PREFIX, name, len(forwarders)))
            out.append('/// so the first argument is the first parameter.')
        else:
            out.append('/// <c>%s</c> through its forwarders (%s%s): %d slot(s).'
                       % (row['self_type'], PREFIX, name, len(forwarders)))
        out.append('/// </summary>')
        out.append('[StructLayout(LayoutKind.Sequential)]')
        out.append('internal unsafe struct %sFwd : IForwarderTable' % name)
        out.append('{')
        out.append('    /// <summary>The name native serves the table under.</summary>')
        out.append('    public static string TableName => "%s%s";' % (PREFIX, name))

        for field, _returns, _types, kind, declaration in forwarders:
            out.append('')
            out.append('    // %s' % declaration)
            condition = row.get('conditional', {}).get(field)
            if condition:
                out.append('    // NULL where the engine is built without %s: the method does not' % condition)
                out.append('    // exist there, so a caller checks the slot before calling it.')
            out.append('    public %s %s;' % (kind, field))

        out.append('}')
        out.append('')

    return '\n'.join(out)


STRUCT = re.compile(r'^internal unsafe struct (\w+)Fwd : IForwarderTable$')
FIELD = re.compile(r'^    public (delegate\* .+) (\w+);$')


def committed_slots(managed):
    """{table: [(field, C# function-pointer type)]} as committed C# files list
    them; {} for none. `managed` is one file's text, or a list of them."""
    tables = {}
    current = None

    texts = managed if isinstance(managed, list) else [managed]

    for line in '\n'.join(text or '' for text in texts).split('\n'):
        struct = STRUCT.match(line)
        if struct:
            current = tables.setdefault(struct.group(1), [])
            continue
        field = FIELD.match(line)
        if field and current is not None:
            current.append((field.group(2), field.group(1)))

    return tables


def appended_only(table, before, after):
    """None when `after` is `before` plus slots at its end, else why not."""
    for index, slot in enumerate(before):
        if index >= len(after):
            return ('%s drops slot %d (%s): a slot stays once forwarded, so an assembly '
                    'built against it still finds it' % (table, index, slot[0]))
        if after[index] != slot:
            return ('%s slot %d was %s %s and would be %s %s: a slot never moves or '
                    'changes, since the check at bind is only a count. Add the method at '
                    'the end of its FORWARD row, or run `--write --reorder` for a '
                    'deliberate break and rebuild both sides'
                    % (table, index, slot[0], slot[1], after[index][0], after[index][1]))
    return None


def emit(previous=None, reorder=False):
    """({path: text}, None) or (None, why). `previous` is the committed
    {table: slots}, which every table must extend at its end unless `reorder`."""
    try:
        tables = all_tables()
    except Refusal as error:
        return None, str(error)

    names = [row['table'] for row, _forwarders in tables]
    if len(set(names)) != len(names):
        return None, 'FORWARD names a table twice'

    if not reorder:
        for row, forwarders in tables:
            after = [(field, kind) for field, _r, _t, kind, _d in forwarders]
            why = appended_only(row['table'], (previous or {}).get(row['table'], []), after)
            if why:
                return None, why

    files = {}
    for library, paths in LIBRARIES.items():
        mine = [(row, forwarders) for row, forwarders in tables if row['side'] in ('both', library)]
        files[paths['native']] = emit_native(mine, library)
    for side, paths in SIDE_FILES.items():
        mine = [(row, forwarders) for row, forwarders in tables if row['side'] == side]
        files[paths['managed']] = emit_managed(mine, side)
    return files, None


def committed():
    """The committed slots of every side's C# file."""
    return committed_slots([read(paths['managed']) for paths in SIDE_FILES.values()])


def derived_side(found):
    """The side a table belongs to, from the side roots that reference it:
    `both` when shared code or both sides do; None when nothing does."""
    if 'both' in found or {'server', 'client'} <= set(found):
        return 'both'
    if 'server' in found:
        return 'server'
    if 'client' in found:
        return 'client'
    return None


def side_audit(tables, sources=None):
    """[why] for every row whose side is not where its struct is referenced.
    `sources` is {side root: [file text]}, read from the tree when None; the
    generated forwarder files themselves are not users."""
    if sources is None:
        sources = {}
        for side, roots in SIDE_ROOTS.items():
            texts = sources.setdefault(side, [])
            for root in roots:
                for folder, _dirs, files in os.walk(os.path.join(REPO, root)):
                    for name in files:
                        if name.endswith('.cs') and not name.endswith('Forwarders.g.cs'):
                            texts.append(read(os.path.relpath(os.path.join(folder, name), REPO)) or '')

    problems = []
    for row, _forwarders in tables:
        word = re.compile(r'\b%sFwd\b' % re.escape(row['table']))
        found = [side for side, texts in sources.items() if any(word.search(t) for t in texts)]
        want = derived_side(found)
        if want is not None and want != row['side']:
            problems.append('%s is side %s, but %sFwd is referenced from %s, so its side is %s'
                            % (row['table'], row['side'], row['table'],
                               ', '.join(SIDE_ROOTS[f][0] for f in sorted(found)), want))
    return problems


def read(relative):
    try:
        with open(os.path.join(REPO, relative)) as handle:
            return handle.read()
    except OSError:
        return None


def check(out=sys.stdout):
    files, why = emit(committed())

    if files is None:
        print('!! %s' % why, file=out)
        return 2

    stale = [path for path, text in files.items() if read(path) != text]

    for path in stale:
        print('!! %s is not what the headers say. Run `tools/engine-forwarders --write` '
              'and read the diff.' % path, file=out)

    if stale:
        return 1

    problems = side_audit(all_tables())
    for why in problems:
        print('!! %s. Set the row\'s side to where its users compile.' % why, file=out)
    if problems:
        return 2

    for row in (resolved(row) for row in FORWARD):
        print('  %-28s %3d forwarder(s) over %s (%s)'
              % (row['table'], len(row['methods']), row['self_type'], row['side']), file=out)
    for row in HAND:
        print('  %-28s %3d function(s) over %s (%s, written by hand)'
              % (row['table'], len(row['slots']), row['self_type'], row.get('side', 'both')), file=out)
    return 0


def self_test(out=sys.stdout):
    failures = []

    checks = [0]

    def ok(what, condition):
        checks[0] += 1
        print('  %s  %s' % ('ok  ' if condition else 'FAIL', what), file=out)
        if not condition:
            failures.append(what)

    def refuses(row):
        try:
            forwarders_of(row)
        except Refusal:
            return True
        return False

    base = resolved(FORWARD[0])

    ok('the committed FORWARD rows are all forwardable', emit()[0] is not None)
    ok('a method the interface does not declare is refused',
       refuses(dict(base, methods=['NoSuchMethodExists'])))
    ok('a method named twice is refused',
       refuses(dict(base, methods=['GetModel', 'GetModel'])))
    ok('an interface tools/vtable-layout does not describe is refused',
       refuses(dict(base, struct='NoSuchVtbl')))

    ok('a Valve header is included by its public/ path',
       include_of('src/public/engine/ivmodelinfo.h') == 'engine/ivmodelinfo.h')
    ok('an own header is included by its path under src/, not the farm\'s',
       include_of('src/sourcesharp/game/server/ishim_frame.h') == 'server/native/ishim_frame.h')

    every_row = resolved(dict(struct='ShimFrameVtbl', every=True))
    every_names = list(slots_of(interface_entry('ShimFrameVtbl')))
    ok('an every row forwards each slot, in the header\'s order',
       every_row['methods'] == every_names and len(every_names) > 1
       and every_names[0] == 'IsSimulatingOnAlternateTicks')
    try:
        resolved(dict(struct='ShimFrameVtbl', every=True, methods=['TickCount']))
        every_refused = False
    except Refusal:
        every_refused = True
    ok('an every row that also names methods is refused', every_refused)

    rows = forwarders_of(dict(base, methods=['GetModelType', 'GetModel']))
    ok('the table is in FORWARD order, not header order',
       [r[0] for r in rows] == ['GetModelType', 'GetModel'])

    overloads = forwarders_of(dict(base, methods=['GetVCollide', 'GetVCollide_2']))
    ok('an overload\'s second declaration is Name_2 and takes its own parameters',
       [r[0] for r in overloads] == ['GetVCollide', 'GetVCollide_2']
       and overloads[0][2] != overloads[1][2])

    native = emit_native([(base, rows)])
    ok('a forwarder calls the method through self and returns its answer',
       'return self->GetModel( a0 );' in native)
    ok('the destructor pair is never forwarded',
       '~' not in native and 'Destructor' not in native)
    ok('the C++ table is the slot array and its count',
       'static const SSForwarderTable s_ModelInfoTable = { s_ModelInfoSlots, 2 };' in native)

    gated = emit_native([(dict(base, conditional={'GetModelType': 'SOME_FLAG'}), rows)])
    ok('a conditional method is compiled under its #if and is a NULL slot without it',
       '#if defined( SOME_FLAG )\nstatic int SSFwd_ModelInfo_GetModelType(' in gated
       and '#else\n\tnullptr, // the engine is built without SOME_FLAG and has no GetModelType\n#endif' in gated
       and gated.count('#if defined( SOME_FLAG )') == 2)

    overlay = dict(struct='DebugOverlayVtbl', methods=['AddTextOverlayRGB_2'])
    printf = forwarders_of(overlay)
    printf_native = emit_native([(resolved(overlay), printf)])
    ok('a printf-style method is forwarded with its format fixed at "%s" and the text last',
       printf[0][3].endswith('byte*, void>')
       and '"%s", a7 );' in printf_native and '...' not in printf[0][3])
    ok('a list that is not varargs has no fixed format', printf_fixed('int, float') is None)
    try:
        printf_fixed('int, ...')
        refused = False
    except Refusal:
        refused = True
    ok('varargs after anything but a format string is refused', refused)

    managed = emit_managed([(base, rows)])
    ok('the C# struct has one plain field per forwarder, in table order',
       managed.index(' GetModelType;') < managed.index(' GetModel;')
       and 'VtableSlot' not in managed and 'MemberFunction' not in managed)

    # Append-only, against slots read back from an emitted file.
    committed = committed_slots(emit_managed([(base, rows)]))
    ok('the committed slots read back by name and signature, in order',
       committed == {'ModelInfo': [(r[0], r[3]) for r in rows]})

    def extends(methods, reorder=False):
        saved = FORWARD[:]
        FORWARD[:] = [dict(base, methods=methods)]
        try:
            return emit(committed, reorder)[0] is not None
        finally:
            FORWARD[:] = saved

    ok('a method added at the end is accepted',
       extends(['GetModelType', 'GetModel', 'GetModelIndex']))
    ok('a method added before the committed ones is refused',
       not extends(['GetModelIndex', 'GetModelType', 'GetModel']))
    ok('two committed slots swapped are refused',
       not extends(['GetModel', 'GetModelType']))
    ok('a committed slot dropped is refused',
       not extends(['GetModelType']))
    changed = dict(committed, ModelInfo=[(f, k.replace('int', 'uint', 1)) for f, k in committed['ModelInfo']])
    FORWARD_saved = FORWARD[:]
    FORWARD[:] = [dict(base, methods=['GetModelType', 'GetModel'])]
    try:
        ok('a committed slot whose signature changed is refused',
           emit(changed)[0] is None)
    finally:
        FORWARD[:] = FORWARD_saved
    ok('--reorder writes a deliberate break',
       extends(['GetModel', 'GetModelType'], reorder=True))
    ok('a table with nothing committed takes any order',
       emit({})[0] is not None)

    # Hand-written tables.
    hand = dict(table='Hand', side='client', self_type='Thing',
                slots=[('Count', 'int', ''), ('Make', 'Thing *', 'void *, int')])
    hand_rows = hand_forwarders(hand)
    ok('a hand slot\'s C# type has no self: its first argument is its first parameter',
       [r[3] for r in hand_rows] == ['delegate* unmanaged<int>',
                                     'delegate* unmanaged<void*, int, void*>'])
    hand_native = emit_native([(dict(hand, hand=True), hand_rows)], 'client')
    ok('a hand table lays out the library\'s own functions and writes no body',
       '\treinterpret_cast< void * >( &SSFwd_Hand_Make ),' in hand_native
       and '{ return' not in hand_native and '#include' not in hand_native
       and 'static const SSForwarderTable s_HandTable = { s_HandSlots, 2 };' in hand_native)

    def hand_refused(row):
        try:
            hand_forwarders(row)
        except Refusal:
            return True
        return False

    ok('a hand slot named twice is refused',
       hand_refused(dict(hand, slots=[('Count', 'int', ''), ('Count', 'int', '')])))
    ok('a hand row naming no side is refused', hand_refused(dict(hand, side='nowhere')))

    saved_hand = HAND[:]
    HAND[:] = [dict(hand, slots=list(reversed(hand['slots'])))]
    try:
        ok('a hand table is held to the append-only rule too',
           emit(committed_slots(emit_managed([(dict(hand, hand=True), hand_rows)], 'client')))[0] is None)
    finally:
        HAND[:] = saved_hand

    # Sides.
    ok('a table both sides, or shared code, reference is both',
       derived_side(['server', 'client']) == 'both' and derived_side(['both']) == 'both'
       and derived_side(['client', 'both']) == 'both')
    ok('a table one side alone references is that side\'s, and one nothing references has none',
       derived_side(['server']) == 'server' and derived_side(['client']) == 'client'
       and derived_side([]) is None)
    probe = [(dict(base, side='client'), rows)]
    ok('the audit refuses a client row the server references, naming the table',
       any(why.startswith('ModelInfo is side client')
           for why in side_audit(probe, {'server': ['ModelInfoFwd* t;'], 'client': [], 'both': []})))
    ok('the audit accepts a row on the side its users compile, and ignores a longer name',
       side_audit(probe, {'server': ['XModelInfoFwd y;'], 'client': ['ModelInfoFwd* t;'], 'both': []}) == [])
    native_sides = emit()[0] or {}
    ok('a both table is in both libraries and a client table in the client\'s alone',
       '"SSFwd_ModelInfo"' in native_sides.get(LIBRARIES['server']['native'], '')
       and '"SSFwd_ModelInfo"' in native_sides.get(LIBRARIES['client']['native'], '')
       and '"SSFwd_EngineClient"' in native_sides.get(LIBRARIES['client']['native'], '')
       and '"SSFwd_EngineClient"' not in native_sides.get(LIBRARIES['server']['native'], ''))
    ok('a client table\'s struct is in Client.Interop\'s file and a both table\'s in Abi\'s',
       'struct EngineClientFwd' in native_sides.get(SIDE_FILES['client']['managed'], '')
       and 'struct EngineClientFwd' not in native_sides.get(SIDE_FILES['both']['managed'], '')
       and 'struct ModelInfoFwd' in native_sides.get(SIDE_FILES['both']['managed'], ''))

    print('engine-forwarders self-test: %d checks, %d failed'
          % (checks[0], len(failures)), file=out)
    return 1 if failures else 0


def main(argv):
    if argv[1:] == ['--self-test']:
        return self_test()

    if argv[1:] in (['--write'], ['--write', '--reorder']):
        files, why = emit(committed(), reorder='--reorder' in argv)
        if files is None:
            print('!! %s' % why, file=sys.stderr)
            return 2
        for path, text in files.items():
            with open(os.path.join(REPO, path), 'w') as handle:
                handle.write(text)
            print('wrote %s' % path)
        return 0

    if argv[1:]:
        print(__doc__.split('plan_engine_forwarders.md.')[0].strip(), file=sys.stderr)
        return 2

    return check()


if __name__ == '__main__':
    sys.exit(main(sys.argv))

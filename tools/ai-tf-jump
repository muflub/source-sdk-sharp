#!/usr/bin/env python3
"""Measure the TF2 Soldier bot's blast jump on ss_ai_tf_jump (plan_bots_teams_tf2_part_g G0, G.5).

  tools/ai-tf-jump measure [--seconds 240] [--config debug] [--out FILE.json] [--keep]
  tools/ai-tf-jump read FILE.json      an earlier run's numbers again, from its kept track
  tools/ai-tf-jump record [--seconds 300] [--config debug] [--keep]
  tools/ai-tf-jump sim [--config debug|release]   the simulator against the recording: its gaps and its speed
  tools/ai-tf-jump --self-test

Starts a headless tf2 game on the map (tools/ai-scenario's Game: its own
instance, temp dir, dev-API directory and port), adds one red Soldier, and
runs two arms of --seconds each with the bot's brain deciding:

  jump   its health held at 200 (`ai_aim_tough`), so it may rocket jump
  walk   its health held at 85, under the jump's health floor and over the
         share at which it leaves for a health pack: the same walk, no jump

The bot has nobody to fight, so it plays capture the flag alone, round and
round: east along the run for the blue flag, west along it carrying, east
under the low lane's slab to its capture zone, and west under the slab with
nothing in its hands. A carrier never jumps, so each arm holds its own walk
beside it. Its place is read from the game (`/ai/world`, about ten times a
second, each sample stamped with the server's tick), and every time it
crosses a lane's middle stretch (x 500 to 1700, 1,200 u) without leaving the
lane, that is one traverse of that lane and direction:

  n        traverses
  seconds  the median time over the stretch, by server ticks
  speed    1,200 u over that, u/s
  peak     the highest the bot's feet rose over the floor in a traverse, u
  hops     times in a traverse it left the floor by more than 24 u

and the applier's count of ability sequences begun in the arm
(`ai.apply.ability.sequences`). A round's restart puts the bot back on its
spawn: a step faster than 1,500 u/s is that, and drops the traverse it was in.
Each flight of more than 200 u up is listed too:

  air      seconds off the floor
  along    how far it went over the floor in that time, u (a walk covers 240 u a second)
  walked   the same time at the bot's own walking speed, u

`record` plays the jump arm alone with the AI session recorded (`ai_record`),
and writes what the blast-jump simulator's differential facts replay
(BlastJumpDifferentialTests, G.5 step 3):

  src/ai/tests/recordings/ss_ai_tf_jump.airec   the bot's usercmds and frames (where it stood and moved each
                                                tick) around each flight: 100 ticks before it left the floor
                                                to 34 after it came back; the rest of the session is cut
  src/ai/tests/recordings/ss_ai_tf_jump.json    the map source's sha256, the game's commit, the flights
                                                this tool saw, the bot's slot, what was cut and the counters

`sim` runs the simulator's facts (BlastJumpDifferentialTests and
BlastJumpSpeedTests) and prints the numbers they write under
bin/<config>/ai-jump/: each recorded flight flown again from its takeoff
state, the gap in apex, air time and landing place (medians and the worst),
and how many flights a second one core simulates. The debug build is
`make ai-test`'s; `--config release` builds and runs the same facts optimised
(`dotnet test -c Release`), which is the speed a played server has, and needs
the map built for it (`make map MAP=ss_ai_tf_jump CONFIG=release`). No game
is started. A report the facts did not write is a failure.

The map is per-tree build output: `make map MAP=ss_ai_tf_jump` first; a
missing map is a failure.
"""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import statistics
import struct
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MAP = "ss_ai_tf_jump"

# TFAiTestMaps' numbers: the floor's top, the lanes across the room, the stretch timed.
FLOOR_Z = 16.0
LANES = {"run": (16.0, 448.0), "low": (464.0, 800.0)}
STRETCH = (500.0, 1700.0)
HOP_UNITS = 24.0
FLIGHT_UNITS = 200.0
TELEPORT_SPEED = 1500.0
WALK_SPEED = 240.0

_loader = importlib.machinery.SourceFileLoader("ai_scenario", os.path.join(ROOT, "tools", "ai-scenario"))
_spec = importlib.util.spec_from_loader("ai_scenario", _loader)
ai_scenario = importlib.util.module_from_spec(_spec)
_loader.exec_module(ai_scenario)


def lane_of(y):
    """The lane a y lies in, or None. PURE."""
    for name, (lo, hi) in LANES.items():
        if lo <= y <= hi:
            return name
    return None


def crossing_tick(a, b, x):
    """The tick at which the walk from sample a to sample b passes x, by a
    straight line between them. Samples are (tick, x, y, z). PURE."""
    (ta, xa), (tb, xb) = (a[0], a[1]), (b[0], b[1])
    if xa == xb:
        return float(ta)
    return ta + (tb - ta) * (x - xa) / (xb - xa)


def traverses(samples, tick_seconds):
    """Every crossing of a lane's stretch, either way, in samples
    [(tick, x, y, z)] in tick order: [{lane, seconds, peak, hops}]. A crossing
    starts where the bot enters the stretch from one end and counts when it
    leaves by the other without having left the lane or the stretch's far
    side; turning back, leaving the lane, or a gap in the samples of more than
    a second drops it. PURE: the self-test holds it."""
    lo, hi = STRETCH
    out = []
    open_ = None
    for i in range(1, len(samples)):
        a, b = samples[i - 1], samples[i]
        if (b[0] - a[0]) * tick_seconds > 1.0 or teleported(a, b, tick_seconds):
            open_ = None
            continue
        lane = lane_of(b[2])
        if open_ is not None:
            if lane != open_["lane"]:
                open_ = None
            else:
                height = b[3] - FLOOR_Z
                open_["peak"] = max(open_["peak"], height)
                if height > HOP_UNITS and not open_["up"]:
                    open_["hops"] += 1
                open_["up"] = height > HOP_UNITS
                exit_x = hi if open_["east"] else lo
                back_x = lo if open_["east"] else hi
                if (a[1] - exit_x) * (b[1] - exit_x) <= 0 and a[1] != b[1]:
                    seconds = (crossing_tick(a, b, exit_x) - open_["start"]) * tick_seconds
                    out.append({"lane": open_["lane"] + ("-east" if open_["east"] else "-west"), "seconds": seconds,
                                "peak": open_["peak"], "hops": open_["hops"]})
                    open_ = None
                    continue
                if (a[1] - back_x) * (b[1] - back_x) < 0:
                    open_ = None
        if open_ is None and lane is not None and lane == lane_of(a[2]) and a[1] != b[1]:
            for enter_x, east in ((lo, True), (hi, False)):
                moving = b[1] > a[1] if east else b[1] < a[1]
                if moving and (a[1] - enter_x) * (b[1] - enter_x) <= 0:
                    open_ = {"lane": lane, "east": east, "start": crossing_tick(a, b, enter_x), "peak": max(0.0, b[3] - FLOOR_Z),
                             "hops": 0, "up": b[3] - FLOOR_Z > HOP_UNITS}
    return out


def teleported(a, b, tick_seconds):
    """Whether the step from sample a to sample b is faster than anything a player does. PURE."""
    seconds = max((b[0] - a[0]) * tick_seconds, 1e-6)
    return ((b[1] - a[1]) ** 2 + (b[2] - a[2]) ** 2) ** 0.5 / seconds > TELEPORT_SPEED


def flights(samples, tick_seconds):
    """Every time off the floor that rose past FLIGHT_UNITS, in samples
    [(tick, x, y, z)]: [{air, along, walked, peak}], from the last sample on
    the floor to the first back on it. PURE."""
    out = []
    start = None
    peak = 0.0
    for i in range(1, len(samples)):
        a, b = samples[i - 1], samples[i]
        if teleported(a, b, tick_seconds):
            start = None
            continue
        up = b[3] - FLOOR_Z > 1.0
        if start is None:
            if up and a[3] - FLOOR_Z <= 1.0:
                start, peak = a, b[3] - FLOOR_Z
            continue
        peak = max(peak, b[3] - FLOOR_Z)
        if not up:
            if peak > FLIGHT_UNITS:
                air = (b[0] - start[0]) * tick_seconds
                along = ((b[1] - start[1]) ** 2 + (b[2] - start[2]) ** 2) ** 0.5
                out.append({"air": round(air, 2), "along": round(along, 1), "walked": round(air * WALK_SPEED, 1), "peak": round(peak, 1)})
            start = None
    return out


def summary(found):
    """Per lane and direction: n, the median seconds and speed, the highest peak, the mean hops. PURE."""
    out = {}
    for lane in [l + d for l in LANES for d in ("-east", "-west")]:
        mine = [t for t in found if t["lane"] == lane]
        if not mine:
            out[lane] = {"n": 0}
            continue
        seconds = statistics.median(t["seconds"] for t in mine)
        out[lane] = {"n": len(mine), "seconds": round(seconds, 2), "speed": round((STRETCH[1] - STRETCH[0]) / seconds, 1),
                     "peak": round(max(t["peak"] for t in mine), 1), "hops": round(sum(t["hops"] for t in mine) / len(mine), 2)}
    return out


def self_test():
    tick = 0.015
    # East along the run at 240 u/s, one sample every 7 ticks (25.2 u), flat.
    walk = [(i * 7, 300.0 + i * 25.2, 232.0, FLOOR_Z) for i in range(70)]
    got = traverses(walk, tick)
    assert len(got) == 1 and got[0]["lane"] == "run-east", got
    assert abs(got[0]["seconds"] - 1200.0 / 240.0) < 0.02, got
    assert got[0]["peak"] == 0 and got[0]["hops"] == 0, got
    # West along the low lane with one hop 60 u high in the middle.
    hop = [(i * 7, 1900.0 - i * 25.2, 632.0, FLOOR_Z + (60.0 if 30 <= i < 34 else 0.0)) for i in range(70)]
    got = traverses(hop, tick)
    assert len(got) == 1 and got[0]["lane"] == "low-west" and got[0]["hops"] == 1 and got[0]["peak"] == 60.0, got
    # Turning back before the far end is no traverse; nor is one that leaves the lane.
    back = walk[:30] + [(210 + i * 7, walk[29][1] - (i + 1) * 25.2, 232.0, FLOOR_Z) for i in range(40)]
    assert traverses(back, tick) == [], traverses(back, tick)
    out = [(t, x, 900.0 if 20 <= i < 24 else y, z) for i, (t, x, y, z) in enumerate(walk)]
    assert traverses(out, tick) == [], traverses(out, tick)
    # A gap in the samples of over a second drops the open traverse.
    gap = walk[:25] + [(t + 200, x, y, z) for (t, x, y, z) in walk[25:]]
    assert traverses(gap, tick) == [], traverses(gap, tick)
    # A restart puts the bot back on its spawn mid-traverse: no traverse, and the next one counts.
    restart = walk[:30] + [(210 + i * 7, 128.0 + i * 25.2, 136.0, FLOOR_Z) for i in range(80)]
    got = traverses(restart, tick)
    assert len(got) == 1 and abs(got[0]["seconds"] - 5.0) < 0.02, got
    assert traverses(walk[:30] + [(210, 128.0, 136.0, FLOOR_Z)], tick) == []
    # A flight: up 900 u over 3 s while drifting 150 u, then down; a 60 u hop is none.
    fly = [(i * 10, 300.0 + i * 7.5, 232.0, FLOOR_Z + (0.0 if i in (0, 21) else 900.0 - abs(i - 10.5) * 80.0)) for i in range(22)]
    got = flights(fly, tick)
    assert len(got) == 1 and abs(got[0]["air"] - 3.15) < 0.01 and abs(got[0]["along"] - 157.5) < 0.1 and got[0]["walked"] == 756.0, got
    assert flights(hop, tick) == [] and flights(walk, tick) == []
    # Twice the speed is half the time: the stimulus reaches the number.
    fast = [(i * 7, 300.0 + i * 50.4, 232.0, FLOOR_Z) for i in range(40)]
    assert abs(traverses(fast, tick)[0]["seconds"] - 2.5) < 0.02
    s = summary(traverses(walk, tick) + traverses(hop, tick))
    assert s["run-east"]["n"] == 1 and s["low-west"]["hops"] == 1.0 and abs(s["run-east"]["speed"] - 240.0) < 1.5, s
    assert s["run-west"] == {"n": 0} and s["low-east"] == {"n": 0}, s
    # The trim: a session of two actors, one flight of slot 2 from tick 300 to 500. Kept: the header and bot
    # records, and slot 2's usercmds and frames from 100 ticks before the flight to 34 after; nothing of slot 1.
    def rec(kind, payload):
        return bytes([kind]) + struct.pack("<I", len(payload)) + payload

    def frame(slot, t):
        z = FLOOR_Z + (600.0 if 300 <= t < 500 else 0.0)
        return rec(REC_FRAME, struct.pack("<iii9f", slot, 1, t, 0.0, 0.0, z, 0.0, 0.0, z + 68.0, 0.0, 0.0, 0.0))

    session = AIREC_MAGIC + struct.pack("<H", 7) + rec(REC_HEADER, b"h") + rec(REC_BOT_ADDED, b"b") + rec(5, b"a snapshot")
    for t in range(100, 700):
        for slot in (1, 2):
            session += rec(REC_USERCMD, struct.pack("<iii", slot, 1, t) + b"cmd") + frame(slot, t)
    cut, windows = trim(session, 2)
    assert windows == [(200, 534)], windows
    kept = list(airec_records(cut))
    assert [k for k, _ in kept[:2]] == [REC_HEADER, REC_BOT_ADDED] and all(k in (REC_USERCMD, REC_FRAME) for k, _ in kept[2:]), kept[:3]
    assert len(kept) == 2 + 2 * 335 and all(struct.unpack_from("<i", p, 0)[0] == 2 for _, p in kept[2:]), len(kept)
    assert {struct.unpack_from("<i", p, 8)[0] for _, p in kept[2:]} == set(range(200, 535))
    assert trim(session, 1)[1] == windows and trim(session, 3) == (session[:10] + rec(REC_HEADER, b"h") + rec(REC_BOT_ADDED, b"b"), [])
    print("ai-tf-jump self-test: ok")


def vector(v):
    if isinstance(v, dict):
        low = {k.lower(): val for k, val in v.items()}
        return float(low["x"]), float(low["y"]), float(low["z"])
    return float(v[0]), float(v[1]), float(v[2])


def lower(o):
    if isinstance(o, dict):
        return {k.lower(): lower(v) for k, v in o.items()}
    if isinstance(o, list):
        return [lower(v) for v in o]
    return o


def bot_sample(world, slot):
    """(tick, x, y, z) of the actor in the slot from an /ai/world answer, or None while it is not in the world."""
    for a in world.get("actors") or []:
        if a.get("slot") == slot and a.get("alive") and a.get("at") is not None:
            x, y, z = vector(a["at"])
            return world["tick"], x, y, z
    return None


def arm(game, slot, health, seconds):
    game.cmd("ai_aim_tough %d %d" % (slot, health))
    time.sleep(2.0)
    before = game.json("/ai/counters").get("ai.apply.ability.sequences", 0)
    samples, tick_seconds, leaves = [], 0.015, {}
    deadline = time.time() + seconds
    while time.time() < deadline:
        world = lower(game.json("/ai/world"))
        tick_seconds = world.get("tickseconds", tick_seconds)
        s = bot_sample(world, slot)
        if s is not None and (not samples or s[0] > samples[-1][0]):
            samples.append(s)
        for b in world.get("bots") or []:
            if b.get("slot") == slot and b.get("going"):
                leaf = b["going"].get("leaf") or ""
                leaves[leaf] = leaves.get(leaf, 0) + 1
        time.sleep(0.1)
    after = game.json("/ai/counters").get("ai.apply.ability.sequences", 0)
    found = traverses(samples, tick_seconds)
    return {"health": health, "flights": flights(samples, tick_seconds), "samples": len(samples), "sequences": after - before, "leaves": leaves, "lanes": summary(found), "traverses": found,
            "tick_seconds": tick_seconds, "track": [[t, round(x, 1), round(y, 1), round(z, 1)] for t, x, y, z in samples]}


def start_game(config):
    """A headless tf2 game on the map, up; a missing map is a failure."""
    nav = os.path.join(ROOT, "bin", config, "mods", "tf2", "maps", MAP + ".nav3d")
    if not os.path.exists(nav):
        raise SystemExit("ai-tf-jump: no %s: `make map MAP=%s` builds it" % (nav, MAP))
    game = ai_scenario.Game(MAP, config, mod="tf2")
    game.start()
    return game


def add_jumper(game):
    """Adds the one red Soldier and answers its slot once it is in the world."""
    game.cmd("ai_bot_add Jumper medium team=2")
    deadline = time.time() + 120
    while time.time() < deadline:
        for b in lower(game.json("/ai/world")).get("bots") or []:
            if b.get("name") == "Jumper" and b.get("truth"):
                return b["slot"]
        time.sleep(1.0)
    raise SystemExit("ai-tf-jump: the bot never spawned")


# The .airec envelope (AiRecordFormat): an 8-byte magic and a version, then records of a type byte, a
# 4-byte length and a payload. A usercmd (7) and a frame (9) both start with the actor's slot and serial
# and the tick, 4 bytes each; a frame goes on with its origin's x, y and z as floats.
AIREC_MAGIC = b"SSAIREC\0"
REC_HEADER, REC_BOT_ADDED, REC_USERCMD, REC_FRAME = 1, 2, 7, 9
TRIM_BEFORE, TRIM_AFTER = 100, 34


def airec_records(data):
    """The (type, payload) records of an .airec's bytes, after its header. PURE."""
    if data[:8] != AIREC_MAGIC:
        raise SystemExit("ai-tf-jump: not an .airec: the magic is wrong")
    at = 10
    while at < len(data):
        kind, size = data[at], struct.unpack_from("<I", data, at + 1)[0]
        yield kind, data[at + 5:at + 5 + size]
        at += 5 + size


def flight_windows(frames):
    """The tick windows to keep, from [(tick, z)] of the bot's frames in tick order: each time
    off the floor that rose past FLIGHT_UNITS, TRIM_BEFORE ticks before to TRIM_AFTER after. PURE."""
    out, start, peak = [], None, 0.0
    for i in range(1, len(frames)):
        (ta, za), (tb, zb) = frames[i - 1], frames[i]
        up = zb - FLOOR_Z > 1.0
        if start is None:
            if up and za - FLOOR_Z <= 1.0:
                start, peak = tb, zb - FLOOR_Z
            continue
        peak = max(peak, zb - FLOOR_Z)
        if not up:
            if peak > FLIGHT_UNITS:
                out.append((start - TRIM_BEFORE, tb + TRIM_AFTER))
            start = None
    return out


def trim(data, slot):
    """An .airec's bytes cut down to what the simulator's facts replay: its header and bot records,
    and the usercmds and frames of the actor in the slot inside the flight windows. Answers the
    bytes and the windows. PURE: the self-test holds it."""
    records = list(airec_records(data))
    frames = [(struct.unpack_from("<i", p, 8)[0], struct.unpack_from("<f", p, 20)[0]) for k, p in records
              if k == REC_FRAME and struct.unpack_from("<i", p, 0)[0] == slot]
    windows = flight_windows(frames)
    out = bytearray(data[:10])
    for kind, payload in records:
        keep = kind in (REC_HEADER, REC_BOT_ADDED)
        if kind in (REC_USERCMD, REC_FRAME) and struct.unpack_from("<i", payload, 0)[0] == slot:
            tick = struct.unpack_from("<i", payload, 8)[0]
            keep = any(lo <= tick <= hi for lo, hi in windows)
        if keep:
            out += bytes([kind]) + struct.pack("<I", len(payload)) + payload
    return bytes(out), windows


def record(config, seconds, keep):
    out_dir = os.path.join(ROOT, "src", "ai", "tests", "recordings")
    rec = os.path.join(out_dir, MAP + ".airec")
    source = ai_scenario.sha256(os.path.join(ROOT, "game", "mod_tf2", "maps", "src", "ai", MAP + ".vmf"))
    commit = subprocess.run(["git", "-C", ROOT, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    game = start_game(config)
    try:
        slot = add_jumper(game)
        game.cmd("ai_record start %s %s@%s" % (rec, MAP, source[:12]))
        time.sleep(0.5)
        a = arm(game, slot, 200, seconds)
        counters = game.json("/ai/counters")
        game.cmd("ai_record stop")
        time.sleep(1)
    finally:
        game.stop(keep)
    with open(rec, "rb") as f:
        raw = f.read()
    cut, windows = trim(raw, slot)
    with open(rec, "wb") as f:
        f.write(cut)
    summary = {"map": MAP, "source_sha256": source, "game_commit": commit, "config": config, "seconds": seconds, "slot": slot,
               "bot": "Jumper medium team=2, health held at 200 (ai_aim_tough)", "tick_seconds": a["tick_seconds"],
               "sequences": a["sequences"], "flights": a["flights"],
               "kept": "the bot's usercmds and frames, %d ticks before each flight to %d after" % (TRIM_BEFORE, TRIM_AFTER),
               "windows": windows, "session_bytes": len(raw), "session_sha256": hashlib.sha256(raw).hexdigest(), "counters": counters}
    with open(os.path.join(out_dir, MAP + ".json"), "w") as f:
        json.dump(summary, f, indent=1)
        f.write("\n")
    print("ai-tf-jump: wrote %s (%d bytes) and %s.json: %d flights over %d sequences" % (
        rec, os.path.getsize(rec), MAP, len(a["flights"]), a["sequences"]))
    return 0 if a["flights"] else 1


SIM_FILTER = "FullyQualifiedName~SourceSharp.Ai.Tests.Jump.BlastJump"


def sim(config):
    """Runs the simulator's facts in the build asked for and prints the reports they wrote; a missing nav or report is a failure."""
    nav = os.path.join(ROOT, "bin", config, "mods", "tf2", "maps", MAP + ".nav3d")
    if not os.path.exists(nav):
        raise SystemExit("ai-tf-jump: no %s: `make map MAP=%s CONFIG=%s` builds it" % (nav, MAP, config))
    out = os.path.join(ROOT, "bin", config, "ai-jump")
    if os.path.isdir(out):
        for name in os.listdir(out):
            if name.endswith(".json"):
                os.remove(os.path.join(out, name))
    if config == "debug":
        run = ["make", "-C", ROOT, "--no-print-directory", "ai-test", "FILTER=" + SIM_FILTER]
    else:
        dotnet = os.environ.get("DOTNET", os.path.expanduser("~/.dotnet/dotnet"))
        run = [dotnet, "test", os.path.join(ROOT, "src", "ai", "tests"), "-c", "Release", "--nologo", "--filter", SIM_FILTER]
    p = subprocess.run(run, capture_output=True, text=True, cwd=ROOT)
    lines = (p.stdout + p.stderr).splitlines()
    print("\n".join(l for l in lines if "Passed!" in l or "Failed!" in l))
    if p.returncode != 0:
        print("\n".join(lines[-30:]))
        raise SystemExit("ai-tf-jump: the simulator's facts failed (rc %d)" % p.returncode)
    reports = sorted(n for n in os.listdir(out) if n.endswith(".json")) if os.path.isdir(out) else []
    for wanted in ("differential.json", "speed.json"):
        if wanted not in reports:
            raise SystemExit("ai-tf-jump: the facts wrote no %s" % os.path.join(out, wanted))
    commit = subprocess.run(["git", "-C", ROOT, "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
    for name in reports:
        with open(os.path.join(out, name)) as f:
            print("%s at %s:\n%s" % (name, commit, f.read().rstrip()))
    return 0


def measure(config, seconds, out, keep):
    game = start_game(config)
    try:
        slot = add_jumper(game)
        result = {"map": MAP, "seconds": seconds, "stretch": STRETCH[1] - STRETCH[0],
                  "jump": arm(game, slot, 200, seconds), "walk": arm(game, slot, 85, seconds)}
    finally:
        game.stop(keep)
    report(result)
    if out:
        with open(out, "w") as f:
            json.dump(result, f, indent=1)
        print("wrote %s" % out)
    return 0 if result["jump"]["samples"] and result["walk"]["samples"] else 1


def report(result):
    for name in ("jump", "walk"):
        a = result[name]
        print("%s (health %d): %d sequences, %d samples, leaves %s" % (name, a["health"], a["sequences"], a["samples"], a["leaves"]))
        for lane, s in a["lanes"].items():
            print("  %-8s %s" % (lane, " ".join("%s=%s" % kv for kv in s.items())))
        f = a["flights"]
        if f:
            print("  flights n=%d air=%.2f along=%.1f walked=%.1f peak=%.1f (medians)" % (
                len(f), statistics.median(x["air"] for x in f), statistics.median(x["along"] for x in f),
                statistics.median(x["walked"] for x in f), statistics.median(x["peak"] for x in f)))


def read(path):
    """An earlier run's numbers, made again from its kept track by this tool's arithmetic."""
    with open(path) as f:
        result = json.load(f)
    for name in ("jump", "walk"):
        a = result[name]
        samples = [tuple(s) for s in a["track"]]
        found = traverses(samples, a["tick_seconds"])
        a["traverses"], a["lanes"], a["flights"] = found, summary(found), flights(samples, a["tick_seconds"])
    report(result)
    return 0


def main(argv):
    if "--self-test" in argv:
        self_test()
        return 0
    p = argparse.ArgumentParser(prog="ai-tf-jump")
    p.add_argument("what", choices=["measure", "read", "record", "sim"])
    p.add_argument("file", nargs="?")
    p.add_argument("--seconds", type=float)
    p.add_argument("--config", default="debug")
    p.add_argument("--out")
    p.add_argument("--keep", action="store_true")
    a = p.parse_args(argv)
    if a.what == "read":
        if not a.file:
            raise SystemExit("ai-tf-jump: read needs a run's FILE.json")
        return read(a.file)
    if a.what == "sim":
        if a.config not in ("debug", "release"):
            raise SystemExit("ai-tf-jump: sim runs the debug or the release build")
        return sim(a.config)
    if a.what == "record":
        return record(a.config, a.seconds or 300.0, a.keep)
    return measure(a.config, a.seconds or 240.0, a.out, a.keep)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

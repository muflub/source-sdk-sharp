def vector(v):
    if isinstance(v, dict):
        low = {k.lower(): val for k, val in v.items()}
        return float(low["x"]), float(low["y"]), float(low["z"])
    return float(v[0]), float(v[1]), float(v[2])


def lower(o):
    if isinstance(o, dict):
        return {k.lower(): lower(v) for k, v in o.items()}
    if isinstance(o, list):
        return [lower(v) for v in o]
    return o


# The low lane's slab (TFAiTestMaps: x 500 to 1800 over the lane, 100 u over the floor).
SLAB_X = (500.0, 1800.0)


def under_slab(at):
    """Whether a place (x, y, z) is under the low lane's slab. PURE."""
    lo, hi = LANES["low"]
    return SLAB_X[0] <= at[0] <= SLAB_X[1] and lo <= at[1] <= hi


JUMP_COUNTERS = ("ai.jump.begun", "ai.jump.unknown", "ai.jump.ended", "ai.jump.landed.near", "ai.jump.landed.short", "ai.jump.landed.elsewhere",
                 "ai.jump.called_off.view", "ai.jump.called_off.astray", "ai.jump.fizzled", "ai.jump.died", "ai.jump.timed_out", "ai.jump.predicted",
                 "ai.jump.book.advised", "ai.jump.book.asked", "ai.jump.book.dropped", "ai.jump.book.planned", "ai.jump.book.refused",
                 "ai.jump.work.pieces", "ai.jump.work.flights", "ai.jump.work.floods", "ai.jump.work.cpu.us", "ai.jump.work.faults")


def jump_summary(before, after):
    """What an arm's jumps did, from /ai/jumps read before and after it (None for a game that serves none):
    the counters' change, the jumps that ended in the arm (those whose serial the first read had not), how many
    took off under the slab, and of the landed ones the medians of their air time, ground covered, slide, distance
    from the plan's touch and from the simulator's landing. PURE: the self-test holds it."""
    if not after:
        return None
    before = before or {}
    seen = {j["serial"] for j in before.get("last", [])}
    mine = [j for j in after.get("last", []) if j["serial"] not in seen]
    out = {"counters": {k: after.get(k, 0) - before.get(k, 0) for k in JUMP_COUNTERS},
           "refused": {k[len("ai.jump.refused."):]: after[k] - before.get(k, 0) for k in after if k.startswith("ai.jump.refused.") and after[k] != before.get(k, 0)},
           "nav_sha256": after.get("nav_sha256", ""), "state": after.get("state", ""), "near_units": after.get("near_units"),
           "ends": {}, "under_slab": sum(1 for j in mine if j["launched"] and under_slab(j["takeoff"])), "jumps": mine, "plans": after.get("plans", [])}
    for j in mine:
        out["ends"][j["end"]] = out["ends"].get(j["end"], 0) + 1
    # A jump that did not land: how it ended, after how long an approach, how long it had stood, and how far from its plan's takeoff it was then.
    out["off"] = [{"serial": j["serial"], "end": j["end"], "after": j["approach_seconds"], "stood": j.get("stood_seconds", 0.0),
                   "past": round(((j["touch"][0] - j["takeoff"][0]) ** 2 + (j["touch"][1] - j["takeoff"][1]) ** 2) ** 0.5, 1)} for j in mine if j["end"] != "Landed"]
    landed = [j for j in mine if j["end"] == "Landed"]
    if landed:
        ground = [((j["touch"][0] - j["takeoff"][0]) ** 2 + (j["touch"][1] - j["takeoff"][1]) ** 2) ** 0.5 for j in landed]
        gaps = [j["gap"] for j in landed if j.get("gap") is not None]
        out["landed"] = {"n": len(landed), "air": round(statistics.median(j["air_seconds"] for j in landed), 3), "ground": round(statistics.median(ground), 1),
                         "plan_air": round(statistics.median(j["plan_air_seconds"] for j in landed), 3),
                         "slid": round(statistics.median(j["slid"] for j in landed), 1), "approach": round(statistics.median(j["approach_seconds"] for j in landed), 3),
                         "off_plan": round(statistics.median(j["off_plan"] for j in landed), 1), "off_plan_worst": round(max(j["off_plan"] for j in landed), 1),
                         "health": round(statistics.median(j["plan_health"] for j in landed), 1)}
        stood = [j["stood_seconds"] for j in landed if j.get("stood_seconds", 0.0) > 0.0]
        out["landed"].update({"stood_n": len(stood), "stood": round(statistics.median(stood), 3) if stood else 0.0,
                              "rise": round(statistics.median(j.get("rise", 0.0) for j in landed), 1)})
        if gaps:
            out["landed"].update({"gap_n": len(gaps), "gap": round(statistics.median(gaps), 1), "gap_worst": round(max(gaps), 1)})
    return out


def jumps_of(game):
    """The game's /ai/jumps, or None for a build that serves none."""
    try:
        got = game.json("/ai/jumps")
    except (ValueError, OSError):
        return None
    return got if isinstance(got, dict) and "ai.jump.begun" in got else None


def bot_sample(world, slot):
    """(tick, x, y, z) of the actor in the slot from an /ai/world answer, or None while it is not in the world."""
    for a in world.get("actors") or []:
        if a.get("slot") == slot and a.get("alive") and a.get("at") is not None:
            x, y, z = vector(a["at"])
            return world["tick"], x, y, z
    return None


def arm(game, slot, health, seconds):
    game.cmd("ai_aim_tough %d %d" % (slot, health))
    time.sleep(2.0)
    counters = game.json("/ai/counters")
    before = counters.get("ai.apply.ability.sequences", 0)
    jumps_before = jumps_of(game)
    samples, tick_seconds, leaves = [], 0.015, {}
    deadline = time.time() + seconds
    while time.time() < deadline:
        world = lower(game.json("/ai/world"))
        tick_seconds = world.get("tickseconds", tick_seconds)
        s = bot_sample(world, slot)
        if s is not None and (not samples or s[0] > samples[-1][0]):
            samples.append(s)
        for b in world.get("bots") or []:
            if b.get("slot") == slot and b.get("going"):
                leaf = b["going"].get("leaf") or ""
                leaves[leaf] = leaves.get(leaf, 0) + 1
        time.sleep(0.1)
    end = game.json("/ai/counters")
    after = end.get("ai.apply.ability.sequences", 0)
    # The worker flies each jump again after it lands: a moment for the last one's.
    time.sleep(1.0)
    found = traverses(samples, tick_seconds)
    jumps_after = jumps_of(game)
    units = flight_units(jumps_after)
    return {"health": health, "flights": flights(samples, tick_seconds, units), "flight_units": units, "samples": len(samples), "sequences": after - before, "leaves": leaves,
            "lanes": summary(found), "traverses": found, "jumps": jump_summary(jumps_before, jumps_after),
            "apply_us": {k: end.get(k) for k in ("ai.apply.us", "ai.main.cpu.us", "ai.brain.cpu.us", "ai.run.us")},
            "tick_seconds": tick_seconds, "track": [[t, round(x, 1), round(y, 1), round(z, 1)] for t, x, y, z in samples]}


# The links mode (G5c-2b): the 250 u ledge's top (TFAiTestMaps.LedgeTop(1)), where a try starts on the floor (the yard, south
# of the ledges, a walk of some 600 u from the link's start), how near the place a bot has got there, and the ability
# argument from which a jump's plan is a link's (NavLinks.ArgumentBase).
LEDGE_250 = (1028.0, 1150.0, 266.0)
LINK_START = (1800.0, 900.0, 16.0)
ARRIVE_FLAT, ARRIVE_Z = 64.0, 24.0
LINK_ARGUMENT_BASE = 1 << 22
NEAR_UNITS = 64.0
TRY_TICKS = 2000


def arrived(sample, target):
    """Whether a (tick, x, y, z) sample is at the target: on its floor and within ARRIVE_FLAT of it. PURE."""
    _, x, y, z = sample
    return abs(z - target[2]) <= ARRIVE_Z and ((x - target[0]) ** 2 + (y - target[1]) ** 2) ** 0.5 <= ARRIVE_FLAT


def link_try(found, target, start_tick, end_tick):
    """One try's verdict from what it saw: the jumps that ended in it (/ai/jumps' `last`, new since the try began) and the
    tick it got there (None: it did not). By a link: it got there and a jump of a link's plan landed. PURE."""
    links = [j for j in found if j["plan"] >= LINK_ARGUMENT_BASE]
    # Landed near its touch (JumpTally.NearUnits): one that "landed" far off was carried there (a round's restart puts the bot on its spawn).
    landed = [j for j in links if j["end"] == "Landed" and j.get("off_plan", 0.0) <= NEAR_UNITS]
    felt_early = [j for j in found if j["end"] == "Fizzled" and 0 <= j.get("felt_after_shot", -1) <= 2]
    return {"target": list(target), "arrived": end_tick is not None, "ticks": None if end_tick is None else end_tick - start_tick,
            "begun": len(found), "links_begun": len(links), "by_link": end_tick is not None and len(landed) > 0,
            "ends": [j["end"] if j["end"] != "Landed" or j.get("off_plan", 0.0) <= NEAR_UNITS else "LandedElsewhere" for j in found],
            "link_ids": [j["plan"] - LINK_ARGUMENT_BASE for j in links],
            "gaps": [j["gap"] for j in landed if j.get("gap") is not None], "off_plan": [j["off_plan"] for j in landed],
            "fizzled_felt_early": len(felt_early)}


# Lane G8: the round's state as TF2's `tf2_dev_win` says it bare (TFDevWinCommand): the state, the winner, and whether it
# still waits for players (its restart, 30 s into a level, puts every player back on a spawn).
ROUND_STATE = re.compile(r"\[TF2/Rounds\] state (\w+), winner \S+, waiting (True|False)")


def round_state_of(lines):
    """(state, waiting) from the last bare tf2_dev_win answer in the console lines, or None. PURE."""
    for line in reversed(lines):
        m = ROUND_STATE.search(line)
        if m:
            return m.group(1), m.group(2) == "True"
    return None


def round_running(state):
    """Whether a round_state_of answer is a round under way that no waiting-for-players restart will cut: past the
    preround freeze and with nobody waited for. PURE."""
    return state == ("RoundRunning", False)


def wait_round(game, seconds=120):
    """Waits for the round to run (lane G8): past the preround freeze, which held the bot still at a first try, and past
    TF2's waiting for players, whose restart put the bot on its spawn in the middle of one. Asks tf2_dev_win bare about
    twice a second and reads its answer; answers the seconds waited. A round that never runs is a failure."""
    start = time.time()
    deadline = start + seconds
    while time.time() < deadline:
        seen = len(game.lines())
        game.cmd("tf2_dev_win")
        time.sleep(0.5)
        if round_running(round_state_of(game.lines()[seen:])):
            waited = time.time() - start
            print("  the round runs (waited %.1f s)" % waited, flush=True)
            return waited
    raise SystemExit("ai-tf-jump: the round never ran (tf2_dev_win said %s)" % (round_state_of(game.lines()),))


def hold(game, slot, at=None):
    """Keeps the bot where it is, or at `at` (lane G8): an errand to that place, which the tree goes to and stands at, so
    between tries it never walks off for the flag (a carrier's tree gives an errand way). Answers the place, or None when
    the bot is not in the world (the errand left as it was)."""
    if at is None:
        s = bot_sample(lower(game.json("/ai/world")), slot)
        if s is None:
            return None
        at = s[1:]
    game.cmd("ai_tf_errand Jumper %g %g %g" % tuple(at))
    return at


def run_try(game, slot, target, try_ticks=TRY_TICKS):
    """Sends the bot from LINK_START to the target by its brain and watches it, by server ticks, until it is there or
    try_ticks have gone; the bot is then held where it is (`hold`) and the jumps' records read after the worker has flown
    them again."""
    # Held at the start (lane G8): it stands there until the errand, rather than set off for the flag.
    hold(game, slot, LINK_START)
    put = game.api("teleport", "pos=%g,%g,%g" % (LINK_START[0], LINK_START[1], LINK_START[2] + 1), "ang=0,180,0", "player=%d" % slot)
    if '"ok":true' not in put:
        raise SystemExit("ai-tf-jump: the teleport to the try's start failed: %s" % put[:300])
    time.sleep(1.0)
    before = jumps_of(game) or {}
    start = game.tick()
    game.cmd("ai_tf_errand Jumper %g %g %g" % target)
    got, samples = None, []
    while True:
        world = lower(game.json("/ai/world"))
        s = bot_sample(world, slot)
        if s is not None:
            samples.append(s)
            if arrived(s, target):
                got = s[0]
                break
        if world.get("tick", start) - start > try_ticks:
            break
        time.sleep(0.1)
    hold(game, slot)
    time.sleep(1.5)
    after = jumps_of(game) or {}
    seen = {j["serial"] for j in before.get("last", [])}
    found = [j for j in after.get("last", []) if j["serial"] not in seen]
    out = link_try(found, target, start, got)
    out["track"] = [[t, round(x, 1), round(y, 1), round(z, 1)] for t, x, y, z in samples[::5]]
    out["game"] = {k: after.get(k, 0) - before.get(k, 0) for k in after if k.startswith("ai.jump.") and isinstance(after.get(k), (int, float))
                   and after.get(k, 0) != before.get(k, 0)}
    print("  try -> (%.0f %.0f %.0f): %s in %s ticks, jumps %s links %s gaps %s; %s" % (
        target[0], target[1], target[2], "there" if out["arrived"] else "NOT there", out["ticks"], out["ends"], out["link_ids"], out["gaps"], out["game"]), flush=True)
    return out


def wait_links(game, seconds=300):
    """/ai/jumps once the level's links are known (found or read from the cache), or a failure."""
    deadline = time.time() + seconds
    while time.time() < deadline:
        j = jumps_of(game)
        if j and j.get("links", 0) > 0 and j.get("links.state") in ("found", "read from the cache"):
            return j
        time.sleep(1.0)
    raise SystemExit("ai-tf-jump: the level's links never came: %s" % (jumps_of(game) or {}).get("links.state"))


def link_summary(tries):
    """The tries' totals: arrivals, by a link, the jumps and how they ended, the gaps. PURE."""
    gaps = [g for t in tries for g in t["gaps"]]
    off = [o for t in tries for o in t["off_plan"]]
    ends = {}
    for t in tries:
        for e in t["ends"]:
            ends[e] = ends.get(e, 0) + 1
    ticks = [t["ticks"] for t in tries if t["ticks"] is not None]
    return {"tries": len(tries), "arrived": sum(t["arrived"] for t in tries), "by_link": sum(t["by_link"] for t in tries),
            "first_jump_landed": sum(1 for t in tries if t["ends"][:1] == ["Landed"]), "jumps": sum(t["begun"] for t in tries),
            "link_jumps": sum(t["links_begun"] for t in tries), "ends": ends, "fizzled_felt_early": sum(t["fizzled_felt_early"] for t in tries),
            "ticks_median": statistics.median(ticks) if ticks else None,
            "gap_median": round(statistics.median(gaps), 1) if gaps else None, "gap_worst": round(max(gaps), 1) if gaps else None,
            "off_plan_median": round(statistics.median(off), 1) if off else None, "off_plan_worst": round(max(off), 1) if off else None}


def print_links(name, tries, jumps):
    s = link_summary(tries)
    print("%s: %d of %d tries got there, %d by a link; first jump landed in %d; jumps %d (%d of links) %s; fizzles felt early %d; "
          "ticks to get there (median) %s; gap to the simulator median %s worst %s; off the link's touch median %s worst %s" % (
              name, s["arrived"], s["tries"], s["by_link"], s["first_jump_landed"], s["jumps"], s["link_jumps"], s["ends"], s["fizzled_felt_early"],
              s["ticks_median"], s["gap_median"], s["gap_worst"], s["off_plan_median"], s["off_plan_worst"]))
    for i, t in enumerate(tries):
        print("  try %d -> (%.0f %.0f %.0f): %s in %s ticks, jumps %s links %s gaps %s" % (
            i + 1, t["target"][0], t["target"][1], t["target"][2], "there" if t["arrived"] else "NOT there", t["ticks"], t["ends"], t["link_ids"], t["gaps"]))
    if jumps:
        print("  game: %s" % " ".join("%s=%s" % (k, jumps[k]) for k in sorted(jumps) if k.startswith("ai.jump.link.") or k in ("links", "links.state")))
    return s


def other_landings(jumps):
    """The landings of the level's links with no walk to them, but the 250 u ledge's, one a cell: /ai/jumps' `links.list`. PURE."""
    out, cells = [], set()
    for l in jumps.get("links.list", []):
        if l.get("walk_seconds") is not None or l["to"] in cells:
            continue
        cells.add(l["to"])
        land = tuple(l["landing"])
        if abs(land[2] - LEDGE_250[2]) <= ARRIVE_Z and abs(land[0] - LEDGE_250[0]) <= 160 and abs(land[1] - LEDGE_250[1]) <= 160:
            continue
        out.append(land)
    return out


def links_mode(config, tries, others, reload, out, keep, think_log=False):
    game = start_game(config)
    if think_log:
        game.cmd("ai_think_log 1")
    result = {"map": MAP, "config": config, "commit": subprocess.run(["git", "-C", ROOT, "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()}
    try:
        slot = add_jumper(game)
        game.cmd("ai_aim_tough %d 200" % slot)
        hold(game, slot)
        jumps = wait_links(game)
        result["round_wait_s"] = [wait_round(game)]
        result["links"] = {"n": jumps["links"], "state": jumps["links.state"]}
        result["ledge"] = [run_try(game, slot, LEDGE_250) for _ in range(tries)]
        result["ledge_summary"] = print_links("ledge 250", result["ledge"], jumps_of(game))
        if others:
            result["others"] = [run_try(game, slot, land) for land in other_landings(jumps)]
            result["others_summary"] = print_links("other landings", result["others"], jumps_of(game))
        if reload:
            game.cmd("changelevel %s" % MAP)
            time.sleep(10.0)
            slot = add_jumper(game) if not any(b.get("name") == "Jumper" and b.get("truth") for b in lower(game.json("/ai/world")).get("bots") or []) else slot
            deadline = time.time() + 120
            while time.time() < deadline:
                bots = [b for b in lower(game.json("/ai/world")).get("bots") or [] if b.get("name") == "Jumper" and b.get("truth")]
                if bots:
                    slot = bots[0]["slot"]
                    break
                time.sleep(1.0)
            game.cmd("ai_aim_tough %d 200" % slot)
            hold(game, slot)
            if think_log:
                game.cmd("ai_think_log 1")
            again = wait_links(game)
            result["round_wait_s"].append(wait_round(game))
            result["reload_links"] = {"n": again["links"], "state": again["links.state"], "from_cache": again.get("links.from_cache")}
            print("reload: %d links, %s" % (again["links"], again["links.state"]))
            result["reload"] = [run_try(game, slot, LEDGE_250) for _ in range(tries)]
            result["reload_summary"] = print_links("ledge 250 after the reload", result["reload"], jumps_of(game))
        result["counters"] = {k: v for k, v in (game.json("/ai/counters") or {}).items() if k.startswith("ai.") and isinstance(v, (int, float))}
    finally:
        # This run's console lines beside its numbers: what the game said (think lines with --think-log) as it played.
        if out:
            with open(os.path.splitext(out)[0] + ".console.log", "w") as f:
                f.write("\n".join(game.lines()) + "\n")
        game.stop(keep)
    if out:
        with open(out, "w") as f:
            json.dump(result, f, indent=1)
    s = result.get("ledge_summary", {})
    return 0 if s.get("by_link", 0) >= 8 * tries // 10 else 1


def store_links(db):
    """The experience file's link rows: (class, from bin, to bin, kind, source, tries, successes, seconds, health cost). An unreadable file is a failure."""
    import sqlite3
    with sqlite3.connect("file:%s?mode=ro" % db, uri=True) as c:
        return [tuple(r) for r in c.execute("SELECT class, from_bin, to_bin, kind, source, tries, successes, seconds, health_cost FROM link ORDER BY from_bin, to_bin")]


def unpack_bin(packed):
    """WorldBin.Unpack: 21 bits a coordinate, biased by 2^20; a bin is 64 u square and 72 u tall. PURE."""
    mask, bias = (1 << 21) - 1, 1 << 20
    return ((packed & mask) - bias, ((packed >> 21) & mask) - bias, ((packed >> 42) & mask) - bias)


def experience_routes(game):
    return (game.json("/ai/experience") or {}).get("routes") or {}


def trust_mode(config, tries, db, out):
    if not db:
        raise SystemExit("ai-tf-jump: trust needs --db FILE.db (a private store)")
    db = os.path.abspath(db)
    if os.path.exists(db):
        raise SystemExit("ai-tf-jump: %s exists: the rows must be this run's" % db)
    game = start_game(config, extra="+ai_experience_db %s" % db)
    result = {"map": MAP, "config": config, "db": db, "commit": subprocess.run(["git", "-C", ROOT, "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()}
    try:
        slot = add_jumper(game)
        game.cmd("ai_aim_tough %d 200" % slot)
        hold(game, slot)
        wait_links(game)
        wait_round(game)
        exp = game.json("/ai/experience") or {}
        if exp.get("state") not in ("on", "memory"):
            raise SystemExit("ai-tf-jump: the store is not on: %s" % exp)
        result["a"] = [run_try(game, slot, LEDGE_250) for _ in range(tries)]
        result["a_summary"] = print_links("phase A", result["a"], jumps_of(game))
        builds = experience_routes(game).get("builds", 0)
        game.cmd("mp_restartgame 1")
        deadline = time.time() + 120
        while time.time() < deadline and experience_routes(game).get("builds", 0) <= builds:
            time.sleep(1.0)
        routes = experience_routes(game)
        if routes.get("builds", 0) <= builds:
            raise SystemExit("ai-tf-jump: no routes were built after the restart: %s" % routes)
        result["routes_after_restart"] = routes
        print("after the restart: %s of %s links left out %s; rows %s" % (routes.get("links_shut"), routes.get("links"), routes.get("shut"), (game.json("/ai/experience") or {}).get("rows")))
        hold(game, slot)
        wait_round(game)
        result["b"] = [run_try(game, slot, LEDGE_250) for _ in range(tries)]
        result["b_summary"] = print_links("phase B", result["b"], jumps_of(game))
        shut = set(routes.get("shut") or [])
        result["b_shut_begun"] = sum(1 for t in result["b"] for i in t["link_ids"] if i in shut)
        print("phase B began a link the snapshot left out %d times" % result["b_shut_begun"])
        result["counters"] = {k: v for k, v in (game.json("/ai/counters") or {}).items() if k.startswith("ai.experience.") and isinstance(v, (int, float))}
    finally:
        if out:
            with open(os.path.splitext(out)[0] + ".console.log", "w") as f:
                f.write("\n".join(game.lines()) + "\n")
        game.stop(False)
    rows = store_links(db)
    result["rows"] = rows
    print("link rows in %s: %d" % (db, len(rows)))
    for r in rows:
        print("  class %d bin %s -> bin %s kind %d source %d: tries %.2f successes %.2f mean seconds %.2f mean health %.1f" % (
            r[0], unpack_bin(r[1]), unpack_bin(r[2]), r[3], r[4], r[5], r[6], r[7] / r[6] if r[6] else 0.0, r[8] / r[6] if r[6] else 0.0))
    if out:
        with open(out, "w") as f:
            json.dump(result, f, indent=1)
    return 0 if rows and result.get("b_shut_begun", 1) == 0 else 1


# The course mode (lane G7a): ss_ai_tf_course's stages as TFAiTestMaps.CourseStages has them (west, south, east, north,
# top), each stage's cabinet bay (west, south; 128 square), how far under a stage's top the feet are fallen, and how long
# a run may take.
COURSE_MAP = "ss_ai_tf_course"
COURSE_STAGES = [(64, 176, 320, 432, 656), (448, 208, 704, 528, 756), (832, 336, 1088, 592, 956), (1488, 336, 1744, 592, 956),
                 (1488, 720, 1744, 976, 1256), (1488, 1536, 1744, 1792, 1256), (1104, 1536, 1360, 1792, 1606)]
COURSE_BAYS = [None, (512, 80), (896, 592), (1744, 400), (1744, 784), (1744, 1600), None]
# Lane G7b: the second rocket's course, ss_ai_tf_double (TFAiTestMaps.DoubleStages: a cabinet over each top, no bays).
COURSES = {COURSE_MAP: (COURSE_STAGES, COURSE_BAYS),
           "ss_ai_tf_double": ([(448, 520, 704, 776, 656), (448, 904, 704, 1160, 848), (1120, 904, 1376, 1160, 1424)], [None, None, None])}
# Lane G7c: the wall jump's course, ss_ai_tf_wall (TFAiTestMaps.Wall: ss_ai_tf_double's stages, a wall beside the second jump, no beam).
COURSES["ss_ai_tf_wall"] = COURSES["ss_ai_tf_double"]
BAY_SIZE = 128
FALL_UNITS = 100.0
RUN_TICKS = 12000
RESPAWN_TICKS = 33
# Lane Ge: the maps whose course is their ends (capture areas naming no point), counted from /ai/course; the ends' number.
ENDS_MAPS = {"ss_ai_tf_ends": 3}


def ends_run(polls, jumps, start_tick, ends):
    """One run on a course of ends from its polls [(tick, reached indices, done, branch)] in tick order and the jumps that
    ended in it (/ai/jumps `last`): per end the ticks from the run's start to the first poll that lists it; the link tries
    begun (by end) between one end and the next; the polls under another branch before the end; finished when a poll says
    done with every one of `ends` reached. PURE: the self-test holds it."""
    reached, other, finished = {}, 0, False
    for t, got, done, branch in polls:
        for e in got:
            if e not in reached:
                reached[e] = t - start_tick
        if branch and not branch.endswith("Course") and not finished:
            other += 1
        if done and len(got) == ends:
            finished = True
    tries = {}
    for j in jumps:
        if j["plan"] < LINK_ARGUMENT_BASE:
            continue
        end = j["end"] if j["end"] != "Landed" or j.get("off_plan", 0.0) <= NEAR_UNITS else "LandedElsewhere"
        tries[end] = tries.get(end, 0) + 1
    return {"finished": finished, "reached": {str(k): v for k, v in sorted(reached.items(), key=lambda kv: kv[1])}, "link_tries": tries,
            "other_branch_samples": other}


def stage_of(x, y, z, slack=2.0, course=COURSES[COURSE_MAP]):
    """The stage of `course` ((stages, bays), ss_ai_tf_course's unless given) whose top (or bay) the feet at (x, y, z) stand on, or None. PURE."""
    stages, bays = course
    for i, (w, s, e, n, top) in enumerate(stages):
        if abs(z - top) > slack:
            continue
        if w <= x <= e and s <= y <= n:
            return i
        bay = bays[i]
        if bay and bay[0] <= x <= bay[0] + BAY_SIZE and bay[1] <= y <= bay[1] + BAY_SIZE:
            return i
    return None


def in_bay(x, y, z, course=COURSES[COURSE_MAP]):
    """The stage whose cabinet bay the feet at (x, y, z) stand in, or None. PURE."""
    stages, bays = course
    for i, bay in enumerate(bays):
        top = stages[i][4]
        if bay and abs(z - top) <= 2.0 and bay[0] <= x <= bay[0] + BAY_SIZE and bay[1] <= y <= bay[1] + BAY_SIZE:
            return i
    return None


def link_jumps(links_list, course=COURSES[COURSE_MAP]):
    """The course's jump each of the level's links is ({link index: jump number 1..6}), by its takeoff's and landing's
    stages: a link from stage k to k+1 is jump k+1; any other (a gap back the other way) is none. PURE."""
    out = {}
    for i, l in enumerate(links_list):
        a = stage_of(*l["takeoff"], slack=24.0, course=course)
        b = stage_of(*l["landing"], slack=24.0, course=course)
        if a is not None and b == a + 1:
            out[i] = b
    return out


def course_run(samples, jumps, link_jump, start_tick, course=COURSES[COURSE_MAP]):
    """One run's table from its samples [(tick, x, y, z, health, branch)] in tick order and the jumps that ended in it
    (/ai/jumps `last` entries): per stage the ticks from the run's start to the first sample standing on its top; per jump
    its tries (by end), its falls and the health as the bot left the takeoff stage's top; the bay visits; the decides
    under another branch; finished when the last stage was reached. PURE: the self-test holds it."""
    stages = course[0]
    last = len(stages) - 1
    reached, arrived_health = {}, {}
    takeoffs = {j: [] for j in range(1, last + 1)}
    falls = {j: 0 for j in range(1, last + 1)}
    moved = {j: 0 for j in range(1, last + 1)}
    tries = {j: {} for j in range(1, last + 1)}
    bays = {}
    other = 0
    on, in_bay_now = None, None
    for i, (t, x, y, z, health, branch) in enumerate(samples):
        st = stage_of(x, y, z, course=course)
        if st is not None and st not in reached:
            reached[st] = t - start_tick
            arrived_health[st] = health
        if branch and not branch.endswith("Course") and last not in reached:
            other += 1
        bay = in_bay(x, y, z, course=course)
        if bay is not None and bay != in_bay_now:
            bays[bay] = bays.get(bay, 0) + 1
        in_bay_now = bay
        if st is not None:
            on = (st, health)
        elif on is not None and on[0] < last:
            top = stages[on[0]][4]
            if z > top + 16.0:
                takeoffs[on[0] + 1].append(on[1])
                on = None
            elif z < top - FALL_UNITS:
                falls[on[0] + 1] += 1
                on = None
    for j in jumps:
        jump = link_jump.get(j["plan"] - LINK_ARGUMENT_BASE) if j["plan"] >= LINK_ARGUMENT_BASE else None
        if jump is None:
            continue
        end = j["end"] if j["end"] != "Landed" or j.get("off_plan", 0.0) <= NEAR_UNITS else "LandedElsewhere"
        tries[jump][end] = tries[jump].get(end, 0) + 1
        # A reset is a fall a teleport put back; a jump the game moved otherwise (a round's restart putting the body on its
        # spawn, the tool's own at a run's start) is no fall: counted apart (lane G7b).
        if end == "Reset":
            falls[jump] = max(falls[jump], sum(1 for k in jumps if link_jump.get(k["plan"] - LINK_ARGUMENT_BASE) == jump and k["end"] == "Reset"))
        if end == "Moved":
            moved[jump] += 1
    return {"finished": last in reached, "reached": {str(k): v for k, v in sorted(reached.items())},
            "tries": {str(k): v for k, v in tries.items()}, "falls": {str(k): v for k, v in falls.items()}, "moved": {str(k): v for k, v in moved.items()},
            "takeoff_health": {str(k): v for k, v in takeoffs.items()}, "arrived_health": {str(k): v for k, v in sorted(arrived_health.items())},
            "bays": {str(k): v for k, v in sorted(bays.items())}, "other_branch_samples": other}


def bot_health(game, slot):
    """The bot's health from the dev API's entity read, or None."""
    try:
        got = game.json("/entity?index=%d" % slot)
    except (ValueError, OSError):
        return None
    return got.get("health") if isinstance(got, dict) else None


def course_watch(game, slot, link_jump, course=COURSES[COURSE_MAP]):
    """One run: the round restarted, then the bot watched until it stands on the last stage or RUN_TICKS go by."""
    before = jumps_of(game) or {}
    game.cmd("mp_restartgame 1")
    asked = game.tick()
    # The restart puts the bot on its spawn on S0 a second on: the run starts at the first sample there after it, or at the
    # first a little past the respawn wherever the bot is (lane G7b: on a short course a sample on S0 can be missed; the bot
    # has left it for the first jump).
    start = None
    deadline = time.time() + 120
    while time.time() < deadline and start is None:
        world = lower(game.json("/ai/world"))
        s = bot_sample(world, slot)
        # Past the respawn, and off the last stage (where the run before ended: a sample of it before the restart is not one).
        if s is not None and s[0] > asked + 66 and (stage_of(s[1], s[2], s[3], course=course) == 0
                                                   or (s[0] > asked + 66 + RESPAWN_TICKS and stage_of(s[1], s[2], s[3], course=course) != len(course[0]) - 1)):
            start = s[0]
        time.sleep(0.1)
    if start is None:
        raise SystemExit("ai-tf-jump: the bot was not in the world after the restart")
    seen = {j["serial"] for j in before.get("last", [])}
    samples = []
    last = len(course[0]) - 1
    while True:
        world = lower(game.json("/ai/world"))
        s = bot_sample(world, slot)
        if s is not None:
            going = next((b.get("going") or {} for b in world.get("bots") or [] if b.get("slot") == slot), {})
            samples.append((s[0], s[1], s[2], s[3], bot_health(game, slot), going.get("branch") or ""))
            if stage_of(s[1], s[2], s[3], course=course) == last:
                break
        if world.get("tick", start) - start > RUN_TICKS:
            break
        time.sleep(0.1)
    time.sleep(1.5)
    after = jumps_of(game) or {}
    found = [j for j in after.get("last", []) if j["serial"] not in seen]
    out = course_run(samples, found, link_jump, start, course)
    out["start_tick"] = start
    out["jumps"] = [{k: j.get(k) for k in ("serial", "plan", "end", "launched", "takeoff", "touch", "plan_touch", "off_plan", "rise", "plan_health", "rockets",
                                           "second_after_shot", "felt_after_shot", "gap", "sim_rockets")} for j in found]
    out["game"] = {k: after.get(k, 0) - before.get(k, 0) for k in after if k.startswith("ai.jump.") and isinstance(after.get(k), (int, float))
                   and after.get(k, 0) != before.get(k, 0)}
    out["track"] = [[t, round(x, 1), round(y, 1), round(z, 1), h] for t, x, y, z, h, _ in samples[::5]]
    return out


def print_course(name, runs):
    done = sum(1 for r in runs if r["finished"])
    print("%s: %d of %d runs finished" % (name, done, len(runs)), flush=True)
    for i, r in enumerate(runs):
        print("  run %d: %s; stages reached at ticks %s" % (i + 1, "finished" if r["finished"] else "NOT finished", r["reached"]))
        for j in sorted(r["tries"], key=int):
            print("    J%s: tries %s, falls %d, moved by the game %d, health at takeoff %s, on arrival %s" % (
                j, r["tries"][j] or "{}", r["falls"][j], r.get("moved", {}).get(j, 0), r["takeoff_health"][j], r.get("arrived_health", {}).get(j)))
        for j in r.get("jumps", []):
            if (j.get("rockets") or 1) > 1:
                print("    two rockets: %s, second pressed %s commands after the first, gap to the simulator %s, plan health %s" % (
                    j["end"], j.get("second_after_shot"), j.get("gap"), j.get("plan_health")))
        print("    bays %s; samples under another branch %d; game %s" % (r["bays"], r["other_branch_samples"],
                                                                         " ".join("%s=%s" % (k, v) for k, v in sorted(r["game"].items()))))
    return done


def course_bot(game, slot):
    """The bot's row of /ai/course, or {}."""
    try:
        got = game.json("/ai/course") or {}
    except (ValueError, OSError):
        return {}
    return next((b for b in got.get("bots") or [] if b.get("slot") == slot), {})


def ends_watch(game, slot, ends):
    """One run on a course of ends: the round restarted, the bot's respawn seen to forget the ends (/ai/course reached
    empty past it), then the bot watched until the route says every end reached or RUN_TICKS go by."""
    before = jumps_of(game) or {}
    lives_before = course_bot(game, slot).get("lives", 0)
    game.cmd("mp_restartgame 1")
    asked = game.tick()
    start = None
    deadline = time.time() + 120
    while time.time() < deadline and start is None:
        s = bot_sample(lower(game.json("/ai/world")), slot)
        if s is not None and s[0] > asked + 66 and not course_bot(game, slot).get("reached", [1]):
            start = s[0]
        time.sleep(0.1)
    if start is None:
        raise SystemExit("ai-tf-jump: the bot did not forget the ends after the restart (/ai/course reached never empty)")
    seen = {j["serial"] for j in before.get("last", [])}
    polls, samples = [], []
    while True:
        world = lower(game.json("/ai/world"))
        s = bot_sample(world, slot)
        row = course_bot(game, slot)
        tick = world.get("tick", start)
        if s is not None:
            going = next((b.get("going") or {} for b in world.get("bots") or [] if b.get("slot") == slot), {})
            polls.append((s[0], row.get("reached", []), bool(row.get("done")), going.get("branch") or ""))
            samples.append((s[0], s[1], s[2], s[3], bot_health(game, slot)))
            if row.get("done"):
                break
        if tick - start > RUN_TICKS:
            break
        time.sleep(0.1)
    time.sleep(1.5)
    after = jumps_of(game) or {}
    found = [j for j in after.get("last", []) if j["serial"] not in seen]
    out = ends_run(polls, found, start, ends)
    last = course_bot(game, slot)
    out.update({"start_tick": start, "route": last, "lives_forgotten": last.get("lives", 0) - lives_before,
                "jumps": [{k: j.get(k) for k in ("serial", "plan", "end", "takeoff", "touch", "off_plan", "rise", "plan_health")} for j in found],
                "game": {k: after.get(k, 0) - before.get(k, 0) for k in after if k.startswith("ai.jump.") and isinstance(after.get(k), (int, float))
                         and after.get(k, 0) != before.get(k, 0)},
                "track": [[t, round(x, 1), round(y, 1), round(z, 1), h] for t, x, y, z, h in samples[::5]]})
    return out


def print_ends(name, runs):
    done = sum(1 for r in runs if r["finished"])
    print("%s: %d of %d runs finished" % (name, done, len(runs)), flush=True)
    for i, r in enumerate(runs):
        route = r.get("route", {})
        print("  run %d: %s; ends reached (the game's) at ticks %s; link tries %s; quits %s, set aside %s, entries %s; samples under another branch %d"
              % (i + 1, "finished" if r["finished"] else "NOT finished", r["reached"], r["link_tries"] or "{}", route.get("quits"), route.get("aside"),
                 route.get("entries"), r["other_branch_samples"]))
    return done


def course_mode(config, runs, reload, db, out, think_log=False, map_name=COURSE_MAP):
    if map_name not in COURSES and map_name not in ENDS_MAPS:
        raise SystemExit("ai-tf-jump: no course table for %s (%s)" % (map_name, ", ".join(sorted(list(COURSES) + list(ENDS_MAPS)))))
    course = COURSES.get(map_name)
    ends = ENDS_MAPS.get(map_name)
    if db:
        db = os.path.abspath(db)
        if os.path.exists(db):
            raise SystemExit("ai-tf-jump: %s exists: the rows must be this run's" % db)
    extra = "+mp_waitingforplayers_time 0" + (" +ai_experience_db %s" % db if db else "")
    game = start_game(config, extra=extra, map_name=map_name)
    result = {"map": map_name, "config": config, "db": db,
              "commit": subprocess.run(["git", "-C", ROOT, "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()}
    ok = True
    try:
        if think_log:
            game.cmd("ai_think_log 1")
        slot = add_jumper(game)
        jumps = wait_links(game)
        if ends:
            known = (game.json("/ai/course") or {}).get("ends") or []
            result["ends"] = known
            result["links"] = {"n": jumps["links"], "state": jumps["links.state"]}
            print("links: %d (%s); the ends the bots know: %s" % (jumps["links"], jumps["links.state"],
                                                                  ", ".join("%s %s" % (e["index"], e["title"]) for e in known)), flush=True)
            if len(known) != ends:
                raise SystemExit("ai-tf-jump: the game knows %d ends of %s, not %d" % (len(known), map_name, ends))
            result["runs"] = [ends_watch(game, slot, ends) for _ in range(runs)]
            ok &= print_ends("course", result["runs"]) * 5 >= 4 * runs
        else:
            link_jump = link_jumps(jumps.get("links.list", []), course)
            result["links"] = {"n": jumps["links"], "state": jumps["links.state"], "course_jumps": sorted(set(link_jump.values()))}
            print("links: %d (%s); the course's jumps among them: %s" % (jumps["links"], jumps["links.state"], result["links"]["course_jumps"]), flush=True)
            result["runs"] = [course_watch(game, slot, link_jump, course) for _ in range(runs)]
            ok &= print_course("course", result["runs"]) * 5 >= 4 * runs
        if reload:
            game.cmd("changelevel %s" % map_name)
            time.sleep(10.0)
            deadline = time.time() + 120
            while time.time() < deadline:
                bots = [b for b in lower(game.json("/ai/world")).get("bots") or [] if b.get("name") == "Jumper" and b.get("truth")]
                if bots:
                    slot = bots[0]["slot"]
                    break
                time.sleep(1.0)
            else:
                slot = add_jumper(game)
            if think_log:
                game.cmd("ai_think_log 1")
            again = wait_links(game)
            result["reload_links"] = {"n": again["links"], "state": again["links.state"], "from_cache": again.get("links.from_cache")}
            print("reload: %d links, %s" % (again["links"], again["links.state"]), flush=True)
            if ends:
                result["reload_runs"] = [ends_watch(game, slot, ends) for _ in range(runs)]
                ok &= print_ends("course after the reload", result["reload_runs"]) * 5 >= 4 * runs
            else:
                link_jump = link_jumps(again.get("links.list", []), course)
                result["reload_runs"] = [course_watch(game, slot, link_jump, course) for _ in range(runs)]
                ok &= print_course("course after the reload", result["reload_runs"]) * 5 >= 4 * runs
        result["counters"] = {k: v for k, v in (game.json("/ai/counters") or {}).items() if k.startswith("ai.") and isinstance(v, (int, float))}
    finally:
        if out:
            with open(os.path.splitext(out)[0] + ".console.log", "w") as f:
                f.write("\n".join(game.lines()) + "\n")
        game.stop(False)
    if db:
        rows = store_links(db)
        result["rows"] = rows
        print("link rows in %s: %d" % (db, len(rows)))
        for r in rows:
            print("  class %d bin %s -> bin %s kind %d source %d: tries %.2f successes %.2f mean seconds %.2f mean health %.1f" % (
                r[0], unpack_bin(r[1]), unpack_bin(r[2]), r[3], r[4], r[5], r[6], r[7] / r[6] if r[6] else 0.0, r[8] / r[6] if r[6] else 0.0))
    if out:
        with open(out, "w") as f:
            json.dump(result, f, indent=1)
    return 0 if ok else 1


def start_game(config, extra="", map_name=MAP):
    """A headless tf2 game on the map, up; a missing map is a failure."""
    nav = os.path.join(ROOT, "bin", config, "mods", "tf2", "maps", map_name + ".nav3d")
    if not os.path.exists(nav):
        raise SystemExit("ai-tf-jump: no %s: `make map MAP=%s` builds it" % (nav, map_name))
    game = ai_scenario.Game(map_name, config, extra=extra, mod="tf2")
    game.start()
    return game


def add_jumper(game):
    """Adds the one red Soldier and answers its slot once it is in the world."""
    game.cmd("ai_bot_add Jumper medium team=2")
    deadline = time.time() + 120
    while time.time() < deadline:
        for b in lower(game.json("/ai/world")).get("bots") or []:
            if b.get("name") == "Jumper" and b.get("truth"):
                return b["slot"]
        time.sleep(1.0)
    raise SystemExit("ai-tf-jump: the bot never spawned")


# The .airec envelope (AiRecordFormat): an 8-byte magic and a version, then records of a type byte, a
# 4-byte length and a payload. A usercmd (7) and a frame (9) both start with the actor's slot and serial
# and the tick, 4 bytes each; a frame goes on with its origin's x, y and z as floats.
AIREC_MAGIC = b"SSAIREC\0"
REC_HEADER, REC_BOT_ADDED, REC_USERCMD, REC_FRAME = 1, 2, 7, 9
TRIM_BEFORE, TRIM_AFTER = 100, 34


def airec_records(data):
    """The (type, payload) records of an .airec's bytes, after its header. PURE."""
    if data[:8] != AIREC_MAGIC:
        raise SystemExit("ai-tf-jump: not an .airec: the magic is wrong")
    at = 10
    while at < len(data):
        kind, size = data[at], struct.unpack_from("<I", data, at + 1)[0]
        yield kind, data[at + 5:at + 5 + size]
        at += 5 + size


def flight_windows(frames):
    """The tick windows to keep, from [(tick, z)] of the bot's frames in tick order: each time
    off the floor that rose past FLIGHT_UNITS, TRIM_BEFORE ticks before to TRIM_AFTER after. PURE."""
    out, start, peak = [], None, 0.0
    for i in range(1, len(frames)):
        (ta, za), (tb, zb) = frames[i - 1], frames[i]
        up = zb - FLOOR_Z > 1.0
        if start is None:
            if up and za - FLOOR_Z <= 1.0:
                start, peak = tb, zb - FLOOR_Z
            continue
        peak = max(peak, zb - FLOOR_Z)
        if not up:
            if peak > FLIGHT_UNITS:
                out.append((start - TRIM_BEFORE, tb + TRIM_AFTER))
            start = None
    return out


def trim(data, slot):
    """An .airec's bytes cut down to what the simulator's facts replay: its header and bot records,
    and the usercmds and frames of the actor in the slot inside the flight windows. Answers the
    bytes and the windows. PURE: the self-test holds it."""
    records = list(airec_records(data))
    frames = [(struct.unpack_from("<i", p, 8)[0], struct.unpack_from("<f", p, 20)[0]) for k, p in records
              if k == REC_FRAME and struct.unpack_from("<i", p, 0)[0] == slot]
    windows = flight_windows(frames)
    out = bytearray(data[:10])
    for kind, payload in records:
        keep = kind in (REC_HEADER, REC_BOT_ADDED)
        if kind in (REC_USERCMD, REC_FRAME) and struct.unpack_from("<i", payload, 0)[0] == slot:
            tick = struct.unpack_from("<i", payload, 8)[0]
            keep = any(lo <= tick <= hi for lo, hi in windows)
        if keep:
            out += bytes([kind]) + struct.pack("<I", len(payload)) + payload
    return bytes(out), windows


def record(config, seconds, keep, rec=None):
    """Records the jump arm; with `rec` (a path), to there and its .json beside it, and the committed recording is not touched."""
    out_dir = os.path.join(ROOT, "src", "ai", "tests", "recordings")
    json_path = os.path.join(out_dir, MAP + ".json")
    if rec:
        rec = os.path.abspath(rec)
        json_path = os.path.splitext(rec)[0] + ".json"
    else:
        rec = os.path.join(out_dir, MAP + ".airec")
    source = ai_scenario.sha256(os.path.join(ROOT, "game", "mod_tf2", "maps", "src", "ai", MAP + ".vmf"))
    commit = subprocess.run(["git", "-C", ROOT, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    game = start_game(config)
    try:
        slot = add_jumper(game)
        game.cmd("ai_record start %s %s@%s" % (rec, MAP, source[:12]))
        time.sleep(0.5)
        a = arm(game, slot, 200, seconds)
        counters = game.json("/ai/counters")
        game.cmd("ai_record stop")
        time.sleep(1)
    finally:
        game.stop(keep)
    with open(rec, "rb") as f:
        raw = f.read()
    cut, windows = trim(raw, slot)
    with open(rec, "wb") as f:
        f.write(cut)
    summary = {"map": MAP, "source_sha256": source, "game_commit": commit, "config": config, "seconds": seconds, "slot": slot,
               "bot": "Jumper medium team=2, health held at 200 (ai_aim_tough)", "tick_seconds": a["tick_seconds"],
               "sequences": a["sequences"], "flights": a["flights"],
               "kept": "the bot's usercmds and frames, %d ticks before each flight to %d after" % (TRIM_BEFORE, TRIM_AFTER),
               "windows": windows, "session_bytes": len(raw), "session_sha256": hashlib.sha256(raw).hexdigest(), "counters": counters}
    if json_path != os.path.join(out_dir, MAP + ".json"):
        # A recording of one's own: the game's jumps too (/ai/jumps, each with its gap to the simulator's flight from its launch).
        summary["jumps"] = a["jumps"]
    with open(json_path, "w") as f:
        json.dump(summary, f, indent=1)
        f.write("\n")
    print("ai-tf-jump: wrote %s (%d bytes) and %s: %d flights over %d sequences" % (
        rec, os.path.getsize(rec), json_path, len(a["flights"]), a["sequences"]))
    return 0 if a["flights"] else 1


SIM_FILTER = "FullyQualifiedName~SourceSharp.Ai.Tests.Jump.BlastJump"


def sim(config):
    """Runs the simulator's facts in the build asked for and prints the reports they wrote; a missing nav or report is a failure."""
    nav = os.path.join(ROOT, "bin", config, "mods", "tf2", "maps", MAP + ".nav3d")
    if not os.path.exists(nav):
        raise SystemExit("ai-tf-jump: no %s: `make map MAP=%s CONFIG=%s` builds it" % (nav, MAP, config))
    out = os.path.join(ROOT, "bin", config, "ai-jump")
    if os.path.isdir(out):
        for name in os.listdir(out):
            if name.endswith(".json"):
                os.remove(os.path.join(out, name))
    if config == "debug":
        run = ["make", "-C", ROOT, "--no-print-directory", "ai-test", "FILTER=" + SIM_FILTER]
    else:
        dotnet = os.environ.get("DOTNET", os.path.expanduser("~/.dotnet/dotnet"))
        run = [dotnet, "test", os.path.join(ROOT, "src", "ai", "tests"), "-c", "Release", "--nologo", "--filter", SIM_FILTER]
    p = subprocess.run(run, capture_output=True, text=True, cwd=ROOT)
    lines = (p.stdout + p.stderr).splitlines()
    print("\n".join(l for l in lines if "Passed!" in l or "Failed!" in l))
    if p.returncode != 0:
        print("\n".join(lines[-30:]))
        raise SystemExit("ai-tf-jump: the simulator's facts failed (rc %d)" % p.returncode)
    reports = sorted(n for n in os.listdir(out) if n.endswith(".json")) if os.path.isdir(out) else []
    for wanted in ("differential.json", "speed.json"):
        if wanted not in reports:
            raise SystemExit("ai-tf-jump: the facts wrote no %s" % os.path.join(out, wanted))
    commit = subprocess.run(["git", "-C", ROOT, "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
    for name in reports:
        with open(os.path.join(out, name)) as f:
            print("%s at %s:\n%s" % (name, commit, f.read().rstrip()))
    return 0


def measure(config, seconds, out, keep, walk_health=110):
    nav = os.path.join(ROOT, "bin", config, "mods", "tf2", "maps", MAP + ".nav3d")
    game = start_game(config)
    try:
        slot = add_jumper(game)
        result = {"map": MAP, "seconds": seconds, "stretch": STRETCH[1] - STRETCH[0], "config": config, "nav_sha256": ai_scenario.sha256(nav),
                  "commit": subprocess.run(["git", "-C", ROOT, "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip(),
                  "jump": arm(game, slot, 200, seconds), "walk": arm(game, slot, walk_health, seconds)}
    finally:
        game.stop(keep)
    report(result)
    if out:
        with open(out, "w") as f:
            json.dump(result, f, indent=1)
        print("wrote %s" % out)
    return 0 if result["jump"]["samples"] and result["walk"]["samples"] else 1


def report(result):
    for name in ("jump", "walk"):
        a = result[name]
        print("%s (health %d): %d sequences, %d samples, leaves %s" % (name, a["health"], a["sequences"], a["samples"], a["leaves"]))
        for lane, s in a["lanes"].items():
            print("  %-8s %s" % (lane, " ".join("%s=%s" % kv for kv in s.items())))
        f = a["flights"]
        if f:
            print("  flights (over %.0f u up) n=%d air=%.2f along=%.1f walked=%.1f peak=%.1f (medians)" % (
                a.get("flight_units", FLIGHT_UNITS), len(f), statistics.median(x["air"] for x in f), statistics.median(x["along"] for x in f),
                statistics.median(x["walked"] for x in f), statistics.median(x["peak"] for x in f)))
        j = a.get("jumps")
        if j:
            c = j["counters"]
            print("  jumps begun=%d ended=%d: landed near=%d short=%d elsewhere=%d, called off view=%d astray=%d, fizzled=%d died=%d timed out=%d; under the slab=%d" % (
                c["ai.jump.begun"], c["ai.jump.ended"], c["ai.jump.landed.near"], c["ai.jump.landed.short"], c["ai.jump.landed.elsewhere"],
                c["ai.jump.called_off.view"], c["ai.jump.called_off.astray"], c["ai.jump.fizzled"], c["ai.jump.died"], c["ai.jump.timed_out"], j["under_slab"]))
            if "landed" in j:
                l = j["landed"]
                print("  flown n=%d air=%.2f (plan %.2f) ground=%.1f slid=%.1f approach=%.2f off the plan's touch=%.1f (worst %.1f), blast %.1f health (medians)" % (
                    l["n"], l["air"], l["plan_air"], l["ground"], l["slid"], l["approach"], l["off_plan"], l["off_plan_worst"], l["health"]))
                if "stood_n" in l:
                    print("  rose %.1f (median); %d of them stood for a late view, %.2f s (median)" % (l["rise"], l["stood_n"], l["stood"]))
                if "gap" in l:
                    print("  gap to the simulator's landing for the same recipe and launch: n=%d median=%.1f worst=%.1f" % (l["gap_n"], l["gap"], l["gap_worst"]))
            for o in j.get("off", []):
                print("  off: jump %d %s after %.2f s, %.1f u from its plan's takeoff, having stood %.2f s" % (o["serial"], o["end"], o["after"], o["past"], o["stood"]))
            print("  book asked=%d planned=%d refused=%d %s; worker flights=%d floods=%d cpu=%.0f ms" % (
                c["ai.jump.book.asked"], c["ai.jump.book.planned"], c["ai.jump.book.refused"], j["refused"],
                c["ai.jump.work.flights"], c["ai.jump.work.floods"], c["ai.jump.work.cpu.us"] / 1000.0))
        if a.get("apply_us"):
            print("  %s" % " ".join("%s=%s" % kv for kv in a["apply_us"].items()))


def read(path):
    """An earlier run's numbers, made again from its kept track by this tool's arithmetic."""
    with open(path) as f:
        result = json.load(f)
    for name in ("jump", "walk"):
        a = result[name]
        samples = [tuple(s) for s in a["track"]]
        found = traverses(samples, a["tick_seconds"])
        a["traverses"], a["lanes"], a["flights"] = found, summary(found), flights(samples, a["tick_seconds"], a.get("flight_units", FLIGHT_UNITS))
    report(result)
    return 0


def main(argv):
    if "--self-test" in argv:
        self_test()
        return 0
    p = argparse.ArgumentParser(prog="ai-tf-jump")
    p.add_argument("what", choices=["measure", "read", "record", "sim", "links", "trust", "course"])
    p.add_argument("file", nargs="?")
    p.add_argument("--seconds", type=float)
    p.add_argument("--config", default="debug")
    p.add_argument("--out")
    p.add_argument("--keep", action="store_true")
    p.add_argument("--walk-health", type=int, default=110)
    p.add_argument("--tries", type=int, default=10)
    p.add_argument("--others", action="store_true")
    p.add_argument("--reload", action="store_true")
    p.add_argument("--think-log", action="store_true")
    p.add_argument("--db")
    p.add_argument("--runs", type=int, default=5)
    p.add_argument("--rec")
    p.add_argument("--map")
    a = p.parse_args(argv)
    if a.what == "course":
        return course_mode(a.config, a.runs, a.reload, a.db, a.out, a.think_log, a.map or COURSE_MAP)
    if a.what == "trust":
        return trust_mode(a.config, a.tries, a.db, a.out)
    if a.what == "links":
        return links_mode(a.config, a.tries, a.others, a.reload, a.out, a.keep, a.think_log)
    if a.what == "read":
        if not a.file:
            raise SystemExit("ai-tf-jump: read needs a run's FILE.json")
        return read(a.file)
    if a.what == "sim":
        if a.config not in ("debug", "release"):
            raise SystemExit("ai-tf-jump: sim runs the debug or the release build")
        return sim(a.config)
    if a.what == "record":
        return record(a.config, a.seconds or 300.0, a.keep, a.rec)
    return measure(a.config, a.seconds or 240.0, a.out, a.keep, a.walk_health)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env python3
"""tools/fx-impact-gate -- does a bullet leave a mark?

THE DEFECT THIS IS ABOUT. `live-batch` measured, at 9819bc5d7,
that shooting a physics prop produced NO impact effect at all: a crate at the
aim point, `debug-api aim` naming prop_physics, carried rounds 90 -> 63 so the gun
really fired, sprite quads +2115 so rendering was live -- and BOTH ledgers flat,
temp entities 58 -> 58 and impact particles 0 -> 0.

THE HAZARD HERE IS A FALSE PASS, not a false red, and every clause below is
shaped against it.

  * NOTHING IS INFERRED FROM AN ABSENCE. Each precondition is asserted
    POSITIVELY before the effect is looked for, because every link in the
    firing chain fails silently and each failure reads as "no impact effect":
    a client that never joined, a map still spawning, a camera pointing at a
    wall, a weapon that was never selected, a trigger that was never pulled.

  * THE COUNTER IS NOT ENOUGH ON ITS OWN. `8f-movetypes` had a broken roaming
    observer whose loop counter grew exactly like a working build's. So the
    impact ledger is read THREE ways, and a build that merely increments
    something cannot pass all three:

      1. IT MOVES at all, against a crate the gate spawned itself;
      2. IT SCALES with the rounds spent -- a long burst must raise it by more
         than a short one, which a counter ticking on some unrelated frame
         path does not do;
      3. IT STAYS PUT over the same window with THE TRIGGER NOT PULLED. A row
         that keeps climbing while the player stands there holding nothing is
         counting frames, or thinks, or draws -- not impacts.

      4. AND THE ROW THAT MOVES IS THE RIGHT ONE: flecks, from a wooden crate,
         and not blood, which nothing in the run shot. A build that lit every
         impact row on every impact would pass 1, 2 and 3 and fail this.

    Arms 2, 3 and 4 are the ones that can fail on a build that passes arm 1, and
    all of them run in the SAME PROCESS against the SAME gun seconds apart, so
    the axis varied is the trigger and nothing else.

    AN EARLIER ARM 3 FIRED AT THE SKY and is withdrawn, measured rather than
    reasoned away: SURF_SKY really is the one surface every stock impact path
    refuses, but at dm_lockdown's `openFloor` stand `setang -89 0 0` puts
    `debug-api aim` on **worldspawn** -- there is a CEILING up there, not sky. The
    arm scored a correct impact on a roof as a failure. A gate that cannot tell
    its negative arm apart from its positive one is worse than not having it.

  * THE LEDGER IS THE NATIVE ONE, and what a row in it means is written at
    shell_effect_ledger.h: incremented AFTER the last early-out on the draw
    path, once per PRIMITIVE ACTUALLY EMITTED -- not on entry, and not per
    entity that exists. An impact that dispatched and drew nothing therefore
    still reads zero, which is the whole point.

EXIT CODES: 0 every arm passed / 1 a real red about the code / 2 NOT
MEASURABLE -- reported as three counts, passed / failed / discarded.

RUN IT with a per-lane debug-api directory, TMPDIR and DEBUG_API_UI_PORT; the socket
directory default is machine-wide and the UI proxy port is a fixed 27110, so a
second concurrent `debug-api run` on it dies EADDRINUSE and takes the game with
it. The client join needs no lease: concurrent joined games measured no
Steam ticket failure (tools/local_launch.py).
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))


def _load(name, path):
    spec = importlib.util.spec_from_file_location(
        name, path, loader=importlib.machinery.SourceFileLoader(name, path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


lg = _load("livegate", os.path.join(HERE, "live-gate"))

PROP_NAME = "ss_fximpact_crate"
CRATE_MODEL = "models/props_junk/wood_crate001a.mdl"

# The walk that says the CLIENT is there. A player the console can move is a
# player whose usercmds are being made and delivered; a client that never
# joined cannot walk at all. Borrowed in shape from `phys-wakesleep`, which is
# where this project established that a free walk of a MEASURED distance is the
# join proof and `debug-api ents ss_player` is not -- that is the SERVER's list
# and it answers perfectly well about a game no client ever reached.
WALK_SECONDS = 1.6
WALK_MIN_UNITS = 40.0

SHORT_BURST = 0.35
LONG_BURST = 1.6


class Arm(object):
    """One row of the verdict. passed / failed / discarded, and why."""

    def __init__(self):
        self.passed = 0
        self.failed = 0
        self.discarded = 0
        self.rows = []

    def ok(self, label, why):
        self.passed += 1
        self.rows.append(("PASS", label, why))

    def bad(self, label, why):
        self.failed += 1
        self.rows.append(("FAIL", label, why))

    def skip(self, label, why):
        self.discarded += 1
        self.rows.append(("DISCARD", label, why))

    def report(self):
        for verdict, label, why in self.rows:
            print("  %-46s %-8s %s" % (label, verdict, why), flush=True)
        print("== passed %d  failed %d  discarded %d"
              % (self.passed, self.failed, self.discarded), flush=True)
        if self.failed:
            return 1
        if self.discarded:
            return 2
        return 0


def box():
    """The machine DURING the run, not at its endpoints.

    `pgrep -x`, never `-f`: `-f` matches this gate's own command line. And the
    count is taken by counting LINES, because `pgrep -c` exits 1 and prints a
    zero, which appends a second zero to any `|| echo 0` pipeline.
    """
    games = 0
    try:
        with os.popen("pgrep -x hl2_linux64") as fh:
            games = len([l for l in fh.read().split("\n") if l.strip()])
    except Exception:
        games = -1
    load = open("/proc/loadavg").read().split()[0]
    avail = 0
    for line in open("/proc/meminfo"):
        if line.startswith("MemAvailable:"):
            avail = int(line.split()[1]) // 1024 // 1024
    return "[box hl2=%d load=%s availGB=%d]" % (games, load, avail)


def console_tail(paths, since):
    """Everything the game has printed since a byte offset, over both sinks.

    Native Msg() reaches the launch log and -condebug's console.log; the
    MANAGED log reaches neither -- it is read through `debug-api log`. Both sinks
    are read because which one carries a line has changed with the launch flags
    before now, and a reader of only one answers a plausible zero.
    """
    out = []
    for path in paths:
        try:
            with open(path, "rb") as fh:
                fh.seek(since.get(path, 0))
                out.append(fh.read().decode("utf-8", "replace"))
        except OSError:
            pass
    return "\n".join(out)


def console_mark(paths):
    mark = {}
    for path in paths:
        try:
            mark[path] = os.path.getsize(path)
        except OSError:
            mark[path] = 0
    return mark


IMPACT_ROWS = ("impact flecks", "impact dust", "impact blood")

# A row as cs_cl_effects_report prints it ("  impact flecks   12"), or as
# cs_cl_fx_report prints the managed one ("[SourceSharp/Client] fx:   impact
# blood   4"): FX_Blood left native code with lane c5-particles
# (ImpactSprays.Blood), so its row is the managed report's.
ROW_RE = r"^(?:\[SourceSharp/Client\] fx:)?\s*%s\s+(\d+)\s*$"


def report_text(api, paths):
    """Both reports' text: the native ledger and the managed fx report."""
    mark = console_mark(paths)
    api.cmd("cs_cl_effects_report")
    api.cmd("cs_cl_fx_report")
    time.sleep(2.0)
    return console_tail(paths, mark)


def impact_ledger(api, paths):
    """The three impact rows of `cs_cl_effects_report`, summed, or None.

    None and 0 are different answers and the callers tell them apart: None is
    "the readout did not reach us", which is a DISCARD, and 0 is "the client
    drew nothing", which is the reading this gate exists to take.
    """
    text = report_text(api, paths)
    total = 0
    seen = 0
    for row in IMPACT_ROWS:
        m = re.search(ROW_RE % re.escape(row), text, re.M)
        if m:
            total += int(m.group(1))
            seen += 1
    return total if seen == len(IMPACT_ROWS) else None


def impact_rows(api, paths):
    """The three impact rows SEPARATELY, or None.

    The summed reader above answers "did anything impact-shaped draw"; this one
    answers "was it the right KIND", which is a question a build that lights
    every row on every impact gets wrong while passing the sum.
    """
    text = report_text(api, paths)
    rows = {}
    for row in IMPACT_ROWS:
        m = re.search(ROW_RE % re.escape(row), text, re.M)
        if m:
            rows[row] = int(m.group(1))
    return rows if len(rows) == len(IMPACT_ROWS) else None


def view_draws(api, scen):
    """How many times the client's view has drawn its effect list.

    THE CONTROL ON THE READOUT: a client that renders a frame draws the
    client-side effect list once (IEffectsList::DrawEffects, counted as
    the ClientFxDrawEffects crossing), whatever is or is not in front of
    the camera. It was the sprite-quad row, and that row counts sprites IN
    VIEW: at the openFloor stand, five of ten view directions draw no sprite
    at all while the view renders 120 frames in two seconds (measured at
    3432d25e, lane c2-fx), and where the crate comes to rest decides which
    way the camera faces. One run of two read 403 -> 403 that way.
    Read from the local client's own counters (/client/{slot}/status), so it
    works in a release build as well; None when they do not answer.
    """
    players = api.ents(scen["playerClass"])
    if len(players) != 1:
        return None
    ops = api.client_crossings(players[0]["index"]).get("ops")
    if not ops:
        return None
    return ops.get("ClientFxDrawEffects", 0)


def temp_entities(api):
    """`cs_cl_te_report`'s played count -- the MANAGED ledger, read managed.

    Through `debug-api log` from the sequence the command itself handed back:
    `tools/debug-api log` with no `since` returns the OLDEST 500 lines, so a reader
    that takes the default window reads the game's start-up for the life of the
    process.
    """
    seq = api.cmd("cs_cl_te_report").get("logFrom", 0)
    time.sleep(2.0)
    for line in reversed(api.log_from(seq, 400)):
        m = re.search(r"temp entities:\s*(\d+)\s+played", line)
        if m:
            return int(m.group(1))
    return None


def carried_rounds(api, index):
    """Clip + reserve for one ss_weapon. The proof the trigger was pulled."""
    try:
        fields = api.fields(index)
    except Exception:
        return None
    total = 0
    got = False
    for name in ("Clip", "Reserve"):
        if name in fields:
            try:
                total += int(float(fields[name]))
                got = True
            except (TypeError, ValueError):
                pass
    return total if got else None


def spawn_crate(g):
    """A crate of OUR OWN at the aim point, not one of the map's hundred.

    The map's props are wherever the mapper put them and the first runs of the
    gate this borrows from read `frames 0` with a WALL between the camera and
    the subject. `ent_create` spawns where the player LOOKS, so the stand is
    part of the spawn and not a step before it -- otherwise one arm inherits
    another's camera and the crate lands outside the world.
    """
    api = g.api
    g.cheats()
    api.fire(PROP_NAME, "Kill")
    time.sleep(0.6)
    before = {e["index"] for e in api.ents("prop_physics")}
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)
    api.cmd("ent_create prop_physics model %s targetname %s"
            % (CRATE_MODEL, PROP_NAME))
    time.sleep(4.0)
    for ent in api.ents("prop_physics"):
        if ent["index"] not in before:
            return ent
    return None


def aim_class(api):
    try:
        d = api.get("aim")
    except Exception:
        return ""
    return d.get("hitClass", "") if d.get("hit") else ""


def fire_at(g, seconds):
    g.hold("attack", seconds)
    time.sleep(2.5)


def run(keep):
    arm = Arm()
    scen = json.load(open(os.path.join(HERE, "live-gate-scenarios",
                                       "dm_lockdown.json")))
    port = lg.free_udp_port(*lg.GATE_PORT_RANGE)
    scratch = os.path.join(os.environ.get("TMPDIR", "/tmp"),
                           "ss-fximpact-%d-%d" % (os.getpid(), port))
    os.makedirs(scratch, exist_ok=True)
    log = os.path.join(scratch, "server.log")

    print("== fx-impact: does a bullet leave a mark?  %s" % box(), flush=True)
    game = lg.Game.launch(lg.server_launch(port, scen["map"]), log,
                          os.path.join(scratch, "server"))
    if game is None:
        arm.skip("the game launched", "no debug-api socket appeared")
        return arm.report()

    api = game.api
    g = lg.Gate(api, scen, verbose=False)
    try:
        # The console file /console follows (console.log, or the +con_logfile
        # one), asked of the game rather than worked out here.
        paths = [log, lg.console_file(api)]
        #------------------------------------------------------------------
        # 1. THE MAP REACHED ITS FULL ENTITY COUNT.
        #
        # The HIGH-WATER MARK and not a second census afterwards: entities come
        # and go once a map has finished spawning, and a reading taken later is
        # a reading of a different moment. What this asks is whether the map
        # ever got there.
        #------------------------------------------------------------------
        seen = []
        settled = api.wait_for(
            lambda: (seen.append(api.census()[0]) or
                     seen[-1] >= scen["entities"]), 240.0)
        reached = max(seen) if seen else 0
        if not settled:
            arm.skip("the map reached its full entity count",
                     "%d of %d entities -- still spawning"
                     % (reached, scen["entities"]))
            return arm.report()
        arm.ok("the map reached its full entity count",
               "%d entities (wanted %d)" % (reached, scen["entities"]))

        if not api.wait_for(lambda: api.player(scen["playerClass"]), 120.0):
            arm.skip("the client joined", "no player entity ever appeared")
            return arm.report()
        time.sleep(2.0)

        #------------------------------------------------------------------
        # 2. THE CLIENT JOINED -- a FREE WALK of a measured distance.
        #
        # Not `debug-api ents ss_player`: that is the SERVER's list and it answers
        # about a game no client ever reached. A player the console can walk is
        # a player whose usercmds are being built by a client and delivered.
        # Nothing is in front of the player, so this cannot be about the crate.
        #------------------------------------------------------------------
        g.cheats()
        g.teleport(scen["openFloor"], scen["openFloorAngles"], settle=1.2)
        start = g.player_origin()
        g.hold("forward", WALK_SECONDS)
        time.sleep(0.6)
        end = g.player_origin()
        walked = None
        if start and end:
            walked = sum((a - b) ** 2 for a, b in zip(start[:2], end[:2])) ** 0.5
        if walked is None or walked < WALK_MIN_UNITS:
            steam = 0
            try:
                steam = len(re.findall(
                    r"GetAuthSessionTicket|requires that you be running Steam",
                    console_tail(paths, {})))
            except Exception:
                pass
            arm.skip("the client joined",
                     "the player walked %s units in %.1fs (wanted >= %.0f); "
                     "Steam auth refusals in the log: %d"
                     % ("%.1f" % walked if walked is not None else "?",
                        WALK_SECONDS, WALK_MIN_UNITS, steam))
            return arm.report()
        arm.ok("the client joined",
               "the player walked %.1f units on the console's own +forward"
               % walked)

        #------------------------------------------------------------------
        # 3. THE TARGET EXISTS AT THE AIM POINT AND `debug-api aim` NAMES IT.
        #------------------------------------------------------------------
        crate = spawn_crate(g)
        if crate is None:
            arm.skip("the target exists and `debug-api aim` names it",
                     "no crate could be spawned")
            return arm.report()
        # AND THEN LOOK AT IT WHERE IT LANDED. The crate is created at the aim
        # point and then FALLS; the camera that spawned it points at where it
        # was. The +8 lift aims at its body rather than the seam where it meets
        # the floor.
        resting = api.ents("prop_physics")
        resting = [e for e in resting if e["index"] == crate["index"]]
        if resting:
            g.face(resting[0]["origin"], lift=8.0)
        time.sleep(0.8)
        sees = aim_class(api)
        if sees != "prop_physics":
            arm.skip("the target exists and `debug-api aim` names it",
                     "the camera is looking at '%s' -- the frustum, not the "
                     "port" % (sees or "nothing"))
            return arm.report()
        arm.ok("the target exists and `debug-api aim` names it",
               "crate %d, and aim reads prop_physics" % crate["index"])

        #------------------------------------------------------------------
        # 4. THE WEAPON ACTUALLY FIRED -- carried rounds FELL.
        #
        # The link the first run of the gate this borrows from was missing: it
        # pressed +attack with nothing selected, read no effect, and called it
        # a red about the impact path.
        #------------------------------------------------------------------
        api.cmd("use weapon_smg1")
        time.sleep(1.2)
        weapons = api.ents("ss_weapon")
        if not weapons:
            arm.skip("the weapon actually fired",
                     "no ss_weapon entity, so nothing could be fired")
            return arm.report()
        weapon = min(weapons, key=lambda e: e["index"])["index"]

        draws_before = view_draws(api, scen)
        rows_begin = impact_rows(api, paths)
        fx_before = impact_ledger(api, paths)
        te_before = temp_entities(api)
        ammo_before = carried_rounds(api, weapon)
        if fx_before is None or ammo_before is None:
            arm.skip("the weapon actually fired",
                     "a readout did not answer (rounds=%s, impact ledger=%s)"
                     % (ammo_before, fx_before))
            return arm.report()

        fire_at(g, SHORT_BURST)
        ammo_short = carried_rounds(api, weapon)
        fx_short = impact_ledger(api, paths)
        te_short = temp_entities(api)

        if ammo_short is None or ammo_short >= ammo_before:
            arm.skip("the weapon actually fired",
                     "carried rounds %s -> %s: the gun did not fire, so "
                     "nothing was measured about the impact path"
                     % (ammo_before, ammo_short))
            return arm.report()
        spent_short = ammo_before - ammo_short
        arm.ok("the weapon actually fired",
               "carried rounds %d -> %d (%d spent)"
               % (ammo_before, ammo_short, spent_short))

        draws_after = view_draws(api, scen)
        if draws_before is None or draws_after is None:
            arm.skip("the client is rendering at all",
                     "the client's crossing counters did not answer")
        elif draws_after <= draws_before:
            arm.skip("the client is rendering at all",
                     "effect-list draws %d -> %d: this client rendered no "
                     "frame, so a flat impact row says nothing about the "
                     "impact path" % (draws_before, draws_after))
        else:
            arm.ok("the client is rendering at all",
                   "effect-list draws %d -> %d (one per rendered frame)"
                   % (draws_before, draws_after))

        #------------------------------------------------------------------
        # 5a. THE EFFECT APPEARED -- the impact ledger MOVED.
        #------------------------------------------------------------------
        print("     crate %d, weapon %d; impact ledger %s -> %s; "
              "temp entities %s -> %s  %s"
              % (crate["index"], weapon, fx_before, fx_short,
                 te_before, te_short, box()), flush=True)
        if fx_short is None:
            arm.skip("the impact ledger MOVED",
                     "the impact rows did not answer after the burst")
            return arm.report()
        if fx_short <= fx_before:
            arm.bad("the impact ledger MOVED",
                    "the gun FIRED %d round(s) into a prop_physics and the "
                    "native impact ledger did not move (%d -> %d); the managed "
                    "temp-entity ledger read %s -> %s"
                    % (spent_short, fx_before, fx_short, te_before, te_short))
            return arm.report()
        arm.ok("the impact ledger MOVED",
               "%d -> %d particles on %d round(s)"
               % (fx_before, fx_short, spent_short))

        #------------------------------------------------------------------
        # 5b. AND IT SCALES WITH THE ROUNDS SPENT.
        #
        # This is the arm a counter ticking on some unrelated per-frame path
        # cannot pass: it has to rise MORE for a longer burst at the same
        # target, seconds later in the same process.
        #------------------------------------------------------------------
        per_round_short = (fx_short - fx_before) / float(spent_short)
        fire_at(g, LONG_BURST)
        ammo_long = carried_rounds(api, weapon)
        fx_long = impact_ledger(api, paths)
        if ammo_long is None or fx_long is None or ammo_long >= ammo_short:
            arm.skip("and the ledger SCALES with the rounds spent",
                     "the long burst did not answer (rounds %s -> %s, "
                     "ledger %s)" % (ammo_short, ammo_long, fx_long))
        else:
            spent_long = ammo_short - ammo_long
            drew_long = fx_long - fx_short
            print("     long burst: %d round(s), ledger %d -> %d"
                  % (spent_long, fx_short, fx_long), flush=True)
            if spent_long <= spent_short:
                arm.skip("and the ledger SCALES with the rounds spent",
                         "the long burst spent %d round(s) and the short one "
                         "spent %d -- no scaling to measure"
                         % (spent_long, spent_short))
            elif drew_long <= (fx_short - fx_before):
                arm.bad("and the ledger SCALES with the rounds spent",
                        "%d round(s) drew %d particle(s) and %d round(s) drew "
                        "%d: the ledger does not follow the trigger"
                        % (spent_short, fx_short - fx_before, spent_long,
                           drew_long))
            else:
                arm.ok("and the ledger SCALES with the rounds spent",
                       "%d round(s) -> %d particles (%.1f each), %d round(s) "
                       "-> %d (%.1f each)"
                       % (spent_short, fx_short - fx_before, per_round_short,
                          spent_long, drew_long,
                          drew_long / float(spent_long)))
            fx_short, ammo_short = fx_long, ammo_long

        #------------------------------------------------------------------
        # 5c. AND IT STAYS PUT WITH THE TRIGGER NOT PULLED.
        #
        # The same stand, the same gun, the same window, seconds later -- the
        # only thing varied is the trigger. This is the arm a row that ticks on
        # a frame path, a think, or a draw call cannot pass, and it is what the
        # hazard at the top of this file is actually about: `8f-movetypes` had a
        # broken observer whose counter grew exactly like a working build's.
        #------------------------------------------------------------------
        time.sleep(LONG_BURST + 2.5)
        fx_idle = impact_ledger(api, paths)
        ammo_idle = carried_rounds(api, weapon)
        print("     trigger not pulled for %.1fs: rounds %s -> %s, ledger "
              "%s -> %s" % (LONG_BURST, ammo_short, ammo_idle,
                            fx_short, fx_idle), flush=True)
        if fx_idle is None or ammo_idle is None:
            arm.skip("and it stays PUT with the trigger not pulled",
                     "a readout did not answer")
        elif ammo_idle != ammo_short:
            arm.skip("and it stays PUT with the trigger not pulled",
                     "carried rounds moved %s -> %s with no trigger, so the "
                     "window was not a quiet one" % (ammo_short, ammo_idle))
        elif fx_idle > fx_short:
            arm.bad("and it stays PUT with the trigger not pulled",
                    "the impact ledger rose %d -> %d over %.1fs with no round "
                    "fired; this row is not counting impacts"
                    % (fx_short, fx_idle, LONG_BURST))
        else:
            arm.ok("and it stays PUT with the trigger not pulled",
                   "%.1fs, no round spent, ledger %d -> %d"
                   % (LONG_BURST, fx_short, fx_idle))

        #------------------------------------------------------------------
        # 5d. AND THE ROW THAT MOVED IS THE RIGHT ONE.
        #
        # The target is a wooden crate, so what a shot into it draws is
        # FX_DebrisFlecks -- `impact flecks`. NOTHING in this run shot a
        # player, so `impact blood` must not have moved at all. A build that
        # lit every impact row on every impact passes every arm above and
        # fails this one.
        #------------------------------------------------------------------
        rows_end = impact_rows(api, paths)
        if rows_begin is None or rows_end is None:
            arm.skip("and the row that moved is the RIGHT one",
                     "the per-row readout did not answer")
        else:
            flecks = rows_end["impact flecks"] - rows_begin["impact flecks"]
            blood = rows_end["impact blood"] - rows_begin["impact blood"]
            print("     rows over the whole run: flecks +%d, dust +%d, "
                  "blood +%d"
                  % (flecks,
                     rows_end["impact dust"] - rows_begin["impact dust"],
                     blood), flush=True)
            if flecks <= 0:
                arm.bad("and the row that moved is the RIGHT one",
                        "a wooden crate was shot and `impact flecks` did not "
                        "move (+%d); FX_DebrisFlecks is what wood and cement "
                        "draw" % flecks)
            elif blood > 0:
                arm.bad("and the row that moved is the RIGHT one",
                        "`impact blood` rose +%d and nothing in this run shot "
                        "a player, so the rows are not telling impacts apart"
                        % blood)
            else:
                arm.ok("and the row that moved is the RIGHT one",
                       "flecks +%d from a wooden crate, blood +%d" % (flecks, blood))

        api.fire(PROP_NAME, "Kill")
    except lg.Skipped as exc:
        arm.skip("the run completed", str(exc))
    except Exception as exc:
        arm.skip("the run completed", "the api died: %s" % exc)
    finally:
        print("   %s" % box(), flush=True)
        if not keep:
            game.kill()
        else:
            print("== the game is left up, pid %s" % game.api.pid, flush=True)
    return arm.report()


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--keep", action="store_true",
                   help="leave the game running afterwards")
    args = p.parse_args()
    sys.exit(run(args.keep))


if __name__ == "__main__":
    main()

#!/usr/bin/env bash
# The AI's offline views (plan_hl2mp_ai §7.1, §7.3).
#
#   tools/ai-replay nav <map> [--config debug|release] [--scale px-per-unit]
#       draws the map's derived nav graph from above to
#       bin/<config>/ai-replay/<map>-nav.png (the per-tree nav: `make map MAP=<map>`)
#   tools/ai-replay heat <map> <recording.airec> [--every ticks] [--config ..] [--scale ..]
#       replays the recording with the brains remembering over the map's graph
#       and writes each bot's beliefs every N ticks (66) as
#       bin/<config>/ai-replay/<map>-heat/heat-bot<slot>-t<tick>.png
#   tools/ai-replay verify <map> <recording.airec> [--threads 0,1,2,4] [--config ..]
#       replays a recording made with ai_record over the map's graph with the
#       game's trees, inline (0) and on each pool size, and exits 1 unless
#       every replay gives the recording's intents byte for byte
#   tools/ai-replay metrics <recording.airec>... [--config ..]
#       prints the plan's §3.4.4 metrics per actor, humans' and bots' alike
#       (angular speed, flicks and their peaks, time to acquire, reaction,
#       strafe interval, yaw reversals); `ai_record human` writes the human
#       sessions to bin/<config>/mods/test/ai-recordings/human/
#   tools/ai-replay calibrate <hitrates.tsv> <probes.tsv> [--skills FILE] [--min-samples N]
#       the aimErrorDeg values at which the probes reach the file's hit rates
#       (tools/ai-aim-calibrate runs the probes; exits 2 if a target is out of reach)
#   tools/ai-replay hitrates <metrics.txt> <out.tsv>
#       a person's hit rate per band from `ai-replay metrics`' output, as a hit rate file
#   tools/ai-replay jank <recording.airec>... [--config ..]
#       prints what makes a bot look wrong, per actor and in total, people by
#       the same definitions (§3.4.5): stuck, wall bump, decision flips,
#       in-sight not firing by leaf, strafe interval, yaw reversals, idle; the
#       worst places of each; a headline score with its weights
#   tools/ai-replay style [--skills FILE]
#       over 500 drawn bots by difficulty: who holds a place, named campers apart,
#       and what each name's skill does, from the skills file (§10)
#   tools/ai-replay chokes <map> [--config ..] [--scale ..]
#       the map's choke points, busiest first with their places, and the graph with
#       them ringed at bin/<config>/ai-replay/<map>-chokes.png (§5.5)
#   tools/ai-replay tactics <map> <recording.airec>... [--config ..]
#       per bot, its camps (how long, how far from a pickup and a choke, kills
#       there) and its prefires (bursts a minute, rounds, hits, kills) (§5.4, §5.5)
#
# Builds src/ai/replay (SkiaSharp, a tool: never in the game's managed dir).
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dotnet="${DOTNET:-$HOME/.dotnet/dotnet}"
verb="${1:-}"
if [[ "$verb" == "hitrates" && -n "${3:-}" ]]; then
  "$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c Debug -v q --nologo >/dev/null
  exec "$dotnet" "$root/bin/debug/tools/ai-replay/SourceSharp.Ai.Replay.dll" hitrates "$(realpath "$2")" "$3"
fi
if [[ "$verb" == "calibrate" && -n "${3:-}" ]]; then
  rates="$(realpath "$2")"; probes="$(realpath "$3")"; shift 3
  skills="$root/game/mod_test/scripts/ai/hl2mp_skills.json"; min=50
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --skills) skills="$(realpath "$2")"; shift 2 ;;
      --min-samples) min="$2"; shift 2 ;;
      *) echo "ai-replay calibrate: what is $1?" >&2; exit 2 ;;
    esac
  done
  "$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c Debug -v q --nologo >/dev/null
  exec "$dotnet" "$root/bin/debug/tools/ai-replay/SourceSharp.Ai.Replay.dll" calibrate "$rates" "$probes" "$skills" "$min"
fi
if [[ "$verb" == style ]]; then
  skills="$root/game/mod_test/scripts/ai/hl2mp_skills.json"
  [[ "${2:-}" == "--skills" ]] && skills="$(realpath "$3")"
  "$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c Debug -v q --nologo >/dev/null
  exec "$dotnet" "$root/bin/debug/tools/ai-replay/SourceSharp.Ai.Replay.dll" style "$skills"
fi
[[ ( "$verb" =~ ^(nav|metrics|jank|chokes)$ && -n "${2:-}" ) || ( "$verb" =~ ^(heat|verify|tactics)$ && -n "${3:-}" ) ]] || { sed -n '2,40p' "$0"; exit 2; }
if [[ "$verb" == tactics ]]; then
  map="$2"; shift 2
  config=debug; recs=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config) config="$2"; shift 2 ;;
      *) [[ -f "$1" ]] || { echo "ai-replay: no recording $1" >&2; exit 1; }; recs+=("$(realpath "$1")"); shift ;;
    esac
  done
  maps="$root/bin/$config/mods/test/maps"
  cfg=Debug; [[ "$config" == release ]] && cfg=Release
  "$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c "$cfg" -v q --nologo >/dev/null
  exec "$dotnet" "$root/bin/$config/tools/ai-replay/SourceSharp.Ai.Replay.dll" tactics "$maps/$map.nav3d" "$maps/$map.bsp" "${recs[@]}"
fi
if [[ "$verb" =~ ^(metrics|jank)$ ]]; then
  shift
  config=debug; recs=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config) config="$2"; shift 2 ;;
      *) [[ -f "$1" ]] || { echo "ai-replay: no recording $1" >&2; exit 1; }; recs+=("$(realpath "$1")"); shift ;;
    esac
  done
  cfg=Debug; [[ "$config" == release ]] && cfg=Release
  "$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c "$cfg" -v q --nologo >/dev/null
  exec "$dotnet" "$root/bin/$config/tools/ai-replay/SourceSharp.Ai.Replay.dll" "$verb" "${recs[@]}"
fi
map="$2"; shift 2
recording=""
if [[ "$verb" =~ ^(heat|verify)$ ]]; then recording="$(realpath "$1")"; shift; fi
config=debug; scale=0.25; every=66; threads=0,1,2,4
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config) config="$2"; shift 2 ;;
    --scale) scale="$2"; shift 2 ;;
    --every) every="$2"; shift 2 ;;
    --threads) threads="$2"; shift 2 ;;
    *) echo "ai-replay: unknown argument $1" >&2; exit 2 ;;
  esac
done
maps="$root/bin/$config/mods/test/maps"
[[ -f "$maps/$map.nav3d" ]] || { echo "ai-replay: no $maps/$map.nav3d: make map MAP=$map" >&2; exit 1; }
out="$root/bin/$config/ai-replay"
mkdir -p "$out"
cfg=Debug; [[ "$config" == release ]] && cfg=Release
"$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c "$cfg" -v q --nologo >/dev/null
dll="$root/bin/$config/tools/ai-replay/SourceSharp.Ai.Replay.dll"
if [[ "$verb" == chokes ]]; then
  "$dotnet" "$dll" chokes "$maps/$map.nav3d" "$maps/$map.bsp" "$out/$map-chokes.png" "$scale"
elif [[ "$verb" == nav ]]; then
  "$dotnet" "$dll" nav "$maps/$map.nav3d" "$maps/$map.bsp" "$out/$map-nav.png" "$scale"
elif [[ "$verb" == verify ]]; then
  [[ -f "$recording" ]] || { echo "ai-replay: no recording $recording" >&2; exit 1; }
  exec "$dotnet" "$dll" verify "$maps/$map.nav3d" "$maps/$map.bsp" "$recording" "$threads"
else
  [[ -f "$recording" ]] || { echo "ai-replay: no recording $recording" >&2; exit 1; }
  "$dotnet" "$dll" heat "$maps/$map.nav3d" "$maps/$map.bsp" "$recording" "$out/$map-heat" "$every" "$scale"
fi

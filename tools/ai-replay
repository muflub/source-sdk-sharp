#!/usr/bin/env bash
# The AI's offline views (plan_hl2mp_ai §7.1, §7.3).
#
#   tools/ai-replay nav <map> [--config debug|release] [--scale px-per-unit]
#       draws the map's derived nav graph from above to
#       bin/<config>/ai-replay/<map>-nav.png (the per-tree nav: `make map MAP=<map>`)
#   tools/ai-replay heat <map> <recording.airec> [--every ticks] [--config ..] [--scale ..]
#       replays the recording with the brains remembering over the map's graph
#       and writes each bot's beliefs every N ticks (66) as
#       bin/<config>/ai-replay/<map>-heat/heat-bot<slot>-t<tick>.png
#   tools/ai-replay verify <map> <recording.airec> [--threads 0,1,2,4] [--config ..]
#       replays a recording made with ai_record over the map's graph with the
#       game's trees, inline (0) and on each pool size, and exits 1 unless
#       every replay gives the recording's intents byte for byte
#   tools/ai-replay metrics <recording.airec>... [--config ..]
#       prints the plan's §3.4.4 metrics per actor, humans' and bots' alike
#       (angular speed, flicks and their peaks, time to acquire, reaction,
#       strafe interval, yaw reversals); `ai_record human` writes the human
#       sessions to bin/<config>/mods/test/ai-recordings/human/
#   tools/ai-replay calibrate <hitrates.tsv> <probes.tsv> [--skills FILE] [--min-samples N]
#       the aimErrorDeg values at which the probes reach the file's hit rates
#       (tools/ai-aim-calibrate runs the probes; exits 2 if a target is out of reach)
#   tools/ai-replay hitrates <metrics.txt> <out.tsv>
#       a person's hit rate per band from `ai-replay metrics`' output, as a hit rate file
#   tools/ai-replay jank <recording.airec>... [--config ..]
#       prints what makes a bot look wrong, per actor and in total, people by
#       the same definitions (§3.4.5): stuck, wall bump, decision flips,
#       in-sight not firing by leaf, strafe interval, yaw reversals, idle; the
#       worst places of each; a headline score with its weights
#   tools/ai-replay threat <recording.airec>... [--config ..]
#       per bot, damage and kills a minute against people and everyone, shots and
#       second triggers a minute by weapon (§12.3, ruling 2026-11-03)
#   tools/ai-replay style [--skills FILE]
#       over 500 drawn bots by difficulty: who holds a place, named campers apart,
#       and what each name's skill does, from the skills file (§10)
#   tools/ai-replay chokes <map> [--config ..] [--scale ..]
#       the map's choke points, busiest first with their places, and the graph with
#       them ringed at bin/<config>/ai-replay/<map>-chokes.png (§5.5)
#   tools/ai-replay tactics <map> <recording.airec>... [--config ..]
#       per bot, its camps (how long, how far from a pickup and a choke, kills
#       there) and its prefires (bursts a minute, rounds, hits, kills) (§5.4, §5.5)
#   tools/ai-replay cost <map> <recording.airec> [--mod test|tf2] [--bodies -|tf2|N|class=N,..] [--passes 2] [--config ..]
#       where a decide's time goes: replays the recording on one thread through the
#       mod's own trees (test: HL2MP's) over the map's graph and prints each part of a
#       brain step in microseconds of thread CPU time a step (the memory's event
#       intake, its reading of the view, the ammo estimates, the beliefs' spread with
#       its hops, the fading; the decide: the tree and all it does beside it),
#       then the whole step by the session's own clock (the game's ai.brain.cpu.us).
#       The first pass warms the code up; the last is printed. A recording carries no
#       class, no objectives and no bodies: --bodies gives the believed runs back
#       (tf2: each class's, by the scoreboard's class; N: everybody's; -: the recording's
#       190 u/s), so one recording is timed at two beliefs.
#       The recording is build output, never in git: make one with the game's own
#         ai_record start <tree>/bin/<config>/ai-cost/<name>.airec <map>   (before the bots are added)
#         ai_bot_add (x12) ... ai_record stop
#       and a missing one is an error, not an empty table.
#   tools/ai-replay navsize <map> [--mod test|tf2] [--hull] [--stop open|leaves|derive|sight|cache] [--no-sight] [--config ..]
#       what the map's navigation costs a server to load: the file opened (the mod's
#       maps/<map>.nav3d, or with --hull its .navhull), read as leaves, the graph
#       derived by the mod's numbers, the sight table built, the graph cache encoded;
#       each step in seconds of thread CPU and wall time, with the managed heap after it
#       and the process's peak memory. --stop names the last step to run and --no-sight
#       leaves the sight table out, for a map too big for a step. The files are per-tree
#       build output (tools/ai-nav-build).
#   tools/ai-replay navrooms <map> [--mod tf2|test] [--largest N] [--derive REGION [--stop STEP] [--no-sight]] [--config ..]
#       the regions of connected free space in the map's .navhull and which hold its
#       spawns, teleports, teleport destinations, cabinets and capture areas (the N
#       largest listed too; 20); with --derive, what that one region costs to derive
#       alone, step by step as navsize says it (open|regions|region|derive|sight|cache).
#
# Builds src/ai/replay (SkiaSharp, a tool: never in the game's managed dir).
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dotnet="${DOTNET:-$HOME/.dotnet/dotnet}"
verb="${1:-}"
# Bot chat's measures (plan_hl2mp_ai §3.6), against the private model of tools/ai-chat-model:
#   tools/ai-replay chat-truth <out.md>          a hundred questions, graded against the map
#   tools/ai-replay chat-eval <console.log> <out.md> <lines> <model>...   lines from real kills
#   tools/ai-replay chat-places                  what every item's place on dm_lockdown reads as
if [[ "$verb" =~ ^chat-(truth|eval|places)$ ]]; then
  "$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c Debug -v q --nologo >/dev/null
  dll="$root/bin/debug/tools/ai-replay/SourceSharp.Ai.Replay.dll"
  maps="$root/bin/debug/mods/test/maps"
  scripts="$root/game/mod_test/scripts/ai"
  url="${AI_CHAT_URL:-http://127.0.0.1:11435}"
  case "$verb" in
    chat-truth) exec "$dotnet" "$dll" chat-truth "$url" "$maps/dm_lockdown.nav3d" "$maps/dm_lockdown.bsp" "$scripts/hl2mp_help.json" "$scripts/hl2mp_chat.json" "$2" "${AI_CHAT_MODEL:-llama3.2:3b}" ;;
    chat-eval) exec "$dotnet" "$dll" chat-eval "$url" "$2" "$scripts/hl2mp_chat.json" "$3" "$4" "${@:5}" ;;
    chat-places) exec "$dotnet" "$dll" chat-places "$maps/dm_lockdown.nav3d" "$maps/dm_lockdown.bsp" "$scripts/hl2mp_help.json" ;;
  esac
fi
if [[ "$verb" == "hitrates" && -n "${3:-}" ]]; then
  "$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c Debug -v q --nologo >/dev/null
  exec "$dotnet" "$root/bin/debug/tools/ai-replay/SourceSharp.Ai.Replay.dll" hitrates "$(realpath "$2")" "$3"
fi
if [[ "$verb" == "calibrate" && -n "${3:-}" ]]; then
  rates="$(realpath "$2")"; probes="$(realpath "$3")"; shift 3
  skills="$root/game/mod_test/scripts/ai/hl2mp_skills.json"; min=50
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --skills) skills="$(realpath "$2")"; shift 2 ;;
      --min-samples) min="$2"; shift 2 ;;
      *) echo "ai-replay calibrate: what is $1?" >&2; exit 2 ;;
    esac
  done
  "$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c Debug -v q --nologo >/dev/null
  exec "$dotnet" "$root/bin/debug/tools/ai-replay/SourceSharp.Ai.Replay.dll" calibrate "$rates" "$probes" "$skills" "$min"
fi
if [[ "$verb" == style ]]; then
  skills="$root/game/mod_test/scripts/ai/hl2mp_skills.json"
  [[ "${2:-}" == "--skills" ]] && skills="$(realpath "$3")"
  "$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c Debug -v q --nologo >/dev/null
  exec "$dotnet" "$root/bin/debug/tools/ai-replay/SourceSharp.Ai.Replay.dll" style "$skills"
fi
[[ ( "$verb" =~ ^(nav|metrics|jank|threat|chokes|navsize|navrooms)$ && -n "${2:-}" ) || ( "$verb" =~ ^(heat|verify|tactics|cost)$ && -n "${3:-}" ) ]] || { sed -n '2,69p' "$0"; exit 2; }
if [[ "$verb" == navsize ]]; then
  map="$2"; shift 2
  config=debug; mod=test; ext=nav3d; stop=cache; sight=sight
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config) config="$2"; shift 2 ;;
      --mod) mod="$2"; shift 2 ;;
      --hull) ext=navhull; shift ;;
      --stop) stop="$2"; shift 2 ;;
      --no-sight) sight=no-sight; shift ;;
      *) echo "ai-replay navsize: what is $1?" >&2; exit 2 ;;
    esac
  done
  case "$mod" in
    test) game=hl2mp; dirs=("$root/bin/$config/mods/test/maps") ;;
    tf2) game=tf2; dirs=("$root/bin/$config/mods/tf2/maps" "$root/bin/$config/content/tf/maps" "$root/bin/$config/content/tf/download/maps") ;;
    *) echo "ai-replay navsize: no numbers for the mod $mod (test or tf2)" >&2; exit 2 ;;
  esac
  nav="$root/bin/$config/mods/$mod/maps/$map.$ext"; bsp=""
  for d in "${dirs[@]}"; do [[ -z "$bsp" && -f "$d/$map.bsp" ]] && bsp="$d/$map.bsp"; done
  [[ -f "$nav" ]] || { echo "ai-replay: no $nav: build it with tools/ai-nav-build $map --mod $mod$([[ $ext == navhull ]] && echo ' --hull')" >&2; exit 1; }
  [[ -n "$bsp" ]] || { echo "ai-replay: no $map.bsp in ${dirs[*]}" >&2; exit 1; }
  cfg=Debug; [[ "$config" == release ]] && cfg=Release
  "$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c "$cfg" -v q --nologo >/dev/null
  exec "$dotnet" "$root/bin/$config/tools/ai-replay/SourceSharp.Ai.Replay.dll" navsize "$game" "$nav" "$bsp" "$stop" "$sight"
fi
if [[ "$verb" == navrooms ]]; then
  map="$2"; shift 2
  config=debug; mod=tf2; what=(rooms)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config) config="$2"; shift 2 ;;
      --mod) mod="$2"; shift 2 ;;
      --largest) what=(rooms "$2"); shift 2 ;;
      --derive) what=(derive "$2" cache sight); shift 2 ;;
      --stop) what[2]="$2"; shift 2 ;;
      --no-sight) what[3]=no-sight; shift ;;
      *) echo "ai-replay navrooms: what is $1?" >&2; exit 2 ;;
    esac
  done
  case "$mod" in
    test) game=hl2mp; dirs=("$root/bin/$config/mods/test/maps") ;;
    tf2) game=tf2; dirs=("$root/bin/$config/mods/tf2/maps" "$root/bin/$config/content/tf/maps" "$root/bin/$config/content/tf/download/maps") ;;
    *) echo "ai-replay navrooms: no numbers for the mod $mod (test or tf2)" >&2; exit 2 ;;
  esac
  nav="$root/bin/$config/mods/$mod/maps/$map.navhull"; bsp=""
  for d in "${dirs[@]}"; do [[ -z "$bsp" && -f "$d/$map.bsp" ]] && bsp="$d/$map.bsp"; done
  [[ -f "$nav" ]] || { echo "ai-replay: no $nav: build it with tools/ai-nav-build $map --mod $mod --hull" >&2; exit 1; }
  [[ -n "$bsp" ]] || { echo "ai-replay: no $map.bsp in ${dirs[*]}" >&2; exit 1; }
  cfg=Debug; [[ "$config" == release ]] && cfg=Release
  "$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c "$cfg" -v q --nologo >/dev/null
  exec "$dotnet" "$root/bin/$config/tools/ai-replay/SourceSharp.Ai.Replay.dll" navrooms "$game" "$nav" "$bsp" "${what[@]}"
fi
if [[ "$verb" == cost ]]; then
  map="$2"; recording="$3"; shift 3
  config=debug; mod=test; bodies=-; passes=2
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config) config="$2"; shift 2 ;;
      --mod) mod="$2"; shift 2 ;;
      --bodies) bodies="$2"; shift 2 ;;
      --passes) passes="$2"; shift 2 ;;
      *) echo "ai-replay cost: what is $1?" >&2; exit 2 ;;
    esac
  done
  case "$mod" in
    test) game=hl2mp; nav="$root/bin/$config/mods/test/maps/$map.nav3d"; bsp="$root/bin/$config/mods/test/maps/$map.bsp" ;;
    tf2) game=tf2; nav="$root/bin/$config/mods/tf2/maps/$map.nav3d"; bsp="$root/bin/$config/content/tf/maps/$map.bsp"
         [[ -f "$bsp" ]] || bsp="$root/bin/$config/mods/tf2/maps/$map.bsp" ;;
    *) echo "ai-replay cost: no trees for the mod $mod (test or tf2)" >&2; exit 2 ;;
  esac
  [[ -f "$recording" ]] || { echo "ai-replay: no recording $recording: it is build output, made with ai_record (tools/ai-replay's header says how)" >&2; exit 1; }
  [[ -f "$nav" ]] || { echo "ai-replay: no $nav: build the map's nav first" >&2; exit 1; }
  cfg=Debug; [[ "$config" == release ]] && cfg=Release
  "$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c "$cfg" -v q --nologo >/dev/null
  exec "$dotnet" "$root/bin/$config/tools/ai-replay/SourceSharp.Ai.Replay.dll" cost "$game" "$nav" "$bsp" "$(realpath "$recording")" "$bodies" "$passes"
fi
if [[ "$verb" == tactics ]]; then
  map="$2"; shift 2
  config=debug; recs=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config) config="$2"; shift 2 ;;
      *) [[ -f "$1" ]] || { echo "ai-replay: no recording $1" >&2; exit 1; }; recs+=("$(realpath "$1")"); shift ;;
    esac
  done
  maps="$root/bin/$config/mods/test/maps"
  cfg=Debug; [[ "$config" == release ]] && cfg=Release
  "$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c "$cfg" -v q --nologo >/dev/null
  exec "$dotnet" "$root/bin/$config/tools/ai-replay/SourceSharp.Ai.Replay.dll" tactics "$maps/$map.nav3d" "$maps/$map.bsp" "${recs[@]}"
fi
if [[ "$verb" =~ ^(metrics|jank|threat)$ ]]; then
  shift
  config=debug; recs=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config) config="$2"; shift 2 ;;
      *) [[ -f "$1" ]] || { echo "ai-replay: no recording $1" >&2; exit 1; }; recs+=("$(realpath "$1")"); shift ;;
    esac
  done
  cfg=Debug; [[ "$config" == release ]] && cfg=Release
  "$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c "$cfg" -v q --nologo >/dev/null
  exec "$dotnet" "$root/bin/$config/tools/ai-replay/SourceSharp.Ai.Replay.dll" "$verb" "${recs[@]}"
fi
map="$2"; shift 2
recording=""
if [[ "$verb" =~ ^(heat|verify)$ ]]; then recording="$(realpath "$1")"; shift; fi
config=debug; scale=0.25; every=66; threads=0,1,2,4
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config) config="$2"; shift 2 ;;
    --scale) scale="$2"; shift 2 ;;
    --every) every="$2"; shift 2 ;;
    --threads) threads="$2"; shift 2 ;;
    *) echo "ai-replay: unknown argument $1" >&2; exit 2 ;;
  esac
done
maps="$root/bin/$config/mods/test/maps"
[[ -f "$maps/$map.nav3d" ]] || { echo "ai-replay: no $maps/$map.nav3d: make map MAP=$map" >&2; exit 1; }
out="$root/bin/$config/ai-replay"
mkdir -p "$out"
cfg=Debug; [[ "$config" == release ]] && cfg=Release
"$dotnet" build "$root/src/ai/replay/SourceSharp.Ai.Replay.csproj" -c "$cfg" -v q --nologo >/dev/null
dll="$root/bin/$config/tools/ai-replay/SourceSharp.Ai.Replay.dll"
if [[ "$verb" == chokes ]]; then
  "$dotnet" "$dll" chokes "$maps/$map.nav3d" "$maps/$map.bsp" "$out/$map-chokes.png" "$scale"
elif [[ "$verb" == nav ]]; then
  "$dotnet" "$dll" nav "$maps/$map.nav3d" "$maps/$map.bsp" "$out/$map-nav.png" "$scale"
elif [[ "$verb" == verify ]]; then
  [[ -f "$recording" ]] || { echo "ai-replay: no recording $recording" >&2; exit 1; }
  exec "$dotnet" "$dll" verify "$maps/$map.nav3d" "$maps/$map.bsp" "$recording" "$threads"
else
  [[ -f "$recording" ]] || { echo "ai-replay: no recording $recording" >&2; exit 1; }
  "$dotnet" "$dll" heat "$maps/$map.nav3d" "$maps/$map.bsp" "$recording" "$out/$map-heat" "$every" "$scale"
fi

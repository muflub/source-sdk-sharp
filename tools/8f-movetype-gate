#=============================================================================
# THE PREDICATES, DEFINED ONCE. --self-test drives THESE, not copies of them:
# a self-test over a second copy tests the copy and lets the real one drift
# under a green light, which is how an earlier gate in this tree announced
# "ok" over a window in which nothing was measured.
#=============================================================================
def distance(a, b):
    return math.sqrt(sum((x - y) ** 2 for x, y in zip(a, b)))


def grew(before, after):
    """A counter that really advanced. A blank reading is NOT growth."""
    if before is None or after is None:
        return False
    return after > before


def numeric(x):
    """A reading, as opposed to a console command whose output never arrived.
    Two runs of the sibling gate were thrown away for want of this."""
    return isinstance(x, int)


def parse_move_total(text):
    """The forwarder's own counter line. Returns None when there is no line --
    NEVER 0, which would make a dead gate look green."""
    found = None
    for line in text.splitlines():
        if "movemath(" in line and "managed call" in line:
            try:
                found = int(line.split(":")[-1].strip().split()[0])
            except (ValueError, IndexError):
                continue
    return found


def fell(before_z, after_z, at_least):
    return before_z is not None and after_z is not None and (before_z - after_z) >= at_least


def held_height(before_z, after_z, within):
    return before_z is not None and after_z is not None and abs(before_z - after_z) <= within


#=============================================================================
def self_test():
    n = [0]
    bad = [0]

    def eq(what, got, want):
        n[0] += 1
        if got == want:
            print("  ok    %s -> %r" % (what, got))
        else:
            bad[0] += 1
            print("  FAIL  %s: expected %r, got %r" % (what, want, got))

    def yes(what, got):
        eq(what, bool(got), True)

    def no(what, got):
        eq(what, bool(got), False)

    print("== 8f-movetype-gate --self-test")

    eq("the counter line parses",
       parse_move_total("[SourceSharp] movemath(server): 16183 managed call(s) total"),
       16183)
    eq("a zero counter parses AS ZERO and not as nothing",
       parse_move_total("[SourceSharp] movemath(server): 0 managed call(s) total"), 0)
    eq("the newest line wins",
       parse_move_total("[SourceSharp] movemath(server): 111 managed call(s) total\n"
                        "[SourceSharp] movemath(server): 222 managed call(s) total"), 222)
    eq("no line at all parses to None, not to zero",
       parse_move_total("nothing to see here"), None)

    yes("grew(10, 20)", grew(10, 20))
    no("grew(20, 20) is not growth", grew(20, 20))
    no("grew(20, 10) is not growth", grew(20, 10))
    no("a missing BEFORE is not growth", grew(None, 20))
    no("a missing AFTER is not growth", grew(10, None))

    yes("numeric(0)", numeric(0))
    no("numeric(None)", numeric(None))
    no("numeric('12') -- a string is not a reading", numeric("12"))

    # The two air predicates, which are the fly/flygravity pair.
    yes("a 40-unit drop is a fall", fell(78.0, 30.0, 40.0))
    no("a 2-unit drop is not a fall", fell(78.0, 76.0, 40.0))
    no("a fall with no reading is not a fall", fell(78.0, None, 40.0))
    yes("holding 78 -> 77.5 is holding height", held_height(78.0, 77.5, 2.0))
    no("holding 78 -> 30 is not holding height", held_height(78.0, 30.0, 2.0))
    no("holding with no reading is not holding", held_height(None, 77.5, 2.0))

    # ARM F's TWO PREDICATES, added when arm 7 was retired at step 8f-remove.
    #
    # process_state is read straight out of /proc, so it is driven against the
    # two ends this machine can actually produce: this very process, and a pid
    # that cannot exist. There is no zombie fixture, and that is deliberate --
    # the first attempt at one in tools/movemath-gate made a real zombie and
    # then could not read it, because the shell reaps its own children before
    # the fixture gets there. The Z mapping is checked as a mapping instead, by
    # the parser test below over a synthetic stat line.
    yes("this process reads as running", process_is_running(os.getpid()))
    with open("/proc/sys/kernel/pid_max") as fh:
        dead = int(fh.read().strip()) - 1
    eq("a pid that cannot exist reads gone", process_state(dead), "gone")
    no("and it is not a running process", process_is_running(dead))

    # THE FIELD-3 PARSE, which is where a stat reader goes wrong. Field 2 is the
    # executable name IN PARENTHESES, so a name containing a space or a bracket
    # shifts every field after it -- splitting on whitespace reads the wrong
    # column and calls a live process a zombie or the reverse.
    def state_of(raw):
        close = raw.rfind(")")
        rest = raw[close + 1:].split()
        return "zombie" if rest and rest[0] == "Z" else (rest[0] if rest else "gone")

    eq("a plain stat line reads its state", state_of("42 (hl2_linux64) R 1 42 42"), "R")
    eq("a Z state is a zombie", state_of("42 (hl2_linux64) Z 1 42 42"), "zombie")
    eq("a name WITH A SPACE does not shift the field",
       state_of("42 (hl2 linux64) S 1 42 42"), "S")
    eq("a name WITH A BRACKET does not shift it either",
       state_of("42 (hl2) (64)) D 1 42 42"), "D")

    # THE PAIR ITSELF. The point of the fly/flygravity arms is that ONE build
    # can satisfy at most one of these two, so the do-nothing build -- which
    # hangs in both -- and the fell-through-to-walk build -- which falls in
    # both -- are each refused by exactly one half.
    def verdict(fly_z, grav_z):
        return (held_height(AIR_Z, fly_z, 2.0), fell(AIR_Z, grav_z, 40.0))

    eq("a working port: fly hangs AND flygravity falls",
       verdict(77.9, 20.0), (True, True))
    eq("a do-nothing arm hangs in BOTH, so the fall half refuses it",
       verdict(77.9, 77.9), (True, False))
    eq("a fall-through to MOVETYPE_WALK falls in BOTH, so the hang half refuses it",
       verdict(20.0, 20.0), (False, True))

    eq("distance is euclidean", round(distance((0, 0, 0), (3, 4, 0)), 6), 5.0)

    print()
    if bad[0] == 0:
        print("== SELF-TEST PASSED (%d check(s))" % n[0])
        return 0
    print("== SELF-TEST FAILED (%d of %d)" % (bad[0], n[0]))
    return 1


#=============================================================================
# IS THE PROCESS STILL THERE? READ /proc, NEVER os.kill(pid, 0).
#
# tools/movemath-gate had this bug and one live run found it: an unreaped child
# answers a zero-signal exactly like a live process, so "dead" and "alive" were
# the same reading. /proc/PID/stat field 3 tells them apart -- 'Z' is a corpse
# nobody has reaped, no entry at all is gone, anything else is still there. It
# works for a child and for a stranger alike.
#
# Field 3 is read by finding the LAST ')' rather than splitting on spaces,
# because field 2 is the executable name in parentheses and a name with a space
# or a bracket in it shifts every field after it.
def process_state(pid):
    try:
        with open("/proc/%d/stat" % int(pid)) as fh:
            raw = fh.read()
    except (OSError, ValueError):
        return "gone"
    close = raw.rfind(")")
    if close < 0:
        return "gone"
    rest = raw[close + 1:].split()
    if not rest:
        return "gone"
    return "zombie" if rest[0] == "Z" else rest[0]


def process_is_running(pid):
    return process_state(pid) not in ("gone", "zombie")


def count_fatals():
    """How many times the movement fatal has been printed. A COUNT and not a
    boolean: console.log is appended to across runs, so "is it in there" would
    be answered by a fatal from an hour ago."""
    n = 0
    for path in (LOG, CONSOLE_LOG):
        try:
            with open(path, errors="replace") as fh:
                for line in fh:
                    if "FATAL: the " in line and "side was asked to move a player" in line:
                        n += 1
        except OSError:
            pass
    return n


#=============================================================================
class Gate(object):
    def __init__(self, pid):
        self.pid = pid
        self.failures = 0
        self.checks = 0

    def check(self, ok, what):
        self.checks += 1
        if ok:
            print("  ok    %s" % what)
        else:
            self.failures += 1
            print("  FAIL  %s" % what)

    def say(self, what):
        print("        %s" % what)

    #-- the wire ------------------------------------------------------------
    def debug_api(self, *args):
        env = dict(os.environ)
        env["DEBUG_API_PID"] = str(self.pid)
        env["DEBUG_API_DIR"] = SOCKET_DIR
        out = subprocess.run([os.path.join(ROOT, "tools", "debug-api")] + list(args),
                             capture_output=True, text=True, env=env, timeout=60)
        return out.stdout

    def cmd(self, text):
        self.debug_api("cmd", text)

    def origin(self):
        try:
            ents = json.loads(self.debug_api("ents", PLAYER_CLASS))
        except (ValueError, subprocess.SubprocessError):
            return None
        rows = ents.get("entities", ents) if isinstance(ents, dict) else ents
        if not rows:
            return None
        row = min(rows, key=lambda e: e["index"])
        return tuple(row["origin"])

    def move_total(self):
        """The NATIVE forwarder's count of managed movement commands. It is the
        only place that can tell "the managed body RAN" from "the managed body
        was asked for"."""
        self.cmd("cs_sv_move_managed_report")
        time.sleep(1.0)
        text = ""
        for path in (LOG, CONSOLE_LOG):
            try:
                with open(path, errors="replace") as fh:
                    text += fh.read()
            except OSError:
                pass
        return parse_move_total(text)

    #-- the scenario --------------------------------------------------------
    def place(self, z):
        self.cmd("setpos %d %d %d" % (OPEN_FLOOR[0], OPEN_FLOOR[1], z))
        self.cmd("setang %d %d %d" % OPEN_FLOOR_ANGLES)
        time.sleep(0.6)

    def set_movetype(self, movetype, obsmode=0):
        self.cmd("ss8f_obsmode %d" % obsmode)
        self.cmd("ss8f_movetype %d" % movetype)
        time.sleep(0.5)

    def drive(self, seconds=0.9):
        """Hold +forward and sample DURING the hold as well as across it. A
        mid-hold displacement cannot be satisfied by a settle, by a fall, or by
        a player who was already somewhere else."""
        before = self.origin()
        self.cmd("+forward")
        mid_a = self.origin()
        time.sleep(seconds)
        mid_b = self.origin()
        self.cmd("-forward")
        time.sleep(0.4)
        after = self.origin()
        flat = lambda a, b: (distance((a[0], a[1], 0), (b[0], b[1], 0))
                             if a and b else 0.0)
        return flat(before, after), flat(mid_a, mid_b), after


#=============================================================================
def pick_game_pid(known):
    best = None
    try:
        now = sorted(p for p in os.listdir(SOCKET_DIR) if p.endswith(".sock"))
    except OSError:
        return None
    for name in now:
        if name in known:
            continue
        pid = name[:-5]
        env = dict(os.environ)
        env["DEBUG_API_PID"] = pid
        env["DEBUG_API_DIR"] = SOCKET_DIR
        r = subprocess.run([os.path.join(ROOT, "tools", "debug-api"), "status"],
                           capture_output=True, env=env)
        if r.returncode == 0:
            best = pid
    return best


def box(label):
    """pgrep -c EXITS 1 AND PRINTS 0 when there is nothing, so `|| echo 0`
    emits TWO zeroes. Counted in python instead."""
    r = subprocess.run(["pgrep", "-x", "hl2_linux64"], capture_output=True, text=True)
    games = len([l for l in r.stdout.split() if l.strip()])
    free = subprocess.run(["free", "-g"], capture_output=True, text=True).stdout
    mem = [l for l in free.splitlines() if l.startswith("Mem:")]
    print("== box %s: %d hl2_linux64 running; %s" % (label, games, mem[0] if mem else "?"))
    return games


def main():
    if "--self-test" in sys.argv:
        return self_test()

    keep = "--keep" in sys.argv

    if not os.path.exists(os.path.join(ROOT, ".8f-probe-saved")):
        print("== tools/8f-probe-movetypes is NOT applied. The three move types are")
        print("   unreachable without it and this gate would measure a player who")
        print("   never entered any of them. Apply it, rebuild, and run again.")
        return 2

    os.makedirs(SOCKET_DIR, exist_ok=True)
    known = set(p for p in os.listdir(SOCKET_DIR) if p.endswith(".sock"))
    run_tmp = "/tmp/sourcesharp-8f-gate-%d" % os.getpid()
    os.makedirs(run_tmp, exist_ok=True)

    box("before")

    print("== launching %s (log: %s)" % (MAP, LOG))
    launch = ('. "%s/tools/gpu-offload" && cd "%s" && '
              'TMPDIR="%s" DEBUG_API_DIR="%s" %s '
              '-debugapi -debugapisocket -condebug -nomessagebox -nocrashdialog '
              '-assertlog -novid -windowed -w 640 -h 480 %s +map %s'
              % (ROOT, GAME_DIR, run_tmp, SOCKET_DIR,
                 "./'source#'", " ".join(local_launch.local_args()), MAP))
    with open(LOG, "w") as fh:
        proc = subprocess.Popen(["bash", "-c", launch], stdout=fh,
                                stderr=subprocess.STDOUT, start_new_session=True)

    pid = None
    try:
        for _ in range(180):
            pid = pick_game_pid(known)
            if pid:
                break
            time.sleep(1)
        time.sleep(14)
        pid = pick_game_pid(known) or pid

        if not pid:
            print("== NO SOCKET. Read %s, and its 'Device :' line first." % LOG)
            return 1

        print("== game pid %s" % pid)
        g = Gate(pid)
        rc = run_arms(g)
    finally:
        if not keep:
            try:
                os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
            except OSError:
                pass
            proc.wait(timeout=30)
        shutil.rmtree(run_tmp, ignore_errors=True)
        box("after")

    return rc


def run_arms(g):
    # ss8f_* and setpos are FCVAR_CHEAT, and a cheat command at sv_cheats 0
    # reports success and does nothing -- which reads exactly like a move type
    # that was never entered.
    g.cmd("sv_cheats 1")
    g.cmd("sourcesharp_movement_managed 1")
    time.sleep(1.0)

    if g.origin() is None:
        print("  FAIL  no player in the map -- nothing below would mean anything")
        return 1

    #-- 1. the harness itself measures something ---------------------------
    print("\n== 1. control: MOVETYPE_WALK, the arm that was never refused")
    g.set_movetype(0)
    g.place(0)
    walk_moved, walk_mid, _ = g.drive()
    walk_before = g.move_total()
    g.drive()
    walk_after = g.move_total()
    g.say("walked %.1f units (%.1f mid-hold); counter %s -> %s"
          % (walk_moved, walk_mid, walk_before, walk_after))
    g.check(walk_moved > 32.0, "the harness can see a player move at all (%.1f units)" % walk_moved)
    g.check(numeric(walk_before) and numeric(walk_after),
            "and the movement counter is a READING, not a blank line")
    g.check(grew(walk_before, walk_after),
            "and the managed loop ran those commands (%s -> %s)" % (walk_before, walk_after))

    #-- 2. MOVETYPE_FLY ----------------------------------------------------
    print("\n== 2. MOVETYPE_FLY (4) -- FullTossMove, no gravity, no friction")
    g.set_movetype(MOVETYPE_FLY)
    g.place(AIR_Z)
    time.sleep(1.4)
    fly_z = g.origin()[2]
    g.say("dropped into the air at z=%d, one and a half seconds later z=%.2f" % (AIR_Z, fly_z))
    g.check(held_height(AIR_Z, fly_z, 2.0),
            "a MOVETYPE_FLY player HOLDS ITS HEIGHT in mid-air (%.2f -> %.2f). "
            "MOVETYPE_WALK falls here, and so does MOVETYPE_FLYGRAVITY below"
            % (AIR_Z, fly_z))

    fly_before = g.move_total()
    fly_moved, fly_mid, _ = g.drive()
    fly_after = g.move_total()
    g.say("flew %.1f units (%.1f mid-hold); counter %s -> %s"
          % (fly_moved, fly_mid, fly_before, fly_after))
    g.check(fly_moved > 32.0,
            "AND IT MOVES: +forward flew the player %.1f units" % fly_moved)
    g.check(fly_mid > 8.0,
            "and they were still moving mid-hold (%.1f units between two samples), "
            "which is zero for a player who settled or was teleported" % fly_mid)
    g.check(grew(fly_before, fly_after),
            "and the MANAGED loop is what flew them (%s -> %s)" % (fly_before, fly_after))

    # FullTossMove calls no Friction() at all -- the signature no other arm has.
    #
    # PLACED AGAIN FIRST, and the hold is short. The drive above flies at the
    # player's full max speed with nothing bleeding it, so it ends against the
    # yard's far wall about 354 units along +Y -- where the velocity has been
    # clipped into the plane and there is nothing left to coast. The first run
    # of this gate measured exactly that and read 0.0: a real reading of a
    # player who had already arrived, not of an arm that does not coast.
    g.place(AIR_Z)
    g.cmd("+forward")
    time.sleep(0.3)
    g.cmd("-forward")
    time.sleep(0.25)
    coast_a = g.origin()
    time.sleep(0.5)
    coast_b = g.origin()
    coast = distance((coast_a[0], coast_a[1], 0), (coast_b[0], coast_b[1], 0)) if coast_a and coast_b else 0.0
    g.say("coasted %.1f units in the half second AFTER the key was released" % coast)
    g.check(coast > 8.0,
            "and a released flier COASTS (%.1f units with no input): FullTossMove "
            "applies no friction, where every walking arm stops within a frame or two" % coast)

    #-- 3. MOVETYPE_FLYGRAVITY --------------------------------------------
    print("\n== 3. MOVETYPE_FLYGRAVITY (5) -- the same body plus one AddGravity")
    g.set_movetype(MOVETYPE_FLYGRAVITY)
    g.place(AIR_Z)
    grav_before = g.move_total()
    time.sleep(1.4)
    grav_z = g.origin()[2]
    grav_after = g.move_total()
    g.say("dropped into the air at z=%d, one and a half seconds later z=%.2f" % (AIR_Z, grav_z))
    g.check(fell(AIR_Z, grav_z, 40.0),
            "a MOVETYPE_FLYGRAVITY player FALLS (%.2f -> %.2f, %.1f units) where the "
            "MOVETYPE_FLY player above held its height. Same map, same spot, same "
            "command: the difference is the one line that separates the two types"
            % (AIR_Z, grav_z, AIR_Z - grav_z))
    g.check(grew(grav_before, grav_after),
            "and the MANAGED loop is what dropped them (%s -> %s)" % (grav_before, grav_after))

    # DRIVEN IN THE AIR, at a gentler gravity. On the ground a
    # MOVETYPE_FLYGRAVITY player with MOVECOLLIDE_DEFAULT cannot move AT ALL,
    # and that is stock: every command accelerates it, PushEntity puts it
    # straight back into the floor, and PerformFlyCollisionResolution's
    # `vel < 900 || collide != FLY_BOUNCE` arm zeroes the velocity again. The
    # first run of this gate asserted a drive after the fall above had already
    # landed the player, and read 0.0 -- a true reading of stock behaviour
    # against a wrong expectation. sv_gravity 100 keeps them airborne for the
    # whole hold; it is restored immediately after.
    g.cmd("sv_gravity 100")
    g.place(AIR_Z)
    fg_before = g.move_total()
    fg_moved, fg_mid, _ = g.drive()
    fg_after = g.move_total()
    g.cmd("sv_gravity 600")
    g.say("flew %.1f units (%.1f mid-hold); counter %s -> %s"
          % (fg_moved, fg_mid, fg_before, fg_after))
    g.check(fg_moved > 32.0,
            "AND IT MOVES UNDER INPUT TOO: +forward moved the airborne flygravity "
            "player %.1f units. On the ground it cannot move, and that is stock -- "
            "see the comment above" % fg_moved)
    g.check(grew(fg_before, fg_after),
            "and the MANAGED loop is what moved them (%s -> %s)" % (fg_before, fg_after))

    #-- 4. MOVETYPE_OBSERVER, roaming -------------------------------------
    print("\n== 4. MOVETYPE_OBSERVER (10), OBS_MODE_ROAMING, sv_specnoclip 1")
    g.cmd("sv_specnoclip 1")
    g.set_movetype(MOVETYPE_OBSERVER, OBS_MODE_ROAMING)
    g.place(AIR_Z)
    roam_before = g.move_total()
    roam_moved, roam_mid, _ = g.drive()
    roam_after = g.move_total()
    g.say("roamed %.1f units (%.1f mid-hold); counter %s -> %s"
          % (roam_moved, roam_mid, roam_before, roam_after))
    g.check(roam_moved > 16.0,
            "A ROAMING OBSERVER MOVES: +forward moved them %.1f units. This is the "
            "one the trap is about -- an observer who cannot move looks exactly like "
            "a player standing still" % roam_moved)
    g.check(roam_mid > 4.0,
            "and they were still moving mid-hold (%.1f units)" % roam_mid)
    g.check(grew(roam_before, roam_after),
            "and the MANAGED loop ran it (%s -> %s)" % (roam_before, roam_after))

    print("\n== 5. the same, sv_specnoclip 0 -- the CLIPPED free roam this step ported")
    g.cmd("sv_specnoclip 0")
    time.sleep(0.6)
    g.place(AIR_Z)
    clip_before = g.move_total()
    clip_moved, clip_mid, _ = g.drive()
    clip_after = g.move_total()
    g.say("roamed %.1f units (%.1f mid-hold); counter %s -> %s"
          % (clip_moved, clip_mid, clip_before, clip_after))
    g.check(clip_moved > 16.0,
            "the CLIPPED roam moves too (%.1f units) -- this arm is FullObserverMove's "
            "own body and not the FullNoClipMove it delegates to above" % clip_moved)
    g.check(grew(clip_before, clip_after),
            "and the MANAGED loop ran it (%s -> %s)" % (clip_before, clip_after))

    #-- 6. THE OTHER HALF OF THE PAIR -------------------------------------
    print("\n== 6. MOVETYPE_OBSERVER, OBS_MODE_FIXED -- the arm that must NOT move")
    g.set_movetype(MOVETYPE_OBSERVER, OBS_MODE_FIXED)
    g.place(AIR_Z)
    fixed_moved, fixed_mid, fixed_after = g.drive()
    g.say("moved %.1f units under +forward (%.1f mid-hold), z=%.2f"
          % (fixed_moved, fixed_mid, fixed_after[2] if fixed_after else -1))
    g.check(fixed_moved < 4.0,
            "a FIXED-cam observer does NOT move under +forward (%.1f units). Same move "
            "type, same place, same command as arm 4 -- only the observer mode differs, "
            "and nothing but FullObserverMove's own switch can produce that difference"
            % fixed_moved)
    g.check(held_height(AIR_Z, fixed_after[2] if fixed_after else None, 2.0),
            "and they do not fall either: FullObserverMove returns before anything, "
            "where MOVETYPE_WALK would have dropped them to the floor")

    #-- F. the retired control, and what it became. LAST: it ends the process.
    print("\n== F. sourcesharp_movement_managed 0 -- the arm that is now FATAL")
    fatal_before = count_fatals()
    g.cmd("sourcesharp_movement_managed 0")

    # WAITED FOR, not slept through. Error() goes into Sys_Error, which writes a
    # crash dump on its way out; measured at ~2s idle, 30 is the allowance for a
    # loaded box and the loop leaves as soon as the process does.
    for _ in range(30):
        if not process_is_running(g.pid):
            break
        time.sleep(1.0)

    fatal_after = count_fatals()
    state = process_state(g.pid)
    g.say("fatal lines %d -> %d, process now: %s" % (fatal_before, fatal_after, state))

    g.check(fatal_after > fatal_before,
            "the 0 arm PRINTED its refusal (%d -> %d fatal line(s)). This arm used "
            "to require a FLAT counter instead, and passed on a dead process "
            "because a counter read out of a log answers with its last value"
            % (fatal_before, fatal_after))
    g.check(not process_is_running(g.pid),
            "and the process STOPPED (/proc says '%s'), which is the other half of "
            "the contract: it did not carry on with nothing moving the players"
            % state)

    print()
    if g.failures == 0:
        print("== GATE PASSED (%d check(s))" % g.checks)
        return 0
    print("== GATE FAILED (%d of %d)" % (g.failures, g.checks))
    return 1


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""Join 5a-fnmap.py's output for physics.cpp against a hand ruling per function.

Usage: 5a-physics-classify.py <fnmap.tsv> <rulings.tsv>

rulings.tsv columns: key<TAB>verdict<TAB>reason
`key` is a unique substring of the fnmap head line.

Prints per-verdict totals and any fnmap row no ruling matched (so a function
added to the file cannot be silently left out of the scope).
"""
import collections
import sys

fnmap = [l.split("\t") for l in
         open(sys.argv[1], encoding="utf-8").read().strip().split("\n")]
rulings = []
for l in open(sys.argv[2], encoding="utf-8").read().strip().split("\n"):
    if not l.strip() or l.startswith("#"):
        continue
    parts = l.split("\t")
    rulings.append((parts[0], parts[1], parts[2] if len(parts) > 2 else ""))

tot = collections.Counter()
cnt = collections.Counter()
unmatched = []
ambiguous = []
rows = []
for start, end, n, head in fnmap:
    hits = [r for r in rulings if r[0] in head]
    if not hits:
        unmatched.append((start, head))
        continue
    if len(hits) > 1:
        ambiguous.append((start, head, [h[0] for h in hits]))
        continue
    key, verdict, reason = hits[0]
    tot[verdict] += int(n)
    cnt[verdict] += 1
    rows.append((int(start), int(n), verdict, head, reason))

unused = [r[0] for r in rulings
          if not any(r[0] in f[3] for f in fnmap)]

for start, n, verdict, head, reason in sorted(rows):
    print("%s\t%d\t%d\t%s" % (verdict, start, n, head))
print()
print("== totals (code lines in body, comments stripped) ==")
for v in sorted(tot, key=lambda k: -tot[k]):
    print("%-10s %4d functions %6d lines" % (v, cnt[v], tot[v]))
print("%-10s %4d functions %6d lines" % ("TOTAL", sum(cnt.values()), sum(tot.values())))
print()
print("UNMATCHED fnmap rows (no ruling):", len(unmatched))
for s, h in unmatched:
    print("   line %s  %s" % (s, h))
print("AMBIGUOUS (ruling key matched >1):", len(ambiguous))
for s, h, k in ambiguous:
    print("   line %s  %s  <- %s" % (s, h, k))
print("UNUSED rulings (key matched no function):", len(unused))
for k in unused:
    print("   %s" % k)
sys.exit(1 if (unmatched or ambiguous or unused) else 0)

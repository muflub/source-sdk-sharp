#!/usr/bin/env python3
"""Enumerate top-level (column-0) function definitions in a .cpp and count the
CODE lines in each body.  Derives nothing from a hardcoded path: the file to
read is argv[1].

A "function" here is a line starting at column 0 whose brace opens a body at
depth 0.  Class/struct/enum/namespace/extern blocks are reported as such so the
caller can see what was not counted as a function.
"""
import re
import sys

path = sys.argv[1]
lines = open(path, encoding="utf-8", errors="replace").read().split("\n")

# Strip comments while keeping line numbering.
code = []
inblock = False
for ln in lines:
    s = ln
    if inblock:
        i = s.find("*/")
        if i < 0:
            code.append("")
            continue
        s = s[i + 2:]
        inblock = False
    out = []
    i = 0
    while i < len(s):
        if s.startswith("//", i):
            break
        if s.startswith("/*", i):
            j = s.find("*/", i + 2)
            if j < 0:
                inblock = True
                break
            i = j + 2
            continue
        if s[i] == '"':
            j = i + 1
            while j < len(s):
                if s[j] == "\\":
                    j += 2
                    continue
                if s[j] == '"':
                    break
                j += 1
            out.append(s[i:j + 1])
            i = j + 1
            continue
        out.append(s[i])
        i += 1
    code.append("".join(out))

sig = re.compile(r"^[A-Za-z_~][\w:<>,*&\s~]*\(")
kw = re.compile(r"^(class|struct|enum|namespace|extern|union|typedef|template)\b")

QUALIFIERS = re.compile(r"(?:\s*(?:const|override|final|noexcept|volatile|OVERRIDE|FINAL|&&|&|->\s*[\w:<>*& ]+))*")


def skip_attribute(text):
    """(attribute, rest) when text starts with __attribute__(( ... )), however spaced."""
    if not text.startswith("__attribute__"):
        return "", text
    i = text.find("(")
    depth = 0
    for j in range(i, len(text)):
        depth += text[j] == "("
        depth -= text[j] == ")"
        if depth == 0:
            return text[:j + 1], text[j + 1:].lstrip()
    return "", text


def signature(text):
    """The head on one line however it was wrapped: up to the parameter list's
    closing parenthesis and its qualifiers (never an initialiser list)."""
    attribute, text = skip_attribute(" ".join(text.split()))
    if attribute:
        return (attribute + " " + signature(text)).strip()
    open_at = text.find("(")
    if open_at < 0:
        return text
    depth = 0
    for i in range(open_at, len(text)):
        if text[i] == "(":
            depth += 1
        elif text[i] == ")":
            depth -= 1
            if depth == 0:
                return text[:QUALIFIERS.match(text, i + 1).end()].rstrip()
    return text


depth = 0
start = None
head = None
opened = False
for n, s in enumerate(code, 1):
    stripped = s.strip()
    if depth == 0 and stripped and not stripped.startswith("#"):
        if sig.match(s) and not kw.match(s) and start is None:
            start = n
            head = stripped
            opened = False
        elif kw.match(s) and start is None:
            start = n
            head = stripped
            opened = True
        elif start is not None and not opened:
            head += " " + stripped.split("{", 1)[0]
    for ch in s:
        if ch == "{":
            if depth == 0 and start is not None:
                body_start = n
                opened = True
            depth += 1
        elif ch == "}":
            depth -= 1
            if depth == 0 and start is not None:
                nlines = sum(
                    1 for k in range(start - 1, n) if code[k].strip()
                )
                print("%d\t%d\t%d\t%s" % (start, n, nlines, signature(head)[:110]))
                start = None
                head = None
    if depth == 0 and start is not None and stripped.endswith(";"):
        start = None
        head = None

#!/usr/bin/env python3
"""plan_entity.md step 8e-entfire's gate: `ent_fire` reaching an entity with no edict.

    tools/8e-entfire-gate

Launches ONE game, drives it FROM THE CONSOLE, and prints PASS/FAIL per check
with the number each verdict was reached from. Exit 0 only when every check
passed.

THE DEFECT. Every native find in this build walks CEntInfo -- FindEntityByName
and FindEntityByClassname for the SDK hierarchy, FindGameEntityByName and
FindGameEntityByClassname for the shelled standalone one. A SHELL-LESS entity
(ScriptedEntityKind.Logical, the default kind, and so every point entity
`ent_create` makes) has no C++ object to have an entry, so all four walk past
it. Step 7c measured the symptom: `ent_fire env_shake StartShake` answered
`nothing is called "env_shake" and nothing is of that class` in the same second
that `debug-api ents env_shake` reported count 1.

EVERY COMMAND HERE GOES THROUGH `debug-api cmd`, WHICH IS THE CONSOLE. That is the
whole point of the step: `debug-api fire` already reached these entities -- it
calls AcceptInput directly -- so a gate that used it would pass on the build
that has the defect. 7c's own note beside its shake check records having to use
`debug-api fire` for exactly this reason, and that route is deliberately not used
anywhere below.

AND THE TRAP THIS GATE IS BUILT AGAINST: an input that does nothing looks
exactly like an input that was delivered and had no visible effect. So no check
here is of the form "the command did not error". Each one is a NUMBER or a
COUNT that the delivery changes:

  no edict          `debug-api ents` reports index -1 for the created entity, so
                    the subject really is one no native walk can reach. A gate
                    on an entity that HAD an edict would pass on the broken
                    build.

  the message       `ent_fire <a word nothing carries>` must still print
                    `nothing is called "..."`, and `ent_fire <our target>` must
                    not. Asserting only the absence would pass for a build that
                    had stopped printing the message at all, which is why the
                    control fire is here.

  shake and fade    cs_cl_vieweffects_report's applied displacement and fade
                    alpha -- 7c's own instrument, which read 2.952 and 38 when
                    7c drove them through `debug-api fire`. Driving the same two
                    from the CONSOLE is the payoff this step is worth more than
                    one defect for: step 4e MOVED that code and could not drive
                    it, so it shipped a relocation with no live measurement.

  the census        `ent_fire <classname> Kill` and then a COUNT: `debug-api ents`
                    goes to zero and status.logical.live falls by the same
                    number. A removal is the change a census can see, and it
                    cannot be produced by an input that was not delivered.

  nativeReach       step 2e's counter, read IMMEDIATELY BEFORE AND AFTER each
                    ent_fire rather than across the run. The fix hands the
                    handle straight to the managed Dispatch and never resolves
                    it natively, so no ent_fire may move it.

                    ACROSS THE RUN IT DOES MOVE, and the first version of this
                    gate failed on that. `ent_create` raises it by exactly one
                    per entity, measured A/B in one game: create 0->1, `debug-api
                    fire` 1->1, second create 1->2, console `ent_fire` 2->2.
                    The site is Engine.EntityTeleport, which has NO shell-less
                    arm where EntitySetOrigin beside it does (Engine.cs:3885
                    against :690) -- so ent_create's drop-point lift resolves a
                    shell-less handle natively, finds nothing, and is counted.
                    Pre-existing, nothing to do with ent_fire, and reported in
                    status/8e-entfire.md rather than fixed here.

DEBT, with a removal owner: this is 8e-entfire's gate and nothing else reads it.
It goes when tools/live-gate grows an I/O step, or when step 8c's leg folds the
live gates in.
"""
import json
import math
import os
import re
import signal
import subprocess
import sys
import time

# The flags every local game carries (+sv_lan 1 unless STEAM_AUTH=1, +fps_max
# 60): tools/local_launch.py, the Makefile's LOCAL_GAME_ARGS.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import local_launch  # noqa: E402

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# The game this configuration built, and the mod in it. bin/<config> holds the
# launcher and the shared bin/; the mod is bin/<config>/mods/test, handed to the
# launcher with -game, and -condebug writes console.log there.
# SOURCESHARP_CONFIG picks the configuration; debug when unset.
CONFIG = os.environ.get("SOURCESHARP_CONFIG") or "debug"
GAME_DIR = os.path.join(ROOT, "bin", CONFIG)
MOD_DIR = os.path.join(GAME_DIR, "mods", "test")

def launch_command(mod_dir):
    """source#, run from the game directory. No -game: it takes the mod from
    mods.yaml beside it, so every launch proves the file supplies it. `#` is
    quoted, so no shell reads it as a comment (tools/launcher-name-test)."""
    return "./'source#'"
SOCKET_DIR = os.environ.get("DEBUG_API_DIR", "/tmp/sourcesharp-debug-api")
CONSOLE = os.path.join(MOD_DIR, "console.log")

LAUNCH = ["-debugapi", "-debugapisocket", "-condebug", "-nomessagebox",
          "-nocrashdialog", "-assertlog", "-insecure", "-novid", "-windowed",
          "-w", "640", "-h", "480", "-maxplayers", "2",
          ] + local_launch.local_args() + ["+map", "dm_lockdown"]

# The open floor tools/live-gate-scenarios calls `openFloor`. The shake is
# radius 0 (everyone) so the position does not gate it, but a player embedded in
# geometry is a bad place to be measuring a rendered frame from.
OPEN_FLOOR = "-3843 2894 0"

SHAKE_NAME = "ss8eshake"
NO_SUCH = "ss8e_nothing_is_called_this"

FAILURES = []
NOTES = []


def check(name, ok, detail):
    print("  %-46s %s   %s" % (name, "PASS" if ok else "FAIL", detail))
    if not ok:
        FAILURES.append(name)
    return ok


def live_sockets():
    if not os.path.isdir(SOCKET_DIR):
        return []
    out = []
    for name in os.listdir(SOCKET_DIR):
        if not name.endswith(".sock"):
            continue
        try:
            os.kill(int(name[:-5]), 0)
        except (OSError, ValueError):
            continue
        out.append(os.path.join(SOCKET_DIR, name))
    return out


def debug_api(pid, *args):
    env = dict(os.environ, DEBUG_API_PID=str(pid), DEBUG_API_DIR=SOCKET_DIR)
    r = subprocess.run([os.path.join(ROOT, "tools", "debug-api")] + list(args),
                       capture_output=True, text=True, env=env, timeout=120)
    return r.stdout


def debug_api_json(pid, *args):
    text = debug_api(pid, *args)
    try:
        return json.loads(text)
    except ValueError:
        return {}


def console():
    try:
        with open(CONSOLE, "r", errors="replace") as fh:
            return fh.read()
    except IOError:
        return ""


def ents(pid, className):
    """(count, [index, ...]) for a class, off the MANAGED registry."""
    data = debug_api_json(pid, "ents", className)
    rows = data.get("entities") or []
    return int(data.get("count", 0)), [r.get("index") for r in rows]


def logical(pid):
    """(live, nativeReach) -- step 2e's two numbers, read together on purpose."""
    data = debug_api_json(pid, "status")
    block = data.get("logical") or {}
    return int(block.get("live", -1)), int(block.get("nativeReach", -1))


def vieweffects(pid):
    """(origin-shift magnitude, angle-shift magnitude, fade alpha) -- 7c's reader."""
    debug_api(pid, "cmd", "cs_cl_vieweffects_report")
    time.sleep(0.8)
    text = console()
    i = text.rfind("vieweffects:")
    text = text[i:] if i >= 0 else ""
    a = re.search(r"APPLIED to the last rendered frame: origin\s+"
                  r"(-?[\d.]+)\s+(-?[\d.]+)\s+(-?[\d.]+)\s+angles\s+"
                  r"(-?[\d.]+)\s+(-?[\d.]+)\s+(-?[\d.]+)", text)
    f = re.search(r"fade\s+rgba (\d+) (\d+) (\d+) (\d+)", text)
    org = math.sqrt(sum(float(a.group(i)) ** 2 for i in (1, 2, 3))) if a else None
    ang = math.sqrt(sum(float(a.group(i)) ** 2 for i in (4, 5, 6))) if a else None
    alpha = int(f.group(4)) if f else None
    return org, ang, alpha


def best_displacement(pid, tries=8):
    best = 0.0
    for _ in range(tries):
        q, a, _ = vieweffects(pid)
        for v in (q, a):
            if v is not None:
                best = max(best, v)
        if best > 0.0:
            break
        time.sleep(0.5)
    return best


def best_alpha(pid, tries=8):
    best = 0
    for _ in range(tries):
        _, _, alpha = vieweffects(pid)
        if alpha:
            best = max(best, alpha)
            break
        time.sleep(0.5)
    return best


def nothing_answers_count(target):
    """How often the console has said nothing answers to this exact word.

    The message carries the target in quotes, so the needle names its subject
    rather than matching the sentence -- a needle that matched only
    `nothing is called` would be satisfied by the CONTROL fire below and would
    then report the real target as unreachable for ever.
    """
    return console().count('nothing is called "%s"' % target)


def count_games():
    # `pgrep -c` prints 0 AND exits 1, so a shell `|| echo 0` emits TWO zeroes.
    r = subprocess.run(["pgrep", "-x", "hl2_linux64"], capture_output=True, text=True)
    return len([l for l in r.stdout.split("\n") if l.strip()])


def main():
    tmpdir = "/tmp/ss-8e-entfire"
    os.makedirs(tmpdir, exist_ok=True)
    os.makedirs(SOCKET_DIR, exist_ok=True)
    if os.path.exists(CONSOLE):
        os.remove(CONSOLE)

    print("box before: hl2_linux64 %d, free -g:" % count_games())
    subprocess.run(["free", "-g"])

    known = set(live_sockets())
    quoted = " ".join("'%s'" % a for a in LAUNCH)
    line = (". '%s/tools/gpu-offload'; cd '%s' && exec %s %s"
            % (ROOT, GAME_DIR, launch_command(MOD_DIR), quoted))
    log = open(os.path.join(tmpdir, "launch.log"), "wb")
    popen = subprocess.Popen(["bash", "-c", line], stdout=log,
                             stderr=subprocess.STDOUT,
                             env=dict(os.environ, TMPDIR=tmpdir),
                             start_new_session=True)

    pid = None
    deadline = time.time() + 240
    while time.time() < deadline:
        fresh = [s for s in live_sockets() if s not in known]
        if fresh:
            pid = int(os.path.basename(fresh[0])[:-5])
            break
        if popen.poll() is not None:
            break
        time.sleep(1.0)

    if pid is None:
        try:
            os.killpg(os.getpgid(popen.pid), signal.SIGKILL)
        except OSError:
            pass
        print("no socket appeared; the game never came up")
        return 2

    try:
        print("game pid %d" % pid)
        for _ in range(60):
            if "ss_player" in debug_api(pid, "ents", "ss_player"):
                break
            time.sleep(1.0)

        # SV_CHEATS FIRST, and it is not ceremony: ent_fire and ent_create are
        # both FCVAR_CHEAT, so at sv_cheats 0 the console accepts the line and
        # does nothing -- which is the OTHER thing that looks exactly like an
        # entity ignoring an input, and is a separate known trap from the one
        # this gate is about.
        debug_api(pid, "cmd", "sv_cheats 1")
        time.sleep(0.5)

        # Onto the open floor, retried: `setpos` is a player command and the
        # console answers "no player issued that" while the local player is
        # still arriving.
        for _ in range(15):
            before = console().count("no player issued that")
            debug_api(pid, "cmd", "setpos " + OPEN_FLOOR)
            time.sleep(1.0)
            if console().count("no player issued that") == before:
                break
        time.sleep(1.5)

        live0, reach0 = logical(pid)

        # ---------------------------------------------------------------
        # THE SUBJECT: an entity with no edict, made the way a person makes
        # one. env_shake is [ScriptedEntity(...)] with the default kind, which
        # is Logical -- no shell, no edict, no CEntInfo entry.
        # ---------------------------------------------------------------
        debug_api(pid, "cmd", "ent_create env_shake targetname %s "
                           "amplitude 16 frequency 40 duration 8 radius 0 "
                           "spawnflags 1" % SHAKE_NAME)
        time.sleep(1.2)

        nshake, indices = ents(pid, "env_shake")
        NOTES.append("ents env_shake after create: count %d, indices %s"
                     % (nshake, indices))

        check("the created entity exists at all",
              nshake >= 1,
              "debug-api ents env_shake count %d" % nshake)

        # -1 IS THE WHOLE PREMISE. An entity with an edict would be found by
        # the native walks that were already there, so this gate would pass on
        # the build that has the defect.
        check("...and it has NO edict (this is the subject)",
              nshake >= 1 and all(i == -1 for i in indices),
              "index %s from debug-api ents; an edict entity carries 0..2047"
              % (indices if indices else "none"))

        liveAfterCreate, _ = logical(pid)
        check("...and the shell-less census counted it",
              liveAfterCreate > live0,
              "status.logical.live %d -> %d" % (live0, liveAfterCreate))

        # ---------------------------------------------------------------
        # THE CONTROL, FIRST: the "nothing answers" message still works.
        #
        # Without this, "our target was not refused" would also be true of a
        # build that had simply stopped printing the message -- which is a
        # check that cannot fail, and this tree has found two dozen of those.
        # ---------------------------------------------------------------
        debug_api(pid, "cmd", "ent_fire %s StartShake" % NO_SUCH)
        time.sleep(1.0)

        check("a word nothing carries is STILL refused out loud",
              nothing_answers_count(NO_SUCH) > 0,
              'console said `nothing is called "%s"` %d time(s)'
              % (NO_SUCH, nothing_answers_count(NO_SUCH)))

        # ---------------------------------------------------------------
        # ent_fire BY NAME. From the console, never debug-api fire.
        # ---------------------------------------------------------------
        before = best_displacement(pid, tries=2)
        refusedNameBefore = nothing_answers_count(SHAKE_NAME)
        _, reachBeforeName = logical(pid)

        debug_api(pid, "cmd", "ent_fire %s StartShake" % SHAKE_NAME)
        time.sleep(1.2)

        _, reachAfterName = logical(pid)

        check("ent_fire BY NAME is not refused",
              nothing_answers_count(SHAKE_NAME) == refusedNameBefore,
              'console said `nothing is called "%s"` %d time(s), was %d'
              % (SHAKE_NAME, nothing_answers_count(SHAKE_NAME), refusedNameBefore))

        after = best_displacement(pid)

        # DELIVERY, not absence of error. Zero is what this build read for the
        # whole of the port while the server sent shakes nobody applied, and
        # what it read again whenever ent_fire failed to find the entity.
        check("ent_fire BY NAME moves the rendered view",
              after > 0.0 and after > before,
              "applied displacement %.3f, was %.3f immediately before" % (after, before))

        # ---------------------------------------------------------------
        # ent_fire BY CLASSNAME -- the case that matters most, because an
        # entity `ent_create` just made has no targetname unless one was typed.
        # ---------------------------------------------------------------
        debug_api(pid, "cmd", "ent_create env_fade duration 8 holdtime 8 "
                           "renderamt 255 rendercolor \"255 0 0\"")
        time.sleep(1.2)

        nfade, fadeIndices = ents(pid, "env_fade")
        NOTES.append("ents env_fade after create: count %d, indices %s"
                     % (nfade, fadeIndices))

        refusedClassBefore = nothing_answers_count("env_fade")
        _, reachBeforeClass = logical(pid)
        debug_api(pid, "cmd", "ent_fire env_fade Fade")
        time.sleep(1.2)

        _, reachAfterClass = logical(pid)

        check("ent_fire BY CLASSNAME is not refused",
              nothing_answers_count("env_fade") == refusedClassBefore,
              'console said `nothing is called "env_fade"` %d time(s), was %d'
              % (nothing_answers_count("env_fade"), refusedClassBefore))

        alpha = best_alpha(pid)

        check("ent_fire BY CLASSNAME tints the screen",
              alpha > 0,
              "fade alpha %d" % alpha)

        # ---------------------------------------------------------------
        # THE CENSUS CHANGE. Kill is a universal input on every scripted
        # entity, and a removal is the one effect a COUNT can see -- it cannot
        # be produced by an input that was never delivered, and it cannot be
        # confused with an effect that was too small to notice.
        # ---------------------------------------------------------------
        liveBeforeKill, _ = logical(pid)
        nshakeBeforeKill, _ = ents(pid, "env_shake")

        debug_api(pid, "cmd", "ent_fire env_shake Kill")
        time.sleep(1.5)

        nshakeAfterKill, _ = ents(pid, "env_shake")
        liveAfterKill, reach1 = logical(pid)

        check("ent_fire Kill removes every entity of the class",
              nshakeBeforeKill > 0 and nshakeAfterKill == 0,
              "debug-api ents env_shake count %d -> %d"
              % (nshakeBeforeKill, nshakeAfterKill))

        check("...and the shell-less census fell by exactly that many",
              liveBeforeKill - liveAfterKill == nshakeBeforeKill,
              "status.logical.live %d -> %d, a fall of %d against %d killed"
              % (liveBeforeKill, liveAfterKill,
                 liveBeforeKill - liveAfterKill, nshakeBeforeKill))

        # ---------------------------------------------------------------
        # STEP 2e's ZERO SURVIVES THE FIX -- ACROSS THE ent_fire, which is the
        # only span this step can be held to. The handle goes straight to the
        # managed Dispatch and is never resolved natively.
        #
        # NOT across the whole run: `ent_create` raises the counter by one per
        # entity through Engine.EntityTeleport, which has no shell-less arm.
        # See the module docstring for the A/B that established that, and
        # status/8e-entfire.md for the defect. `live` is quoted beside every
        # reading because a zero taken on a build with no shell-less entities
        # would say nothing at all.
        # ---------------------------------------------------------------
        check("ent_fire BY NAME reached no handle natively",
              reachAfterName == reachBeforeName,
              "status.logical.nativeReach %d -> %d across the fire, live %d"
              % (reachBeforeName, reachAfterName, liveAfterCreate))

        check("ent_fire BY CLASSNAME reached no handle natively",
              reachAfterClass == reachBeforeClass,
              "status.logical.nativeReach %d -> %d across the fire, live %d"
              % (reachBeforeClass, reachAfterClass, liveBeforeKill))

        NOTES.append("nativeReach across the whole run: %d -> %d, live %d -> %d. "
                     "The rise is ent_create's, one per entity, through "
                     "Engine.EntityTeleport -- see the docstring."
                     % (reach0, reach1, live0, liveAfterKill))

        # ---------------------------------------------------------------
        # And nothing fell over on the way.
        # ---------------------------------------------------------------
        text = console()
        nbad = len(re.findall(r"Assertion|SIGSEGV|Segmentation", text))
        check("no assertion and no segfault", nbad == 0,
              "%d matches for Assertion|SIGSEGV|Segmentation" % nbad)

        # ---------------------------------------------------------------
        # AND THE LEDGER HAS TO AGREE WITH ALL OF THAT.
        #
        # `ContractBaseline.OpenDefects` carried "ent_fire cannot reach any
        # entity that has no edict" for four waves after this step closed it,
        # and STATE recorded the disagreement rather than settling it -- twice,
        # because the entry has no tree-local witness (the walk that used to
        # fail is inside engine.so) so no managed test could ever notice. The
        # thing that CAN notice is this gate, which has just watched every one
        # of those checks pass from the console.
        #
        # So the reconciliation is a command, exactly as the 3D skybox half of
        # the same disagreement was settled by tools/7a-effect-gate asserting
        # its row IS on the ledger. Here the assertion is the opposite one, and
        # it fails if anybody puts the row back.
        #
        # WITH A POSITIVE CONTROL, because an absence check over a file this
        # did not manage to read would pass. The teleport-slide row is the one
        # OpenDefects entry nothing in this step touches; if THAT is missing,
        # the file was not read and the absence below means nothing.
        # ---------------------------------------------------------------
        ledger_path = os.path.join(ROOT, "src", "sourcesharp", "managed",
                                   "SourceSharp.Tests.Common", "ContractBaseline.cs")
        ledger = ""
        try:
            with open(ledger_path, encoding="utf-8") as fh:
                ledger = fh.read()
        except OSError as exc:
            NOTES.append("ledger unreadable: %s" % exc)

        check("the ledger was actually read (positive control)",
              "An entity that teleports is drawn sliding to where it went" in ledger,
              "ContractBaseline.cs is %d bytes and %s the teleport row"
              % (len(ledger),
                 "carries" if "drawn sliding to where it went" in ledger
                 else "DOES NOT carry"))

        check("ent_fire is NOT on the OpenDefects ledger",
              "ent_fire cannot reach any entity that has no edict" not in ledger,
              "ContractBaseline.cs %s the row, and every check above passed"
              % ("STILL CARRIES"
                 if "ent_fire cannot reach any entity that has no edict" in ledger
                 else "no longer carries"))

    finally:
        try:
            os.killpg(os.getpgid(popen.pid), signal.SIGKILL)
        except OSError:
            pass
        try:
            popen.wait(timeout=20)
        except Exception:
            pass
        log.close()
        print("box after: hl2_linux64 %d" % count_games())

    print()
    for note in NOTES:
        print("  note: " + note)
    print()
    if FAILURES:
        print("8e-entfire-gate: FAILED -- " + ", ".join(FAILURES))
        return 1
    print("8e-entfire-gate: every check passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())

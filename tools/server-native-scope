#!/usr/bin/env python3
"""tools/server-native-scope -- the ratchet behind
docs/plans/plan_server_native_min.md: every server native function stays
ruled, and the not-native work (MOVE + DELETE + FOLD + DEBUG code lines) may
only fall.

    tools/server-native-scope               measure, compare against
                                            docs/server-native-ratchet.tsv;
                                            exit 1 on an unruled function, a
                                            ruled-but-vanished function, or a
                                            ratchet row that rose
    tools/server-native-scope --write       rewrite the ratchet to what was
                                            measured (review the diff)
    tools/server-native-scope --self-test   this script's own checks

    SOURCESHARP_CONFIG (or --config) picks farm/<config>; only the source
    list is read, never build output, so no build is needed first.

Inputs (a missing input is a failure, never zero):
  src/server/native/CMakeLists.txt   server_sourcesharp_sources and the
                                     server_sourcesharp_debug_sources list
  tools/physics-scope/fnmap          per-TU function census (run as a
                                     subprocess so one tool owns the parser)
  docs/plans/server_native_audit.tsv the ledger (one row per function,
                                     joined on file + symbol, never line)

Join rules (plan section 0 / Recipe G):
  - a fnmap row with no ledger row  -> FAIL "unruled", naming the function
  - a ledger row for a measured TU whose function is gone is fine ONLY if its
    verdict is DELETE, DONE or FOLD; anything else -> FAIL "ruled but
    vanished" (a KEEP that vanished silently is exactly what this check
    exists to catch; re-rule the row in the same commit instead)
Ratchet (docs/server-native-ratchet.tsv, one row per file):
  code lines summed over the file's MOVE+DELETE+FOLD+DEBUG rows.
  measured > committed -> FAIL "rose".  A file that left the source list
  measures 0: a fall, never an error.
"""
import os
import re
import subprocess
import sys
import tempfile

SUBROW = re.compile(r"^(.*) \(method inside the class row (\d+)-(\d+)\)$")

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FNMAP = os.path.join(REPO, "tools", "physics-scope", "fnmap")
CMAKELISTS = os.path.join(REPO, "src", "server", "native", "CMakeLists.txt")
LEDGER_DEFAULT = os.path.join(REPO, "docs", "plans", "server_native_audit.tsv")
RATCHET_DEFAULT = os.path.join(REPO, "docs", "server-native-ratchet.tsv")

TERMINAL = ("DELETE", "DONE", "FOLD", "OOS")
RATCHET_VERDICTS = ("MOVE", "DELETE", "FOLD", "DEBUG")

# Out of scope: none since plan_server_native_v2 T0 (2026-10-18). The physics
# and bones plan is done, so its TUs are ruled here like every other (physics.cpp
# KEEP-REG, shell_physicsobjects.cpp KEEP-OUT, physics_debug.cpp DEBUG,
# collisionutils.cpp DELETE but one MOVE). A TU listed here measures 0 and
# needs no rows; the list is kept so a future out-of-scope ruling has one place.
OOS_TUS = ()


def fail(msg):
    print("server-native-scope: " + msg)
    return 1


# --------------------------------------------------------------- source list

def parse_sources(cmake_text):
    """The .cpp files of server_sourcesharp_sources and the debug list, as
    repo-relative paths, in listed order, duplicates dropped. Comment lines
    are stripped first."""
    import re
    text = "\n".join(ln.split("#", 1)[0] for ln in cmake_text.split("\n"))
    files, seen = [], set()
    for m in ("server_sourcesharp_sources", "server_sourcesharp_debug_sources"):
        block = re_block(text, m)
        if block is None:
            return None
        for tok in block.split():
            if not tok.endswith(".cpp"):
                continue
            if tok.startswith("${CMAKE_CURRENT_SOURCE_DIR}/"):
                rel = "src/server/native/" + tok[len("${CMAKE_CURRENT_SOURCE_DIR}/"):]
            elif tok.startswith("${LOCAL}/"):
                rel = "src/server/native/" + tok[len("${LOCAL}/"):]
            elif tok.startswith("${SHARED}/"):
                rel = "src/shared/native/" + tok[len("${SHARED}/"):]
            elif tok.startswith("${PROJECT_SOURCE_DIR}/"):
                rel = tok[len("${PROJECT_SOURCE_DIR}/"):]
            else:
                return None
            if rel not in seen:
                seen.add(rel)
                files.append(rel)
    return files


def re_block(text, name):
    import re
    m = re.search(r"set\(%s\s*\n(.*?)\n\)" % re.escape(name), text, re.S)
    return m.group(1) if m else None


# ---------------------------------------------------------------- fnmap rows

def norm(symbol):
    """The join key: the fnmap head line with whitespace collapsed
    (Recipe G). The ledger stores the same normalization."""
    return " ".join(symbol.split())


def fnmap_rows(path):
    """(start, end, code, symbol) per column-0 function of one TU."""
    out = subprocess.run([FNMAP, path], capture_output=True, text=True)
    if out.returncode != 0:
        return None
    rows = []
    for ln in out.stdout.splitlines():
        parts = ln.split("\t")
        if len(parts) < 4:
            return None
        rows.append((int(parts[0]), int(parts[1]), int(parts[2]), norm("\t".join(parts[3:]))))
    return rows


def read_ledger(path):
    """{file: [(symbol, verdict, code, start, end), ...]} for the data rows;
    a list because one file can carry several same-labelled rows (two
    anonymous namespaces)."""
    by_file = {}
    with open(path, encoding="utf-8") as fh:
        for ln in fh:
            if not ln.strip() or ln.startswith("#") or ln.startswith("cluster\t"):
                continue
            cols = ln.rstrip("\n").split("\t")
            if len(cols) < 7:
                return None
            cluster, fname, start, end, code, symbol, verdict = cols[:7]
            by_file.setdefault(fname, []).append((norm(symbol), verdict, int(code), int(start), int(end)))
    return by_file


def read_ratchet(path):
    """{file: code}; malformed or missing returns None."""
    if not os.path.isfile(path):
        return None
    rows = {}
    with open(path, encoding="utf-8") as fh:
        for ln in fh:
            if not ln.strip() or ln.startswith("#"):
                continue
            parts = ln.rstrip("\n").split("\t")
            if len(parts) != 2:
                return None
            rows[parts[0]] = int(parts[1])
    return rows


def fn_name(head):
    """The identifier a fnmap head names: the token before the first '(', or
    the whole head for namespace/class/enum blocks. Returns None when the
    head names no function."""
    h = head
    if h.startswith("__attribute__"):
        # __attribute__(( ... )) static void F(), however it is spaced
        depth, i = 0, h.find("(")
        for j in range(i, len(h)):
            depth += h[j] == "("
            depth -= h[j] == ")"
            if depth == 0:
                h = h[j + 1:].strip()
                break
    i = h.find("(")
    if i < 0:
        return None
    m = re.search(r"([~\w:]+)\s*$", h[:i])
    return m.group(1) if m else None


class Joiner:
    """Matches fnmap rows to ledger rows for one file. Both sides carry the
    collapsed head and the extracted identifier; a row matches on exact
    head, then on identifier, then on the kw-block's first word ("namespace:"
    free-text labels). Overloads that survive to the name pass pair in
    order; a mismatched count fails."""

    def __init__(self, fnmap_rows, ledger_rows):
        self.fnmap = list(fnmap_rows)      # (start, end, code, head)
        self.ledger = list(ledger_rows)    # (symbol, verdict, code, start, end)
        self.matched = {}                  # fnmap index -> ledger index

    def run(self):
        ledger_free = set(range(len(self.ledger)))
        # pass 1: exact head
        for fi, row in enumerate(self.fnmap):
            for li in ledger_free:
                if self.ledger[li][0] == row[3]:
                    self.matched[fi] = li
                    ledger_free.discard(li)
                    break
        # pass 2: identifier, including ctor/dtor labels ("ConVar ctor(3)")
        for fi, row in enumerate(self.fnmap):
            if fi in self.matched:
                continue
            head = row[3]
            name = fn_name(head)
            if name is None:
                continue
            last = name.rsplit("::", 1)[-1]
            if last.startswith("~"):
                aliases = [name, last, last.lstrip("~") + " dtor"]   # a destructor
            elif last == name.rsplit("::", 1)[0] and "::" in name:
                aliases = [name, last, last + " ctor"]        # a constructor
            else:
                aliases = [name, last]
            for li in ledger_free:
                symbol = self.ledger[li][0]
                if any(symbol == a or symbol.startswith(a + "(") for a in aliases):
                    self.matched[fi] = li
                    ledger_free.discard(li)
                    break
                if name.isupper() and symbol.startswith(name + " "):
                    # macro rows: "CON_COMMAND cs_cl_move_managed_report"
                    self.matched[fi] = li
                    ledger_free.discard(li)
                    break
                if symbol.startswith(name + " (server)") or symbol.startswith(name + " (client"):
                    # the audit's side-tags for same-name twins ("(client arm)")
                    self.matched[fi] = li
                    ledger_free.discard(li)
                    break
        # pass 3: kw blocks (namespace / class / enum heads vs their labels)
        for fi, row in enumerate(self.fnmap):
            if fi in self.matched:
                continue
            head = row[3]
            kw = head.split()[0] if head.split() else ""
            if not kw or re.match(r"^[A-Za-z_~][\w:<>,*&\s~]*\(", head):
                continue  # a signature, not a kw block
            for li in ledger_free:
                symbol = self.ledger[li][0]
                if symbol == kw or symbol.startswith(kw + ":") or symbol.startswith(kw + " "):
                    self.matched[fi] = li
                    ledger_free.discard(li)
                    break
                # "namespace ss { void F(...); }" <-> "ss::F decl"
                if kw == "namespace":
                    names = re.findall(r"([\w:]+)\s*[({;]", head)
                    if any(symbol.startswith(n + "::") for n in names if n != "namespace"):
                        self.matched[fi] = li
                        ledger_free.discard(li)
                        break
        # pass 4: leftovers with the same identifier pair in order (overloads
        # whose signatures drifted), then any remaining free-text label (an
        # extern "C"/namespace block the audit described but fnmap cannot name)
        for fi, row in enumerate(self.fnmap):
            if fi in self.matched:
                continue
            name = fn_name(row[3])
            if name is None:
                continue
            for li in ledger_free:
                symbol = self.ledger[li][0]
                if symbol.startswith(name + "(") or symbol == name:
                    self.matched[fi] = li
                    ledger_free.discard(li)
                    break
        for fi, row in enumerate(self.fnmap):
            if fi in self.matched:
                continue
            if fn_name(row[3]) is not None:
                continue
            for li in ledger_free:
                if "(" not in self.ledger[li][0]:
                    self.matched[fi] = li
                    ledger_free.discard(li)
                    break
        unruled = [row[3] for fi, row in enumerate(self.fnmap) if fi not in self.matched]
        # ledger rows left over that decompose a matched block (class methods
        # defined in-class) are that block's sub-rows: a leftover row whose
        # ledger start lies inside a matched block row's ledger range.fnmap
        # cannot see globals, decls and #includes, so a KEEP-* row with no
        # "(" in its label is fine too; every other leftover vanished.
        self.subrows = {}                  # ledger index of block row -> [(verdict, code)]
        for li in sorted(ledger_free):
            symbol, verdict, code, lstart, lend = self.ledger[li]
            if SUBROW.match(symbol):
                # legacy marker: the parent range is in the label
                m = SUBROW.match(symbol)
                lo = int(m.group(2))
            else:
                lo = lstart                # containment decided on the start line
            best, best_span = None, None
            for fi in self.matched:
                head = self.fnmap[fi][3]
                if fn_name(head) is not None:
                    continue  # a function row, not a block
                bs, be = self.ledger[self.matched[fi]][3], self.ledger[self.matched[fi]][4]
                if not (bs <= lo <= be):
                    continue
                span = be - bs
                if best is None or span < best_span:
                    best, best_span = self.matched[fi], span
            if best is not None:
                self.subrows.setdefault(best, []).append((verdict, code))
                ledger_free.discard(li)
            elif verdict.startswith("KEEP") and ("(" not in symbol or symbol.startswith("#include")):
                ledger_free.discard(li)  # a global / declaration / include line: fnmap cannot see it
        vanished = [self.ledger[li] for li in sorted(ledger_free)]
        return unruled, vanished


def measure(paths, ledger):
    """Returns (unruled, vanished, counts): the failure lists and the per-file
    MOVE+DELETE+FOLD+DEBUG code-line totals."""
    unruled, vanished, counts = [], [], {}
    for rel in paths:
        if rel in OOS_TUS:
            counts[rel] = 0
            continue
        rows = fnmap_rows(rel if os.path.isabs(rel) else os.path.join(REPO, rel))
        if rows is None:
            return None, None, None
        ruled = ledger.get(rel, [])
        rows4 = fnmap_rows(rel if os.path.isabs(rel) else os.path.join(REPO, rel))
        if rows4 is None:
            return None, None, None
        fnmap = [(s, e, c, sym) for s, e, c, sym in rows4]
        j = Joiner(fnmap, ruled)
        f_unruled, f_vanished = j.run()
        unruled.extend("%s: %s" % (rel, head) for head in f_unruled)
        vanished.extend("%s: %s (%s)" % (rel, sym, verdict)
                        for sym, verdict, *_rest in f_vanished if verdict not in TERMINAL)
        total = 0
        for fi, li in j.matched.items():
            subs = j.subrows.get(li)
            if subs is not None:
                total += sum(code for verdict, code in subs if verdict in RATCHET_VERDICTS)
            elif j.ledger[li][1] in RATCHET_VERDICTS:
                total += fnmap[fi][2]
        counts[rel] = total
    return unruled, vanished, counts


def compare(committed, measured):
    """(rose, unmeasured): a baselined file that left the source list
    measures 0 -- a fall, green; a measured count above its baseline is red."""
    rose = [(f, committed[f], measured.get(f, 0))
            for f in committed if measured.get(f, 0) > committed[f]]
    return rose, []


def main():
    args = sys.argv[1:]
    if "--self-test" in args:
        return self_test()

    ledger_path = LEDGER_DEFAULT
    ratchet_path = RATCHET_DEFAULT
    write = "--write" in args
    for a in args:
        if a.startswith("--ledger="):
            ledger_path = a.split("=", 1)[1]
        if a.startswith("--ratchet="):
            ratchet_path = a.split("=", 1)[1]

    if not os.path.isfile(FNMAP):
        return fail("missing input: " + FNMAP)
    if not os.path.isfile(CMAKELISTS):
        return fail("missing input: " + CMAKELISTS)
    if not os.path.isfile(ledger_path):
        return fail("missing input: " + ledger_path)

    with open(CMAKELISTS, encoding="utf-8") as fh:
        paths = parse_sources(fh.read())
    if paths is None:
        return fail("could not parse the server source lists from " + CMAKELISTS)
    if not paths:
        return fail("empty server source list")

    ledger = read_ledger(ledger_path)
    if ledger is None:
        return fail("malformed ledger: " + ledger_path)

    unruled, vanished, counts = measure(paths, ledger)
    if counts is None:
        return fail("fnmap failed on a TU")

    rc = 0
    if unruled:
        rc = 1
        print("unruled functions (%d) -- add a ledger row, do not pass silently:" % len(unruled))
        for u in unruled[:20]:
            print("  " + u)
    if vanished:
        rc = 1
        print("ruled but vanished (%d) -- re-rule the row in the same commit:" % len(vanished))
        for v in vanished[:20]:
            print("  " + v)

    total = sum(counts.values())
    if write:
        with open(ratchet_path, "w", encoding="utf-8") as fh:
            fh.write("# docs/server-native-ratchet.tsv -- per-file not-native code lines\n"
                     "# (MOVE+DELETE+FOLD+DEBUG) from docs/plans/server_native_audit.tsv,\n"
                     "# maintained by tools/server-native-scope --write; reviewed in the diff.\n")
            for f in sorted(counts):
                if counts[f]:
                    fh.write("%s\t%d\n" % (f, counts[f]))
        print("wrote %s (%d files, %d lines)" % (ratchet_path, sum(1 for v in counts.values() if v), total))

    committed = read_ratchet(ratchet_path)
    if committed is None:
        return fail("missing or malformed ratchet: " + ratchet_path
                    + " (regenerate with --write and review the diff)")
    rose, _unmeasured = compare(committed, counts)
    if rose:
        rc = 1
        print("ratchet rose (%d) -- the not-native lines may only fall:" % len(rose))
        for f, was, now in rose[:20]:
            print("  %s %d -> %d" % (f, was, now))
    if rc == 0:
        print("server-native-scope: %d TUs, %d not-native lines (ratchet %d)"
              % (len(paths), total, sum(committed.values())))
    return rc


# ----------------------------------------------------------------- self-test

def self_test():
    checks = failed = 0

    def ck(what, ok):
        nonlocal checks, failed
        checks += 1
        if not ok:
            failed += 1
            print("  FAIL", what)

    ck("a missing ledger is a failure, never a pass",
       not os.path.isfile("/nonexistent/ledger.tsv"))
    with tempfile.TemporaryDirectory(prefix="sns-bad-") as td:
        bad = os.path.join(td, "bad.tsv")
        open(bad, "w").write("A\tsrc/x.cpp\t1\t2\t3\tint f() {\n")  # 7 columns truncated to 6
        ck("a malformed ledger row is a failure", read_ledger(bad) is None)

    with tempfile.TemporaryDirectory(prefix="sns-") as td:
        tu = os.path.join(td, "tu.cpp")
        with open(tu, "w") as fh:
            fh.write("int Kept() { return 1; }\n")

        rows = fnmap_rows(tu)
        ck("fnmap reads the planted TU", rows is not None and len(rows) == 1)
        if not rows:
            return 1
        symbol = rows[0][3]

        # a ruled function passes and its ratchet counts only not-native rows
        with open(tu, "w") as fh:
            fh.write("int Kept() { return 1; }\n"
                     "int Moved() { return 2; }\n"
                     "int Folded() { return 3; }\n")
        rows = fnmap_rows(tu)
        ck("fnmap reads the three planted functions", rows is not None and len(rows) == 3)
        code = {r[3]: r[2] for r in rows}
        ledger = {tu: [("int Kept()", "KEEP-OUT", 1, 1, 1),
                       ("int Moved()", "MOVE", 0, 2, 2),
                       ("int Folded()", "FOLD", 0, 3, 3),
                       ("int Dead()", "DELETE", 3, 9, 9)]}
        unruled, vanished, counts = measure([tu], ledger)
        ck("a ruled function is not unruled", unruled == [])
        ck("a DELETE row whose function is gone is fine", vanished == [])
        ck("a KEEP row whose function is gone fails",
           measure([tu], {tu: ledger[tu] + [("int Gone2()", "KEEP-OUT", 4, 9, 9)]})[1]
           == ["%s: int Gone2() (KEEP-OUT)" % tu])
        ck("the ratchet counts MOVE+FOLD code, not KEEP",
           counts is not None and counts[tu] == code["int Moved()"] + code["int Folded()"])

        # a planted function with no row is named by the check
        with open(tu, "a") as fh:
            fh.write("\nint Unruled_new() { return 9; }\n")
        unruled, _v, _c = measure([tu], ledger)
        ck("a planted unruled function is named", unruled == ["%s: int Unruled_new()" % tu])

        # a raised ratchet row is red; a fallen one is not
        rose, _ = compare({"a.cpp": 3, "b.cpp": 1}, {"a.cpp": 4})
        ck("a row that rose is red", rose == [("a.cpp", 3, 4)])
        rose, _ = compare({"a.cpp": 3, "b.cpp": 1}, {"a.cpp": 0, "b.cpp": 1})
        ck("a file that fell to 0 is not red", rose == [])
        rose, _ = compare({"a.cpp": 3}, {"a.cpp": 3, "new.cpp": 5})
        ck("negative control: a new file below its (absent) baseline is not rose", rose == [])

    print("%d checks, %d failed" % (checks, failed))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())

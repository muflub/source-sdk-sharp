#!/usr/bin/env python3
"""tools/descent-preview-spawns -- one spawn view in a Descent level's preview.

    tools/descent-preview-spawns <preview.bsp>      keep the first info_player_start, stand the breakables
    tools/descent-preview-spawns --self-test

`make descent-level` links a level a second time for `ssmap preview`, without
-mod-entities, so its arrival and the four party spawns round it become five
info_player_starts. The preview plans a player's-eye view from up to four of
them, and four views from one spot of one room tell nothing the first does not
(user review, 2026-11-10: "drop the four spawn views that stare at a wall to
one"). This rewrites the preview map's entity lump in place keeping the first
info_player_start (the arrival, the room's way in, which faces into the room)
and dropping the others. Only the preview's own copy is changed: the level the
host links (-mod-entities) is another file, and the movement report walks
from the one spawn that is left, which stands in the same room as the others.

The entity lump is written at the end of the file and the header points at it,
so no other lump moves. A map with no info_player_start is refused.

It then stands the level's breakable crates and barrels in the same preview
map (ruling M34, brief p12): the rooms write each as a point the server's
breakable manager draws, so neither linked map holds a prop there, and the
preview would show (and its walker cross) open floor. tools/descent-breakables
reads the points from the .nav3d the preview's link wrote beside the map, as
the server reads them, and adds the server's model at each as a solid static
prop casting no shadow (the lightmaps were baked without them, as the game's
are). It is built against the map tools' assemblies: MAPTOOLS_DIR, else the
checkout maptools.lock.local names, else ../source-sdk-map-tools (the
Makefile's default). A map without its .nav3d is refused. The props are
in the map's checksum, which the .map2d beside it records (the map tools'
Map2dReader refuses a stale one), so the .map2d is rebound to the new map as
tools/descent-face-sides rebinds it, and one made for another map is refused.
"""
import importlib.machinery
import importlib.util
import os
import re
import struct
import subprocess
import sys
import tempfile

ENTITIES = 0
HEADER_LUMPS = 64

HERE = os.path.dirname(os.path.abspath(os.path.realpath(__file__)))
ROOT = os.path.abspath(os.path.join(HERE, '..'))
DOTNET = os.path.expanduser('~/.dotnet/dotnet')
BREAKABLES_PROJECT = os.path.join(ROOT, 'tools', 'descent-breakables')
BREAKABLES_BIN = os.path.join(ROOT, 'bin', 'descent-breakables', 'bin', 'Release', 'net10.0', 'descent-breakables')


def entity_blocks(text):
    return re.findall(r'\{[^{}]*\}', text)


def keep_first_spawn(text):
    """The entity text with every info_player_start after the first dropped; returns (text, dropped)."""
    blocks = entity_blocks(text)
    out, seen, dropped = [], False, 0
    for b in blocks:
        if re.search(r'"classname"\s+"info_player_start"', b):
            if seen:
                dropped += 1
                continue
            seen = True
        out.append(b)
    if not seen:
        raise ValueError('the map has no info_player_start')
    return '\n'.join(out) + '\n\x00', dropped


def rewrite(path):
    with open(path, 'rb') as f:
        data = bytearray(f.read())
    if data[:4] != b'VBSP':
        raise ValueError('%s is not a BSP' % path)
    off, length, version, fourcc = struct.unpack_from('<iiii', data, 8 + 16 * ENTITIES)
    text = bytes(data[off:off + length]).decode('latin1').rstrip('\x00')
    new, dropped = keep_first_spawn(text)
    blob = new.encode('latin1')
    # Append the new lump on a 4-byte boundary and point the header at it.
    while len(data) % 4:
        data.append(0)
    at = len(data)
    data += blob
    struct.pack_into('<iiii', data, 8 + 16 * ENTITIES, at, len(blob), version, fourcc)
    tmp = path + '.tmp'
    with open(tmp, 'wb') as f:
        f.write(data)
    os.replace(tmp, path)
    return dropped


def maptools_dir():
    """The map tools checkout, as the Makefile finds it."""
    if os.environ.get('MAPTOOLS_DIR'):
        return os.environ['MAPTOOLS_DIR']
    local = os.path.join(ROOT, 'maptools.lock.local')
    if os.path.isfile(local):
        with open(local) as f:
            line = f.read().strip()
        if line:
            return line
    return os.path.join(ROOT, '..', 'source-sdk-map-tools')


def face_sides():
    """tools/descent-face-sides as a module: its map checksum and .map2d binding are this rewrite's too."""
    loader = importlib.machinery.SourceFileLoader('descent_face_sides', os.path.join(HERE, 'descent-face-sides'))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def stand_breakables(path):
    """The server's crates and barrels as static props in the preview map at `path`; returns the tool's line."""
    nav = os.path.splitext(path)[0] + '.nav3d'
    if not os.path.isfile(nav):
        raise ValueError('no %s beside the map: the breakables are read from it' % nav)
    sides = face_sides()
    map2d = sides.map2d_of(path)
    with open(path, 'rb') as f:
        before = sides.map_checksum(f.read())
    if os.path.exists(map2d) and sides.recorded_checksum(map2d) != before:
        raise ValueError('%s records map checksum %08x, not %08x (this map before the breakables): it was made for '
                         'another map; link the level again' % (map2d, sides.recorded_checksum(map2d), before))
    build = subprocess.run([DOTNET, 'build', BREAKABLES_PROJECT, '-c', 'Release', '-nologo', '-v', 'q',
                            '-p:MapToolsDir=' + maptools_dir()], cwd=ROOT, capture_output=True, text=True)
    if build.returncode != 0:
        raise ValueError('tools/descent-breakables did not build (exit %d): %s' % (build.returncode, (build.stdout + build.stderr)[-800:]))
    out = subprocess.run([BREAKABLES_BIN, 'preview', path, nav], cwd=ROOT, capture_output=True, text=True)
    if out.returncode != 0:
        raise ValueError('tools/descent-breakables preview failed (exit %d): %s' % (out.returncode, (out.stdout + out.stderr)[-800:]))
    if os.path.exists(map2d):
        with open(path, 'rb') as f:
            after = sides.map_checksum(f.read())
        with open(map2d, 'rb') as f:
            side = bytearray(f.read())
        struct.pack_into('<I', side, sides.MAP2D_CHECKSUM_AT, after)
        sides.write_atomic(map2d, side)
    return out.stdout.strip()


def self_test():
    bad = []
    text = ('{\n"classname" "worldspawn"\n}\n{\n"classname" "info_player_start"\n"origin" "1 2 3"\n}\n'
            '{\n"classname" "info_player_start"\n"origin" "4 5 6"\n}\n{\n"classname" "light"\n}\n')
    new, dropped = keep_first_spawn(text)
    if dropped != 1 or '"1 2 3"' not in new or '"4 5 6"' in new or '"light"' not in new:
        bad.append('the second spawn was not the one dropped, or another entity went')
    try:
        keep_first_spawn('{\n"classname" "worldspawn"\n}\n')
        bad.append('a map without a spawn was accepted')
    except ValueError:
        pass
    # A round trip through a minimal BSP: the lump moves, the text is the kept one.
    with tempfile.TemporaryDirectory() as d:
        path = os.path.join(d, 'm.bsp')
        body = text.encode('latin1') + b'\x00'
        head = bytearray(b'VBSP' + struct.pack('<i', 20) + b'\x00' * (16 * HEADER_LUMPS) + b'\x00\x00\x00\x00')
        struct.pack_into('<iiii', head, 8, len(head), len(body), 0, 0)
        with open(path, 'wb') as f:
            f.write(head + body)
        if rewrite(path) != 1:
            bad.append('the rewrite dropped the wrong number of spawns')
        with open(path, 'rb') as f:
            data = f.read()
        off, length = struct.unpack_from('<ii', data, 8)
        kept = data[off:off + length].decode('latin1')
        if kept.count('info_player_start') != 1 or '"1 2 3"' not in kept:
            bad.append('the rewritten lump is not the kept text')
    for b in bad:
        print('descent-preview-spawns self-test: FAIL: ' + b)
    print('descent-preview-spawns self-test: %s' % ('FAIL' if bad else 'ok'))
    return 1 if bad else 0


def main(argv):
    if argv == ['--self-test']:
        return self_test()
    if len(argv) != 1:
        print(__doc__.strip().splitlines()[2], file=sys.stderr)
        return 2
    try:
        dropped = rewrite(argv[0])
        print('descent-preview-spawns: kept the arrival, dropped %d spawn(s) from %s' % (dropped, argv[0]))
        print(stand_breakables(argv[0]))
    except (OSError, ValueError) as e:
        print('descent-preview-spawns: %s' % e, file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))

def cmd_orphans(graph, ghosts, args):
    rows = []
    summary = []
    for side in SIDES:
        if not graph.by_side[side]:
            continue
        if args.side and args.side != side:
            continue
        syms = Symbols(graph, side)
        # Every symbol imported by ANY live object on this side.
        imported = set(syms.importer)
        n_orphan = 0
        for obj in sorted(syms.defs, key=objkey):
            d = syms.defs[obj]
            if not d:
                # Defines nothing at all: a TU that is pure static registration
                # or entirely inlined. Reported with 0/0, never as "used".
                rows.append("\t".join([side, object_name(obj),
                                       syms.source_of(obj), "0", "0", "ORPHAN"]))
                n_orphan += 1
                continue
            # A symbol this object defines and some OTHER live object imports.
            used = set()
            for s in d:
                importers = syms.importer.get(s, set())
                if importers - {obj}:
                    used.add(s)
            if not used:
                rows.append("\t".join([side, object_name(obj),
                                       syms.source_of(obj), str(len(d)), "0",
                                       "ORPHAN"]))
                n_orphan += 1
            elif args.all:
                rows.append("\t".join([side, object_name(obj),
                                       syms.source_of(obj), str(len(d)),
                                       str(len(used)), "USED"]))
        summary.append("ORPHANS\t%s\t%d of %d live objects define nothing any "
                       "other live object imports"
                       % (side, n_orphan, len(syms.defs)))

    out = header(graph, ghosts, ["orphans"] + _side_argv(args))
    out.append("# An ORPHAN is a live object none of whose defined symbols any")
    out.append("# OTHER live object imports. It is a DELETION CANDIDATE, not a")
    out.append("# proof of deadness: a virtual call through a vtable the engine")
    out.append("# owns, a static-init registration, an inlined header body and a")
    out.append("# data-only dependency all appear here as nothing at all. Every")
    out.append("# entry point the engine resolves by name (ServerGameDLL012, the")
    out.append("# EXPOSE_INTERFACE objects, the IGameSystem registrations) is an")
    out.append("# orphan by this measure and must not be deleted on it.")
    out.append("#")
    out.append("# TAKE THIS LIST ON THE DEBUG GRAPH, OR ON BOTH -- NEVER ON")
    out.append("# RELEASE ALONE. Release inlines across TU boundaries that debug")
    out.append("# does not, so a TU whose every caller inlined it has no importer")
    out.append("# left and reads as an orphan. Measured at 427517057:")
    out.append("#   debug   server 16 / 143   client 52 / 271")
    out.append("#   release server 16 / 143   client 54 / 271")
    out.append("# The two extra release orphans are client bone_accessor.o and")
    out.append("# networkvar.o, both of which debug shows as imported. Deleting")
    out.append("# on the release reading would have taken two live files.")
    out.append("# columns: side\tobject\tsource\tdefines\timported_by_others\tverdict")
    out.extend("# %s" % s for s in summary)
    out.extend(rows)
    print("\n".join(out))
    return rows


# ---------------------------------------------------------------------------
# passthrough  (plan_shim.md step 3g) -- REPORT ONLY
# ---------------------------------------------------------------------------

_LINE_COMMENT = re.compile(r"//[^\n]*")
_BLOCK_COMMENT = re.compile(r"/\*.*?\*/", re.S)


def strip_code(text):
    """Remove comments and string/char literals, preserving newline count.

    Prose counted as code has bitten this port repeatedly; every token count
    below runs on this output, never on raw source.
    """
    def keep_nl(m):
        return "\n" * m.group(0).count("\n")
    text = _BLOCK_COMMENT.sub(keep_nl, text)
    text = _LINE_COMMENT.sub("", text)
    out = []
    i = 0
    n = len(text)
    while i < n:
        c = text[i]
        if c in "\"'":
            q = c
            i += 1
            while i < n and text[i] != q:
                if text[i] == "\\":
                    i += 1
                i += 1
            i += 1
            out.append('""')
            continue
        out.append(c)
        i += 1
    return "".join(out)


# A definition, not a declaration: the signature must be followed by `{`.
_ENTRY_RE = re.compile(
    r"(?P<ret>[A-Za-z_][A-Za-z0-9_:<>,\*&\s]*?)\b"
    r"(?P<name>SourceSharp_[A-Za-z0-9_]+)\s*"
    r"\((?P<args>[^;{}]*)\)\s*(?:const\s*)?\{")

_BLITTABLE = re.compile(
    r"^(?:const\s+|volatile\s+|unsigned\s+|signed\s+|struct\s+|enum\s+)*"
    r"(?:void|bool|char|short|int|long|float|double|size_t|ptrdiff_t|"
    r"u?int(?:8|16|32|64)_t|intptr_t|uintptr_t|QAngle_t|"
    r"[A-Za-z_][A-Za-z0-9_]*_t)"
    r"(?:\s*\*+\s*(?:const\s*)?)*$")

# Anything that makes a slot NOT a bare passthrough: shell objects, ehandles,
# the slot table. These are the names the design keeps on the native side on
# purpose (plan_shim.md 3g: "Not for entity ops ... and not for VPhysics").
_STATEFUL = re.compile(
    r"\b("
    r"[A-Za-z_]*[Ss]hell[A-Za-z0-9_]*"
    r"|[A-Za-z_]*Slot[A-Za-z0-9_]*"
    r"|[A-Za-z_]*[Hh]andle[A-Za-z0-9_]*"
    r"|EHANDLE|CBaseHandle|CBaseEntity|CBasePlayer|C_BaseEntity|C_BasePlayer"
    r"|g_[A-Za-z0-9_]+"
    r"|SourceSharpEntitySlot[A-Za-z0-9_]*"
    r"|ToShell|FromShell|ResolveEntity|EntityFromSlot|SlotFromEntity"
    r")\b")

_ENGINE_CALL = re.compile(
    r"\b(" + "|".join(ENGINE_GLOBALS) + r")\s*->\s*([A-Za-z_][A-Za-z0-9_]*)\s*\(")

# Control flow, casts and sizeof are followed by `(` and are not calls.
_NOT_A_CALL = frozenset((
    "if", "while", "for", "switch", "return", "sizeof", "catch", "do", "else",
    "static_cast", "reinterpret_cast", "const_cast", "dynamic_cast",
    "alignof", "decltype", "noexcept", "throw", "case",
))

# Diagnostics that write to a log and to nothing else. They are not shell,
# handle or slot state, so they do not disqualify a body -- but they ARE
# reported in --explain, so a reader can disagree with this list by name.
_DIAGNOSTIC_CALLS = frozenset((
    "SOURCESHARP_TRACE", "Assert", "AssertMsg", "AssertMsg1", "AssertMsg2",
    "VPROF", "VPROF_BUDGET", "Msg", "Warning", "DevMsg", "DevWarning",
    "ConMsg", "COMPILE_TIME_ASSERT", "static_assert", "MEM_ALLOC_CREDIT",
))

# Pure string/buffer marshalling into a caller-owned out-parameter. These
# decide nothing and touch no game state; a body whose only extra calls are
# these is reported as NEAR-passthrough, a bucket of its own.
VERDICT = {"yes": "PASSTHROUGH", "near": "NEAR-PASSTHROUGH", "no": "no"}

_MARSHALLING_CALLS = frozenset((
    "V_strncpy", "V_strcpy", "V_strcat", "V_snprintf", "V_sprintf",
    "Q_strncpy", "Q_strcpy", "Q_strcat", "Q_snprintf", "Q_sprintf",
    "V_strlen", "Q_strlen", "strlen", "memcpy", "V_memcpy", "memset",
    "V_FileBase", "Q_FileBase", "V_StripExtension",
))

_CALL_SITE = re.compile(
    r"(?:(?P<recv>[A-Za-z_][A-Za-z0-9_]*)\s*(?:->|\.)\s*)?"
    r"(?P<fn>[A-Za-z_][A-Za-z0-9_]*)\s*\(")

_DEREF = re.compile(r"(?P<recv>[A-Za-z_][A-Za-z0-9_]*)\s*->\s*(?P<member>[A-Za-z_][A-Za-z0-9_]*)")


def _split_args(s):
    """Split a parameter list on top-level commas (templates/parens nest)."""
    out, depth, cur = [], 0, []
    for ch in s:
        if ch in "(<[":
            depth += 1
        elif ch in ")>]":
            depth -= 1
        if ch == "," and depth == 0:
            out.append("".join(cur))
            cur = []
        else:
            cur.append(ch)
    if "".join(cur).strip():
        out.append("".join(cur))
    return [a.strip() for a in out if a.strip()]


def _param_type(decl):
    """Strip the parameter NAME and any array suffix, leaving the type."""
    d = decl.strip()
    d = re.sub(r"\s*=\s*[^,]+$", "", d)          # default argument
    d = re.sub(r"\[\s*\d*\s*\]\s*$", "*", d)     # T a[] -> T*
    # drop a trailing identifier that is the parameter name
    m = re.match(r"^(.*?[\s\*&])([A-Za-z_][A-Za-z0-9_]*)$", d)
    if m and m.group(2) not in ("const", "unsigned", "signed", "long", "short",
                                "int", "char", "void", "float", "double", "bool"):
        d = m.group(1)
    return re.sub(r"\s+", " ", d).strip()


def blittable(decl):
    t = _param_type(decl)
    if not t or t == "void":
        return True, ""
    if "..." in decl:
        return False, "varargs"
    if "&" in t:
        return False, "reference parameter (%s)" % t
    if re.search(r"\b(CUtl|std::|Vector|QAngle|matrix3x4|Quaternion|"
                 r"KeyValues|CBase|C_Base|I[A-Z])", t) and "*" not in t:
        return False, "by-value class type (%s)" % t
    if _BLITTABLE.match(t):
        return True, ""
    if t.endswith("*"):
        base = t.rstrip("* ").strip()
        if re.search(r"\b(CUtl|std::|KeyValues)", base):
            return False, "pointer to non-blittable (%s)" % t
        return True, ""
    return False, "not blittable (%s)" % t


class Entry(object):
    def __init__(self, name, path, line, args, body):
        self.name = name
        self.path = path
        self.line = line
        self.args = args
        self.body = body
        self.verdict = None
        self.reason = ""
        self.evidence = []


def find_entries(roots):
    """Every SourceSharp_* DEFINITION under roots, body read brace-balanced."""
    entries = []
    unparsed = []
    for root in roots:
        for dirpath, _dirs, files in os.walk(root):
            for f in sorted(files):
                if not f.endswith((".cpp", ".cc")):
                    continue
                p = os.path.join(dirpath, f)
                try:
                    raw = open(p, "r", errors="replace").read()
                except OSError:
                    continue
                if "SourceSharp_" not in raw:
                    continue
                code = strip_code(raw)
                for m in _ENTRY_RE.finditer(code):
                    open_at = code.index("{", m.end() - 1)
                    body, ok = _balanced(code, open_at)
                    rel = os.path.relpath(p, ROOT)
                    lineno = code.count("\n", 0, m.start()) + 1
                    if not ok:
                        unparsed.append("%s:%d\t%s" % (rel, lineno, m.group("name")))
                        continue
                    entries.append(Entry(m.group("name"), rel, lineno,
                                         m.group("args"), body))
    return entries, unparsed


def _balanced(code, open_at):
    depth = 0
    for i in range(open_at, len(code)):
        if code[i] == "{":
            depth += 1
        elif code[i] == "}":
            depth -= 1
            if depth == 0:
                return code[open_at + 1:i], True
    return "", False


def _extra_arrows(body):
    """Every `x->y` whose receiver is not an engine global, sorted and unique."""
    return sorted(set(
        "%s->%s" % (m.group("recv"), m.group("member"))
        for m in _DEREF.finditer(body)
        if m.group("recv") not in ENGINE_GLOBALS))


def classify(e):
    """Assign exactly one bucket. The buckets are a PARTITION (see header).

    The checks are ORDERED and the first that fires names the bucket, so a body
    rejected for its arguments is never also counted as a rejection for its
    calls. That is what makes the buckets sum to the population.

    Checks 4 and 5 were added after --explain caught two false positives in the
    first version, which the eye would not have caught in a 25-row table:

      SourceSharp_AreaPortalSetOpen  resolved a token to a CAreaPortal, wrote
                                     pPortal->m_bOpen, THEN called the engine
      SourceSharp_ClientEntityModelType  resolved an entity from an index and
                                     called a virtual on it before the engine

    Neither is a passthrough by 3g's own words -- both touch handle state --
    and neither tripped the name-based _STATEFUL filter, because the state they
    touch is named AreaPortalFromToken and ClientEntityFromIndex. A body that
    forwards its arguments does not need to call anything else or dereference
    anything, so "any other call" and "any other arrow" are the checks that
    actually mean what 3g means.
    """
    for a in _split_args(e.args):
        ok, why = blittable(a)
        if not ok:
            e.verdict, e.reason = "no", "args: " + why
            e.evidence.append("parameter: %s" % a.strip())
            return e

    calls = [(m.group(1), m.group(2)) for m in _ENGINE_CALL.finditer(e.body)]
    if len(calls) == 0:
        e.verdict, e.reason = "no", "no engine-global call"
        return e
    if len(calls) > 1:
        e.verdict = "no"
        e.reason = "%d engine-global calls" % len(calls)
        e.evidence = ["%s->%s" % (g, f) for g, f in calls]
        return e

    stateful = sorted(set(m.group(0) for m in _STATEFUL.finditer(e.body)))
    stateful = [s for s in stateful if s not in ENGINE_GLOBALS]
    if stateful:
        e.verdict = "no"
        e.reason = "touches shell/handle/slot state"
        e.evidence = stateful[:6]
        return e

    # 4. Any call that is not THE engine call and not a pure diagnostic.
    others = []
    for m in _CALL_SITE.finditer(e.body):
        fn, recv = m.group("fn"), m.group("recv")
        if recv in ENGINE_GLOBALS:
            continue
        if fn in _NOT_A_CALL or fn in _DIAGNOSTIC_CALLS:
            continue
        if recv is None and fn in ENGINE_GLOBALS:
            continue
        others.append("%s%s()" % (recv + "->" if recv else "", fn))
    if others:
        # A body whose ONLY other calls are string/buffer marshalling into a
        # caller-owned out-parameter is not a strict passthrough, and saying
        # so in one bucket would be a real loss: those are the bodies whose
        # whole content is "call the engine and copy the answer out", which is
        # what a bound vtable would do for free. They get their OWN verdict --
        # not folded into PASSTHROUGH, not folded into the rejection -- so the
        # step-3g reader gets both numbers and can see which rows are which.
        bare = [o.split("(")[0] for o in others]
        if all(b in _MARSHALLING_CALLS for b in bare) and not _extra_arrows(e.body):
            e.verdict = "near"
            e.reason = "passthrough + marshalling (%s)" % ", ".join(sorted(set(bare)))
            e.evidence = ["%s->%s" % calls[0]] + sorted(set(others))
            return e
        e.verdict = "no"
        e.reason = "calls other native code"
        e.evidence = sorted(set(others))[:6]
        return e

    # 5. Any arrow that is not THE engine call: a resolved pointer, a member
    #    read or a member write. A forwarding body has none.
    arrows = _extra_arrows(e.body)
    if arrows:
        e.verdict = "no"
        e.reason = "dereferences a native object"
        e.evidence = arrows[:6]
        return e

    e.verdict = "yes"
    e.reason = "one %s->%s call, blittable args, nothing else" % calls[0]
    e.evidence = ["%s->%s" % calls[0]]
    return e


# plan_shim.md 3g carves two families OUT of the rebinding route regardless of
# what the body looks like: entity ops (handle->shell resolution is the slot
# table's single-writer design) and VPhysics (ids-with-serials, per
# plan_entity.md 3.8). Mechanically-passthrough rows in those families are
# still printed -- this is a report -- but they are FLAGGED, so nobody reads
# the total as a work queue.
_EXCLUDED_3G = re.compile(
    r"^SourceSharp_(?:Client)?(?:Entity|Entities|Standalone|Player|Players|"
    r"Phys|Physics|Constraint|Motion|Collision)")


def excluded_by_3g(name):
    return bool(_EXCLUDED_3G.match(name))


def slot_assignments():
    """`engineApi.X = SourceSharp_Y;` -- the slot table, for the cross-check."""
    p = os.path.join(SRC, "sourcesharp", "game", "shared",
                     "sourcesharp_gamesystem.cpp")
    out = {}
    if not os.path.exists(p):
        return out
    code = strip_code(open(p, "r", errors="replace").read())
    for m in re.finditer(r"(\w+)\s*\.\s*(\w+)\s*=\s*(SourceSharp_\w+)\s*;", code):
        out[m.group(3)] = "%s.%s" % (m.group(1), m.group(2))
    return out


def cmd_passthrough(graph, ghosts, args):
    roots = [os.path.join(SRC, "sourcesharp")]
    entries, unparsed = find_entries(roots)
    for e in entries:
        classify(e)

    buckets = {}
    for e in entries:
        key = {"yes": "PASSTHROUGH", "near": "NEAR-PASSTHROUGH"}.get(
            e.verdict, e.reason.split("(")[0].split(":")[0].strip())
        buckets[key] = buckets.get(key, 0) + 1

    slots = slot_assignments()
    found = set(e.name for e in entries)
    unresolved = sorted(n for n in slots if n not in found)

    notes = [
        "PASSTHROUGH IS A REPORT. Nothing here is a licence to delete or",
        "rebind anything; plan_shim.md 3g is the step that acts on it.",
        "population\t%d SourceSharp_* definitions under src/sourcesharp" % len(entries),
        "unparsed\t%d bodies that did not brace-balance%s"
        % (len(unparsed), "" if not unparsed else " -- THE COUNT BELOW IS NOT TRUSTWORTHY"),
        "slot assignments\t%d engineApi.* = SourceSharp_*;" % len(slots),
        "unresolved\t%d assigned slots whose body this scanner did not find"
        % len(unresolved),
    ]
    for u in unparsed[:20]:
        notes.append("unparsed\t%s" % u)
    for u in unresolved[:20]:
        notes.append("unresolved\t%s\t%s" % (u, slots[u]))
    notes.append("-- buckets, which PARTITION the population --")
    total = 0
    for k in sorted(buckets, key=lambda x: -buckets[x]):
        notes.append("bucket\t%-34s\t%d" % (k, buckets[k]))
        total += buckets[k]
    n_pass = sum(1 for e in entries if e.verdict == "yes")
    n_near = sum(1 for e in entries if e.verdict == "near")
    n_excl = sum(1 for e in entries if e.verdict == "yes" and excluded_by_3g(e.name))
    notes.append("passthrough\t%d strictly passthrough (one engine call and "
                 "nothing else at all)" % n_pass)
    notes.append("near-passthrough\t%d also copy the answer into a "
                 "caller-owned buffer and do nothing else" % n_near)
    notes.append("3g carve-out\t%d of those are entity/physics ops, which "
                 "plan_shim.md 3g excludes from rebinding by design" % n_excl)
    notes.append("3g actionable\t%d -- this is the number step 3g is about"
                 % (n_pass - n_excl))
    notes.append("bucket sum\t%d\t%s" % (total, "== population" if total == len(entries)
                                        else "!= population -- BUG"))

    if args.explain:
        hits = [e for e in entries if e.name == args.explain]
        if not hits:
            die("no SourceSharp_* definition named %s under src/sourcesharp"
                % args.explain)
        out = header(graph, ghosts, ["passthrough", "--explain", args.explain])
        for e in hits:
            out.append("# %s\t%s:%d" % (e.name, e.path, e.line))
            out.append("# verdict\t%s" % VERDICT[e.verdict])
            out.append("# reason\t%s" % e.reason)
            for ev in e.evidence:
                out.append("# evidence\t%s" % ev)
            out.append("# args\t%s" % re.sub(r"\s+", " ", e.args).strip())
            out.append("# slot\t%s" % slots.get(e.name, "(not assigned to a slot)"))
            out.append("# --- body as the classifier saw it (comments and string")
            out.append("# --- literals removed) ---")
            for ln in e.body.strip().splitlines():
                out.append("# | %s" % ln.rstrip())
        print("\n".join(out))
        return entries

    out = header(graph, ghosts, ["passthrough"] + _side_argv(args), notes)
    out.append("# columns: entry_point\tverdict\t3g_policy\treason\tslot\tsource\tline")
    order = {"yes": 0, "near": 1}
    for e in sorted(entries, key=lambda x: (order.get(x.verdict, 2), x.name)):
        if args.only_passthrough and e.verdict not in ("yes", "near"):
            continue
        out.append("\t".join([
            e.name,
            VERDICT[e.verdict],
            "EXCLUDED_BY_3G" if excluded_by_3g(e.name) else "-",
            e.reason,
            slots.get(e.name, "-"),
            e.path,
            str(e.line),
        ]))
    print("\n".join(out))
    return entries


# ---------------------------------------------------------------------------
# --self-test
# ---------------------------------------------------------------------------

_PASS = []
_FAIL = []


def ok(cond, what):
    (_PASS if cond else _FAIL).append(what)
    sys.stderr.write("  %s  %s\n" % ("ok  " if cond else "FAIL", what))


def _run_self(argv, cwd=None):
    """Re-enter this script as a subprocess so the refusal's EXIT CODE is what
    is asserted, not an internal return value. A refusal that prints but exits
    0 is the exact failure this tool exists to prevent."""
    p = subprocess.run([sys.executable, os.path.abspath(__file__)] + argv,
                       capture_output=True, text=True, cwd=cwd or ROOT)
    return p.returncode, p.stdout, p.stderr


def self_test():
    sys.stderr.write("shim-census --self-test\n")

    # -------------------------------------------------------------------
    # demangled_base: the helper behind who-imports' name matching.
    #
    # Its absence is what made `who-imports <C++ function name>` answer a
    # confident 0 for every function in the tree -- c++filt returns a full
    # signature, the old code compared it to the bare name, nothing ever
    # matched, and the fallback reported no importers. Variables were
    # unaffected, which is why it lived so long.
    # -------------------------------------------------------------------
    _t = [
        ("SourceSharp_HltvCameraAvailable()", "SourceSharp_HltvCameraAvailable"),
        ("CFoo::Bar(int) const",              "CFoo::Bar"),
        ("CFoo::Bar()",                       "CFoo::Bar"),
        ("Plain",                             "Plain"),
        # A template argument carrying parentheses: cutting at the LAST `(`
        # would keep half the signature; cutting at the first TOP-LEVEL one
        # is what makes this right.
        ("CUtlVector<int (*)(char)>::Frob(int)", "CUtlVector<int (*)(char)>::Frob"),
        # THE CASE THAT DISCRIMINATES. A function-pointer ARGUMENT puts the
        # last `(` inside the signature, so cutting at the last one yields
        # "CFoo::Frob(int (*)" -- a wrong answer that still looks like a name.
        # Without this row a naive rfind passes every other row here, which it
        # did when this was first written.
        ("CFoo::Frob(int (*)(char))", "CFoo::Frob"),
    ]
    for _d, _want in _t:
        _got = demangled_base(_d)
        ok(_got == _want,
           "demangled_base(%r) is %r%s"
           % (_d, _want, "" if _got == _want else " -- got %r" % (_got,)))

    tmp = tempfile.mkdtemp(prefix="shim-census-selftest-")
    try:
        # A fake CMake build: farm/debug/{src,build,tools} plus a stand-in repo
        # whose CMakeLists name the sources. The server link edge names two
        # objects, one present and one missing; the client's names one.
        cfg = "debug"
        farm = os.path.join(tmp, "farm", cfg)
        bdir = os.path.join(farm, "build")
        repo = os.path.join(tmp, "repo")
        now = time.time()
        srcs = {"server": ["sourcesharp/game/server/present.cpp",
                           "sourcesharp/game/server/absent.cpp"],
                "client": ["sourcesharp/game/client/present_c.cpp"]}
        objdir = {}
        entries, ninja_text = [], []
        for side, files in sorted(srcs.items()):
            target = "%s_sourcesharp" % side
            listing = os.path.join(repo, "src", side, "native", "CMakeLists.txt")
            os.makedirs(os.path.dirname(listing))
            with open(listing, "w") as fh:
                fh.write("set(%s_sources\n    %s\n)\n" % (target, "\n    ".join(files)))
            rel_dir = "src/%s/native/CMakeFiles/%s.dir" % (side, target)
            objdir[side] = os.path.join(bdir, rel_dir)
            os.makedirs(objdir[side])
            outs = []
            for f in files:
                sp = os.path.join(farm, "src", f)
                os.makedirs(os.path.dirname(sp), exist_ok=True)
                open(sp, "w").write("int x;\n")
                os.utime(sp, (now - 120, now - 120))
                out = "%s/%s.o" % (rel_dir, os.path.basename(f))
                outs.append(out)
                entries.append({"directory": bdir, "command": "c++ -c " + sp,
                                "file": sp, "output": out})
            ninja_text.append(
                "build out/%s.so: CXX_SHARED_LIBRARY_LINKER__%s_Debug %s\n"
                "  LINK_LIBRARIES = -lmanaged_host\n\n"
                % (side, target, " ".join(outs)))
        import json
        with open(os.path.join(bdir, "compile_commands.json"), "w") as fh:
            json.dump(entries, fh)
        ninja = os.path.join(bdir, "build.ninja")
        with open(ninja, "w") as fh:
            fh.write("".join(ninja_text))
        os.utime(ninja, (now - 90, now - 90))

        def put(side, name):
            o = os.path.join(objdir[side], name)
            open(o, "wb").write(b"")
            os.utime(o, (now - 60, now - 60))
            return o

        put("server", "present.cpp.o")
        put("client", "present_c.cpp.o")
        # absent.cpp.o deliberately NOT created.

        # The tool must be reachable from the fixture's own farm, because ROOT
        # (and so the default build dir) is derived from the script's location.
        # Copy it in, with the reader it imports.
        os.makedirs(os.path.join(farm, "tools"))
        shutil.copy(os.path.abspath(__file__), os.path.join(farm, "tools", "shim-census"))
        shutil.copy(os.path.join(os.path.dirname(os.path.realpath(__file__)), "cmakegraph.py"),
                    os.path.join(farm, "tools", "cmakegraph.py"))
        fixture_tool = os.path.join(farm, "tools", "shim-census")
        env = dict(os.environ, SOURCESHARP_REPO=repo, PYTHONDONTWRITEBYTECODE="1")
        env.pop("SOURCESHARP_BUILD_DIR", None)

        def run(argv):
            p = subprocess.run([sys.executable, fixture_tool] + argv,
                               capture_output=True, text=True, cwd=tmp, env=env)
            return p.returncode, p.stdout, p.stderr

        # 1. THE REFUSAL. absent.cpp.o is on the link edge and is not on disk.
        rc, out, err = run(["orphans"])
        ok(rc != 0, "a graph naming a missing object refuses (exit %d)" % rc)
        ok("not on disk" in err,
           "the refusal names the problem: %r" % err.strip().splitlines()[:1])
        ok("absent.o" in err, "the refusal names the missing object (VPC's name)")
        ok(not out.strip(), "a refused run prints NO answer on stdout")

        # 2. MUTATION-VERIFY THE RED PATH. Create absent.cpp.o and the same
        #    command must now succeed -- otherwise assertion 1 passes for some
        #    other reason and proves nothing about the missing-object check.
        put("server", "absent.cpp.o")
        rc2, out2, err2 = run(["orphans"])
        ok(rc2 == 0,
           "the SAME command passes once the object exists (exit %d) -- so the "
           "refusal was about the missing object %s" % (rc2, err2.strip()[:120]))
        ok("# tip\t" in out2, "a successful run stamps the tip it measured")
        ok("# objects\tserver\t2 on the graph" in out2,
           "the server count is read off the link edge (2)")
        ok("\tabsent.o\tsourcesharp/game/server/absent.cpp\t" in out2,
           "a row names the object by VPC's name and its farm-relative source")

        # 3. STALE: a source edited after its object was built.
        sp = os.path.join(farm, "src", srcs["server"][0])
        os.utime(sp, None)
        rc3, out3, err3 = run(["orphans"])
        ok(rc3 != 0, "an object OLDER than its source refuses (exit %d)" % rc3)
        ok("OLDER than the source" in err3 and "present.o" in err3,
           "the stale refusal says why, and names the object")
        ok(not out3.strip(), "a stale run prints no answer either")
        rc3o, _, _ = run(["orphans", "--mtime-policy", "off"])
        ok(rc3o == 0, "--mtime-policy off measures that tree (exit %d)" % rc3o)
        os.utime(sp, (now - 120, now - 120))

        # 3b. graph-newer, kept as an option: build.ninja newer than objects.
        os.utime(ninja, None)
        rc3g, _, err3g = run(["orphans", "--mtime-policy", "graph-newer"])
        ok(rc3g != 0 and "graph-newer" in err3g,
           "--mtime-policy graph-newer refuses objects older than build.ninja")
        rc3d, _, _ = run(["orphans"])
        ok(rc3d == 0, "and the default does not: a re-configure after a list "
                      "edit rewrites build.ninja without recompiling (exit %d)" % rc3d)
        os.utime(ninja, (now - 90, now - 90))

        # 4. GHOSTS are reported, not fatal -- and they are what `ls` counts.
        put("server", "ghost.cpp.o")
        rc4, out4, _ = run(["orphans"])
        ok(rc4 == 0, "a ghost object does not refuse the run")
        ok("1 ghost" in out4, "the header counts the ghost")
        ok("# ghost\tserver\tghost.o" in out4, "the header NAMES the ghost")
        rc4s, _, err4s = run(["orphans", "--strict"])
        ok(rc4s != 0, "--strict promotes a ghost to a refusal (exit %d)" % rc4s)
        # The MESSAGE, not just the code: the first version of this tool put
        # --strict on the top-level parser only, so this invocation died in
        # argparse with exit 2 and the assertion above passed without the
        # check ever running.
        ok("ghost object(s) on disk" in err4s,
           "--strict AFTER the subcommand reaches the ghost check, not argparse")
        rc4p, _, err4p = run(["--strict", "orphans"])
        ok("ghost object(s) on disk" in err4p,
           "--strict BEFORE the subcommand reaches it too")
        # --side is a VALUE flag, so the subparser-default bug silences it
        # rather than erroring. The per-side summary row is the witness:
        # present for the side asked, absent for the other.
        _rc, out_srv, _ = run(["orphans", "--side", "server"])
        _rc, out_cli, _ = run(["orphans", "--side", "client"])
        ok("# ORPHANS\tserver" in out_srv and "# ORPHANS\tclient" not in out_srv,
           "--side server measures server only")
        ok("# ORPHANS\tserver" not in out_cli and "# ORPHANS\tclient" in out_cli,
           "--side client after the subcommand is not overwritten by a "
           "subparser default")

        # 4b. --build-dir reaches the build it names: a copy measured through
        #     the flag answers, a wrong one refuses.
        rc4b, out4b, _ = run(["orphans", "--build-dir", bdir])
        ok(rc4b == 0 and "# objects\tserver\t2 on the graph" in out4b,
           "--build-dir <the build> measures it (exit %d)" % rc4b)
        rc4w, _, _ = run(["orphans", "--build-dir", os.path.join(tmp, "nowhere")])
        ok(rc4w != 0, "--build-dir <nothing> refuses (exit %d)" % rc4w)

        # 5. The literal Phase 1a mtime rule, kept as an option, fires on a
        #    perfectly good tree -- which is why it is not the default.
        rc5, _, err5 = run(["orphans", "--mtime-policy", "objects-older"])
        ok(rc5 != 0, "--mtime-policy objects-older refuses a freshly built tree")
        ok("fires on every successful build" in err5,
           "and says so, so nobody takes the header on trust")

        # 6. A source list that disagrees with the compile database (a list
        #    edited and the build not re-run) is a refusal.
        listing = os.path.join(repo, "src", "server", "native", "CMakeLists.txt")
        good = open(listing).read()
        with open(listing, "w") as fh:
            fh.write(good.replace(")\n", "    sourcesharp/game/server/added.cpp\n)\n"))
        rc6l, out6l, err6l = run(["orphans"])
        ok(rc6l != 0 and "disagrees" in err6l,
           "a list naming a source the build never compiled refuses (exit %d)" % rc6l)
        ok(not out6l.strip(), "and answers nothing")
        with open(listing, "w") as fh:
            fh.write(good)

        # 7. An empty graph is a refusal, not an empty answer.
        with open(ninja, "w") as fh:
            fh.write("# no build edges at all\n")
        os.utime(ninja, (now - 90, now - 90))
        rc6, out6, err6 = run(["orphans"])
        ok(rc6 != 0, "a graph with no shim link edge refuses (exit %d)" % rc6)
        ok("no link edge" in err6, "and says so: %r" % err6.strip()[:100])
        ok(not out6.strip(), "and answers nothing")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    # -- pure units, no tree needed ----------------------------------------
    sha, dirty = tip()
    ok(isinstance(dirty, list),
       "tip() reports the dirty PATHS, not a bare flag -- a census written "
       "into the tree is itself one of them")
    ok(len(sha) == 40 or sha == "UNKNOWN",
       "tip() reports a full sha (or says UNKNOWN, never a blank)")
    # A truncated path is the failure this catches: `git status --porcelain`
    # writes " M path" for an unstaged edit, and stripping that leading space
    # before slicing off the status columns turns tools/x into ools/x. A
    # reported path that is neither on disk nor a deletion git knows about is
    # a parse bug, not a dirty file.
    bad = [d for d in dirty
           if not os.path.exists(os.path.join(ROOT, d))
           and not git("ls-files", "--deleted", "--", d)]
    ok(not bad, "every dirty path reported is a real path (offenders: %s)"
                % (bad[:3] or "none"))

    ok(_normalise_source("src/game/shared/util_shared.cpp")
       == _normalise_source("game/shared/util_shared.cpp"),
       "a source path resolves from the repo root or from src/")

    ok(blittable("int nIndex")[0], "int is blittable")
    ok(blittable("const char *pszModel")[0], "const char* is blittable")
    ok(blittable("const float *pXYZ")[0], "const float* is blittable")
    ok(not blittable("const Vector &vecOrigin")[0], "const Vector& is not")
    ok(not blittable("CUtlVector<int> v")[0], "a by-value CUtlVector is not")
    ok(not blittable("...")[0], "varargs are not")
    ok(blittable("uint32_t h")[0], "uint32_t is blittable")

    ok(strip_code('int x; // engine->Foo()\n').find("engine->") == -1,
       "a call in a COMMENT is not a call")
    ok(strip_code('const char *s = "engine->Foo()";').find("engine->") == -1,
       "a call in a STRING LITERAL is not a call")
    ok(strip_code("/*\nengine->Foo()\n*/\nint x;").count("\n") == 3,
       "stripping a block comment preserves the line count")

    body_one = "return engine->Time();"
    e = classify(Entry("SourceSharp_X", "f.cpp", 1, "void", body_one))
    ok(e.verdict == "yes", "one engine-> call with no args is passthrough")
    e = classify(Entry("SourceSharp_X", "f.cpp", 1, "void",
                       "engine->Time(); engine->Foo();"))
    ok(e.verdict == "no" and "2 engine" in e.reason,
       "two engine-> calls is not passthrough")
    e = classify(Entry("SourceSharp_X", "f.cpp", 1, "void",
                       "CBaseEntity *p = ShellFor(h); return engine->Time();"))
    ok(e.verdict == "no" and "shell" in e.reason,
       "an engine-> call that first resolves a shell is not passthrough")
    e = classify(Entry("SourceSharp_X", "f.cpp", 1, "const Vector &v",
                       "return engine->Time();"))
    ok(e.verdict == "no" and e.reason.startswith("args"),
       "a reference argument is rejected before the call is counted")
    e = classify(Entry("SourceSharp_X", "f.cpp", 1, "void", "return 0;"))
    ok(e.verdict == "no" and "no engine-global" in e.reason,
       "a body with no engine call is not passthrough")

    # The two false positives the first version of this classifier passed,
    # reduced to their shape. Both were found with `passthrough --explain`.
    e = classify(Entry("SourceSharp_AreaPortalSetOpen", "f.cpp", 1,
                       "uint32_t hPortal, int32_t bOpen",
                       "CAreaPortal *pPortal = AreaPortalFromToken( hPortal );"
                       " if ( !pPortal ) return;"
                       " pPortal->m_bOpen = ( bOpen != 0 );"
                       " engine->SetAreaPortalState( pPortal->m_portalNumber, 1 );"))
    ok(e.verdict == "no",
       "resolving a token and writing its member before the engine call is "
       "NOT passthrough (the real SourceSharp_AreaPortalSetOpen shape)")
    e = classify(Entry("SourceSharp_ClientEntityModelType", "f.cpp", 1,
                       "int32_t nEntity",
                       "IClientEntity *p = SourceSharp_ClientEntityFromIndex( nEntity );"
                       " if ( !p ) return -1;"
                       " const model_t *m = p->GetModel();"
                       " return (int32_t)modelinfo->GetModelType( m );"))
    ok(e.verdict == "no",
       "resolving an entity from an index before the engine call is NOT "
       "passthrough (the real SourceSharp_ClientEntityModelType shape)")

    e = classify(Entry("SourceSharp_X", "f.cpp", 1, "int32_t n",
                       "SOURCESHARP_TRACE(); Assert( n >= 0 );"
                       " return engine->Time( n );"))
    ok(e.verdict == "yes",
       "a trace macro and an Assert are diagnostics, not shell state")

    ok(excluded_by_3g("SourceSharp_EntityGetModelName"),
       "3g's entity carve-out is flagged")
    ok(excluded_by_3g("SourceSharp_PhysicsWake"),
       "3g's VPhysics carve-out is flagged")
    ok(not excluded_by_3g("SourceSharp_AreaPortalSetOpen"),
       "an area portal is not an entity or a physics op")

    got, bad = _balanced("{ if (a) { b(); } }", 0)
    ok(bad and got.count("{") == 1, "a nested body is read to its OWN close brace")
    _b, bad2 = _balanced("{ if (a) {", 0)
    ok(not bad2, "an unbalanced body is reported, not guessed at")

    # -------------------------------------------------------------------
    # intra_tu_callers, against a REAL object built for the purpose.
    #
    # Two questions, and the second is the one that matters. A caller in the
    # same TU must be FOUND -- that is the false 0 this exists to stop. And a
    # function with no caller at all must NOT be reported -- which is the whole
    # justification for filtering to .text sections. Built with -g on purpose:
    # the debug build the census reads emits .debug_info relocations naming
    # every function in the file, so a version of this helper that counted all
    # relocations reports an intra-TU caller for absolutely everything and is a
    # check that cannot fail. `lonely` is that mutation, standing.
    # -------------------------------------------------------------------
    if shutil.which("g++") and shutil.which("objdump"):
        tmp = tempfile.mkdtemp(prefix="shim-census-intratu-")
        try:
            src = os.path.join(tmp, "t.cpp")
            with open(src, "w") as f:
                f.write("void callee() {}\n"
                        "void lonely() {}\n"
                        "void caller() { callee(); }\n")
            obj = os.path.join(tmp, "t.o")
            c = subprocess.run(["g++", "-g", "-O0", "-ffunction-sections",
                                "-c", src, "-o", obj],
                               capture_output=True, text=True)
            if c.returncode != 0:
                ok(False, "intra-TU fixture compiled (%s)" % c.stderr.strip()[:80])
            else:
                nm = subprocess.run(["nm", "--defined-only", obj],
                                    capture_output=True, text=True).stdout
                names = {}
                for ln in nm.splitlines():
                    fs = ln.split()
                    if len(fs) == 3 and fs[1] == "T":
                        for want in ("callee", "lonely", "caller"):
                            if want in fs[2]:
                                names[want] = fs[2]
                ok(len(names) == 3,
                   "intra-TU fixture defines all three probes (%d)" % len(names))
                if len(names) == 3:
                    # objdump is run with cwd=SRC, so hand it an absolute path.
                    got = intra_tu_callers(obj, set(names.values()))
                    ok(got is not None,
                       "intra_tu_callers could read the fixture object")
                    got = got or {}
                    hit = got.get(names["callee"], set())
                    ok(any(names["caller"] in s for s in hit),
                       "a caller in the SAME TU is found (the false 0)")
                    ok(names["lonely"] not in got,
                       "a function nothing calls is NOT reported -- the .text "
                       "filter is load-bearing, .debug_info names every one")
                    ok(names["caller"] not in got,
                       "the caller itself has no intra-TU caller")
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
    else:
        ok(False, "g++/objdump absent -- intra_tu_callers went UNMEASURED, "
                  "which is not the same as passing")

    sys.stderr.write("\n%d passed, %d failed\n" % (len(_PASS), len(_FAIL)))
    return 1 if _FAIL else 0



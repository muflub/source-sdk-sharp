def intra_tu_callers(obj, syms):
    """Which OTHER functions inside `obj` itself call one of `syms`?

    AN INTRA-TU CALL EMITS NO UNDEFINED SYMBOL. A free function whose only
    caller sits in its own translation unit is invisible to every importer
    census -- `nm -u` never names it, so who-imports answers a truthful,
    complete, and thoroughly misleading 0.

    This is not hypothetical. Lane 5e-testonly measured 0 importers on both
    sides for SourceSharp_AcquireReason and was one step from calling it
    test-only: its caller, SourceSharp_SayAcquireReason, is fifty lines further
    down the same .cpp and has a live importer per side. Overlay_BoxAngles and
    Overlay_SegmentIsVisible have the identical shape.

    A call leaves a relocation in the CALLER's .text section. Section-per-
    function (-ffunction-sections, which this build uses) then names the caller
    outright. RELOCATIONS OUTSIDE .text DO NOT COUNT: a debug build emits
    .debug_info relocations against every function in the file, and counting
    those reports an intra-TU caller for absolutely everything -- Overlay_
    ResetPool, which has none, reads 8 that way.
    """
    p = subprocess.run(["objdump", "-r", obj], cwd=SRC,
                       capture_output=True, text=True)
    if p.returncode != 0:
        return None                      # cannot measure; the caller says so
    out = {}
    section, in_text = None, False
    for line in p.stdout.splitlines():
        m = re.match(r"RELOCATION RECORDS FOR \[([^\]]+)\]", line)
        if m:
            section = m.group(1)
            in_text = section.startswith(".text")
            continue
        if not in_text:
            continue
        for s in syms:
            # A function calling ITSELF is recursion, not a second consumer.
            if s in line and not section.endswith(s):
                out.setdefault(s, set()).add(section)
    return out


def _nm(args, objs):
    """Run nm over a batch of objects, yielding (obj, line) pairs.

    --print-file-name is used so one nm invocation covers the whole side; the
    per-object grouping that `nm obj1 obj2` prints with blank-line headers is
    fragile and has mis-attributed symbols before.
    """
    if not objs:
        return
    CHUNK = 200
    for i in range(0, len(objs), CHUNK):
        batch = objs[i:i + CHUNK]
        p = subprocess.run(["nm", "--print-file-name"] + args + batch,
                           cwd=SRC, capture_output=True, text=True)
        for line in p.stdout.splitlines():
            # "<obj>:<addr> <type> <name>"  or  "<obj>:         U <name>"
            head, sep, rest = line.partition(":")
            if not sep:
                continue
            yield head, rest


class Symbols(object):
    """Defined and undefined symbol sets per object, joined MANGLED."""

    def __init__(self, graph, side):
        self.graph = graph
        self.side = side
        objs = sorted(graph.by_side[side], key=objkey)
        self.defs = {}    # obj -> set(mangled)
        self.undef = {}   # obj -> set(mangled)
        self.definer = {} # mangled -> set(obj)
        self.importer = {}# mangled -> set(obj)

        for obj in objs:
            self.defs[obj] = set()
            self.undef[obj] = set()

        # Definitions, type-filtered. Method rule 2.
        for obj, rest in _nm(["--defined-only"], objs):
            f = rest.split()
            if len(f) >= 3 and f[1] in DEFINED_TYPES:
                self.defs.setdefault(obj, set()).add(f[2])
            elif len(f) == 2 and f[0] in DEFINED_TYPES:
                # common-symbol / no-address form
                self.defs.setdefault(obj, set()).add(f[1])

        # Undefined references.
        for obj, rest in _nm(["-u"], objs):
            f = rest.split()
            if len(f) >= 2 and f[-2] == "U":
                self.undef.setdefault(obj, set()).add(f[-1])
            elif len(f) == 2 and f[0] == "U":
                self.undef.setdefault(obj, set()).add(f[1])

        for obj, syms in self.defs.items():
            for s in syms:
                self.definer.setdefault(s, set()).add(obj)
        for obj, syms in self.undef.items():
            for s in syms:
                self.importer.setdefault(s, set()).add(obj)

    def source_of(self, obj):
        return self.graph.by_side[self.side].get(obj, obj)

    def objects_for_source(self, path):
        """Objects compiled FROM this source path (usually 0 or 1)."""
        want = _normalise_source(path)
        hits = []
        for obj, src in self.graph.by_side[self.side].items():
            if _normalise_source(src) == want:
                hits.append(obj)
        return sorted(hits)


def _normalise_source(p):
    """Compare sources the way a human names them.

    The graph names sources relative to src/ ("game/shared/util_shared.cpp");
    the rulings table and every human names them from the repo root
    ("src/game/shared/util_shared.cpp"). Both resolve here, and so does a bare
    basename.
    """
    p = p.strip().replace("\\", "/")
    if p.startswith("./"):
        p = p[2:]
    if p.startswith("src/"):
        p = p[4:]
    return p


def demangle(names):
    """Batch c++filt. Display only -- the JOIN is always mangled (rule 3)."""
    names = list(names)
    if not names:
        return {}
    p = subprocess.run(["c++filt"], input="\n".join(names) + "\n",
                       capture_output=True, text=True)
    out = p.stdout.splitlines()
    if len(out) != len(names):
        return {n: n for n in names}
    return dict(zip(names, out))


def demangled_base(d):
    """`CFoo::Bar(int) const` -> `CFoo::Bar`. The name without its signature.

    c++filt hands back a full signature, so any comparison against the bare
    name a human types has to strip the argument list first. Done by scanning
    from the LEFT and cutting at the first top-level `(` -- templates can carry
    parentheses inside `<>` and a naive rfind would cut in the wrong place.
    """
    depth = 0
    for i, c in enumerate(d):
        if c == "<":
            depth += 1
        elif c == ">":
            depth -= 1
        elif c == "(" and depth == 0:
            return d[:i].strip()
    return d.strip()



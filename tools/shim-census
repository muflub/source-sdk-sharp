def git(*args, **kw):
    """`strip=False` matters: --porcelain's status letters live in columns 0-1
    and an unstaged edit is " M path", so .strip() eats the leading space and
    every path afterwards loses its first character. That shipped once and
    printed `ools/shim-census`."""
    strip = kw.pop("strip", True)
    try:
        out = subprocess.run(
            ["git", "-C", ROOT] + list(args),
            capture_output=True, text=True, check=False)
    except OSError:
        return ""
    if out.returncode != 0:
        return ""
    return out.stdout.strip() if strip else out.stdout


def tip():
    """(sha, dirty_paths) for the tree this run measured.

    The PATHS, not just a flag: a census written INTO the tree makes the tree
    dirty by existing, and a bare DIRTY on that run would read as an unmeasured
    edit. Listing them lets a reader tell the two apart.
    """
    sha = git("rev-parse", "HEAD") or "UNKNOWN"
    status = git("status", "--porcelain", strip=False)
    paths = [ln[3:].strip() for ln in status.splitlines() if ln.strip()]
    return sha, paths



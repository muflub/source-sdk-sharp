def cmd_who_imports(graph, ghosts, args):
    target = args.target
    rows = []
    counts = {}
    notes = []

    looks_like_file = ("/" in target or target.endswith((".cpp", ".h", ".c", ".cc")))

    for side in SIDES:
        if not graph.by_side[side]:
            continue
        if args.side and args.side != side:
            continue
        syms = Symbols(graph, side)

        if looks_like_file:
            owners = syms.objects_for_source(target)
            if not owners:
                # A header defines nothing of its own; its symbols are emitted
                # into whatever TU included it. Say so rather than answering 0.
                notes.append("%s: %s is not a compiled translation unit on this "
                             "side -- 0 objects, so it defines no symbols of its "
                             "own and this answer is vacuous, not a proof of "
                             "deadness. For a header, ask about the symbols it "
                             "declares, or about the .cpp that owns them."
                             % (side, target))
                counts[side] = 0
                continue
            wanted = set()
            for o in owners:
                wanted |= syms.defs[o]
            owners_set = set(owners)
        else:
            wanted = {target}
            if target not in syms.definer:
                # try a demangled match
                #
                # THIS COMPARISON USED TO BE `d == target` AND THAT ANSWERED 0
                # FOR EVERY C++ FUNCTION NAME. c++filt returns
                # "SourceSharp_HltvCameraAvailable()" -- with the argument list
                # -- so an exact compare against the bare name a human types
                # never matched, `wanted` stayed the unmangled string, nothing
                # imported it, and the tool printed a confident 0. The mangled
                # form answered 2 for the same function. Found by lane
                # 5c-drophltv, which re-checked its zeros against an
                # independent script; a lane that trusted the 0 would have
                # deleted a live body. Variables were never affected, which is
                # why it survived: they demangle to a bare name.
                dm = demangle(list(syms.definer))
                hit = [m for m, d in dm.items()
                       if d == target or demangled_base(d) == target]
                if not hit:
                    # A trailing-scope match, so `Bar` finds `CFoo::Bar(int)`.
                    hit = [m for m, d in dm.items()
                           if demangled_base(d).endswith("::" + target)]
                if hit:
                    wanted = set(hit)
                    bases = sorted({demangled_base(dm[m]) for m in hit})
                    if len(bases) > 1:
                        notes.append(
                            "%s: %s is AMBIGUOUS -- it matched %d distinct "
                            "names (%s). The count below sums all of them; ask "
                            "by mangled name to separate them."
                            % (side, target, len(bases), ", ".join(bases)))
                else:
                    # REFUSE. A zero here means "I could not find it", and this
                    # tool's own rule is that a refusal must never be
                    # reportable as a measurement.
                    notes.append(
                        "%s: REFUSED -- no live object defines %s, mangled or "
                        "demangled. This is NOT a consumer count of 0. If it "
                        "is a header, ask tools/shim-header-census; if it is a "
                        "static or an inline, it has no symbol to join on."
                        % (side, target))
                    counts[side] = None
                    continue
            owners_set = set()
            for w in wanted:
                owners_set |= syms.definer.get(w, set())

        importers = {}
        for s in wanted:
            for obj in syms.importer.get(s, ()):
                if obj in owners_set:
                    continue        # a TU importing its own definition is noise
                importers.setdefault(obj, set()).add(s)

        counts[side] = len(importers)

        # A 0 THAT HAS NOT BEEN CHECKED AGAINST THE DEFINING TU IS NOT AN
        # ANSWER. See intra_tu_callers: the one caller may be in the same file,
        # in which case no importer exists and the symbol is fully live.
        if counts[side] == 0 and owners_set:
            found = {}
            unreadable = []
            for o in sorted(owners_set, key=objkey):
                got = intra_tu_callers(o, wanted)
                if got is None:
                    unreadable.append(o)
                    continue
                for s, callers in got.items():
                    found.setdefault(s, set()).update(callers)
            if unreadable:
                notes.append(
                    "%s: could not run objdump -r on %s, so the 0 below is NOT "
                    "checked for a caller inside the defining translation unit "
                    "-- do not read it as deadness."
                    % (side, ", ".join(object_name(o) for o in unreadable)))
            if found:
                for s in sorted(found):
                    callers = sorted(found[s])
                    notes.append(
                        "%s: %s HAS AN INTRA-TU CALLER and is therefore NOT "
                        "dead: %s calls it from inside the same object, which "
                        "emits no undefined symbol and so cannot appear as an "
                        "importer. The 0 below counts OTHER objects only."
                        % (side, s, ", ".join(c[len(".text."):] if
                                              c.startswith(".text.") else c
                                              for c in callers)))

        dm = demangle(sorted({s for v in importers.values() for s in v})) \
            if args.show_demangled else {}
        for obj in sorted(importers, key=objkey):
            shown = sorted(importers[obj])
            if args.show_demangled:
                shown = sorted(dm.get(s, s) for s in shown)
            rows.append("\t".join([
                side,
                object_name(obj),
                syms.source_of(obj),
                str(len(importers[obj])),
                ";".join(shown[:args.max_symbols]),
            ]))

    out = header(graph, ghosts, ["who-imports", target] + _side_argv(args), notes)
    out.append("# columns: side\tobject\tsource\tsymbols_imported\tsymbols")
    for side in SIDES:
        if side in counts:
            if counts[side] is None:
                # A REFUSAL IS NOT A COUNT. Printing 0 here is precisely the
                # defect this branch exists to stop, so the row says REFUSED
                # and the exit status is non-zero.
                out.append("# COUNT\t%s\t%s\tREFUSED -- not a count of 0"
                           % (side, target))
            else:
                out.append("# COUNT\t%s\t%s\t%d object files import it"
                           % (side, target, counts[side]))
    out.extend(rows)
    print("\n".join(out))
    if any(counts.get(sd) is None for sd in SIDES):
        # Exit non-zero so `who-imports X && delete X` cannot proceed on a
        # refusal. A lane reading only the count would otherwise see nothing.
        sys.exit(3)
    return counts


def _side_argv(args):
    return ["--side", args.side] if args.side else []



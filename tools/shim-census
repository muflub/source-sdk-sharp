def header(graph, ghosts, argv, extra=()):
    sha, dirty = tip()
    lines = [
        "# tools/shim-census -- %s" % " ".join(argv),
        "# tip\t%s\t%s" % (
            sha,
            "DIRTY (%d path%s)" % (len(dirty), "" if len(dirty) == 1 else "s")
            if dirty else "clean"),
        "# when\t%s" % time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "# build\t%s" % os.path.relpath(graph.bdir, ROOT),
        "# config\t%s" % graph.config,
    ]
    for d in dirty[:12]:
        lines.append("# dirty\t%s" % d)
    if len(dirty) > 12:
        lines.append("# dirty\t... and %d more" % (len(dirty) - 12))
    for side in SIDES:
        n = len(graph.by_side[side])
        if not n:
            continue
        disk = len(graph.on_disk(side))
        g = len(ghosts.get(side, ()))
        lines.append("# objects\t%s\t%d on the graph\t%d on disk\t%d ghost%s"
                     % (side, n, disk, g, "" if g == 1 else "s"))
    if any(ghosts.values()):
        lines.append("# GHOSTS PRESENT -- objects on disk that the graph does not")
        lines.append("# link. This tool ignores them; a count taken with `ls` would not.")
        for side in SIDES:
            for o in ghosts.get(side, ()):
                lines.append("# ghost\t%s\t%s" % (side, object_name(o)))
    lines.extend("# %s" % e for e in extra)
    return lines



# main
# ---------------------------------------------------------------------------

def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)

    # The common flags live on a PARENT parser and are therefore accepted both
    # before and after the subcommand. They were top-level only in the first
    # version, and `shim-census orphans --strict` died in argparse with exit 2
    # -- non-zero, so the self-test's "it refuses" assertion passed for
    # entirely the wrong reason. Two of the assertions below pin the flag's
    # own message, not just its exit code, for exactly that reason.
    # Every common flag defaults to SUPPRESS and the real defaults are applied
    # AFTER parsing. Without that, a subparser that shares the option rewrites
    # the namespace with its own default and `--side server orphans` silently
    # measures both sides.
    S = argparse.SUPPRESS
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--config", default=S, choices=("debug", "release"),
                        help="which build to measure (default debug)")
    common.add_argument("--build-dir", default=S,
                        help="the CMake build dir (default farm/<config>/build; "
                             "overrides --config)")
    common.add_argument("--side", default=S, choices=SIDES,
                        help="measure one side only")
    common.add_argument("--strict", action="store_true", default=S,
                        help="promote ghost objects from a warning to a refusal")
    common.add_argument("--mtime-policy", default=S,
                        choices=("source-newer", "graph-newer", "objects-older", "off"),
                        help="source-newer (default): refuse an object older "
                             "than the source it is compiled from. graph-newer: "
                             "refuse when build.ninja is newer than an object it "
                             "names, which under CMake fires after every "
                             "source-list edit. objects-older: the literal Phase "
                             "1a rule, which fires on every successful build -- "
                             "see this file's header. off: no mtime check.")
    common.add_argument("--self-test", "--selftest", dest="self_test",
                        action="store_true", default=S,
                        help="fixture tests; no tree needed")
    common.add_argument("--check", metavar="FILE", default=S,
                        help="exit non-zero if FILE still has importers "
                             "(CI shape; prints the same TSV)")
    common.add_argument("--show-demangled", action="store_true", default=S)
    common.add_argument("--max-symbols", type=int, default=S)

    COMMON_DEFAULTS = {
        "config": "debug", "build_dir": None, "side": None, "strict": False,
        "mtime_policy": "source-newer", "self_test": False, "check": None,
        "show_demangled": False, "max_symbols": 8,
    }

    p = argparse.ArgumentParser(
        prog="tools/shim-census",
        description=__doc__,
        parents=[common],
        formatter_class=argparse.RawDescriptionHelpFormatter)

    sub = p.add_subparsers(dest="cmd")
    w = sub.add_parser("who-imports", parents=[common])
    w.add_argument("target", help="a source path, or a symbol (mangled or not)")
    o = sub.add_parser("orphans", parents=[common])
    o.add_argument("--all", action="store_true",
                   help="also print the USED objects, for a full table")
    t = sub.add_parser("passthrough", parents=[common])
    t.add_argument("--explain", metavar="SourceSharp_Name", default=None)
    t.add_argument("--only-passthrough", action="store_true")

    args = p.parse_args(argv)
    for k, v in COMMON_DEFAULTS.items():
        if not hasattr(args, k):
            setattr(args, k, v)
    for d in ("all", "explain", "only_passthrough"):
        if not hasattr(args, d):
            setattr(args, d, None if d == "explain" else False)

    if args.self_test:
        return self_test()

    if args.check and not args.cmd:
        args.cmd = "who-imports"
        args.target = args.check

    if not args.cmd:
        p.print_help()
        return 2

    bdir = os.path.abspath(args.build_dir) if args.build_dir else build_for(args.config)
    if not os.path.isdir(bdir):
        die("no CMake build dir at %s\n"
            "           configure and build it first: make %s"
            % (bdir, args.config))

    try:
        graph = Graph(bdir, args.config)
    except cmakegraph.GraphError as e:
        die("REFUSING TO MEASURE -- %s" % e)
    if graph.empty():
        die("%s links no server_sourcesharp or client_sourcesharp objects -- "
            "there is nothing to measure and an empty answer would be a lie."
            % os.path.relpath(graph.ninja, ROOT))

    fatal, ghosts = graph.audit(args.mtime_policy)
    if args.strict and any(ghosts.values()):
        fatal.append(
            "--strict: %d ghost object(s) on disk that the graph does not link. "
            "They are what a directory-based census counts and this tool does "
            "not. Clear them: rm the stale .o files, or `ninja -C <build> -t "
            "cleandead` and rebuild." % sum(len(v) for v in ghosts.values()))
    if fatal:
        for f in fatal:
            sys.stderr.write("shim-census: REFUSING TO MEASURE -- %s\n" % f)
        sys.stderr.write(
            "shim-census: a stale census answers confidently and wrongly, so "
            "this is an error rather than a warning.\n")
        return 3

    if args.cmd == "who-imports":
        counts = cmd_who_imports(graph, ghosts, args)
        if args.check:
            total = sum(counts.values())
            if total:
                sys.stderr.write(
                    "shim-census: --check FAILED: %s still has %d importing "
                    "object file(s) on the link line.\n" % (args.check, total))
                return 1
            sys.stderr.write(
                "shim-census: --check ok: %s has 0 importers on the link line "
                "of %s.\n" % (args.check, os.path.relpath(graph.ninja, ROOT)))
        return 0

    if args.cmd == "orphans":
        cmd_orphans(graph, ghosts, args)
        return 0

    if args.cmd == "passthrough":
        cmd_passthrough(graph, ghosts, args)
        return 0

    p.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())

# the graph
# ---------------------------------------------------------------------------

def object_name(obj):
    """An object's display name in VPC's flat spelling: CMake's
    .../CMakeFiles/server_sourcesharp.dir/.../util_shared.cpp.o prints as
    util_shared.o, which is how every row of this census read before Phase 6b
    and how every consumer of those rows keys an object."""
    return re.sub(r"\.(cpp|cc|c)\.o$", ".o", os.path.basename(obj))


def objkey(obj):
    """Sort objects by their display name (VPC's order), then by path."""
    return (object_name(obj), obj)


def build_for(config):
    """The CMake build dir of a configuration: farm/<config>/build. ROOT is the
    farm this runs in (farm/<x>), so the other configuration's build is its
    sibling farm's."""
    farms = os.path.dirname(ROOT)
    if os.path.basename(farms) == "farm":
        return os.path.join(farms, config, "build")
    return os.path.join(ROOT, "farm", config, "build")


class Graph(object):
    """The objects the build actually links, per side, with their sources.

    The objects are the inputs of each .so's link edge in build.ninja; the
    source of each comes from compile_commands.json, which must agree with the
    target's CMakeLists source list (tools/cmakegraph.py). Anything unreadable
    or inconsistent raises cmakegraph.GraphError -- a refusal, never an empty
    side.
    """

    def __init__(self, bdir, config):
        self.bdir = bdir
        self.ninja = os.path.join(bdir, "build.ninja")
        self.config = config
        self.by_side = {s: {} for s in SIDES}   # side -> {absolute object -> farm-relative source}
        self.objdir = {}                        # side -> absolute CMakeFiles/<target>.dir

        for side in SIDES:
            target = cmakegraph.SIDES[side]
            # The list and the database must agree, or the edge below is a
            # build of some other tree.
            cmakegraph.compiled_sources(target, bdir)
            srcof = {}
            for e in cmakegraph.target_entries(target, bdir):
                o = e["output"] if os.path.isabs(e["output"]) else os.path.join(bdir, e["output"])
                srcof[os.path.normpath(o)] = cmakegraph.farm_relative(e["file"], bdir)
            for obj in cmakegraph.link_edge(target, bdir)["objects"]:
                obj = os.path.normpath(obj)
                if not obj.endswith(".o"):
                    continue
                if obj not in srcof:
                    raise cmakegraph.GraphError(
                        "%s is on the link edge of %s but compile_commands.json "
                        "does not compile it" % (obj, target))
                self.by_side[side][obj] = srcof[obj]
            mark = "/CMakeFiles/%s.dir/" % target
            some = next(iter(self.by_side[side]), "")
            if mark in some:
                self.objdir[side] = some[:some.index(mark) + len(mark) - 1]

    def empty(self):
        return not any(self.by_side[s] for s in SIDES)

    def on_disk(self, side):
        d = self.objdir.get(side)
        if not d or not os.path.isdir(d):
            return set()
        out = set()
        for dirpath, _dirs, files in os.walk(d):
            out.update(os.path.normpath(os.path.join(dirpath, f))
                       for f in files if f.endswith(".o"))
        return out

    # -- the refusals ------------------------------------------------------

    def audit(self, mtime_policy):
        """Return (fatal_problems, ghosts). fatal_problems is a list of strings."""
        fatal = []
        ghosts = {}
        try:
            ninja_mtime = os.path.getmtime(self.ninja)
        except OSError as e:
            return ["cannot stat %s: %s" % (self.ninja, e)], ghosts
        farm = cmakegraph.farm_src(self.bdir)

        for side in SIDES:
            named = self.by_side[side]
            if not named:
                continue
            missing = []
            older = []
            newer = []
            stale = []
            for obj in sorted(named, key=objkey):
                if not os.path.exists(obj):
                    missing.append(obj)
                    continue
                m = os.path.getmtime(obj)
                if m < ninja_mtime:
                    older.append(obj)
                else:
                    newer.append(obj)
                if mtime_policy == "source-newer":
                    sp = os.path.join(farm, named[obj])
                    try:
                        if os.path.getmtime(sp) > m:
                            stale.append(obj)
                    except OSError as e:
                        fatal.append("cannot stat %s, the source of %s: %s"
                                     % (sp, object_name(obj), e.strerror))
            if missing:
                fatal.append(
                    "the %s graph names %d object(s) that are not on disk -- "
                    "the tree was never built, or was cleaned after the graph "
                    "was written. nm would read 0 symbols from each and every "
                    "count below would be silently low. Build first:\n"
                    "    make %s\nFirst few: %s"
                    % (side, len(missing), self.config,
                       ", ".join(object_name(o) for o in missing[:5])))
            if stale:
                fatal.append(
                    "%d %s object(s) are OLDER than the source they are "
                    "compiled from: the source was edited and the build was "
                    "not re-run, so these objects are a previous version of "
                    "it. Rebuild, then re-measure. First few: %s"
                    % (len(stale), side,
                       ", ".join(object_name(o) for o in stale[:5])))
            if mtime_policy == "graph-newer" and older:
                fatal.append(
                    "%d %s object(s) are OLDER than %s (--mtime-policy "
                    "graph-newer): the graph was regenerated after they were "
                    "built. NOTE under CMake this also fires after every "
                    "source-list edit on a good tree -- see this file's header. "
                    "First few: %s"
                    % (len(older), side, os.path.basename(self.ninja),
                       ", ".join(object_name(o) for o in older[:5])))
            if mtime_policy == "objects-older" and newer:
                fatal.append(
                    "%d %s object(s) are NEWER than %s (--mtime-policy "
                    "objects-older). NOTE this is the literal Phase 1a rule and "
                    "it fires on every successful build, because the generator "
                    "writes the graph and ninja then compiles against it. See "
                    "this file's header. First few: %s"
                    % (len(newer), side, os.path.basename(self.ninja),
                       ", ".join(object_name(o) for o in newer[:5])))

            disk = self.on_disk(side)
            g = sorted(disk - set(named), key=objkey)
            if g:
                ghosts[side] = g

        return fatal, ghosts



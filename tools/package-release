#!/usr/bin/env python3
"""tools/package-release -- the game directory as a release archive.

    tools/package-release --config release --label v1.2.3 --out dist \\
                          [--native bin/ci-release/linux64]
    tools/package-release --self-test

Writes dist/sourcesharp-<label>-linux-x64.tar.gz, holding bin/<config> as a
plain directory tree named sourcesharp/ that runs from wherever it is
unpacked, and dist/sourcesharp-<label>-linux-x64-dbg.tar.gz with the split
debug info (<name>.dbg) when the native build made any.

bin/<config> is not that tree: tools/setup composes it from LINKS. The mod's
content, mods.yaml and libsteam_api.so are absolute symlinks into this repo
and into ROOT, which mean nothing on another machine, and mods/<id>/bin is a
relative link to ../../bin, which is exactly what a game directory needs. So
the rule is: an absolute link is replaced by a copy of what it points at, a
relative link is kept as a link. The managed assemblies and the bundled
runtime are real files and are copied.

--native names the directory whose .so files ship. The default is the game
directory's own bin/linux64 (a host clang build); CI passes
bin/ci-<config>/linux64, the build made inside Valve's sniper container
(tools/build/ci-build), whose glibc floor is the one the shipped binaries
must have. Whatever is in bin/linux64 besides regular files (libsteam_api.so's
link, the server_srv.so -> server.so alias) is kept from the game directory.

A missing input is a failure, never a thinner archive: the launcher, the
three native libraries, libsteam_api.so, the managed assemblies and the
bundled runtime are each required, and the archive is not written without
them. The engine's own droppings (console logs, steam_appid.txt) are left out.
"""

import argparse
import io
import os
import shutil
import stat
import sys
import tarfile
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TOP = "sourcesharp"
RID = "linux-x64"
LAUNCHER = "source#"
NATIVE_REQUIRED = ("server.so", "client.so", "libmanaged_host.so")
# Files the engine writes while it runs; never part of a release.
DROPPINGS = ("steam_appid.txt",)
DROPPING_SUFFIXES = (".log",)


class PackageError(Exception):
    pass


def is_dropping(name):
    return name in DROPPINGS or name.endswith(DROPPING_SUFFIXES)


def stage_tree(src, dst):
    """Copy src to dst: absolute links dereferenced, relative links kept."""
    os.makedirs(dst, exist_ok=True)
    for name in sorted(os.listdir(src)):
        if is_dropping(name):
            continue
        s = os.path.join(src, name)
        d = os.path.join(dst, name)
        stage_entry(s, d)


def stage_entry(s, d):
    if os.path.islink(s):
        target = os.readlink(s)
        if not os.path.isabs(target):
            os.symlink(target, d)
            return
        if not os.path.exists(s):
            raise PackageError(f"{s} is a link to {target}, which does not exist")
        s = os.path.realpath(s)
    if os.path.isdir(s):
        stage_tree(s, d)
    else:
        shutil.copy2(s, d)


def require_dir_with_files(path, what):
    if not os.path.isdir(path) or not any(
            os.path.isfile(os.path.join(path, f)) for f in os.listdir(path)):
        raise PackageError(f"{what} is missing or empty: {path}")


def stage(game, native, work):
    """Compose work/sourcesharp from the game directory; returns the list of
    .dbg files (absolute paths) that go to the symbols archive."""
    launcher = os.path.join(game, LAUNCHER)
    if not os.path.isfile(launcher) or not os.access(launcher, os.X_OK):
        raise PackageError(f"no launcher at {launcher}: publish src/launcher first")
    require_dir_with_files(os.path.join(game, "bin", "managed"), "the managed assemblies")
    if not os.path.isdir(os.path.join(game, "bin", "dotnet", "host", "fxr")):
        raise PackageError(f"no bundled .NET runtime under {game}/bin/dotnet (tools/setup provisions it)")
    steam = os.path.join(game, "bin", "linux64", "libsteam_api.so")
    if not os.path.exists(steam):
        raise PackageError(f"no libsteam_api.so at {steam} (tools/setup links it from ROOT)")
    for so in NATIVE_REQUIRED:
        if not os.path.isfile(os.path.join(native, so)):
            raise PackageError(f"{so} is not in {native}: the native build did not run, or --native is wrong")

    top = os.path.join(work, TOP)
    os.makedirs(top)
    for name in sorted(os.listdir(game)):
        if is_dropping(name):
            continue
        s = os.path.join(game, name)
        d = os.path.join(top, name)
        if name == "bin":
            stage_bin(s, native, d)
        else:
            stage_entry(s, d)
    dbg = sorted(os.path.join(native, f) for f in os.listdir(native) if f.endswith(".dbg"))
    return dbg


def stage_bin(src, native, dst):
    os.makedirs(dst)
    for name in sorted(os.listdir(src)):
        s = os.path.join(src, name)
        d = os.path.join(dst, name)
        if name != "linux64":
            stage_entry(s, d)
            continue
        # The shipped libraries come from --native; the rest of the game
        # directory's linux64 (the libsteam_api.so link, the server_srv.so
        # alias) is kept, and a regular file there that --native did not
        # build (a host clang .so) does not ship.
        os.makedirs(d)
        for entry in sorted(os.listdir(s)):
            e = os.path.join(s, entry)
            if os.path.islink(e) or os.path.isdir(e):
                stage_entry(e, os.path.join(d, entry))
        for entry in sorted(os.listdir(native)):
            e = os.path.join(native, entry)
            if os.path.isfile(e) and not os.path.islink(e) and not entry.endswith(".dbg"):
                shutil.copy2(e, os.path.join(d, entry))


def write_tar(path, root, arcname):
    with tarfile.open(path, "w:gz") as tar:
        tar.add(root, arcname=arcname)


def write_dbg_tar(path, dbg):
    with tarfile.open(path, "w:gz") as tar:
        for f in dbg:
            tar.add(f, arcname=f"{TOP}/bin/linux64/{os.path.basename(f)}")


def package(repo, config, label, out, native=None, log=print):
    game = os.path.join(repo, "bin", config)
    if not os.path.isdir(game):
        raise PackageError(f"no game directory at {game}: run make setup and build {config}")
    native = os.path.abspath(native) if native else os.path.join(game, "bin", "linux64")
    os.makedirs(out, exist_ok=True)
    main = os.path.join(out, f"sourcesharp-{label}-{RID}.tar.gz")
    symbols = os.path.join(out, f"sourcesharp-{label}-{RID}-dbg.tar.gz")
    with tempfile.TemporaryDirectory(prefix="package-release-") as work:
        dbg = stage(game, native, work)
        write_tar(main, os.path.join(work, TOP), TOP)
        files = sum(len(fs) for _, _, fs in os.walk(os.path.join(work, TOP)))
    log(f"{os.path.relpath(main)}: {files} entries, {os.path.getsize(main) // 1024} KB")
    if dbg:
        write_dbg_tar(symbols, dbg)
        log(f"{os.path.relpath(symbols)}: {len(dbg)} .dbg, {os.path.getsize(symbols) // 1024} KB")
    else:
        if os.path.exists(symbols):
            os.remove(symbols)
        log("no .dbg files beside the native libraries; no symbols archive")
    return main, (symbols if dbg else None)


# --- self-test -----------------------------------------------------------------

def self_test():
    failures = 0

    def expect(name, cond):
        nonlocal failures
        print(f"{'ok ' if cond else 'BAD'} {name}")
        if not cond:
            failures += 1

    def touch(path, data=b"x", mode=None):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "wb") as f:
            f.write(data)
        if mode is not None:
            os.chmod(path, mode)

    def fixture():
        """A repo with a game directory the way tools/setup composes one, a
        ROOT it links into, and a native build directory."""
        d = tempfile.mkdtemp(prefix="package-release-test-")
        repo = os.path.join(d, "repo")
        root = os.path.join(d, "root")
        game = os.path.join(repo, "bin", "release")
        touch(os.path.join(repo, "game", "mods.yaml"), b"default_mod: test\n")
        touch(os.path.join(repo, "game", "mod_test", "gameinfo.txt"), b"GameInfo\n")
        touch(os.path.join(repo, "game", "mod_test", "maps", "a.bsp"), b"VBSP")
        touch(os.path.join(root, "game", "bin", "linux64", "libsteam_api.so"), b"steam")
        touch(os.path.join(game, LAUNCHER), b"#!/bin/sh\n", 0o755)
        os.symlink(os.path.join(repo, "game", "mods.yaml"), os.path.join(game, "mods.yaml"))
        touch(os.path.join(game, "bin", "managed", "SourceSharp.Server.dll"), b"MZ")
        touch(os.path.join(game, "bin", "dotnet", "host", "fxr", "10.0.0", "libhostfxr.so"), b"ELF")
        touch(os.path.join(game, "bin", "dotnet", "shared", "Microsoft.NETCore.App", "10.0.0", "x.dll"))
        os.makedirs(os.path.join(game, "bin", "linux64"))
        os.symlink(os.path.join(root, "game", "bin", "linux64", "libsteam_api.so"),
                   os.path.join(game, "bin", "linux64", "libsteam_api.so"))
        os.symlink("server.so", os.path.join(game, "bin", "linux64", "server_srv.so"))
        touch(os.path.join(game, "bin", "linux64", "server.so"), b"host clang build")
        mod = os.path.join(game, "mods", "test")
        os.makedirs(os.path.join(mod, "maps"))
        os.symlink(os.path.join(repo, "game", "mod_test", "gameinfo.txt"), os.path.join(mod, "gameinfo.txt"))
        os.symlink(os.path.join(repo, "game", "mod_test", "maps", "a.bsp"), os.path.join(mod, "maps", "a.bsp"))
        os.symlink("../../bin", os.path.join(mod, "bin"))
        touch(os.path.join(mod, "cfg", "settings.scr"), b"seed")
        touch(os.path.join(mod, "console.log"), b"engine wrote this")
        touch(os.path.join(game, "steam_appid.txt"), b"243750")
        native = os.path.join(repo, "bin", "ci-release", "linux64")
        for so in NATIVE_REQUIRED:
            touch(os.path.join(native, so), b"sniper build of " + so.encode())
            touch(os.path.join(native, so + ".dbg"), b"DWARF")
        return repo, native

    def members(path):
        with tarfile.open(path) as tar:
            return {m.name: m for m in tar.getmembers()}

    def content(path, name):
        with tarfile.open(path) as tar:
            return tar.extractfile(name).read()

    repo, native = fixture()
    out = os.path.join(repo, "dist")
    main, symbols = package(repo, "release", "test", out, native, log=lambda _: None)
    m = members(main)
    expect("the archive is named for the label and rid",
           os.path.basename(main) == f"sourcesharp-test-{RID}.tar.gz")
    expect("the launcher ships, executable",
           f"{TOP}/{LAUNCHER}" in m and m[f"{TOP}/{LAUNCHER}"].mode & stat.S_IXUSR)
    expect("mods.yaml, an absolute link, ships as a file",
           m[f"{TOP}/mods.yaml"].isfile() and content(main, f"{TOP}/mods.yaml") == b"default_mod: test\n")
    expect("the mod's content, linked per file, ships as files",
           m[f"{TOP}/mods/test/gameinfo.txt"].isfile() and m[f"{TOP}/mods/test/maps/a.bsp"].isfile())
    expect("mods/test/bin stays a relative link to ../../bin",
           m[f"{TOP}/mods/test/bin"].issym() and m[f"{TOP}/mods/test/bin"].linkname == "../../bin")
    expect("server_srv.so stays a relative link to server.so",
           m[f"{TOP}/bin/linux64/server_srv.so"].issym()
           and m[f"{TOP}/bin/linux64/server_srv.so"].linkname == "server.so")
    expect("libsteam_api.so, linked from ROOT, ships as a file",
           m[f"{TOP}/bin/linux64/libsteam_api.so"].isfile()
           and content(main, f"{TOP}/bin/linux64/libsteam_api.so") == b"steam")
    expect("the native libraries come from --native, not the game directory's own build",
           content(main, f"{TOP}/bin/linux64/server.so") == b"sniper build of server.so"
           and f"{TOP}/bin/linux64/client.so" in m and f"{TOP}/bin/linux64/libmanaged_host.so" in m)
    expect("no .dbg in the game archive", not any(n.endswith(".dbg") for n in m))
    expect("the seeded cfg ships", f"{TOP}/mods/test/cfg/settings.scr" in m)
    expect("the managed assemblies and the runtime ship",
           f"{TOP}/bin/managed/SourceSharp.Server.dll" in m
           and f"{TOP}/bin/dotnet/host/fxr/10.0.0/libhostfxr.so" in m)
    expect("the engine's droppings are left out",
           f"{TOP}/mods/test/console.log" not in m and f"{TOP}/steam_appid.txt" not in m)
    expect("nothing in the archive is an absolute link",
           not any(mm.issym() and os.path.isabs(mm.linkname) for mm in m.values()))
    s = members(symbols)
    expect("the symbols archive holds every .dbg beside the native libraries",
           set(s) == {f"{TOP}/bin/linux64/{so}.dbg" for so in NATIVE_REQUIRED})

    # Without --native the game directory's own linux64 is what ships.
    repo2, _ = fixture()
    for so in NATIVE_REQUIRED:
        touch(os.path.join(repo2, "bin", "release", "bin", "linux64", so), b"host")
    main2, symbols2 = package(repo2, "release", "t", os.path.join(repo2, "dist"), log=lambda _: None)
    expect("without --native, bin/linux64's own libraries ship and there is no symbols archive",
           content(main2, f"{TOP}/bin/linux64/server.so") == b"host" and symbols2 is None)

    # Refusals: each required input missing is an error naming it, and no archive.
    def refuses(name, mutate, needle):
        r, n = fixture()
        mutate(r, n)
        o = os.path.join(r, "dist")
        try:
            package(r, "release", "t", o, n, log=lambda _: None)
            expect(name, False)
        except PackageError as e:
            expect(name, needle in str(e) and not os.path.exists(os.path.join(o, f"sourcesharp-t-{RID}.tar.gz")))

    refuses("a missing launcher is refused",
            lambda r, n: os.remove(os.path.join(r, "bin", "release", LAUNCHER)), "launcher")
    refuses("a missing native library is refused naming it",
            lambda r, n: os.remove(os.path.join(n, "client.so")), "client.so")
    refuses("a missing libsteam_api.so is refused",
            lambda r, n: os.remove(os.path.join(r, "bin", "release", "bin", "linux64", "libsteam_api.so")),
            "libsteam_api.so")
    refuses("an empty managed directory is refused",
            lambda r, n: os.remove(os.path.join(r, "bin", "release", "bin", "managed", "SourceSharp.Server.dll")),
            "managed")
    refuses("a missing bundled runtime is refused",
            lambda r, n: shutil.rmtree(os.path.join(r, "bin", "release", "bin", "dotnet")), "runtime")
    refuses("a dangling content link is refused",
            lambda r, n: os.remove(os.path.join(r, "game", "mod_test", "maps", "a.bsp")), "does not exist")
    refuses("a missing game directory is refused",
            lambda r, n: shutil.rmtree(os.path.join(r, "bin", "release")), "game directory")

    print("package-release self-test:", "PASS" if failures == 0 else f"{failures} FAILED")
    return 1 if failures else 0


def main(argv):
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--config", choices=("debug", "release"), default="release")
    ap.add_argument("--label", help="the version in the archive name (a tag, or a short sha)")
    ap.add_argument("--out", default="dist", help="where the archives go (default dist/)")
    ap.add_argument("--native", help="the directory whose .so files ship (default bin/<config>/bin/linux64)")
    ap.add_argument("--self-test", action="store_true")
    a = ap.parse_args(argv)
    if a.self_test:
        return self_test()
    if not a.label:
        ap.error("--label is required")
    try:
        package(REPO, a.config, a.label, a.out, a.native)
    except PackageError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

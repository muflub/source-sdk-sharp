#!/usr/bin/env python3
"""
tools/4f-component -- which translation units must leave a vpc TOGETHER.

WHY THIS EXISTS.

plan_entity.md Phase 4 is written as eight steps, each owning one stock cluster,
"order from the census's reverse topology". Step 4f measured the topology and it
is not a DAG at that granularity: 4a, 4c, 4d, 4e, 4f and the Phase 2 and Phase 3
exits sit in ONE STRONGLY CONNECTED COMPONENT of the link graph. Each of them
still references the others, so no single one of them can take its stock TU out
of server_csharp.vpc, and every one of 4a-4e in fact landed CODE moves and
removed NO stock TU. 4e said so in its own handover ("neither util.cpp nor
collisionproperty.cpp can LEAVE either vpc in this step either ... every one of
those holders is 4f's") and 4f says the mirror image.

`tools/4a-owes` answers "who owes THIS file" one hop. This answers the closure:
give it a set of files somebody wants out, and it names every other TU that must
go in the same commit for the link to hold. That is the unit of work a Phase 4
exit lane has to be scoped to, and getting it wrong is how a lane discovers at
the link step that its step was never independently completable.

METHOD -- the same three rules tools/entity-census and tools/7f-consumers state,
for the same reasons:

  1. the object list is the .so's link edge in the CMake build's build.ninja,
     each object mapped to its source by compile_commands.json (read through
     tools/cmakegraph.py, which refuses a database that disagrees with the
     target's CMakeLists source list), never `ls` and never linker output. A
     file taken out of the build leaves its .o behind on disk, and a directory
     scan counts the stale object as a live consumer -- which is exactly what
     happened to gib.o after step 4a.
  2. definitions are filtered on symbol type; undefined rows are type 'U'.
     Without the type filter, weak inline emissions read as definitions and
     every count inflates.
  3. symbols are compared MANGLED. `nm -C` demangles defined and undefined rows
     inconsistently on an object file and silently loses consumers.

WHAT THE ANSWER IS, AND WHAT IT IS NOT.

It is a FLOOR, twice over, and neither hole is small:

  * A VIRTUAL CALL EMITS NO SYMBOL. An object that only ever reaches a class
    through its vtable owes nothing the linker can see. So a TU absent from this
    closure is not thereby safe to delete -- it is only "the linker will not
    complain".
  * A DATA-ONLY or PURELY HEADER-INLINE dependency emits nothing either.
    effect_dispatch_data.cpp read zero owed symbols for the whole of Phase 3
    while registering a live send table.

It is also, in the other direction, WIDER than the minimum: an edge can be
broken by retyping a signature instead of by deleting the file. The closure says
what must leave IF NOTHING IS RETYPED, which is the right question for "can step
N finish on its own" and the wrong one for "how much work is left".

So the closure is a lower bound on the batch and an upper bound on the
independence. Check it against the linker -- `--link-command` prints the relink
that does exactly that, and it is what turned this from an inference into a
measurement for step 4f.

USAGE, from a farm root (farm/<config>, where the tests run it):

    tools/4f-component                      # the 4f seed set, server side
    tools/4f-component --side client SRC... # some other seed, client side
    tools/4f-component --seed-file F        # one source path per line
    tools/4f-component --tsv                # role<TAB>source<TAB>owed-symbols
    tools/4f-component --link-command       # print the relink that checks it
    tools/4f-component --self-test          # the closure algebra, on a fixture
    --build-dir D                           # the CMake build (default `build`,
                                            # i.e. farm/<config>/build)

EXIT CODES, three rather than two, for the reason tools/entity-gates gives:
"the tree still couples these files" and "I could not take the measurement" are
different answers.

    0  measured (a closure of any size is a legitimate answer)
    2  refused: no CMake build (build.ninja, compile_commands.json), a stale
       one, an object on the link edge not built, an empty seed, a seed that
       names a file this side does not compile. Nothing was measured.
"""

import argparse
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import cmakegraph  # noqa: E402

BUILD_DIR_DEFAULT = "build"

# plan_entity.md step 4f: "client.cpp, cbase.cpp, entitylist.cpp,
# entitylist_base.cpp, baseentity.cpp, entity_bases.h, baseentity_statics.cpp,
# shell_entity_orphans.cpp, shell_ai_orphans.cpp, shell_ai_absent.cpp". The .h
# is not a translation unit, and the three shim .cpp are link glue that dies
# with its consumers rather than holding anything, so the seed is the six TUs
# that actually define the base and the list.
#
# `game/server/client.cpp` WAS THE SECOND ENTRY AND IS NOT ANY MORE. Lane
# p4-exit took it out of server_csharp.vpc (the server list) at the Phase 4 exit -- it is batch 7
# of tools/p4-exit-batches' removal order, ahead of the cycle, and
# `tools/4a-owes client` reads 0 -- so a seed naming it makes this tool REFUSE
# (exit 2, "not compiled into the server project"), which is the refusal
# ComponentClosure.ASeedThisSideDoesNotCompileIsRefusedNotClosed exists to
# demand. It is deleted rather than replaced: it was in 4f's list because it
# defined CPointClientCommand and CPointServerCommand, and both of those husks
# went at step 4f itself.
SEED_4F = [
    "game/server/baseentity.cpp",
    "game/server/cbase.cpp",
    "game/server/entitylist.cpp",
    "game/shared/entitylist_base.cpp",
    "sourcesharp/game/server/baseentity_statics.cpp",
]


def die(msg):
    sys.stderr.write("4f-component: %s\n" % msg)
    sys.exit(2)


def object_table(bdir, side):
    """[(absolute object path, farm-relative source path)] for one side: the
    objects on the .so's link edge, each present on disk, one per compiled
    source (cmakegraph.object_sources refuses otherwise)."""
    try:
        rows = sorted(cmakegraph.object_sources(cmakegraph.SIDES[side], bdir).items())
    except cmakegraph.GraphError as e:
        die("%s (build first: make debug)" % e)
    if not rows:
        die("the object table names no %s TUs -- is %s the right build?" % (side, bdir))
    return rows


def nm_rows(path, args):
    try:
        out = subprocess.run(["nm"] + args + [path], capture_output=True, text=True).stdout
    except OSError:
        die("nm is not on PATH")
    return out.splitlines()


def defined(obj_abs):
    # Rule 2: symbol type filtered. Rule 3: mangled, so no -C.
    names = set()
    for line in nm_rows(obj_abs, ["--defined-only"]):
        f = line.split()
        if len(f) >= 3 and f[1] in "TWVDBRtGSuvw":
            names.add(f[2])
    return names


def undefined(obj_abs):
    names = set()
    for line in nm_rows(obj_abs, ["--undefined-only"]):
        f = line.split()
        if len(f) == 2 and f[0] == "U":
            names.add(f[1])
    return names


def closure(undefs, owner, seed_objs, hops=None):
    """Which objects must leave, given that `seed_objs` are leaving.

    undefs: object -> set of mangled symbols it leaves undefined.
    owner:  mangled symbol -> set of objects that define it.

    THE RULE IS "EVERY DEFINER IS LEAVING", not "some definer is leaving", and
    that distinction is the difference between a useful answer and a useless
    one. A weak inline emitted out of line at -O0 is defined by DOZENS of
    objects: `bone_setup.o` and `baseentity.o` both emit the same header body,
    so an "any definer" rule pulls bone_setup.cpp into the closure of
    baseentity.cpp for a symbol the link would still resolve. The first version
    of this tool did exactly that and answered 124 -- it named most of the
    project and told a reader nothing.

    A symbol nothing in the object list defines (it comes from tier1, the
    engine, or libc) is not a blocker either and is skipped: `owner` has no
    entry for it.

    `hops` bounds the transitivity. hops=1 is "who breaks IMMEDIATELY", which is
    the actionable list for a lane; None is the fixpoint, which is the honest
    statement of how far the coupling reaches. The set only ever grows and is
    bounded by the object list, so the fixpoint terminates.
    """
    inside = set(seed_objs)
    round_no = 0
    while True:
        round_no += 1
        added = set()
        for obj, names in undefs.items():
            if obj in inside:
                continue
            for n in names:
                d = owner.get(n)
                if d and d <= inside:
                    added.add(obj)
                    break
        if not added:
            return inside
        inside |= added
        if hops is not None and round_no >= hops:
            return inside


def self_test():
    """The closure algebra, on a fixture rather than on the tree.

    A tool whose only mode reads a 166-object link cannot be shown to be right;
    entity_gates makes the same argument for its own fixture. Each property
    below is a way this has actually been got wrong.
    """
    fails = []

    def check(cond, what):
        if not cond:
            fails.append(what)

    # a needs s_b (only b defines it); c needs s_a (only a defines it);
    # d needs s_ext, which nothing in the list defines; e needs its own symbol.
    undefs = {"a": {"s_b"}, "b": set(), "c": {"s_a"}, "d": {"s_ext"}, "e": {"s_e"}}
    owner = {"s_b": {"b"}, "s_a": {"a"}, "s_e": {"e"}}

    check(closure(undefs, owner, ["b"]) == {"a", "b", "c"},
          "transitive: c needs a, a needs b, so removing b takes both")
    check(closure(undefs, owner, ["b"], hops=1) == {"a", "b"},
          "hops=1 stops at the direct referencers -- an unbounded-only tool "
          "cannot tell a lane what breaks immediately")
    check(closure(undefs, owner, ["d"]) == {"d"},
          "an isolated TU is its own closure. A tool that always answered "
          "'everything' would look right on the real tree and be useless")
    check(closure(undefs, owner, []) == set(),
          "an empty seed closes to nothing, not to everything")
    check(closure(undefs, owner, ["e"]) == {"e"},
          "a self-edge terminates rather than looping")
    check("d" not in closure(undefs, owner, ["a", "b", "c"]),
          "a symbol NOTHING in the object list defines is not a blocker: it "
          "comes from tier1 or the engine and survives the deletion")

    # THE WEAK-INLINE CASE, which is what the "every definer" rule is for.
    # w needs s_w; both p (leaving) and q (staying) emit it, as two objects
    # emit the same -O0 out-of-line inline. w must NOT be pulled in.
    undefs2 = {"p": set(), "q": set(), "w": {"s_w"}}
    owner2 = {"s_w": {"p", "q"}}
    check(closure(undefs2, owner2, ["p"]) == {"p"},
          "a symbol a SURVIVING object also defines is not a blocker -- this is "
          "the weak-inline case, and an 'any definer' rule answered 124 of 166 "
          "TUs on the real tree because of it")
    check(closure(undefs2, owner2, ["p", "q"]) == {"p", "q", "w"},
          "...and when BOTH definers leave, w does become one")

    for f in fails:
        print("FAIL  %s" % f)
    print("4f-component --self-test: %d check(s), %d failure(s)" % (8, len(fails)))
    return 1 if fails else 0


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("--side", default="server", choices=["server", "client"])
    ap.add_argument("--build-dir", default=BUILD_DIR_DEFAULT)
    ap.add_argument("--seed-file")
    ap.add_argument("--hops", type=int, default=None,
                    help="bound the transitivity; 1 = direct blockers only")
    ap.add_argument("--tsv", action="store_true")
    ap.add_argument("--link-command", action="store_true")
    ap.add_argument("--self-test", action="store_true")
    ap.add_argument("-h", "--help", action="store_true")
    ap.add_argument("seed", nargs="*")
    a = ap.parse_args()

    if a.help:
        print(__doc__)
        return 0
    if a.self_test:
        return self_test()

    seed_src = list(a.seed)
    if a.seed_file:
        seed_src += [l.strip() for l in open(a.seed_file) if l.strip() and not l.startswith("#")]
    if not seed_src:
        seed_src = SEED_4F if a.side == "server" else []
    if not seed_src:
        die("no seed given and no default for side '%s'" % a.side)

    rows = object_table(os.path.abspath(a.build_dir), a.side)

    by_src = {}
    for obj, src in rows:
        by_src[src] = obj
    by_obj = {obj: src for obj, src in rows}

    seed_objs = []
    for s in seed_src:
        if s not in by_src:
            die("%s is not compiled into the %s project (the CMake build does "
                "not link it). A seed this side does not build would close to "
                "nothing and read as good news." % (s, a.side))
        seed_objs.append(by_src[s])

    # Build the reference graph once. Two nm calls per object.
    defs, undefs = {}, {}
    for obj in by_obj:
        p = obj
        if not os.path.exists(p):
            die("no object at %s -- build first: make debug" % p)
        defs[obj] = defined(p)
        undefs[obj] = undefined(p)

    # owner[symbol] = set of objects defining it. A symbol two objects define
    # (a weak inline in a header) makes an edge to BOTH, which is conservative
    # in the direction that matters: it can only widen the closure.
    owner = {}
    for obj, names in defs.items():
        for n in names:
            owner.setdefault(n, set()).add(obj)

    inside = closure(undefs, owner, seed_objs, hops=a.hops)
    extra = sorted(inside - set(seed_objs), key=lambda o: by_obj[o])

    # How many symbols each blocker would lose. Counted against the closure as
    # a whole and only for symbols the closure is the SOLE definer of, so it
    # agrees with the rule that put the object in the set.
    def owed_by(obj):
        n = 0
        for sym in undefs[obj]:
            d = owner.get(sym)
            if d and d <= inside:
                n += 1
        return n

    if a.link_command:
        drop = "|".join(re.escape(os.path.basename(o)) for o in sorted(inside))
        print("# relink the %s .so with the whole closure removed; "
              "-Wl,--no-undefined then names anything this floor missed." % a.side)
        print("# the object list is the link edge's inputs in %s/build.ninja."
              % a.build_dir)
        print("grep -vE '/(%s)$' <object list> > objs-minus.txt" % drop)
        return 0

    def role(src):
        return "shim" if src.startswith("sourcesharp/") else "stock"

    if a.tsv:
        for o in seed_objs:
            print("seed\t%s\t%s\t-" % (role(by_obj[o]), by_obj[o]))
        for o in extra:
            print("closure\t%s\t%s\t%d" % (role(by_obj[o]), by_obj[o], owed_by(o)))
        return 0

    print("4f-component -- what must leave the %s build together (%s)."
          % (a.side, cmakegraph.SIDES[a.side]))
    print()
    print("  objects   %d compiled into the %s project" % (len(by_obj), a.side))
    print("  seed      %d translation unit(s)" % len(seed_objs))
    for o in seed_objs:
        print("              %s" % by_obj[o])
    print()
    stock = [o for o in extra if role(by_obj[o]) == "stock"]
    shim = [o for o in extra if role(by_obj[o]) == "shim"]
    print("  CLOSURE   %d more TU(s) must go in the same commit: "
          "%d stock, %d shim" % (len(extra), len(stock), len(shim)))
    if a.hops is None:
        # The two numbers answer different questions and a report carrying only
        # the fixpoint reads as "everything", which is not actionable.
        hop1 = closure(undefs, owner, seed_objs, hops=1) - set(seed_objs)
        h_stock = sum(1 for o in hop1 if role(by_obj[o]) == "stock")
        print("            of which %d break IMMEDIATELY (%d stock, %d shim) -- "
              "`--hops 1`" % (len(hop1), h_stock, len(hop1) - h_stock))
    print()
    for label, group in (("stock", stock), ("shim", shim)):
        if not group:
            continue
        print("  -- %s --" % label)
        for o in group:
            print("    %5d  %s" % (owed_by(o), by_obj[o]))
        print()
    print("  The count is symbols this TU leaves undefined that ONLY the closure "
          "defines.")
    print("  FLOOR: a virtual call emits no symbol, so a TU absent here is not "
          "thereby")
    print("  safe to delete. Check with --link-command.")
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/bin/bash
#
# Populate a fresh git worktree with the files git does not carry.
#
#     tools/worktree-setup                 # populate this worktree
#     tools/worktree-setup --check         # report only, change nothing
#     tools/worktree-setup --reference DIR # take them from DIR
#     tools/worktree-setup --required-only # skip the conveniences
#     tools/worktree-setup --list          # print the manifest and exit
#
# WHY THIS EXISTS. `git worktree add` gives you every TRACKED file and nothing
# else, and each thing it leaves out fails in a way that looks exactly like a
# bug in whatever the agent was working on. See docs/worktree-setup.md.
#
#=============================================================================#
#
# HOW THE MANIFEST WAS FOUND, so the next person can redo it rather than trust
# it. Four sieves over the reference checkout:
#
#   1. enumerate every path in it;
#   2. keep the ones `git check-ignore --no-index` reports as ignored;
#   3. drop the ones `git ls-files` reports as TRACKED -- check-ignore matches
#      patterns only, so tracked files under a matched directory (every file in
#      game/bin/, under the global `[Bb]in/` rule) look ignored and are not;
#   4. drop everything a full `make debug && make test` recreates on its own.
#
# 21,133 ignored-and-untracked paths collapse to 133 roots; the fourth sieve
# takes that to the handful below. What it removes is game-runtime droppings
# (console.log, *.cache, screenshots/, downloadlists/, demoheader.tmp,
# voice_ban.dt, videoconfig_linux.cfg, ServerConfig.vdf, maps/graphs/), another
# mod's build cache (mod_hl2mp, mod_tf), vpc caches and _vpc_/ trees, the
# managed obj/bin trees, and three downloads that have their own tool
# (tools/node via tools/get-node, src/webui/node_modules via `make ui`, and
# the farm and bin/<config> via `make setup`).
#
# REQUIRED vs CONVENIENCE, and the difference is not cosmetic. Only two entries
# are things NOTHING in the tree can produce. The rest are regenerated by the
# engine or by a make target, and are copied to save an agent the wait -- so
# --check fails on a missing required entry and only warns on a missing
# convenience.
#
# WHAT IS DELIBERATELY NOT HERE, with the reason, because each of these has been
# proposed and each is a mistake:
#
#   steam_appid.txt and game/steam_appid.txt
#       NOT COPIED, and this is the entry most likely to be "fixed" back in.
#       Both are written BY THE LAUNCHER: src/launcher_main/main.cpp:165 does
#       fopen( "steam_appid.txt", "w" ) in its working directory on every run.
#       `make run` does `cd game/` first (Makefile:214), so it drops
#       game/steam_appid.txt; `tools/debug-api run` launches from the repo root, so it
#       drops the root one. They are OUTPUTS.
#
#       And pre-seeding them is not merely redundant. Commit 361e947b untracked
#       both on purpose: "game/steam_appid.txt is a runtime dropping, and
#       specifically a harmful one to track: with it present the launcher skips
#       the Steam relaunch, never chdirs to the SDK Base install, and dies with
#       'AppFramework : Unable to load module engine.so!'. An agent hit exactly
#       that earlier tonight, lost a run to it". Copying them here would
#       re-create by script the trap that commit removed from git.
#
#       The opposite has also been reported -- that their ABSENCE gives an
#       SDL/zenity "Not able to load Steam API" dialog with nothing on stdout.
#       That dialog is main.cpp:160, and it fires when dlopen of
#       game/bin/linux64/libsteam_api.so fails. That file is TRACKED, so a fresh
#       worktree always has it, and steam_appid.txt is written after the dlopen
#       rather than before it -- the two cannot be cause and effect.
#       --with-steam-appid exists for anyone who wants to re-test that.
#
#   bin/<config>/mods/test/maps/graphs/*.ain
#       The engine rebuilds a missing nodegraph on first load. Slow and noisy,
#       but a STALE one copied from a checkout whose map has since changed is
#       worse: the AI then walks a graph that does not match the world.
#
#   bin/<config>/mods/test/maps/ss_sandbox.bsp
#       The same rule as the nodegraph above, applied to the map itself -- it
#       was copied until the cost of doing so was measured.
#
#       This was a "req:" entry justified as saving a minute of compile. What it
#       actually did was hand every worktree the REFERENCE checkout's map. That
#       map is build output, so nothing updates it, and the one in the main
#       checkout is 216 places behind Sandbox.cs: 733 entities across 194
#       classnames against the generator's 944, short 72 registered classes, and
#       carrying spawnflags 0 on the env_explosion the generator gives 2. Every
#       worktree therefore inherited a stale map and two red
#       SandboxArtefactTests that had nothing to do with the work in it. Four
#       separate lanes spent effort proving those failures were not theirs
#       before anyone looked here.
#
#       Copying build output between trees makes a tree's contents stop being a
#       fact about that tree. A worktree with no map now says exactly that, and
#       SandboxArtefactTests skips with the reason printed. Anyone who wants the
#       map runs `make map MAP=ss_sandbox`, which compiles it with the managed
#       compilers in ../source-sdk-map-tools -- no Steam login, no Wine.
#
#       Worktrees created before this change still hold the copy. Delete it
#       (rm bin/<config>/mods/test/maps/ss_sandbox.bsp) or recompile it; either way the
#       two tests stop reporting on someone else's file.
#
#=============================================================================#

set -euo pipefail

MODE=copy
REFERENCE=""
WANT_STEAM_APPID=0
REQUIRED_ONLY=0

usage() {
    sed -n '3,9p' "$0" | sed 's/^# \?//'
    exit "${1:-0}"
}

while (( $# )); do
    case "$1" in
        --check)            MODE=check ;;
        --list)             MODE=list ;;
        --reference)        REFERENCE="${2:-}"; shift ;;
        --reference=*)      REFERENCE="${1#*=}" ;;
        --required-only)    REQUIRED_ONLY=1 ;;
        --with-steam-appid) WANT_STEAM_APPID=1 ;;
        -h|--help)          usage 0 ;;
        *)                  echo "unknown argument: $1" >&2; usage 1 ;;
    esac
    shift
done

#-----------------------------------------------------------------------------
# Where we are, and where to copy from.
#
# The reference defaults to the MAIN checkout, which git already knows: the
# common git dir of a linked worktree is <main>/.git. Guessing from $HOME or a
# hardcoded path would be wrong on anyone else's machine, and silently.
#-----------------------------------------------------------------------------
TARGET="$(git rev-parse --show-toplevel)"

# Which configuration's game directory the runtime entries are in:
# bin/<config>/bin/dotnet and bin/<config>/mods/test/cfg. Debug when unset.
CONFIG="${SOURCESHARP_CONFIG:-debug}"
DOTNET_REL="bin/$CONFIG/bin/dotnet"
MODCFG_REL="bin/$CONFIG/mods/test/cfg"
MODMAT_REL="bin/$CONFIG/mods/test/materials"
UI_REL="src/debug_api/ui"

if [[ -z "$REFERENCE" ]]; then
    common="$(git rev-parse --git-common-dir)"
    [[ "$common" = /* ]] || common="$(cd "$(dirname -- "$common")" && pwd)/$(basename -- "$common")"
    REFERENCE="$(dirname -- "$common")"
fi

#-----------------------------------------------------------------------------
# THE MANIFEST. tier:kind:path
#
#   req / opt  -- whether --check fails or only warns
#   dir / file -- what it must land as
#
# Paths are relative to the repository root.
#-----------------------------------------------------------------------------
MANIFEST=(
    # REQUIRED. Nothing in this tree produces either of these.
    #
    # The bundled .NET runtime. sourcesharp.cpp:162 loads libhostfxr by explicit
    # path from <mod>/bin/dotnet/host/fxr and sets DOTNET_ROOT to
    # <mod>/bin/dotnet, so a game without it STARTS, logs "no bundled
    # libhostfxr", and then runs with no managed code in it at all -- which
    # reads as every C# change having silently done nothing. <mod>/bin is the
    # shared bin/<config>/bin. `make setup` provisions it too.
    "req:dir:$DOTNET_REL"

    # NOT COPIED, deliberately: bin/<config>/mods/test/maps/ss_sandbox.bsp.
    # See the "what is deliberately NOT copied" note in the header.

    # CONVENIENCE. Regenerated on demand; copied to save the wait.
    #
    # The built web UI, embedded into Debug.Api.Server at compile time.
    # `make ui` recreates it and `make test` depends on `ui` for exactly this
    # reason -- but a bare `dotnet test`, or `dotnet build` of DebugApi, fails
    # first with an error that names the missing embed rather than the cause.
    "opt:dir:$UI_REL"

    # Engine-generated at runtime (.gitignore:522, "same set as mod_tf /
    # mod_hl2mp"). Copied because it carries the key binds and convars a
    # screenshot gate was tuned against -- and NOT required, because it also
    # carries whatever the last session left in autoexec.cfg. If a gate behaves
    # differently in a fresh worktree, look here first.
    "opt:dir:$MODCFG_REL"

    # Also engine-generated (.gitignore:525). In the reference checkout this is
    # three EMPTY directories -- materials/vgui/logos/ui, no files -- which the
    # engine creates for itself on startup. It is in the manifest only so
    # `--check` accounts for every path the old by-hand copy list named; if it
    # is missing, nothing is wrong.
    "opt:dir:$MODMAT_REL"
)

if (( WANT_STEAM_APPID )); then
    MANIFEST+=( "opt:file:game/steam_appid.txt" "opt:file:steam_appid.txt" )
fi

if [[ "$MODE" == list ]]; then
    printf '%s\n' "${MANIFEST[@]}"
    exit 0
fi

[[ -d "$REFERENCE" ]] || {
    echo "error: reference $REFERENCE is not a directory" >&2; exit 1; }

# A reference that is really the target copies files onto themselves and reports
# success, which is the most misleading outcome available.
if [[ "$(cd -- "$REFERENCE" && pwd -P)" == "$(cd -- "$TARGET" && pwd -P)" ]]; then
    echo "error: reference and target are the same directory ($TARGET)." >&2
    echo "       Point --reference at the main checkout." >&2
    exit 1
fi

# And a reference that is not a checkout of this project would copy nothing
# while reporting every entry as "not in the reference".
[[ -f "$REFERENCE/tools/build/buildsourcesharp" ]] || {
    echo "error: $REFERENCE does not look like a source-sdk-sharp checkout" >&2
    echo "       (no tools/build/buildsourcesharp in it)" >&2
    exit 1; }

#-----------------------------------------------------------------------------
# The checks. Each returns 0 when the entry is present AND has the right shape.
#
# "Present" is not the question. The mistake that prompted these produced a
# populated bin/ and a game that could not find a runtime.
#-----------------------------------------------------------------------------
fail_reasons=()
note_fail() { fail_reasons+=( "$1" ); }

check_entry() {
    local kind="$1" rel="$2"
    local p="$TARGET/$rel"

    case "$kind" in
        dir)
            [[ -d "$p" ]] || { note_fail "$rel: not a directory"; return 1; }
            # A nested duplicate is what `cp -a SRC DST` does when DST already
            # exists -- cfg/cfg, ui/ui, dotnet/dotnet. It leaves the real files
            # one level too deep and every consumer looking at an empty parent.
            local base
            base="$(basename -- "$rel")"
            [[ -e "$p/$base" ]] && {
                note_fail "$rel: nested $base/$base -- the copy landed one level too deep"
                return 1; }
            [[ -n "$(ls -A -- "$p" 2>/dev/null)" ]] || {
                note_fail "$rel: empty directory"; return 1; }
            ;;
        file)
            [[ -f "$p" ]] || { note_fail "$rel: not a regular file"; return 1; }
            [[ -s "$p" ]] || { note_fail "$rel: zero bytes"; return 1; }
            ;;
    esac

    # Per-entry shape, where there is one worth pinning.
    case "$rel" in
        "$DOTNET_REL")
            # What sourcesharp.cpp actually opens.
            [[ -d "$p/host/fxr" ]] || {
                note_fail "$rel: no host/fxr -- sourcesharp.cpp loads libhostfxr from there"
                return 1; }
            find "$p/host/fxr" -name libhostfxr.so -type f -print -quit 2>/dev/null | grep -q . || {
                note_fail "$rel: host/fxr holds no libhostfxr.so"; return 1; }
            [[ -d "$p/shared/Microsoft.NETCore.App" ]] || {
                note_fail "$rel: no shared/Microsoft.NETCore.App -- DOTNET_ROOT would point at a runtime that is not there"
                return 1; }

            # THE MISTAKE THAT HAS ACTUALLY HAPPENED. `cp -a ref/bin/dotnet/* bin/`
            # spills the runtime's own top level into bin/ and creates no
            # dotnet/ at all. If dotnet/ is then made by a second, correct copy,
            # the spilled files stay behind and nothing ever complains.
            local stray
            for stray in host shared LICENSE.txt ThirdPartyNotices.txt; do
                [[ -e "$TARGET/bin/$CONFIG/bin/$stray" ]] && {
                    note_fail "bin/$CONFIG/bin/$stray: the runtime was unpacked INTO bin/ instead of bin/dotnet/. Remove it."
                    return 1; }
            done
            ;;
        "$UI_REL")
            [[ -f "$p/index.html" ]] || {
                note_fail "$rel: no index.html -- this is the directory the assembly embeds"
                return 1; }
            ;;
        "$MODCFG_REL")
            [[ -f "$p/config.cfg" ]] || {
                note_fail "$rel: no config.cfg in it"; return 1; }
            ;;
        game/steam_appid.txt|steam_appid.txt)
            grep -Eq '^[0-9]+$' "$p" || {
                note_fail "$rel: not a bare numeric app id"; return 1; }
            ;;
    esac

    return 0
}

#-----------------------------------------------------------------------------
# Copy one entry.
#
# The destination is removed first, because `cp -a SRC DST` on an existing DST
# NESTS instead of replacing -- which is the nested-duplicate failure above,
# created by the very script meant to prevent it. Only ever reached for an entry
# that has already failed its check.
#-----------------------------------------------------------------------------
copy_entry() {
    local rel="$1"
    local src="$REFERENCE/$rel"
    local dst="$TARGET/$rel"

    if [[ ! -e "$src" ]]; then
        note_fail "$rel: not in the reference checkout ($REFERENCE) either"
        return 1
    fi

    rm -rf -- "$dst"
    mkdir -p -- "$(dirname -- "$dst")"
    cp -a -- "$src" "$dst"
}

#-----------------------------------------------------------------------------
# Run.
#-----------------------------------------------------------------------------
echo "worktree : $TARGET"
echo "reference: $REFERENCE"
echo

# For the end check below. Taken BEFORE anything is copied, because a worktree
# with work in progress in it is the normal case -- demanding a pristine tree
# would make the check fire on every run that mattered and be turned off.
status_before="$(git -C "$TARGET" status --porcelain)"

n_ok=0 n_copied=0 n_bad=0 n_warn=0

for entry in "${MANIFEST[@]}"; do
    tier="${entry%%:*}"
    rest="${entry#*:}"
    kind="${rest%%:*}"
    rel="${rest#*:}"

    (( REQUIRED_ONLY )) && [[ "$tier" == opt ]] && continue

    before=${#fail_reasons[@]}

    if check_entry "$kind" "$rel"; then
        printf '  ok       %s\n' "$rel"
        n_ok=$(( n_ok + 1 ))
        continue
    fi

    if [[ "$MODE" == check ]]; then
        if [[ "$tier" == req ]]; then
            printf '  MISSING  %s\n' "$rel"
            n_bad=$(( n_bad + 1 ))
        else
            printf '  missing  %s (convenience)\n' "$rel"
            n_warn=$(( n_warn + 1 ))
        fi
        continue
    fi

    # Drop the reasons that only described the pre-copy state.
    fail_reasons=( "${fail_reasons[@]:0:$before}" )

    if copy_entry "$rel" && check_entry "$kind" "$rel"; then
        printf '  copied   %s\n' "$rel"
        n_copied=$(( n_copied + 1 ))
    elif [[ "$tier" == req ]]; then
        printf '  FAILED   %s\n' "$rel"
        n_bad=$(( n_bad + 1 ))
    else
        printf '  skipped  %s (convenience, not in the reference)\n' "$rel"
        n_warn=$(( n_warn + 1 ))
    fi
done

echo
echo "$n_ok already in place, $n_copied copied, $n_warn skipped, $n_bad unresolved"

#-----------------------------------------------------------------------------
# THE END CHECK, and it catches a whole class of mistake at once: this must add
# NOTHING to `git status`.
#
# Every manifest path is gitignored, so copying one cannot make git notice
# anything. A new entry means a copy landed on TRACKED content -- an archive
# unpacked one directory too high, a reference on a different branch, a manifest
# entry that is not in fact ignored. Reporting "done" over that is how a
# worktree ends up carrying someone else's edits.
#
# Compared against the snapshot taken before the copies rather than against an
# empty tree: a worktree with work in progress in it is the normal case, and a
# check that fires on every interesting run is a check that gets turned off.
#-----------------------------------------------------------------------------
if [[ "$MODE" != check ]]; then
    added="$(git -C "$TARGET" status --porcelain \
             | grep -vxF -f <(printf '%s\n' "$status_before") || true)"
    if [[ -n "$added" ]]; then
        echo
        echo "!! setup made git notice paths it did not notice before. Every"
        echo "!! manifest path is gitignored, so this means something was copied"
        echo "!! over TRACKED content:"
        printf '%s\n' "$added" | head -20 | sed 's/^/     /'
        exit 1
    fi
fi

if (( n_bad )); then
    echo
    echo "unresolved:"
    printf '  %s\n' "${fail_reasons[@]}"
    exit 1
fi

[[ "$MODE" == check ]] && echo "every required entry is present."
exit 0

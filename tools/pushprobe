#!/usr/bin/env python3
"""tools/pushprobe -- reproduce the push jam (plan_physics_managed A39) on purpose.

Usage: tools/pushprobe <holds> [push|knock] [out.jsonl]

It walks from the scenario's pushFloor, as the gate's push and knock-loose
steps do. PUSHPROBE_FLOOR="x y z" overrides it:
"-3843 2894 0" is openFloor, whose path crosses eight concrete_chunk props, and
reproduces the jam (a player standing on one is not leaning).

Launches one game with the gate's own launch line, then repeats the gate's push
setup (or its knock-loose crate) `holds` times in one level, with no reload.
During each hold it samples the player's and the crate's origins as fast as the
dev API answers, and turns on cs_sv_playershadow_trace, so each hold's record
says WHY the pair moved as it did, not only how far:

  arms      which recovery arm ran, counted (impulse, move, far-untouched ...)
  along     the impulses' component along the player's walk, mean and min;
            a negative mean is the recovery pulling the player back
  lead      how far ahead of the player's origin the plan aims the shadow,
            mean over the leaning commands
  arrive    the arrival times the plan asked for

A hold is a JAM when the player's speed in the hold's second second is under
JAM_SPEED: gate_flakes_findings.md measured JAMs creeping at 1.3-12.3 u/s and
FREE walks at 87-235 at d93e976c, against stock's 50 u/s push cap
(player.cpp:8233). It FAILS when the crate moved 4.0 or less, the gate's
threshold (tools/live-gate); failures are the JAMs' lower tail.

First used as a scratch script by the gate-flakes lane; committed with the
trace so a jam can be reproduced and explained from the tree.
"""
import importlib.machinery, importlib.util, json, math, os, re, sys, time
from collections import Counter

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
_path = os.path.join(ROOT, "tools", "live-gate")
_spec = importlib.util.spec_from_file_location(
    "livegate", _path, loader=importlib.machinery.SourceFileLoader("livegate", _path))
lg = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(lg)

TRACE = "[cs_sv_playershadow_trace]"
JAM_SPEED = 30.0
FAIL_MOVED = 4.0
PLAN_RE = re.compile(r"leaning (\d) .*? lead ([-\d.]+) .*? arrive ([-\d.]+)")
RECOVER_RE = re.compile(r"arm (\S+) impulse \(([^)]*)\) along ([-\d.]+)")


def summarise(lines):
    """The trace lines of one hold, reduced to the four suspects' numbers."""
    arms, along, leads, arrive = Counter(), [], [], Counter()
    for line in lines:
        if " plan cmd " in line:
            m = PLAN_RE.search(line)
            if m:
                if m.group(1) == "1":
                    leads.append(float(m.group(2)))
                arrive[m.group(3)] += 1
        elif " recover: " in line:
            m = RECOVER_RE.search(line)
            if m:
                arms[m.group(1)] += 1
                if m.group(1).startswith("impulse"):
                    along.append(float(m.group(3)))
    mean = lambda xs: round(sum(xs) / len(xs), 2) if xs else None
    return {
        "plans": sum(arrive.values()),
        "arms": dict(arms),
        "along_mean": mean(along), "along_min": min(along, default=None),
        "lead_mean": mean(leads), "leaning": len(leads),
        "arrive": dict(arrive.most_common(4)),
    }


def lines_after(path, start):
    try:
        with open(path, errors="replace") as fh:
            return [l.rstrip("\n") for i, l in enumerate(fh) if i >= start and TRACE in l]
    except OSError:
        return []


def line_count(path):
    try:
        with open(path, errors="replace") as fh:
            return sum(1 for _ in fh)
    except OSError:
        return 0


def speed(samples, index, t_from):
    """Units per second of sample column `index` from t_from to the end."""
    pts = [(s[0], s[index]) for s in samples if s[0] >= t_from and s[index]]
    if len(pts) < 2 or pts[-1][0] <= pts[0][0]:
        return None
    return round(lg.distance(pts[0][1], pts[-1][1]) / (pts[-1][0] - pts[0][0]), 2)


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        return 2
    holds = int(sys.argv[1])
    mode = sys.argv[2] if len(sys.argv) > 2 else "push"
    tmp = os.environ.get("TMPDIR", "/tmp")
    scratch = os.path.join(tmp, "pushprobe-%d" % os.getpid())
    os.makedirs(scratch, exist_ok=True)
    out = sys.argv[3] if len(sys.argv) > 3 else os.path.join(scratch, "holds.jsonl")

    scen = lg.load_scenario("dm_lockdown")
    scen["openFloor"] = scen["pushFloor"]
    if os.environ.get("PUSHPROBE_FLOOR"):
        scen["openFloor"] = [float(v) for v in os.environ["PUSHPROBE_FLOOR"].split()]
    port = lg.free_udp_port(*lg.GATE_PORT_RANGE)
    console_name = "pushprobe-%d.log" % os.getpid()
    console_path = os.path.join(lg.MOD_DIR, console_name)
    log = os.path.join(scratch, "server.log")
    args = lg.server_launch(port, scen["map"]) + ["+con_logfile", console_name]
    game = lg.Game.launch(args, log, os.path.join(scratch, "server"))
    if game is None:
        print("pushprobe: the game never opened its dev API socket")
        return 1
    api = game.api
    print("pushprobe: pid %s, console %s, records %s" % (api.pid, console_path, out), flush=True)
    if not api.wait_for(lambda: api.player(scen["playerClass"]), 120.0):
        print("pushprobe: no player joined")
        game.kill()
        return 1
    time.sleep(6.0)
    g = lg.Gate(api, scen)
    g.server_port = port
    g.scratch = scratch
    g.own_log = log
    g.count_log = lambda n: lg.count_in(log, n)
    g.last_log_line = lambda n: lg.last_line_in(log, n)
    g.count_console = lambda n: lg.count_in(console_path, n)
    g.last_console_line = lambda n: lg.last_line_in(console_path, n)
    jams = fails = 0
    with open(out, "a") as fh:
        try:
            g.cheats()
            for h in range(holds):
                rec = {"hold": h, "mode": mode}
                g.teleport(scen["openFloor"], scen["openFloorAngles"], settle=1.2)
                if mode == "push":
                    index, resting, _ = lg.spawn_prop(g)
                else:
                    lg.kill_prop(g, lg.KNOCK_NAME)
                    before = {e["index"] for e in api.ents("prop_physics")}
                    api.cmd("ent_create prop_physics model %s targetname %s forcetoenablemotion 1000"
                            % (scen["propModel"], lg.KNOCK_NAME))
                    fresh = api.wait_for(
                        lambda: [e for e in api.ents("prop_physics") if e["index"] not in before], 10.0)
                    index = fresh[0]["index"] if fresh else None
                    time.sleep(1.0)
                    resting = lg.prop_origin(g, index) if index else None
                if index is None or resting is None:
                    rec["error"] = "no prop"
                    fh.write(json.dumps(rec) + "\n")
                    fh.flush()
                    continue
                here = g.player_origin()
                dx, dy = resting[0] - here[0], resting[1] - here[1]
                span = math.hypot(dx, dy) or 1.0
                g.teleport([resting[0] - dx / span * 64.0, resting[1] - dy / span * 64.0, resting[2]], settle=1.2)
                g.face(resting, lift=64.0)
                p0 = g.player_origin()

                since = api.events_next()
                me = api.player(scen["playerClass"])
                pidx = me["index"] if me else 1
                first = line_count(console_path)
                api.cmd("cs_sv_playershadow_trace 1")
                samples = []
                api.cmd("+forward")
                t0 = time.time()
                while time.time() < t0 + (2.0 if mode == "push" else 1.5):
                    pl = api.get("ent", "index=%d" % pidx)
                    found = pl.get("found")
                    samples.append([round(time.time() - t0, 3), pl.get("origin") if found else None,
                                    lg.prop_origin(g, index), pl.get("ground") if found else None])
                api.cmd("-forward")
                api.cmd("cs_sv_playershadow_trace 0")
                time.sleep(0.8)
                trace = lines_after(console_path, first)
                outputs = sorted({str(e.get("name")) for e in api.events_all(since)
                                  if e.get("index") == index and e.get("kind") == "output"})
                grounds = Counter(s[3] for s in samples if len(s) > 3 and s[3] not in (None, -1))
                ground_names = {}
                for gi in grounds:
                    e = api.get("ent", "index=%d" % gi)
                    o = e.get("origin") or [0, 0, 0]
                    ground_names[str(gi)] = "%s '%s' at (%.0f %.0f %.0f)%s" % (
                        e.get("classname", "?"), e.get("name", ""), o[0], o[1], o[2],
                        " (the crate)" if gi == index else "")

                p1 = g.player_origin()
                pr1 = lg.prop_origin(g, index)
                moved = lg.distance(resting, pr1) if pr1 else None
                late = speed(samples, 1, 1.0)
                jam = late is not None and late < JAM_SPEED
                failed = moved is not None and moved <= FAIL_MOVED
                jams += jam
                fails += failed
                rec.update(crate_index=index, outputs=outputs, start=p0, end=p1, rest=resting, prop_end=pr1, moved=moved, jam=jam,
                           failed=failed,
                           walked=lg.distance(p0, p1) if p0 and p1 else None,
                           player_speed_late=late, crate_speed_late=speed(samples, 2, 1.0),
                           grounds={str(k): v for k, v in grounds.items()}, ground_names=ground_names,
                           trace=summarise(trace), trace_lines=len(trace), samples=samples)
                fh.write(json.dumps(rec) + "\n")
                fh.flush()
                t = rec["trace"]
                print("hold %d %s%s moved %.1f player %s crate #%s %s u/s | outputs %s | grounds %s | arms %s along %s lead %s arrive %s" % (
                    h, "JAM " if jam else "free", " FAIL" if failed else "", moved or -1, late, index,
                    rec["crate_speed_late"], outputs, {"#%s %s" % (k, ground_names.get(str(k), "?")): v for k, v in grounds.items()},
                    t["arms"], t["along_mean"], t["lead_mean"], list(t["arrive"])), flush=True)
                lg.kill_prop(g, lg.KNOCK_NAME if mode == "knock" else lg.PROP_NAME)
        finally:
            game.kill()
    print("pushprobe: %d of %d holds jammed (player under %.0f u/s late), %d failed (crate moved %.1f or less)"
          % (jams, holds, JAM_SPEED, fails, FAIL_MOVED))
    return 0


sys.exit(main())

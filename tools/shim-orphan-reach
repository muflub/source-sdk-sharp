#!/usr/bin/env python3
"""
tools/shim-orphan-reach -- does anything still import what this object defines?

    tools/shim-orphan-reach shell_player_orphans.o
    tools/shim-orphan-reach --side server shell_absent.o
    tools/shim-orphan-reach --quiet shell_player_orphans.o   # exit 1 if any DEAD
    tools/shim-orphan-reach --self-test

=============================================================================
WHY THIS EXISTS
=============================================================================

The shim has several LINKER-SATISFACTION files -- `shell_player_orphans.cpp`,
`shell_client_orphans.cpp`, `shell_absent.cpp`.  Each holds definitions that
exist only because some still-compiled translation unit references them, and
each one's header says the same thing:

    Found by removing the files and reading the linker, which is also how
    entries come off this list.

Removing a definition and rebuilding IS that reading, but it is destructive,
serial, and it answers one symbol at a time.  This answers all of them at once,
non-destructively, BEFORE the removal.

`tools/shim-census who-imports` answers the same question per FILE.  This one
answers it per SYMBOL, which is what a file whose whole content is a list of
unrelated definitions needs: `shell_player_orphans.o` had twenty-six, and five
of them were imported.

=============================================================================
WHAT IT REFUSES, AND WHY THAT MATTERS MORE THAN WHAT IT ANSWERS
=============================================================================

An unbuilt tree answers "nobody imports anything" -- which looks exactly like
"every definition here is dead" and would delete a whole file.  That is failure
mode 8 in the Phase 4 addendum, a tool REFUSAL recorded as a zero, and it is
what killed `handle_cross.h` on paper (called dead with one consumer; it has
102 server / 169 client live TUs).

So: every object on the .so's link edge must be ON DISK, and if one is not this
refuses with exit 2 and says which.  It does NOT read the object directory
(`CMakeFiles/<target>.dir/`) as a directory -- that keeps objects of
translation units the build has evicted, and 101 such ghosts once inflated
consumer counts by up to 13x.  The objects are the explicit inputs of the
link edge in the CMake build's build.ninja (tools/cmakegraph.py), each mapped
to its source by compile_commands.json, which is refused when it disagrees
with the target's CMakeLists source list.

Objects are named in VPC's flat spelling, the source's file name with `.o`
(`shell_player_orphans.o`): CMake's `shell_player_orphans.cpp.o` is accepted
too, and both mean the one object on the link edge with that stem.

    --build-dir D   the CMake build (default `build`, i.e. farm/<config>/build
                    when run from the farm root, as the tests do)

THE SYMBOL-TYPE FILTER IS NOT DECORATION.  A plain `nm` counts weak inline
emissions (`W`) as definitions, and an orphan file full of one-line bodies
picks up dozens of them from the headers it includes -- `Vector::Init`,
`Vector2D::Vector2D`.  Only `T`, `B` and `D` are this file's own.

=============================================================================
WHERE IT STOPS
=============================================================================

A count of undefined references is a FLOOR, not a total:

  * a VIRTUAL call emits no symbol, so a definition reached through a vtable
    reads DEAD here.  Check with `nm -C <objects> | grep 'vtable for <Class>'`:
    if no object emits the class's vtable, no instance exists and no virtual
    call can dispatch to it, which is what makes the floor exact.
  * a SIBLING in the same object does not import its neighbour, so a DEAD
    symbol may still be called by another DEAD symbol.  Delete the transitive
    set, not the flat one.
  * reached BY NAME -- a ConCommand, a ConVar, an interface string -- is
    invisible here, as it is to every symbol census.
"""
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import cmakegraph  # noqa: E402


def die(msg):
    print('shim-orphan-reach: %s' % msg, file=sys.stderr)
    sys.exit(2)


def object_name(path):
    """VPC's flat object name: shell_player_orphans.cpp.o -> shell_player_orphans.o."""
    return re.sub(r'\.(cpp|cc|c)\.o$', '.o', os.path.basename(path))


def graph_objects(side, bdir):
    """The objects on the side's link edge (absolute), sorted. Not checked for
    presence on disk here: run() does that, so it can say how many are missing."""
    target = cmakegraph.SIDES.get(side)
    if target is None:
        die("unknown side '%s' (server or client)" % side)
    try:
        objs = cmakegraph.link_edge(target, bdir)['objects']
        n = len(cmakegraph.compiled_sources(target, bdir))
    except cmakegraph.GraphError as e:
        die(str(e))
    if len(objs) != n:
        die("build.ninja links %d objects into '%s' but compile_commands.json compiles "
            "%d sources" % (len(objs), target, n))
    return sorted(set(objs))


def defined_symbols(path):
    out = subprocess.run(['nm', '-C', '--defined-only', path],
                         capture_output=True, text=True).stdout
    found = set()
    for line in out.split('\n'):
        m = re.match(r'^\S*\s+([A-Za-z])\s+(.+)$', line)
        # T text, B bss, D data.  NOT W: a weak inline emission belongs to the
        # header it came from, not to this translation unit.
        if m and m.group(1) in 'TBD':
            found.add(m.group(2))
    return found


def undefined_symbols(path):
    out = subprocess.run(['nm', '-C', '-u', path], capture_output=True, text=True).stdout
    return set(l.split(None, 1)[1] for l in out.split('\n') if l.strip().startswith('U '))


def run(objname, side, quiet, bdir):
    objs = graph_objects(side, bdir)
    if not objs:
        print('shim-orphan-reach: the graph names no %s objects' % side, file=sys.stderr)
        return 2

    missing = [o for o in objs if not os.path.exists(o)]
    if missing:
        print('shim-orphan-reach: REFUSING -- %d of %d %s objects the graph names are '
              'not on disk (build first; an unbuilt tree answers "nobody imports '
              'anything", which looks exactly like "delete this file").'
              % (len(missing), len(objs), side), file=sys.stderr)
        print('  first: %s' % missing[0], file=sys.stderr)
        return 2

    subject = [o for o in objs if object_name(o) == object_name(objname)]
    if len(subject) != 1:
        print('shim-orphan-reach: %s names %d objects on the %s graph, not 1'
              % (objname, len(subject), side), file=sys.stderr)
        return 2

    spath = subject[0]
    defined = defined_symbols(spath)

    if not defined:
        print('shim-orphan-reach: %s defines no T/B/D symbols at all -- either it is '
              'empty or the type filter no longer matches this nm.' % objname,
              file=sys.stderr)
        return 2

    importers = {d: set() for d in defined}
    for o in objs:
        if o == subject[0]:
            continue
        names = undefined_symbols(o)
        for d in defined & names:
            importers[d].add(object_name(o))

    dead = sorted(d for d in defined if not importers[d])

    if not quiet:
        print('# tools/shim-orphan-reach -- %s (%s side)' % (objname, side))
        print('# %d objects on the graph, all on disk (%s)' % (len(objs), bdir))
        print('# %s defines %d symbols (T/B/D only)' % (objname, len(defined)))
        for d in sorted(defined):
            who = sorted(importers[d])
            print('%-5s %-58s %s' % ('LIVE' if who else 'DEAD', d, ','.join(who)))
        print('# %d imported, %d with no importer on the %s link line'
              % (len(defined) - len(dead), len(dead), side))
        if dead:
            print('# A DEAD row is a FLOOR, not a verdict: a virtual call emits no '
                  'symbol, and a sibling in this same object does not import its '
                  'neighbour. See this tool\'s header.')

    return 1 if dead else 0


def self_test(bdir):
    """Each check names what would make it fail."""
    ok = True

    def check(name, cond, why):
        nonlocal ok
        print('%-4s %s' % ('ok' if cond else 'FAIL', name))
        if not cond:
            ok = False
            print('     ' + why)

    objs = graph_objects('client', bdir)
    check('the client link edge parses', len(objs) > 100,
          "build.ninja's link-edge shape changed, or the build is not generated")
    check('object names normalise to VPC\'s flat spelling',
          object_name('/b/CMakeFiles/client_sourcesharp.dir/x/shell_player_orphans.cpp.o')
          == 'shell_player_orphans.o' and object_name('shell_player_orphans.o')
          == 'shell_player_orphans.o',
          'object_name() no longer maps x.cpp.o to x.o, so no VPC-spelled name matches')

    missing = [o for o in objs if not os.path.exists(o)]
    if missing:
        print('SKIP: the tree is not built (%d objects missing), so the symbol '
              'checks below cannot run. That is the refusal working.' % len(missing))
        return 0 if ok else 1

    # The filter is the point.  Without it, a one-line-bodies file picks up the
    # weak inline emissions of every header it includes.
    subject = [o for o in objs if object_name(o) == 'shell_player_orphans.o']
    check('shell_player_orphans is on the client link edge', len(subject) == 1,
          'the object this self-test demonstrates the filter on is gone; pick another')
    if subject:
        p = subject[0]
        filtered = defined_symbols(p)
        raw = subprocess.run(['nm', '-C', '--defined-only', p],
                             capture_output=True, text=True).stdout
        weak = len([l for l in raw.split('\n') if re.match(r'^\S*\s+W\s+', l)])
        check('the symbol-type filter drops weak emissions', weak > 0,
              'shell_player_orphans.o emits no weak symbols, so this run does not '
              'demonstrate that the filter does anything; find an object that does')
        check('and keeps the real definitions', len(filtered) > 0,
              'the filter dropped everything, so every DEAD row would be vacuous')

    print('\n%s' % ('all checks passed' if ok else 'SELF-TEST FAILED'))
    return 0 if ok else 1


def main(argv):
    side, quiet, name, bdir, selftest = 'client', False, None, 'build', False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == '--self-test':
            selftest = True
        elif a == '--build-dir':
            i += 1
            bdir = argv[i]
        elif a == '--side':
            i += 1
            side = argv[i]
        elif a == '--quiet':
            quiet = True
        elif a.startswith('-'):
            print(__doc__.strip(), file=sys.stderr)
            return 2
        else:
            name = a
        i += 1

    bdir = os.path.abspath(bdir)
    if selftest:
        return self_test(bdir)
    if not name:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return run(name, side, quiet, bdir)


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))

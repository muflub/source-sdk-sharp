def brightest(paths):
    """The screenshot with the most light in it: a burst's muzzle flash."""
    from PIL import Image, ImageStat
    return max(paths, key=lambda p: ImageStat.Stat(Image.open(p).convert("L")).mean[0])


# The surfaces whose "bulletimpact" names another script, in Source SDK Base
# 2013's hl2/scripts/surfaceproperties.txt: a bullet into plaster plays
# drywall.ImpactHard, into plastic or an item Plastic_Box.ImpactHard, into a
# grenade Grenade.ImpactHard. Each is a bullet impact when a round makes it.
BULLET_IMPACT_ALIASES = {"drywall.impacthard", "plastic_box.impacthard", "grenade.impacthard"}


def weapon_sounds(sounds):
    """
    A press's sounds without the props it happened to hit (physics/...), with
    a raw wave's numbered variant folded (shotgun_shell1.wav and
    shotgun_shell3.wav are one sound picked at random), and a round's impact
    folded to its kind: which surface a pellet lands on follows the command's
    spread seed, and the two games number their commands differently.
    """
    out = set()
    for s in sounds:
        side, name = s.split(":", 1)
        if name.lower().startswith("physics/"):
            continue
        if name.lower() in BULLET_IMPACT_ALIASES:
            name = "<surface>.bulletimpact"
        name = re.sub(r"^[A-Za-z_]+\.(bulletimpact|impacthard|impactsoft)$", r"<surface>.\1", name)
        out.add(side + ":" + re.sub(r"\d+(\.wav)$", r"#\1", name))
    return sorted(out)


def ammo_delta(before, after):
    """What one press changed: each pool's count, and the active weapon's clip."""
    pools = {k: after["ammo"].get(k, 0) - before["ammo"].get(k, 0)
             for k in set(before["ammo"]) | set(after["ammo"])}
    pools = {k: v for k, v in pools.items() if v != 0}
    weapon = after["active"] or before["active"]
    clip = None
    if weapon in before["weapons"] and weapon in after["weapons"]:
        clip = after["weapons"][weapon] - before["weapons"][weapon]
    return {"pools": pools, "clip": clip}


def weapon_round(stock, sharp, weapon, camera, out, tool, opts):
    """One weapon in both games: equipped, idle, primary, secondary."""
    record = {"weapon": weapon}
    for game in (stock, sharp):
        game.cmd("give " + weapon)
    time.sleep(1.0)
    for game in (stock, sharp):
        game.cmd("use " + weapon + "; " + pose_command(camera))
    time.sleep(2.5)

    arsenals = {"stock": stock.arsenal(), "sharp": sharp.arsenal()}
    record["has"] = {side: weapon in a["weapons"] for side, a in arsenals.items()}
    record["active"] = {side: a["active"] for side, a in arsenals.items()}

    files = []
    for suffix in ("a", "b"):
        files.append((stock.screenshot("sab_%s_idle_%s" % (weapon, suffix)),
                      sharp.screenshot("sab_%s_idle_%s" % (weapon, suffix))))
        time.sleep(PAIR_GAP_SECONDS)
    idle = subprocess.run(tool + ["compare", "--out", out, "--name", weapon + "-idle", "--title", weapon + " equipped",
                                  "--threshold", str(opts.threshold), "--tolerance", str(opts.tolerance),
                                  files[0][0], files[1][0], files[0][1], files[1][1]],
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    record["idle"] = json.loads(idle.stdout)["Score"] if idle.returncode in (0, 1) else {"error": idle.stdout}

    for attack in ("attack", "attack2"):
        marks = {"stock": stock.console_mark(), "sharp": sharp.console_mark()}
        before = {"stock": stock.arsenal(), "sharp": sharp.arsenal()}
        # Slowed four times so a muzzle flash, which lasts a few frames, is in
        # a burst of screenshots; each game's brightest frame is its flash.
        for game in (stock, sharp):
            game.cmd("host_timescale %s; +%s" % (FIRE_TIMESCALE, attack))
        burst = {"stock": [], "sharp": []}
        for k in range(FLASH_BURST):
            burst["stock"].append(stock.screenshot("sab_%s_%s_%d" % (weapon, attack, k)))
            burst["sharp"].append(sharp.screenshot("sab_%s_%s_%d" % (weapon, attack, k)))
        for game in (stock, sharp):
            game.cmd("-" + attack)
        time.sleep(1.0)
        for game in (stock, sharp):
            game.cmd("host_timescale 1")
        time.sleep(1.0)
        flash = (brightest(burst["stock"]), brightest(burst["sharp"]))
        after = {"stock": stock.arsenal(), "sharp": sharp.arsenal()}
        sounds = {"stock": sound_names(stock.console_since(marks["stock"])),
                  "sharp": sound_names(sharp.console_since(marks["sharp"]))}
        subprocess.run(tool + ["compare", "--out", out, "--name", "%s-%s" % (weapon, attack),
                               "--title", "%s %s" % (weapon, attack), "--threshold", str(opts.threshold),
                               "--tolerance", "100", flash[0], flash[0], flash[1], flash[1]],
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        record[attack] = {side: {"ammo": ammo_delta(before[side], after[side]), "sounds": sounds[side]}
                          for side in ("stock", "sharp")}
        for path in burst["stock"] + burst["sharp"]:
            os.remove(path)
    for shot in files:
        for path in shot:
            os.remove(path)

    with open(os.path.join(out, "weapons.jsonl"), "a") as f:
        f.write(json.dumps(record) + "\n")
    return record


def weapon_verdict(record):
    """Where the two games disagree about one weapon, as short phrases."""
    problems = []
    if record["has"]["stock"] != record["has"]["sharp"]:
        problems.append("only %s has it" % ("stock" if record["has"]["stock"] else "SourceSharp"))
        return problems
    if isinstance(record.get("idle"), dict) and record["idle"].get("Verdict") == "Fail":
        problems.append("looks different equipped (%.1f%%)" % record["idle"]["DifferingPercent"])
    for attack in ("attack", "attack2"):
        a = record[attack]
        if a["stock"]["ammo"] != a["sharp"]["ammo"]:
            problems.append("%s ammo %s vs %s" % (attack, a["stock"]["ammo"], a["sharp"]["ammo"]))
        stock_sounds, sharp_sounds = weapon_sounds(a["stock"]["sounds"]), weapon_sounds(a["sharp"]["sounds"])
        if stock_sounds != sharp_sounds:
            missing = [x for x in stock_sounds if x not in sharp_sounds]
            extra = [x for x in sharp_sounds if x not in stock_sounds]
            problems.append("%s sounds: missing %s, extra %s" % (attack, missing, extra))
    return problems


def noclip_on(game, read_eye):
    """noclip is a toggle: turn it on, then prove the camera hangs in the air."""
    # A player still spawning ignores it, so keep toggling until it holds.
    probe = {"origin": (0.0, 0.0, 400.0), "angles": (0.0, 0.0, 0.0)}
    for _ in range(6):
        game.cmd(pose_command(probe))
        time.sleep(1.5)
        if eye_matches(read_eye(), probe):
            return
        game.cmd("noclip")
        time.sleep(1.0)
    raise RunError("could not put %s in noclip" % type(game).__name__)


def run(opts):
    sdk = os.path.abspath(opts.sdk)
    refuse_protected(sdk)
    config = opts.config
    sandbox = opts.map == "ss_sandbox"
    bsp = os.path.join(ROOT, "bin", config, "mods", "test", "maps", opts.map + ".bsp")
    source_bsp = os.path.join(sdk, "game", "mod_hl2mp", "maps", opts.map + ".bsp")
    for path, why in ((os.path.join(sdk, "game", "mod_hl2mp", "bin", "linux64", "client.so"), "stock-ab build"),
                      (os.path.join(ROOT, "bin", config, "source#"), "make " + config),
                      (bsp, "make map MAP=%s CONFIG=%s" % (opts.map, config) if sandbox else "the map in the test mod"),
                      (source_bsp if not sandbox else bsp, "the same map in stock's mod_hl2mp/maps"),
                      (os.path.join(ENGINE, "hl2_linux64"), "Source SDK Base 2013 Multiplayer installed")):
        if not os.path.exists(path):
            raise RunError("%s is missing (needs: %s)" % (path, why))

    stamp = time.strftime("%Y%m%d-%H%M%S")
    out = os.path.abspath(opts.out or os.path.join(ROOT, "bin", config, "stock-ab", stamp))
    os.makedirs(out, exist_ok=True)
    # Short, private and ours: the dev API socket path must stay under 108 bytes.
    work = tempfile.mkdtemp(prefix="sab-", dir="/tmp")

    log("building the image tool")
    dotnet(["build", "-v", "q", "-nologo", os.path.join(ROOT, "src", "tools", "StockAb", "SourceSharp.StockAb.csproj")])
    tool = [DOTNET, os.path.join(ROOT, "bin", "debug", "tools", "stock-ab", "SourceSharp.StockAb.dll")]

    stock = StockGame(sdk, work, opts.map)
    sharp = SharpGame(config, work, opts.map)
    stock.prepare()
    if sandbox:
        log("writing stock's copy of %s" % bsp)
        mapgen = [DOTNET, "run", "--project", os.path.join(ROOT, "src", "mapgen"), "--"]
        subprocess.run(mapgen + ["stockmap", bsp, os.path.join(stock.mod, "maps", "ss_sandbox.bsp")],
                       check=True, stdout=subprocess.PIPE)
        stations = parse_stations(subprocess.run(mapgen + ["stations"], check=True, stdout=subprocess.PIPE, text=True).stdout)
        views = cameras(stations)
    else:
        # Another map is compared only as the same bytes in both mods.
        if not same_file(bsp, source_bsp):
            raise RunError("%s and %s differ; census needs one map" % (bsp, source_bsp))
        views = []
    if opts.only:
        wanted = set(opts.only.split(","))
        views = [v for v in views if v["name"] in wanted]
        missing = wanted - {v["name"] for v in views}
        if missing:
            raise RunError("no camera named %s" % ", ".join(sorted(missing)))

    failed = False
    try:
        log("launching stock hl2mp and SourceSharp (%s)" % config)
        stock.launch()
        sharp.launch()
        wait_for(stock.ready, 240, "stock hl2mp to join " + opts.map, 1.0)
        wait_for(sharp.ready, 240, "SourceSharp to join " + opts.map, 1.0)
        log("both joined; stock log %s, SourceSharp pid %s" % (stock.log_path, sharp.pid))

        stock.cmd(SETUP)
        sharp.cmd(SETUP)
        stock.cmd("noclip")
        sharp.cmd("noclip")
        noclip_on(stock, lambda: stock.view()["eye"])
        noclip_on(sharp, sharp.eye)

        log("entity census")
        stock_ents = os.path.join(out, "stock-ents.tsv")
        sharp_ents = os.path.join(out, "sharp-ents.json")
        stock.dump_entities(stock_ents)
        sharp.dump_entities(sharp_ents)
        census = subprocess.run(tool + ["census", stock_ents, sharp_ents, os.path.join(out, "census.json")],
                                check=True, stdout=subprocess.PIPE, text=True).stdout
        print(census, end="", flush=True)

        log("solidity census")
        stock_solid = os.path.join(out, "stock-solidity.tsv")
        stock.dump_solidity(stock_solid)
        solidity = subprocess.run(tool + ["solidity", stock_solid, sharp_ents, os.path.join(out, "solidity.json")],
                                  check=True, stdout=subprocess.PIPE, text=True).stdout
        print(solidity, end="", flush=True)

        if opts.weapons:
            wanted = WEAPONS if opts.weapons == "all" else opts.weapons.split(",")
            xs = [s["x"] for s in stations] if sandbox else [0.0]
            ys = [s["y"] for s in stations] if sandbox else [0.0]
            camera = {"origin": (min(xs) - WEAPON_CAMERA_BACK, min(ys) - WEAPON_CAMERA_BACK, 60.0),
                      "angles": (2.0, 45.0, 0.0)}
            for game in (stock, sharp):
                game.cmd("r_drawviewmodel 1; sv_soundemitter_trace 1")
            weapons_path = os.path.join(out, "weapons.jsonl")
            if os.path.exists(weapons_path):
                os.remove(weapons_path)
            for weapon in wanted:
                record = weapon_round(stock, sharp, weapon, camera, out, tool, opts)
                problems = weapon_verdict(record)
                failed |= bool(problems)
                log("%-18s %s" % (weapon, "; ".join(problems) if problems else "matches stock"))
            views = []

        shots_path = os.path.join(out, "shots.jsonl")
        if os.path.exists(shots_path):
            os.remove(shots_path)
        for view in views:
            command = pose_command(view)
            stock.cmd(command)
            sharp.cmd(command)
            time.sleep(SETTLE_SECONDS)
            for name, eye in (("stock", stock.view()["eye"]), ("SourceSharp", sharp.eye())):
                if not eye_matches(eye, view):
                    raise RunError("%s's camera for %s is at %s, not %s" % (name, view["name"], eye, view["origin"]))
            files = []
            for suffix in ("a", "b"):
                files.append((stock.screenshot("sab_%s_%s" % (view["name"], suffix)),
                              sharp.screenshot("sab_%s_%s" % (view["name"], suffix))))
                time.sleep(PAIR_GAP_SECONDS)
            compare = subprocess.run(tool + [
                "compare", "--out", out, "--name", view["name"], "--title", view["title"],
                "--threshold", str(opts.threshold), "--tolerance", str(opts.tolerance),
                files[0][0], files[1][0], files[0][1], files[1][1]],
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            if compare.returncode not in (0, 1):
                raise RunError("compare failed for %s: %s" % (view["name"], compare.stdout))
            score = json.loads(compare.stdout)["Score"]
            failed |= score["Verdict"] == "Fail"
            log("%-12s %-12s differing %6.2f%%  luma ratio %.3f  still %5.1f%%" % (
                view["name"], score["Verdict"], score["DifferingPercent"], score["LumaRatio"], score["StillPercent"]))
            for shot in files:
                for path in shot:
                    os.remove(path)
    finally:
        stock.stop()
        sharp.stop()
        shutil.rmtree(work, ignore_errors=True)

    head = subprocess.run(["git", "-C", ROOT, "rev-parse", "--short", "HEAD"], stdout=subprocess.PIPE, text=True).stdout.strip()
    stock_head = git(["log", "--oneline", "-1", "--format=%h"], cwd=sdk).stdout.strip()
    report = subprocess.run(tool + ["report", out, "sourcesharp=%s (%s)" % (head, config), "stock=%s" % stock_head,
                                    "threshold=%d" % opts.threshold, "tolerance=%s" % opts.tolerance],
                            check=True, stdout=subprocess.PIPE, text=True).stdout.strip()
    log("report: " + report)
    return 1 if failed else 0


#-----------------------------------------------------------------------------
# self-test
#-----------------------------------------------------------------------------

def self_test():
    stations = parse_stations("health\t-960\t-2560\t0\tHEALTH\nammo\t-320\t-2560\t0\tAMMO\n")
    assert [s["slug"] for s in stations] == ["health", "ammo"], stations

    try:
        parse_stations("")
        raise AssertionError("an empty station list was accepted")
    except RunError:
        pass

    views = cameras(stations)
    assert [v["name"] for v in views] == ["health", "ammo", "overview"], views
    assert views[0]["origin"] == (-1260.0, -2860.0, 120.0), views[0]
    assert pose_command(views[0]) == "setpos -1260.0 -2860.0 120.0; setang 22.0 45.0 0.0", pose_command(views[0])
    assert views[2]["origin"][:2] == (-1160.0, -2760.0), views[2]

    view = parse_view("t3\t1\t-1260.000 -2860.000 184.000\t22.000 45.000 0.000\t100\n")
    assert view["player"] and view["eye"] == (-1260.0, -2860.0, 184.0), view
    assert eye_matches(view["eye"], views[0])
    assert not eye_matches((-1260.0, -2860.0, 120.0), views[0]), "an eye at the origin is not the camera"
    assert not parse_view("t1\t0\t0 0 0\t0 0 0\t0\n")["player"]

    answer = json.dumps({"ok": True, "captured": {"console": [
        "setpos -1260.000000 -2860.000000 184.000000;", "setang 22 45 0"]}})
    assert parse_getpos(answer) == (-1260.0, -2860.0, 184.0)
    for bad in ('{"ok":false}', "not json", json.dumps({"captured": {"console": ["setang 0 0 0"]}})):
        try:
            parse_getpos(bad)
            raise AssertionError("getpos answer accepted: %r" % bad)
        except RunError:
            pass

    with tempfile.TemporaryDirectory() as scratch:
        lock = os.path.join(scratch, "x")
        os.makedirs(lock)
        # The real locks name the fork and the oracle clone; neither is a scratch dir.
        refuse_protected(lock)
        for name in ("sdk-root.lock.local", "valve-sdk.lock.local"):
            path = os.path.join(ROOT, name)
            if os.path.exists(path):
                named = open(path).read().strip()
                if named:
                    try:
                        refuse_protected(named)
                        raise AssertionError("%s's checkout was accepted" % name)
                    except RunError:
                        pass

    with tempfile.TemporaryDirectory() as scratch:
        one, two, three = (os.path.join(scratch, n) for n in ("1", "2", "3"))
        for path, text in ((one, b"map"), (two, b"map"), (three, b"maq")):
            with open(path, "wb") as f:
                f.write(text)
        assert same_file(one, two) and not same_file(one, three)

    arsenal = parse_stock_arsenal("weapon\tweapon_pistol\t18\t-1\t1\nammo\tPistol\t150\n#end\tt4\n")
    assert arsenal == {"weapons": {"weapon_pistol": 18}, "active": "weapon_pistol", "ammo": {"pistol": 150}}, arsenal
    sharp_arsenal = parse_sharp_arsenal(["[SourceSharp/Arsenal] player 1: 2 weapon(s)",
                                         "  weapon_crowbar  clip -1", "  weapon_pistol  clip 17  (active)",
                                         "  pool Pistol: 150"])
    assert sharp_arsenal == {"weapons": {"weapon_crowbar": -1, "weapon_pistol": 17}, "active": "weapon_pistol",
                             "ammo": {"pistol": 150}}, sharp_arsenal
    delta = ammo_delta(arsenal, sharp_arsenal)
    assert delta == {"pools": {}, "clip": -1}, delta
    assert sound_names(["(sv) EmitSound:  'Weapon_Pistol.Single' emitted as 'weapons/pistol/pistol_fire2.wav' (ent 1)",
                        "(cl) EmitSound:  Raw wave emitted 'weapons/x.wav' (ent 3)", "noise"]) == \
        ["sv:Weapon_Pistol.Single", "cl:weapons/x.wav"]
    same = {"weapon": "w", "has": {"stock": True, "sharp": True}, "idle": {"Verdict": "Pass"},
            "attack": {"stock": {"ammo": delta, "sounds": ["sv:A"]}, "sharp": {"ammo": delta, "sounds": ["sv:A"]}},
            "attack2": {"stock": {"ammo": delta, "sounds": []}, "sharp": {"ammo": delta, "sounds": []}}}
    assert weapon_verdict(same) == [], weapon_verdict(same)
    same["attack"]["sharp"] = {"ammo": delta, "sounds": ["sv:A", "sv:physics/metal/can.wav"]}
    assert weapon_verdict(same) == [], "a prop the bullet hit is not the weapon's sound"
    assert weapon_sounds(["cl:weapons/fx/tink/shotgun_shell1.wav", "cl:weapons/fx/tink/shotgun_shell3.wav",
                          "sv:Weapon_SMG1.Single"]) == ["cl:weapons/fx/tink/shotgun_shell#.wav", "sv:Weapon_SMG1.Single"]
    assert weapon_sounds(["cl:tile.bulletimpact", "cl:wood.bulletimpact"]) == ["cl:<surface>.bulletimpact"]
    assert weapon_sounds(["cl:wood.impacthard"]) != weapon_sounds(["cl:wood.bulletimpact"]), \
        "a hard impact is not a bullet impact"
    assert weapon_sounds(["cl:drywall.impacthard"]) == weapon_sounds(["cl:tile.bulletimpact"]), \
        "plaster's bullet impact is drywall.ImpactHard"
    same["attack"]["sharp"] = {"ammo": delta, "sounds": ["sv:B"]}
    assert len(weapon_verdict(same)) == 1, weapon_verdict(same)
    assert weapon_verdict({"weapon": "w", "has": {"stock": True, "sharp": False}}) == ["only stock has it"]

    print("stock-ab self-test: ok")
    return 0


def main():
    if sys.argv[1:] == ["--self-test"]:
        return self_test()

    parser = argparse.ArgumentParser(prog="stock-ab", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)
    f = sub.add_parser("fetch")
    f.add_argument("--sdk", default=DEFAULT_SDK)
    f.add_argument("--from", dest="source", default=UPSTREAM_URL)
    b = sub.add_parser("build")
    b.add_argument("--sdk", default=DEFAULT_SDK)
    b.add_argument("--mode", default="release", choices=["release", "debug"])
    r = sub.add_parser("run")
    r.add_argument("--sdk", default=DEFAULT_SDK)
    r.add_argument("--config", default="release", choices=["release", "debug"])
    r.add_argument("--only")
    r.add_argument("--threshold", type=int, default=24)
    r.add_argument("--tolerance", type=float, default=5.0)
    r.add_argument("--out")
    r.add_argument("--map", default="ss_sandbox")
    r.add_argument("--weapons", help="all, or a comma list: give, equip and fire each in both games")
    opts = parser.parse_args()

    try:
        if opts.command == "fetch":
            fetch(os.path.abspath(opts.sdk), opts.source)
            return 0
        if opts.command == "build":
            build(os.path.abspath(opts.sdk), opts.mode)
            return 0
        return run(opts)
    except (RunError, subprocess.CalledProcessError) as error:
        log("FAILED: %s" % error)
        return 2


if __name__ == "__main__":
    sys.exit(main())

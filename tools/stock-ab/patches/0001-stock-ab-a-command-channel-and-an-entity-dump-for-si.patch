--- /dev/null
+++ b/src/game/client/ss_ab_client.cpp
@@ -0,0 +1,108 @@
+//========= SourceSharp stock A/B hooks (test build only) =====================//
+//
+// Lets a harness drive a stock hl2mp client the way SourceSharp's dev API
+// drives the test mod, so the two can be compared side by side
+// (source-sdk-sharp tools/stock-ab). Inert unless SS_AB_DIR is set.
+//
+//   $SS_AB_DIR/cmd    written by the harness (atomically, by rename); read,
+//                     deleted and run as console text once a frame
+//   ab_ack <token>    writes the token to $SS_AB_DIR/ack once every command
+//                     queued before it has run
+//   ab_view <token>   writes the token, whether a local player exists, and
+//                     the main view's origin and angles to $SS_AB_DIR/view
+//
+//=============================================================================//
+
+#include "cbase.h"
+#include "igamesystem.h"
+#include "view.h"
+#include "c_baseplayer.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+// memdbgon must be the last include file in a .cpp file!!!
+#include "tier0/memdbgon.h"
+
+static const char *ABDir()
+{
+	const char *pszDir = getenv( "SS_AB_DIR" );
+	return ( pszDir && *pszDir ) ? pszDir : NULL;
+}
+
+// Write pszText to $SS_AB_DIR/<pszName> through a temporary and a rename, so
+// the harness never reads half a file.
+static void ABWrite( const char *pszName, const char *pszText )
+{
+	const char *pszDir = ABDir();
+	if ( !pszDir )
+		return;
+
+	char szTmp[MAX_PATH], szPath[MAX_PATH];
+	V_snprintf( szTmp, sizeof( szTmp ), "%s/%s.tmp", pszDir, pszName );
+	V_snprintf( szPath, sizeof( szPath ), "%s/%s", pszDir, pszName );
+
+	FILE *pFile = fopen( szTmp, "wb" );
+	if ( !pFile )
+		return;
+	fputs( pszText, pFile );
+	fclose( pFile );
+	rename( szTmp, szPath );
+}
+
+class CABCommandChannel : public CAutoGameSystemPerFrame
+{
+public:
+	CABCommandChannel() : CAutoGameSystemPerFrame( "CABCommandChannel" ) {}
+
+	virtual void Update( float frametime )
+	{
+		const char *pszDir = ABDir();
+		if ( !pszDir )
+			return;
+
+		char szPath[MAX_PATH];
+		V_snprintf( szPath, sizeof( szPath ), "%s/cmd", pszDir );
+
+		FILE *pFile = fopen( szPath, "rb" );
+		if ( !pFile )
+			return;
+
+		char szText[8192];
+		size_t nRead = fread( szText, 1, sizeof( szText ) - 2, pFile );
+		fclose( pFile );
+		unlink( szPath );
+
+		szText[nRead] = 0;
+		if ( nRead && szText[nRead - 1] != '\n' )
+		{
+			szText[nRead] = '\n';
+			szText[nRead + 1] = 0;
+		}
+
+		engine->ClientCmd_Unrestricted( szText );
+	}
+};
+
+static CABCommandChannel g_ABCommandChannel;
+
+CON_COMMAND( ab_ack, "stock-ab: write the token to $SS_AB_DIR/ack" )
+{
+	char szText[512];
+	V_snprintf( szText, sizeof( szText ), "%s\n", args.ArgS() );
+	ABWrite( "ack", szText );
+}
+
+CON_COMMAND( ab_view, "stock-ab: write the token, the local player and the main view to $SS_AB_DIR/view" )
+{
+	const Vector &vecOrigin = MainViewOrigin();
+	const QAngle &angView = MainViewAngles();
+	C_BasePlayer *pPlayer = C_BasePlayer::GetLocalPlayer();
+
+	char szText[512];
+	V_snprintf( szText, sizeof( szText ), "%s\t%d\t%.3f %.3f %.3f\t%.3f %.3f %.3f\t%d\n",
+		args.ArgS(), pPlayer ? 1 : 0,
+		vecOrigin.x, vecOrigin.y, vecOrigin.z, angView.x, angView.y, angView.z,
+		pPlayer ? pPlayer->GetHealth() : 0 );
+	ABWrite( "view", szText );
+}

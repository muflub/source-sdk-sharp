+++ b/src/game/server/ss_ab_server.cpp
@@ -0,0 +1,47 @@
+//========= SourceSharp stock A/B hooks (test build only) =====================//
+//
+// The server half of source-sdk-sharp tools/stock-ab's stock hooks: what the
+// harness reads from SourceSharp's dev API (/entities), written to a file.
+//
+//   ab_dump_ents <token>   every edict-or-not entity in gEntList, one per line,
+//                          to $SS_AB_DIR/ents (tab-separated: index,
+//                          classname, targetname, origin, angles, health,
+//                          model, effects), then the token on a last line
+//
+//=============================================================================//
+
+#include "cbase.h"
+#include <stdio.h>
+#include <stdlib.h>
+
+// memdbgon must be the last include file in a .cpp file!!!
+#include "tier0/memdbgon.h"
+
+CON_COMMAND( ab_dump_ents, "stock-ab: write every entity to $SS_AB_DIR/ents" )
+{
+	const char *pszDir = getenv( "SS_AB_DIR" );
+	if ( !pszDir || !*pszDir )
+		return;
+
+	char szTmp[MAX_PATH], szPath[MAX_PATH];
+	V_snprintf( szTmp, sizeof( szTmp ), "%s/ents.tmp", pszDir );
+	V_snprintf( szPath, sizeof( szPath ), "%s/ents", pszDir );
+
+	FILE *pFile = fopen( szTmp, "wb" );
+	if ( !pFile )
+		return;
+
+	for ( CBaseEntity *pEntity = gEntList.FirstEnt(); pEntity; pEntity = gEntList.NextEnt( pEntity ) )
+	{
+		const Vector &vecOrigin = pEntity->GetAbsOrigin();
+		const QAngle &angAngles = pEntity->GetAbsAngles();
+		fprintf( pFile, "%d\t%s\t%s\t%.3f %.3f %.3f\t%.3f %.3f %.3f\t%d\t%s\t%d\n",
+			pEntity->entindex(), pEntity->GetClassname(), STRING( pEntity->GetEntityName() ),
+			vecOrigin.x, vecOrigin.y, vecOrigin.z, angAngles.x, angAngles.y, angAngles.z,
+			pEntity->GetHealth(), STRING( pEntity->GetModelName() ), pEntity->GetEffects() );
+	}
+
+	fprintf( pFile, "#end\t%s\n", args.ArgS() );
+	fclose( pFile );
+	rename( szTmp, szPath );
+}

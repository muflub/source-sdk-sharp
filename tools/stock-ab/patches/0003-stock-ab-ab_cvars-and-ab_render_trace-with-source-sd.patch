From 2d0b2ae6d65aa2570a8d41ee00c8a434a2ce2dcd Mon Sep 17 00:00:00 2001
From: Mark Chandler <admin@lodle.net>
Date: Sun, 25 Oct 2026 13:54:47 -0700
Subject: [PATCH 3/4] stock-ab: ab_cvars, and ab_render_trace with
 source-sdk-sharp's render tracer

source-sdk-sharp's tools/stock-ab/build-stock copies its
shell_render_trace_client.cpp and the headers it needs into ss_ab/ before
each build (ss_fwd.h here is a stub: no forwarder tables), so a stock
frame is recorded by the same instrument as cs_cl_render_trace.
View_Render goes through SSAB_View_Render, which traces one frame when
armed and notes the frame's environment as SourceSharp does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/game/client/cdll_client_int.cpp |  4 +-
 src/game/client/client_hl2mp.vpc    |  1 +
 src/game/client/ss_ab/.gitignore    |  7 +++
 src/game/client/ss_ab/ss_fwd.h      | 25 ++++++++
 src/game/client/ss_ab_client.cpp    | 98 +++++++++++++++++++++++++++++
 5 files changed, 134 insertions(+), 1 deletion(-)
 create mode 100644 src/game/client/ss_ab/.gitignore
 create mode 100644 src/game/client/ss_ab/ss_fwd.h

diff --git a/src/game/client/cdll_client_int.cpp b/src/game/client/cdll_client_int.cpp
index 7b47d820..dab1746e 100644
--- a/src/game/client/cdll_client_int.cpp
+++ b/src/game/client/cdll_client_int.cpp
@@ -1523,6 +1523,8 @@ void CHLClient::DecodeUserCmdFromBuffer( bf_read& buf, int slot )
 //-----------------------------------------------------------------------------
 // Purpose: 
 //-----------------------------------------------------------------------------
+void SSAB_View_Render( vrect_t *rect ); // SS_AB: ss_ab_client.cpp
+
 void CHLClient::View_Render( vrect_t *rect )
 {
 	VPROF( "View_Render" );
@@ -1531,7 +1533,7 @@ void CHLClient::View_Render( vrect_t *rect )
 	if ( rect->width == 0 || rect->height == 0 )
 		return;
 
-	view->Render( rect );
+	SSAB_View_Render( rect ); // SS_AB: view->Render, traced when ab_render_trace armed it
 	UpdatePerfStats();
 }
 
diff --git a/src/game/client/client_hl2mp.vpc b/src/game/client/client_hl2mp.vpc
index bca2bc5c..2399360b 100644
--- a/src/game/client/client_hl2mp.vpc
+++ b/src/game/client/client_hl2mp.vpc
@@ -26,6 +26,7 @@ $Project "Client (HL2MP)"
 		-$File	"$SRCDIR\game\shared\weapon_parse_default.cpp"
 
 		$File	"ss_ab_client.cpp"
+		$File	"ss_ab\shell_render_trace_client.cpp"
 		$File	"c_team_objectiveresource.cpp"
 		$File	"c_team_objectiveresource.h"

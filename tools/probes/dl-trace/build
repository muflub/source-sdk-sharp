#!/bin/bash
# Build the G0 dlopen/dlsym tracer (dl_trace.cpp) into
# farm/<config>/build/probes/dl-trace/libss_dltrace.so, or into $1.
# Never into bin/: a run names it in LD_PRELOAD for one session.
set -euo pipefail
HERE="$(dirname -- "$(readlink -f -- "$0")")"
ROOT="$(readlink -f "$HERE/../../..")"
CONFIG="${CONFIG:-debug}"
OUT="${1:-$ROOT/farm/$CONFIG/build/probes/dl-trace/libss_dltrace.so}"
mkdir -p "$(dirname "$OUT")"
CXX="${CXX:-clang++-22}"
"$CXX" -std=c++17 -shared -fPIC -O0 -g -Wall -Wextra -Werror \
  -fvisibility=hidden -o "$OUT" "$HERE/dl_trace.cpp" -ldl
exports=$(nm -D --defined-only "$OUT" | awk '$2=="T"{print $3}' | sort | tr '\n' ' ')
if [[ "$exports" != "dlopen dlsym " ]]; then
  echo "dl-trace: unexpected exports: $exports" >&2
  exit 1
fi
echo "$OUT"

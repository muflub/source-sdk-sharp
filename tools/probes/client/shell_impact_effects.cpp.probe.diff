+// lane c5-particles probe: the impact sprays (sprays-stock.tsv) -- every random
+// draw (fkr rows), each effect's inputs and block, and every particle built.
+static void C5pVecRandom( Vector &v, float lo, float hi )
+{
+	v.x = ::RandomFloat( lo, hi ); FxProbeLog( "fkr\tv\t%.9g\t%.9g\t%.9g", lo, hi, v.x );
+	v.y = ::RandomFloat( lo, hi ); FxProbeLog( "fkr\tv\t%.9g\t%.9g\t%.9g", lo, hi, v.y );
+	v.z = ::RandomFloat( lo, hi ); FxProbeLog( "fkr\tv\t%.9g\t%.9g\t%.9g", lo, hi, v.z );
+}
+static const char *C5pBlock( const float *pP, char *buf, int nBuf )
+{
+	int n = 0;
+	for ( int k = 0; k < SS_IMPACT_MAX_FLOATS && n < nBuf - 32; k++ )
+		n += Q_snprintf( buf + n, nBuf - n, "\t%.9g", pP[k] );
+	buf[n] = 0;
+	return buf;
+}
+static void C5pSpray( const char *pEffect, int nB, const SimpleParticle *p, int nMat )
+{
+	FxProbeLog( "spp\t%s\t%d\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%.9g\t%.9g\t%d",
+	            pEffect, nB, p->m_Pos.x, p->m_Pos.y, p->m_Pos.z, p->m_vecVelocity.x, p->m_vecVelocity.y, p->m_vecVelocity.z,
+	            p->m_flLifetime, p->m_flDieTime, p->m_uchColor[0], p->m_uchColor[1], p->m_uchColor[2],
+	            p->m_uchStartAlpha, p->m_uchEndAlpha, p->m_uchStartSize, p->m_uchEndSize, p->m_flRoll, p->m_flRollDelta, nMat );
+}

 #include "tier0/memdbgon.h"
 
+//==== C2-BEAMS ROPE PROBE (tools/probes/client/c2-beams/c_rope.diff; debug,
+//==== SS_CLIENT_PROBES only). Appends tab-separated rows to
+//==== $SOURCESHARP_PROBE_LOG; %.9g round-trips a float.
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+static int C2Fd()
+{
+	static int s_fd = -2;
+	if ( s_fd == -2 )
+	{
+		const char *p = getenv( "SOURCESHARP_PROBE_LOG" );
+		s_fd = p ? open( p, O_WRONLY | O_CREAT | O_APPEND, 0644 ) : -1;
+	}
+	return s_fd;
+}
+static void C2Log( const char *fmt, ... )
+{
+	const int fd = C2Fd();
+	if ( fd < 0 )
+		return;
+	char buf[8192];
+	va_list a;
+	va_start( a, fmt );
+	int n = vsnprintf( buf, sizeof( buf ), fmt, a );
+	va_end( a );
+	if ( n > (int)sizeof( buf ) - 1 )
+		n = (int)sizeof( buf ) - 1;
+	if ( n > 0 && write( fd, buf, n ) < 0 )
+		return;
+}
+#define C2V "\t%.9g\t%.9g\t%.9g"
+#define C2X( v ) (double)(v).x, (double)(v).y, (double)(v).z
+static int g_C2Rope = -1;
+static float C2RandomFloat( float lo, float hi )
+{
+	const float r = ::RandomFloat( lo, hi );
+	C2Log( "RF\t%d\t%.9g\t%.9g\t%.9g\n", g_C2Rope, lo, hi, r );
+	return r;
+}
+static Vector C2RandomVector( float lo, float hi )
+{
+	const Vector v = ::RandomVector( lo, hi );
+	C2Log( "RV\t%d\t%.9g\t%.9g" C2V "\n", g_C2Rope, lo, hi, C2X( v ) );
+	return v;
+}
+#define RandomFloat C2RandomFloat
+#define RandomVector C2RandomVector
+//==== END PROBE HELPERS
+

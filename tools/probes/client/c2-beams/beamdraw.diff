 #include "tier0/memdbgon.h"
 
+//==== C2-BEAMS BEAM PROBE (tools/probes/client/c2-beams/*.diff; debug,
+//==== SS_CLIENT_PROBES only). Tab-separated rows to $SOURCESHARP_PROBE_LOG;
+//==== %.9g round-trips a float.
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+static int C2Fd()
+{
+	static int s_fd = -2;
+	if ( s_fd == -2 )
+	{
+		const char *p = getenv( "SOURCESHARP_PROBE_LOG" );
+		s_fd = p ? open( p, O_WRONLY | O_CREAT | O_APPEND, 0644 ) : -1;
+	}
+	return s_fd;
+}
+static void C2Log( const char *fmt, ... )
+{
+	const int fd = C2Fd();
+	if ( fd < 0 )
+		return;
+	char buf[8192];
+	va_list a;
+	va_start( a, fmt );
+	int n = vsnprintf( buf, sizeof( buf ), fmt, a );
+	va_end( a );
+	if ( n > (int)sizeof( buf ) - 1 )
+		n = (int)sizeof( buf ) - 1;
+	if ( n > 0 && write( fd, buf, n ) < 0 )
+		return;
+}
+#define C2V "\t%.9g\t%.9g\t%.9g"
+#define C2X( v ) (double)(v).x, (double)(v).y, (double)(v).z
+
+extern int g_C2BeamCtx;
+class C2SegDraw : public CBeamSegDraw
+{
+public:
+	void Start( IMatRenderContext *pRenderContext, int nSegs, IMaterial *pMaterial = 0, CMeshBuilder *pMeshBuilder = NULL, int nMeshVertCount = 0 )
+	{
+		C2Log( "SG\t%d\t%d\t%d\n", g_C2BeamCtx, nSegs, pMaterial ? 1 : 0 );
+		CBeamSegDraw::Start( pRenderContext, nSegs, pMaterial, pMeshBuilder, nMeshVertCount );
+	}
+	virtual void NextSeg( BeamSeg_t *pSeg )
+	{
+		C2Log( "SN\t%d" C2V C2V "\t%.9g\t%.9g\t%.9g\n", g_C2BeamCtx, C2X( pSeg->m_vPos ), C2X( pSeg->m_vColor ),
+			pSeg->m_flTexCoord, pSeg->m_flWidth, pSeg->m_flAlpha );
+		CBeamSegDraw::NextSeg( pSeg );
+	}
+};
+class C2MeshBuilder : public CMeshBuilder
+{
+public:
+	float m_p[3], m_c[4], m_t[2];
+	int m_k;
+	C2MeshBuilder() { m_k = -1; m_c[0] = m_c[1] = m_c[2] = m_c[3] = 0; m_t[0] = m_t[1] = 0; m_p[0] = m_p[1] = m_p[2] = 0; }
+	void Begin( IMesh *pMesh, MaterialPrimitiveType_t type, int nPrimitives )
+	{
+		C2Log( "MB\t%d\t%d\t%d\n", g_C2BeamCtx, (int)type, nPrimitives );
+		CMeshBuilder::Begin( pMesh, type, nPrimitives );
+	}
+	void Position3fv( const float *v ) { m_p[0] = v[0]; m_p[1] = v[1]; m_p[2] = v[2]; CMeshBuilder::Position3fv( v ); }
+	void Color3fv( const float *v ) { m_k = 0; m_c[0] = v[0]; m_c[1] = v[1]; m_c[2] = v[2]; m_c[3] = 1; CMeshBuilder::Color3fv( v ); }
+	void Color3f( float r, float g, float b ) { m_k = 0; m_c[0] = r; m_c[1] = g; m_c[2] = b; m_c[3] = 1; CMeshBuilder::Color3f( r, g, b ); }
+	void Color3ubv( const unsigned char *v ) { m_k = 1; m_c[0] = v[0]; m_c[1] = v[1]; m_c[2] = v[2]; m_c[3] = 255; CMeshBuilder::Color3ubv( v ); }
+	void Color4ubv( const unsigned char *v ) { m_k = 2; m_c[0] = v[0]; m_c[1] = v[1]; m_c[2] = v[2]; m_c[3] = v[3]; CMeshBuilder::Color4ubv( v ); }
+	void TexCoord2f( int stage, float s, float t ) { m_t[0] = s; m_t[1] = t; CMeshBuilder::TexCoord2f( stage, s, t ); }
+	void AdvanceVertex()
+	{
+		C2Log( "MV\t%d\t%d\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\n", g_C2BeamCtx, m_k,
+			m_p[0], m_p[1], m_p[2], m_c[0], m_c[1], m_c[2], m_c[3], m_t[0], m_t[1] );
+		CMeshBuilder::AdvanceVertex();
+	}
+};

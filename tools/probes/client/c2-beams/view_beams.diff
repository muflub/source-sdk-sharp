+static void C2LogInfo( const char *kind, const BeamInfo_t &bi, int nEnts )
+{
+	const bool bEnts = nEnts != 0;
+	IClientEntity *pStart = ( nEnts & 1 ) ? bi.m_pStartEnt : NULL;
+	IClientEntity *pEnd = ( nEnts & 2 ) ? bi.m_pEndEnt : NULL;
+	C2Log( "BI\t%s\t%d\t%d\t%d\t%d\t%d\t%d\t%d" C2V C2V "\t%d\t%s\t%d\t%s\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%d\t%.9g\t%.9g\t%.9g\t%.9g\t%d\t%d\t%d" C2V "\t%.9g\t%.9g\t%.9g\t%.9g\n",
+		kind, bi.m_nType,
+		pStart ? C2Entry( pStart->GetRefEHandle() ) : -1, pStart && pStart->GetModel() ? 1 : 0, bEnts ? bi.m_nStartAttachment : 0,
+		pEnd ? C2Entry( pEnd->GetRefEHandle() ) : -1, pEnd && pEnd->GetModel() ? 1 : 0, bEnts ? bi.m_nEndAttachment : 0,
+		C2X( bi.m_vecStart ), C2X( bi.m_vecEnd ),
+		bi.m_nModelIndex, bi.m_pszModelName ? bi.m_pszModelName : "-", bi.m_nHaloIndex, bi.m_pszHaloName ? bi.m_pszHaloName : "-",
+		bi.m_flHaloScale, bi.m_flLife, bi.m_flWidth, bi.m_flEndWidth, bi.m_flFadeLength, bi.m_flAmplitude, bi.m_flBrightness,
+		bi.m_flSpeed, bi.m_nStartFrame, bi.m_flFrameRate, bi.m_flRed, bi.m_flGreen, bi.m_flBlue, (int)bi.m_bRenderable,
+		bi.m_nSegments, bi.m_nFlags, C2X( bi.m_vecCenter ), bi.m_flStartRadius, bi.m_flEndRadius,
+		gpGlobals->curtime, gpGlobals->frametime );
+}
+static void C2LogModel( int nIndex )
+{
+	const model_t *m = modelinfo->GetModel( nIndex );
+	C2Log( "MD\t%d\t%d\t%d\t%s\n", nIndex, m ? 1 : 0, m ? modelinfo->GetModelFrameCount( m ) : 0,
+		m ? modelinfo->GetModelName( m ) : "-" );
+}
+static void C2LogView( const char *tag )

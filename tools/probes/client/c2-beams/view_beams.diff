+		C2X( CurrentViewAngles() ), C2X( MainViewUp() ), C2X( MainViewRight() ),
+		w[0][0], w[0][1], w[0][2], w[0][3], w[1][0], w[1][1], w[1][2], w[1][3],
+		w[2][0], w[2][1], w[2][2], w[2][3], w[3][0], w[3][1], w[3][2], w[3][3],
+		gpGlobals->curtime, gpGlobals->frametime, r_DrawBeams.GetInt() );
+}

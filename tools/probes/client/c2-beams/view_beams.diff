 #include "tier0/memdbgon.h"
 
+//==== C2-BEAMS BEAM PROBE (tools/probes/client/c2-beams/*.diff; debug,
+//==== SS_CLIENT_PROBES only). Tab-separated rows to $SOURCESHARP_PROBE_LOG;
+//==== %.9g round-trips a float.
+#include <fcntl.h>
+#include <unistd.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+static int C2Fd()
+{
+	static int s_fd = -2;
+	if ( s_fd == -2 )
+	{
+		const char *p = getenv( "SOURCESHARP_PROBE_LOG" );
+		s_fd = p ? open( p, O_WRONLY | O_CREAT | O_APPEND, 0644 ) : -1;
+	}
+	return s_fd;
+}
+static void C2Log( const char *fmt, ... )
+{
+	const int fd = C2Fd();
+	if ( fd < 0 )
+		return;
+	char buf[8192];
+	va_list a;
+	va_start( a, fmt );
+	int n = vsnprintf( buf, sizeof( buf ), fmt, a );
+	va_end( a );
+	if ( n > (int)sizeof( buf ) - 1 )
+		n = (int)sizeof( buf ) - 1;
+	if ( n > 0 && write( fd, buf, n ) < 0 )
+		return;
+}
+#define C2V "\t%.9g\t%.9g\t%.9g"
+#define C2X( v ) (double)(v).x, (double)(v).y, (double)(v).z
+
+#include <unordered_map>
+int g_C2BeamCtx = -1;
+static std::unordered_map< const Beam_t *, int > g_C2BeamIds;
+static int g_C2NextBeam = 0;
+static int C2Id( const Beam_t *p )
+{
+	if ( !p )
+		return -1;
+	std::unordered_map< const Beam_t *, int >::const_iterator it = g_C2BeamIds.find( p );
+	return it == g_C2BeamIds.end() ? -1 : it->second;
+}
+static unsigned int C2NoiseHash( const float *p )
+{
+	unsigned int h = 2166136261u;
+	const unsigned char *b = (const unsigned char *)p;
+	for ( int i = 0; i < (int)( ( NOISE_DIVISIONS + 1 ) * sizeof( float ) ); i++ )
+		h = ( h ^ b[i] ) * 16777619u;
+	return h;
+}
+static int C2Entry( const CBaseHandle &h ) { return h.IsValid() ? h.GetEntryIndex() : -1; }
+static void C2LogBeam( const char *tag, const Beam_t *b )
+{
+	int nTrail = 0;
+	for ( const BeamTrail_t *t = b->trail; t; t = t->next )
+		nTrail++;
+	C2Log( "%s\t%d\t%d\t%d\t%d" C2V C2V C2V C2V "\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%.9g\t%d\t%.9g\t%.9g\t%u\t%d" C2V C2V "\t%d\t%d\t%d\t%.9g\n",
+		tag, C2Id( b ), b->type, b->flags, b->numAttachments,
+		C2X( b->attachment[0] ), C2X( b->attachment[1] ), C2X( b->attachment[2] ), C2X( b->delta ),
+		b->t, b->freq, b->die, b->width, b->endWidth, b->fadeLength, b->amplitude, b->life,
+		b->r, b->g, b->b, b->brightness, b->speed, b->frameRate, b->frame, b->segments,
+		C2Entry( b->entity[0] ), C2Entry( b->entity[1] ), b->attachmentIndex[0], b->attachmentIndex[1],
+		b->modelIndex, b->haloIndex, b->haloScale, b->frameCount, b->start_radius, b->end_radius,
+		C2NoiseHash( b->rgNoise ), (int)b->m_bCalculatedNoise, C2X( b->m_Mins ), C2X( b->m_Maxs ),
+		nTrail, b->m_hRenderHandle != INVALID_CLIENT_RENDER_HANDLE ? 1 : 0, (int)b->m_bCalculatedNoise,
+		b->m_flHDRColorScale );
+	int i = 0;
+	for ( const BeamTrail_t *t = b->trail; t; t = t->next, i++ )
+		C2Log( "%sT\t%d\t%d\t%.9g" C2V C2V "\n", tag, C2Id( b ), i, t->die, C2X( t->org ), C2X( t->vel ) );
+}
+// The entity pointers are read only for the creations that set them: BeamInfo_t's
+// constructor leaves them uninitialised, and the point/ring-point/circle forms

+
+//==== C2-BEAMS PROBE COMMAND: the stock creation paths no temp entity reaches
+//==== in this build (a halo, a disk, a cylinder, sine noise, shading, a fade, a
+//==== tesla and a laser between points), made by the stock code itself so the
+//==== draw functions behind them are recorded.
+CON_COMMAND( c2_beam_probe_extra, "C2 beams probe (debug): make the beam shapes no temp entity reaches, in front of the view" )
+{
+	const int nLaser = modelinfo->GetModelIndex( "sprites/laserbeam.vmt" );
+	if ( nLaser < 0 )
+	{
+		Msg( "c2_beam_probe_extra: sprites/laserbeam.vmt is not precached\n" );
+		return;
+	}
+	Vector o = MainViewOrigin(), f = MainViewForward(), r = MainViewRight(), u = MainViewUp();
+	Vector at = o + f * 160.0f;
+	struct Shape_t { int type; int flags; int halo; float dx, dz; };
+	const Shape_t shapes[] =
+	{
+		{ TE_BEAMPOINTS, 0, 1, -60, 30 },
+		{ TE_BEAMPOINTS, FBEAM_SINENOISE | FBEAM_SHADEIN | FBEAM_SHADEOUT, 0, -30, 30 },
+		{ TE_BEAMPOINTS, FBEAM_FADEIN | FBEAM_NOTILE, 0, 0, 30 },
+		{ TE_BEAMPOINTS, FBEAM_FADEOUT | FBEAM_ONLYNOISEONCE | FBEAM_SOLID, 0, 30, 30 },
+		{ TE_BEAMPOINTS, FBEAM_HALOBEAM, 1, 60, 30 },
+		{ TE_BEAMDISK, 0, 0, -45, -30 },
+		{ TE_BEAMCYLINDER, 0, 0, -15, -30 },
+		{ TE_BEAMTESLA, 0, 0, 15, -30 },
+		{ TE_BEAMLASER, 0, 0, 45, -30 },
+	};
+	for ( int i = 0; i < (int)ARRAYSIZE( shapes ); i++ )
+	{
+		BeamInfo_t bi;
+		bi.m_nType = shapes[i].type;
+		bi.m_vecStart = at + r * shapes[i].dx + u * shapes[i].dz;
+		bi.m_vecEnd = bi.m_vecStart + u * 40.0f + r * 8.0f;
+		bi.m_nModelIndex = nLaser;
+		bi.m_nHaloIndex = shapes[i].halo ? nLaser : -1;
+		bi.m_flHaloScale = 3.0f;
+		bi.m_flLife = 2.0f;
+		bi.m_flWidth = 2.0f;
+		bi.m_flEndWidth = 4.0f;
+		bi.m_flFadeLength = 0.0f;
+		bi.m_flAmplitude = 2.0f;
+		bi.m_flBrightness = 200.0f;
+		bi.m_flSpeed = 1.5f;
+		bi.m_nStartFrame = 0;
+		bi.m_flFrameRate = 10.0f;
+		bi.m_flRed = 255.0f; bi.m_flGreen = 128.0f; bi.m_flBlue = 64.0f;
+		bi.m_nSegments = shapes[i].type == TE_BEAMTESLA ? 20 : -1;
+		bi.m_nFlags = shapes[i].flags;
+		if ( shapes[i].type == TE_BEAMDISK || shapes[i].type == TE_BEAMCYLINDER )
+		{
+			bi.m_vecEnd = bi.m_vecStart + Vector( 0, 0, 24 );
+			s_ViewRenderBeams.CreateBeamCirclePoints( bi );
+		}
+		else
+			s_ViewRenderBeams.CreateBeamPoints( bi );
+	}
+	Msg( "c2_beam_probe_extra: %d shapes\n", (int)ARRAYSIZE( shapes ) );
+}

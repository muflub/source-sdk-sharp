+	const VMatrix &w = engine->WorldToScreenMatrix();
+	C2Log( "%s" C2V C2V C2V C2V C2V C2V C2V "\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%d\n", tag,

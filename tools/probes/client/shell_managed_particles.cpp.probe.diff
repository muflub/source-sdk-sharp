+// lane c5-particles probe: the sphere renderer's state and its lighting
+// helpers are private. An explicit instantiation may name a private member
+// (C++ [temp.explicit]), so these tags hand the recorder pointers to them; the
+// recorder then calls stock's own AddLightColor and ClampColor.
+namespace c5probe
+{
+template < typename Tag, typename Tag::type M > struct Rob { friend typename Tag::type Get( Tag ) { return M; } };
+struct BaseColor   { typedef Vector CParticleSphereRenderer::*type; friend type Get( BaseColor ); };
+struct Ambient     { typedef CParticleLightInfo CParticleSphereRenderer::*type; friend type Get( Ambient ); };
+struct Directional { typedef CParticleLightInfo CParticleSphereRenderer::*type; friend type Get( Directional ); };
+struct PixelShaders{ typedef bool CParticleSphereRenderer::*type; friend type Get( PixelShaders ); };
+struct AddLight    { typedef void ( CParticleSphereRenderer::*type )( Vector const *, Vector const *, Vector const *, float, Vector * ); friend type Get( AddLight ); };
+struct ClampFn     { typedef void ( CParticleSphereRenderer::*type )( Vector & ); friend type Get( ClampFn ); };
+template struct Rob< BaseColor, &CParticleSphereRenderer::m_vBaseColor >;
+template struct Rob< Ambient, &CParticleSphereRenderer::m_AmbientLight >;
+template struct Rob< Directional, &CParticleSphereRenderer::m_DirectionalLight >;
+template struct Rob< PixelShaders, &CParticleSphereRenderer::m_bUsingPixelShaders >;
+template struct Rob< AddLight, &CParticleSphereRenderer::AddLightColor >;
+template struct Rob< ClampFn, &CParticleSphereRenderer::ClampColor >;
+}
 

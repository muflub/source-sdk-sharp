+static ConVar cs_cl_probe_trailwiggle( "cs_cl_probe_trailwiggle", "0", 0, "c2-fx probe (debug): radius of a circle laid on every managed trail's followed origin" );
+static Vector FxProbeTrailWiggle()
+{
+	const float r = cs_cl_probe_trailwiggle.GetFloat();
+	if ( r == 0.0f )

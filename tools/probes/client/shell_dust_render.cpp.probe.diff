+#include "fx_probe_log.h"
+
+// lane c5-particles probe (dust motes): every rand() the motes draw, logged as
+// the int it returned ("dmr"), and Vector::Random's expression over it.
+static int DmRand() { const int v = rand(); FxProbeLog( "dmr\t%d", v ); return v; }
+static Vector DmRandomVector( float lo, float hi )
+{
+	Vector v;
+	v.x = lo + ( (float)DmRand() / VALVE_RAND_MAX ) * ( hi - lo );
+	v.y = lo + ( (float)DmRand() / VALVE_RAND_MAX ) * ( hi - lo );
+	v.z = lo + ( (float)DmRand() / VALVE_RAND_MAX ) * ( hi - lo );
+	return v;
+}
 

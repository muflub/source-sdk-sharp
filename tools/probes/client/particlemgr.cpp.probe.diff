+// ---- C7 particles phase 2 probe (tools/probes/client/particlemgr.cpp.probe.diff) ----
+// The old-style manager's decisions, one line each, to SOURCESHARP_PROBE_LOG
+// (tag "pm"). Every binding here is shell_managed_particles.cpp's executor,
+// whose particles carry managed's id right after the Particle header.
+#include <fcntl.h>
+#include <unistd.h>
+#include "viewrender.h"
+static void PmLog( const char *pFmt, ... )
+{
+	static int s_fd = -2;
+	if ( s_fd == -2 )
+	{
+		const char *pPath = getenv( "SOURCESHARP_PROBE_LOG" );
+		s_fd = ( pPath && *pPath ) ? open( pPath, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644 ) : -1;
+	}
+	if ( s_fd < 0 )
+		return;
+	static char buf[ 65536 ];
+	va_list ap;
+	va_start( ap, pFmt );
+	int n = V_vsnprintf( buf, sizeof( buf ) - 2, pFmt, ap );
+	va_end( ap );
+	if ( n < 0 )
+		return;
+	if ( n > (int)sizeof( buf ) - 2 )
+		n = sizeof( buf ) - 2;
+	buf[ n++ ] = '\n';
+	(void)!write( s_fd, buf, n );
+}
+// ManagedParticle_t's id sits in Particle's tail padding (Particle is not a
+// layout POD: Vector has a constructor), right after m_Pos.
+static int PmId( const Particle *p ) { return *(const int32 *)( (const char *)&p->m_Pos + sizeof( Vector ) ); }
+static int PmRandomInt( int lo, int hi )
+{
+	const int v = random->RandomInt( lo, hi );
+	PmLog( "pm\trnd\t%d\t%d\t%d", lo, hi, v );
+	return v;
+}
+#define PM_V( v ) (v).x, (v).y, (v).z
+// One material's particles in list order: id and position.
+static void PmList( const char *pTag, const void *pEffect, int iMat, const Particle *pHead )
+{
+	static char buf[ 60000 ];
+	int n = 0;
+	int count = 0;
+	for ( const Particle *p = pHead->m_pNext; p != pHead && n < (int)sizeof( buf ) - 64; p = p->m_pNext, count++ )
+		n += V_snprintf( buf + n, sizeof( buf ) - n, " %d:%.9g,%.9g,%.9g", PmId( p ), PM_V( p->m_Pos ) );
+	buf[ n ] = 0;
+	PmLog( "pm\t%s\t%p\t%d\t%d\t%s", pTag, pEffect, iMat, count, buf );
+}
+// ---- end probe ----

+static float SkRandF( float lo, float hi )
+{
+	const float v = random->RandomFloat( lo, hi );
+	FxProbeLog( "skr\tf\t%.9g\t%.9g\t%.9g", lo, hi, v );
+	return v;
+}
+
+static int SkRandI( int lo, int hi )
+{
+	const int v = random->RandomInt( lo, hi );
+	FxProbeLog( "skr\ti\t%d\t%d\t%d", lo, hi, v );
+	return v;
+}
+
+// Vector::Random draws three rand()s; the port draws three floats in [lo, hi].
+static void SkLogRandomVector( const Vector &v, float lo, float hi )
+{
+	for ( int k = 0; k < 3; k++ )
+		FxProbeLog( "skr\tf\t%.9g\t%.9g\t%.9g", lo, hi, v[k] );
+}

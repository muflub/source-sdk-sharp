+//==== c2-fx probe battery (debug): cs_cl_probe_tebattery render|muzzle|sound|attach [entindex]
+static int ProbeModel( const char *pName )
+{
+	int n = modelinfo->GetModelIndex( pName );
+	return n;
+}
+CON_COMMAND( cs_cl_probe_tebattery, "c2-fx probe (debug): drive the legacy tempents' decisions over a fixed battery" )
+{
+	CTempEnts *pTe = static_cast< CTempEnts * >( tempents );
+	const char *what = args.ArgC() > 1 ? args[1] : "";
+	const Vector eye = MainViewOrigin();
+	Vector fwd, right, up;
+	AngleVectors( MainViewAngles(), &fwd, &right, &up );
+	if ( !Q_stricmp( what, "render" ) )
+	{
+		int sprite = ProbeModel( "sprites/glow01.spr" );
+		if ( sprite <= 0 ) sprite = ProbeModel( "sprites/muzzleflash4.vmt" );
+		const int modes[] = { kRenderNormal, kRenderTransColor, kRenderTransTexture, kRenderGlow, kRenderTransAlpha, kRenderTransAdd, kRenderWorldGlow };
+		int n = 0;
+		for ( int fx = 0; fx <= 20; fx++ )
+		{
+			for ( int m = 0; m < (int)ARRAYSIZE( modes ); m++, n++ )
+			{
+				Vector pos = eye + fwd * ( 150.0f + ( n % 5 ) * 10.0f ) + right * ( ( n % 15 ) * 6.0f - 42.0f ) + up * ( ( n / 15 ) * 4.0f - 20.0f );
+				C_LocalTempEntity *p = pTe->TempSprite( pos, vec3_origin, 0.15f, sprite, modes[m], fx, 200.0f / 255.0f, 4.0f, 0 );
+				if ( p && ( n % 4 ) == 0 ) { p->flags |= FTENT_BEOCCLUDED; p->m_vecNormal = ( ( n % 8 ) == 0 ) ? -fwd : fwd; p->tempent_renderamt = 180; }
+				FxProbeLog( "tbat-sprite n=%d fx=%d mode=%d ok=%d", n, fx, modes[m], p ? 1 : 0 );
+			}
+		}
+		const model_t *shell = engine->LoadModel( "models/weapons/rifleshell.mdl" );
+		for ( int fx = 0; fx <= 20 && shell; fx++ )
+		{
+			Vector pos = eye + fwd * 80.0f + right * ( fx * 3.0f - 30.0f ) - up * 10.0f;
+			C_LocalTempEntity *p = pTe->SpawnTempModel( shell, pos, vec3_angle, vec3_origin, 4.0f, FTENT_NONE );
+			if ( p ) { p->m_nRenderFX = fx; p->SetRenderMode( ( fx % 3 ) == 0 ? kRenderNormal : kRenderTransTexture ); p->SetRenderColorA( 150 ); if ( fx % 5 == 0 ) { p->flags |= FTENT_BEOCCLUDED; p->m_vecNormal = -fwd; p->tempent_renderamt = 200; } }
+			FxProbeLog( "tbat-studio fx=%d ok=%d", fx, p ? 1 : 0 );
+		}
+	}
+	else if ( !Q_stricmp( what, "muzzle" ) )
+	{
+		const int ent = args.ArgC() > 2 ? atoi( args[2] ) : engine->GetLocalPlayer();
+		CBaseHandle h = SSClientHandleFromIndex( ent );
+		for ( int type = 0; type <= MUZZLEFLASH_COMBINE_TURRET; type++ )
+		{
+			for ( int fp = 0; fp < 2; fp++ )
+			{
+				pTe->MuzzleFlash( type, h, 1, fp != 0 );
+				pTe->MuzzleFlash( eye + fwd * 64.0f, MainViewAngles(), type, h, fp != 0 );
+			}
+		}
+	}
+	else if ( !Q_stricmp( what, "sound" ) )
+	{
+		C_LocalTempEntity *p = pTe->TempSprite( eye + fwd * 64.0f, vec3_origin, 0.1f, ProbeModel( "sprites/glow01.spr" ), kRenderTransAdd, 0, 1.0f, 0.5f, 0 );
+		if ( !p ) return;
+		const float zv[] = { 0.0f, 50.0f, -120.0f, 199.0f, 200.0f, -260.0f, 349.0f, 400.0f, -900.0f };
+		const float damps[] = { 0.0f, 0.5f, 1.0f };

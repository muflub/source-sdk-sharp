+//==== c2-fx TEMPENT PROBE (tools/probes/client/c_te_legacytempents.cpp.probe.diff;
+//==== debug, SS_CLIENT_PROBES only). Rows to $SOURCESHARP_PROBE_LOG through FxProbeLog.
+#include "fx_probe_log.h"
+class CTrailParticles;
+
+#define FXV "%.9g %.9g %.9g"
+#define FXX( v ) (double)(v).x, (double)(v).y, (double)(v).z
+static const char *ProbeMat( PMaterialHandle h )
+{
+	IMaterial *m = h ? ParticleMgr()->PMaterialToIMaterial( h ) : NULL;
+	return m ? m->GetName() : "null";
+}
+struct ProbeAdded_t { Particle *p; int size; bool trail; };
+static CUtlVector< ProbeAdded_t > g_ProbeAdded;
+static int g_nProbeDepth = 0;
+template < class E > static bool ProbeIsTrail( CSmartPtr< E > & ) { return false; }
+static bool ProbeIsTrail( CSmartPtr< CTrailParticles > & ) { return true; }
+template < class E > static Particle *ProbeAdd( E &e, int size, PMaterialHandle h, const Vector &pos )
+{
+	Particle *p = e->AddParticle( size, h, pos );
+	const bool bTrail = ProbeIsTrail( e );
+	FxProbeLog( "tmf-add n=%d size=%d mat=%s pos=" FXV " ok=%d", g_ProbeAdded.Count(), size, ProbeMat( h ), FXX( pos ), p ? 1 : 0 );
+	if ( p ) { ProbeAdded_t a = { p, size, bTrail }; g_ProbeAdded.AddToTail( a ); }
+	return p;
+}
+struct ProbeScope
+{
+	ProbeScope( const char *pName, ClientEntityHandle_t h, int att )
+	{
+		if ( g_nProbeDepth++ == 0 ) g_ProbeAdded.RemoveAll();
+		FxProbeLog( "tmf-begin %s h=%d att=%d smg=%d combine=%d dust=%d", pName, h.ToInt(), att,
+			g_Mat_SMG_Muzzleflash[0] ? 1 : 0, g_Mat_Combine_Muzzleflash[0] ? 1 : 0, g_Mat_DustPuff[0] ? 1 : 0 );
+	}
+	~ProbeScope()
+	{
+		if ( --g_nProbeDepth != 0 ) return;
+		for ( int i = 0; i < g_ProbeAdded.Count(); i++ )
+		{
+			Particle *q = g_ProbeAdded[i].p;
+			if ( g_ProbeAdded[i].trail )
+			{
+				TrailParticle *t = (TrailParticle *)q;
+				FxProbeLog( "tmf-trail n=%d pos=" FXV " vel=" FXV " col=%d %d %d %d die=%.9g life=%.9g len=%.9g width=%.9g", i, FXX( t->m_Pos ), FXX( t->m_vecVelocity ),
+					t->m_color.r, t->m_color.g, t->m_color.b, t->m_color.a, t->m_flDieTime, t->m_flLifetime, t->m_flLength, t->m_flWidth );
+			}
+			else
+			{
+				SimpleParticle *s = (SimpleParticle *)q;
+				FxProbeLog( "tmf-simple n=%d pos=" FXV " vel=" FXV " roll=%.9g die=%.9g life=%.9g col=%d %d %d sa=%d ea=%d ss=%d es=%d flags=%d rd=%.9g", i, FXX( s->m_Pos ), FXX( s->m_vecVelocity ),
+					s->m_flRoll, s->m_flDieTime, s->m_flLifetime, s->m_uchColor[0], s->m_uchColor[1], s->m_uchColor[2], s->m_uchStartAlpha, s->m_uchEndAlpha, s->m_uchStartSize, s->m_uchEndSize, s->m_iFlags, s->m_flRollDelta );
+			}
+		}
+		FxProbeLog( "tmf-end n=%d", g_ProbeAdded.Count() );
+		g_ProbeAdded.RemoveAll();
+	}
+};

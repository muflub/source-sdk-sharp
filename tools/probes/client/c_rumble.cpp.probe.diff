+// c6-input probe (debug): cs_cl_probe_rumble N records the mixer over N frames
+// into $SOURCESHARP_C6_FIXTURE_DIR/rumble-stock.tsv, with a scripted effect
+// schedule, the local player's alive check bypassed while armed (it answers
+// NULL on this build, so stock's update never ran past it).
+static FILE *s_pRumbleProbe = NULL;
+static int s_nRumbleFrames = 0;
+static int s_nRumbleFrame = 0;
+static void RumbleProbeLog( const char *pFmt, ... )
+{
+	if ( !s_pRumbleProbe )
+		return;
+	va_list ap;
+	va_start( ap, pFmt );
+	vfprintf( s_pRumbleProbe, pFmt, ap );
+	va_end( ap );
+	fputc( '\n', s_pRumbleProbe );
+}
 
 ConVar cl_rumblescale( "cl_rumblescale", "1.0", FCVAR_ARCHIVE | FCVAR_ARCHIVE_XBOX, "Scale sensitivity of rumble effects (0 to 1.0)" ); 

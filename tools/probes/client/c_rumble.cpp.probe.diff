 //---------------------------------------------------------
 void EnableRumbleOutput( bool bEnable )
 {
+	RumbleProbeLog( "EN\t%d", bEnable ? 1 : 0 );
 	g_RumbleEffects.SetOutputEnabled( bEnable );
 }
+
+// Driven once a frame by the input probe (c6input_probes_debug.cpp): the
+// client mode's Update, which stock calls this from, is not called here.
+void C6P_RumbleFrame()
+{
+	if ( s_pRumbleProbe )
+		UpdateRumbleEffects();
+}
+
+CON_COMMAND( cs_cl_probe_rumble, "c6-input probe (debug): record the stock rumble mixer over N frames into $SOURCESHARP_C6_FIXTURE_DIR/rumble-stock.tsv" )
+{
+	const char *pDir = getenv( "SOURCESHARP_C6_FIXTURE_DIR" );
+	if ( s_pRumbleProbe || !pDir || !*pDir )
+	{
+		Msg( "[c6-input probe] rumble: busy, or SOURCESHARP_C6_FIXTURE_DIR is not set\n" );
+		return;
+	}
+	char path[ 1024 ];
+	Q_snprintf( path, sizeof( path ), "%s/rumble-stock.tsv", pDir );
+	s_pRumbleProbe = fopen( path, "w" );
+	if ( !s_pRumbleProbe )
+		return;
+	s_nRumbleFrames = args.ArgC() > 1 ? atoi( args[ 1 ] ) : 400;
+	s_nRumbleFrame = 0;
+	fprintf( s_pRumbleProbe, "# rumble-stock.tsv: STOCK c_rumble.cpp, recorded -- see README-rumble-stock.md.\n" );
+	for ( int w = 0; w < NUM_RUMBLE_EFFECTS; w++ )
+	{
+		RumbleWaveform_t &wf = g_RumbleEffects.m_Waveforms[ w ];
+		fprintf( s_pRumbleProbe, "W\t%d\t%d", w, wf.numSamples );
+		for ( int i = 0; i < NUM_WAVE_SAMPLES; i++ )
+			fprintf( s_pRumbleProbe, "\t%.9g,%.9g", wf.amplitude_left[ i ], wf.amplitude_right[ i ] );
+		fputc( '\n', s_pRumbleProbe );
+	}
+	g_RumbleEffects.StopAllEffects();
+	fprintf( s_pRumbleProbe, "V\tcl_rumblescale\t%s\n", cl_rumblescale.GetString() );
+}

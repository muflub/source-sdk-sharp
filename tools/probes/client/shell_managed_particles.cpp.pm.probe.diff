+#include <fcntl.h>
+#include <unistd.h>
+static void PmShellLog( const char *pFmt, ... )
+{
+	static int s_fd = -2;
+	if ( s_fd == -2 )
+	{
+		const char *pPath = getenv( "SOURCESHARP_PROBE_LOG" );
+		s_fd = ( pPath && *pPath ) ? open( pPath, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644 ) : -1;
+	}
+	if ( s_fd < 0 )
+		return;
+	char buf[ 512 ];
+	va_list ap;
+	va_start( ap, pFmt );
+	int n = V_vsnprintf( buf, sizeof( buf ) - 2, pFmt, ap );
+	va_end( ap );
+	if ( n < 0 )
+		return;
+	if ( n > (int)sizeof( buf ) - 2 )
+		n = sizeof( buf ) - 2;
+	buf[ n++ ] = '\n';
+	(void)!write( s_fd, buf, n );
+}
+static const Particle *PmNext( CParticleRenderIterator *pIterator, const void *pBinding, int nId, float flKey )
+{
+	PmShellLog( "pm\tkey\t%p\t%d\t%.9g", pBinding, nId, flKey );
+	return pIterator->GetNext( flKey );
+}
+// ---- end probe ----

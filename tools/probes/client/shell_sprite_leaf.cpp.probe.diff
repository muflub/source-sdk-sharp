+// c2-fx probe (debug): GetSpriteAxes over every SPRITETYPE (and one past),
+// a seeded spread of origins and angles plus the near-vertical ones its
+// early returns are for, with the outputs pre-filled so a return that
+// leaves them alone is visible.
+CON_COMMAND( cs_cl_probe_spriteaxes, "c2-fx probe (debug): log GetSpriteAxes over a fixed battery against the current view" )
+{
+	unsigned int seed = 12345u;
+	auto next = [&seed]() -> float { seed = seed * 1103515245u + 12345u; return (float)( ( seed >> 8 ) & 0xFFFF ) / 65535.0f; };
+	FxProbeLog( "spa-view fwd=%.9g %.9g %.9g right=%.9g %.9g %.9g up=%.9g %.9g %.9g",
+		CurrentViewForward().x, CurrentViewForward().y, CurrentViewForward().z,
+		CurrentViewRight().x, CurrentViewRight().y, CurrentViewRight().z,
+		CurrentViewUp().x, CurrentViewUp().y, CurrentViewUp().z );
+	for ( int type = 0; type <= 5; ++type )
+	{
+		for ( int k = 0; k < 44; ++k )
+		{
+			Vector o( ( next() - 0.5f ) * 4000.0f, ( next() - 0.5f ) * 4000.0f, ( next() - 0.5f ) * 1000.0f );
+			if ( k == 0 ) o = Vector( 0.001f, 0.0f, -900.0f );
+			if ( k == 1 ) o = Vector( 0.0f, 0.0f, 0.0f );
+			if ( k == 2 ) o = Vector( 10.0f, 5.0f, 600.0f );
+			QAngle a( ( next() - 0.5f ) * 180.0f, ( next() - 0.5f ) * 720.0f, ( k % 3 == 0 ) ? 0.0f : ( next() - 0.5f ) * 720.0f );
+			Vector f( 777.0f, 778.0f, 779.0f ), r( 787.0f, 788.0f, 789.0f ), u( 797.0f, 798.0f, 799.0f );
+			C_SpriteRenderer::GetSpriteAxes( (C_SpriteRenderer::SPRITETYPE)type, o, a, f, r, u );
+			FxProbeLog( "spa type=%d o=%.9g %.9g %.9g a=%.9g %.9g %.9g f=%.9g %.9g %.9g r=%.9g %.9g %.9g u=%.9g %.9g %.9g",
+				type, o.x, o.y, o.z, a.x, a.y, a.z, f.x, f.y, f.z, r.x, r.y, r.z, u.x, u.y, u.z );
+		}
+	}

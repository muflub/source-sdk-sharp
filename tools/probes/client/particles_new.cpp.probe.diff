+// CNewParticleEffect's decisions, tag "np", to SOURCESHARP_PROBE_LOG.
+#include <fcntl.h>
+#include <unistd.h>
+static void NpLog( const char *pFmt, ... )
+{
+	static int s_fd = -2;
+	if ( s_fd == -2 )
+	{
+		const char *pPath = getenv( "SOURCESHARP_PROBE_LOG" );
+		s_fd = ( pPath && *pPath ) ? open( pPath, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0644 ) : -1;
+	}
+	if ( s_fd < 0 )
+		return;
+	static thread_local char buf[ 4096 ];
+	va_list ap;
+	va_start( ap, pFmt );
+	int n = V_vsnprintf( buf, sizeof( buf ) - 2, pFmt, ap );
+	va_end( ap );
+	if ( n < 0 )
+		return;
+	if ( n > (int)sizeof( buf ) - 2 )
+		n = sizeof( buf ) - 2;
+	buf[ n++ ] = '\n';
+	(void)!write( s_fd, buf, n );
+}
+#define NP_V( v ) (v).x, (v).y, (v).z
+#define NP_DRAW_RETURN( r, why ) do { NpLog( "np\tdraw\t%p\t%d\t%d\t%s\t%.9g", this, flags, r, why, m_flNextSleepTime ); return r; } while ( 0 )
+// ---- end probe ----

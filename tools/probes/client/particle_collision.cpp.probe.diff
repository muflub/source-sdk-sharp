+static void C5pTrace( const Vector &s, const Vector &e, trace_t *ptr )
+{
+	UTIL_TraceLine( s, e, MASK_SOLID_BRUSHONLY, NULL, COLLISION_GROUP_NONE, ptr );
+	FxProbeLog( "pct\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t|\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%d\t%d",
+	            s.x, s.y, s.z, e.x, e.y, e.z, ptr->fraction, ptr->endpos.x, ptr->endpos.y, ptr->endpos.z,
+	            ptr->plane.normal.x, ptr->plane.normal.y, ptr->plane.normal.z, ptr->plane.dist,
+	            ptr->allsolid ? 1 : 0, ptr->startsolid ? 1 : 0 );
+}
+
+static float C5pRandom( float lo, float hi )
+{
+	const float v = random->RandomFloat( lo, hi );
+	FxProbeLog( "pcr\t%.9g\t%.9g\t%.9g", lo, hi, v );
+	return v;
+}
+
+struct C5pMoveLog
+{
+	const void *pThis; Vector &o; Vector &v; float *pRoll; trace_t *pTrace; int nRet;
+	C5pMoveLog( const void *t, Vector &origin, Vector &velocity, float *roll, float dt, trace_t *tr, float grav, float damp, int planes )
+		: pThis( t ), o( origin ), v( velocity ), pRoll( roll ), pTrace( tr ), nRet( 0 )
+	{
+		FxProbeLog( "pcm\t%p\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%d\t%.9g\t%.9g\t%.9g\t%.9g\t%d",
+		            t, o.x, o.y, o.z, v.x, v.y, v.z, roll ? 1 : 0, roll ? *roll : 0.0f, dt, grav, damp, planes );
+	}
+	~C5pMoveLog()
+	{
+		FxProbeLog( "pcmo\t%p\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%d\t%.9g\t%d",
+		            pThis, o.x, o.y, o.z, v.x, v.y, v.z, pRoll ? *pRoll : 0.0f, nRet, pTrace->fraction, pTrace->allsolid ? 1 : 0 );
+	}
+};

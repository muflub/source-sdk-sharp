+static void C2SimsProbe_Particle( const char *pTag, const SimpleParticle *p, int nMaterial )
+{
+	if ( !C2SimsProbe_On() )
+		return;
+	C2SimsProbe_Row( "%s\t%d\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d", pTag, nMaterial,
+		p->m_Pos.x, p->m_Pos.y, p->m_Pos.z, p->m_vecVelocity.x, p->m_vecVelocity.y, p->m_vecVelocity.z,
+		p->m_flRoll, p->m_flRollDelta, p->m_flLifetime, p->m_flDieTime,
+		p->m_uchColor[0], p->m_uchColor[1], p->m_uchColor[2], p->m_uchStartAlpha, p->m_uchEndAlpha,
+		p->m_uchStartSize, p->m_uchEndSize, p->m_iFlags );
+}
+
+
+int C2SimsProbe_Frame();
+static void C2SimsProbe_Draw( const char *pTag, const Vector &pos, const Vector &color, float alpha, float scale, float roll )
+{
+	if ( C2SimsProbe_On() )
+		C2SimsProbe_Row( "%s\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g", pTag, pos.x, pos.y, pos.z, color.x, color.y, color.z, alpha, scale, roll );
+}
+// An emitter of stock class TBase whose rules are logged: Q<tag> after each
+// roll step, D<tag> at each render, and its velocity step's draws recorded.
+template < class TBase >
+class CC2SimsProbeEmitter : public TBase
+{
+public:
+	CC2SimsProbeEmitter( const char *pTag, const char *pName ) : TBase( pName ), m_pTag( pTag ) { this->SetDynamicallyAllocated( true ); }
+	const char *m_pTag;
+	virtual float UpdateRoll( SimpleParticle *p, float dt )
+	{
+		float r = TBase::UpdateRoll( p, dt );
+		char tag[ 8 ]; Q_snprintf( tag, sizeof( tag ), "Q%s", m_pTag );
+		C2SimsProbe_Particle( tag, p, -1 );
+		return r;
+	}
+	virtual void UpdateVelocity( SimpleParticle *p, float dt )
+	{
+		C2SimsProbe_Arm( true );
+		TBase::UpdateVelocity( p, dt );
+		C2SimsProbe_Arm( false );
+	}
+	virtual Vector UpdateColor( const SimpleParticle *p )
+	{
+		Vector c = TBase::UpdateColor( p );
+		char tag[ 8 ]; Q_snprintf( tag, sizeof( tag ), "D%s", m_pTag );
+		C2SimsProbe_Draw( tag, p->m_Pos, c, this->UpdateAlpha( p ), this->UpdateScale( p ), p->m_flRoll );
+		return c;
+	}
+};

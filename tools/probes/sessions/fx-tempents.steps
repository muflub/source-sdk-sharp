# lane c2-fx: the legacy tempents' oracle (probe copy of c_te_legacytempents.cpp):
# the render choices of every drawn tempent (ComputeFxBlend, IsTransparent,
# GetRenderGroup, DrawModel's occlusion alpha, the breakmodel lighting
# origin), PlaySound, AttachTentToPlayer, EjectBrass and the MuzzleFlash
# family (every particle each variant adds), over live temp entities in view
# and the cs_cl_probe_tebattery battery. Needs the probe build.
wait managed client module initialized 120
cmd map dm_lockdown
wait first paint 240
sleep 2
cmd sv_cheats 1
cmd setpos_exact -3843 2894 0
cmd setang_exact 15 90 0
sleep 1
cmd cs_te_fire all -3843 3150 40
sleep 2
cmd cs_te_fire breakmodel -3843 3100 60
sleep 0.3
cmd cs_te_fire breakmodel -3800 3100 60
sleep 2
cmd cs_cl_probe_tebattery render
sleep 4.5
cmd cs_cl_probe_tebattery muzzle
cmd cs_cl_probe_tebattery muzzle 0
sleep 0.5
cmd cs_cl_probe_tebattery sound
cmd cs_cl_probe_tebattery attach
sleep 2
cmd cs_sv_te_dispatch ShellEject -3843 3000 40
cmd cs_sv_te_dispatch RifleShellEject -3843 3000 40
cmd cs_sv_te_dispatch ShotgunShellEject -3843 3000 40
cmd cl_ejectbrass 0
cmd cs_sv_te_dispatch ShellEject -3843 3000 40
cmd cl_ejectbrass 1
cmd cs_sv_te_dispatch MuzzleFlash -3843 3000 40
sleep 2
cmd cs_te_fire all -3843 3150 40
sleep 3
quit

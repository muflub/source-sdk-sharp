sleep 0.3
cmd cs_cl_probe_fxshells
sleep 0.3
cmd cs_cl_probe_fxshells
sleep 0.3
cmd cs_cl_probe_fxshells
sleep 0.3
cmd cs_cl_probe_fxshells
sleep 0.3
cmd cs_cl_probe_fxshells
sleep 0.3

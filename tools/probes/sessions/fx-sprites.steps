# lane c2-fx: the sprite decisions' oracle (probe copies of our
# shell_sprite_leaf.cpp / shell_sprite_render.cpp): every C_SpriteRenderer::
# DrawSprite with its inputs, glow answers, blend and quad; every managed
# sprite's scale and aspect; every env_spritetrail tick and draw, with the
# random widths it drew. Needs the probe build.
wait managed client module initialized 120
cmd map dm_lockdown
wait first paint 240
sleep 2
cmd sv_cheats 1
cmd cs_te_fire all
sleep 0.5
cmd cs_te_fire all
sleep 1.5
cmd r_drawsprites 2
sleep 0.3
cmd r_drawsprites 0
sleep 0.3
cmd r_drawsprites 1
cmd map ss_sandbox
wait first paint 240
sleep 2
cmd sv_cheats 1
cmd cs_cl_probe_trailwiggle 40
cmd setpos_exact 960 2300 40
cmd setang_exact 0 -90 0
sleep 1
cmd cs_cl_probe_trailparams "1.5 16 2 6 0.05 120"
sleep 1.5
cmd cs_cl_probe_trailparams "0.8 10 -1 3 0.1 40"
sleep 1.5
cmd cs_cl_probe_trailparams "0 16 4 0 0.02 0"
sleep 0.5
cmd cs_cl_probe_trailparams "1.5 16 2 0 0 0"
cmd setpos_exact 800 2300 40
sleep 0.5
cmd setpos_exact 1120 2300 40
sleep 0.5
cmd setpos_exact 960 2600 200
cmd setang_exact 30 -90 0
sleep 0.5
cmd setpos_exact 960 1500 40
cmd setang_exact 0 90 0
sleep 0.7
cmd setpos_exact 960 1900 300
cmd setang_exact 89 90 0
sleep 0.5
cmd cs_cl_probe_spriteaxes
cmd setang_exact 89.99 90 0
sleep 0.3
cmd cs_cl_probe_spriteaxes
cmd setang_exact -60 90 20
sleep 0.5
cmd cs_cl_probe_spriteaxes
cmd cs_cl_probe_trailwiggle 0
sleep 2
cmd cs_cl_probe_trailwiggle 8
cmd setpos_exact 960 2300 40
cmd setang_exact 0 -90 0
sleep 1
cmd cs_te_fire all
sleep 1
quit

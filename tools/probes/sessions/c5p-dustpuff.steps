# lane c5-particles: FX_Dust (the dust puff) recorded (tools/probes/client/shell_dust_render.cpp.puff.probe.diff):
# c5p_ieffects dust across its clamps (a size under 2 is one puff, over 64 is 32; a negative speed is 1,
# over 480 is 48), in light and in shadow, with the temp entity's own call (cs_te_fire dust, 64 / 32).
wait first paint 240
sleep 3
cmd sv_cheats 1
cmd setpos_exact -3843 2894 0
sleep 1
cmd c5p_ieffects dust -3843 3050 4 0 0 1 1 30
cmd c5p_ieffects dust -3843 3050 4 0 0 1 0.5 30
cmd c5p_ieffects dust -3843 3050 4 0 0 1 10 -5
cmd c5p_ieffects dust -3843 3050 4 1 0 0 64 32
cmd c5p_ieffects dust -3843 3050 4 0.6 0.8 0 100 600
cmd c5p_ieffects dust -3843 3050 4 0 1 0 24 200
sleep 1
cmd c5p_ieffects dust -2880 2894 92 0 0 1 16 64
cmd c5p_ieffects dust -2939 3200 40 -1 0 0 40 120
cmd c5p_ieffects dust -3200 2400 8 0 0 1 8 16
cmd cs_te_fire dust
sleep 1
cmd cs_te_fire dust
sleep 1
quit

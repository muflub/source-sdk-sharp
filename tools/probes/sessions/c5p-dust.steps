# lane c5-particles: the dust motes recorded (tools/probes/client/shell_dust_render.cpp.probe.diff):
# ss_sandbox's weather station (func_dustmotes "weather_motes", x 1496..1592, y 1376..1504, z 16..200, and
# func_dustcloud "weather_cloud" beside it, x 1624..1720), stood south of them inside DistMax and seen from several angles and distances, so the render rows hold
# drawn and culled motes, scaled and unscaled, and the simulate rows span the motes' whole lives.
wait first paint 240
sleep 3
cmd sv_cheats 1
cmd setpos_exact 1544 1300 60
sleep 0.5
cmd setang_exact 0 90 0
sleep 6
cmd setang_exact 10 80 0
sleep 3
cmd setpos_exact 1544 1200 60
sleep 3
cmd setang_exact -10 100 0
sleep 3
cmd setpos_exact 1544 1440 100
sleep 3
cmd setang_exact 0 270 0
sleep 3
cmd setpos_exact 1672 1300 60
sleep 0.5
cmd setang_exact 0 90 0
sleep 5
cmd setang_exact 15 110 0
sleep 3
cmd cs_cl_dust_report
sleep 1
quit

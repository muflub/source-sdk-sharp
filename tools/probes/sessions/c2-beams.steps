# C2 beam oracle (tools/probes/client/c2-beams/README.md): dm_lockdown, the
# viewer parked in the shower room looking down +x; every beam temp entity the
# build fires (cs_te_fire), then the shapes no temp entity reaches
# (c2_beam_probe_extra), each alive for two seconds in view; the player moves
# while a follow beam trails it.
wait iface-list 120
cmd map dm_lockdown
wait first paint 240
cmd sv_cheats 1
cmd setpos_exact -3800 2500 64
cmd setang_exact 0 0 0
sleep 2
cmd cs_te_fire beampoints -3640 2440 30
cmd cs_te_fire beamringpoint -3640 2500 30
cmd cs_te_fire beamentpoint -3640 2560 30
cmd cs_te_fire beaments -3640 2500 30
cmd cs_te_fire beamring -3640 2500 30
cmd cs_te_fire beamlaser -3640 2500 30
cmd cs_te_fire beamfollow -3640 2500 30
sleep 0.3
cmd setpos_exact -3800 2460 64
sleep 0.3
cmd setpos_exact -3800 2420 64
sleep 0.3
cmd setpos_exact -3800 2500 64
shot beams-te
sleep 2.5
cmd c2_beam_probe_extra
sleep 0.5
shot beams-extra
sleep 2.5
cmd disconnect
sleep 2
quit

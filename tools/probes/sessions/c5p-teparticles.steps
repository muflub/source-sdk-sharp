# lane c5-particles: the temp entity particles recorded (shell_te_particle_render.cpp and
# shell_te_backends_client.cpp .tep.probe.diff): the blood stream and the debug line through their
# backends and their temp entities, at the default gravity and at half of it, seen while they fall.
wait first paint 240
sleep 3
cmd sv_cheats 1
cmd setpos_exact -3843 2894 0
sleep 1
cmd setang_exact 10 90 0
sleep 0.5
cmd cs_cl_te_backend bloodstream
cmd cs_cl_te_backend showline
sleep 3
cmd cs_te_fire bloodstream
cmd cs_te_fire showline
sleep 3
cmd sv_gravity 300
sleep 0.5
cmd cs_cl_te_backend bloodstream
sleep 3
cmd sv_gravity 600
cmd setang_exact 30 60 0
cmd cs_cl_te_backend bloodstream
sleep 4
quit

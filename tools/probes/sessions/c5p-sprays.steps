# lane c5-particles: the impact sprays recorded (shell_impact_effects.cpp.probe.diff's sdi/sti/sbi/sui/spp
# rows, particles_simple.cpp's dg* rows for the dust emitter): bullets into the floor and a wall (the
# debris dust beside the flecks), then c5p_spray debris and dust on the floor and a wall at two scales,
# blood in two colours and two directions, and the bug blood.
wait first paint 240
sleep 3
cmd sv_cheats 1
cmd use weapon_smg1
sleep 1
cmd setpos_exact -3843 2894 0
cmd setang_exact 60 0 0
sleep 1
cmd +attack
sleep 1.5
cmd -attack
sleep 2
cmd setang_exact 10 90 0
sleep 1
cmd +attack
sleep 1.5
cmd -attack
sleep 2
cmd c5p_spray debris -3843 3000 20 0 0 -1 1
cmd c5p_spray debris -3820 3000 20 0 0 -1 2
cmd c5p_spray dust -3843 3000 20 0 0 -1 1
cmd c5p_spray dust -3830 3010 20 0 0 -1 2
cmd c5p_spray dust -3843 3020 30 0 1 0 1
sleep 3
cmd c5p_spray blood -3843 3050 40 0 -1 0 255 0 0 255
cmd c5p_spray blood -3843 3050 40 0.6 -0.8 0 128 128 0 200
cmd c5p_spray bugblood -3843 3050 40 0 -1 0
cmd c5p_spray bugblood -3820 3040 30 0.6 -0.8 0
sleep 4

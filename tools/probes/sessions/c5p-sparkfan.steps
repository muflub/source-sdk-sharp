# lane c5-particles: FX_SparkFan recorded (fx_sparks.cpp.probe.diff's skf rows): the ManhackSparks client effect at three
# places and normals, run locally by c5p_dispatch.
wait first paint 240
sleep 3
cmd sv_cheats 1
cmd setpos_exact -3843 2894 0
cmd setang_exact 5 90 0
sleep 1
cmd c5p_dispatch ManhackSparks -3843 3050 40 0 -1 0 1 0 0
cmd c5p_dispatch ManhackSparks -3843 3050 40 0 0 1 1 0 0
cmd c5p_dispatch ManhackSparks -3820 3000 20 0.6 -0.8 0 1 0 0
sleep 2

#!/usr/bin/env python3
"""tools/probes/tempent-select -- lane c2-fx: a probe.log from
tools/probes/sessions/fx-tempents.steps into the legacy tempent fixtures.

    tools/probes/tempent-select PROBE_LOG OUT_DIR

Writes, each row the probe line after its "<ns> <pid> fx " prefix and every
`fxr` random draw kept with the row it was drawn inside:
  tempents-render-stock.tsv.gz   the render choices: tfx-in/out pairs, ttr
                                 (with the trg it answered, when it was
                                 asked from inside GetRenderGroup), trg,
                                 tdm-in/tdm-a pairs (one row in four of
                                 each kind, and every row of a kind/fx/mode
                                 seen fewer than 64 times), every breakable
                                 helper event (tbh-*, tlo, which are stateful)
  tempents-muzzle-stock.tsv      every tmf-* row
  tempents-sound-stock.tsv       every tps-* row
  tempents-misc-stock.tsv        tat-*, teb-*, tbat-*
Fails when a channel is empty: a recording that did not reach a subject is
not a fixture.
"""
import collections, gzip, pathlib, re, sys

def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    log, out = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
    rows = []
    for line in log.read_text(errors='replace').splitlines():
        parts = line.split(' ', 3)
        if len(parts) == 4 and parts[2] == 'fx':
            rows.append(parts[3])
    # groups: a starter row and the fxr draws (and its partner) after it
    groups = []
    for r in rows:
        tag = r.split(' ', 1)[0]
        if tag == 'fxr' or tag in ('tfx-out', 'tdm-a'):
            if groups:
                groups[-1].append(r)
            continue
        if not tag.startswith('t'):
            continue
        # IsTransparent asked from inside GetRenderGroup: the two are one group.
        if tag == 'trg' and groups and len(groups[-1]) == 1 and groups[-1][0].startswith('ttr '):
            groups[-1].append(r)
            continue
        if tag.startswith(('tmf-', 'tps-')) and groups and groups[-1][0].split(' ', 1)[0][:4] == tag[:4] \
                and not tag in ('tmf-call1', 'tmf-call2', 'tps-in'):
            groups[-1].append(r)
            continue
        groups.append([r])
    chan = collections.defaultdict(list)
    def key(g):
        t = g[0].split(' ', 1)[0]
        fx = re.search(r' fx=(\d+)', g[0]); mode = re.search(r' mode=(\d+)', g[0])
        return (t, fx.group(1) if fx else '', mode.group(1) if mode else '')
    counts = collections.Counter(key(g) for g in groups if g[0][:4] in ('tfx-', 'ttr ', 'trg ', 'tdm-'))
    seen = collections.Counter()
    for g in groups:
        t = g[0].split(' ', 1)[0]
        if t.startswith(('tfx', 'ttr', 'trg', 'tdm')):
            k = key(g); seen[k] += 1
            if counts[k] < 64 or seen[k] % 4 == 1:
                chan['render'] += g
        elif t.startswith(('tbh', 'tlo')):
            chan['render'] += g
        elif t.startswith('tmf'):
            chan['muzzle'] += g
        elif t.startswith('tps'):
            chan['sound'] += g
        elif t.startswith(('tat', 'teb', 'tbat')):
            chan['misc'] += g
    out.mkdir(parents=True, exist_ok=True)
    for name, gz in (('render', True), ('muzzle', False), ('sound', False), ('misc', False)):
        if not chan[name]:
            sys.exit(f'tempent-select: no {name} rows')
        data = ('\n'.join(chan[name]) + '\n').encode()
        path = out / f'tempents-{name}-stock.tsv{".gz" if gz else ""}'
        if gz:
            with gzip.GzipFile(path, 'wb', mtime=0) as f:
                f.write(data)
        else:
            path.write_bytes(data)
        print(f'{path.name}: {len(chan[name])} rows')

main()

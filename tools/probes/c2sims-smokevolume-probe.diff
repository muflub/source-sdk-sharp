+void C_FuncSmokeVolume::ProbeCells()
+{
+	const int nTotal = m_xCount * m_yCount * m_zCount;
+	for ( int i = 0; i < nTotal; i++ )
+	{
+		SmokeParticleInfo *pInfo = &m_pSmokeParticleInfos[i];
+		if ( !pInfo->m_pParticle )
+			continue;
+		SmokeGrenadeParticle *p = pInfo->m_pParticle;
+		C2SimsProbe_Row( "G\t%d\t%d\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%d\t%d\t%d\t%.9g\t%.9g\t%d",
+			i, pInfo->m_TradeIndex,
+			pInfo->m_TradeIndex == -1 ? 0.0f : pInfo->m_TradeClock, pInfo->m_TradeIndex == -1 ? 0.0f : pInfo->m_TradeDuration,
+			p->m_Pos.x, p->m_Pos.y, p->m_Pos.z, p->m_FadeAlpha, p->m_Color[0], p->m_Color[1], p->m_Color[2],
+			p->m_RotationFactor, p->m_CurRotation, p->m_ColorInterp );
+	}
+}

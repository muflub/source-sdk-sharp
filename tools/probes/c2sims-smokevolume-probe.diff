+			m_CurrentDensity, m_Density );
+		C2SimsProbe_Arm( true );
+	}
+	UpdateInner( fTimeDelta );
+	if ( bProbe )
+	{
+		C2SimsProbe_Arm( false );
+		ProbeCells();
+	}

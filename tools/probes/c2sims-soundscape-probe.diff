+void C_SoundscapeSystem::SsProbeScript( int f )
+{
+	if ( f == 1 )
+	{
+		C2SimsProbe_Row( "X\treset" );
+		Shutdown();
+		Init();
+		SsProbePush( -2, 0, 0, vec3_origin );
+		SsProbePush( -1, 0, 0, vec3_origin );
+	}
+	if ( f == 2 ) { C2SimsProbe_Row( "X\tforce\tc2probe.full\t48" ); ForceSoundscape( "c2probe.full", 48 ); }
+	if ( f == 150 ) { C2SimsProbe_Row( "X\tforce\te3_c17_01_battle\t64" ); ForceSoundscape( "e3_c17_01_battle", 64 ); }
+	if ( f == 300 ) { C2SimsProbe_Row( "X\tname\tc17_02_street_lower_1" ); SsProbePush( FindSoundscapeByName( "c17_02_street_lower_1" ), 1, 1, Vector( 100, 200, 64 ) ); }
+	if ( f == 450 ) { C2SimsProbe_Row( "X\tname\tc17_02_street_upper_2" ); SsProbePush( FindSoundscapeByName( "c17_02_street_upper_2" ), 1, 1, Vector( 300, 200, 64 ) ); }
+	if ( f == 600 ) { C2SimsProbe_Row( "X\tname\tc17_02_street_upper_2" ); SsProbePush( FindSoundscapeByName( "c17_02_street_upper_2" ), 1, 1, Vector( 300, 200, 64 ) ); }
+	if ( f == 620 ) { SsProbePush( 9999, 1, 0, vec3_origin ); }
+	if ( f == 650 ) { SsProbePush( -1, 0, 0, vec3_origin ); }
+	if ( f == 700 )
+	{
+		C2SimsProbe_Row( "X\tflush" );
+		audioparams_t tmp;
+		GetAudioParams( tmp );
+		Shutdown();
+		Init();
+		g_bSsProbePush = true;
+		Soundscape_Update( tmp );
+		g_bSsProbePush = false;
+	}
+	if ( f == 720 ) { C2SimsProbe_Row( "X\tname\tc17_02_street_upper_1" ); SsProbePush( FindSoundscapeByName( "c17_02_street_upper_1" ), 1, 1, Vector( 300, 200, 64 ) ); }
+	if ( f == 800 ) { C2SimsProbe_Row( "X\tstop" ); StartNewSoundscape( NULL ); }
+	if ( f == 850 ) { C2SimsProbe_Row( "X\tforce\tc2probe.full\t48" ); ForceSoundscape( "c2probe.full", 48 ); }
+	if ( f == 900 ) { C2SimsProbe_Row( "X\tforce\tno_such_soundscape\t48" ); ForceSoundscape( "no_such_soundscape", 48 ); }
+}

+static void SsProbePush( int idx, int ent, int bits, const Vector &p0 )
+{
+	audioparams_t a;
+	a.soundscapeIndex = idx;
+	a.entIndex = ent;
+	a.localBits = bits;
+	for ( int i = 0; i < NUM_AUDIO_LOCAL_SOUNDS; ++i )
+		a.localSound.Set( i, i == 0 ? p0 : vec3_origin );
+	C2SimsProbe_Row( "X\tpush\t%d\t%d\t%d\t%.9g\t%.9g\t%.9g", idx, ent, bits, p0.x, p0.y, p0.z );
+	g_bSsProbePush = true;
+	Soundscape_Update( a );
+	g_bSsProbePush = false;
+}

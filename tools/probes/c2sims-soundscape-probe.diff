+		C2SimsProbe_Arm( true );
+		const Vector o = MainViewOrigin(), fw = MainViewForward(), rt = MainViewRight();
+		C2SimsProbe_Row( "F\t%d\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%.9g\t%d",
+		                 C2SimsProbe_Frame(), gpGlobals->curtime, frametime, o.x, o.y, o.z, fw.x, fw.y, fw.z, rt.x, rt.y, rt.z,
+		                 soundscape_fadetime.GetFloat(), IsBeingRestored() ? 1 : 0 );
+		SsProbeScript( C2SimsProbe_Frame() );
+	}
+	SsProbeUpdate( frametime );
+	if ( bProbe )
+	{
+		C2SimsProbe_Row( "Q\t%d\t%d\t%d\t%d", GetCurrentSoundscape(), m_loopingSounds.Count(), m_randomSounds.Count(), m_loopingSoundId );
+		C2SimsProbe_Arm( false );
+	}
+}

#!/usr/bin/env python3
"""tools/late-bound -- forwarders for the interfaces the engine fetches before DLLInit.

    tools/late-bound              check the generated forwarders are what the headers say
    tools/late-bound --write      write them
    tools/late-bound --self-test

    exit 0   they are current
    exit 1   they are not -- run --write and read the diff
    exit 2   a header could not be read, or a declaration cannot be forwarded

plan_server_native_v2 T6 part 3. The engine asks the game DLL's factory for
IServerGameClients and IServerGameEnts when it loads the DLL and keeps the
pointers; DLLInit comes later. So
the object it is handed must exist before any engine interface does, and it
lives on the game DLL's root. The work is done by an implementation the DLL
tier builds in DLLInit with what it calls handed to its constructor; the root's
object is this generated forwarder, which the root binds to that implementation
in DLLInit and unbinds in DLLShutdown. The engine calls no method outside that
window -- except for what ROOT_ANSWERS lists: the engine calls those before
DLLInit (it asks IServerGameClients::GetPlayerLimits while loading the DLL), so
the forwarder leaves them pure and the root's subclass answers them itself. A
forwarded call made while unbound stops with Error() naming the method, never a
null dereference.

Each method is copied from the header as written and forwards every argument
by name; an unnamed parameter is named a0, a1, ... A varargs method cannot be
forwarded and is refused.
"""

import importlib.machinery
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
NF = importlib.machinery.SourceFileLoader('native_fakes', os.path.join(ROOT, 'tools', 'native-fakes')).load_module()
VALVE = 'tools/valve-header.txt'
GENERATED = '// GENERATED by `tools/late-bound --write`. DO NOT EDIT.'

# Methods the engine calls before DLLInit, answered by the root's subclass.
ROOT_ANSWERS = {
    'IServerGameClients': ['GetPlayerLimits'],
}

# (interface, header it is declared in, header to include, generated file)
LATE_BOUND = [
    ('IServerGameClients', 'vendor/shared/public/eiface.h', 'eiface.h',
     'src/server/native/late_bound_game_clients.g.h'),
    ('IServerGameEnts', 'vendor/shared/public/eiface.h', 'eiface.h',
     'src/server/native/late_bound_game_ents.g.h'),
]

Refusal = NF.Refusal

TYPE_WORDS = {'int', 'char', 'bool', 'float', 'double', 'long', 'short', 'unsigned', 'signed', 'void', 'const',
              'struct', 'class', 'volatile'}


def split_params(params):
    """The top-level comma-separated parameters of a parameter list."""
    out, depth, cur = [], 0, ''
    for ch in params:
        if ch in '(<[':
            depth += 1
        elif ch in ')>]':
            depth -= 1
        if ch == ',' and depth == 0:
            out.append(cur.strip())
            cur = ''
        else:
            cur += ch
    if cur.strip():
        out.append(cur.strip())
    return out


def named(param, index):
    """(declaration, name): the parameter with its default dropped and a name it can be
    forwarded by, invented when the header gives none."""
    decl = param.split('=')[0].strip()
    m = re.match(r'^(.*?[\s\*&])([A-Za-z_]\w*)$', decl)
    if m and m.group(2) not in TYPE_WORDS and m.group(1).strip() not in ('', 'const', 'unsigned', 'signed'):
        return param, m.group(2)
    name = 'a%d' % index
    if '=' in param:
        return '%s %s = %s' % (decl, name, param.split('=', 1)[1].strip()), name
    return '%s %s' % (decl, name), name


def forwarder(decl):
    """One forwarding method for a declaration `RET Name( params )[ const]`."""
    m = re.match(r'^(.*?)\b(\w+)\s*\((.*)\)\s*(const)?$', decl)
    if not m:
        raise Refusal('cannot read: %s' % decl)
    ret, name, params, const = m.group(1).strip(), m.group(2), m.group(3).strip(), m.group(4)
    if '...' in params:
        raise Refusal('%s is varargs and cannot be forwarded' % name)
    parts = [] if params in ('', 'void') else split_params(params)
    decls, names = [], []
    for k, p in enumerate(parts):
        d, n = named(p, k)
        decls.append(d)
        names.append(n)
    lead = ret if ret.endswith(('*', '&')) else ret + ' '
    head = '%s%s( %s )%s' % (lead, name, ', '.join(decls), ' const' if const else '') if decls else \
        '%s%s()%s' % (lead, name, ' const' if const else '')
    call = 'Impl( "%s" )->%s( %s )' % (name, name, ', '.join(names)) if names else 'Impl( "%s" )->%s()' % (name, name)
    return '\t%s override { %s%s; }' % (head, '' if ret == 'void' else 'return ', call)


def method_name(decl):
    return re.match(r'^(.*?)\b(\w+)\s*\(', decl).group(2)


def generate_one(iface, header, include):
    valve = NF.read(VALVE).rstrip('\n')
    decls = NF.pure_virtuals(NF.read(header), iface)
    root = ROOT_ANSWERS.get(iface, [])
    missing = [m for m in root if m not in [method_name(d) for d in decls]]
    if missing:
        raise Refusal('%s has no %s for the root to answer' % (iface, ', '.join(missing)))
    cls = 'CLateBound' + iface[1:]
    out = [valve, '', GENERATED, '//',
           '// %s held by the game DLL\'s root from load, forwarding to the DLL tier\'s' % iface,
           '// implementation the root binds in DLLInit and unbinds in DLLShutdown.']
    if root:
        out.append('// The engine calls %s before DLLInit; the root\'s subclass answers it.' % ', '.join(root))
    out += ['', '#pragma once', '', '#include "%s"' % include, '#include "tier0/dbg.h"', '',
            'class %s%s : public %s' % (cls, '' if root else ' final', iface), '{', 'public:',
            '\tvoid Bind( %s *pImpl ) { m_pImpl = pImpl; }' % iface, '']
    out += [forwarder(d) for d in decls if method_name(d) not in root]
    out += ['', 'private:',
            '\t%s *Impl( const char *pszMethod ) const' % iface, '\t{', '\t\tif ( !m_pImpl )',
            '\t\t\tError( "[SourceSharp] %s::%%s was called before DLLInit bound it\\n", pszMethod );' % iface,
            '\t\treturn m_pImpl;', '\t}', '',
            '\t%s *m_pImpl = nullptr;' % iface, '};', '']
    return '\n'.join(out)


def generate():
    return {path: NF.formatted(generate_one(iface, header, include), path)
            for iface, header, include, path in LATE_BOUND}


def self_test():
    arms = []

    def expect(name, cond):
        arms.append(bool(cond))
        print('  %-4s %s' % ('ok' if cond else 'FAIL', name))

    expect('a named parameter forwards by its name',
           forwarder('void ClientActive( edict_t * pEntity, bool bLoadGame )')
           == '\tvoid ClientActive( edict_t * pEntity, bool bLoadGame ) override { Impl( "ClientActive" )->ClientActive( pEntity, bLoadGame ); }')
    expect('an unnamed parameter is named, and a value is returned',
           forwarder('CBaseEntity *EdictToBaseEntity( edict_t * )')
           == '\tCBaseEntity *EdictToBaseEntity( edict_t * a0 ) override { return Impl( "EdictToBaseEntity" )->EdictToBaseEntity( a0 ); }')
    expect('a bare type is a type, not a name',
           forwarder('void Set( int, unsigned int )')
           == '\tvoid Set( int a0, unsigned int a1 ) override { Impl( "Set" )->Set( a0, a1 ); }')
    expect('a reference out-parameter and const are kept',
           forwarder('void GetPlayerLimits( int &minplayers, int &maxplayers ) const')
           == '\tvoid GetPlayerLimits( int &minplayers, int &maxplayers ) const override '
              '{ Impl( "GetPlayerLimits" )->GetPlayerLimits( minplayers, maxplayers ); }')
    expect('a default is kept on a named parameter and dropped from the call',
           forwarder('int Precache( const char *s, bool preload = false )')
           == '\tint Precache( const char *s, bool preload = false ) override { return Impl( "Precache" )->Precache( s, preload ); }')
    expect('no parameters forward as none',
           forwarder('int Count()') == '\tint Count() override { return Impl( "Count" )->Count(); }')
    try:
        forwarder('void Say( const char *fmt, ... )')
        expect('a varargs method is refused', False)
    except Refusal:
        expect('a varargs method is refused', True)
    clients = generate_one(*LATE_BOUND[0][:3])
    expect('the game clients forwarder forwards the 18 methods the root does not answer itself',
           clients.count(' override ') == 18 and 'GetPlayerLimits' not in clients.split('class ')[1].split('private:')[0]
           and 'final' not in clients.split('class ')[1].split('{')[0])
    expect('an unbound call stops with Error naming the method',
           'Error( "[SourceSharp] IServerGameClients::%s was called before DLLInit bound it\\n", pszMethod );' in clients)
    ents = generate_one(*LATE_BOUND[1][:3])
    expect('a forwarder whose interface the root answers nothing of is final',
           'class CLateBoundServerGameEnts final : public IServerGameEnts' in ents)
    print('\n%d arm(s), %d failed.' % (len(arms), arms.count(False)))
    return 0 if all(arms) else 1


def main(argv):
    if '--self-test' in argv:
        return self_test()
    try:
        gen = generate()
    except (Refusal, OSError) as e:
        print('tools/late-bound: %s' % e)
        return 2
    stale = []
    for path, text in gen.items():
        full = os.path.join(ROOT, path)
        if '--write' in argv:
            with open(full, 'w') as f:
                f.write(text)
        elif not os.path.exists(full) or open(full).read() != text:
            stale.append(path)
    if stale:
        print('tools/late-bound: stale: %s -- run `tools/late-bound --write` and read the diff' % ', '.join(stale))
        return 1
    print('tools/late-bound: %d forwarder(s) are what the headers say.' % len(gen))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))

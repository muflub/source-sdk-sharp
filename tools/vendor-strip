#!/usr/bin/env python3
"""tools/vendor-strip -- delete the vendored declarations nothing uses.

    tools/vendor-strip                    report what would go; exit 0
    tools/vendor-strip --write [--only S] delete it (S: shared, server or client;
                                          default all three), then build
    tools/vendor-strip --stub [--write]   the unused virtuals instead: each keeps its
                                          slot as `virtual void unused_<Name>() = 0;`
    tools/vendor-strip --check            exit 1 if anything would still go
    tools/vendor-strip --self-test        this script's own checks
    --cache FILE  keep the walk's result in FILE and reuse it (one tree state only)
    --config C (or SOURCESHARP_CONFIG) picks farm/<C>; default debug.

vendor/ is cut to what the modules use (vendor/README.md). tools/vendor
drops the files no module reads; this drops what is inside a file that no
module needs. Every module object is parsed with libclang (tools/lib/
libclang_lite.py) from its own compile command, the Linux build's and the
windows-cross build's, and each declaration is named by its USR, so a use
through any copy of a header (the fork's, the pristine clone's, vendor/'s)
counts for the vendored one.

LIVENESS. A reference from this repo's code is a root. A reference from
inside a vendored declaration counts only when that declaration is live, so
a helper only a dead inline function calls goes with it. A live member keeps
its class; a live class keeps its data members, enumerators, constructors,
destructor, operators, virtual methods (tools/vendor-stub's), and, for a
class template, every member (an instantiation's uses are not in the AST).
A macro is live when any module object expands it, or when any #if, #ifdef,
#ifndef or #elif line here or in our native sources names it.

WHAT GOES: a declaration of a dead free function, function template,
non-virtual method, global, class, class template, enum, typedef or alias,
and the #define of a dead macro; with each, its attached comment. A
declaration whose text spans a preprocessor line, or that a macro wrote, is
kept. Then an #include of a vendored file with nothing live left in it (or
in what it includes) goes too, and tools/vendor --write deletes the file.

WHAT THE AST CANNOT SEE: a member a template body reaches only through its
type parameter. Building after --write finds those; KEEP below names each,
with the error that found it.
"""
import concurrent.futures
import hashlib
import subprocess
import importlib.machinery
import json
import os
import re
import shlex
import sys
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
VENDOR = os.path.realpath(os.path.join(REPO, "vendor"))
sys.path.insert(0, os.path.join(REPO, "tools", "lib"))
VD = importlib.machinery.SourceFileLoader("vendor_tool", os.path.join(REPO, "tools", "vendor")).load_module()

# Names the build needed that the AST walk could not see (see the docstring).
KEEP = {
    # xboxstubs.h's _XSESSION_INFO, a struct whose text a typedef shares (so
    # it stays), types a field with it: "unknown type name 'XNADDR'" in
    # tier1's convar.cpp and the client forwarder library.
    "XNADDR",
    # dmxelement.h's member templates (SetValue<T> and kin) call it from
    # bodies the AST shows only per instantiation: "use of undeclared
    # identifier 'AddAttribute'" in libss_particles.
    "AddAttribute",
    # platform.h's, for the byte stubs tools/vendor-fields writes where MSVC
    # and Itanium lay a record out differently; kept for the next such run.
    "SS_ABI_PICK",
}

CLANG_RESOURCE = "/usr/lib/llvm-22/lib/clang/22/include"
OUR_NATIVE = ("src/server/native", "src/client/native", "src/shared/native", "src/fwd/native",
              "src/host/native", "src/engineabi/native")

UNIT_KINDS = {"FunctionDecl", "CXXMethod", "Constructor", "Destructor", "ConversionFunction",
              "FunctionTemplate", "ClassDecl", "StructDecl", "UnionDecl", "ClassTemplate",
              "ClassTemplatePartialSpecialization", "EnumDecl", "TypedefDecl", "TypeAliasDecl",
              "VarDecl"}
CLASS_KINDS = {"ClassDecl", "StructDecl", "UnionDecl", "ClassTemplate",
               "ClassTemplatePartialSpecialization"}
ALWAYS_WITH_CLASS = {"FieldDecl", "Constructor", "Destructor", "ConversionFunction",
                     "EnumConstantDecl"}
# A declaration inside a function body is the body's, never a unit of its own.
FUNCTION_KINDS = {"FunctionDecl", "CXXMethod", "Constructor", "Destructor", "ConversionFunction",
                  "FunctionTemplate"}
STRIPPABLE = {"FunctionDecl", "CXXMethod", "FunctionTemplate", "ClassDecl", "StructDecl",
              "UnionDecl", "ClassTemplate", "EnumDecl", "TypedefDecl", "TypeAliasDecl", "VarDecl"}


class Missing(Exception):
    pass


REPO_REAL = os.path.realpath(REPO)


def is_ours(path):
    """A file of this repo outside vendor/ (the farm's links resolve into the
    fork or the clone, so a realpath under the repo is ours)."""
    return path.startswith(REPO_REAL + os.sep) and side_of(path) is None


def side_of(path):
    if not path or not path.startswith(VENDOR + os.sep):
        return None
    return path[len(VENDOR) + 1:].split(os.sep, 1)[0]


# ---------------------------------------------------------------------------
# The walk (one module object per call, in a worker process)
# ---------------------------------------------------------------------------

def compile_args(entry, windows):
    toks = shlex.split(entry["command"]) if "command" in entry else list(entry["arguments"])
    out, skip = [], False
    for t in toks[1:]:
        if skip:
            skip = False
            continue
        if t in ("-o", "-c", "-MF", "-MT", "-MQ", "--"):
            skip = t != "--"
            continue
        if t.startswith(("/Fo", "/Fd", "/Fe", "-MD", "/showIncludes")) and windows:
            continue
        if t in ("-MD", "-MMD") or os.path.basename(t) == os.path.basename(entry["file"]):
            continue
        out.append(t)
    if windows:
        out = ["--driver-mode=cl"] + out
    else:
        out.append("-I" + CLANG_RESOURCE)
    return out


def walk(job):
    import libclang_lite as lc
    entry, windows = job
    kinds = {v: k for k, v in lc.K.items()}
    idx = lc.createIndex(0, 0)
    tu = lc.parse(idx, entry["file"], compile_args(entry, windows))
    decls, edges, macro_defs, macro_uses = {}, set(), {}, set()
    bases, overriders = set(), set()
    usr_of = lc.usr

    def add_decl(c, kind, owner_usr):
        u = usr_of(c)
        if not u:
            return None
        ext = lc.getCursorExtent(c)
        f, _, start = lc.where(lc.getRangeStart(ext))
        f2, _, end = lc.where(lc.getRangeEnd(ext))
        f = os.path.realpath(f) if f else None
        if side_of(f) is None or f != (os.path.realpath(f2) if f2 else None):
            return u
        parent = lc.getSemanticParent(c)
        pk = kinds.get(parent.kind, "")
        info = (f, start, end, kind, lc.spelling(c),
                usr_of(parent) if pk in CLASS_KINDS or pk == "EnumDecl" else "",
                bool(kind == "CXXMethod" and lc.methodIsVirtual(c)), pk == "ClassTemplate")
        decls.setdefault(u, set()).add(info)
        return u

    def visit(cursor, owner, in_body):
        @lc.VISITOR
        def cb(c, parent, data):
            kind = kinds.get(c.kind)
            if kind == "MacroDefinition":
                ext = lc.getCursorExtent(c)
                f, _, start = lc.where(lc.getRangeStart(ext))
                _, _, end = lc.where(lc.getRangeEnd(ext))
                f = os.path.realpath(f) if f else None
                if side_of(f):
                    macro_defs[(f, start)] = (lc.spelling(c), end)
                return 1
            if kind == "MacroExpansion":
                macro_uses.add(lc.spelling(c))
                return 1
            if kind == "InclusionDirective":
                return 1
            if kind == "CXXBaseSpecifier":
                b = lc.getCursorReferenced(c)
                for _ in range(3):
                    if lc.cursorIsNull(b):
                        break
                    if usr_of(b):
                        bases.add(usr_of(b))
                    b = lc.specializedTemplate(b)
            elif kind == "CXXMethod" and not in_body:
                ov = lc.overridden(c)
                if ov:
                    overriders.add(usr_of(c))
                    # The methods it overrides are implemented somewhere: an
                    # interface our code answers (IParticleSystemQuery through
                    # CBaseAppSystem<>, a base no base specifier names) keeps
                    # every slot it fills.
                    for o in ov:
                        overriders.add(usr_of(o))
            new_owner = owner
            body = in_body or kind in FUNCTION_KINDS
            if in_body:
                kind = "local"
            if kind is not None and (kind in UNIT_KINDS or kind in ALWAYS_WITH_CLASS):
                u = add_decl(c, kind, owner)
                # Our code declaring or defining a vendored name (an
                # out-of-line member of a vendored class) keeps that name.
                if u and is_ours(os.path.realpath(lc.where(lc.getCursorLocation(c))[0] or "")):
                    edges.add(("", u))
                if u and kind in UNIT_KINDS:
                    loc_file = lc.where(lc.getCursorLocation(c))[0]
                    new_owner = u if side_of(os.path.realpath(loc_file) if loc_file else None) else ""
            r = lc.getCursorReferenced(c)
            if not lc.cursorIsNull(r) and not lc.equalCursors(r, c):
                if kind == "OverloadedDeclRef":
                    for i in range(lc.numOverloaded(c)):
                        edges.add((owner, usr_of(lc.overloadedDecl(c, i))))
                else:
                    ru = usr_of(r)
                    if ru:
                        edges.add((owner, ru))
                    # A use of Clamp<int> or CUtlVector<int>::Count is a use
                    # of the template it was made from, which is what the
                    # text declares.
                    t = lc.specializedTemplate(r)
                    for _ in range(3):
                        if lc.cursorIsNull(t):
                            break
                        tu_ = usr_of(t)
                        if tu_:
                            edges.add((owner, tu_))
                        t = lc.specializedTemplate(t)
            visit(c, new_owner, body)
            return 1
        lc.visitChildren(cursor, cb, None)

    visit(lc.getTUCursor(tu), "", False)
    diags = lc.getNumDiagnostics(tu)
    lc.disposeTU(tu)
    lc.disposeIndex(idx)
    return decls, edges, macro_defs, macro_uses, bases, overriders, diags, entry["file"]



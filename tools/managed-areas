# tools/engine-forwarders places its structs: the root's in the shared interop (its
# ManagedRoot builds it, for both sides; the Abi holds plumbing only), the
# server's runtime and areas in Server.Interop, the client's runtime, areas and
# Steam callback in Client.Interop.
OUT_TABLES = 'src/shared/interop/SharedManagedTables.g.cs'
OUT_TABLES_SERVER = 'src/server/interop/ServerManagedTables.g.cs'
OUT_TABLES_CLIENT = 'src/client/interop/ClientManagedTables.g.cs'
TABLE_FILES = {
    OUT_TABLES: 'the shared interop (each side\'s interop compiles it), for the table both sides build (the root)',
    OUT_TABLES_SERVER: 'SourceSharp.Server.Interop, for the server\'s runtime and areas',
    OUT_TABLES_CLIENT: 'SourceSharp.Client.Interop, for the client\'s runtime, areas and Steam callback',
}
OUT_STEAM = 'src/fwd/native/imanaged_steam_callback.h'   # libss_fwd_client's callback's managed side
OUT_MANAGED = 'src/server/interop/ManagedAreas.g.cs'   # SourceSharp.Server.Interop (SI)


OUT_RUNTIME_CLIENT = 'src/shared/native/imanaged_runtime_client.h'
OUT_IFACE_CLIENT = 'src/shared/native/imanaged_areas_client.h'
OUT_HOLDER_CLIENT = 'src/shared/native/shell_managed_areas_client.h'
OUT_IMPL_CLIENT = 'src/shared/native/shell_managed_areas_client.inc'
OUT_MANAGED_CLIENT = 'src/client/interop/ManagedAreas.g.cs'   # SourceSharp.Client.Interop

# The two that are not areas (plan_managed_vtable_reload.md L0b): the root
# LoadSideV2 hands native, which BOTH sides take, and the shell game DLL's
# runtime, which only the server does. They are declared in imanaged_core.h
# (the root, both sides, no ABI types) and imanaged_runtime.h (the runtime,
# the server's, which takes the ABI's SourceSharpMapLoad and so includes
# sourcesharp.h -- a header the root's users do not all have on their path),
# and nothing else is generated for them: the root is accepted by
# ManagedRoot_Accept and the runtime by ManagedRoot_AcquireAreas, each by hand,
# and their C# contracts (IManagedRoot in ManagedRoot.cs, IServerRuntime in
# ServerRuntimeBinding.cs) are held to their layouts by ManagedVtableGenerator.
# The value says whether the declaration is the server's only.
#
# IManagedSteamCallback is not an area either: libss_fwd_client's Steam
# callback holds one (plan_engine_forwarders.md section 6), and its header is
# the forwarder library's (OUT_STEAM).
CORE = {'IManagedRoot': False, 'IManagedRuntimeServer': True, 'IManagedRuntimeClient': False,
        'IManagedSteamCallback': False}

# plan_forwarders_everywhere.md phase 5: the managed side of each vphysics
# callback (and, since plan_server_native_v2 T4a, of the recipient filter the
# engine's EmitSound calls, which has the same shape). vphysics calls IPhysicsCollisionEvent and the rest through its own
# C++ vtable, so libss_fwd_<side> builds that object (fwd_physics.cpp) and its
# overrides call these tables. Not areas: built on demand, one per handler.
# Each block reserves CALLBACK_WORDS words after word 0, where the native
# object is built (its vptr, its pointer back to the block and, for the trace
# filter, the trace type managed chose), so it lives,
# survives a reload and is freed exactly as the block is. The value is the C#
# file the table goes in: the assembly whose code builds it.
CALLBACK_WORDS = 3
OUT_CALLBACKS = 'src/fwd/native/imanaged_physics_callbacks.h'
CALLBACKS = {
    'IManagedPhysicsObjectEvent': 'server',
    'IManagedPhysicsCollisionEvent': 'shared',
    'IManagedPhysicsCollisionSolver': 'shared',
    'IManagedPhysicsConstraintEvent': 'server',
    'IManagedMotionEvent': 'server',
    'IManagedVPhysicsKeyHandler': 'shared',
    # plan_server_native_v2 T4a: the IRecipientFilter IEngineSound::EmitSound
    # calls back, built by libss_fwd_<side> (fwd_recipient_filter.cpp) over the
    # recipients the managed SoundEmitter chose; shared since the client's
    # emitter is managed too.
    'IManagedRecipientFilter': 'shared',
    # plan_server_native_v2 T4f: the ITraceFilter IEngineTrace::TraceRay calls
    # per candidate, built by libss_fwd_server (fwd_trace_filter.cpp) over the
    # managed rule (TraceFilterRules); server only, the client's traces keep
    # their own filters.
    'IManagedTraceFilter': 'server',
}


def is_client(iface):
    """plan_client_vtables CD: a client area or the client's runtime."""
    return iface.endswith('Client')

GENERATED = '// GENERATED by `tools/managed-areas --write` from docs/managed-interfaces.tsv. DO NOT EDIT.'


def read(rel):
    with open(os.path.join(ROOT, rel)) as f:
        return f.read()


def strip_comments(text):
    text = re.sub(r'/\*.*?\*/', lambda m: '\n' * m.group(0).count('\n'), text, flags=re.S)
    return re.sub(r'//[^\n]*', '', text)


def parse_spec(text):
    """[(interface, [(method, return, parameters)])] in first-appearance order.

    One row per method, slot order within an interface; `void` parameters are
    an empty list. Release is never a row: every interface gets it last.
    """
    order, methods = [], {}
    rows = [l for l in text.splitlines() if l.strip() and not l.lstrip().startswith('#')]
    if not rows or rows[0].split('\t') != ['interface', 'method', 'return', 'parameters']:
        raise SystemExit('tools/managed-areas: %s does not start with its header row' % SPEC)
    for n, line in enumerate(rows[1:], 2):
        cells = line.split('\t')
        if len(cells) != 4 or not all(c.strip() for c in cells):
            raise SystemExit('tools/managed-areas: %s row %d is not four cells: %r' % (SPEC, n, line))
        iface, method, ret, params = (c.strip() for c in cells)
        if method == 'Release':
            raise SystemExit('tools/managed-areas: %s declares Release on %s; it is added, never listed'
                             % (SPEC, iface))
        if iface not in methods:
            order.append(iface)
            methods[iface] = []
        if any(m == method for m, _r, _p in methods[iface]):
            raise SystemExit('tools/managed-areas: %s declares %s::%s twice' % (SPEC, iface, method))
        methods[iface].append((method, ret, '' if params == 'void' else params))
    return [(i, methods[i]) for i in order]


def spec():
    return parse_spec(read(SPEC))


def short(iface):
    return iface[len('IManaged'):]


def model():
    """[(interface, [(method, return, parameters)])] for the server's managed-built AREAS."""
    return [a for a in spec() if a[0] not in CORE and a[0] not in CALLBACKS and not is_client(a[0])]


def client_model():
    """plan_client_vtables CD: the client's managed-built areas."""
    return [a for a in spec() if a[0] not in CORE and a[0] not in CALLBACKS and is_client(a[0])]


def callbacks():
    """The vphysics callbacks' managed sides, from the same spec. All must be declared."""
    found = [a for a in spec() if a[0] in CALLBACKS]
    missing = sorted(set(CALLBACKS) - set(i for i, _m in found))
    if missing:
        raise SystemExit('tools/managed-areas: %s declares no %s' % (SPEC, ', '.join(missing)))
    return found


def core():
    """The root and the runtime, from the same spec. Both must be declared."""
    found = [a for a in spec() if a[0] in CORE]
    missing = sorted(set(CORE) - set(i for i, _m in found))
    if missing:
        raise SystemExit('tools/managed-areas: %s declares no %s' % (SPEC, ', '.join(missing)))
    return found


def layout_fields(layouts_text, struct):
    """[(slot, [C# parameter types after self], C# return)] of a generated layout, or None."""
    m = re.search(r' unsafe struct %s\n\{(.*?)\n\}' % re.escape(struct), layouts_text, re.S)
    if not m:
        return None
    out = []
    for f in re.finditer(r'public delegate\* unmanaged(?:\[\w+\])?<([^;]*)>\s+(\w+);', m.group(1)):
        types = [t.strip() for t in split_top(f.group(1))]
        out.append((f.group(2), types[1:-1], types[-1]))
    return out


VALIDATE = 'int32_t Validate( const uint32_t *pSlotHashes, int32_t nSlots )'

# Every table starts with these two (plan_managed_vtable_reload.md L1b):
# Release frees the block, Validate answers whether its slots are the ones
# native was generated with.
OBJECT_SLOTS = [('Release', 'void', ''),
                ('Validate', 'int32_t', 'const uint32_t *pSlotHashes, int32_t nSlots')]


def table_slots(ss):
    """[(name, C return, C parameters, C# function-pointer type, hash)] for one
    managed-built table, Release and Validate first, then the TSV's methods in
    order. The C# type is a method's (`self` first), and the hash is FNV-1a over
    it (tools/vtable-layout's slot_hash), which native checks Validate against."""
    out = []
    for name, ret, params in OBJECT_SLOTS + list(ss):
        kind = VL.signature_of(ret, VL.normalise_signature(params) or 'void')
        out.append((name, ret, params, kind, VL.slot_hash('%s %s;' % (kind, name))))
    return out


def table_name(iface):
    """The C struct of the table managed writes for an interface: SSManagedFooTable."""
    return 'SS%sTable' % iface[1:]


def named_parameters(params):
    """[(declaration with a name, name)] for a TSV parameter list: a parameter
    the TSV gives no name is named a<N>, so the forwarder can pass it on."""
    out = []
    for n, part in enumerate(p.strip() for p in params.split(',') if p.strip()):
        bare = VL.normalise_parameter(part)
        if bare == ' '.join(re.sub(r'([*&])', r' \1 ', part).split()):
            part, name = '%s a%d' % (part, n), 'a%d' % n
        else:
            name = re.findall(r'[A-Za-z_]\w*', part)[-1]
        out.append((part, name))
    return out


def object_lines():
    """IManagedObject: the two slots every table managed writes starts with
    (plan_managed_vtable_reload.md L1b), and the one data member, word 0 of the
    block, which points at the table. NO VIRTUAL ANYWHERE
    (plan_forwarders_everywhere.md phase 4): native calls a managed-built object
    through the table managed wrote, in the order docs/managed-interfaces.tsv
    gives, never through a C++ vtable whose order would be the compiler's."""
    return ['// plan_managed_vtable_reload.md L1b, plan_forwarders_everywhere.md phase 4:',
            '// the base of every managed-built interface. Word 0 of the block managed',
            '// builds points at the table it wrote; every table starts with Release and',
            '// Validate, each handed the object.',
            'class IManagedObject;', '',
            'struct SSManagedObjectTable', '{',
            '\tvoid ( *Release )( IManagedObject *self );',
            '\tint32_t ( *Validate )( IManagedObject *self, const uint32_t *pSlotHashes, int32_t nSlots );',
            '};', '',
            'class IManagedObject', '{', 'public:',
            '\t// Native never builds one: managed does. A native test that fakes one',
            '\t// hands its own table here.',
            '\texplicit IManagedObject( const void *pTable ) : m_pTable( pTable ) {}', '',
            '\tvoid Release() { Object()->Release( this ); }',
            '\tint32_t Validate( const uint32_t *pSlotHashes, int32_t nSlots ) '
            '{ return Object()->Validate( this, pSlotHashes, nSlots ); }', '',
            'protected:',
            '\tconst void *m_pTable;', '',
            'private:',
            '\tconst SSManagedObjectTable *Object() const '
            '{ return static_cast< const SSManagedObjectTable * >( m_pTable ); }',
            '};', '']


def interface_lines(iface, ss):
    """One managed-built interface: its table, then a class with no virtual whose
    inline methods are this direction's forwarders, each calling its slot of the
    table managed wrote with the object first."""
    t = table_name(iface)
    out = ['class %s;' % iface, '',
           '// The table managed writes for %s: Release, Validate, then the TSV\'s order.' % iface,
           'struct %s' % t, '{',
           '\tvoid ( *Release )( IManagedObject *self );',
           '\tint32_t ( *Validate )( IManagedObject *self, const uint32_t *pSlotHashes, int32_t nSlots );']
    for name, ret, params in ss:
        decl = ''.join(', %s' % d for d, _n in named_parameters(params))
        out.append('\t%s ( *%s )( %s *self%s );' % (ret, name, iface, decl))
    out += ['};', '',
            'class %s : public IManagedObject' % iface, '{', 'public:',
            '\texplicit %s( const %s *pTable ) : IManagedObject( pTable ) {}' % (iface, t), '']
    for name, ret, params in ss:
        named = named_parameters(params)
        decl = ', '.join(d for d, _n in named)
        args = ''.join(', %s' % n for _d, n in named)
        head = '%s%s%s' % (ret, '' if ret.endswith('*') else ' ', name)
        out.append('\t%s(%s) { %sTable()->%s( this%s ); }'
                   % (head, ' %s ' % decl if decl else '', '' if ret == 'void' else 'return ', name, args))
    out += ['', 'private:',
            '\tconst %s *Table() const { return static_cast< const %s * >( m_pTable ); }' % (t, t),
            '};', '']
    return out


def hash_lines(iface, ss):
    """k<I>SlotHashes and k<I>SlotCount, from the TSV (table_slots), and the
    compiler's check that the table struct is one pointer per slot."""
    hashes = [h for *_x, h in table_slots(ss)]
    return ['static const uint32_t k%sSlotHashes[] = {' % iface] + \
           ['\t' + ' '.join('0x%08x,' % h for h in hashes[i:i + 8])
            for i in range(0, len(hashes), 8)] + \
           ['};', 'static const int32_t k%sSlotCount = %d;' % (iface, len(hashes)),
            'static_assert( sizeof( %s ) == %d * sizeof( void * ), "%s is one pointer per slot" );'
            % (table_name(iface), len(hashes), table_name(iface)), '']


def split_top(s):
    out, depth, cur = [], 0, ''
    for ch in s:
        if ch == '<':
            depth += 1
        elif ch == '>':
            depth -= 1
        if ch == ',' and depth == 0:
            out.append(cur)
            cur = ''
        else:
            cur += ch
    if cur.strip():
        out.append(cur)
    return out


def factory_lines(areas):
    """plan_client_vtables SI: the generated Create methods are internal to the
    interop assembly; this is the public door the game assembly builds each
    area's block through. Stateless."""
    m = ['/// <summary>Builds each managed-built area\'s block in a side\'s registry.</summary>',
         'public static class ManagedAreaFactory', '{']
    for i, _ss in areas:
        m.append('    public static ManagedVtable Create(ManagedVtables vtables, %s target)' % i)
        m.append('        => %s__ManagedVtable.Create(vtables, target);' % i)
    return m + ['}', '']


def csharp_table_name(iface):
    """The C# struct of an interface's table: ManagedFooTable."""
    return '%sTable' % iface[1:]


def table_file(iface):
    """Which C# file an interface's table goes in (TABLE_FILES)."""
    if iface in CALLBACKS:
        return OUT_TABLES if CALLBACKS[iface] == 'shared' else OUT_TABLES_SERVER
    if iface == 'IManagedRoot':
        return OUT_TABLES
    if is_client(iface) or iface == 'IManagedSteamCallback':
        return OUT_TABLES_CLIENT
    return OUT_TABLES_SERVER


def managed_tables(interfaces, path=OUT_TABLES):
    """One C# file of tables: one public struct per table managed writes, one
    function-pointer field per slot in the TSV's order, each with its hash."""
    out = [GENERATED, '//',
           '// The tables managed writes and native calls, in %s' % TABLE_FILES[path],
           '// (plan_forwarders_everywhere.md phase 4): Release, Validate, then each interface\'s methods in',
           '// docs/managed-interfaces.tsv\'s order. ManagedVtableGenerator fills each field',
           '// with a thunk and answers Validate from its [SlotHash], FNV-1a over the field\'s',
           '// type, which native checks against the same hashes in the C++ header',
           '// tools/managed-areas writes beside the table\'s struct. Native calls a slot',
           '// through that struct, never through a C++ vtable, so the order is the TSV\'s on',
           '// every ABI.', '',
           'using System.Runtime.InteropServices;', '',
           'namespace SourceSharp.Abi;']
    for iface, ss in interfaces:
        out += ['',
                '/// <summary>The table managed writes for <c>%s</c> (<c>%s</c> native-side).</summary>'
                % (iface, table_name(iface)),
                ('[ImplementedByManaged("%s", ReservedWords = %d)]' % (iface, CALLBACK_WORDS)
                 if iface in CALLBACKS else '[ImplementedByManaged("%s")]' % iface),
                '[StructLayout(LayoutKind.Sequential)]',
                'public unsafe struct %s' % csharp_table_name(iface), '{']
        for n, (name, ret, params, kind, h) in enumerate(table_slots(ss)):
            if n:
                out.append('')
            out.append('    // %d: %s %s( %s )' % (n, ret, name, params or 'void'))
            out.append('    [SlotHash(0x%08x)]' % h)
            out.append('    public %s %s;' % (kind, name))
        out.append('}')
    return '\n'.join(out + [''])


def generate():
    areas = model()
    valve = read(VALVE).rstrip('\n')

    # ---- the root and the runtime ---------------------------------------------
    def core_header(guard, purpose, includes, iface, ss, server_only, with_object=False):
        out = [valve, '', GENERATED, '//'] + ['// ' + l if l else '//' for l in purpose] + \
              ['', '#ifndef %s' % guard, '#define %s' % guard, '#pragma once', ''] + \
              ['#include %s' % inc for inc in includes] + ['']
        if server_only:
            out += ['#ifndef CLIENT_DLL', '']
        if with_object:
            out += object_lines()
        out += interface_lines(iface, ss) + hash_lines(iface, ss)
        if server_only:
            out += ['#endif // !CLIENT_DLL', '']
        return out + ['#endif // %s' % guard, '']

    cores = dict(core())
    k = core_header('IMANAGED_CORE_H',
                    ['plan_managed_vtable_reload.md L0b: IManagedObject, the base every',
                     'managed-built interface derives from, and IManagedRoot, the one object',
                     'LoadSideV2 hands native (both sides). IMPLEMENTED BY MANAGED: native calls',
                     'each through the table managed wrote, Release at slot 0 and Validate at 1.'],
                    ['<stdint.h>', '"tier0/platform.h"'], 'IManagedRoot', cores['IManagedRoot'], False,
                    with_object=True)
    r = core_header('IMANAGED_RUNTIME_H',
                    ['plan_managed_vtable_reload.md L0b: IManagedRuntimeServer, the shell game DLL\'s',
                     'calls into the mod (the server). IMPLEMENTED BY MANAGED, through its table:',
                     'Release is at slot 0 and Validate at 1; the map loads take the ABI\'s flat',
                     'SourceSharpMapLoad by pointer, and the stop is not a slot (DLLShutdown',
                     'unloads the managed side itself).'],
                    ['<stdint.h>', '"tier0/platform.h"', '"sourcesharp.h"', '"imanaged_core.h"'],
                    'IManagedRuntimeServer', cores['IManagedRuntimeServer'], True)
    st = core_header('IMANAGED_STEAM_CALLBACK_H',
                     ['plan_engine_forwarders.md section 6: one Steam callback\'s managed side.',
                      'libss_fwd_client builds the CCallbackBase Steam calls (fwd_steam.cpp), and its',
                      'overrides call this, through the table managed wrote: Release (0) and Validate',
                      '(1), which native never calls (managed releases the block after Steam has',
                      'let go), and Run, for both of CCallbackBase\'s Run overloads.'],
                     ['<stdint.h>', '"tier0/platform.h"', '"imanaged_core.h"'],
                     'IManagedSteamCallback', cores['IManagedSteamCallback'], False)
    cb = [valve, '', GENERATED, '//',
          '// plan_forwarders_everywhere.md phase 5: the managed side of each vphysics callback',
          '// (and of the IRecipientFilter EmitSound calls back, fwd_recipient_filter.cpp).',
          '// libss_fwd_<side> builds the object vphysics calls (fwd_physics.cpp), deriving',
          '// IPhysicsCollisionEvent and the rest, and its overrides call these through the',
          '// table managed wrote. The object lives in the block\'s %d reserved words after' % CALLBACK_WORDS,
          '// word 0, so it is the block\'s, across a reload too. Engine types cross as void *.',
          '', '#ifndef IMANAGED_PHYSICS_CALLBACKS_H', '#define IMANAGED_PHYSICS_CALLBACKS_H', '#pragma once', '',
          '#include <stdint.h>', '#include "tier0/platform.h"', '#include "imanaged_core.h"', '']
    for i, ss in callbacks():
        cb += interface_lines(i, ss) + hash_lines(i, ss)
    cb += ['// The words a block reserves for the object libss_fwd builds in it.',
           'static const int32_t kManagedPhysicsCallbackWords = %d;' % CALLBACK_WORDS, '',
           '#endif // IMANAGED_PHYSICS_CALLBACKS_H', '']

    # ---- the interfaces ------------------------------------------------------
    h = [valve, '', GENERATED, '//',
         '// plan_engineapi_vtables.md Phase E: the server\'s managed-built areas',
         '// (docs/managed-interfaces.tsv). IMPLEMENTED BY MANAGED --',
         '// ManagedVtableGenerator writes each table from SourceSharp.Server, and native',
         '// calls it through the C struct beside each class (plan_forwarders_everywhere.md',
         '// phase 4); Release is slot 0 and Validate slot 1, and native takes',
         '// an area only when Validate matches its k<I>SlotHashes (managed_accept.h).',
         '// Each is acquired again on every load and released before every unload,',
         '// so native keeps no pointer and calls through the accessor.',
         '', '#ifndef IMANAGED_AREAS_H', '#define IMANAGED_AREAS_H', '#pragma once', '',
         '#include <stdint.h>', '#include "tier0/platform.h"', '#include "sourcesharp.h"',
         '#include "imanaged_core.h"', '', '#ifndef CLIENT_DLL', '']
    for i, ss in areas:
        h += interface_lines(i, ss) + hash_lines(i, ss)
    for i, _ss in areas:
        h.append('%s *Managed%s();   // this load\'s area, or NULL outside a load' % (i, short(i)))
    h += ['', '#endif // !CLIENT_DLL', '', '#endif // IMANAGED_AREAS_H', '']

    # ---- the holder ----------------------------------------------------------
    c = [valve, '', GENERATED, '//',
         '// Everything native holds from managed: the root, the runtime and the areas.',
         '// plan_managed_vtable_reload.md L2: the game DLL object owns them',
         '// (CShellGameDll::m_Managed, shell_gamedll.cpp); there is no static of their own.',
         '// Plain pointers, no initialisers.', '',
         '#pragma once', '', '#include <stddef.h>', '#include "imanaged_areas.h"',
         '#include "imanaged_runtime.h"', '#include "imanaged_root.h"', '', '#ifndef CLIENT_DLL', '',
         'struct CManagedAreas', '{']
    c += ['\t%s *m_p%s;' % (i, short(i)) for i, _ss in areas] or ['\tint m_nUnused;   // no area is managed-built yet']
    c += ['};', '',
          'struct CManagedHolders', '{',
          '\tIManagedRoot *m_pRoot;',
          '\tIManagedRuntimeServer *m_pRuntimeServer;',
          '\tCManagedAreas m_Areas;', '};', '',
          '// The game DLL object\'s holders (shell_gamedll.cpp).',
          'CManagedHolders &ShellGameDll_Managed();', '',
          '// True when the root, the runtime and every area have been released.',
          'inline bool ManagedHolders_Empty( const CManagedHolders &holders )', '{']
    held = ['holders.m_pRoot', 'holders.m_pRuntimeServer'] + \
           ['holders.m_Areas.m_p%s' % short(i) for i, _ss in areas]
    c += ['\treturn !' + held[0]] + ['\t\t&& !%s' % x for x in held[1:-1]] + \
         ['\t\t&& !%s;' % held[-1], '}', '']
    c += [
          '// Every area from the root, each accepted through its Validate; false with the',
          '// reason on the first refusal.',
          'bool ManagedAreas_Acquire( CManagedAreas &areas, IManagedRoot *pRoot, char *pWhy, size_t nWhy );',
          '', '// After a reload (plan_managed_vtable_reload.md L4): every held area answers its',
          '// Validate through the patched block; false with the reason on the first that does not.',
          'bool ManagedAreas_Validate( const CManagedAreas &areas, char *pWhy, size_t nWhy );',
          '', '// Each area nulled, then released.',
          'void ManagedAreas_Release( CManagedAreas &areas );', '', '#endif // !CLIENT_DLL', '']

    # ---- the bodies ----------------------------------------------------------
    im = [valve, '', GENERATED, '//',
          '// Included at the end of shell_internalfactory.cpp. The areas live on the game DLL',
          '// object (ShellGameDll_Managed(), plan_managed_vtable_reload.md L2).', '',
          '#ifndef CLIENT_DLL', '',
          'bool ManagedAreas_Acquire( CManagedAreas &areas, IManagedRoot *pRoot, char *pWhy, size_t nWhy )',
          '{']
    if areas:
        im += ['\tvoid *pObject = NULL;', '']
    else:
        im += ['\t(void)areas;', '\t(void)pRoot;', '\t(void)pWhy;', '\t(void)nWhy;']
    for i, _ss in areas:
        im += ['\tpObject = pRoot->Acquire( "%s" );' % i,
               '\tareas.m_p%s = ManagedAccept< %s >( pObject, k%sSlotHashes, k%sSlotCount, pWhy, nWhy );'
               % (short(i), i, i, i),
               '\tif ( !areas.m_p%s )' % short(i),
               '\t\treturn false;', '']
    im += ['\treturn true;', '}', '',
           'bool ManagedAreas_Validate( const CManagedAreas &areas, char *pWhy, size_t nWhy )', '{']
    if not areas:
        im += ['\t(void)areas;', '\t(void)pWhy;', '\t(void)nWhy;']
    for i, _ss in areas:
        im += ['\tif ( !ManagedAcceptObject( areas.m_p%s, k%sSlotHashes, k%sSlotCount, pWhy, nWhy ) )'
               % (short(i), i, i),
               '\t\treturn false;']
    im += ['\treturn true;', '}', '',
           'void ManagedAreas_Release( CManagedAreas &areas )', '{']
    if not areas:
        im.append('\t(void)areas;')
    for i, _ss in areas:
        im.append('\tManagedRelease( areas.m_p%s );' % short(i))
    im += ['}', '']
    for i, _ss in areas:
        im += ['%s *Managed%s()' % (i, short(i)), '{',
               '\treturn ShellGameDll_Managed().m_Areas.m_p%s;' % short(i), '}', '']
    im += ['#endif // !CLIENT_DLL', '']

    # ---- the C# tables -------------------------------------------------------
    # Every table managed writes, from the same rows: what ManagedVtableGenerator
    # fills (each slot a thunk) and answers Validate from (each [SlotHash]).
    table_texts = {path: managed_tables([a for a in spec() if table_file(a[0]) == path], path)
                   for path in TABLE_FILES}
    tables = '\n'.join(table_texts.values())   # every struct, for typing the contracts

    # ---- the managed contracts -----------------------------------------------
    m = [GENERATED, '//',
         '// The contracts ManagedVtableGenerator builds each managed-built area from,',
         '// typed from its generated table (ManagedTables.g.cs) so a contract speaks its',
         '// slots\' exact types.',
         '// A binding implements one and is registered with ManagedBindings by name.',
         '', 'using SourceSharp.Abi;', '', 'namespace SourceSharp.Server.Interop;', '']
    for i, ss in areas:
        fields = layout_fields(tables, csharp_table_name(i))
        m += ['[ManagedVtable(typeof(%s))]' % csharp_table_name(i),
              'public unsafe interface %s' % i, '{']
        for name, ptypes, ret in fields:
            if name in ('Release', 'Validate'):
                continue
            m.append('    %s %s(%s);' % (ret, name, ', '.join('%s a%d' % (ty, k) for k, ty in enumerate(ptypes))))
        m += ['}', '']
    m += factory_lines(areas)

    out = {OUT_CORE: '\n'.join(k), OUT_RUNTIME: '\n'.join(r), OUT_STEAM: '\n'.join(st),
           OUT_CALLBACKS: '\n'.join(cb),
           OUT_IFACE: '\n'.join(h), OUT_HOLDER: '\n'.join(c), OUT_IMPL: '\n'.join(im),
           OUT_MANAGED: '\n'.join(m)}
    out.update(table_texts)
    out.update(client_outputs(valve, cores, tables))
    return out


def client_outputs(valve, cores, tables):
    """plan_client_vtables CD: the client's runtime, areas, holder, bodies and
    contracts, in files of their own (the server's are unchanged)."""
    areas = client_model()

    # ---- the runtime: declared unguarded, like the root ------------------------
    rc = [valve, '', GENERATED, '//',
          '// plan_client_vtables CD: IManagedRuntimeClient, the shell client DLL\'s calls into',
          '// the mod. IMPLEMENTED BY MANAGED, called through its table: Release is at slot 0',
          '// and Validate at 1 (IManagedObject). Declared on both sides so native tests see it;',
          '// only the client holds one (shell_managed_areas_client.h).', '',
          '#ifndef IMANAGED_RUNTIME_CLIENT_H', '#define IMANAGED_RUNTIME_CLIENT_H', '#pragma once', '',
          '#include <stdint.h>', '#include "tier0/platform.h"', '#include "imanaged_core.h"', '']
    rc += interface_lines('IManagedRuntimeClient', cores['IManagedRuntimeClient'])
    rc += hash_lines('IManagedRuntimeClient', cores['IManagedRuntimeClient'])
    rc += ['#endif // IMANAGED_RUNTIME_CLIENT_H', '']

    # ---- the areas -------------------------------------------------------------
    h = [valve, '', GENERATED, '//',
         '// plan_client_vtables CE: the client\'s managed-built areas (docs/managed-interfaces.tsv,',
         '// the interfaces named *Client). IMPLEMENTED BY MANAGED, as imanaged_areas.h. The',
         '// declarations are unguarded so native tests compile them; the accessors are the',
         '// client\'s.', '',
         '#ifndef IMANAGED_AREAS_CLIENT_H', '#define IMANAGED_AREAS_CLIENT_H', '#pragma once', '',
         '#include <stdint.h>', '#include "tier0/platform.h"', '#include "sourcesharp.h"',
         '#include "imanaged_core.h"', '']
    for i, ss in areas:
        h += interface_lines(i, ss) + hash_lines(i, ss)
    h += ['#ifdef CLIENT_DLL', '']
    for i, _ss in areas:
        h.append('%s *Managed%s();   // this load\'s area, or NULL outside a load' % (i, short(i)))
    h += ['', '#endif // CLIENT_DLL', '', '#endif // IMANAGED_AREAS_CLIENT_H', '']

    # ---- the holder ------------------------------------------------------------
    c = [valve, '', GENERATED, '//',
         '// Everything the client holds from managed: the root, its runtime and its areas,',
         '// owned by the client DLL object (CShellClientDLL::m_Managed, shell_clientdll.cpp),',
         '// as the server\'s are by CShellGameDll (plan_managed_vtable_reload.md L2).',
         '// Plain pointers, no initialisers.', '',
         '#pragma once', '', '#include <stddef.h>', '#include "imanaged_areas_client.h"',
         '#include "imanaged_runtime_client.h"', '#include "imanaged_root.h"', '', '#ifdef CLIENT_DLL', '',
         'struct CManagedAreasClient', '{']
    c += ['\t%s *m_p%s;' % (i, short(i)) for i, _ss in areas] or ['\tint m_nUnused;   // no client area is managed-built yet']
    c += ['};', '',
          'struct CManagedHoldersClient', '{',
          '\tIManagedRoot *m_pRoot;',
          '\tIManagedRuntimeClient *m_pRuntimeClient;',
          '\tCManagedAreasClient m_Areas;', '};', '',
          '// The client DLL object\'s holders (shell_clientdll.cpp).',
          'CManagedHoldersClient &ShellClientDll_Managed();', '',
          '// This load\'s runtime, or NULL outside a load (shell_internalfactory.cpp).',
          'IManagedRuntimeClient *ManagedRuntimeClient();', '',
          '// True when the root, the runtime and every area have been released.',
          'inline bool ManagedHoldersClient_Empty( const CManagedHoldersClient &holders )', '{']
    held = ['holders.m_pRoot', 'holders.m_pRuntimeClient'] + ['holders.m_Areas.m_p%s' % short(i) for i, _ss in areas]
    c += ['\treturn !' + held[0]] + ['\t\t&& !%s' % x for x in held[1:-1]] + ['\t\t&& !%s;' % held[-1], '}', '']
    c += ['bool ManagedAreasClient_Acquire( CManagedAreasClient &areas, IManagedRoot *pRoot, char *pWhy, size_t nWhy );',
          'bool ManagedAreasClient_Validate( const CManagedAreasClient &areas, char *pWhy, size_t nWhy );',
          'void ManagedAreasClient_Release( CManagedAreasClient &areas );', '', '#endif // CLIENT_DLL', '']

    # ---- the bodies --------------------------------------------------------------
    im = [valve, '', GENERATED, '//',
          '// plan_client_vtables CD: the client\'s areas, acquired, validated and released.',
          '// Included at the end of shell_internalfactory.cpp, client only.', '',
          'bool ManagedAreasClient_Acquire( CManagedAreasClient &areas, IManagedRoot *pRoot, char *pWhy, size_t nWhy )',
          '{']
    im += ['\tvoid *pObject = NULL;', ''] if areas else ['\t(void)areas;', '\t(void)pRoot;', '\t(void)pWhy;', '\t(void)nWhy;']
    for i, _ss in areas:
        im += ['\tpObject = pRoot->Acquire( "%s" );' % i,
               '\tareas.m_p%s = ManagedAccept< %s >( pObject, k%sSlotHashes, k%sSlotCount, pWhy, nWhy );' % (short(i), i, i, i),
               '\tif ( !areas.m_p%s )' % short(i), '\t\treturn false;', '']
    im += ['\treturn true;', '}', '',
           'bool ManagedAreasClient_Validate( const CManagedAreasClient &areas, char *pWhy, size_t nWhy )', '{']
    if not areas:
        im += ['\t(void)areas;', '\t(void)pWhy;', '\t(void)nWhy;']
    for i, _ss in areas:
        im += ['\tif ( !ManagedAcceptObject( areas.m_p%s, k%sSlotHashes, k%sSlotCount, pWhy, nWhy ) )' % (short(i), i, i),
               '\t\treturn false;']
    im += ['\treturn true;', '}', '', 'void ManagedAreasClient_Release( CManagedAreasClient &areas )', '{']
    if not areas:
        im.append('\t(void)areas;')
    for i, _ss in areas:
        im.append('\tManagedRelease( areas.m_p%s );' % short(i))
    im += ['}', '']
    for i, _ss in areas:
        im += ['%s *Managed%s()' % (i, short(i)), '{', '\treturn ShellClientDll_Managed().m_Areas.m_p%s;' % short(i), '}', '']

    # ---- the managed contracts ----------------------------------------------------
    m = [GENERATED, '//',
         '// The contracts ManagedVtableGenerator builds each of the client\'s managed-built',
         '// areas from (plan_client_vtables CE), typed from its generated table.',
         '', 'using SourceSharp.Abi;', '', 'namespace SourceSharp.Client.Interop;', '']
    for i, ss in areas:
        fields = layout_fields(tables, csharp_table_name(i))
        m += ['[ManagedVtable(typeof(%s))]' % csharp_table_name(i), 'public unsafe interface %s' % i, '{']
        for name, ptypes, ret in fields:
            if name in ('Release', 'Validate'):
                continue
            m.append('    %s %s(%s);' % (ret, name, ', '.join('%s a%d' % (ty, k) for k, ty in enumerate(ptypes))))
        m += ['}', '']

    m += factory_lines(areas)

    return {OUT_RUNTIME_CLIENT: '\n'.join(rc), OUT_IFACE_CLIENT: '\n'.join(h), OUT_HOLDER_CLIENT: '\n'.join(c),
            OUT_IMPL_CLIENT: '\n'.join(im), OUT_MANAGED_CLIENT: '\n'.join(m)}


def self_test():
    arms = []

    def expect(name, cond):
        arms.append(bool(cond))
        print('  %-4s %s' % ('ok' if cond else 'FAIL', name))

    def refuses(text):
        try:
            parse_spec(text)
            return False
        except SystemExit:
            return True

    head = 'interface\tmethod\treturn\tparameters\n'
    parsed = parse_spec('# a comment\n' + head + 'IA\tA\tvoid\tconst char *p\nIA\tB\tint32_t\tvoid\n'
                        'IB\tC\tvoid\tvoid\n')
    expect('rows group by interface in first-appearance order, methods in slot order',
           parsed == [('IA', [('A', 'void', 'const char *p'), ('B', 'int32_t', '')]),
                      ('IB', [('C', 'void', '')])])
    expect('a spec without its header row is refused', refuses('IA\tA\tvoid\tvoid\n'))
    expect('a row that is not four cells is refused', refuses(head + 'IA\tA\tvoid\n'))
    expect('Release is never a row: it is added last', refuses(head + 'IA\tRelease\tvoid\tvoid\n'))
    expect('a method declared twice is refused', refuses(head + 'IA\tA\tvoid\tvoid\nIA\tA\tvoid\tvoid\n'))

    fields = layout_fields('public unsafe struct ManagedXVtbl\n{\n'
                           '    public delegate* unmanaged<void*, byte*, int> A; // 0\n'
                           '    public delegate* unmanaged<void*, void> Release; // 1\n}',
                           'ManagedXVtbl')
    expect('a layout field keeps its types after self', fields == [('A', ['byte*'], 'int'), ('Release', [], 'void')])

    real = globals()['spec']
    try:
        globals()['spec'] = lambda: [i for i in real() if i[0] == 'IManagedSoundEnt' or i[0] in CORE or i[0] in CALLBACKS]
        out = generate()
    finally:
        globals()['spec'] = real
    iface = out[OUT_IFACE]
    sound_ent = iface[iface.index('class IManagedSoundEnt : public IManagedObject'):]
    sound_ent = sound_ent[:sound_ent.index('};')]
    table = iface[iface.index('struct SSManagedSoundEntTable'):]
    table = table[:table.index('};')]
    expect('an interface derives from IManagedObject, which holds Release (slot 0) and Validate (slot 1)',
           sound_ent.startswith('class IManagedSoundEnt : public IManagedObject\n{\npublic:\n'))
    expect('an interface does not redeclare the base\'s two slots',
           'Release' not in sound_ent and 'Validate' not in sound_ent)
    # plan_forwarders_everywhere.md phase 4: no virtual anywhere. Native calls
    # each slot of the table managed wrote, in the TSV's order, the object first.
    expect('no interface declares a virtual: native calls the table, never a C++ vtable',
           'virtual' not in iface and 'abstract_class' not in iface
           and 'virtual' not in out[OUT_CORE] + out[OUT_RUNTIME] + out[OUT_STEAM])
    expect('a table starts with Release and Validate, each handed the base, then the TSV\'s slots',
           table.index('( *Release )( IManagedObject *self )')
           < table.index('( *Validate )( IManagedObject *self,')
           < table.index('( *ServerSoundEntInit )( IManagedSoundEnt *self, int32_t nMaxClients, float flCurTime )')
           < table.index('( *ServerSoundEntShutdown )( IManagedSoundEnt *self )'))
    expect('a method calls its slot of the table with the object first and its arguments in order',
           '\tvoid ServerSoundEntInit( int32_t nMaxClients, float flCurTime ) '
           '{ Table()->ServerSoundEntInit( this, nMaxClients, flCurTime ); }' in sound_ent)
    expect('a returning method returns its slot\'s answer, and a parameter the TSV leaves unnamed is named',
           named_parameters('int32_t, const char *pName') == [('int32_t a0', 'a0'), ('const char *pName', 'pName')])
    expect('the table struct is held to one pointer per slot by the compiler',
           'static_assert( sizeof( SSManagedSoundEntTable ) == 6 * sizeof( void * )' in iface)
    tables = out[OUT_TABLES_SERVER]
    expect('each table is in the assembly that builds it: the root in the shared interop, a server area in '
           'Server.Interop, a client area and the Steam callback in Client.Interop',
           'struct ManagedRootTable' in out[OUT_TABLES] and 'struct ManagedSoundEntTable' not in out[OUT_TABLES]
           and table_file('IManagedRuntimeServer') == OUT_TABLES_SERVER
           and table_file('IManagedSteamCallback') == OUT_TABLES_CLIENT
           and table_file('IManagedHudClient') == OUT_TABLES_CLIENT)
    expect('the C# table carries the same order and each slot\'s hash, as ManagedVtableGenerator reads it',
           '[ImplementedByManaged("IManagedSoundEnt")]' in tables
           and 'public unsafe struct ManagedSoundEntTable' in tables
           and tables.index('public delegate* unmanaged<void*, void> Release;')
           < tables.index(' ServerSoundEntInit;'))
    expect('the areas header sees the base it derives from',
           '#include "imanaged_core.h"' in out[OUT_IFACE])
    expect('its compiled slot hashes and count are emitted, one per slot',
           'static const uint32_t kIManagedSoundEntSlotHashes[]' in out[OUT_IFACE]
           and 'static const int32_t kIManagedSoundEntSlotCount = 6;' in out[OUT_IFACE])
    expect('no virtual destructor is emitted', '~' not in out[OUT_IFACE])
    expect('it is accepted through Validate, against its compiled hashes',
           'ManagedAccept< IManagedSoundEnt >( pObject, kIManagedSoundEntSlotHashes, '
           'kIManagedSoundEntSlotCount, pWhy, nWhy )' in out[OUT_IMPL])
    expect('it is released through the base, which nulls the holder first (managed_accept.h)',
           '\tManagedRelease( areas.m_pSoundEnt );' in out[OUT_IMPL])
    # plan_managed_vtable_reload.md L2: the game DLL object owns the holders.
    expect('the holders are one struct: the root, the runtime and the areas',
           'struct CManagedHolders\n{\n\tIManagedRoot *m_pRoot;\n\tIManagedRuntimeServer *m_pRuntimeServer;\n'
           '\tCManagedAreas m_Areas;\n};' in out[OUT_HOLDER])
    expect('an area\'s accessor reads the game DLL object\'s holders, not a static',
           'IManagedSoundEnt *ManagedSoundEnt()\n{\n\treturn ShellGameDll_Managed().m_Areas.m_pSoundEnt;\n}'
           in out[OUT_IMPL] and 'g_ShimRoot' not in out[OUT_IMPL])
    expect('the emptiness check names the area too',
           '\t\t&& !holders.m_Areas.m_pSoundEnt' in out[OUT_HOLDER])

    # A row edited by hand reaches the output: the check this tool runs in the
    # runner leg must see it, or the spec is not what the headers say.
    def edited():
        areas = real()
        k = next(n for n, (i, _ms) in enumerate(areas) if i not in CORE)
        i, ms = areas[k]
        name, ret, params = ms[0]
        changed = (i, [(name, ret, (params + ', int32_t nExtra') if params else 'int32_t nExtra')] + ms[1:])
        return areas[:k] + [changed] + areas[k + 1:]
    expect('a spec row changed by hand changes the generated header', edited_differs(edited, real))

    out = generate()
    expect('the root and the runtime are declared in their own headers, not as areas',
           'class IManagedRoot : public IManagedObject' in out[OUT_CORE]
           and 'class IManagedRuntimeServer : public IManagedObject' in out[OUT_RUNTIME]
           and 'IManagedRuntimeServer' not in out[OUT_IFACE]
           and 'IManagedRoot\n' not in out[OUT_IFACE])
    expect('the runtime is the server\'s only and takes the ABI header; the root is neither',
           out[OUT_RUNTIME].index('#ifndef CLIENT_DLL') < out[OUT_RUNTIME].index('class IManagedRuntimeServer : public')
           and '"sourcesharp.h"' in out[OUT_RUNTIME]
           and 'CLIENT_DLL' not in out[OUT_CORE] and 'sourcesharp.h' not in out[OUT_CORE])
    try:
        globals()['spec'] = lambda: [a for a in real() if a[0] != 'IManagedRoot']
        core()
        refused = False
    except SystemExit:
        refused = True
    finally:
        globals()['spec'] = real
    expect('a spec without the root is refused, not generated without it', refused)
    # plan_client_vtables CD: the client's side, in files of its own.
    expect('the client runtime is declared unguarded beside its hashes',
           'class IManagedRuntimeClient : public IManagedObject' in out[OUT_RUNTIME_CLIENT]
           and 'kIManagedRuntimeClientSlotCount' in out[OUT_RUNTIME_CLIENT]
           and 'CLIENT_DLL' not in out[OUT_RUNTIME_CLIENT])
    expect('the client holder is the client DLL object\'s, client-only',
           'CManagedHoldersClient &ShellClientDll_Managed();' in out[OUT_HOLDER_CLIENT]
           and out[OUT_HOLDER_CLIENT].index('#ifdef CLIENT_DLL') < out[OUT_HOLDER_CLIENT].index('struct CManagedHoldersClient'))
    expect('no client interface reaches the server\'s files',
           not any(is_client(i) for i, _ss in model()) and any(i == 'IManagedClients' for i, _ss in model())
           and 'IManagedRuntimeClient' not in out[OUT_IFACE] + out[OUT_HOLDER] + out[OUT_IMPL] + out[OUT_MANAGED])

    # The vphysics callbacks (plan_forwarders_everywhere.md phase 5): managed
    # tables like the areas, but no area holds them -- libss_fwd builds the
    # Valve object in each block's reserved words -- so they have a header of
    # their own and reserve exactly the words that object takes.
    cb = out[OUT_CALLBACKS]
    expect('every vphysics callback is declared in its own header and in no area header',
           all('class %s : public IManagedObject' % i in cb and 'class %s ' % i not in out[OUT_IFACE]
               for i in CALLBACKS)
           and not any(i in CALLBACKS for i, _ss in model() + client_model()))
    expect('each callback\'s C# table reserves the object\'s words, and no area\'s does',
           all('[ImplementedByManaged("%s", ReservedWords = %d)]' % (i, CALLBACK_WORDS)
               in out[table_file(i)] for i in CALLBACKS)
           and 'ReservedWords' not in out[OUT_TABLES_CLIENT]
           and '[ImplementedByManaged("IManagedSoundEnt")]' in out[OUT_TABLES_SERVER])
    expect('a callback\'s table is in the assembly that builds it: shared ones in the shared interop, '
           'the server\'s motion controller in Server.Interop',
           table_file('IManagedVPhysicsKeyHandler') == OUT_TABLES
           and table_file('IManagedMotionEvent') == OUT_TABLES_SERVER)
    expect('the header hands native the reserved word count it builds the object in',
           'static const int32_t kManagedPhysicsCallbackWords = %d;' % CALLBACK_WORDS in cb)
    g = globals()
    saved = g['CALLBACKS']
    try:
        g['CALLBACKS'] = dict(saved, IManagedNoSuchCallback='shared')
        refused = False
        try:
            callbacks()
        except SystemExit:
            refused = True
    finally:
        g['CALLBACKS'] = saved
    expect('a callback the TSV does not declare is refused, not generated without it', refused)
    print('\n%d arm(s), %d failed.' % (len(arms), arms.count(False)))
    return 0 if all(arms) else 1


def edited_differs(edited, real):
    """Whether generate() over `edited` writes a different interface header than over `real`."""
    g = globals()
    try:
        g['spec'] = edited
        a = generate()[OUT_IFACE]
        g['spec'] = real
        b = generate()[OUT_IFACE]
    finally:
        g['spec'] = real
    return a != b and 'int32_t nExtra' in a


def main(argv):
    if '--self-test' in argv:
        return self_test()
    out = generate()
    if '--write' in argv:
        for rel, text in out.items():
            with open(os.path.join(ROOT, rel), 'w') as f:
                f.write(text)
            print('wrote %s' % rel)
        return 0
    stale = [rel for rel, text in out.items()
             if not os.path.exists(os.path.join(ROOT, rel)) or read(rel) != text]
    if stale:
        print('tools/managed-areas: stale: %s -- run `tools/managed-areas --write` and read the diff'
              % ', '.join(stale))
        return 1
    print('tools/managed-areas: %d generated file(s) are what the inputs say (%d area(s)).'
          % (len(out), len(model())))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))

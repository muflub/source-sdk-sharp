#!/usr/bin/env python3
"""tools/managed-areas -- the server's ManagedApi areas as managed-built interfaces.

    tools/managed-areas            check the generated files are what the inputs say
    tools/managed-areas --write    write them
    tools/managed-areas --self-test

    exit 0   they are current
    exit 1   they are not -- run --write and read the diff

plan_engineapi_vtables.md Phase E, the reverse of tools/shim-areas. Its ONE
input is docs/managed-interfaces.tsv (plan_managed_vtable_reload.md L0): every
managed-built interface native calls, one row per method in slot order, with
the C return type and parameters. It used to read the ManagedApi slot
signatures in sourcesharp.h, grouped by docs/engineapi-areas.tsv and listed by
docs/managedapi-switched.txt; E-last deletes those signatures, so the
interfaces are declared here instead. From the spec this writes:

  src/shared/native/imanaged_areas.h      per interface, the C struct of the table
                                          managed writes (Release, Validate, then
                                          the TSV's slots) and a class with NO
                                          VIRTUAL whose inline methods call it,
                                          the object first; k<I>SlotHashes; the
                                          accessor native calls each through
                                          (plan_forwarders_everywhere.md phase 4)
  src/shared/native/imanaged_core.h, imanaged_runtime*.h, and
  src/fwd/native/imanaged_steam_callback.h   the same, for the root, the
                                          runtimes and the Steam callback's
                                          managed side, which are not areas
  src/shared/native/shell_managed_areas.h CManagedAreas, the pointers the shim
                                          root holds by value
  src/shared/native/shell_managed_areas.inc  acquiring each from the managed
                                          root (accepted through its Validate,
                                          managed_accept.h), releasing each, and
                                          the accessors; included by
                                          shell_internalfactory.cpp
  src/shared/interop/SharedManagedTables.g.cs, src/server/interop/ServerManagedTables.g.cs,
  src/client/interop/ClientManagedTables.g.cs   each table as C#, with each
                                          slot's hash, in the assembly whose code
                                          builds it
  src/{server,client}/interop/ManagedAreas.g.cs   the C# contracts
                                          ManagedVtableGenerator builds the tables
                                          from, typed from those structs

ONE PASS: the C side, the C# side and the hashes all come from the TSV here,
typed and hashed with tools/vtable-layout's signature_of and slot_hash, so
nothing is read back from a generated file.
"""

import csv
import importlib.machinery
import importlib.util
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def _load_vtable_layout():
    """tools/vtable-layout as a module, for its C# typing of a C signature
    (signature_of) and its slot hash (slot_hash): one definition of each, so a
    table this writes types and hashes its slots exactly as every other
    generated table does."""
    here = os.path.dirname(os.path.abspath(__file__))
    loader = importlib.machinery.SourceFileLoader('vtable_layout', os.path.join(here, 'vtable-layout'))
    spec_ = importlib.util.spec_from_loader('vtable_layout', loader)
    module = importlib.util.module_from_spec(spec_)
    loader.exec_module(module)
    return module


VL = _load_vtable_layout()

SPEC = 'docs/managed-interfaces.tsv'
VALVE = 'tools/valve-header.txt'

OUT_IFACE = 'src/shared/native/imanaged_areas.h'
OUT_CORE = 'src/shared/native/imanaged_core.h'
OUT_RUNTIME = 'src/shared/native/imanaged_runtime.h'
OUT_HOLDER = 'src/shared/native/shell_managed_areas.h'
OUT_IMPL = 'src/shared/native/shell_managed_areas.inc'

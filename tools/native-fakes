#!/usr/bin/env python3
"""tools/native-fakes -- default-answering C++ fakes of engine interfaces, for gtests.

    tools/native-fakes              check the generated fakes are what the headers say
    tools/native-fakes --write      write them
    tools/native-fakes --self-test

    exit 0   they are current
    exit 1   they are not -- run --write and read the diff
    exit 2   a header could not be read, or an interface is not in it

plan_server_native_v2 T6 part 3: a server subsystem takes the engine
interfaces it calls by constructor, so its gtest hands it a fake. A fake
here overrides every pure virtual of the interface: void methods do nothing,
a method returning a reference answers a default object it owns, and every
other method answers a value-initialised result. A test derives from the
fake and overrides only the methods its subject calls.

Each declaration is copied from the header as written (its parameters,
defaults and const), so a header change regenerates the fake and a stale fake
fails here, not as a compile error in some test.
"""

import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
VALVE = 'tools/valve-header.txt'
GENERATED = '// GENERATED by `tools/native-fakes --write`. DO NOT EDIT.'

# (interface, header it is declared in, header to include, generated file)
FAKES = [
    ('IVEngineServer', 'vendor/shared/public/eiface.h', 'eiface.h',
     'src/test/native/fakes/fake_engine_server.g.h'),
    ('IVDebugOverlay', 'vendor/shared/public/engine/ivdebugoverlay.h', 'engine/ivdebugoverlay.h',
     'src/test/native/fakes/fake_debug_overlay.g.h'),
    ('INetChannel', 'vendor/shared/public/inetchannel.h', 'inetchannel.h',
     'src/test/native/fakes/fake_net_channel.g.h', {'INetChannelInfo': 'vendor/shared/public/inetchannelinfo.h'}),
    ('IMDLCache', 'vendor/shared/public/datacache/imdlcache.h', 'datacache/imdlcache.h',
     'src/test/native/fakes/fake_mdl_cache.g.h', {'IAppSystem': 'vendor/shared/public/appframework/IAppSystem.h'}),
    ('ICollideable', 'vendor/shared/public/engine/ICollideable.h', 'engine/ICollideable.h',
     'src/test/native/fakes/fake_collideable.g.h'),
    ('IServerEntity', 'vendor/shared/public/iserverentity.h', 'iserverentity.h',
     'src/test/native/fakes/fake_server_entity.g.h', {'IServerUnknown': 'vendor/shared/public/iserverunknown.h',
                                                      'IHandleEntity': 'vendor/shared/public/ihandleentity.h'}),
]


class Refusal(Exception):
    pass


def read(rel):
    with open(os.path.join(ROOT, rel)) as f:
        return f.read()


def strip_comments(text):
    text = re.sub(r'/\*.*?\*/', ' ', text, flags=re.S)
    return re.sub(r'//[^\n]*', '', text)


def pure_virtuals(header_text, iface):
    """The interface's pure virtual declarations, each as one line without its
    `virtual` and `= 0;`, in declaration order."""
    code = strip_comments(header_text)
    head = re.search(r'^\s*(?:abstract_class|class)\s+%s\b[^;{]*\{' % re.escape(iface), code, re.M)
    if not head:
        raise Refusal('%s is not declared in its header' % iface)
    depth, i = 1, head.end()
    while depth and i < len(code):
        depth += {'{': 1, '}': -1}.get(code[i], 0)
        i += 1
    body = code[head.end():i - 1]
    # An inline body ends a declaration as a ';' does: `~IFoo() {} virtual void Bar() = 0;`.
    while True:
        flat = re.sub(r'\{[^{}]*\}', ';', body)
        if flat == body:
            break
        body = flat
    out = []
    for stmt in body.split(';'):
        stmt = ' '.join(stmt.split())
        m = re.match(r'(?:public:|protected:|private:|\s)*virtual\s+(.*\))\s*(const\s*)?=\s*0$', stmt)
        if m:
            out.append((m.group(1) + (' const' if m.group(2) else '')).strip())
    if not out:
        raise Refusal('%s declares no pure virtual' % iface)
    return out


def bases_of(header_text, iface):
    """The public bases an interface names in its head, in order."""
    code = strip_comments(header_text)
    head = re.search(r'^\s*(?:abstract_class|class)\s+%s\b([^;{]*)\{' % re.escape(iface), code, re.M)
    if not head or ':' not in head.group(1):
        return []
    return re.findall(r'public\s+(\w+)', head.group(1))


def chain_virtuals(iface, header, base_headers):
    """Every pure virtual a fake of iface must override: its bases' first (each found
    in base_headers, by name), then its own, each once."""
    text = read(header)
    out = []
    for base in bases_of(text, iface):
        if base not in base_headers:
            raise Refusal('%s derives from %s, which no base header is named for' % (iface, base))
        out += chain_virtuals(base, base_headers[base], base_headers)
    for d in pure_virtuals(text, iface):
        if d not in out:
            out.append(d)
    return out


def return_type(decl):
    """The return type of `RET Name( ... )[ const]`: the text before the name."""
    m = re.match(r'(.*?)\b(\w+)\s*\(', decl)
    if not m:
        raise Refusal('cannot read a return type from: %s' % decl)
    return m.group(1).strip()


def body_of(decl):
    ret = return_type(decl)
    if ret == 'void':
        return '{}'
    if ret.endswith('&'):
        return '{ static std::remove_cv_t<std::remove_reference_t<%s>> s_Default; return s_Default; }' % ret
    return '{ return {}; }'


def generate_one(iface, header, include, base_headers=None):
    valve = read(VALVE).rstrip('\n')
    decls = chain_virtuals(iface, header, base_headers or {})
    name = 'CFake' + iface[1:]
    out = [valve, '', GENERATED, '//',
           '// %s with every pure virtual answering a default; a test derives from it' % iface,
           '// and overrides what its subject calls.', '',
           '#pragma once', '', '#include <type_traits>', '', '#include "%s"' % include, '',
           'class %s : public %s' % (name, iface), '{', 'public:']
    for d in decls:
        out.append('\t%s override %s' % (d, body_of(d)))
    out += ['};', '']
    return '\n'.join(out)


def formatted(text, name):
    """What tools/clang-format makes of a native file this writes."""
    import importlib.machinery
    cf = importlib.machinery.SourceFileLoader(
        'clang_format_tool', os.path.join(ROOT, 'tools', 'clang-format')).load_module()
    return cf.format_text(text, name)


def generate():
    return {row[3]: formatted(generate_one(row[0], row[1], row[2], row[4] if len(row) > 4 else None), row[3])
            for row in FAKES}


def self_test():
    arms = []

    def expect(name, cond):
        arms.append(bool(cond))
        print('  %-4s %s' % ('ok' if cond else 'FAIL', name))

    toy = '''
    abstract_class IToy
    {
    public:
        // virtual int Commented() = 0;
        virtual void Ping() = 0;
        virtual int Count( int a,
                           bool b = false ) const = 0;
        virtual const Vector &Where() = 0;
        virtual void Say( const char *fmt, ... ) = 0;
        virtual void NotPure() {}
        int NotVirtual();
        virtual ~IToy() {}
        virtual void AfterAnInlineBody() = 0;
    };
    class IOther { public: virtual void Ping() = 0; };
    '''
    decls = pure_virtuals(toy, 'IToy')
    expect('every pure virtual is read, in order, and nothing else',
           decls == ['void Ping()', 'int Count( int a, bool b = false ) const',
                     'const Vector &Where()', 'void Say( const char *fmt, ... )',
                     'void AfterAnInlineBody()'])
    expect('a void method does nothing', body_of('void Ping()') == '{}')
    expect('a value method answers a value-initialised result',
           body_of('int Count( int a, bool b = false ) const') == '{ return {}; }')
    expect('a reference method answers an object it owns',
           'static std::remove_cv_t<std::remove_reference_t<const Vector &>> s_Default'
           in body_of('const Vector &Where()'))
    try:
        pure_virtuals(toy, 'IMissing')
        expect('an interface not in the header is refused', False)
    except Refusal:
        expect('an interface not in the header is refused', True)
    engine = generate_one(*FAKES[0][:3])
    expect('a fake overrides its bases\' pure virtuals too (INetChannel over INetChannelInfo)',
           sorted(chain_virtuals('INetChannel', FAKES[2][1], FAKES[2][4]))
           == sorted(set(pure_virtuals(read(FAKES[2][1]), 'INetChannel'))
                     | set(pure_virtuals(read(FAKES[2][4]['INetChannelInfo']), 'INetChannelInfo'))))
    try:
        chain_virtuals('INetChannel', FAKES[2][1], {})
        expect('a base with no header named is refused', False)
    except Refusal:
        expect('a base with no header named is refused', True)
    expect('the engine fake overrides IVEngineServer\'s 124 pure virtuals',
           engine.count(' override ') == 124)
    expect('the engine fake keeps const and defaults as declared',
           'bool IsModelPrecached( char const *s ) const override { return {}; }' in engine
           and 'int PrecacheModel( const char *s, bool preload = false ) override { return {}; }' in engine)
    print('\n%d arm(s), %d failed.' % (len(arms), arms.count(False)))
    return 0 if all(arms) else 1


def main(argv):
    if '--self-test' in argv:
        return self_test()
    try:
        gen = generate()
    except (Refusal, OSError) as e:
        print('tools/native-fakes: %s' % e)
        return 2
    stale = []
    for path, text in gen.items():
        full = os.path.join(ROOT, path)
        if '--write' in argv:
            os.makedirs(os.path.dirname(full), exist_ok=True)
            with open(full, 'w') as f:
                f.write(text)
        elif not os.path.exists(full) or open(full).read() != text:
            stale.append(path)
    if stale:
        print('tools/native-fakes: stale: %s -- run `tools/native-fakes --write` and read the diff'
              % ', '.join(stale))
        return 1
    print('tools/native-fakes: %d fake(s) are what the headers say.' % len(gen))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))

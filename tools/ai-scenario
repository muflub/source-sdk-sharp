#!/usr/bin/env python3
"""Run one of the AI's purpose-built test maps' scenarios (plan_hl2mp_ai §6.6).

  tools/ai-scenario sight   [--config debug] [--keep]
  tools/ai-scenario hearing [--config debug] [--keep]
  tools/ai-scenario duel|routes|nav [--config debug] [--keep]
  tools/ai-scenario jank [--minutes 5] [--streaks 0|1] [--preset hard] [--config debug] [--keep]   (`make ai-jank`)
  tools/ai-scenario live [--config debug] [--keep]
  tools/ai-scenario traits [--minutes 5] [--points 50|35|20] [--config debug] [--keep]
  tools/ai-scenario habit [--minutes 5] [--config debug] [--keep]
  tools/ai-scenario prefire [--trials 30] [--skills skills=a,b,...] [--config debug] [--keep]
  tools/ai-scenario camp [--minutes 5] [--config debug] [--keep]
  tools/ai-scenario spectator [--config debug] [--keep]

Starts a headless game on the map (`make headless`, its own instance, temp
dir, dev-API directory and port), records the AI session (`ai_record`), adds
the scenario's bots, places them with the dev API's teleport, drives the
scripted target through the bots' own command path (`ai_bot_act`,
`ai_bot_drive`), stops the recording, and writes

  src/ai/tests/recordings/<map>.airec   the session: bots, events, snapshots
  src/ai/tests/recordings/<map>.json    the scenes (tick windows and what each
                                        expects), the hearing truth lines, the
                                        map source's sha256 and ai.sense.us

which the scenario facts replay (SsAiScenarioTests). The map is per-tree
build output: `make map MAP=ss_ai_<name>` first; a missing map is a failure.
The game is killed by its PID at the end (--keep leaves it up).

`jank` is the standard run of the jank score (plan_hl2mp_ai §3.4.5), not a map
scenario: dm_lockdown (`make ai-nav`), four bots of mixed presets and a scripted
client, recorded for the minutes asked, scored with `tools/ai-replay jank`. It
writes bin/<config>/ai-jank/<utc>-<sha>.airec and its report beside it, never
into the tree's recordings.

`live` makes the committed live session again, after a change to what the brains
decide: dm_lockdown, the four bots of LiveRecordingTests, 2,400 ticks on the pool
beside an idle human, to src/ai/tests/recordings/live/dm_lockdown-4bots.airec.

`traits` and `habit` show personality live (plan_hl2mp_ai §5.5). `traits`: two
campers and two chasers of one point total (--points: Hard's 50, Medium's 35 or
Easy's 20) with a scripted client, scored as `jank` is. `habit`: the listen client stands at one spot and is put back there
when it dies, among high-Cunning bots: what each bot did about it, sampled from
its inspector record, first half against second, with the moment lines.

`prefire` (plan_hl2mp_ai §5.4): on ss_ai_sight a god-mode scripted client stands in
the open until the bot has it, then is gone behind a wall (teleported, a duck behind
a corner with no walk to watch), and every third trial comes back during the burst.
`camp` (§5.5): dm_lockdown, four bots of high Cunning and Cover at 50 points and a
scripted client. Both are read with `tools/ai-replay tactics`, which they call.
`spectator` (§4.1, ruling 2026-11-02): the client plays until a bot knows it, goes to
spectate, is flown through the bots, then comes back: while it watches no bot may list it,
be about it or hit it; back in play one must take it up. Exit 1 if any fails.
"""
import collections
import hashlib
import json
import os
import random
import re
import signal
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEBUG_API = os.path.join(ROOT, "tools", "debug-api")
USER = os.environ.get("USER", "ss")


def sha256(path):
    with open(path, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


class Game:
    def __init__(self, map_name, config):
        self.map = map_name
        self.config = config
        self.api_dir = os.environ.get("AI_SCENARIO_API_DIR", "/tmp/ss-ais-%s" % USER)
        self.tmp = os.environ.get("AI_SCENARIO_TMPDIR", "/tmp/ss-ais-tmp-%s" % USER)
        self.port = os.environ.get("AI_SCENARIO_PORT", "27265")
        os.makedirs(self.api_dir, exist_ok=True)
        os.makedirs(self.tmp, exist_ok=True)
        self.pid = None
        self.console = None
        self.mark = 0

    def start(self):
        before = set(os.listdir(self.api_dir))
        env = dict(os.environ, DEBUG_API_DIR=self.api_dir, DEBUG_API_UI_PORT=str(int(self.port) + 1), TMPDIR=self.tmp)
        args = "$(RUN_ARGS) -assertlog -port %s +maxplayers 8 +sv_cheats 1" % self.port
        self.log = open(os.path.join(self.tmp, "ai-scenario-%s.log" % self.map), "w")
        self.make = subprocess.Popen(["make", "-C", ROOT, "headless", "CONFIG=" + self.config, "MAP=" + self.map, "HEADLESS_ARGS=" + args],
                                     env=env, stdout=self.log, stderr=subprocess.STDOUT)
        deadline = time.time() + 600
        while time.time() < deadline:
            if self.make.poll() is not None:
                raise SystemExit("ai-scenario: the game exited (rc %s): see %s" % (self.make.returncode, self.log.name))
            new = [s for s in set(os.listdir(self.api_dir)) - before if s.endswith(".sock")]
            if new:
                self.pid = int(new[0].split(".")[0])
                break
            time.sleep(1)
        if self.pid is None:
            raise SystemExit("ai-scenario: no dev-API socket in %s" % self.api_dir)
        cmd = open("/proc/%d/cmdline" % self.pid, "rb").read().split(b"\0")
        game_dir = cmd[cmd.index(b"-game") + 1].decode()
        self.console = os.path.join(game_dir, "console.log")
        # The console log is appended to by every game of this tree (the
        # instance links it), so this run's lines are those after its size
        # now, when this game has its socket and has not loaded the map: an
        # earlier game's lines are no truth of this one.
        try:
            self.mark = os.path.getsize(self.console)
        except FileNotFoundError:
            self.mark = 0
        self.wait_for(r"\[SourceSharp/Ai\] %s: the bots know" % re.escape(self.map), 300)
        self.wait_for(r"client 1 active", 300)

    def lines(self):
        try:
            with open(self.console, "rb") as f:
                f.seek(self.mark)
                return f.read().decode(errors="replace").splitlines()
        except FileNotFoundError:
            return []

    def wait_for(self, pattern, seconds):
        deadline = time.time() + seconds
        while time.time() < deadline:
            if any(re.search(pattern, l) for l in self.lines()):
                return
            if self.make.poll() is not None:
                raise SystemExit("ai-scenario: the game exited while waiting for %r" % pattern)
            time.sleep(0.5)
        raise SystemExit("ai-scenario: never saw %r in %s" % (pattern, self.console))

    def api(self, *args):
        env = dict(os.environ, DEBUG_API_DIR=self.api_dir, DEBUG_API_PID=str(self.pid))
        p = subprocess.run([DEBUG_API] + list(args), env=env, capture_output=True, text=True)
        return p.stdout

    def cmd(self, text):
        self.api("cmd", text)

    def json(self, path):
        env = dict(os.environ, DEBUG_API_DIR=self.api_dir, DEBUG_API_PID=str(self.pid))
        sock = os.path.join(self.api_dir, "%d.sock" % self.pid)
        out = subprocess.run(["curl", "-s", "--unix-socket", sock, "http://x" + path], env=env, capture_output=True, text=True).stdout
        return json.loads(out)

    def tick(self):
        return self.json("/ai/counters")["tick"]

    def teleport(self, slot, x, y, z, yaw=0.0):
        out = self.api("teleport", "pos=%g,%g,%g" % (x, y, z + 1), "ang=0,%g,0" % yaw, "player=%d" % slot, "settle=1", "timeout=200")
        if '"ok":true' not in out:
            raise SystemExit("ai-scenario: teleport of player %d to (%g %g %g) failed: %s" % (slot, x, y, z, out[:300]))

    def stop(self, keep):
        if keep or self.pid is None:
            return
        args = open("/proc/%d/cmdline" % self.pid, "rb").read() if os.path.exists("/proc/%d" % self.pid) else b""
        if b"hl2_linux64" in args:
            os.kill(self.pid, signal.SIGTERM)
        self.make.wait(timeout=60)


def bots_by_name(game):
    return {b["name"]: b["slot"] for b in game.json("/ai/bots") if b.get("state", "active") == "active"}


def sight(game):
    """The watcher holds a post; the target stands past each occluder (§6.6)."""
    game.cmd("ai_think 0")
    game.cmd("ai_sense_log 1")
    game.cmd("ai_bot_add Watcher skills=8,7,6,6,6,6,7,5,5,4")
    game.cmd("ai_bot_add Target skills=2,2,3,1,2,1,2,2,3,2")
    game.cmd("ai_bot_add Blocker skills=2,2,3,1,2,1,2,2,3,2")
    time.sleep(2)
    slots = bots_by_name(game)
    w, t, b = slots["Watcher"], slots["Target"], slots["Blocker"]
    room1 = 512.0  # ssmap link lays the rooms 512 apart (the level grid), not the library's 768
    park = (room1 + 440, 80, 17)
    scenes = [
        # name, watcher (x y z yaw), target, blocker or None, expect
        ("open", (64, 300, 16, 0), (200, 300, 16), None, "seen"),
        ("wall", (64, 224, 16, 0), (400, 100, 16), None, "hidden"),
        ("window", (64, 224, 16, 0), (420, 224, 16), None, "seen"),
        ("player", (64, 300, 16, 0), (240, 300, 16), (160, 300, 16), "hidden"),
        ("door", (room1 + 64, 256, 16, 0), (room1 + 400, 256, 16), None, "hidden"),
        ("crates", (room1 + 64, 400, 16, 0), (room1 + 200, 400, 16), None, "hidden"),
        ("open again", (64, 300, 16, 0), (200, 300, 16), None, "seen"),
    ]
    out = []
    for name, wp, tp, bp, expect in scenes:
        game.teleport(b, *(bp or park), yaw=180)
        game.teleport(t, *tp, yaw=180)
        game.teleport(w, *wp)
        start = game.tick()
        time.sleep(3.0)
        end = game.tick()
        out.append({"name": name, "from": start, "to": end, "watcher": w, "target": t, "expect": expect})
        print("ai-scenario: %-10s ticks %d..%d expect %s" % (name, start, end, expect))
    return out


def hearing(game):
    """A listener holds still; the target fires, reloads and walks at scripted distances (§6.6)."""
    game.cmd("ai_think 0")
    game.cmd("ai_sense_log 1")
    game.cmd("ai_bot_add Listener skills=8,7,6,6,6,6,7,5,5,4")
    game.cmd("ai_bot_add Target skills=2,2,3,1,2,1,2,2,3,2")
    time.sleep(2)
    slots = bots_by_name(game)
    l, t = slots["Listener"], slots["Target"]
    far = 2 * 512.0  # the level grid's, see sight()
    game.teleport(l, 64, 256, 16)
    scenes = []

    def scene(name, steps, seconds):
        start = game.tick()
        for s in steps:
            if isinstance(s, tuple):
                game.teleport(t, *s, yaw=0)
            else:
                game.cmd(s)
                time.sleep(0.2)
        time.sleep(seconds)
        scenes.append({"name": name, "from": start, "to": game.tick()})
        print("ai-scenario: %-14s ticks %d..%d" % (name, start, scenes[-1]["to"]))

    scene("near smg1", [(200, 256, 16), "ai_bot_act Target select 2"], 1.0)
    scene("near smg1 fire", ["ai_bot_act Target fire 1"], 1.5)
    scene("near smg1 reload", ["ai_bot_act Target reload"], 2.5)
    scene("near pistol", ["ai_bot_act Target select 1", "ai_bot_act Target fire 1"], 1.5)
    scene("near pistol reload", ["ai_bot_act Target reload"], 2.5)
    scene("near 357", [(256, 96, 16)], 1.5)
    scene("near 357 fire", ["ai_bot_act Target select 5", "ai_bot_act Target fire 2.5"], 3.0)
    scene("near 357 reload", ["ai_bot_act Target reload"], 4.5)
    scene("far smg1", [(far + 200, 256, 16), "ai_bot_act Target select 2", "ai_bot_act Target fire 1"], 1.5)
    scene("far smg1 reload", ["ai_bot_act Target reload"], 2.5)
    scene("far steps", ["ai_bot_drive Target 90 1.5"], 2.0)
    scene("own steps", ["ai_bot_drive Listener 90 1.5"], 2.0)
    truth = []
    for line in game.lines():
        m = re.search(r"\[SourceSharp/Ai\] (sound|client step) (\d+) to (\d+): (\S+) owner (-?\d+) in ([01]) dist ([\d.]+) reach (\S+) share ([\d.]+) kind (\w+) weapon (-?\d+)", line)
        if m and int(m.group(3)) == l:
            truth.append({"way": m.group(1), "tick": int(m.group(2)), "bot": l, "sound": m.group(4), "owner": int(m.group(5)), "in": m.group(6) == "1",
                          "dist": float(m.group(7)), "reach": float(m.group(8)) if re.match(r"^[\d.]+$", m.group(8)) else 1e30,
                          "share": float(m.group(9)), "kind": m.group(10), "weapon": int(m.group(11))})
    return scenes, truth, {"listener": l, "target": t}


THINK = re.compile(r"\[SourceSharp/Ai\] think (\d+) (\S+): (\w+)/([^v]*?) verdict '([^']*)' target (-?\d+) at \((-?\d+) (-?\d+) (-?\d+)\) goal (?:\((-?\d+) (-?\d+) (-?\d+)\)|-)")


def thinks(game):
    """The brains' decisions as ai_think_log printed them: tick, bot, branch, leaf, verdict, target slot, where, goal."""
    out = []
    for line in game.lines():
        m = THINK.search(line)
        if m:
            out.append({"tick": int(m.group(1)), "bot": m.group(2), "branch": m.group(3), "leaf": m.group(4).strip(), "verdict": m.group(5),
                        "target": int(m.group(6)), "at": [int(m.group(7)), int(m.group(8)), int(m.group(9))],
                        "goal": [int(m.group(10)), int(m.group(11)), int(m.group(12))] if m.group(10) else None})
    return out


def scenes_of(game, teleports):
    scenes = []

    def scene(name, steps, seconds):
        start = game.tick()
        for s in steps:
            if isinstance(s, tuple):
                slot, x, y, z, yaw = s
                game.teleport(teleports[slot], x, y, z, yaw=yaw)
            else:
                game.cmd(s)
                time.sleep(0.2)
        time.sleep(seconds)
        scenes.append({"name": name, "from": start, "to": game.tick()})
        print("ai-scenario: %-16s ticks %d..%d" % (name, start, scenes[-1]["to"]))

    return scenes, scene


def duel(game):
    """A Discipline 10 bot (brains deciding, nobody acting) watches a target empty its SMG1's clip facing away; its decisions push in the reload window (§5.4)."""
    game.cmd("ai_think 0")
    game.cmd("ai_sense_log 1")
    game.cmd("ai_think_log 1")
    game.cmd("ai_bot_add Pusher skills=8,7,6,6,6,6,10,5,4,2")
    game.cmd("ai_bot_add Target skills=2,2,3,1,2,1,2,2,3,2")
    time.sleep(2)
    slots = bots_by_name(game)
    p, t = slots["Pusher"], slots["Target"]
    scenes, scene = scenes_of(game, {"p": p, "t": t})
    scene("sight", [("t", 300, 256, 16, 0), ("p", 150, 256, 16, 0), "ai_bot_act Target select 2"], 2.0)
    # 45 rounds at 0.075 s run dry in 3.4 s; holding fire past it, the SMG1 reloads itself (1.5 s).
    scene("target fires", ["ai_bot_act Target fire 4"], 6.0)
    reloads = []
    for line in game.lines():
        m = re.search(r"\[SourceSharp/Ai\] sound (\d+) to (\d+): \S+ owner (\d+) in [01] .* kind Reload weapon", line)
        if m and int(m.group(2)) == p and int(m.group(3)) == t:
            reloads.append(int(m.group(1)))
    return scenes, {"pusher": p, "target": t, "reloads": sorted(set(reloads)), "thinks": thinks(game)}


def routes(game):
    """A Headhunter (10) and a plain bot (0) see the scoreboard's leader and a low scorer, lose both, and hunt: the Headhunter the leader (§5.4)."""
    game.cmd("ai_think 0")
    game.cmd("ai_sense_log 1")
    game.cmd("ai_think_log 1")
    game.cmd("ai_bot_add Hunter skills=4,4,4,3,3,3,4,3,4,10")
    game.cmd("ai_bot_add Plain skills=4,4,4,3,3,3,4,3,4,0")
    game.cmd("ai_bot_add Leader skills=2,2,3,1,2,1,2,2,3,2")
    game.cmd("ai_bot_add Low skills=2,2,3,1,2,1,2,2,3,2")
    time.sleep(2)
    slots = bots_by_name(game)
    h, pl, le, lo = slots["Hunter"], slots["Plain"], slots["Leader"], slots["Low"]
    mid, east = 512.0, 1024.0
    # The leader takes two frags off the low scorer: the scoreboard ranks it first.
    for _ in range(2):
        game.api("hurt", "#%d" % lo, "500", "", "", "#%d" % le)
        time.sleep(2.5)
    scenes, scene = scenes_of(game, {"h": h, "p": pl, "le": le, "lo": lo})
    scene("see both", [("le", mid + 420, 256, 16, 180), ("lo", mid + 200, 330, 16, 180),
                       ("h", mid + 64, 240, 16, 0), ("p", mid + 64, 300, 16, 0)], 3.0)
    scene("hide", [("le", east + 420, 100, 16, 0), ("lo", 64, 96, 16, 0)], 2.0)
    scene("hunt", ["ai_bot_act Leader fire 0", "ai_think 1"], 4.0)
    return scenes, {"hunter": h, "plain": pl, "leader": le, "low": lo, "thinks": thinks(game)}


def nav(game):
    """One bot sent to every pickup of ss_ai_nav in turn, by ai_bot_goto: every edge type, the ladder and the door (§6.6)."""
    game.cmd("ai_think 0")
    game.cmd("ai_bot_add Walker skills=6,6,5,5,5,5,6,4,5,3")
    time.sleep(2)
    slots = bots_by_name(game)
    w = slots["Walker"]
    game.teleport(w, 720, 420, 16)
    pickups = ["weapon_shotgun", "weapon_smg1", "weapon_357", "item_battery", "weapon_crossbow", "item_ammo_crossbow"]
    out = []
    for item in pickups:
        start = game.tick()
        n = len(game.lines())
        game.cmd("ai_bot_goto Walker %s" % item)
        deadline = time.time() + 30
        arrived = False
        while time.time() < deadline and not arrived:
            time.sleep(0.5)
            arrived = any(re.search(r"\[SourceSharp/Ai\] bot \d+ arrived cell", l) for l in game.lines()[n:])
        out.append({"name": item, "from": start, "to": game.tick(), "arrived": arrived})
        print("ai-scenario: %-16s ticks %d..%d %s" % (item, start, out[-1]["to"], "arrived" if arrived else "NOT ARRIVED"))
    ladder = [l for l in game.lines() if re.search(r"\[SourceSharp/Ai\] bot \d+ \(Walker\) (is on a ladder|got off the ladder)", l)]
    jumps = [l for l in game.lines() if re.search(r"\[SourceSharp/Ai\] bot \d+ \(Walker\) (crouch-)?jumps at", l)]
    stuck = [l for l in game.lines() if re.search(r"\[SourceSharp/Ai\] bot \d+ \(Walker\) is stuck", l)]
    return out, {"walker": w, "ladder": ladder, "jumps": jumps, "stuck": stuck}


# The standard run's bots: one of each preset (plan_hl2mp_ai §3.4.5).
JANK_BOTS = [("Alyx", "expert"), ("Barney", "hard"), ("Gordon", "normal"), ("Kleiner", "easy")]
TICKS_PER_MINUTE = 60 / 0.015


class ScriptedClient:
    """The listen server's own client, played by keys through the console: it
    runs forward, turns, jumps and fires at seeded random, and a press respawns
    it. A moving target and a real command stream, no person's skill."""

    def __init__(self, game, seed=7):
        self.game = game
        self.rng = random.Random(seed)

    def begin(self):
        self.game.cmd("+forward")

    def step(self):
        turn = self.rng.choice(["left", "right"])
        self.game.cmd("+" + turn)
        time.sleep(self.rng.uniform(0.2, 0.8))
        self.game.cmd("-" + turn)
        press = self.rng.choice(["jump", "attack", "attack"])
        self.game.cmd("+" + press)
        time.sleep(0.2)
        self.game.cmd("-" + press)
        time.sleep(self.rng.uniform(0.5, 2.0))

    def end(self):
        for key in ("forward", "left", "right", "jump", "attack"):
            self.game.cmd("-" + key)


def jank(config, keep, minutes, streaks=1, preset=None):
    """The standard run: its exit is the score tool's, and a run with too few bots or too little play is a failure."""
    sha = subprocess.run(["git", "-C", ROOT, "rev-parse", "--short=9", "HEAD"], capture_output=True, text=True).stdout.strip()
    out_dir = os.path.join(ROOT, "bin", config, "ai-jank")
    os.makedirs(out_dir, exist_ok=True)
    rec = os.path.join(out_dir, "%s-%s.airec" % (time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()), sha))
    # One preset four times: what that difficulty does to the scripted client, with four times the sample (§12.3).
    bots_asked = [(name, preset or p) for name, p in JANK_BOTS]
    game = Game("dm_lockdown", config)
    try:
        game.start()
        game.cmd("ai_record start %s dm_lockdown" % rec)
        game.cmd("ai_bot_streaks %d" % streaks)
        for name, asked in bots_asked:
            game.cmd("ai_bot_add %s %s" % (name, asked))
        time.sleep(2)
        bots = bots_by_name(game)
        if len(bots) != len(JANK_BOTS):
            raise SystemExit("ai-scenario: %d of the %d bots came in: %s" % (len(bots), len(JANK_BOTS), sorted(bots)))
        start = game.tick()
        end = start + minutes * TICKS_PER_MINUTE
        client = ScriptedClient(game)
        client.begin()
        counters = game.json("/ai/counters")
        crates = counters.get("ai.breakables")
        while game.tick() < end:
            client.step()
        client.end()
        counters = game.json("/ai/counters")
        print("ai-scenario: ai_bot_streaks %d: hot %s, cold %s" % (streaks, counters.get("ai.streaks.hot"), counters.get("ai.streaks.cold")))
        print("ai-scenario: breakables on the map %s -> %s; shots at them begun %s, given up %s" % (crates, counters.get("ai.breakables"), counters.get("ai.breaks"), counters.get("ai.breaks.given_up")))
        game.cmd("ai_record stop")
        time.sleep(1)
        # Who killed whom with what, the console's own lines: `ai-replay threat` has the hits, not the weapon of a kill.
        with open(rec + ".kills.txt", "w") as f:
            f.write("".join(l + "\n" for l in game.lines() if re.search(r" killed .+ with [a-z0-9_]+\.$", l)))
    finally:
        game.stop(keep)
    p = subprocess.run([os.path.join(ROOT, "tools", "ai-replay"), "jank", rec, "--config", config], capture_output=True, text=True)
    header = "ai-scenario: jank at %s: %s, dm_lockdown, %g minutes, bots %s, %s\n" % (
        sha, config, minutes, " ".join("%s=%s" % b for b in bots_asked), rec)
    report = header + p.stdout + p.stderr
    with open(rec + ".txt", "w") as f:
        f.write(report)
    print(report, end="")
    m = re.search(r"^jank: bots score \S+ over (\S+) bot-minutes", p.stdout, re.M)
    if p.returncode != 0 or not m:
        raise SystemExit("ai-scenario: the score failed (exit %d)" % p.returncode)
    # The stimulus reached the subject: four bots alive for most of the run.
    if float(m.group(1)) < 2 * minutes:

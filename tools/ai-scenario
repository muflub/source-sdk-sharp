def place(game, slot, at, yaw=0.0):
    """A teleport with no wait: a bot that keeps thinking does not settle."""
    x, y, z = at
    game.api("teleport", "pos=%g,%g,%g" % (x, y, z + 1), "ang=0,%g,0" % yaw, "player=%d" % slot, "settle=1", "timeout=1")


def prefire(config, keep, trials, skills):
    sha, rec = new_recording(config, "prefire")
    game = Game("ss_ai_sight", config)
    hidden_spot, open_spot, post = (400, 100, 16), (200, 300, 16), (64, 300, 16)
    returned = 0
    gone = []
    try:
        game.start()
        game.cmd("ai_record start %s ss_ai_sight" % rec)
        game.cmd("god")
        game.cmd("ai_bot_add Corner %s" % skills)
        time.sleep(2)
        slots = bots_by_name(game)
        if "Corner" not in slots:
            raise SystemExit("ai-scenario: the bot did not come in: %s" % sorted(slots))
        for trial in range(trials):
            place(game, slots["Corner"], post)
            place(game, 1, open_spot, 180)
            # Long enough to be seen and fired at, short of emptying its clip.
            time.sleep(1.0)
            place(game, 1, hidden_spot, 180)
            gone.append(game.tick())
            if trial % 3 == 2:
                time.sleep(1.1)
                place(game, 1, open_spot, 180)
                returned += 1
                time.sleep(1.0)
            else:
                time.sleep(3.0)
        game.cmd("ai_record stop")
        time.sleep(1)
    finally:
        game.stop(keep)
    tactics(rec, config, "ss_ai_sight", "ai-scenario: prefire at %s: %d trials (%d back in sight), bot %s, %s\n" % (sha, trials, returned, skills, rec))
    with open(rec + ".tactics.txt") as f:
        m = re.search(r"^bursts of \d+: (.*)$", f.read(), re.M)
    bursts = [int(t) for t in m.group(1).split()] if m else []
    delays = []
    for t in gone:
        after = [b for b in bursts if b >= t and b < t + 240]
        if after:
            delays.append((after[0] - t) * 0.015)
    print("ai-scenario: %d of %d disappearances drew a burst; delay from gone to the first burst: mean %.2f s, min %.2f, max %.2f (the tick of the teleport is read a moment after it)" %
          (len(delays), len(gone), sum(delays) / len(delays) if delays else float("nan"), min(delays or [float("nan")]), max(delays or [float("nan")])))
    return 0



def spectator(config, keep):
    sha, rec = new_recording(config, "spectator")
    game = Game("dm_lockdown", config)
    failed = []
    try:
        game.start()
        game.cmd("ai_record start %s dm_lockdown" % rec)
        for name, skills in (("Alyx", "hard"), ("Barney", "hard"), ("Gordon", "hard")):
            game.cmd("ai_bot_add %s %s" % (name, skills))
        time.sleep(2)
        slots = bots_by_name(game)

        def knows():
            n = 0
            for slot in slots.values():
                if any(a.get("slot") == 1 for a in game.json("/ai/bot/%d/memory" % slot).get("actors", [])):
                    n += 1
            return n

        def about():
            return sum(1 for slot in slots.values() if game.json("/ai/bot/%d/doing" % slot).get("targetSlot") == 1)

        # In play: a bot learns of it (a scoreboard row at the least, a sight if it can).
        deadline = time.time() + 60
        while time.time() < deadline and knows() == 0:
            time.sleep(1)
        before = knows()
        print("ai-scenario: in play, %d of %d bots list the client" % (before, len(slots)))
        if before == 0:
            failed.append("no bot ever listed the client in play")

        game.cmd("spectate")
        time.sleep(1.0)
        world = game.json("/ai/world")
        me = [a for a in world.get("actors", []) if a.get("slot") == 1]
        print("ai-scenario: went to spectate: %s" % (me[:1],))
        hurt0 = game.json("/ai/counters").get("tick")
        listed = aimed = samples = 0
        end = time.time() + 40
        spots = list(slots.values())
        i = 0
        while time.time() < end:
            # Through each bot in turn: its body, as a camera.
            read = [a for a in game.json("/ai/world").get("actors", []) if a.get("slot") == spots[i % len(spots)] and a.get("at")]
            if read:
                x, y, z = read[0]["at"]
                game.api("teleport", "pos=%g,%g,%g" % (x, y, z + 40), "ang=0,0,0", "player=1", "settle=1", "timeout=1")
            i += 1
            for _ in range(3):
                listed += knows()
                aimed += about()
                samples += len(slots)
                time.sleep(0.3)
        print("ai-scenario: spectating, of %d bot samples: %d listed it, %d were about it" % (samples, listed, aimed))
        if listed or aimed:
            failed.append("a bot knew a spectator: %d listed, %d about" % (listed, aimed))

        game.cmd("jointeam 2")
        game.cmd("+jump")
        time.sleep(0.2)
        game.cmd("-jump")
        taken = None
        deadline = time.time() + 90
        client = ScriptedClient(game)
        client.begin()
        while time.time() < deadline and taken is None:
            client.step()
            if about() > 0:
                taken = time.time()
        client.end()
        print("ai-scenario: back in play, a bot took it up: %s; %d list it" % ("yes" if taken else "NO", knows()))
        if taken is None:
            failed.append("back in play no bot took the client up")
        game.cmd("ai_record stop")
        time.sleep(1)
    finally:
        game.stop(keep)
    print("ai-scenario: spectator at %s, %s: %s" % (sha, rec, "; ".join(failed) if failed else "PASS"))
    return 1 if failed else 0


def habit(config, keep, minutes):
    sha, rec = new_recording(config, "habit")
    game = Game("dm_lockdown", config)
    samples = {}
    grudges = {}
    try:
        game.start()
        game.cmd("ai_record start %s dm_lockdown" % rec)
        for name, skills in HABIT_BOTS:
            game.cmd("ai_bot_add %s %s" % (name, skills))
        time.sleep(2)
        slots = bots_by_name(game)
        if len(slots) != len(HABIT_BOTS):
            raise SystemExit("ai-scenario: %d of the %d bots came in: %s" % (len(slots), len(HABIT_BOTS), sorted(slots)))
        start = game.tick()
        end = start + minutes * TICKS_PER_MINUTE
        x, y, z = HABIT_SPOT
        beat = 0
        while game.tick() < end:
            # Back at the spot, a press to respawn if dead, facing about.
            game.cmd("+jump")
            time.sleep(0.1)
            game.cmd("-jump")
            game.api("teleport", "pos=%g,%g,%g" % (x, y, z + 1), "ang=0,%g,0" % (beat * 37 % 360), "player=1", "settle=1", "timeout=50")
            beat += 1
            for _ in range(4):
                now = game.tick()
                half = "first" if now < start + (end - start) / 2 else "second"
                for name, slot in slots.items():
                    d = game.json("/ai/bot/%d/doing" % slot)
                    row = samples.setdefault((name, half), collections.Counter())
                    row["decides"] += 1
                    if d.get("leaf") in ("hunt", "chase"):
                        row["hunting"] += 1
                    if d.get("preAiming"):
                        row["preAiming"] += 1
                    if d.get("habitSpot"):
                        row["habitKnown"] += 1
                        grudges.setdefault(name, {})["habitSpot"] = d["habitSpot"]
                time.sleep(0.5)
        for name, slot in slots.items():
            memory = game.json("/ai/bot/%d/memory" % slot)
            grudges.setdefault(name, {})["grudges"] = {str(a["slot"]): round(a.get("grudge", 0), 2) for a in memory.get("actors", []) if a.get("grudge", 0) > 0}
        moments = [l for l in game.lines() if "[SourceSharp/Ai] moment " in l]
        game.cmd("ai_record stop")
        time.sleep(1)
    finally:
        game.stop(keep)
    print("ai-scenario: habit at %s: %g minutes at %s, bots %s" % (sha, minutes, HABIT_SPOT, slots))
    for (name, half), row in sorted(samples.items()):
        print("  %-8s %-6s half: %s" % (name, half, dict(row)))
    for name, g in sorted(grudges.items()):
        print("  %-8s %s" % (name, g))
    print("  %d moment lines:" % len(moments))
    for l in moments[:40]:
        print("    " + l.strip()[:120])
    scored(rec, config, "")
    return 0


def main(argv):
    if not argv or argv[0] not in ("sight", "hearing", "duel", "routes", "nav", "jank", "live", "traits", "habit", "prefire", "camp", "spectator"):
        print(__doc__)
        return 2
    which = argv[0]
    config = argv[argv.index("--config") + 1] if "--config" in argv else "debug"
    keep = "--keep" in argv
    if which == "jank":
        return jank(config, keep, float(argv[argv.index("--minutes") + 1]) if "--minutes" in argv else 5.0,
                    int(argv[argv.index("--streaks") + 1]) if "--streaks" in argv else 1,
                    argv[argv.index("--preset") + 1] if "--preset" in argv else None)
    if which == "live":
        return live(config, keep)
    minutes = float(argv[argv.index("--minutes") + 1]) if "--minutes" in argv else 5.0
    if which == "traits":
        return traits(config, keep, minutes, int(argv[argv.index("--points") + 1]) if "--points" in argv else 50)
    if which == "habit":
        return habit(config, keep, minutes)
    if which == "spectator":
        return spectator(config, keep)
    if which == "camp":
        return camp(config, keep, minutes)
    if which == "prefire":
        return prefire(config, keep, int(argv[argv.index("--trials") + 1]) if "--trials" in argv else 30,
                       argv[argv.index("--skills") + 1] if "--skills" in argv else PREFIRE_BOT)
    map_name = "ss_ai_" + which
    bsp = os.path.join(ROOT, "bin", config, "mods", "test", "maps", map_name + ".bsp")
    vmf = os.path.join(ROOT, "game", "mod_test", "maps", "src", "ai", map_name + ".vmf")
    if not os.path.exists(bsp):
        raise SystemExit("ai-scenario: no %s: make map MAP=%s" % (bsp, map_name))
    out_dir = os.path.join(ROOT, "src", "ai", "tests", "recordings")
    os.makedirs(out_dir, exist_ok=True)
    rec = os.path.join(out_dir, map_name + ".airec")
    source = sha256(vmf)
    game = Game(map_name, config)
    try:
        game.start()
        game.cmd("ai_record start %s %s@%s" % (rec, map_name, source[:12]))
        time.sleep(0.5)
        summary = {"map": map_name, "source_sha256": source}
        if which == "sight":
            summary["scenes"] = sight(game)
        elif which == "hearing":
            scenes, truth, who = hearing(game)
            summary.update(scenes=scenes, truth=truth, **who)
        else:
            scenes, more = {"duel": duel, "routes": routes, "nav": nav}[which](game)
            summary.update(scenes=scenes, **more)
        counters = game.json("/ai/counters")
        summary["counters"] = counters
        game.cmd("ai_record stop")
        time.sleep(1)
        print("ai-scenario: ai.sense.us mean %s, worst %s over %s ticks, ai.publish.us %s, %s bots" %
              (counters["ai.sense.us"], counters["ai.sense.us.max"], counters["ai.sense.ticks"], counters["ai.publish.us"], counters["bots"]))
    finally:
        game.stop(keep)
    with open(os.path.join(out_dir, map_name + ".json"), "w") as f:
        json.dump(summary, f, indent=1)
        f.write("\n")
    print("ai-scenario: wrote %s (%d bytes) and %s.json" % (rec, os.path.getsize(rec), map_name))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

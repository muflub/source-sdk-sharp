def scored(rec, config, header):
    p = subprocess.run([os.path.join(ROOT, "tools", "ai-replay"), "jank", rec, "--config", config], capture_output=True, text=True)
    report = header + p.stdout + p.stderr
    with open(rec + ".txt", "w") as f:
        f.write(report)
    print(report, end="")
    if p.returncode != 0:
        raise SystemExit("ai-scenario: the score failed (exit %d)" % p.returncode)


def new_recording(config, what):
    sha = subprocess.run(["git", "-C", ROOT, "rev-parse", "--short=9", "HEAD"], capture_output=True, text=True).stdout.strip()
    out_dir = os.path.join(ROOT, "bin", config, "ai-jank")
    os.makedirs(out_dir, exist_ok=True)
    return sha, os.path.join(out_dir, "%s-%s-%s.airec" % (what, time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()), sha))



#!/usr/bin/env python3
"""Classify every file of the SourceSharp fork at a frozen tip T.

    tools/move-classify --fork ../source-sdk-2013 --tip T [--base 22288b919]
                        [--out docs/move/ledger.tsv]
    tools/move-classify --self-test

One row per file tracked at T, plus the untracked plan files at the top of the
fork, each with exactly one class (plan_sharp_repo.md, Phase 1):

  VALVE          identical to Valve upstream (--base)
  VALVE-EDITED   a Valve path we modified
  VALVE-DERIVED  added by us but carrying >= valvetext.RUN consecutive
                 content lines verbatim from Valve, or relocated Valve code
                 (src/sourcesharp/public, src/sourcesharp/common)
  OURS           SourceSharp-authored, moves to `dest`
  OURS-OVERLAY   SourceSharp-authored at a Valve-tree path, moves to `dest`
  MOD-COPY       game/mod_sharp, copied whole to game/mod_test
  DROP           goes nowhere (dead tools, lane probes, stale output)

Columns: path class dest valve_header header_reason run valve_match
borderline sha256. `valve_header` is filled for source files that move (OURS,
OURS-OVERLAY, MOD-COPY): rules 1 (Valve copyright today) and 3 (native code
built against SDK headers) are decided here; rule 2 (ports Valve logic) comes
from --rulings, a TSV of path<TAB>yes|no<TAB>reason written by per-module
review. A source file with no decision is `?`, and the run exits non-zero
with --strict.
"""

import argparse
import hashlib
import os

    tg = {1: 100, 2: 70, 3: 55}

    def bv(results, tol=3):
        return brightness_verdict(results, level1=0.30, tolerance=tol, targets=tg, calibration={})[0]
    falling = {1: [(1, 0.30, 0.2, 0.001)], 2: [(1, 0.21, 0.1, 0.001)], 3: [(1, 0.165, 0.1, 0.001)]}
    expect(not bv(falling), 'a falling series on its targets fails')
    expect(bv({1: [(1, 0.30, 0.2, 0.001)], 2: [(1, 0.31, 0.1, 0.001)]}, tol=50), 'a brighter depth passes')
    expect(bv({1: [(1, 0.30, 0.2, 0.001)], 2: [(1, 0.30, 0.1, 0.001)]}, tol=50), 'an equal depth passes')
    expect(bv({1: [(1, 0.30, 0.2, 0.05)], 2: [(1, 0.21, 0.1, 0.001)]}), 'a clipped level passes')
    expect(bv({2: [(1, 0.24, 0.1, 0.001)]}), 'a depth 10 over its target passes')
    expect(not bv({2: [(1, 0.2172, 0.1, 0.001)]}), 'a depth 2.4 over its target, inside 3, fails')
    expect(bv({2: [(1, 0.2028, 0.1, 0.001)]}, tol=2), 'a depth 2.4 under its target passes at a tolerance of 2')
    expect(not bv({4: [(1, 0.12, 0.1, 0.001)]}), 'a depth with no target, alone, fails')
    tb = {**tg, 4: 40, 5: 52, 6: 32}

    def bvb(results, tol=3):
        return brightness_verdict(results, level1=0.30, tolerance=tol, targets=tb, calibration={})[0]
    boss_lit = {4: [(1, 0.12, 0.1, 0.001)], 5: [(1, 0.156, 0.1, 0.001)], 6: [(1, 0.096, 0.1, 0.001)]}
    expect(not bvb(boss_lit), 'a boss level on its target, brighter than the level above it, fails the falling order')
    expect(bvb({4: [(1, 0.12, 0.1, 0.001)], 5: [(1, 0.156, 0.1, 0.001)], 6: [(1, 0.13, 0.1, 0.001)]}, tol=50),
           'a level brighter than the one before the boss level between them passes')
    expect(bvb({4: [(1, 0.12, 0.1, 0.001)], 5: [(1, 0.12, 0.1, 0.001)], 6: [(1, 0.096, 0.1, 0.001)]}),
           'a boss level off its target passes')
    expect(brightness_verdict({5: [(1, 0.156, 0.1, 0.001)]}, level1=0.30, tolerance=3, targets=tg, calibration={})[0],
           'a boss level with no target passes')
    # The calibration: an Act III level whose figure is 20.8 predicts 16 in game at 0.769, and is held there.
    t3 = {9: 20, 11: 16}
    act3 = {11: [(1, 0.3 * 0.208, 0.1, 0.001)]}
    expect(not brightness_verdict(act3, level1=0.30, tolerance=3, targets=t3, calibration={3: 0.769})[0],
           'an Act III level on its target in game by its act\'s factor fails')
    expect(brightness_verdict(act3, level1=0.30, tolerance=3, targets=t3, calibration={})[0],
           'an Act III level 4.8 over its target uncalibrated passes')
    expect(brightness_verdict(act3, level1=0.30, tolerance=3, targets=t3, calibration={3: 1.0})[0],
           'an act\'s factor of 1 moves the figure')
    across = {9: [(1, 0.3 * 0.20, 0.1, 0.001)], 11: [(1, 0.3 * 0.208, 0.1, 0.001)]}
    expect(not brightness_verdict(across, level1=0.30, tolerance=3, targets=t3, calibration={2: 1.0, 3: 0.769})[0],
           'the falling order is not read from the calibrated figures (9 at 20, 11 at 16 in game)')
    expect(brightness_verdict(across, level1=0.30, tolerance=50, targets=t3, calibration={})[0],
           'an uncalibrated level 11 at 20.8 under level 9 at 20 passes the falling order')
    expect(set(CALIBRATION) == {1, 2, 3} and all(0.5 < f < 1.5 for f in CALIBRATION.values()),
           'the calibration is not one factor per act')
    expect([act_of(d) for d in (1, 5, 6, 10, 11, 15)] == [1, 1, 2, 2, 3, 3], 'the acts are not 1-5, 6-10 and 11-15')
    expect(bv({2: [(1, 0.15, 0.1, 0.001), (2, 0.27, 0.1, 0.001)]}) == [], 'the seeds\' mean is not what is held')
    expect(bv({}), 'no depth passes')
    expect(bv({1: [(1, 0.3, 0.2, 0)], 2: []}), 'a depth with no seed passes')
    expect(brightness_verdict(falling, level1=0, tolerance=3, targets=tg)[0], 'a zero level 1 scales')
    lut = gamma_lut()
    expect(lut[0] == 0 and lut[255] == 255, 'the re-encoding moves black or white')
    expect(lut[1] >= 5 and lut[8] >= 16, 'the re-encoding does not lift the darks (sRGB 1 is 6 at 2.2, 8 is 17)')
    expect(abs(lut[128] - 128) <= 2, 'the re-encoding moves the midtones (the two curves meet there)')
    expect(all(a <= b for a, b in zip(lut, lut[1:])), 'the re-encoding is not monotone')
    try:
        from PIL import Image
    except ImportError:
        Image = None
        print('descent-gate self-test: PIL is not installed: the view measure (tile_luma) is not tested here')
    if Image is not None:
        tile = Image.new('RGB', (4, 4), (0, 0, 0))
        for x in range(2):
            for y in range(4):
                tile.putpixel((x, y), FIGURE_COLOUR)
        expect(tile_luma(tile) == 0, 'the scale figure\'s pixels count in a view')
        grey = Image.new('RGB', (4, 4), (128, 128, 128))
        expect(abs(tile_luma(grey) - lut[128] / 255) < 1e-6, 'a grey view does not read its re-encoded grey')
    sheet_index = {'cameras': [{'id': 'overview', 'kind': 'overview', 'size': [512, 384]},
                               {'id': 'iso', 'kind': 'isometric', 'size': [512, 384]},
                               {'id': 'spawn1', 'kind': 'spawn', 'size': [512, 384]},
                               {'id': 'cam1', 'kind': 'custom', 'size': [512, 384]}],
                   'checks': {'movement': {}}}
    boxes = view_boxes(sheet_index, (4 + 3 * 516, 4 + 2 * 388))
    expect([b[0] for b in boxes] == ['spawn1', 'cam1'], 'the room views are not the spawn and custom cameras')
    expect(boxes[0][1] == (4 + 0 * 516, 4 + 388 + VIEW_LABEL_ROWS, 4 + 512, 4 + 388 + 384),
           'the spawn view is not the fourth tile (after overview, reach, iso), label band cut')
    expect(boxes[1][1][0] == 4 + 516, 'the first camera is not the fifth tile')
    try:
        view_boxes(sheet_index, (4 + 3 * 516, 4 + 1 * 388))
        bad.append('a sheet of the wrong size reads')
    except Missing:
        pass
    lit = {'cameras': [{'id': 'spawn1', 'kind': 'spawn', 'luminance': {'clipped_fraction': 0.004}},
                       {'id': 'cam1', 'kind': 'custom', 'luminance': {'clipped_fraction': 0.01}},
                       {'id': 'overview', 'kind': 'overview'}]}
    expect(not view_verdict(1, 1, lit), 'views under the limit fail')
    white = json.loads(json.dumps(lit))
    white['cameras'][0]['luminance']['clipped_fraction'] = 0.043
    expect(view_verdict(1, 1, white), 'a washed-out spawn view passes')
    try:
        view_verdict(1, 1, {'cameras': [{'id': 'cam1', 'kind': 'custom'}]})
        bad.append('a view without luminance reads')
    except Missing:
        pass
    table = brightness_verdict(falling, level1=0.30, tolerance=3, targets=tg)[1]
    expect(any(l.startswith('2 ') and ' 70 +-3 ' in l for l in table), 'the table lacks the target column')
    try:
        field({'checks': {'lighting': {}}}, 'checks', 'lighting', 'mean')
        bad.append('a missing field reads')
    except Missing:
        pass

    clean = {'checks': {'movement': {'islands': [{'nodes': 9, 'sample': [1, 2, 104], 'min': [0, 0, 104], 'max': [9, 9, 104]}],
                                     'island_count': 1, 'traps': [], 'stuck_spawns': [], 'reached_by_team': {'0': 900},
                                     'airborne': {'explosive_only_nodes': 4}}}}
    expect(not reach_verdict(1, 1, clean)[0], 'a level with only a ledge island fails')
    floor = json.loads(json.dumps(clean))
    floor['checks']['movement']['islands'].append({'nodes': 40, 'sample': [5, 5, 16.03], 'min': [0, 0, 16.03], 'max': [9, 9, 16.03]})
    floor['checks']['movement']['island_count'] = 2
    expect(reach_verdict(1, 1, floor)[0], 'an unreached floor passes')
    trap = json.loads(json.dumps(clean))

#!/usr/bin/env python3
"""The launcher is called `source#`, and every tool that starts it must say so.

    tools/launcher-name-test [--config debug|release]
    tools/launcher-name-test --self-test

`#` starts a comment in make, and in the shell at the start of a word, so a
tool that spells the name carelessly runs `./source` -- or nothing -- and the
failure lands mid-launch, far from its cause. This runs `source# -help`
through each path that starts the game and checks the launcher's own usage
line comes back:

  make     the recipe `make -n headless` expands to
  make-dedicated, make-join   the recipes of `make dedicated` / `make join`
                              (plan_host_sdk §2.5)
  shell    `cd bin/<config> && ./source# -help`
  debug-api   `tools/debug-api launcher -help`
  gate     tools/live-gate's launch_command(), run the way the gate runs it
"""

import argparse
import importlib.machinery
import importlib.util
import os
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
USAGE = "source# [-mod <id>]"


def sh(cmd, env=None, cwd=ROOT):
    r = subprocess.run(["bash", "-c", cmd], capture_output=True, text=True,
                       env=env, cwd=cwd, timeout=120)
    return r.returncode, r.stdout + r.stderr


def check_make(config, make_cmd="make"):
    """The recipe make would run: it must name ./source# whole. (Running it
    would start the game; the word is what make can break, via `#`.)"""
    rc, out = sh(f"{make_cmd} -s -n headless CONFIG={config}")
    lines = [l for l in out.splitlines() if "gpu-offload" in l]
    if not lines:
        return False, "no launch line in `make -n headless`"
    if "./source# " not in lines[-1]:
        return False, f"make launches `{lines[-1][:120]}`, not ./source#"
    return True, "make recipe names ./source#"


def check_make_target(config, target, marker, make_cmd="make"):
    """A launch recipe other than headless: the line carrying `marker` (an
    argument only that recipe passes) must name ./source# whole."""
    rc, out = sh(f"{make_cmd} -s -n {target} CONFIG={config} ADDR=127.0.0.1:27015")
    lines = [l for l in out.splitlines() if marker in l]
    if not lines:
        return False, f"no launch line with {marker} in `make -n {target}`"
    if "./source# " not in lines[-1]:
        return False, f"make {target} launches `{lines[-1][:120]}`, not ./source#"
    return True, f"make {target} names ./source#"


def check_make_dedicated(config, make_cmd="make"):
    return check_make_target(config, "dedicated", "-dedicated", make_cmd)


def check_make_join(config, make_cmd="make"):
    return check_make_target(config, "join", "+connect", make_cmd)


def check_shell(config):
    rc, out = sh(f"cd bin/{config} && ./source# -help")
    return rc == 0 and USAGE in out, f"shell: exit {rc}"


def check_debug_api(config, debug_api="tools/debug-api"):
    env = dict(os.environ, SOURCESHARP_CONFIG=config)
    rc, out = sh(f"{debug_api} launcher -help", env=env)
    return rc == 0 and USAGE in out, f"debug-api: exit {rc}"


def check_gate(config, gate="tools/live-gate"):
    env = dict(os.environ, SOURCESHARP_CONFIG=config)
    old = dict(os.environ)
    os.environ.update(env)
    try:
        loader = importlib.machinery.SourceFileLoader(
            "live_gate_mod", os.path.join(ROOT, gate))
        spec = importlib.util.spec_from_loader("live_gate_mod", loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        cmd = mod.launch_command(mod.MOD_DIR)
    finally:
        os.environ.clear()
        os.environ.update(old)
    rc, out = sh(f"cd '{os.path.join(ROOT, 'bin', config)}' && exec {cmd} -help")
    return rc == 0 and USAGE in out, f"gate launches `{cmd}`: exit {rc}"


def run(config):
    bad = 0
    for name, fn in (("make", check_make), ("make-dedicated", check_make_dedicated),
                     ("make-join", check_make_join), ("shell", check_shell),
                     ("debug-api", check_debug_api), ("gate", check_gate)):
        ok, why = fn(config)
        bad += not ok
        print(f"{'ok ' if ok else 'BAD'} {name}: {why}")
    return bad


def self_test(config):
    """Each check must fail on a tool that truncates the name at `#`."""
    bad = 0
    with tempfile.TemporaryDirectory() as d:
        debug_api = os.path.join(d, "debug-api")
        with open(debug_api, "w") as f:
            f.write(f'#!/bin/bash\nexec "{ROOT}/bin/{config}/source" "${{@:2}}"\n')
        os.chmod(debug_api, 0o755)
        ok, _ = check_debug_api(config, debug_api)
        bad += ok
        print(f"{'BAD' if ok else 'ok '} a debug-api that runs ./source is refused")

        gate = os.path.join(d, "gate")
        with open(gate, "w") as f:
            f.write("MOD_DIR='x'\ndef launch_command(m):\n    return './source'\n")
        rel = os.path.relpath(gate, ROOT)
        ok, _ = check_gate(config, rel)
        bad += ok
        print(f"{'BAD' if ok else 'ok '} a gate that launches ./source is refused")

        makefile = os.path.join(d, "Makefile")
        with open(makefile, "w") as f:
            f.write("dedicated:\n\t@cd bin && ./source -mod x -dedicated\n"
                    "join:\n\t@cd bin && ./source -mod x +connect $(ADDR)\n")
        for name, fn in (("dedicated", check_make_dedicated), ("join", check_make_join)):
            ok, _ = fn(config, f"make -f {makefile}")
            bad += ok
            print(f"{'BAD' if ok else 'ok '} a make {name} that runs ./source is refused")
    print("self-test", "FAILED" if bad else "passed")
    return 1 if bad else 0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--config", default=os.environ.get("SOURCESHARP_CONFIG")
                    or "debug")
    ap.add_argument("--self-test", action="store_true")
    a = ap.parse_args()
    if not os.path.exists(os.path.join(ROOT, "bin", a.config, "source#")):
        print(f"no bin/{a.config}/source#: build first (make {a.config})")
        return 2
    if a.self_test:
        return self_test(a.config)
    bad = run(a.config)
    print(f"{6 - bad} of 6 launch paths reach source# -help")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())

def self_test():
    checks = []

    def ok(cond, name):
        checks.append((bool(cond), name))

    def doc(verdicts, exit_code=1, failures=()):
        return {"steps": list(verdicts), "verdicts": verdicts, "exit": exit_code,
                "failures": [list(f) for f in failures]}

    # skip
    ok(decide_skip("abc", "abc"), "main at the last green sha is a skip")
    ok(not decide_skip("abd", "abc"), "main moved: run")
    ok(not decide_skip("abc", ""), "no green run yet: run")
    ok(not decide_skip("", ""), "an unreadable sha never skips")
    # failing steps
    d = doc({"join": ["pass", "pass"], "push": ["pass", "fail"], "door": ["fail", "fail"]})
    ok(failing_steps(d) == ["push", "door"], "a fail on any pass names the step, in run order")
    ok(failing_steps(doc({"join": ["pass"]}, failures=[("join", "x")])) == ["join"],
       "a failure filed under a step names it")
    ok(failing_steps(doc({"join": ["pass"]}, failures=[("between passes", "x")])) == [],
       "a failure under no step names no step")
    ok(failing_steps(None) == [], "no verdicts: no steps named (the caller reports the run failed)")
    # confirm
    c, f = classify(doc({"join": ["pass"] * 3, "push": ["fail", "pass", "pass"], "door": ["fail", "fail", "pass"]}),
                    ["push", "door"])
    ok(c == ["door"] and f == {"push": (1, 3)}, "1 of 3 is FLAKY, 2 of 3 is confirmed")
    c, f = classify(doc({"join": ["pass"] * 3, "door": ["pass"] * 3}), ["door"])
    ok(c == [] and f == {"door": (0, 3)}, "0 of 3 is FLAKY (it failed the night run only)")
    c, f = classify(None, ["door"])
    ok(c == ["door"] and not f, "a confirm run with no verdicts is no evidence of a flake")
    # confirm (2026-10-11): a crash in one step ends the live-gate process,
    # so one `--passes 3` run gave every step ONE verdict, and "1 of 1"
    # failed came out FLAKY on 10-10 and 10-11.
    c, f = classify(doc({"ui-scoreboard": ["fail"], "hot-reload": ["fail"]}), ["ui-scoreboard", "hot-reload"])
    ok(c == ["ui-scoreboard", "hot-reload"] and not f, "1 of 1 failed is not FLAKY: no pass was seen")
    c, f = classify(doc({"door": ["fail", "pass"]}), ["door"])
    ok(c == ["door"] and not f, "1 of 2 with a pass missing can still reach 2 of 3: not FLAKY")
    c, f = classify(doc({"door": ["pass", "pass"]}), ["door"])
    ok(c == [] and f == {"door": (0, 2)}, "0 of 2 cannot reach 2 of 3: FLAKY")
    c, f = classify(doc({"door": ["fail", "fail", "fail"]}), ["door"])
    ok(c == ["door"] and not f, "3 of 3 is confirmed")

    def fake_gate(script):
        """A live-gate stand-in: `script(steps, passes)` gives the verdict
        list per step for one process; the calls are recorded."""
        calls = []

        def run_one(steps, passes):
            calls.append((list(steps), passes))
            v = script(steps, passes)
            return None if v is None else doc(v)
        return run_one, calls

    def crashing(steps, passes):
        # hot-reload crashes the game on every pass it runs: the process ends
        # there, and the steps it ran before it get the one verdict.
        out = {}
        for _ in range(passes):
            for s in steps:
                out.setdefault(s, []).append("fail" if s in ("hot-reload", "ui-scoreboard") else "pass")
                if s == "hot-reload":
                    return out
        return out
    run_one, calls = fake_gate(crashing)
    m = confirm(run_one, ["ui-scoreboard", "frag-credit", "hot-reload"])
    ok(all(len(m["verdicts"][s]) == CONFIRM_PASSES for s in ("ui-scoreboard", "frag-credit", "hot-reload")),
       "confirm gives each red step 3 passes even when one pass crashes the game")
    ok(calls[0] == (["ui-scoreboard", "frag-credit", "hot-reload"], CONFIRM_PASSES) and
       all(len(st) == 1 and p == 1 for st, p in calls[1:]),
       "one run of all the steps first, then each short step alone, a pass per process")
    c, f = classify(m, ["ui-scoreboard", "frag-credit", "hot-reload"])
    ok(c == ["ui-scoreboard", "hot-reload"] and f == {"frag-credit": (0, 3)},
       "the crash-starved steps are judged on 3 passes each")
    run_one, calls = fake_gate(lambda steps, passes: {s: ["pass"] * passes for s in steps})
    confirm(run_one, ["door", "push"])
    ok(len(calls) == 1, "steps that got all their passes in the first run are not run again")
    run_one, calls = fake_gate(lambda steps, passes: None)
    m = confirm(run_one, ["door"])
    ok(m["verdicts"]["door"] == [] and 1 < len(calls) <= 1 + CONFIRM_PASSES + 1,
       "a gate that never writes verdicts is retried a bounded number of times")
    ok(classify(m, ["door"]) == (["door"], {}), "and no evidence is no flake")
    run_one, calls = fake_gate(lambda steps, passes: {s: ["fail"] * (passes + 2) for s in steps})
    m = confirm(run_one, ["door"])
    ok(m["verdicts"]["door"] == ["fail"] * CONFIRM_PASSES, "no step is credited more passes than asked for")
    # what the confirm leads to
    ok(next_action(["door"], {}, "abc", True) == "BISECT", "3 of 3 is FAIL and is bisected when a green sha exists")
    ok(next_action(["door"], {}, "", True) == "NO-BASELINE", "with no green sha: FAIL, no baseline")
    ok(next_action(["door"], {}, "abc", False) == "NOT-ANCESTOR", "a green sha off main's history: FAIL, no bisect")
    ok(next_action([], {"door": (1, 3)}, "abc", True) == "FLAKY", "under 2 of 3 with nothing confirmed is FLAKY")
    ok(next_action([], {"door": (1, 3)}, "abc", True, ["shutdown"]) == "NEVER-RAN" and
       verdict_word("NEVER-RAN") == "FAIL", "a step that never gave a verdict anywhere is FAIL, not FLAKY")
    ok(verdict_word("NO-BASELINE") == "FAIL-NO-BASELINE" and verdict_word("FLAKY") == "FLAKY",
       "the verdict names the missing baseline")
    # the steps a crash kept the night run from reaching
    night = doc({"join": ["pass"], "hot-reload": ["fail"], "map-change": []})
    night["steps"].append("shutdown")
    ok(unrun_steps(night) == ["map-change", "shutdown"], "a step with no verdict at night is named unrun")
    ok(unrun_steps(None) == [], "no verdicts: no unrun steps (the caller reports the run failed)")
    # the per-step table
    t = "\n".join(step_table(doc({"ui-teammenu": ["fail"], "hot-reload": ["fail"]}),
                             doc({"ui-teammenu": ["fail"] * 3, "hot-reload": ["fail", "pass", "pass"],
                                  "shutdown": ["pass"] * 3}),
                             ["ui-teammenu", "hot-reload", "shutdown"], ["ui-teammenu"],
                             {"hot-reload": (1, 3), "shutdown": (0, 3)}, ["shutdown"]))
    ok(re.search(r"^\s*ui-teammenu\s+1 of 1 red\s+3 of 3 red\s+CONFIRMED$", t, re.M) and
       re.search(r"^\s*hot-reload\s+1 of 1 red\s+1 of 3 red\s+FLAKY$", t, re.M) and
       re.search(r"^\s*shutdown\s+not run\s+0 of 3 red\s+passed on confirm$", t, re.M),
       "the table shows each step's night and confirm counts and its verdict")
    ok(dedupe_failures([["a", "x"], ["a", "x"], ["b", "y"], ["a", "x"]]) == [("a", "x", 3), ("b", "y", 1)],
       "a failure the gate filed three times is reported once, with its count")
    # rounds
    ok(rounds_for(["door"], KNOWN_FLAKY) == 3, "a step not known flaky gets 3 passes")
    ok(rounds_for(["push"], KNOWN_FLAKY) == 5, "push at 1/6 needs 5 (3 risks 7.4%)")
    ok(rounds_for(["trigger"], KNOWN_FLAKY) == 9, "a known flake of unmeasured rate gets the most")
    ok(_tail(1 / 6.0, 5) < FALSE_BAD <= _tail(1 / 6.0, 3), "the 5% line falls between 3 and 5 for 1/6")
    # bisect verdict
    ok(bisect_verdict(doc({"door": ["fail", "fail", "pass"]}), ["door"]) == 1, "a majority of fails is bad")
    ok(bisect_verdict(doc({"door": ["fail", "pass", "pass"]}), ["door"]) == 0, "a minority is good")
    ok(bisect_verdict(doc({"join": ["pass"]}), ["door"]) == SKIP_EXIT, "a step that never ran is a skip")
    ok(bisect_verdict(None, ["door"]) == SKIP_EXIT, "no verdicts is a skip, never good")
    # rates file
    with tempfile.TemporaryDirectory() as d:
        def rates_of(body):
            p = os.path.join(d, "f.md")
            with open(p, "w") as fh:
                fh.write(body)
            return read_rates(p)
        r, w = rates_of("push fails 2 of 46 in prose\n```rates\npush\t2\t10\tsrc\nknock-loose\t4\t20\tsrc\n```\n")
        ok(w is None and r["push"] == (2, 10) and r["knock-loose"] == (4, 20),
           "the ```rates block overrides the built-in rates; the prose is not read")
        r, w = rates_of("push fails 2/10 in the long run\nknock-loose: 4 of 20\n")
        ok(w and r == KNOWN_FLAKY, "a document with no ```rates block: the built-in rates, and a warning")
        r, w = rates_of("```rates\npush\t9\n```\n")
        ok(w and "bad row" in w and r == KNOWN_FLAKY, "a malformed row: the built-in rates, and a warning")
        r, w = rates_of("```rates\npush\t9\t105\ts\npush\t1\t2\ts\n```\n")
        ok(w and r == KNOWN_FLAKY, "a step named twice: the built-in rates, and a warning")
        r, w = rates_of("```rates\npush\t9\t105\ts\n")
        ok(w and r == KNOWN_FLAKY, "an unterminated block: the built-in rates, and a warning")
        r, w = read_rates(os.path.join(d, "missing.md"))
        ok(w and r["push"] == (1, 6), "no document: the built-in rates, and a warning")
    # today's findings document: its prose quotes other N-of-M counts near the step names
    findings = os.path.join(ROOT, "docs", "plans", "gate_flakes_findings.md")
    r, w = read_rates(findings)
    ok(w is None, "the findings document's ```rates block reads without a warning")
    ok(r.get("push") == (0, 45), "the findings document's push rate is the block's 0/45 (since pushFloor), not a count in the prose")
    ok((r.get("trigger"), r.get("contact-touch"), r.get("knock-loose"), r.get("hot-reload")) ==
       ((4, 105), (4, 104), (8, 104), (4, 105)), "the findings document's other historical rates")
    # bisect output
    ok(parse_first_bad("Bisecting...\n0123456789abcdef0123456789abcdef01234567 is the first bad commit\ncommit 0123") ==
       "0123456789abcdef0123456789abcdef01234567", "the first bad commit is read off bisect run's output")
    ok(parse_first_bad("bisect run cannot continue any more") is None, "no named commit reads as None")
    ok(bisect_counts("# bad: [a] x\n# good: [b] y\ngit bisect start 'a' 'b'\n# skip: [c] z\n# good: [d] w\n"
                     "git bisect good d\n# bad: [e] v\n") == (1, 1, 1),
       "the tested good/bad/skip marks are counted, not the endpoints before the start")
    # reports
    ok(not report_status(None)[0], "a missing report is a failure")
    ok(not report_status("TIP x\nstep debug exit 0\n")[0], "a report that never finished is a failure")
    ok(not report_status("verdict FAIL\nexit 1\n")[0], "a failing report is a failure")
    ok(not report_status("verdict PASS\nexit 2\n")[0], "PASS with a non-zero exit is a failure")
    ok(not report_status("verdict FLAKY\nexit 0\n")[0], "only PASS or SKIP with exit 0 is green")
    ok(report_status("verdict SKIP\nexit 0\n")[0] and report_status("verdict PASS\nexit 0\n")[0],
       "PASS or SKIP with exit 0 is green")
    with tempfile.TemporaryDirectory() as d:
        r = Report(os.path.join(d, "2026-10-04-abc.log"))
        r.lines.append("TIP abc")
        r.finish("PASS", 0, os.path.join(d, "latest"))
        text = open(os.path.join(d, "latest")).read()
        ok(report_status(text)[0] and "TIP abc" in text, "a finished report is green through the latest link")
        r2 = Report(os.path.join(d, "2026-10-05-abd.log"))
        r2.finish("FAIL", 1, os.path.join(d, "latest"))
        ok(not report_status(open(os.path.join(d, "latest")).read())[0], "the link follows the newest report")
    # setup: follow setup's own --check, not only the pins (2026-10-05: new
    # files in our tree left farm/debug 5 links short and `make debug` refused)
    with tempfile.TemporaryDirectory() as d:
        wt, fork = os.path.join(d, "wt"), os.path.join(d, "fork")
        os.makedirs(os.path.join(wt, "farm", "debug"))
        os.makedirs(fork)
        rep = Report(os.path.join(d, "r.log"))
        ran = []

        def fake_step(report, name, cmd, cwd, env, log):
            ran.append(cmd)
            return 0

        def go(check_rc):
            del ran[:]
            rc = ensure_setup(rep, wt, fork, {}, os.path.join(d, "o"),
                              step=fake_step, check=lambda wt, env: check_rc)
            return rc, len(ran)

        ok(go(1) == (0, 1), "no stamp yet: setup runs")
        ok(go(0) == (0, 0), "pins unchanged and --check clean: setup is skipped")
        ok(go(1) == (0, 1), "pins unchanged but --check has work to do: setup runs")
        ok(ran and ran[0][:2] == ["make", "setup"], "the setup it runs is `make setup`")
        ok(go(0) == (0, 0), "after it, a clean --check skips again")
        with open(os.path.join(wt, "sdk-root.lock"), "w") as fh:
            fh.write("moved\n")
        ok(go(0) == (0, 1), "pins changed: setup runs even when --check is clean")
        ok(go(0) == (0, 0), "and the new pins are stamped")
    e = {"GIT_DIR": "/x/.git", "GIT_WORK_TREE": "/x", "PATH": "/bin", "GITHUB": "keep"}
    scrub_git_env(e)
    ok(e == {"PATH": "/bin", "GITHUB": "keep"}, "git's GIT_* variables are dropped, nothing else")
    ok(os.path.basename(ROOT) and os.path.isfile(os.path.join(ROOT, "tools", "daily-gate")),
       "the root is found from this file's own location")

    for good, name in checks:
        print("  %s  %s" % ("ok  " if good else "FAIL", name))
    bad = [n for g, n in checks if not g]
    print("\n%d check(s), %d failed" % (len(checks), len(bad)))
    return 1 if bad else 0


def scrub_git_env(environ):
    """Drop GIT_DIR and the rest of git's GIT_* variables. `git bisect run`
    exports them to the command it runs, and every git call below it -- make
    setup's look at the fork's HEAD, the fork's status -- then answers about
    the bisected repo instead (setup saw the fork at the commit under test,
    2026-10-04)."""
    for k in [k for k in environ if k.startswith("GIT_")]:
        del environ[k]


def main(argv):
    scrub_git_env(os.environ)
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--self-test", action="store_true")
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--bisect", nargs=2, metavar=("GOOD", "BAD"))
    ap.add_argument("--bisect-step", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--steps")
    ap.add_argument("--rounds", type=int, default=3)
    ap.add_argument("--worktree")
    ap.add_argument("--fork")
    ap.add_argument("--state")
    ap.add_argument("--log")
    ap.add_argument("--reset-to")
    ap.add_argument("--ref", default="main",
                    help="what to gate (default main; another ref is for proving the tool)")
    a = ap.parse_args(argv)
    if a.self_test:
        return self_test()
    if a.status:
        return status(a)
    if a.bisect_step:
        return bisect_step(a)
    if a.bisect:
        if not a.steps:
            ap.error("--bisect needs --steps")
        return bisect_only(a)
    return run(a)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

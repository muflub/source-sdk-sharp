#!/usr/bin/env python3
"""tools/daily-gate -- the once-a-day live gate, and the bisect when it fails.

    tools/daily-gate [--ref main]    run it: main's tip, in its own worktree
    tools/daily-gate --status        exit 0 only if the latest report is green
    tools/daily-gate --bisect GOOD BAD --steps a,b [--worktree DIR] [--reset-to REF]
                                     bisect GOOD..BAD on those steps alone
    tools/daily-gate --self-test

THE RULING (user, 2026-10-04): `make live-gate` runs once a day, on a
schedule (tools/systemd/sourcesharp-daily-gate.timer), not per commit and not
before each merge. An agent runs a gate by hand only when the user asks, or
to diagnose a failure a daily report shows.

ONE RUN:
  1. main's sha. If it is the last GREEN run's, the run is a SKIP, and says so
     in a report like any other.
  2. A worktree of its own (default: ss-daily-gate beside the main checkout),
     created detached at main if missing, else `git checkout --detach main`.
     It never moves a branch.
  3. tools/box-ready gate --wait; then, with a TMPDIR and DEBUG_API_DIR of its
     own (the gate picks and measures its own port): `make setup` when the
     pins changed since the last setup or `tools/setup --check` has work to
     do (the fork is only read), `make debug`,
     `make map MAP=ss_sandbox` (per-tree output the gate loads), `make
     live-gate` writing its verdicts as JSON.
  4. Green: the sha is recorded as the last green one.
  5. Red in the gate's steps: CONFIRM by re-running only the failing steps,
     and any step the night run never reached (a crash ends live-gate's
     process: nothing after it runs). One `live-gate --steps ... --passes 3`,
     then each step still short of 3 verdicts alone, one pass per process,
     so one crashing step cannot starve the rest (10-10 and 10-11 judged
     every step on 1 pass). A step that cannot reach 2 fails of 3 even if
     its missing passes had failed is FLAKY (counts and known rate
     reported), not bisected; "1 of 1" is not a flake. A per-step table
     (night, confirm, verdict) goes in the report. With no green sha on
     record the verdict is FAIL-NO-BASELINE: nothing to bisect from. A
     confirmed step
     is BISECTED from the last green sha to main (`git bisect run`, in the
     worktree, detached): each commit gets `make setup`, `make debug` and the
     steps over enough passes to beat their flake rate; setup or build
     failures are skips (125). The first bad commit, the counts and the
     bisect log go in the report and in <date>-bisect.txt.
  Always: `git bisect reset`, the worktree left detached at main, and the
  fork checked for writes (`git status --porcelain` must stay empty).

THE REPORT: $XDG_STATE_HOME/sourcesharp/daily-gate (else ~/.local/state/...)
<date>-<sha>.log, with TIP, every step's exit code and wall time, the verdict
and the run's exit code, and a `latest` link to it. A run that never wrote a
report, or a report whose exit is not 0, is a FAILURE to --status: never a
pass.

Finds its root from its own location; the worktree, the fork and the state
directory are arguments with defaults derived from it.
"""

import argparse
import datetime
import hashlib
import json
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.dirname(HERE)

# Steps known to fail now and then without a regression, and their measured
# rates (fails, runs) where known; None is "known flaky, rate not measured".
# docs/plans/gate_flakes_findings.md overrides these when it is present.
KNOWN_FLAKY = {"push": (1, 6), "knock-loose": (3, 20), "contact-touch": None, "trigger": None}
UNKNOWN_RATE = 0.25        # assumed for a step known flaky with no measured rate
FALSE_BAD = 0.05           # the most a bisect may risk calling a flake a regression
CONFIRM_PASSES = 3
CONFIRM_MIN_FAILS = 2      # of CONFIRM_PASSES, for a failure to be real
MAX_ROUNDS = 9
SKIP_EXIT = 125            # git bisect run: this commit cannot be tested
# The gate's map-change step loads ss_sandbox, which is per-tree build output
# (never copied between trees): a fresh worktree has none, and the step fails
# for that alone. Regenerated and compiled each run, about 7 s.
SANDBOX_MAP = ["make", "map", "MAP=ss_sandbox"]


# ===========================================================================
# PURE DECISIONS (driven by --self-test with faked results)
# ===========================================================================
def decide_skip(main_sha, last_green):
    """Skip the run when main has not moved since the last green run."""
    return bool(main_sha) and main_sha == last_green


def failing_steps(doc, known_steps=None):
    """The steps a verdicts JSON says failed (a `fail` on any pass, or a
    failure filed under that step), in the order the run ran them."""
    if not doc:
        return []
    steps = doc.get("steps") or []
    bad = {s for s, v in (doc.get("verdicts") or {}).items() if "fail" in v}
    bad |= {f[0] for f in doc.get("failures") or [] if f and f[0] in steps}
    if known_steps is not None:
        bad &= set(known_steps)
    return [s for s in steps if s in bad] + sorted(bad - set(steps))


def fail_counts(doc, steps):
    """{step: (fails, passes)} over the passes of a verdicts JSON."""
    out = {}
    for s in steps:
        got = (doc.get("verdicts") or {}).get(s, []) if doc else []
        out[s] = (sum(1 for v in got if v == "fail"), len(got))
    return out


def classify(confirm_doc, steps):
    """(confirmed, flaky): flaky is {step: (fails, passes)}. A step is FLAKY
    only when it cannot reach CONFIRM_MIN_FAILS of CONFIRM_PASSES even if every
    pass it is missing had failed; everything else is confirmed. So "1 of 1"
    (the other passes never ran: a crash ends the gate's process) is not a
    flake -- no evidence is not evidence of a flake, and it goes to the bisect,
    whose own verdict per commit is again a majority of the passes it got."""
    counts = fail_counts(confirm_doc, steps)
    confirmed, flaky = [], {}
    for s in steps:
        fails, passes = counts[s]
        missing = max(0, CONFIRM_PASSES - passes)
        if fails >= CONFIRM_MIN_FAILS or fails + missing >= CONFIRM_MIN_FAILS:
            confirmed.append(s)
        else:
            flaky[s] = (fails, passes)
    return confirmed, flaky


def confirm(run_one, steps, passes=CONFIRM_PASSES):
    """Give each of `steps` `passes` verdicts. `run_one(steps, passes)` runs
    one live-gate process and returns its verdicts JSON (or None).

    The gate stops its whole process at a crash (live-gate's pass loop: "Nothing
    after it ran"), so one `--passes 3` run gave every step ONE verdict on
    10-10 and 10-11. Hence: one run of all the steps, then each step still
    short runs ALONE, one pass per process, so a crash costs one pass of one
    step. A process that adds nothing is still an attempt: each step gets at
    most its shortfall plus one."""
    merged = {"steps": list(steps), "passes": passes, "verdicts": {s: [] for s in steps},
              "failures": [], "runs": []}

    def take(doc, wanted, asked):
        added = 0
        for s in wanted:
            got = ((doc or {}).get("verdicts") or {}).get(s, [])
            room = passes - len(merged["verdicts"][s])
            merged["verdicts"][s] += got[:max(0, room)]
            added += min(len(got), max(0, room))
        merged["failures"] += [list(f) for f in (doc or {}).get("failures") or [] if f and f[0] in wanted]
        merged["runs"].append({"steps": list(wanted), "passes": asked,
                               "exit": (doc or {}).get("exit"), "verdicts_added": added})

    take(run_one(steps, passes), steps, passes)
    for s in steps:
        short = passes - len(merged["verdicts"][s])
        for _ in range(short + 1 if short > 0 else 0):
            if len(merged["verdicts"][s]) >= passes:
                break
            take(run_one([s], 1), [s], 1)
    return merged


def unrun_steps(doc):
    """The steps a verdicts JSON lists but never gave a verdict: the game
    died before them (a crash ends the process), so they are neither red nor
    green, and a run with any of them is not green."""
    if not doc:
        return []
    v = doc.get("verdicts") or {}
    return [s for s in doc.get("steps") or [] if not v.get(s)]


def next_action(confirmed, flaky, last_green, is_ancestor, never_ran=()):
    """What follows the confirm: FLAKY (nothing confirmed), NEVER-RAN
    (nothing confirmed, but a step never gave a verdict at all: not green, and
    nothing to bisect on), NO-BASELINE (no green run on record), NOT-ANCESTOR
    (the green sha is off main's history), or BISECT."""
    if not confirmed:
        return "NEVER-RAN" if never_ran else "FLAKY"
    if not last_green:
        return "NO-BASELINE"
    if not is_ancestor:
        return "NOT-ANCESTOR"
    return "BISECT"


def verdict_word(action):
    return {"FLAKY": "FLAKY", "NO-BASELINE": "FAIL-NO-BASELINE"}.get(action, "FAIL")


def _red(counts):
    fails, passes = counts
    return "not run" if passes == 0 else "%d of %d red" % (fails, passes)


def step_table(night_doc, confirm_doc, steps, confirmed, flaky, unrun=()):
    """The per-step picture a person reads first: night and confirm counts,
    and what each step was ruled."""
    night = fail_counts(night_doc, steps)
    conf = fail_counts(confirm_doc, steps)
    rows = [("step", "night", "confirm", "verdict")]
    for s in steps:
        if s in unrun and conf[s][1] == 0:
            word = "never ran"
        elif s in confirmed:
            word = "CONFIRMED"
        elif s in unrun and conf[s][0] == 0 and conf[s][1] > 0:
            word = "passed on confirm"
        elif s in flaky:
            word = "FLAKY"
        else:
            word = "?"
        rows.append((s, _red(night[s]), _red(conf[s]), word))
    return ["  %-18s %-14s %-14s %s" % r for r in rows]


def dedupe_failures(failures):
    """[(step, message, times)] in first-seen order: the gate files some
    failures once per pass it reports, so the raw list repeats them."""
    seen = {}
    for f in failures or []:
        if not f:
            continue
        key = (f[0], f[1] if len(f) > 1 else "")
        seen[key] = seen.get(key, 0) + 1
    return [(k[0], k[1], n) for k, n in seen.items()]


def _tail(p, rounds):
    need = rounds // 2 + 1
    return sum(math.comb(rounds, k) * p ** k * (1 - p) ** (rounds - k) for k in range(need, rounds + 1))


def rounds_for(steps, rates):
    """The fewest odd passes for which a majority of flake failures is under
    FALSE_BAD, at the worst rate among `steps` (3 at least)."""
    p = 0.0
    for s in steps:
        if s in rates:
            r = rates[s]
            p = max(p, UNKNOWN_RATE if r is None else r[0] / float(r[1]))
    for rounds in range(3, MAX_ROUNDS + 1, 2):
        if _tail(p, rounds) < FALSE_BAD:
            return rounds
    return MAX_ROUNDS


def bisect_verdict(doc, steps):
    """git bisect run's answer for one commit: 1 (bad) when any of `steps`
    failed in a majority of its passes, 0 (good) when all passed a majority,
    SKIP_EXIT when there is no verdict for a step."""
    if not doc:
        return SKIP_EXIT
    for s, (fails, passes) in fail_counts(doc, steps).items():
        if passes == 0:
            return SKIP_EXIT
        if fails > passes // 2:
            return 1
    return 0


RATES_FENCE = "```rates"


def read_rates(path, steps=None):
    """(rates, warning). The findings document's fenced ```rates block, one
    `step<TAB>failures<TAB>passes<TAB>source` row per step, overrides
    KNOWN_FLAKY. Only that block is read: the prose quotes other N-of-M counts
    (a push row cites "34 of 46 samples"). A missing document, a missing block,
    or any malformed row is a failure of the lookup: the rates are KNOWN_FLAKY
    alone and the warning says why. `steps` is accepted for the callers; the
    whole block is returned."""
    rates = dict(KNOWN_FLAKY)
    try:
        text = open(path, encoding="utf-8").read()
    except (OSError, UnicodeDecodeError) as e:
        return rates, "rates: cannot read %s (%s); using the built-in rates" % (path, e)
    lines = text.splitlines()
    starts = [i for i, ln in enumerate(lines) if ln.strip() == RATES_FENCE]
    if len(starts) != 1:
        return rates, "rates: %s has %d ```rates blocks, not 1; using the built-in rates" % (path, len(starts))
    found = {}
    closed = False
    for ln in lines[starts[0] + 1:]:
        if ln.strip() == "```":
            closed = True
            break
        if not ln.strip() or ln.startswith("#"):
            continue
        f = ln.split("\t")
        if (len(f) != 4 or not f[0] or not re.fullmatch(r"\d+", f[1]) or not re.fullmatch(r"\d+", f[2])
                or int(f[2]) == 0 or int(f[1]) > int(f[2]) or f[0] in found):
            return rates, "rates: bad row %r in %s; using the built-in rates" % (ln, path)
        found[f[0]] = (int(f[1]), int(f[2]))
    if not closed or not found:
        return rates, "rates: the ```rates block in %s is %s; using the built-in rates" % (
            path, "unterminated" if not closed else "empty")
    rates.update(found)
    return rates, None


def parse_first_bad(text):
    """The sha git bisect names as the first bad commit, or None."""
    m = re.search(r"^([0-9a-f]{7,40}) is the first bad commit", text, re.M)
    return m.group(1) if m else None


def bisect_counts(log):
    """(good, bad, skipped) commits a `git bisect log` recorded as TESTED:
    the marks after `git bisect start`, not the two endpoints logged before it."""
    at = log.find("git bisect start")
    log = log[log.find("\n", at) + 1:] if at >= 0 else log
    good = len(re.findall(r"^# good: ", log, re.M))
    bad = len(re.findall(r"^# bad: ", log, re.M))
    skip = len(re.findall(r"^# skip: ", log, re.M))
    return good, bad, skip


def report_status(text):
    """(ok, why) of a report's text: ok only with `exit 0` and a PASS or SKIP verdict."""
    if text is None:
        return False, "no report: the run never wrote one"
    m = re.search(r"^exit (-?\d+)$", text, re.M)
    v = re.search(r"^verdict (\S+)", text, re.M)
    if not m or not v:
        return False, "the report has no exit/verdict line: the run did not finish"
    if int(m.group(1)) != 0 or v.group(1) not in ("PASS", "SKIP"):
        return False, "verdict %s, exit %s" % (v.group(1), m.group(1))
    return True, "verdict %s, exit 0" % v.group(1)



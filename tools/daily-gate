def state_dir(override=None):
    base = override or os.path.join(
        os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
        "sourcesharp", "daily-gate")
    os.makedirs(base, exist_ok=True)
    return base


def git(cwd, *args, check=True):
    p = subprocess.run(["git", "-C", cwd] + list(args), capture_output=True, text=True)
    if check and p.returncode != 0:
        raise RuntimeError("git %s: %s" % (" ".join(args), p.stderr.strip()))
    return p.stdout.strip()


def main_checkout():
    common = git(ROOT, "rev-parse", "--path-format=absolute", "--git-common-dir")
    return os.path.dirname(common)


class Report:
    def __init__(self, path):
        self.path = path
        self.lines = []
        self.start = time.time()

    def say(self, line):
        line = line.rstrip("\n")
        self.lines.append(line)
        print(line, flush=True)

    def finish(self, verdict, rc, latest=None):
        self.say("verdict %s" % verdict)
        self.say("wall %.0f s" % (time.time() - self.start))
        self.say("exit %d" % rc)
        tmp = self.path + ".tmp"
        with open(tmp, "w") as f:
            f.write("\n".join(self.lines) + "\n")
        os.replace(tmp, self.path)
        if latest:
            try:
                os.unlink(latest)
            except OSError:
                pass
            os.symlink(os.path.basename(self.path), latest)
        return rc


def run_step(report, name, cmd, cwd, env, log):
    """Run one step, its output to `log`; record name, exit code, wall time."""
    t = time.time()
    with open(log, "ab") as f:
        f.write(("\n==== %s: %s\n" % (name, " ".join(cmd))).encode())
        f.flush()
        rc = subprocess.run(cmd, cwd=cwd, env=env, stdout=f, stderr=subprocess.STDOUT,
                            stdin=subprocess.DEVNULL).returncode
    report.say("step %-12s exit %-4d %6.0f s" % (name, rc, time.time() - t))
    return rc


def setup_stamp(wt, fork):
    h = hashlib.sha256(os.path.realpath(fork).encode())
    for rel in ("sdk-root.lock", "tools/setup", "tools/module-map.tsv"):
        try:
            h.update(open(os.path.join(wt, rel), "rb").read())
        except OSError:
            h.update(b"-")
    links = os.path.join(wt, "sdk-links")
    for name in sorted(os.listdir(links)) if os.path.isdir(links) else []:
        h.update(open(os.path.join(links, name), "rb").read())
    return h.hexdigest()


def setup_check(wt, env):
    """`tools/setup --check --config debug`, the same check `make debug` runs
    before it builds (the Makefile's require-setup): non-zero when the farm
    or bin/ is short of anything -- a new file in our tree is a missing farm
    link, and the pins never see it (2026-10-05). A report only: it changes
    nothing and costs ~0.15 s."""
    return subprocess.run([os.path.join(wt, "tools", "setup"), "--check", "--config", "debug"],
                          cwd=wt, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                          stdin=subprocess.DEVNULL).returncode


def ensure_setup(report, wt, fork, env, log, force=False, step=run_step, check=setup_check):
    """`make setup` when the pins it reads changed since the last one here, or
    when setup's own --check has anything to do."""
    stamp_path = os.path.join(wt, ".daily-gate-setup")
    want = setup_stamp(wt, fork)
    have = open(stamp_path).read().strip() if os.path.exists(stamp_path) else ""
    pins_same = have == want and os.path.isdir(os.path.join(wt, "farm", "debug"))
    if not force and pins_same:
        if check(wt, env) == 0:
            report.say("step %-12s (pins unchanged, setup --check clean)" % "setup")
            return 0
        report.say("step %-12s (pins unchanged, but setup --check has work to do)" % "setup")
    rel = os.path.relpath(fork, wt)
    rc = step(report, "setup", ["make", "setup", "ROOT=" + rel], wt, env, log)
    if rc == 0:
        with open(stamp_path, "w") as f:
            f.write(want + "\n")
    return rc


def gate_env(state, run_id):
    env = dict(os.environ)
    tmp = os.path.join(state, "tmp", run_id)
    os.makedirs(tmp, exist_ok=True)
    env["TMPDIR"] = tmp
    # Short: a socket path is at most 108 bytes (live-gate lane pitfalls).
    sock = "/tmp/ss-dg-%d" % os.getpid()
    os.makedirs(sock, exist_ok=True)
    env["DEBUG_API_DIR"] = sock
    return env, tmp, sock


def live_gate(report, name, wt, env, log, verdicts, steps=None, passes=None):
    args = "--verdicts %s" % verdicts
    if steps:
        args += " --steps %s" % ",".join(steps)
    if passes:
        args += " --passes %d" % passes
    try:
        os.unlink(verdicts)
    except OSError:
        pass
    rc = run_step(report, name, ["make", "live-gate", "LIVE_ARGS=" + args], wt, env, log)
    try:
        doc = json.load(open(verdicts))
    except (OSError, ValueError):
        doc = None
    return rc, doc


def fork_clean(report, fork):
    out = git(fork, "status", "--porcelain", check=False)
    n = len([l for l in out.splitlines() if l.strip()])
    report.say("fork %s: %d change(s) (%s)" % (fork, n, "read-only" if n == 0 else "WRITTEN TO"))
    return n == 0


def ensure_worktree(wt, ref="main"):
    if os.path.isdir(os.path.join(wt, ".git")) or os.path.isfile(os.path.join(wt, ".git")):
        git(wt, "checkout", "--detach", ref)
    else:
        git(main_checkout(), "worktree", "add", "--detach", wt, ref)


def bisect(report, wt, fork, good, bad, steps, rates, state, env, log, stamp):
    """git bisect run over good..bad in `wt`, on `steps`. Returns the
    bisect.txt path. Always resets the bisect."""
    rounds = rounds_for(steps, rates)
    report.say("bisect %s..%s on %s, %d pass(es) per commit" % (good[:12], bad[:12], ",".join(steps), rounds))
    # A copy of this script runs each commit: the commit under test may not
    # have tools/daily-gate, or have another one.
    runner_dir = tempfile.mkdtemp(prefix="bisect-", dir=state)
    runner = os.path.join(runner_dir, "daily-gate")
    shutil.copy(os.path.realpath(__file__), runner)
    out_text, blog = "", ""
    try:
        git(wt, "bisect", "reset", check=False)
        git(wt, "bisect", "start", bad, good)
        p = subprocess.run(["git", "-C", wt, "bisect", "run", sys.executable, runner, "--bisect-step",
                            "--worktree", wt, "--fork", fork, "--steps", ",".join(steps),
                            "--rounds", str(rounds), "--state", state, "--log", log],
                           env=env, capture_output=True, text=True)
        out_text = p.stdout + p.stderr
        blog = git(wt, "bisect", "log", check=False)
    finally:
        git(wt, "bisect", "reset", check=False)
        shutil.rmtree(runner_dir, ignore_errors=True)
    first = parse_first_bad(out_text)
    g, b, s = bisect_counts(blog)
    lines = ["bisect %s..%s, steps %s, %d pass(es) per commit" % (good, bad, ",".join(steps), rounds),
             "tested: %d good, %d bad, %d skipped" % (g, b, s)]
    if first:
        info = git(wt, "show", "-s", "--format=%H%n%s%n%an <%ae>%n%ad", first, check=False).splitlines()
        lines += ["FIRST BAD COMMIT %s" % info[0], "  subject %s" % info[1],
                  "  author  %s" % info[2], "  date    %s" % info[3]]
    else:
        lines.append("NO FIRST BAD COMMIT named (every commit skipped, or the bisect failed):")
        lines += ["  " + l for l in out_text.strip().splitlines()[-15:]]
    lines += ["", "-- git bisect log"] + blog.splitlines()
    path = os.path.join(state, "%s-bisect.txt" % stamp)
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    for l in lines:
        report.say(l)
    return path, first


def bisect_step(args):
    """One commit, under `git bisect run`: 0 good, 1 bad, 125 skip."""
    wt, fork = args.worktree, args.fork
    steps = args.steps.split(",")
    state = state_dir(args.state)
    head = git(wt, "rev-parse", "HEAD")
    report = Report(os.path.join(state, "bisect-step-%s.log" % head[:12]))
    env = dict(os.environ)
    log = args.log or os.path.join(state, "bisect-%s.out" % head[:12])
    report.say("commit %s" % head)
    if ensure_setup(report, wt, fork, env, log) != 0:
        report.say("setup failed: skip")
        return SKIP_EXIT
    if run_step(report, "debug", ["make", "debug"], wt, env, log) != 0:
        report.say("build failed: skip")
        return SKIP_EXIT
    if run_step(report, "map", SANDBOX_MAP, wt, env, log) != 0:
        report.say("the sandbox map did not build: skip")
        return SKIP_EXIT
    helptext = subprocess.run([os.path.join(wt, "tools", "live-gate"), "--help"],
                              cwd=wt, capture_output=True, text=True).stdout
    if "--steps" not in helptext or "--verdicts" not in helptext:
        report.say("this commit's live-gate has no --steps/--verdicts: skip")
        return SKIP_EXIT
    base = os.path.join(state, "verdicts-%s" % head[:12])
    doc = confirm(confirm_runner(report, wt, env, log, base), steps, args.rounds)
    v = bisect_verdict(doc, steps)
    report.say("counts %s -> %s" % (fail_counts(doc, steps) if doc else "no verdicts",
                                    {0: "good", 1: "bad"}.get(v, "skip")))
    fork_ok = fork_clean(report, fork)
    return v if fork_ok else SKIP_EXIT


def run(args):
    state = state_dir(args.state)
    wt = os.path.abspath(args.worktree or os.path.join(os.path.dirname(main_checkout()), "ss-daily-gate"))
    fork = os.path.abspath(args.fork or os.path.join(os.path.dirname(wt), "source-sdk-2013"))
    sha = git(ROOT, "rev-parse", args.ref)
    stamp = "%s-%s" % (datetime.date.today().isoformat(), sha[:12])
    report = Report(os.path.join(state, stamp + ".log"))
    latest = os.path.join(state, "latest")
    green_path = os.path.join(state, "last-green")
    last_green = open(green_path).read().strip() if os.path.exists(green_path) else ""

    report.say("daily-gate %s" % datetime.datetime.now().isoformat(timespec="seconds"))
    report.say("TIP %s" % sha)
    report.say("last-green %s" % (last_green or "(none)"))
    try:
        report.say("last-green provenance: " + open(green_path + ".provenance").readline().strip())
    except OSError:
        pass
    report.say("worktree %s" % wt)
    if decide_skip(sha, last_green):
        report.say("main has not moved since the last green run: nothing to gate")
        return report.finish("SKIP", 0, latest)

    log = os.path.join(state, stamp + ".out")
    env, tmp, sock = gate_env(state, stamp)
    rc, verdict = 1, "FAIL"
    try:
        ensure_worktree(wt, sha)
        report.say("worktree at %s" % git(wt, "rev-parse", "HEAD"))
        run_step(report, "box-ready", [os.path.join(wt, "tools", "box-ready"), "gate", "--wait"], wt, env, log)
        if ensure_setup(report, wt, fork, env, log) != 0:
            report.say("setup failed: see %s" % log)
        elif run_step(report, "debug", ["make", "debug"], wt, env, log) != 0:
            report.say("the build failed: see %s" % log)
        elif run_step(report, "map", SANDBOX_MAP, wt, env, log) != 0:
            report.say("the sandbox map did not build: see %s" % log)
        else:
            vpath = os.path.join(state, stamp + "-verdicts.json")
            grc, doc = live_gate(report, "live-gate", wt, env, log, vpath)
            if grc == 0 and doc and doc.get("exit") == 0:
                rc, verdict = 0, "PASS"
            elif not doc:
                report.say("the gate wrote no verdicts (exit %d): see %s" % (grc, log))
            else:
                failing = failing_steps(doc)
                unrun = unrun_steps(doc)
                report.say("failing steps: %s" % (", ".join(failing) or "(none named)"))
                if unrun:
                    report.say("steps the night run never reached (the game died first): %s" % ", ".join(unrun))
                for step, msg, times in dedupe_failures(doc.get("failures")):
                    report.say("  failure %-14s %s%s" % (step, msg, "" if times == 1 else "  (x%d)" % times))
                if failing:
                    verdict = triage(report, wt, fork, failing, last_green, sha, state, env, log, stamp,
                                     night=doc, unrun=unrun)
        if not fork_clean(report, fork):
            rc, verdict = 1, "FAIL-FORK-WRITTEN"
        if rc == 0:
            with open(green_path, "w") as f:
                f.write(sha + "\n")
            with open(green_path + ".provenance", "w") as f:
                f.write("daily-gate PASS, report %s\n" % report.path)
    except Exception as exc:  # noqa: BLE001 -- the report must still be written
        report.say("daily-gate raised: %r" % exc)
        rc, verdict = 1, "ERROR"
    finally:
        try:
            git(wt, "bisect", "reset", check=False)
            git(wt, "checkout", "--detach", sha, check=False)
        except Exception:  # noqa: BLE001
            pass
        shutil.rmtree(tmp, ignore_errors=True)
        shutil.rmtree(sock, ignore_errors=True)
    report.say("log %s" % log)
    return report.finish(verdict, rc, latest)


def confirm_runner(report, wt, env, log, base):
    """run_one for confirm(): one live-gate process per call, each with its
    own verdicts file (<base>-<n>.json) so no run overwrites another's."""
    n = [0]

    def run_one(steps, passes):
        n[0] += 1
        path = "%s-%d.json" % (base, n[0])
        _rc, doc = live_gate(report, "confirm-%d" % n[0], wt, env, log, path, steps, passes)
        return doc
    return run_one


def triage(report, wt, fork, failing, last_green, sha, state, env, log, stamp, night=None, unrun=()):
    """Confirm the failing steps (and those the night run never reached);
    bisect the confirmed ones. Returns the verdict word."""
    rates, warn = read_rates(os.path.join(wt, "docs", "plans", "gate_flakes_findings.md"), failing)
    if warn:
        report.say("WARNING " + warn)
    steps = list(failing) + [s for s in unrun if s not in failing]
    cpath = os.path.join(state, stamp + "-confirm.json")
    cdoc = confirm(confirm_runner(report, wt, env, log, cpath[:-len(".json")]), steps)
    with open(cpath, "w") as f:
        json.dump(cdoc, f, indent=1)
    confirmed, flaky = classify(cdoc, steps)
    # A step the night never reached that passes every confirm pass is green;
    # one that gave no verdict on confirm either is unknown: never bisected
    # (every commit would be a skip), and the run is not green.
    never_ran = []
    for s in unrun:
        if s in failing:
            continue
        if fail_counts(cdoc, [s])[s][1] == 0:
            never_ran.append(s)
            confirmed.remove(s)
        elif flaky.get(s, (1, 0))[0] == 0:
            del flaky[s]
    report.say("confirm: each step's verdicts over %d pass(es), %d live-gate process(es)"
               % (CONFIRM_PASSES, len(cdoc["runs"])))
    for l in step_table(night, cdoc, steps, confirmed, flaky, unrun):
        report.say(l)
    for s, (f, n) in flaky.items():
        r = rates.get(s, "not known flaky")
        known = "unmeasured" if r is None else ("%d/%d" % r if isinstance(r, tuple) else r)
        report.say("FLAKY %s: failed %d of %d confirm passes (known rate: %s); not bisected" % (s, f, n, known))
    for s in confirmed:
        f, n = fail_counts(cdoc, [s])[s]
        if n < CONFIRM_PASSES:
            report.say("CONFIRMED %s on %d of %d pass(es): the other %d never gave a verdict"
                       % (s, f, n, CONFIRM_PASSES - n))
    ancestor = bool(last_green) and subprocess.run(
        ["git", "-C", wt, "merge-base", "--is-ancestor", last_green, sha]).returncode == 0
    if never_ran:
        report.say("NEVER RAN %s: no verdict at night or on confirm (see the log)" % ", ".join(never_ran))
    action = next_action(confirmed, flaky, last_green, ancestor, never_ran)
    if action in ("FLAKY", "NEVER-RAN"):
        return verdict_word(action)
    report.say("CONFIRMED %s" % ", ".join(confirmed))
    if action == "NO-BASELINE":
        report.say("no baseline: no green run is on record, so there is nothing to bisect from; "
                   "the red steps are the CONFIRMED rows above")
        return verdict_word(action)
    if action == "NOT-ANCESTOR":
        report.say("the last green %s is not an ancestor of %s: cannot bisect" % (last_green[:12], sha[:12]))
        return verdict_word(action)
    _path, first = bisect(report, wt, fork, last_green, sha, confirmed, rates, state, env, log, stamp)
    return "FAIL-BISECTED" if first else "FAIL"


def status(args):
    state = state_dir(args.state)
    latest = os.path.join(state, "latest")
    try:
        text = open(latest).read()
    except OSError:
        text = None
    ok, why = report_status(text)
    print("daily-gate: %s (%s)" % ("GREEN" if ok else "NOT GREEN", why))
    return 0 if ok else 1


def bisect_only(args):
    """--bisect GOOD BAD: the bisect path alone (proof and diagnosis)."""
    state = state_dir(args.state)
    wt = os.path.abspath(args.worktree or ROOT)
    fork = os.path.abspath(args.fork or os.path.join(os.path.dirname(wt), "source-sdk-2013"))
    good, bad = (git(wt, "rev-parse", r) for r in args.bisect)
    steps = args.steps.split(",")
    stamp = "%s-%s" % (datetime.date.today().isoformat(), bad[:12])
    report = Report(os.path.join(state, stamp + "-bisect-only.log"))
    report.say("TIP %s" % bad)
    env, tmp, sock = gate_env(state, stamp)
    log = os.path.join(state, stamp + "-bisect-only.out")
    reset_to = args.reset_to or git(wt, "rev-parse", "--abbrev-ref", "HEAD")
    rates, warn = read_rates(os.path.join(wt, "docs", "plans", "gate_flakes_findings.md"), steps)
    if warn:
        report.say("WARNING " + warn)
    first = None
    try:
        _p, first = bisect(report, wt, fork, good, bad, steps, rates, state, env, log, stamp)
    finally:
        git(wt, "bisect", "reset", check=False)
        git(wt, "checkout", reset_to, check=False)
        shutil.rmtree(tmp, ignore_errors=True)
        shutil.rmtree(sock, ignore_errors=True)
    return report.finish("BISECTED" if first else "FAIL", 0 if first else 1)



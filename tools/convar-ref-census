#!/usr/bin/env python3
"""tools/convar-ref-census -- every native site that reads a ConVar managed
code declares.

    tools/convar-ref-census              the table, tab-separated
    tools/convar-ref-census --count      the three totals only
    tools/convar-ref-census --self-test  check this script's own reporting
    --build-dir D                        the CMake build (default <root>/build,
                                         i.e. farm/<config>/build from the farm)

    exit 0   measured
    exit 2   the CMake build could not be read (or is stale against the
             CMakeLists source lists), or the scan lost its subject


WHY THIS IS NOT tools/shim-census
=================================

A ConVar is reached BY NAME.

    static CManagedConVarRef r_SnowEnable( "r_SnowEnable" );

takes a string and asks `ICvar` for it at first use.  There is no symbol for a
link-line join to work with, so `tools/shim-census` -- which is exactly such a
join, and is right to be -- has nothing to report about any of these.  That
blind spot is not theoretical: it is what made the "dead" physics-world
scaffolding look removable when eight tools and twenty-seven sites were driving
it.

So this is a TEXT scan, and the thing that keeps it honest is its subject: the
SOURCES of every object on the server.so and client.so link edges of the
CMake build (tools/cmakegraph.py: compile_commands.json, cross-checked against
the CMakeLists source lists and against the link edge's object count in
build.ninja), plus every reachable header.
A `CManagedConVarRef` in a translation unit the build does not compile is not a
site, and counting one is how a number comes out too big -- `plan_shim.md`'s
figure of forty includes two in `game/client/c_baseanimating.cpp`, which is on
neither link line.


WHAT A ROW MEANS
================

A NATIVE DECISION reading a value the MANAGED side owns.  The ConVar has
already moved; what has not is the code that reads it.  `plan_shim.md` §10's
ConVar ledger (Phase 5) is where each row gets its verdict --
`docs/convar-native-reads.md` sets out the three shapes a verdict can take.
"""

import io
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import cmakegraph  # noqa: E402

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
# Run from the farm (farm/<config>/tools is a link to the repo's), the build is
# the farm's own build/. Run from the repo (the runner leg's --self-test), it is
# the config's farm build -- cmakegraph.build_dir, $SOURCESHARP_BUILD_DIR first.
# Either way the sources scanned are that build's farm src/.
BUILD_DIR = os.path.join(ROOT, "build")
if not os.path.isdir(BUILD_DIR):
    BUILD_DIR = cmakegraph.build_dir(os.environ.get("SOURCESHARP_CONFIG") or "debug")
SRC = cmakegraph.farm_src(BUILD_DIR)

# `CManagedConVarRef name( "convar" )`, which is how every one of them is
# spelled: the reference is constructed with the NAME and resolves at first use.
DECL = re.compile(r"CManagedConVarRef\s+(\w+)\s*\(\s*\"([^\"]+)\"")

# Any mention at all, so a member declaration (`CManagedConVarRef m_ref;`) is a
# site too -- it is still a native read, it just names its convar elsewhere.
USE = re.compile(r"\bCManagedConVarRef\b")

def die(msg):
    sys.stderr.write("tools/convar-ref-census: %s\n" % msg)
    sys.exit(2)


def compiled_sources():
    """{farm-relative source: {"server", "client"}} off the two link edges."""
    out = {}
    try:
        for side, target in sorted(cmakegraph.SIDES.items()):
            srcs = cmakegraph.compiled_sources(target, BUILD_DIR)
            n = len(cmakegraph.link_edge(target, BUILD_DIR)["objects"])
            if n != len(srcs):
                die("build.ninja links %d objects into %s but compile_commands.json "
                    "compiles %d sources" % (n, target, len(srcs)))
            for rel in srcs:
                out.setdefault(rel, set()).add(side)
    except cmakegraph.GraphError as e:
        die("cannot read the CMake build at %s: %s. Build first: make debug."
            % (BUILD_DIR, e))
    if len(out) < 100:
        die("only %d compiled sources parsed out of the build; the scan lost "
            "its subject" % len(out))
    return out


def reachable_headers():
    out = []
    for base, dirs, files in os.walk(SRC):
        if "_vpc_" in base or "/thirdparty/" in base:
            continue
        for fn in files:
            if fn.endswith((".h", ".inl")):
                out.append(os.path.relpath(os.path.join(base, fn), SRC))
    return out


def census():
    paths = compiled_sources()
    for rel in reachable_headers():
        paths.setdefault(rel, set())

    rows = []
    for rel in sorted(paths):
        # The type's own header, and the tests that assert about it, are not
        # sites: one declares it and the others measure it.
        if rel.endswith("managed_convar_ref.h") or rel.startswith("sourcesharp/test/"):
            continue
        try:
            text = io.open(os.path.join(SRC, rel), encoding="utf-8",
                           errors="replace").read()
        except OSError:
            continue
        if "CManagedConVarRef" not in text:
            continue

        sides = "+".join(sorted(paths[rel])) or "header"
        for i, line in enumerate(text.splitlines(), 1):
            if not USE.search(line):
                continue
            s = line.strip()
            if s.startswith("//") or s.startswith("*"):
                continue
            m = DECL.search(line)
            rows.append((rel, i, sides, m.group(2) if m else "", s[:110]))
    return rows


def self_test():
    ok = True

    def check(name, cond, detail=""):
        nonlocal ok
        print("%-56s %s%s" % (name, "ok" if cond else "FAIL",
                              "" if cond else "  " + detail))
        ok = ok and cond

    check("the declaration form is recognised",
          DECL.search('static CManagedConVarRef r_SnowEnable( "r_SnowEnable" );')
          .group(2) == "r_SnowEnable")
    check("a member declaration is a site with no name",
          USE.search("\tCManagedConVarRef m_r_lightmap_bicubic_set;") is not None
          and DECL.search("\tCManagedConVarRef m_r_lightmap_bicubic_set;") is None)
    check("the type's own name does not match a plain ConVarRef",
          USE.search("static ConVarRef foo( \"foo\" );") is None)
    check("a compiled file maps to its farm-relative source",
          cmakegraph.farm_relative("/f/src/sourcesharp/game/server/plugin_check.cpp",
                                   "/f/build")
          == "sourcesharp/game/server/plugin_check.cpp")
    try:
        cmakegraph.farm_relative("/elsewhere/Panel.cpp", "/f/build")
        outside = False
    except cmakegraph.GraphError:
        outside = True
    check("a file outside the farm's src/ is refused", outside)

    # THE LAST TWO ARMS NEED A BUILT TREE, and a self-test that fails for a
    # missing build artefact is a checker that reports the wrong thing. They
    # say they were not run rather than passing quietly -- which is the shape
    # this project keeps finding, a check that cannot fail.
    if not os.path.exists(os.path.join(BUILD_DIR, "compile_commands.json")):
        print("%-56s SKIPPED  no CMake build; run `make debug` first"
              % "the census arms")
        print("the two arms that need a built tree did NOT run. This is not a "
              "pass:\n  the instrument's parsing was checked, its subject was "
              "not.")
        return 0 if ok else 1

    rows = census()
    check("the census finds sites at all", len(rows) > 10,
          "found %d" % len(rows))
    check("no site is in an uncompiled translation unit",
          not any(r[0] == "game/client/c_baseanimating.cpp" for r in rows),
          "c_baseanimating.cpp is on neither link line and declares two")

    return 0 if ok else 1


def main():
    global BUILD_DIR, SRC
    args = sys.argv[1:]
    if len(args) >= 2 and args[0] == "--build-dir":
        # The sources scanned are the ones this build compiled: its farm's src/.
        BUILD_DIR = os.path.abspath(args[1])
        SRC = cmakegraph.farm_src(BUILD_DIR)
        args = args[2:]
    if args == ["--self-test"]:
        return self_test()

    rows = census()
    print("sites\t%d" % len(rows))
    print("files\t%d" % len({r[0] for r in rows}))
    print("convars\t%d" % len({r[3] for r in rows if r[3]}))

    if args == ["--count"]:
        return 0
    if args:
        sys.stderr.write(__doc__)
        return 2

    print()
    print("file\tline\tsides\tconvar\ttext")
    for r in rows:
        print("%s\t%d\t%s\t%s\t%s" % r)
    return 0


if __name__ == "__main__":
    sys.exit(main())

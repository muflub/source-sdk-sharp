# The web UI's facts: no build, and an arm's filter is "file::test-name pattern".
WEBUI = os.path.join(ROOT, "src", "webui")
NODE_BIN = os.path.join(ROOT, "tools", "node", "bin")


def built_digest(project="ai"):
    return [digest(p) for p in PROJECTS[project][2]] if project in PROJECTS else []


def path(rel):
    return os.path.join(ROOT, rel)


def digest(p):
    with open(p, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


def build(project="ai"):
    if project == "webui":
        return
    p = subprocess.run([DOTNET, "build", PROJECTS[project][0], "-v", "q", "--nologo", "-c", "Debug"],
                       cwd=ROOT, capture_output=True, text=True)
    if p.returncode != 0:
        tail = "\n".join(l for l in p.stdout.splitlines() if "error" in l)[:2000]
        raise SystemExit("ai-mutations: the build failed:\n" + tail)


def run(filt, project="ai"):
    """(failed, passed) of the facts the filter names; a run that ran none is an error."""
    if project == "webui":
        return run_vitest(filt)
    p = subprocess.run([DOTNET, "test", PROJECTS[project][1], "--nologo", "--filter", filt],
                       cwd=ROOT, capture_output=True, text=True)
    m = re.search(r"Failed:\s*(\d+), Passed:\s*(\d+)", p.stdout)
    failed, passed = (int(m.group(1)), int(m.group(2))) if m else (0, 0)
    if failed + passed == 0:
        raise SystemExit("ai-mutations: filter %r ran no fact:\n%s" % (filt, p.stdout[-1500:]))
    return failed, passed


def run_vitest(filt):
    """(failed, passed) of a vitest file's tests matching a name pattern; a run that ran none is an error."""
    test, pattern = filt.split("::", 1)
    env = dict(os.environ, NO_COLOR="1", PATH=NODE_BIN + os.pathsep + os.environ.get("PATH", ""))
    p = subprocess.run(["npx", "vitest", "run", test, "-t", pattern], cwd=WEBUI, env=env, capture_output=True, text=True)
    m = re.search(r"^\s*Tests\s+(.*)$", p.stdout, re.M)
    line = m.group(1) if m else ""
    count = lambda word: int((re.search(r"(\d+) " + word, line) or [0, 0])[1])
    failed, passed = count("failed"), count("passed")
    if failed + passed == 0:
        raise SystemExit("ai-mutations: vitest %r ran no test:\n%s" % (filt, (p.stdout + p.stderr)[-1500:]))
    return failed, passed


class Edit:
    """Replace `old` with `new` in a file (old must occur once), or append, or create."""

    def __init__(self, rel, old=None, new="", create=False):
        self.rel, self.old, self.new, self.create = rel, old, new, create

    def apply(self):
        p = path(self.rel)
        if self.create:
            assert not os.path.exists(p), "%s already exists" % self.rel
            with open(p, "w") as f:
                f.write(self.new)
            self.original = None
            return
        with open(p) as f:
            self.original = f.read()
        self.mode = os.stat(p).st_mode
        before = digest(p)
        if self.old is None:
            text = self.original + self.new
        else:
            assert self.original.count(self.old) == 1, "%s: the needle occurs %d times" % (self.rel, self.original.count(self.old))
            text = self.original.replace(self.old, self.new)
        with open(p, "w") as f:
            f.write(text)
        os.utime(p, None)
        assert digest(p) != before, "the mutation changed nothing in %s" % self.rel

    def restore(self):
        p = path(self.rel)
        if self.create:
            if os.path.exists(p):
                os.remove(p)
            return
        if getattr(self, "original", None) is None:
            return
        with open(p, "w") as f:
            f.write(self.original)
        os.utime(p, None)
        os.chmod(p, self.mode)



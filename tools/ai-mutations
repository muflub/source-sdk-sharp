def main(argv):
    if "--list" in argv:
        for name, (what, _e, _f, _b) in ARMS.items():
            print("%-16s %s" % (name, what))
        return 0
    names = [a for a in argv if not a.startswith("-")] or list(ARMS)
    unknown = [n for n in names if n not in ARMS]
    if unknown:
        raise SystemExit("ai-mutations: no arm %s (--list)" % ", ".join(unknown))

    build()
    for name in names:
        failed, passed = run(ARMS[name][2])
        if failed:
            raise SystemExit("ai-mutations: %s's facts are red before the mutation (%d failed)" % (name, failed))

    bad = []
    for name in names:
        what, edits, filt, rebuild = ARMS[name]
        built_before = built_digest()
        try:
            for e in edits:
                e.apply()
            if rebuild:
                build()
                if built_digest() == built_before:
                    raise SystemExit("ai-mutations: %s: no AI assembly changed, so no rebuild took effect" % name)
            failed, passed = run(filt)
        finally:
            for e in reversed(edits):
                e.restore()
        verdict = "RED" if failed else "green"
        print("%-16s %-5s %d failed, %d passed  (%s)" % (name, verdict, failed, passed, what))
        if not failed:
            bad.append(name)

    build()
    for name in names:
        failed, _ = run(ARMS[name][2])
        if failed:
            bad.append(name + " (still red after restore)")

    if bad:
        print("ai-mutations: NOT red: %s" % ", ".join(bad))
        return 1
    print("ai-mutations: %d arm(s), every one red, every one green again after restore" % len(names))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

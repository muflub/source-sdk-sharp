#!/usr/bin/env python3
"""Mutation-verify the AI's facts (docs/plans/plan_hl2mp_ai.md §8.2).

Each arm breaks one subject -- the core's references, the core's names, the
lane's native diff, a rule of the core -- rebuilds the AI's test project,
runs the facts that hold that subject, and requires them to go RED. Then the
arm is restored and, after every arm, the same facts must be GREEN again.

  tools/ai-mutations                 every arm
  tools/ai-mutations no-abi decide   the arms named
  tools/ai-mutations --list          the arms

Snapshot with a copy, restore from it with a FRESH mtime (never
`git checkout --`, never a copy that keeps the old mtime: MSBuild would skip
the rebuild and the next run would re-execute the mutant). Each arm proves
the mutation landed (the file's hash changed) and that the rebuild happened
(the test assembly's hash changed), and restores in a `finally`.
"""
import hashlib
import re
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DOTNET = os.environ.get("DOTNET", os.path.expanduser("~/.dotnet/dotnet"))
# Each test project an arm can run: its project, its test assembly, and the
# subject assemblies as the run loads them (a mutant must change one). The AI's
# own facts are "ai"; the core services the AI needs (§3.1, §3.2) are held by
# the server's facts.
PROJECTS = {
    "ai": (os.path.join(ROOT, "src", "ai", "tests", "SourceSharp.Ai.Tests.csproj"),
           os.path.join(ROOT, "bin", "debug", "ai-tests", "SourceSharp.Ai.Tests.dll"),
           [os.path.join(ROOT, "bin", "debug", "ai-tests", n) for n in ("SourceSharp.Ai.dll", "SourceSharp.Ai.Hl2mp.dll", "SourceSharp.Ai.Replay.dll",
                                                                         "SourceSharp.Ai.Hl2mp.Client.dll")]),
    "server": (os.path.join(ROOT, "src", "test", "server", "SourceSharp.Server.Tests.csproj"),
               os.path.join(ROOT, "bin", "debug", "tests-server", "SourceSharp.Server.Tests.dll"),
               [os.path.join(ROOT, "bin", "debug", "tests-server", n)
                for n in ("SourceSharp.Server.dll", "SourceSharp.Server.Interop.dll", "Debug.Api.Server.dll")]),
    "client": (os.path.join(ROOT, "src", "test", "client", "SourceSharp.Client.Tests.csproj"),
               os.path.join(ROOT, "bin", "debug", "tests-client", "SourceSharp.Client.Tests.dll"),
               [os.path.join(ROOT, "bin", "debug", "tests-client", n)
                for n in ("SourceSharp.Client.dll", "SourceSharp.Client.Ui.dll", "SourceSharp.Client.Ui.Toolkit.dll", "SourceSharp.Ai.Hl2mp.Ui.dll")]),
}


def built_digest(project="ai"):
    return [digest(p) for p in PROJECTS[project][2]]


def path(rel):
    return os.path.join(ROOT, rel)


def digest(p):
    with open(p, "rb") as f:
        return hashlib.sha256(f.read()).hexdigest()


def build(project="ai"):
    p = subprocess.run([DOTNET, "build", PROJECTS[project][0], "-v", "q", "--nologo", "-c", "Debug"],
                       cwd=ROOT, capture_output=True, text=True)
    if p.returncode != 0:
        tail = "\n".join(l for l in p.stdout.splitlines() if "error" in l)[:2000]
        raise SystemExit("ai-mutations: the build failed:\n" + tail)


def run(filt, project="ai"):
    """(failed, passed) of the facts the filter names; a run that ran none is an error."""
    p = subprocess.run([DOTNET, "test", PROJECTS[project][1], "--nologo", "--filter", filt],
                       cwd=ROOT, capture_output=True, text=True)
    m = re.search(r"Failed:\s*(\d+), Passed:\s*(\d+)", p.stdout)
    failed, passed = (int(m.group(1)), int(m.group(2))) if m else (0, 0)
    if failed + passed == 0:
        raise SystemExit("ai-mutations: filter %r ran no fact:\n%s" % (filt, p.stdout[-1500:]))
    return failed, passed


class Edit:
    """Replace `old` with `new` in a file (old must occur once), or append, or create."""

    def __init__(self, rel, old=None, new="", create=False):
        self.rel, self.old, self.new, self.create = rel, old, new, create

    def apply(self):
        p = path(self.rel)
        if self.create:
            assert not os.path.exists(p), "%s already exists" % self.rel
            with open(p, "w") as f:
                f.write(self.new)
            self.original = None
            return
        with open(p) as f:
            self.original = f.read()
        self.mode = os.stat(p).st_mode
        before = digest(p)
        if self.old is None:
            text = self.original + self.new
        else:
            assert self.original.count(self.old) == 1, "%s: the needle occurs %d times" % (self.rel, self.original.count(self.old))
            text = self.original.replace(self.old, self.new)
        with open(p, "w") as f:
            f.write(text)
        os.utime(p, None)
        assert digest(p) != before, "the mutation changed nothing in %s" % self.rel

    def restore(self):
        p = path(self.rel)
        if self.create:
            if os.path.exists(p):
                os.remove(p)
            return
        if getattr(self, "original", None) is None:
            return
        with open(p, "w") as f:
            f.write(self.original)
        os.utime(p, None)
        os.chmod(p, self.mode)



def project_of(name):
    """The test project an arm's facts are in: its fifth field, or the AI's."""
    arm = ARMS[name]
    return arm[4] if len(arm) > 4 else "ai"


def main(argv):
    if "--list" in argv:
        for name, arm in ARMS.items():
            print("%-16s %s" % (name, arm[0]))
        return 0
    names = [a for a in argv if not a.startswith("-")] or list(ARMS)
    unknown = [n for n in names if n not in ARMS]
    if unknown:
        raise SystemExit("ai-mutations: no arm %s (--list)" % ", ".join(unknown))

    projects = sorted({project_of(n) for n in names})
    for proj in projects:
        build(proj)
    for name in names:
        failed, passed = run(ARMS[name][2], project_of(name))
        if failed:
            raise SystemExit("ai-mutations: %s's facts are red before the mutation (%d failed)" % (name, failed))

    bad = []
    for name in names:
        what, edits, filt, rebuild = ARMS[name][:4]
        proj = project_of(name)
        built_before = built_digest(proj)
        try:
            for e in edits:
                e.apply()
            if rebuild:
                build(proj)
                if built_digest(proj) == built_before:
                    raise SystemExit("ai-mutations: %s: no subject assembly changed, so no rebuild took effect" % name)
            failed, passed = run(filt, proj)
        finally:
            for e in reversed(edits):
                e.restore()
        verdict = "RED" if failed else "green"
        print("%-16s %-5s %d failed, %d passed  (%s)" % (name, verdict, failed, passed, what))
        if not failed:
            bad.append(name)

    for proj in projects:
        build(proj)
    for name in names:
        failed, _ = run(ARMS[name][2], project_of(name))
        if failed:
            bad.append(name + " (still red after restore)")

    if bad:
        print("ai-mutations: NOT red: %s" % ", ".join(bad))
        return 1
    print("ai-mutations: %d arm(s), every one red, every one green again after restore" % len(names))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

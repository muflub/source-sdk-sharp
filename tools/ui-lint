#!/usr/bin/env python3
"""tools/ui-lint -- the UI design lint over every screen sample (plan_client_ui §5.8.5).

    tools/ui-lint [--config debug|release] [--only NAME]
    tools/ui-lint --self-test

Builds src/tools/UiPreview and runs its --lint: every [UiSample] at the five
mock-up sizes and every [UiGallery] part, laid out exactly as the previews
are, checked against the rules (UiLint.Rules). One line per defect:

    scoreboard/12-players@2560x1080 [clipped] TeamTable[team1] › "xXx_…" overflows its box by 38 du; use .Elide() or a wider box

then a count per rule. Exit 0 when clean, 1 on any finding, 2 when the lint
could not run (a build failure is not a clean report).
"""
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)

LINE = re.compile(r'^(?P<where>\S+@\d+x\d+(?:@[\d.]+)?) \[(?P<rule>[a-z-]+)\] (?P<rest>.*)$')
SUMMARY = re.compile(r'^ui-lint: (?P<n>\d+) finding\(s\); rules: (?P<rules>.*)$')


def parse(output):
    """(findings as (where, rule, rest), summary count or None, rules list)."""
    findings, count, rules = [], None, []
    for line in output.splitlines():
        m = LINE.match(line)
        if m:
            findings.append((m['where'], m['rule'], m['rest']))
            continue
        s = SUMMARY.match(line)
        if s:
            count = int(s['n'])
            rules = [r.strip() for r in s['rules'].split(',') if r.strip()]
    return findings, count, rules


def verdict(findings, count, rules):
    """0 clean, 1 findings, 2 the run cannot be trusted (no summary, a count that disagrees, no rules)."""
    if count is None or not rules or count != len(findings):
        return 2
    return 0 if count == 0 else 1


def per_rule(findings):
    counts = {}
    for _, rule, _ in findings:
        counts[rule] = counts.get(rule, 0) + 1
    return sorted(counts.items())


def self_test():
    failures, total = [], 0

    def check(cond, what):
        nonlocal total
        total += 1
        if not cond:
            failures.append(what)

    out = ('scoreboard/12-players@2560x1080 [clipped] TeamTable › "x" overflows its box by 38 du; use .Elide()\n'
           'hud/full@1024x768 [contrast] "100" is 2.1:1 over bright\n'
           'ui-lint: 2 finding(s); rules: clipped, contrast\n')
    f, n, rules = parse(out)
    check(len(f) == 2 and f[0][1] == 'clipped' and f[1][0] == 'hud/full@1024x768', f'parse findings: {f}')
    check(n == 2 and rules == ['clipped', 'contrast'], f'parse summary: {n} {rules}')
    check(verdict(f, n, rules) == 1, 'findings fail')
    check(verdict([], 0, ['clipped']) == 0, 'a clean run passes')
    check(verdict([], None, []) == 2, 'no summary is not a pass')
    check(verdict(f[:1], 2, rules) == 2, 'a count that disagrees with the lines is not trusted')
    check(verdict([], 0, []) == 2, 'a lint with no rules is not a pass')
    check(per_rule(f) == [('clipped', 1), ('contrast', 1)], 'per-rule counts')

    for x in failures:
        print('FAIL:', x)
    print(f'ui-lint self-test: {total - len(failures)}/{total} passed')
    return 1 if failures else 0


def main(argv):
    if '--self-test' in argv:
        return self_test()
    config = argv[argv.index('--config') + 1] if '--config' in argv else os.environ.get('CONFIG', 'debug')
    b = subprocess.run(['dotnet', 'build', os.path.join(ROOT, 'src/tools/UiPreview'), '--nologo', '-v', 'q',
                        '-c', 'Release' if config == 'release' else 'Debug'], capture_output=True, text=True)
    if b.returncode != 0:
        print(b.stdout[-4000:] + b.stderr[-2000:], file=sys.stderr)
        print('ui-lint: the preview tool did not build: NOT LINTED', file=sys.stderr)
        return 2
    cmd = ['dotnet', os.path.join(ROOT, 'bin', config, 'tools', 'ui-preview', 'SourceSharp.UiPreview.dll'),
           '--root', ROOT, '--lint']
    if '--only' in argv:
        cmd += ['--only', argv[argv.index('--only') + 1]]
    r = subprocess.run(cmd, capture_output=True, text=True)
    sys.stdout.write(r.stdout)
    sys.stderr.write(r.stderr)
    findings, count, rules = parse(r.stdout)
    for rule, n in per_rule(findings):
        print(f'  {rule}: {n}')
    v = verdict(findings, count, rules)
    if v == 2:
        print('ui-lint: no trustworthy summary from the lint: NOT LINTED', file=sys.stderr)
    return v


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))

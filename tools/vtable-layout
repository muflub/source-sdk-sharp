    '_WIN32': False,
    'WIN32': False,
    '_PS3': False,
    'POSIX': True,
    'LINUX': True,
    '_LINUX': True,
    'PLATFORM_64BITS': True,

    # cdll_int.h's two, and the reason the whole file cares: the shipped engine

# ---------------------------------------------------------------------------
# THE SLOT HASH. tools/managed-areas stamps one on every slot of a table
# managed builds, and native checks them all in Validate before it calls any
# slot. It is the hash of the slot's C# function-pointer TYPE and nothing
# else, so a slot or a parameter renamed still validates and a retyped one
# does not. It lives beside signature_of so that the type which is hashed and
# the type which is spelled come out of one map.
# ---------------------------------------------------------------------------
def slot_hash(declaration):
    """FNV-1a 32 over a field declaration's TYPE, all whitespace removed:
    `delegate* unmanaged<void*, int, int> Add;` hashes `delegate*unmanaged<void*,int,int>`."""
    text = ''.join(declaration.rstrip(';').rsplit(' ', 1)[0].split())
    h = 2166136261
    for b in text.encode('utf-8'):
        h ^= b
        h = (h * 16777619) & 0xFFFFFFFF
    return h



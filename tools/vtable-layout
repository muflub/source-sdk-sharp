CONDITION = re.compile(
    r'^[ \t]*#[ \t]*(?P<kind>ifdef|ifndef|if|elif|else|endif)\b(?P<rest>[^\n]*)')


def evaluate(kind, rest):
    """True / False for a condition, or raise ValueError naming what it is."""
    text = rest.strip()

    if kind == 'ifdef':
        name = text.split()[0] if text.split() else ''
        return lookup(name, text)

    if kind == 'ifndef':
        name = text.split()[0] if text.split() else ''
        return not lookup(name, text)

    # `#if defined( X )`, `#if !defined( X )`, `#if 0`, `#if 1`.
    if text in ('0', '1'):
        return text == '1'

    match = re.fullmatch(r'(?P<not>!\s*)?defined\s*\(?\s*(?P<name>\w+)\s*\)?', text)

    if match:
        value = lookup(match.group('name'), text)
        return (not value) if match.group('not') else value

    raise ValueError('cannot evaluate `#%s %s`' % (kind, text))


def lookup(name, text):
    if name not in DEFINES:
        raise ValueError('`%s` is not in DEFINES, so `#if %s` cannot be decided '
                         'here -- add it with the reason it has its value' % (name, text))

    value = DEFINES[name]

    if value is None:
        raise ValueError('`%s` is side-dependent, so a declaration gated on it is '
                         'in one compilation and not the other' % name)

    return value


# A `virtual` declaration. The preprocessor directives the old walk tracked
# alongside these are no longer read: with native compiled to the engine's own
# defines, a conditional declaration is IN, and counting it is the correct
# answer rather than an unnumberable one.
VIRTUAL = re.compile(r'\bvirtual\b(?P<signature>[^;{]*)')

# Both in ONE pattern so they are seen in SOURCE ORDER: which side of a `#if` a
# declaration falls on is a fact about their positions, and two separate scans
# could not tell.
DIRECTIVE_OR_VIRTUAL = re.compile(
    r'^[ \t]*#[ \t]*(?P<kind>ifdef|ifndef|if|elif|else|endif)\b(?P<rest>[^\n]*)'
    r'|\bvirtual\b(?P<signature>[^;{]*)', re.M)


def walk_body(body):
    """
    Yield (name, parameters, returns, slot) for a class body, in order.

    Raises ValueError with the reason for a declaration it cannot classify: the
    alternative is silently numbering every declaration after it wrongly, which
    is the defect this walk exists to prevent.
    """
    slot = 0

    # One entry per open conditional: True when this branch is compiled.
    stack = []

    for match in DIRECTIVE_OR_VIRTUAL.finditer(body):
        kind = match.group('kind')

        if kind is not None:
            rest = match.group('rest') or ''

            if kind in ('ifdef', 'ifndef', 'if'):
                stack.append(evaluate(kind, rest))
            elif kind == 'elif':
                # An `#elif` is only reached when every branch above it was
                # false, so its own condition decides it.
                if stack:
                    stack[-1] = (not stack[-1]) and evaluate('if', rest)
            elif kind == 'else':
                if stack:
                    stack[-1] = not stack[-1]
            elif kind == 'endif':
                if stack:
                    stack.pop()

            continue

        # A declaration in a branch this build does not compile occupies NO
        # slot, so it is skipped without advancing the counter.
        if not all(stack):
            continue

        signature = match.group('signature')

        # A VIRTUAL DESTRUCTOR TAKES TWO SLOTS -- the complete-object destructor
        # (D1) and the deleting destructor (D0) -- with one source line between
        # them. Yielded as declarations of their own so the emitter can comment
        # them rather than leaving a hole it has to guess the meaning of.
        if '~' in signature:
            yield '~destructor', '', 'void', slot
            slot += 2
            continue

        name = re.search(r'([A-Za-z_]\w*)\s*\(', signature)

        if not name:
            raise ValueError(
                'cannot read a method name out of "virtual%s"' % signature.strip())

        parameters = parameters_of(signature)

        if parameters is None:
            raise ValueError(
                'cannot read a parameter list out of "virtual%s"' % signature.strip())

        yield (name.group(1), normalise_signature(parameters),
               return_type_of(signature, name.start(1)), slot)
        slot += 1


def derive_from_header(text, interface):
    """[(method, parameters, returns, slot)] for one class, or (None, reason)."""
    body, why = class_body(text, interface)

    if body is None:
        return None, why

    slots = []

    try:
        for row in walk_body(body):
            slots.append(row)
    except ValueError as error:
        return None, str(error)

    if not slots:
        return None, 'class %s declares no virtual method' % interface

    return slots, None


def chain_steps(entry):
    """[(header, class)] for one interface's chain, base first.

    A CHAIN CAN SPAN HEADERS and most of them do: `IDataCache` derives from
    `IAppSystem`, which is in appframework/IAppSystem.h, and its own slots are
    numbered after that base's five. Reading only the derived class's header
    would number the whole interface from zero.

    An entry writes `chain=['IAppSystem', 'IDataCache']` when both are in its own
    header, or pairs it with `chain_headers` naming the file each class comes
    from. A class with no entry falls back to the interface's own header.
    """
    headers = entry.get('chain_headers', {})

    return [(headers.get(cls, entry['header']), cls) for cls in entry['chain']]


def derive_chain(steps, chain=None):
    """[(class, method, parameters, returns, slot)] across a chain, base first.

    `steps` is [(header, class)]; the two-argument form is kept for the arms that
    pass one text and a list of class names.
    """
    if chain is not None:
        steps = [(steps, cls) for cls in chain]
        read_text = lambda h: h
    else:
        read_text = read

    rows = []
    at = {}        # (method, parameters) -> the slot it already occupies
    overrides = {} # that slot -> the derived classes that re-declare it
    next_slot = 0

    for header, cls in steps:
        text = read_text(header)

        if text is None:
            return None, '%s is missing' % header

        declared, why = derive_from_header(text, cls)

        if declared is None:
            return None, '%s: %s' % (header, why)

        for name, parameters, returns, _local in declared:
            # AN OVERRIDE IS NOT A NEW SLOT, and this is where a chain silently
            # grows if nobody says so. A derived class that re-declares a base's
            # method REPLACES the entry in the base's slot; it does not append.
            #
            # Both cases here were found by the compiler and by nothing else:
            #
            #   IVModelInfoClient re-declares FindOrLoadModel, which IVModelInfo
            #   declares at slot 40 as an obsolete stub. Counted as new, the
            #   chain read 61 where the real table is 60.
            #
            #   IGameEventManager2 re-declares its own virtual destructor over
            #   IBaseInterface's. A destructor override takes the SAME PAIR --
            #   16 where the real table is 14.
            #
            # Keyed on (name, PARAMETERS) rather than name, for the reason
            # IBaseFileSystem::Size exists: two overloads are two slots, and a
            # derived class re-declaring one of them overrides that one only.
            # AND ONLY ACROSS CLASSES. A class does not override itself: two
            # declarations in ONE class are two slots, always. ICvar is what
            # says so -- it declares FindCommandBase, FindVar, FindCommand and
            # GetCommands each TWICE, as a const and a non-const overload with
            # identical parameter lists, and a rule that did not exclude the
            # same class read all four as overrides and dropped them. 31 where
            # the real table is 35.
            #
            # The const qualifier is what tells those apart in C++ and this walk
            # does not read it, so the exclusion is by CLASS rather than by
            # signature. What that leaves uncovered is a derived class declaring
            # a const overload of a base's non-const method -- and the compiler
            # check in vtable_index_agreement_test.cpp is what would catch it,
            # which is how both of the real overrides above were found.
            key = ('~destructor', '') if name == '~destructor' else (name, parameters)
            prior = at.get(key)

            if prior is not None and prior[0] != cls:
                overrides.setdefault(prior[1], []).append(cls)
                continue

            at[key] = (cls, next_slot)
            rows.append((cls, name, parameters, returns, next_slot))
            next_slot += 2 if name == '~destructor' else 1

    return rows, overrides


# ---------------------------------------------------------------------------
# POLICY. Not verification: see the file's own header.
# ---------------------------------------------------------------------------
def load_policy():
    """{class: {method: reason}}, or raise."""
    with open(POLICY_FILE) as handle:
        raw = json.load(handle)

    return {cls: {method: ' '.join(lines)
                  for method, lines in entries.items()}
            for cls, entries in raw.items()
            if not cls.startswith('_')}


def read(relative):
    """A file's text, or None."""
    try:
        with open(os.path.join(ROOT, relative)) as handle:
            return handle.read()
    except OSError:
        return None


# ---------------------------------------------------------------------------
# THE EMITTER.
# ---------------------------------------------------------------------------
DESTRUCTOR_NOTE = (
    'destructor %d -- reserved, never bound, and it must never be called from '
    'managed')


def wrap_comment(text, width=88):
    """The reason, as trailing comment lines of at most `width` characters."""
    words, lines, current = text.split(), [], ''

    for word in words:
        candidate = (current + ' ' + word).strip()

        if len(candidate) > width and current:
            lines.append(current)
            current = word
        else:
            current = candidate

    if current:
        lines.append(current)

    return lines


def fields_for(entry, policy):
    """([(slot, declaration, comment lines)], None) for one interface, or (None, why)."""
    rows, why = derive_chain(chain_steps(entry))

    if rows is None:
        return None, why

    if kind_of(entry) not in KINDS:
        return None, ('%s names chain kind %r; the kinds are %s'
                      % (entry['struct'], kind_of(entry), ', '.join(KINDS)))

    # RESERVED WORDS are the C++ class's data members after its vptr: only a
    # Valve layout has them, since our own interfaces declare none.
    if entry.get('reserved_words', 0) and kind_of(entry) != VALVE_BY_MANAGED:
        return None, ('%s reserves %d word(s) after its vptr, and only a %s row may: '
                      'our own interfaces carry no data members'
                      % (entry['struct'], entry['reserved_words'], VALVE_BY_MANAGED))

    if kind_of(entry) in MANAGED_WRITTEN:
        refusals = managed_implementation_refusals(
            rows, policy, valve_layout=kind_of(entry) == VALVE_BY_MANAGED)

        if refusals:
            return None, ('%s is %s and %s' % (entry['struct'], kind_of(entry),
                                              '; and '.join(refusals)))

    # How many times each name is declared across the chain. IBaseFileSystem
    # declares Size twice and IVModelInfo declares GetVCollide and FindModel
    # twice each, so the field names have to be told apart -- and the trailing
    # comment carries the parameter list that says which is which.
    times = {}

    for cls, name, _parameters, _returns, _slot in rows:
        times[(cls, name)] = times.get((cls, name), 0) + 1

    fields = []
    used = {}

    # PER-SLOT [SuppressGCTransition] (plan_engineapi_vtables A2). A row's
    # `suppress=[...]` names the methods whose calls skip the GC-mode switch --
    # the EngineApi slots that carry the attribute today move into vtables with
    # it, or every hot read pays a transition it did not pay as a struct field.
    # A name that is not a typed slot of this chain is refused rather than
    # ignored: a misspelt entry would otherwise silently drop the attribute.
    suppress = set(entry.get('suppress', ()))
    suppressed = set()

    for cls, name, parameters, returns, slot in rows:
        if name == '~destructor':
            fields.append((slot, 'nint Destructor1;',
                           [DESTRUCTOR_NOTE % 1,
                            'Complete Object Destructor (D1): destroys the object\'s '
                            'members and subobjects, but does',
                            'not free the memory. Used for objects on the stack, member '
                            'variables, or elements in an array.']))
            fields.append((slot + 1, 'nint Destructor2;',
                           [DESTRUCTOR_NOTE % 2,
                            'Deleting Destructor (D0): calls the complete object '
                            'destructor (D1) and then automatically',
                            'invokes operator delete to free the dynamic memory. Used '
                            'when you explicitly call delete ptr.']))
            continue

        declaration = '%s %s::%s( %s )' % (returns, cls, name, parameters or 'void')
        comment = [declaration]

        proxy = PROXIES.get((cls, name))
        reason = policy.get(cls, {}).get(name)

        try:
            kind = signature_of(returns, parameters)
        except Inexpressible as error:
            kind = None

            # A SLOT MANAGED CANNOT SPELL NEEDS AN ACCOUNT OF ITSELF, and having
            # none is a hard failure rather than a quiet `nint`.
            #
            # ON AN INTERFACE WITH AN IMPL CLASS that means one of two things.
            # Either a C++ proxy taking marshalable parameters -- which is what
            # makes the call reachable at all -- or a POLICY reason saying the
            # impl exposes nothing here anyway, in which case a proxy would be
            # dead code. IVEngineServer::ClientCommand is the second kind and
            # says so in its own words: "varargs ... and it runs a command on a
            # client, so it would be refused twice over".
            #
            # ON A LAYOUT-ONLY INTERFACE the account is already complete: there
            # is no impl class, so nothing is exposed, so there is nothing for a
            # proxy to serve and no per-method decision to record. Demanding one
            # would mean writing a policy entry for every by-value parameter on
            # 26 interfaces nobody calls -- 16 sentences saying the same thing,
            # which is how a rule stops being read.
            if entry.get('exposed') and proxy is None and reason is None:
                return None, ('%s::%s cannot be typed (%s) and has neither a C++ proxy '
                              'in PROXIES nor a reason in tools/vtable-policy.json -- '
                              'one of the two, never an untyped slot with no account '
                              'of itself' % (cls, name, error))

            comment += ['REFUSED -- MANAGED CANNOT EXPRESS THIS CALL: %s.' % error]

            if proxy is None and not entry.get('exposed'):
                comment += ['No C++ proxy, because this interface is LAYOUT ONLY: '
                            'nothing exposes it, so there is nothing for a proxy to '
                            'serve.']
            elif proxy is None:
                comment += ['No C++ proxy is provided, because policy already exposes '
                            'nothing here -- one would be dead code:']

        if proxy is not None:
            if kind is not None:
                return None, ('%s::%s names a C++ proxy in PROXIES but IS expressible '
                              'as %s -- a proxy for a call managed can make is dead '
                              'code' % (cls, name, kind))

            comment += wrap_comment(proxy)

        if reason is not None:
            comment += ['NOT EXPOSED (policy, not verification) --'] + wrap_comment(reason)

        if kind is not None and name in suppress:
            kind = kind.replace('delegate* unmanaged<',
                                'delegate* unmanaged[SuppressGCTransition]<', 1)
            suppressed.add(name)

        field = name if kind is not None else 'Refused_' + name

        seen = used.get(field, 0) + 1
        used[field] = seen

        if seen > 1:
            field = '%s_%d' % (field, seen)

        fields.append((slot, '%s %s;' % (kind or 'nint', field), comment))

    unknown = sorted(suppress - suppressed)
    if unknown:
        return None, ('%s: suppress names %s, which %s not a typed slot of %s'
                      % (entry['struct'], ', '.join(unknown),
                         'is' if len(unknown) == 1 else 'are', ' / '.join(entry['chain'])))

    return fields, None


def emit():
    """(the generated C# file as text, None), or (None, why)."""
    policy = load_policy()

    out = __doc__.split('WHAT THIS REPLACED')[0]  # unused; kept out of the file
    out = [
        '// GENERATED by `tools/vtable-layout --write`. DO NOT EDIT.',
        '//',
        '// One [StructLayout(LayoutKind.Sequential)] struct per interface, with one',
        '// pointer-sized field per vtable slot IN THE HEADER\'S OWN DECLARATION ORDER --',
        '// so field N sits at byte 8N and THE FIELD\'S POSITION IS THE SLOT NUMBER. A',
        '// call is `_vtbl->GetLevelName(_self)`: no index is written at the call site,',
        '// none is looked up at run time, and nothing happens per call.',
        '//',
        '// The order is not typed here by hand. It comes from the header walk in',
        '// `tools/vtable-layout`, which regenerates this file and diffs it against what',
        '// is committed -- so the layout cannot drift from the header silently.',
        '//',
        '// EVERY SLOT IS TYPED. The struct describes the ABI and nothing else: what the',
        '// engine\'s calling convention is for that method, derived from the header\'s',
        '// parameter list and its return type. There is no `NotBound_`.',
        '//',
        '// WHAT THE STRUCT DOES NOT DECIDE IS WHAT MAY BE CALLED. That is the impl',
        '// class\'s job, and it decides it by what it EXPOSES -- a method with a side',
        '// effect, or one nothing else in the process can corroborate, simply has no',
        '// one-line delegation reaching its field. Those reasons are policy, they are',
        '// carried in tools/vtable-policy.json, and each is copied onto the field it',
        '// names as "NOT EXPOSED (policy, not verification)". The struct still types the',
        '// slot, because the ABI is what it is whatever anybody decides.',
        '//',
        '// `Refused_` MEANS ONE THING AND IT IS NOT A JUDGEMENT: managed cannot express',
        '// the call. Varargs cannot be issued through a fixed indirect signature, and a',
        '// class returned BY VALUE is passed under rules `delegate* unmanaged<...>`',
        '// cannot spell. Four slots, all on IVEngineClient013, and each names the C++',
        '// proxy that takes marshalable parameters instead.',
        '//',
        '// A VIRTUAL DESTRUCTOR RESERVES THE FIRST TWO SLOTS of any interface that has',
        '// one, and they are emitted uniformly rather than as a special case:',
        '//',
        '//   Complete Object Destructor (D1): destroys the object\'s members and',
        '//   subobjects, but does not free the memory. Used for objects on the stack,',
        '//   member variables, or elements in an array.',
        '//',
        '//   Deleting Destructor (D0): calls the complete object destructor (D1) and',
        '//   then automatically invokes operator delete to free the dynamic memory.',
        '//   Used when you explicitly call delete ptr.',
        '//',
        '// THE ONE CHECK. `SourceSharp_AcquireInterface` hands managed the interface',
        '// pointer AND a count native took from the compiler, and VtableFactory compares',
        '// it to sizeof(TVtbl) / sizeof(void *). Equal, construct; not equal, refuse',
        '// naming both numbers. That is the whole of it, it runs once per acquire, and',
        '// what it catches is THIS FILE GOING STALE against the headers.',
        '',
        'using System.Runtime.InteropServices;',
        '',
        'namespace SourceSharp.Abi;',
    ]

    for entry in INTERFACES:
        fields, why = fields_for(entry, load_policy())

        if fields is None:
            return None, why

        span = max(slot for slot, _d, _c in fields) + 1

        if span != len(fields):
            return None, ('%s emits %d field(s) for a %d slot table'
                          % (entry['struct'], len(fields), span))

        out += [
            '',
            '/// <summary>',
            '/// %s' % entry['summary'],
            '///',
            '/// <para>',
            '/// %d slot(s), walked from <c>%s</c>. <c>sizeof</c> divided by the pointer'
            % (span, entry['header']),
        ] + ([
            '/// size is that number, and it is what <c>VtableFactory</c> holds against',
            '/// the count native takes from the compiler for <c>%s</c>.' % entry['version'],
        ] if 'version' in entry else [
            '/// size is that number. Reached through %s, so no factory hands a count' % entry['reached_by'],
            '/// with the pointer: vtable_index_agreement_test holds the header against it.',
        ]) + [
            '/// </para>',
            '///',
            '/// <para>',
        ] + ['/// %s' % line for line in wrap_comment(entry['note'], 74)] + [
            '/// </para>',
        ]

        if kind_of(entry) == IMPLEMENTED_BY_MANAGED:
            out += [
                '///',
                '/// <para>',
                '/// IMPLEMENTED BY MANAGED. Native calls this table and managed writes it:',
                '/// <c>ManagedVtableGenerator</c> fills every field with a generated thunk',
                '/// and hands native the block and this struct\'s slot count, which native',
                '/// holds against <c>VTableHook::MemberOf( &amp;%s::Release ).slot + 1</c>.'
                % entry['chain'][-1],
                '/// </para>',
            ]

        if kind_of(entry) == VALVE_BY_MANAGED:
            out += [
                '///',
                '/// <para>',
                '/// VALVE\'S LAYOUT, WRITTEN BY MANAGED. The caller holds an',
                '/// <c>%s *</c> and calls these slots in Valve\'s order;' % entry['chain'][-1],
                '/// <c>ManagedVtableGenerator</c> fills every one. There is no Release or',
                '/// Validate: managed frees the block when the holder is done with it.',
                '/// </para>',
            ]

        out += [
            '/// </summary>',
        ]

        if kind_of(entry) == IMPLEMENTED_BY_MANAGED:
            out.append('[ImplementedByManaged("%s")]' % entry['chain'][-1])
        elif kind_of(entry) == VALVE_BY_MANAGED:
            out.append('[ImplementedByManaged("%s", ValveLayout = true%s)]'
                       % (entry['chain'][-1], reserved_spelling(entry)))

        out += [
            '[StructLayout(LayoutKind.Sequential)]',
            # PUBLIC when managed writes the table: the contract that names it
            # ([ManagedVtable(typeof(...))]) lives in Shared or Server, which do
            # not see Abi's internals.
            '%s unsafe struct %s' % ('public' if kind_of(entry) in MANAGED_WRITTEN
                                     else 'internal', entry['struct']),
            '{',
        ]

        # Aligned to the widest SHORT declaration rather than to the widest of
        # all of them: one 90-character `delegate* unmanaged<...>` would push
        # every one of 146 trailing comments off the right of the screen.
        width = max([len(d) for _s, d, _c in fields if len(d) <= ALIGN] or [ALIGN])

        for index, (slot, declaration, comment) in enumerate(fields):
            if index:
                out.append('')

            # The prose leads, the declaration trails. A refusal is several
            # sentences long and a reader scanning for a slot number should not
            # have to walk past them.
            for line in comment[1:]:
                out.append('    // %s' % line)

            # A MANAGED-BUILT SLOT CARRIES ITS HASH (plan_managed_vtable_reload.md
            # L1): FNV-1a 32 over the field's type with all whitespace removed.
            # This is the one place it is computed. tools/managed-areas copies it
            # into the C++ header native checks with, and ManagedVtableGenerator
            # reads it off the field to answer Validate, so the two sides can only
            # disagree when they were built from different headers.
            if kind_of(entry) in MANAGED_WRITTEN:
                out.append('    [SlotHash(0x%08x)]' % slot_hash(declaration))

            pad = ' ' * max(1, width - len(declaration) + 1)
            out.append('    public %s%s// %-3d %s' % (declaration, pad, slot, comment[0]))

        out.append('}')

    out.append('')

    return '\n'.join(out), None


def check(out=sys.stdout):
    """0 when the committed file is what the headers say."""
    generated, why = emit()

    if generated is None:
        print('!! %s' % why, file=out)
        return 2

    committed = read(VTBL_FILE)

    if committed is None:
        print('!! %s is missing -- run `tools/vtable-layout --write`' % VTBL_FILE, file=out)
        return 1

    if committed != generated:
        print('!! %s does not match the header walk. Run '
              '`tools/vtable-layout --write` and read the diff.' % VTBL_FILE, file=out)
        return 1

    total = 0

    for entry in INTERFACES:
        fields, _why = fields_for(entry, load_policy())
        print('  %-24s %3d slot(s)  %s%s'
              % (entry['struct'], len(fields), entry.get('version', 'by pointer'),
                 '  [%s]' % IMPLEMENTED_BY_MANAGED
                 if kind_of(entry) == IMPLEMENTED_BY_MANAGED else ''),
              file=out)
        total += len(fields)

    print('\n%d interface(s), %d slot(s), every one typed from its own declaration.'
          % (len(INTERFACES), total), file=out)

    return 0


# ---------------------------------------------------------------------------
# THE SELF-TEST. A generator with no arm that bites is decoration.
# ---------------------------------------------------------------------------
def self_test(out=sys.stdout):
    arms = []

    def expect(name, condition):
        arms.append((name, bool(condition)))
        print('  %-4s %s' % ('ok' if condition else 'FAIL', name), file=out)

    # -- the walk ------------------------------------------------------------
    body, why = class_body(read('src/public/vstdlib/random.h'), 'IUniformRandomStream')
    expect('random.h IUniformRandomStream body is found', body is not None and why is None)

    rows = list(walk_body(body))
    expect('random.h declares four methods and NO destructor -- line 28 is commented '
           'out, and counting it would move every slot by two',
           len(rows) == 4 and not any(n == '~destructor' for n, _p, _r, _s in rows))
    expect('random.h RandomFloat is slot 1',
           [s for n, _p, _r, s in rows if n == 'RandomFloat'] == [1])

    # -- the destructor pair -------------------------------------------------
    model, _ = derive_from_header(read('src/public/engine/ivmodelinfo.h'), 'IVModelInfo')
    expect('ivmodelinfo.h yields the destructor at slot 0',
           model[0][0] == '~destructor' and model[0][3] == 0)
    expect('ivmodelinfo.h puts GetModel at slot 2, past BOTH destructor slots',
           [s for n, _p, _r, s in model if n == 'GetModel'] == [2])

    # -- the chain -----------------------------------------------------------
    chain, _ = derive_chain(read('src/public/cdll_int.h'),
                            ['IVEngineClient013', 'IVEngineClient'])
    expect('cdll_int.h numbers IVEngineClient::GetProtocolVersion at 138 -- the '
           'derived class CONTINUES the base\'s numbering rather than restarting',
           [s for c, n, _p, _r, s in chain
            if n == 'GetProtocolVersion' and c == 'IVEngineClient'] == [138])
    expect('cdll_int.h counts both conditional declarations IN, so the chain spans 146',
           max(s for _c, _n, _p, _r, s in chain) + 1 == 146)

    # -- per-slot suppression (plan_engineapi_vtables A2) ----------------------
    frame = [e for e in INTERFACES if e['struct'] == 'ShimFrameVtbl'][0]
    policy = load_policy()
    marked, why = fields_for(dict(frame, suppress=['TickCount']), policy)
    decl = dict((d.split()[-1].rstrip(';'), d) for _s, d, _c in (marked or []))
    expect('suppress=[TickCount] emits TickCount as unmanaged[SuppressGCTransition]',
           why is None and 'unmanaged[SuppressGCTransition]<' in decl.get('TickCount', ''))
    expect('a slot NOT on the suppress list keeps the plain unmanaged form',
           why is None and 'SuppressGCTransition' not in decl.get('GetFrameTime', 'x Suppress'))
    plain, _ = fields_for(frame, policy)
    expect('a row with no suppress list emits no attribute at all',
           plain is not None and not any('SuppressGCTransition' in d for _s, d, _c in plain))
    bad, why = fields_for(dict(frame, suppress=['NoSuchMethod']), policy)
    expect('a suppress name that is not a typed slot is REFUSED, naming it',
           bad is None and why is not None and 'NoSuchMethod' in why)

    # -- the type map --------------------------------------------------------
    expect('const char * maps to byte*', csharp_type('const char *') == 'byte*')
    expect('const model_t * maps to void*', csharp_type('const model_t *') == 'void*')
    expect('Vector & -- an out-parameter -- maps to void* and NOT to a by-value refusal',
           csharp_type('Vector &') == 'void*')
    expect('bool maps to byte, because C# bool is not blittable here',
           csharp_type('bool') == 'byte')
    expect('FileHandle_t maps to void* (typedef void *)',
           csharp_type('FileHandle_t') == 'void*')
    expect('MDLHandle_t maps to ushort (typedef unsigned short)',
           csharp_type('MDLHandle_t') == 'ushort')
    expect('long maps to long -- LP64, and GetFileTime returns one',
           csharp_type('long') == 'long')

    def refuses(text):
        try:
            csharp_type(text)
            return False
        except Inexpressible:
            return True

    expect('Vector BY VALUE is refused as a parameter', refuses('Vector'))
    expect('... and spelled as a RETURN: trivial for calls, xmm0:xmm1',
           csharp_return_type('Vector') == 'Vector')
    expect('QAngle by value is still refused as a return (not mapped)',
           refuses('QAngle'))
    expect('... is refused', refuses('...'))
    expect('an unknown class by value is refused, rather than guessed at',
           refuses('CUtlSomethingNobodyMapped'))

    # -- what the emitter does with all that ---------------------------------
    generated, why = emit()
    expect('the file generates at all', generated is not None and why is None)

    body = re.sub(r'(?m)^//.*$', '', generated or '')

    def struct_text(name):
        """One generated struct's body, so an arm about the EXPOSED five is not
        diluted by the twenty-six layout-only ones beside them."""
        head = ' unsafe struct %s\n{' % name   # internal, or public when managed writes it
        at = body.index(head)
        return body[at:body.index('\n}', at)]

    # THE ENGINE'S EXPOSED FIVE, WITHOUT THE SHIM ONES BESIDE THEM. The arms
    # below are about what the engine's calling convention can and cannot
    # express, and every shim interface is expressible BY CONSTRUCTION -- its
    # signatures are copied from flat ABI fields, which are already C function
    # pointers, so regrouping them as vtable methods cannot manufacture an
    # inexpressible one. Folding them in would dilute a claim about the engine
    # with a set that can never falsify it.
    exposed = ''.join(struct_text(e['struct']) for e in INTERFACES
                      if e.get('exposed') and not e.get('shim'))

    shim = ''.join(struct_text(e['struct']) for e in INTERFACES if e.get('shim'))

    expect('NO field is called NotBound_ anything -- 259 of the old file\'s 350 were',
           'NotBound_' not in body)

    # -- the five with an impl class ----------------------------------------
    # 341 / 9 / 7 / 4 until Vector returns were spelled (2026-10-12):
    # GetLightForPoint and GetLightForPointFast are typed now and lost their
    # PROXIES rows.
    expect('across the five EXPOSED ENGINE interfaces, every field is a real '
           'delegate* except seven',
           exposed.count('public delegate* unmanaged') == 343)
    expect('the seven are the destructor pair and five the calling convention '
           'cannot express -- nothing else is left untyped',
           exposed.count('public nint ') == 7)
    expect('two of the five name a C++ proxy',
           len(PROXIES) == 2 and exposed.count('Refused_') == 5)
    expect('Con_NPrintf is one of them', 'nint Refused_Con_NPrintf;' in exposed)
    expect('GetLightForPoint is NOT: a Vector return is spelled',
           'Refused_GetLightForPoint' not in exposed
           and 'GetLightForPoint;' in exposed)
    expect('IVEngineServer::ClientCommand is refused with NO proxy -- policy already '
           'exposes nothing there, so a proxy would be dead code',
           'nint Refused_ClientCommand;' in exposed
           and ('IVEngineServer', 'ClientCommand') not in PROXIES)

    # -- the shim layer ------------------------------------------------------
    #
    # EVERY SHIM SLOT IS TYPED, AND THIS IS NOT THE SAME CLAIM AS THE ONE ABOVE.
    # `Refused_` means "managed cannot express this call", and for OUR OWN
    # headers that category cannot arise: every signature is copied from a flat
    # ABI field, every flat ABI field is already a C-ABI function pointer, so
    # there is nothing to refuse. A `nint` appearing in a shim struct means
    # somebody wrote a by-value class or a varargs into a header this tree owns
    # -- which ishim_frame.h's own rule forbids -- and this arm is where that
    # shows up rather than at a call site.
    expect('no shim slot is untyped: our own headers cannot produce a refusal',
           'nint ' not in shim and 'Refused_' not in shim)
    # THE SHIM LAYER'S SIZE IS DERIVED, and it has to be: it grows by one area
    # per wave, and a hand-kept literal here would make every wave read as a
    # defect -- which is what happened to the policy-reason count one commit
    # ago and to the coverage floor in sdk_player_cast_test.cpp before that.
    #
    # What is worth pinning is the RELATION, not the number: a shim struct is
    # exactly as long as its class and has NO destructor pair in front of it,
    # so the total is the sum of the per-interface spans and nothing else.
    shim_spans = [len(fields_for(e, load_policy())[0])
                  for e in INTERFACES if e.get('shim')]

    expect('the shim layer is %d slot(s) across %d interface(s), with no '
           'destructor pair in front of any of them'
           % (sum(shim_spans), len(shim_spans)),
           shim.count('public delegate* unmanaged') == sum(shim_spans)
           and 'Destructor1' not in shim)

    # -- the whole set -------------------------------------------------------
    #
    # THESE THREE NUMBERS MOVE, and they are written down anyway. A layout costs
    # nothing to have, so the resolved set grows whenever the mod resolves
    # another interface and whenever an area moves to the shim layer -- and the
    # arm is not "the number is 32", it is "the number is what the INTERFACES
    # table says", checked from two directions so a struct that failed to emit
    # is caught rather than absorbed.
    expect('every interface the mod resolves has a layout, and the file holds '
           'exactly one struct per row of INTERFACES (%d)' % len(INTERFACES),
           body.count(' unsafe struct ') == len(INTERFACES))

    # THE SAME DERIVATION, over every interface rather than the shim ones: the
    # typed fields are the total span minus the refusals and the destructor
    # pairs, and each of those three is counted from the emitter's own output.
    total = sum(len(fields_for(e, load_policy())[0]) for e in INTERFACES)

    expect('%d of the %d slots across all of them are a real delegate*, and the '
           'rest are refusals and destructor pairs'
           % (total - body.count('public nint '), total),
           body.count('public delegate* unmanaged') + body.count('public nint ')
           == total)
    # 41/23/9 until INetworkStringTable (the message of the day's row) added a
    # destructor pair and one refusal, SetStringChangedCallback. 44/24/10 until
    # plan_physics_managed B0's six vphysics rows: five destructor pairs
    # (environment, object, shadow and motion controllers, friction snapshot)
    # and four refusals (three Vector returns by value, one priority_t); B0b
    # mapped priority_t, so 57/27. 59/27 since B2.2's IPhysicsFluidController
    # row added one destructor pair and no refusal. 63/27 since 2.4's
    # IPhysicsConstraint and IPhysicsSpring rows: two pairs, no refusal.
    # 65/27 since 2.5's IPhysicsPlayerController row: one pair, no refusal.
    # 69/27 since Phase 3's IVPhysicsKeyParser and IPhysicsConstraintGroup
    # rows (IPhysicsCollisionSet's destructor is not virtual): two pairs.
    # 62/20 since the seven Vector returns were spelled (2026-10-12).
    expect('and the 62 that are not are 20 refusals plus 42 destructor slots -- '
           'TWENTY-ONE interfaces declare a virtual destructor, and a pair is '
           'what a `nint` may be, along with a call managed cannot spell, and all '
           'it may be',
           body.count('public nint ') == 62
           and body.count('Refused_') == 20
           and body.count('nint Destructor1;') == 21
           and body.count('nint Destructor2;') == 21)

    expect('an OVERRIDE takes the base\'s slot rather than appending one -- '
           'IGameEventManager2 re-declares IBaseInterface\'s virtual destructor '
           'and the chain is 14 slots, not 16',
           len(derive_chain(chain_steps(
               [e for e in INTERFACES if e['struct'] == 'GameEventManagerVtbl'][0]))[0]) == 13)

    # -- the derivation against the table it replaced -------------------------
    #
    # THE OLD TOOL CARRIED FIFTEEN HAND-CURATED TYPES, written by eye one at a
    # time and deleted with the rest of the ledger. Re-derived from the headers
    # by the mapper above, FOURTEEN come out identical -- which is what says the
    # derivation reproduces judgement rather than replacing it with something
    # that merely compiles.
    #
    # The fifteenth is a CORRECTION and is recorded as one: cdll_int.h declares
    # `uint GetProtocolVersion()` and the hand-typed row said `int`. Same width,
    # same register, so nothing was ever wrong at run time -- and nothing had
    # read the return type, which is exactly why it drifted.
    was_hand_typed = {
        'RandomFloat':      'delegate* unmanaged<void*, float, float, float>',
        'RandomInt':        'delegate* unmanaged<void*, int, int, int>',
        'RandomFloatExp':   'delegate* unmanaged<void*, float, float, float, float>',
        'GetModel':         'delegate* unmanaged<void*, int, void*>',
        'GetModelIndex':    'delegate* unmanaged<void*, byte*, int>',
        'GetModelName':     'delegate* unmanaged<void*, void*, byte*>',
        'GetModelType':     'delegate* unmanaged<void*, void*, int>',
        'Size_2':           'delegate* unmanaged<void*, byte*, byte*, uint>',
        'GetFileTime':      'delegate* unmanaged<void*, byte*, byte*, long>',
        'GetGameDirectory': 'delegate* unmanaged<void*, byte*>',
        'GetLevelName':     'delegate* unmanaged<void*, byte*>',
        'IsModelPrecached': 'delegate* unmanaged<void*, byte*, byte>',
        'GetGameDir':       'delegate* unmanaged<void*, byte*, int, void>',
        'GetMapEntitiesString': 'delegate* unmanaged<void*, byte*>',
    }

    emitted = dict((m.group(2), m.group(1)) for m in re.finditer(
        r'public (delegate\* unmanaged<[^>]*>|nint) (\w+);', body))

    agreed = [name for name, kind in was_hand_typed.items() if emitted.get(name) == kind]

    expect('all fourteen types the deleted ledger hand-wrote are re-derived '
           'identically from the headers',
           len(agreed) == len(was_hand_typed))
    expect('and the fifteenth is corrected: cdll_int.h says GetProtocolVersion '
           'returns uint, where the hand-typed row said int',
           emitted.get('GetProtocolVersion') == 'delegate* unmanaged<void*, uint>')

    # -- ( void ) is not a parameter -----------------------------------------
    expect('`GetLevelName( void )` takes NO parameter -- reading the `void` as one '
           'gives an arity that does not match the ABI',
           signature_of('const char *', 'void') == 'delegate* unmanaged<void*, byte*>')
    expect('the destructor pair is commented "destructor 1" and "destructor 2"',
           'destructor 1 --' in (generated or '') and 'destructor 2 --' in (generated or ''))
    expect('the D1/D0 explanation is at the type',
           'Complete Object Destructor (D1)' in (generated or '')
           and 'Deleting Destructor (D0)' in (generated or ''))
    # EVERY POLICY REASON IS CARRIED, AND THE NUMBER IS DERIVED RATHER THAN
    # TYPED. It was written down as 73/74/75 and went red the first time a
    # refusal was LIFTED -- plan_native_api.md Phase 3 exposed four methods on
    # IVEngineServer and one on IBaseFileSystem, and a hand-kept literal makes
    # that read as a defect instead of as the work.
    #
    # The +1 is IVModelInfo's: its one reason lands on the CLIENT spelling of
    # that interface as well as the server's, because both structs are walked
    # from the same class. The count is taken over the FIELDS rather than over
    # the file, because the preamble says the phrase too and matching it there
    # would pass for free.
    reasons = sum(len(v) for k, v in load_policy().items() if k != '_comment')
    modelinfo = len(load_policy().get('IVModelInfo', {}))

    expect('every policy reason is carried onto the field it names -- %d reasons, '
           '%d annotations, the difference being IVModelInfo\'s, which land on the '
           'client spelling of that interface as well as the server\'s'
           % (reasons, reasons + modelinfo),
           body.count('NOT EXPOSED (policy, not verification)') == reasons + modelinfo
           and generated.count('NOT EXPOSED (policy, not verification)')
               == reasons + modelinfo + 1)
    expect('ClientCmd_Unrestricted keeps its reason -- it runs a console command '
           'and must not become callable from managed',
           'ClientCmd_Unrestricted' in body)
    expect('a reason is filed under the class that DECLARES the method: '
           'IsWindowedMode is IVEngineClient\'s, not IVEngineClient013\'s',
           'IsWindowedMode' in load_policy().get('IVEngineClient', {}))

    # -- the overload rule ---------------------------------------------------
    expect('IBaseFileSystem::Size is emitted TWICE and the second is Size_2 -- a '
           'name-keyed table would hand a filename to the FileHandle_t overload',
           'Size;' in (generated or '') and 'Size_2;' in (generated or ''))

    # -- a policy key that names nothing -------------------------------------
    saved = dict(load_policy.__globals__)
    policy = load_policy()
    policy.setdefault('IVModelInfo', {})['NoSuchMethodExists'] = 'x'
    entry = [e for e in INTERFACES if e['struct'] == 'ModelInfoVtbl'][0]
    fields, _ = fields_for(entry, policy)
    text = '\n'.join(str(f) for f in (fields or []))
    expect('a policy reason for a method the header does not declare lands on NOTHING '
           '-- reported by --check rather than silently dropped',
           'NoSuchMethodExists' not in text)

    # -- the implemented-by-managed kind ---------------------------------------
    #
    # Each refusal arm is paired with the header that differs from the accepted
    # one in exactly the property under test, so an arm that passes because the
    # walk broke -- rather than because the rule fired -- cannot read as green.
    accepted_header = """
        class IManagedKindProbe
        {
        protected:
            ~IManagedKindProbe() {}
        public:
            virtual void Release() = 0;
            virtual int32_t Validate( const uint32_t *pSlotHashes, int32_t nSlots ) = 0;
            virtual bool OnStart() = 0;
            virtual int OnWrite( char *pOut, int nOutSize ) = 0;
        };
    """
    probe_rows, _ = derive_chain(accepted_header, ['IManagedKindProbe'])
    expect('implemented-by-managed ACCEPTS Release at slot 0, Validate at slot 1 and '
           'no virtual destructor (the control: four slots, no refusal)',
           probe_rows is not None and len(probe_rows) == 4
           and managed_implementation_refusals(probe_rows, {}) == [])

    with_dtor = accepted_header.replace('~IManagedKindProbe() {}',
                                        'virtual ~IManagedKindProbe() {}')
    dtor_rows, _ = derive_chain(with_dtor, ['IManagedKindProbe'])
    expect('implemented-by-managed REFUSES a virtual destructor',
           any('virtual destructor' in r
               for r in managed_implementation_refusals(dtor_rows, {})))

    no_release = accepted_header.replace('virtual void Release() = 0;', '')
    nr_rows, _ = derive_chain(no_release, ['IManagedKindProbe'])
    expect('implemented-by-managed REFUSES a table that does not start with Release()',
           any('Release' in r for r in managed_implementation_refusals(nr_rows, {})))

    release_last = accepted_header.replace(
        '            virtual void Release() = 0;\n', '').replace(
        'virtual int OnWrite( char *pOut, int nOutSize ) = 0;',
        'virtual int OnWrite( char *pOut, int nOutSize ) = 0;\n            virtual void Release() = 0;')
    rl_rows, _ = derive_chain(release_last, ['IManagedKindProbe'])
    expect('implemented-by-managed REFUSES Release() anywhere but slot 0 (the old, last-slot '
           'shape)',
           rl_rows is not None and rl_rows[-1][1] == 'Release'
           and any('slot 0' in r for r in managed_implementation_refusals(rl_rows, {})))

    validate_moved = accepted_header.replace(
        '            virtual int32_t Validate( const uint32_t *pSlotHashes, int32_t nSlots ) = 0;\n', '').replace(
        'virtual int OnWrite( char *pOut, int nOutSize ) = 0;',
        'virtual int OnWrite( char *pOut, int nOutSize ) = 0;\n'
        '            virtual int32_t Validate( const uint32_t *pSlotHashes, int32_t nSlots ) = 0;')
    vm_rows, _ = derive_chain(validate_moved, ['IManagedKindProbe'])
    expect('implemented-by-managed REFUSES Validate anywhere but slot 1',
           any('slot 1' in r for r in managed_implementation_refusals(vm_rows, {})))

    validate_retyped = accepted_header.replace(
        'virtual int32_t Validate( const uint32_t *pSlotHashes, int32_t nSlots ) = 0;',
        'virtual int32_t Validate( const uint32_t *pSlotHashes ) = 0;')
    vr_rows, _ = derive_chain(validate_retyped, ['IManagedKindProbe'])
    expect('implemented-by-managed REFUSES a Validate whose shape differs',
           any('slot 1' in r for r in managed_implementation_refusals(vr_rows, {})))

    # -- the valve-implemented-by-managed kind (plan_physics_managed B0b) ------
    #
    # Valve's own slots, so no Release/Validate is required; the destructor
    # refusal still holds. Each arm is paired with the control above.
    valve_header = """
        class IValveKindProbe
        {
        public:
            virtual void ObjectWake( void *pObject ) = 0;
            virtual void ObjectSleep( void *pObject ) = 0;
        };
    """
    valve_rows, _ = derive_chain(valve_header, ['IValveKindProbe'])
    expect('valve-implemented-by-managed ACCEPTS a table with no Release or Validate '
           '(two slots, no refusal), which implemented-by-managed refuses',
           valve_rows is not None and len(valve_rows) == 2
           and managed_implementation_refusals(valve_rows, {}, valve_layout=True) == []
           and managed_implementation_refusals(valve_rows, {}) != [])

    valve_dtor = valve_header.replace('public:', 'public:\n            virtual ~IValveKindProbe() {}')
    vd_rows, _ = derive_chain(valve_dtor, ['IValveKindProbe'])
    expect('valve-implemented-by-managed still REFUSES a virtual destructor',
           any('virtual destructor' in r
               for r in managed_implementation_refusals(vd_rows, {}, valve_layout=True)))

    # plan_managed_vtable_reload.md L1: a slot hash is the field's type and
    # nothing else, so a rename (of the slot or its parameters) still validates
    # and a retype does not.
    shape = 'delegate* unmanaged<void*, byte*, int, void> Name;'
    expect('slot hash: the canonical spelling hashes to its pinned FNV-1a value',
           slot_hash('delegate* unmanaged<void*, void> Release;') == 0x07e0f4c4)
    expect('slot hash: a renamed slot keeps its hash',
           slot_hash(shape) == slot_hash(shape.replace(' Name;', ' Label;')))
    expect('slot hash: whitespace inside the type does not change it',
           slot_hash(shape) == slot_hash(shape.replace('void*, byte*', 'void* ,   byte*')))
    expect('slot hash: a retyped parameter changes it',
           slot_hash(shape) != slot_hash(shape.replace('int, void>', 'long, void>')))
    expect('slot hash: a changed return changes it',
           slot_hash(shape) != slot_hash(shape.replace('int, void>', 'int, int>')))

    by_value = accepted_header.replace('virtual bool OnStart() = 0;',
                                       'virtual bool OnStart( MapLoadInfo info ) = 0;')
    bv_rows, _ = derive_chain(by_value, ['IManagedKindProbe'])
    expect('implemented-by-managed REFUSES a class passed by value -- managed '
           'cannot fill a slot it cannot spell',
           any('class type by value' in r
               for r in managed_implementation_refusals(bv_rows, {})))

    expect('implemented-by-managed REFUSES a policy reason against one of its slots',
           any('policy reason' in r for r in managed_implementation_refusals(
               probe_rows, {'IManagedKindProbe': {'OnStart': 'x'}})))

    expect('an unknown chain kind is refused rather than read as the default',
           fields_for(dict(struct='X', header='src/sourcesharp/game/shared/'
                           'sourcesharp_gamesystem.h', chain=['IManagedRuntimeServer'],
                           kind='implemented-by-native'), {})[0] is None)

    managed_rows = [e for e in INTERFACES if kind_of(e) == IMPLEMENTED_BY_MANAGED]
    valve_rows_all = [e for e in INTERFACES if kind_of(e) == VALVE_BY_MANAGED]
    expect('every managed-written row is emitted with [ImplementedByManaged] naming its '
           'class -- ValveLayout = true on exactly the valve-layout ones -- and no other '
           'row is',
           generated is not None
           and generated.count('[ImplementedByManaged(') == len(managed_rows) + len(valve_rows_all)
           and all('[ImplementedByManaged("%s")]' % e['chain'][-1] in generated
                   for e in managed_rows)
           and generated.count('ValveLayout = true') == len(valve_rows_all)
           and all('[ImplementedByManaged("%s", ValveLayout = true%s)]'
                   % (e['chain'][-1], reserved_spelling(e))
                   in generated for e in valve_rows_all))

    expect('reserved_words is refused on a row that is not a Valve layout',
           fields_for(dict(struct='X', header='src/sourcesharp/game/shared/'
                           'sourcesharp_gamesystem.h', chain=['IManagedRuntimeServer'],
                           kind=IMPLEMENTED_BY_MANAGED, reserved_words=1), {})[0] is None)

    failed = [name for name, ok in arms if not ok]
    print('\n%d arm(s), %d failed.' % (len(arms), len(failed)), file=out)

    return 1 if failed else 0


def check_policy_keys(out=sys.stdout):
    """Every policy key must name a declaration in the class it is filed under."""
    policy = load_policy()
    declared = {}

    for entry in INTERFACES:
        rows, why = derive_chain(chain_steps(entry))

        if rows is None:
            print('!! %s' % why, file=out)
            return 2

        for cls, name, _p, _r, _s in rows:
            declared.setdefault(cls, set()).add(name)

    bad = 0

    for cls, entries in policy.items():
        for method in entries:
            if method not in declared.get(cls, set()):
                print('!! tools/vtable-policy.json has a reason for %s::%s and %s '
                      'declares no such method' % (cls, method, cls), file=out)
                bad += 1

    return 1 if bad else 0


def main(argv):
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument('--emit', action='store_true')
    parser.add_argument('--write', action='store_true')
    parser.add_argument('--self-test', action='store_true')
    args = parser.parse_args(argv[1:])

    if args.self_test:
        return self_test()

    if args.emit or args.write:
        generated, why = emit()

        if generated is None:
            print('!! %s' % why, file=sys.stderr)
            return 2

        if args.write:
            with open(os.path.join(ROOT, VTBL_FILE), 'w') as handle:
                handle.write(generated)
            print('wrote %s' % VTBL_FILE)
            return 0

        sys.stdout.write(generated)
        return 0

    return check_policy_keys() or check()


if __name__ == '__main__':
    sys.exit(main(sys.argv))

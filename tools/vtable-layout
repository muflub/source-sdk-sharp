def managed_area_rows(spec='docs/managed-interfaces.tsv'):
    """plan_engineapi_vtables E: one implemented-by-managed row per managed-built
    area tools/managed-areas generates (imanaged_areas.h), in the order the spec
    (plan_managed_vtable_reload.md L0) first names each interface."""
    if not os.path.exists(spec):
        return []
    live = []
    with open(spec) as f:
        for line in f:
            if not line.strip() or line.lstrip().startswith('#') or line.startswith('interface\t'):
                continue
            iface = line.split('\t', 1)[0].strip()
            # The root and the runtime are in the spec too (L0b) but are not
            # areas: their rows are the two explicit ones above, walked from
            # imanaged_core.h.
            if iface in ('IManagedRoot', 'IManagedRuntimeServer', 'IManagedRuntimeClient'):
                continue
            if iface not in live:
                live.append(iface)

    rows = []
    for i in live:
        name = i[len('IManaged'):]
        client = i.endswith('Client')   # plan_client_vtables CD: the client's areas
        rows.append(dict(
            struct='Managed%sVtbl' % name,
            shim=True,
            kind=IMPLEMENTED_BY_MANAGED,
            header='src/sourcesharp/game/shared/imanaged_areas_client.h' if client
                   else 'src/sourcesharp/game/shared/imanaged_areas.h',
            chain=['IManagedObject', i],
            chain_headers={'IManagedObject': MANAGED_CORE},
            reached_by='IManagedRoot::Acquire( "%s" )' % i,
            summary='<c>%s</c>, generated by <c>tools/managed-areas</c> from '
                    '<c>docs/managed-interfaces.tsv</c>.' % i,
            note='OURS and GENERATED, and managed writes it: the server\'s ManagedApi '
                 'slots of this family, one method per slot, named after the slot, '
                 'after Release (slot 0) and Validate (slot 1).',

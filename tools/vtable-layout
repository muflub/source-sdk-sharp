# Written against a parameter and meaning nothing to the ABI.
ANNOTATIONS = ('PRINTF_FORMAT_STRING', 'IN_Z', 'OUT_Z_CAP', 'const', 'struct',
               'class', 'enum', 'volatile')

CHAR_FAMILY = ('char', 'signed char', 'unsigned char', 'byte')


class Inexpressible(Exception):
    """Managed cannot spell this call, and no decision could change that."""


def csharp_type(cpp):
    """The C# spelling of one normalised C++ type, or raise Inexpressible."""
    text = ' '.join(cpp.split())

    if '...' in text:
        raise Inexpressible('varargs')

    if not text:
        return 'void'

    # AN ARRAY PARAMETER IS A POINTER. `Vector origin[]` and
    # `unsigned char chAreaBits[MAX_AREA_STATE_BYTES]` are passed as the address
    # of the first element -- C has no other way to pass an array -- so the
    # brackets are removed and what is left is a pointer of that element type.
    # Reading `Vector origin[]` as a by-value Vector would refuse a call that is
    # perfectly expressible.
    if '[' in text:
        text = re.sub(r'\s*\[[^\]]*\]', ' * ', text)
        text = ' '.join(text.split())

    # A POINTER OR A REFERENCE IS A POINTER. That is the whole of what the ABI
    # says about either, and the one distinction managed needs on top of it is
    # "this is a C string I am going to read" -- so char* is byte* and
    # everything else, including every T& out-parameter, is void*.
    if '*' in text or '&' in text:
        depth = text.count('*') + text.count('&')
        base = re.sub(r'[*&]', ' ', text)
        base = base.split('::')[-1] if '::' in base else base

        for word in ANNOTATIONS:
            base = re.sub(r'\b%s\b' % word, ' ', base)

        base = ' '.join(base.split())

        return 'byte*' if depth == 1 and base in CHAR_FAMILY else 'void*'

    stripped = text.split('::')[-1] if '::' in text else text

    for word in ANNOTATIONS:
        stripped = re.sub(r'\b%s\b' % word, ' ', stripped)

    stripped = ' '.join(stripped.split())

    if stripped in SCALARS:
        return SCALARS[stripped]

    if stripped in NAMED:
        return NAMED[stripped][0]

    # A CLASS BY VALUE. Vector, QAngle and VMatrix are passed and returned under
    # SysV rules a fixed `delegate* unmanaged<...>` has no spelling for, so this
    # is a calling-convention refusal and wants a C++ proxy.
    raise Inexpressible('%s is a class type by value' % stripped)


def signature_of(returns, parameters):
    """`delegate* unmanaged<...>` for one method, or raise Inexpressible."""
    types = ['void*']

    # `( void )` IS AN EMPTY PARAMETER LIST, not a parameter. Source's headers
    # write it both ways -- `GetLevelName( void )` and `IsInGame()` -- and taking
    # the first literally appends a `void` to the signature, which is a compile
    # error in the lucky case and an arity that does not match the ABI in the
    # unlucky one.
    declared = parameters.strip()

    if declared == 'void':
        declared = ''

    for part in declared.split(','):
        if part.strip():
            types.append(csharp_type(part))

    types.append(csharp_return_type(returns))

    return 'delegate* unmanaged<%s>' % ', '.join(types)


def csharp_return_type(cpp):
    """csharp_type, plus the by-value returns BY_VALUE_RETURNS can spell."""
    text = ' '.join(cpp.split())
    for word in ANNOTATIONS:
        text = re.sub(r'\b%s\b' % word, ' ', text)
    text = ' '.join(text.split())

    if text in BY_VALUE_RETURNS:
        return BY_VALUE_RETURNS[text]

    return csharp_type(cpp)


# ---------------------------------------------------------------------------
# THE HEADER WALK. Carried over unchanged from tools/vtable-index except that it
# now keeps the RETURN TYPE, which is what let every slot be typed.
#
# Not a C++ parser and it must not pretend to be one: it walks ONE class body
# and refuses what it does not recognise rather than skipping it, because
# skipping a declaration numbers every declaration after it wrongly and does so
# silently.
# ---------------------------------------------------------------------------
def normalise_parameter(text):
    """"const char *pFileName" -> "const char *"; "FileHandle_t file" -> "FileHandle_t"."""
    text = ' '.join(text.split()).split('=')[0].strip()

    if not text:
        return ''

    # A pointer or reference marker is part of the TYPE even when it is written
    # against the name, so it is separated before the name is dropped.
    text = re.sub(r'([*&])', r' \1 ', text)
    parts = text.split()

    # The trailing word is the parameter's NAME unless it is part of the type.
    # "unsigned int" and "const char *" both end in something that is, which is
    # why this is a keyword test and not "drop the last word".
    keywords = {'int', 'float', 'bool', 'char', 'void', 'unsigned', 'signed',
                'long', 'short', 'double', 'const', 'wchar_t'}

    if (len(parts) > 1
            and re.fullmatch(r'[A-Za-z_]\w*', parts[-1])
            and parts[-1] not in keywords):
        parts = parts[:-1]

    return ' '.join(parts)


def normalise_signature(text):
    """A comma-separated parameter list, normalised parameter by parameter."""
    return ', '.join(
        normalise_parameter(part) for part in text.split(',') if part.strip())


def parameters_of(signature):
    """The text between a declaration's outermost parentheses, or None."""
    start = signature.find('(')

    if start < 0:
        return None

    depth = 0

    for at in range(start, len(signature)):
        if signature[at] == '(':
            depth += 1
        elif signature[at] == ')':
            depth -= 1

            if depth == 0:
                return signature[start + 1:at]

    return None


def return_type_of(signature, name_at):
    """
    The declared return type of `virtual<signature>`, whose name starts at
    `name_at`.

    THE OLD WALK THREW THIS AWAY, and that is why two slots could not be typed
    at all. Everything between `virtual` and the method's own name IS the return
    type; the only thing needing care is the pointer or reference marker written
    against the NAME rather than the type, which normalise_parameter already
    handles -- so it is handed a synthetic parameter name and reused, keeping
    returns and parameters spelled by ONE routine rather than two that could
    drift apart.
    """
    return normalise_parameter(signature[:name_at] + ' returnValue')


def class_body(text, interface):
    """The class's body with comments stripped, or (None, reason)."""
    start = re.search(
        r'\b(?:abstract_class|class)\b[^;{]{0,200}?\b%s\b[^;{]{0,200}?\{' % re.escape(interface),
        text)

    if not start:
        return None, 'no class %s' % interface

    # The body, to the matching brace. Nested braces are counted rather than
    # assumed absent: an inline body inside the class would end the walk early
    # and drop every method after it. IVModelInfo has seven of them.
    depth = 0
    at = start.end() - 1
    body_start = at + 1

    while at < len(text):
        if text[at] == '{':
            depth += 1
        elif text[at] == '}':
            depth -= 1
            if depth == 0:
                break
        at += 1
    else:
        return None, 'class %s is not closed' % interface

    body = text[body_start:at]

    # Comments carry declarations that are NOT in the vtable, and random.h is
    # the reason the rule matters: line 28 is `//virtual
    # ~IUniformRandomStream() { }`, commented out. Counting it would put every
    # method two slots too high and every call would reach the wrong function.
    body = re.sub(r'/\*.*?\*/', ' ', body, flags=re.S)
    body = re.sub(r'//[^\n]*', ' ', body)

    # A NESTED CLASS'S VIRTUALS ARE NOT THIS CLASS'S SLOTS, and counting them is
    # not a small error. `ICvar` declares `class ICVarIteratorInternal` inside
    # its own body with a virtual destructor and four methods; walking straight
    # through it made this header answer 42 where the compiler answers 35 --
    # seven slots of drift on an interface whose real table is 35 long.
    #
    # Found by asking the compiler, which is the only thing that could have
    # found it: the walk agreed with itself, the struct compiled, and 42 is a
    # perfectly plausible length.
    body = strip_nested_types(body)

    return body, None


def strip_nested_types(body):
    """The body with every nested class/struct/union DEFINITION removed.

    A forward declaration (`class Foo;`) is left alone -- it has no body and
    declares no slot. Only a definition, which is `class Foo ... { ... }`, is
    cut, and it is cut to its MATCHING brace so a nested type containing another
    one goes whole.
    """
    nested = re.compile(r'\b(?:class|struct|union)\b[^;{()]{0,120}?\{')

    while True:
        match = nested.search(body)

        if not match:
            return body

        depth = 0
        at = match.end() - 1

        while at < len(body):
            if body[at] == '{':
                depth += 1
            elif body[at] == '}':
                depth -= 1
                if depth == 0:
                    break
            at += 1
        else:
            # Unbalanced: leave it rather than truncate the rest of the body.
            return body

        body = body[:match.start()] + ' ' + body[at + 1:]



# ---------------------------------------------------------------------------
# THE PREPROCESSOR, EVALUATED RATHER THAN IGNORED.
#
# A declaration inside a `#if` that is FALSE in this build occupies no slot, and
# counting it shifts every slot below. `ICvar` is where this stopped being
# theoretical: `PublishToVXConsole` sits inside `#if defined( _X360 )`, which is
# false on Linux, and a walk that counted it answered 36 where the compiler
# answers 35.
#
# Found by asking the compiler. Nothing else could have found it -- the walk
# agreed with itself, the struct compiled, and 36 is a perfectly plausible
# length for a 35-slot table.
#
# WHAT THIS IS NOT. It is not a preprocessor. It knows the handful of symbols
# that decide a declaration in these headers, each written down with why it has
# the value it has, and it REFUSES a condition it does not recognise rather than
# assuming one. An unknown `#if` is a hard failure naming the line, because the
# alternative is numbering every slot below it on a guess.
# ---------------------------------------------------------------------------
DEFINES = {
    # The platform this port builds and runs on. `_X360` gates declarations in
    # icvar.h and elsewhere and is false everywhere here.
    '_X360': False,
    '_WIN32': False,
    'WIN32': False,
    '_PS3': False,
    'POSIX': True,
    'LINUX': True,
    '_LINUX': True,
    'PLATFORM_64BITS': True,

    # cdll_int.h's two, and the reason the whole file cares: the shipped engine
    # was built with voice IN and SDL IN, native is compiled to match, and
    # the native code that calls those slots `#error`s if it is not.
    'USE_SDL': True,
    'NO_VOICE': False,

    # This mod builds neither.
    'TF_CLIENT_DLL': False,
    'TF_DLL': False,
    'PORTAL': False,
    'HL1_CLIENT_DLL': False,
    'HL1_DLL': False,

    # Replay is compiled in; the client resolves ReplaySystem001.
    'REPLAY_ENABLED': True,

    'DEDICATED': False,
    'SWDS': False,

    # filesystem.h's blocking-i/o tracker (FileSystemVtbl): nothing in the
    # SDK or this build's compile lines defines it.
    'TRACK_BLOCKING_IO': False,
    'CLIENT_DLL': None,   # side-dependent: a declaration gated on it is refused
    'GAME_DLL': None,
}

CONDITION = re.compile(
    r'^[ \t]*#[ \t]*(?P<kind>ifdef|ifndef|if|elif|else|endif)\b(?P<rest>[^\n]*)')


def evaluate(kind, rest):
    """True / False for a condition, or raise ValueError naming what it is."""
    text = rest.strip()

    if kind == 'ifdef':
        name = text.split()[0] if text.split() else ''
        return lookup(name, text)

    if kind == 'ifndef':
        name = text.split()[0] if text.split() else ''
        return not lookup(name, text)

    # `#if defined( X )`, `#if !defined( X )`, `#if 0`, `#if 1`.
    if text in ('0', '1'):
        return text == '1'

    match = re.fullmatch(r'(?P<not>!\s*)?defined\s*\(?\s*(?P<name>\w+)\s*\)?', text)

    if match:
        value = lookup(match.group('name'), text)
        return (not value) if match.group('not') else value

    raise ValueError('cannot evaluate `#%s %s`' % (kind, text))


def lookup(name, text):
    if name not in DEFINES:
        raise ValueError('`%s` is not in DEFINES, so `#if %s` cannot be decided '
                         'here -- add it with the reason it has its value' % (name, text))

    value = DEFINES[name]

    if value is None:
        raise ValueError('`%s` is side-dependent, so a declaration gated on it is '
                         'in one compilation and not the other' % name)

    return value


# A `virtual` declaration. The preprocessor directives the old walk tracked
# alongside these are no longer read: with native compiled to the engine's own
# defines, a conditional declaration is IN, and counting it is the correct
# answer rather than an unnumberable one.
VIRTUAL = re.compile(r'\bvirtual\b(?P<signature>[^;{]*)')

# Both in ONE pattern so they are seen in SOURCE ORDER: which side of a `#if` a
# declaration falls on is a fact about their positions, and two separate scans
# could not tell.
DIRECTIVE_OR_VIRTUAL = re.compile(
    r'^[ \t]*#[ \t]*(?P<kind>ifdef|ifndef|if|elif|else|endif)\b(?P<rest>[^\n]*)'
    r'|\bvirtual\b(?P<signature>[^;{]*)', re.M)


def walk_body(body):
    """
    Yield (name, parameters, returns, slot) for a class body, in order.

    Raises ValueError with the reason for a declaration it cannot classify: the
    alternative is silently numbering every declaration after it wrongly, which
    is the defect this walk exists to prevent.
    """
    slot = 0

    # One entry per open conditional: True when this branch is compiled.
    stack = []

    for match in DIRECTIVE_OR_VIRTUAL.finditer(body):
        kind = match.group('kind')

        if kind is not None:
            rest = match.group('rest') or ''

            if kind in ('ifdef', 'ifndef', 'if'):
                stack.append(evaluate(kind, rest))
            elif kind == 'elif':
                # An `#elif` is only reached when every branch above it was
                # false, so its own condition decides it.
                if stack:
                    stack[-1] = (not stack[-1]) and evaluate('if', rest)
            elif kind == 'else':
                if stack:
                    stack[-1] = not stack[-1]
            elif kind == 'endif':
                if stack:
                    stack.pop()

            continue

        # A declaration in a branch this build does not compile occupies NO
        # slot, so it is skipped without advancing the counter.
        if not all(stack):
            continue

        signature = match.group('signature')

        # A VIRTUAL DESTRUCTOR TAKES TWO SLOTS -- the complete-object destructor
        # (D1) and the deleting destructor (D0) -- with one source line between
        # them. Yielded as one declaration of its own, two slots wide, so a
        # consumer skips the pair by name rather than meeting a hole it has to
        # guess the meaning of.
        if '~' in signature:
            yield '~destructor', '', 'void', slot
            slot += 2
            continue

        name = re.search(r'([A-Za-z_]\w*)\s*\(', signature)

        if not name:
            raise ValueError(
                'cannot read a method name out of "virtual%s"' % signature.strip())

        parameters = parameters_of(signature)

        if parameters is None:
            raise ValueError(
                'cannot read a parameter list out of "virtual%s"' % signature.strip())

        yield (name.group(1), normalise_signature(parameters),
               return_type_of(signature, name.start(1)), slot)
        slot += 1


def derive_from_header(text, interface):
    """[(method, parameters, returns, slot)] for one class, or (None, reason)."""
    body, why = class_body(text, interface)

    if body is None:
        return None, why

    slots = []

    try:
        for row in walk_body(body):
            slots.append(row)
    except ValueError as error:
        return None, str(error)

    if not slots:
        return None, 'class %s declares no virtual method' % interface

    return slots, None


def chain_steps(entry):
    """[(header, class)] for one interface's chain, base first.

    A CHAIN CAN SPAN HEADERS and most of them do: `IDataCache` derives from
    `IAppSystem`, which is in appframework/IAppSystem.h, and its own slots are
    numbered after that base's five. Reading only the derived class's header
    would number the whole interface from zero.

    An entry writes `chain=['IAppSystem', 'IDataCache']` when both are in its own
    header, or pairs it with `chain_headers` naming the file each class comes
    from. A class with no entry falls back to the interface's own header.
    """
    headers = entry.get('chain_headers', {})

    return [(headers.get(cls, entry['header']), cls) for cls in entry['chain']]


def derive_chain(steps, chain=None):
    """[(class, method, parameters, returns, slot)] across a chain, base first.

    `steps` is [(header, class)]; the two-argument form is kept for the arms that
    pass one text and a list of class names.
    """
    if chain is not None:
        steps = [(steps, cls) for cls in chain]
        read_text = lambda h: h
    else:
        read_text = read

    rows = []
    at = {}        # (method, parameters) -> the slot it already occupies
    overrides = {} # that slot -> the derived classes that re-declare it
    next_slot = 0

    for header, cls in steps:
        text = read_text(header)

        if text is None:
            return None, '%s is missing' % header

        declared, why = derive_from_header(text, cls)

        if declared is None:
            return None, '%s: %s' % (header, why)

        for name, parameters, returns, _local in declared:
            # AN OVERRIDE IS NOT A NEW SLOT, and this is where a chain silently
            # grows if nobody says so. A derived class that re-declares a base's
            # method REPLACES the entry in the base's slot; it does not append.
            #
            # Both cases here were found by the compiler and by nothing else:
            #
            #   IVModelInfoClient re-declares FindOrLoadModel, which IVModelInfo
            #   declares at slot 40 as an obsolete stub. Counted as new, the
            #   chain read 61 where the real table is 60.
            #
            #   IGameEventManager2 re-declares its own virtual destructor over
            #   IBaseInterface's. A destructor override takes the SAME PAIR --
            #   16 where the real table is 14.
            #
            # Keyed on (name, PARAMETERS) rather than name, for the reason
            # IBaseFileSystem::Size exists: two overloads are two slots, and a
            # derived class re-declaring one of them overrides that one only.
            # AND ONLY ACROSS CLASSES. A class does not override itself: two
            # declarations in ONE class are two slots, always. ICvar is what
            # says so -- it declares FindCommandBase, FindVar, FindCommand and
            # GetCommands each TWICE, as a const and a non-const overload with
            # identical parameter lists, and a rule that did not exclude the
            # same class read all four as overrides and dropped them. 31 where
            # the real table is 35.
            #
            # The const qualifier is what tells those apart in C++ and this walk
            # does not read it, so the exclusion is by CLASS rather than by
            # signature. What that leaves uncovered is a derived class declaring
            # a const overload of a base's non-const method -- and the compiler
            # check in vtable_index_agreement_test.cpp is what would catch it,
            # which is how both of the real overrides above were found.
            key = ('~destructor', '') if name == '~destructor' else (name, parameters)
            prior = at.get(key)

            if prior is not None and prior[0] != cls:
                overrides.setdefault(prior[1], []).append(cls)
                continue

            at[key] = (cls, next_slot)
            rows.append((cls, name, parameters, returns, next_slot))
            next_slot += 2 if name == '~destructor' else 1

    return rows, overrides


# ---------------------------------------------------------------------------
# POLICY. Not verification: see the file's own header.
# ---------------------------------------------------------------------------
def load_policy():
    """{class: {method: reason}}, or raise."""
    with open(POLICY_FILE) as handle:
        raw = json.load(handle)

    return {cls: {method: ' '.join(lines)
                  for method, lines in entries.items()}
            for cls, entries in raw.items()
            if not cls.startswith('_')}


VENDOR = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'vendor')
# The self-test's fixtures are the Valve headers as written, the farm's: in
# vendor/ a method nothing uses is a stub (tools/vendor-strip --stub).
READ_VENDOR = [True]


def read(relative):
    """A file's text, or None. A Valve header (src/...) is read from vendor/,
    which the modules build from, before the farm."""
    candidates = [os.path.join(ROOT, relative)]
    if relative.startswith('src/') and READ_VENDOR[0]:
        candidates[:0] = [os.path.join(VENDOR, side, relative[len('src/'):])
                          for side in ('shared', 'client', 'server')]
    for path in candidates:
        try:
            with open(path) as handle:
                return handle.read()
        except OSError:
            continue
    return None


# ---------------------------------------------------------------------------
# THE TYPING, row by row: what the check runs and what the self-test probes.
# ---------------------------------------------------------------------------
def fields_for(entry, policy):
    """([(slot, declaration)], None) for one interface, or (None, why).

    Each declaration is `<C# type> <field>;`: a typed slot's is its
    `delegate* unmanaged<...>` under the method's name, an untypeable one's
    is `nint Refused_<method>`, and a virtual destructor's pair is
    `nint Destructor1;` and `nint Destructor2;`. tools/engine-forwarders types
    its forwarders with the same signature_of, so a row this refuses is a row
    whose forwarders would not have been what the header says.
    """
    # NO ROW NAMES A CHAIN KIND. Every interface here is built by native and
    # called by managed through its generated forwarders, so the direction is
    # not a property a row can vary. A table managed builds is not walked from
    # a C++ class at all: it is a row of docs/managed-interfaces.tsv, and
    # tools/managed-areas writes both of its sides. A `kind` key is refused
    # rather than ignored, because a row that says it is something else and is
    # treated as an ordinary forwarder row is a disagreement nobody would see.
    if 'kind' in entry:
        return None, ('%s names a chain kind (%r), and no row may: every interface here '
                      'is built by native and called by managed through its forwarders '
                      '(tools/engine-forwarders); a table managed builds is a row of '
                      'docs/managed-interfaces.tsv (tools/managed-areas)'
                      % (entry.get('struct', '?'), entry['kind']))

    rows, why = derive_chain(chain_steps(entry))

    if rows is None:
        return None, why

    fields = []

    # How many times each field name has been used so far. IBaseFileSystem
    # declares Size twice and IVModelInfo declares GetVCollide and FindModel
    # twice each, so the second of each is Name_2 -- the same naming
    # tools/engine-forwarders gives a FORWARD row's methods.
    used = {}

    # PER-SLOT [SuppressGCTransition]. A row's `suppress=[...]` names the
    # methods whose calls skip the GC-mode switch, and tools/engine-forwarders
    # applies it to each forwarder's type. A name that is not a typed slot of
    # this chain is refused here rather than ignored there: a misspelt entry
    # would otherwise silently drop the attribute, and the forwarder generator
    # does not check the names itself.
    suppress = set(entry.get('suppress', ()))
    suppressed = set()

    for cls, name, parameters, returns, slot in rows:
        if name == '~destructor':
            fields.append((slot, 'nint Destructor1;'))
            fields.append((slot + 1, 'nint Destructor2;'))
            continue

        proxy = PROXIES.get((cls, name))
        reason = policy.get(cls, {}).get(name)

        try:
            kind = signature_of(returns, parameters)
        except Inexpressible as error:
            kind = None

            # A SLOT MANAGED CANNOT SPELL NEEDS AN ACCOUNT OF ITSELF, and having
            # none is a hard failure rather than a quiet `nint`.
            #
            # ON AN EXPOSED INTERFACE that means one of two things. Either a
            # C++ proxy taking marshalable parameters -- which is what makes
            # the call reachable at all -- or a POLICY reason saying nothing
            # exposes it anyway, in which case a proxy would be dead code.
            # IVEngineServer::ClientCommand is the second kind and says so in
            # its own words: "varargs ... and it runs a command on a client,
            # so it would be refused twice over".
            #
            # ON AN INTERFACE THAT IS NOT EXPOSED the account is already
            # complete: nothing is exposed, so there is nothing for a proxy to
            # serve and no per-method decision to record. Demanding one would
            # mean writing a policy entry for every by-value parameter on
            # interfaces nobody calls -- sentences all saying the same thing,
            # which is how a rule stops being read.
            if entry.get('exposed') and proxy is None and reason is None:
                return None, ('%s::%s cannot be typed (%s) and has neither a C++ proxy '
                              'in PROXIES nor a reason in tools/vtable-policy.json -- '
                              'one of the two, never an untyped slot with no account '
                              'of itself' % (cls, name, error))

        # A PROXY FOR A CALL MANAGED CAN MAKE is dead code, and an entry that
        # outlives the varargs it was written for says the opposite of the
        # header.
        if proxy is not None and kind is not None:
            return None, ('%s::%s names a C++ proxy in PROXIES but IS expressible '
                          'as %s -- a proxy for a call managed can make is dead '
                          'code' % (cls, name, kind))

        if kind is not None and name in suppress:
            kind = kind.replace('delegate* unmanaged<',
                                'delegate* unmanaged[SuppressGCTransition]<', 1)
            suppressed.add(name)

        field = name if kind is not None else 'Refused_' + name

        seen = used.get(field, 0) + 1
        used[field] = seen

        if seen > 1:
            field = '%s_%d' % (field, seen)

        fields.append((slot, '%s %s;' % (kind or 'nint', field)))

    unknown = sorted(suppress - suppressed)
    if unknown:
        return None, ('%s: suppress names %s, which %s not a typed slot of %s'
                      % (entry['struct'], ', '.join(unknown),
                         'is' if len(unknown) == 1 else 'are', ' / '.join(entry['chain'])))

    return fields, None


def check(out=sys.stdout):
    """0 when every row is typed from its own header, 2 when one is not.

    Every row is walked and every failure printed, not only the first: a
    header edit that breaks one chain usually breaks every chain over the
    same base, and the list is what says so.
    """
    policy = load_policy()
    total = 0
    failed = 0

    for entry in INTERFACES:
        fields, why = fields_for(entry, policy)

        if fields is None:
            print('!! %s' % why, file=out)
            failed += 1
            continue

        print('  %-24s %3d slot(s)  %s'
              % (entry['struct'], len(fields), entry.get('version', 'by pointer')),
              file=out)
        total += len(fields)

    if failed:
        return 2

    print('\n%d interface(s), %d slot(s), every one typed from its own declaration.'
          % (len(INTERFACES), total), file=out)

    return 0


# ---------------------------------------------------------------------------
# THE SELF-TEST. A walk with no arm that bites is decoration.
# ---------------------------------------------------------------------------
def self_test(out=sys.stdout):
    READ_VENDOR[0] = False
    arms = []

    def expect(name, condition):
        arms.append((name, bool(condition)))
        print('  %-4s %s' % ('ok' if condition else 'FAIL', name), file=out)

    def row(struct):
        return [e for e in INTERFACES if e['struct'] == struct][0]

    def derived(struct, policy=None):
        """{field: type} as fields_for types one row: the signatures
        tools/engine-forwarders spells for that row's forwarders."""
        fields, _why = fields_for(row(struct), load_policy() if policy is None else policy)
        found = {}
        for _slot, declaration in fields or []:
            cut = declaration.rindex(' ')
            found[declaration[cut + 1:-1]] = declaration[:cut]
        return found

    # -- the walk ------------------------------------------------------------
    body, why = class_body(read('src/public/vstdlib/random.h'), 'IUniformRandomStream')
    expect('random.h IUniformRandomStream body is found', body is not None and why is None)

    rows = list(walk_body(body))
    expect('random.h declares four methods and NO destructor -- line 28 is commented '
           'out, and counting it would move every slot by two',
           len(rows) == 4 and not any(n == '~destructor' for n, _p, _r, _s in rows))
    expect('random.h RandomFloat is slot 1',
           [s for n, _p, _r, s in rows if n == 'RandomFloat'] == [1])

    # -- the destructor pair -------------------------------------------------
    model, _ = derive_from_header(read('src/public/engine/ivmodelinfo.h'), 'IVModelInfo')
    expect('ivmodelinfo.h yields the destructor at slot 0',
           model[0][0] == '~destructor' and model[0][3] == 0)
    expect('ivmodelinfo.h puts GetModel at slot 2, past BOTH destructor slots',
           [s for n, _p, _r, s in model if n == 'GetModel'] == [2])

    # -- the chain -----------------------------------------------------------
    chain, _ = derive_chain(read('src/public/cdll_int.h'),
                            ['IVEngineClient013', 'IVEngineClient'])
    expect('cdll_int.h numbers IVEngineClient::GetProtocolVersion at 138 -- the '
           'derived class CONTINUES the base\'s numbering rather than restarting',
           [s for c, n, _p, _r, s in chain
            if n == 'GetProtocolVersion' and c == 'IVEngineClient'] == [138])
    expect('cdll_int.h counts both conditional declarations IN, so the chain spans 146',
           max(s for _c, _n, _p, _r, s in chain) + 1 == 146)

    # -- per-slot suppression ------------------------------------------------
    frame = row('ShimFrameVtbl')
    policy = load_policy()
    marked, why = fields_for(dict(frame, suppress=['TickCount']), policy)
    decl = dict((d.split()[-1].rstrip(';'), d) for _s, d in (marked or []))
    expect('suppress=[TickCount] types TickCount as unmanaged[SuppressGCTransition]',
           why is None and 'unmanaged[SuppressGCTransition]<' in decl.get('TickCount', ''))
    expect('a slot NOT on the suppress list keeps the plain unmanaged form',
           why is None and 'SuppressGCTransition' not in decl.get('GetFrameTime', 'x Suppress'))
    plain, _ = fields_for(frame, policy)
    expect('a row with no suppress list carries no attribute at all',
           plain is not None and not any('SuppressGCTransition' in d for _s, d in plain))
    bad, why = fields_for(dict(frame, suppress=['NoSuchMethod']), policy)
    expect('a suppress name that is not a typed slot is REFUSED, naming it',
           bad is None and why is not None and 'NoSuchMethod' in why)

    # -- no chain kinds ------------------------------------------------------
    #
    # The control is the plain ShimFrameVtbl row above, which types; the same
    # row with a `kind` key, whatever it says, does not.
    kinded = [fields_for(dict(frame, kind=kind), policy)
              for kind in ('called-by-managed', 'implemented-by-managed')]
    expect('a row naming a chain kind is refused, naming the row and the kind -- '
           'even the kind every row used to be by default',
           plain is not None
           and all(fields is None and 'ShimFrameVtbl names a chain kind' in (why or '')
                   for fields, why in kinded)
           and "'called-by-managed'" in kinded[0][1])

    # -- the type map --------------------------------------------------------
    expect('const char * maps to byte*', csharp_type('const char *') == 'byte*')
    expect('const model_t * maps to void*', csharp_type('const model_t *') == 'void*')
    expect('Vector & -- an out-parameter -- maps to void* and NOT to a by-value refusal',
           csharp_type('Vector &') == 'void*')
    expect('bool maps to byte, because C# bool is not blittable here',
           csharp_type('bool') == 'byte')
    expect('FileHandle_t maps to void* (typedef void *)',
           csharp_type('FileHandle_t') == 'void*')
    expect('MDLHandle_t maps to ushort (typedef unsigned short)',
           csharp_type('MDLHandle_t') == 'ushort')
    expect('long maps to long -- LP64, and GetFileTime returns one',
           csharp_type('long') == 'long')

    def refuses(text):
        try:
            csharp_type(text)
            return False
        except Inexpressible:
            return True

    expect('Vector BY VALUE is refused as a parameter', refuses('Vector'))
    expect('... and spelled as a RETURN: trivial for calls, xmm0:xmm1',
           csharp_return_type('Vector') == 'Vector')
    expect('QAngle by value is still refused as a return (not mapped)',
           refuses('QAngle'))
    expect('... is refused', refuses('...'))
    expect('an unknown class by value is refused, rather than guessed at',
           refuses('CUtlSomethingNobodyMapped'))
    physics_object = derived('PhysicsObjectVtbl')
    expect('IPhysicsObject::GetInertia and GetInvInertia, Vectors returned by value, are '
           'typed with a Vector return rather than refused',
           physics_object.get('GetInertia', '').endswith('<void*, Vector>')
           and physics_object.get('GetInvInertia') == 'delegate* unmanaged<void*, Vector>')

    # -- the shim layer ------------------------------------------------------
    #
    # EVERY SHIM SLOT IS TYPED. `Refused_` means "managed cannot express this
    # call", and for OUR OWN headers that category cannot arise: every
    # signature is a C-ABI one, so there is nothing to refuse. A `nint`
    # appearing on a shim row means somebody wrote a by-value class or a
    # varargs into a header this tree owns -- which ishim_frame.h's own rule
    # forbids -- and this arm is where that shows up rather than in a
    # forwarder.
    shim_rows = [e for e in INTERFACES if e.get('shim')]
    shim_fields = [fields_for(e, policy) for e in shim_rows]
    shim_decls = [d for fields, _why in shim_fields for _s, d in (fields or [])]
    expect('every one of the %d shim rows types, and none has an untyped slot: our '
           'own headers cannot produce a refusal' % len(shim_rows),
           shim_rows and all(fields for fields, _why in shim_fields)
           and not any(d.startswith('nint ') or 'Refused_' in d for d in shim_decls))
    # A SHIM TABLE IS EXACTLY AS LONG AS ITS CLASS, with no destructor pair in
    # front of it: one would take its first two slots, and the singletons
    # behind these are never deleted through a base pointer.
    expect('no shim row declares a virtual destructor (%d slot(s) across %d interface(s))'
           % (len(shim_decls), len(shim_rows)),
           shim_decls and not any('Destructor' in d for d in shim_decls))

    # -- the derivation, which the forwarders read ---------------------------
    expect('an OVERRIDE takes the base\'s slot rather than appending one -- '
           'IGameEventManager2 re-declares IBaseInterface\'s virtual destructor '
           'and the chain is 14 slots, not 16',
           len(derive_chain(chain_steps(row('GameEventManagerVtbl')))[0]) == 13)

    # THE OLD TOOL CARRIED FIFTEEN HAND-CURATED TYPES, written by eye one at a
    # time. Re-derived from the headers, FOURTEEN come out identical -- which
    # is what says the derivation reproduces judgement rather than replacing it
    # with something that merely compiles. The fifteenth is a CORRECTION:
    # cdll_int.h declares `uint GetProtocolVersion()` and the hand-typed row
    # said `int`.
    was_hand_typed = {
        'UniformRandomStreamVtbl': {
            'RandomFloat':      'delegate* unmanaged<void*, float, float, float>',
            'RandomInt':        'delegate* unmanaged<void*, int, int, int>',
            'RandomFloatExp':   'delegate* unmanaged<void*, float, float, float, float>',
        },
        'ModelInfoVtbl': {
            'GetModel':         'delegate* unmanaged<void*, int, void*>',
            'GetModelIndex':    'delegate* unmanaged<void*, byte*, int>',
            'GetModelName':     'delegate* unmanaged<void*, void*, byte*>',
            'GetModelType':     'delegate* unmanaged<void*, void*, int>',
        },
        'BaseFileSystemVtbl': {
            'Size_2':           'delegate* unmanaged<void*, byte*, byte*, uint>',
            'GetFileTime':      'delegate* unmanaged<void*, byte*, byte*, long>',
        },
        'EngineClientVtbl': {
            'GetGameDirectory': 'delegate* unmanaged<void*, byte*>',
            'GetLevelName':     'delegate* unmanaged<void*, byte*>',
        },
        'EngineServerVtbl': {
            'IsModelPrecached': 'delegate* unmanaged<void*, byte*, byte>',
            'GetGameDir':       'delegate* unmanaged<void*, byte*, int, void>',
            'GetMapEntitiesString': 'delegate* unmanaged<void*, byte*>',
        },
    }
    agreed = [name for struct, types in was_hand_typed.items()
              for name, kind in types.items() if derived(struct).get(name) == kind]
    expect('all fourteen types the deleted ledger hand-wrote are re-derived '
           'identically from the headers',
           len(agreed) == sum(len(types) for types in was_hand_typed.values()))
    expect('and the fifteenth is corrected: cdll_int.h says GetProtocolVersion '
           'returns uint, where the hand-typed row said int',
           derived('EngineClientVtbl').get('GetProtocolVersion') == 'delegate* unmanaged<void*, uint>')

    expect('`GetLevelName( void )` takes NO parameter -- reading the `void` as one '
           'gives an arity that does not match the ABI',
           signature_of('const char *', 'void') == 'delegate* unmanaged<void*, byte*>')
    expect('IBaseFileSystem::Size is derived TWICE and the second is Size_2 -- a '
           'name-keyed table would hand a filename to the FileHandle_t overload',
           'Size' in derived('BaseFileSystemVtbl') and 'Size_2' in derived('BaseFileSystemVtbl'))

    # -- an untypeable slot's account ----------------------------------------
    #
    # IVEngineServer is exposed and its ClientCommand is varargs, accounted for
    # by a policy reason. The control types with the policy as it is; without
    # that one reason the row is refused, naming the slot.
    unaccounted = load_policy()
    removed = unaccounted.get('IVEngineServer', {}).pop('ClientCommand', None)
    fields, why = fields_for(row('EngineServerVtbl'), unaccounted)
    expect('an exposed row\'s untypeable slot with neither a proxy nor a policy reason '
           'is refused, naming it; with its reason it is Refused_ClientCommand',
           removed is not None and 'Refused_ClientCommand' in derived('EngineServerVtbl')
           and fields is None and 'IVEngineServer::ClientCommand cannot be typed' in (why or ''))
    not_exposed = dict(row('EngineServerVtbl'))
    not_exposed.pop('exposed')
    expect('... and the same slot on a row that is NOT exposed needs no account',
           fields_for(not_exposed, unaccounted)[0] is not None)

    # A proxy for a call managed can make is dead code. RandomInt types, so a
    # PROXIES entry naming it is refused; the row types without the entry.
    try:
        PROXIES[('IUniformRandomStream', 'RandomInt')] = 'a proxy nobody needs'
        fields, why = fields_for(row('UniformRandomStreamVtbl'), policy)
    finally:
        PROXIES.pop(('IUniformRandomStream', 'RandomInt'), None)
    expect('a C++ proxy for a slot managed CAN type is refused as dead code, naming it',
           fields_for(row('UniformRandomStreamVtbl'), policy)[0] is not None
           and fields is None and 'IUniformRandomStream::RandomInt names a C++ proxy' in (why or ''))

    # -- slot hashes ----------------------------------------------------------
    #
    # A slot hash is the field's type and nothing else, so a rename (of the
    # slot or its parameters) still validates and a retype does not.
    shape = 'delegate* unmanaged<void*, byte*, int, void> Name;'
    expect('slot hash: the canonical spelling hashes to its pinned FNV-1a value',
           slot_hash('delegate* unmanaged<void*, void> Release;') == 0x07e0f4c4)
    expect('slot hash: a renamed slot keeps its hash',
           slot_hash(shape) == slot_hash(shape.replace(' Name;', ' Label;')))
    expect('slot hash: whitespace inside the type does not change it',
           slot_hash(shape) == slot_hash(shape.replace('void*, byte*', 'void* ,   byte*')))
    expect('slot hash: a retyped parameter changes it',
           slot_hash(shape) != slot_hash(shape.replace('int, void>', 'long, void>')))
    expect('slot hash: a changed return changes it',
           slot_hash(shape) != slot_hash(shape.replace('int, void>', 'int, int>')))

    # -- a policy key that names nothing -------------------------------------
    #
    # The control is the policy as committed, which check_policy_keys passes.
    stale = load_policy()
    stale.setdefault('IVModelInfo', {})['NoSuchMethodExists'] = 'x'
    report = []

    class Lines:
        def write(self, text):
            report.append(text)

    clean = check_policy_keys(Lines())
    flagged = check_policy_keys(Lines(), stale)
    expect('a policy reason for a method the header does not declare is reported, '
           'naming it, rather than silently landing on nothing',
           clean == 0 and flagged == 1
           and 'IVModelInfo::NoSuchMethodExists' in ''.join(report))

    failed = [name for name, ok in arms if not ok]
    print('\n%d arm(s), %d failed.' % (len(arms), len(failed)), file=out)

    return 1 if failed else 0


def check_policy_keys(out=sys.stdout, policy=None):
    """Every policy key must name a declaration in the class it is filed under."""
    policy = load_policy() if policy is None else policy
    declared = {}

    for entry in INTERFACES:
        rows, why = derive_chain(chain_steps(entry))

        if rows is None:
            print('!! %s' % why, file=out)
            return 2

        for cls, name, _p, _r, _s in rows:
            declared.setdefault(cls, set()).add(name)

    bad = 0

    for cls, entries in policy.items():
        for method in entries:
            if method not in declared.get(cls, set()):
                print('!! tools/vtable-policy.json has a reason for %s::%s and %s '
                      'declares no such method' % (cls, method, cls), file=out)
                bad += 1

    return 1 if bad else 0


def main(argv):
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument('--self-test', action='store_true')
    args = parser.parse_args(argv[1:])

    if args.self_test:
        return self_test()

    return check_policy_keys() or check()


if __name__ == '__main__':
    sys.exit(main(sys.argv))

# ---------------------------------------------------------------------------
# THE CHAIN KINDS -- which side of the boundary WRITES the table.
#
# `called-by-managed` is every row below that says nothing: native (the engine,
# or the shim) owns the object and its vtable, managed is handed the pointer and
# CALLS through it. That is the only direction this file knew until
# plan_globals.md G2 item 5.
#
# `implemented-by-managed` is the reverse. Native owns only the C++ abstract
# class; MANAGED builds the object -- `{ void **vtbl; nint gcHandle; }` in
# NativeMemory, the vtable filled with the addresses of [UnmanagedCallersOnly]
# thunks -- and hands native the address, which native uses as an ordinary
# `I<Area> *`. The struct emitted for such a row is the same shape, field N at
# byte 8N, because it describes the same ABI; what changes is who fills it, so
# it carries [ImplementedByManaged] and the fifth generator in
# SourceSharp.Generators (ManagedVtableGenerator) accepts NO OTHER struct.
#
# The kind adds refusals, and each is a thing the reverse direction cannot
# survive rather than a matter of taste:
#
#   * NO VIRTUAL DESTRUCTOR. Itanium emits two slots for one (D1 and D0), and
#     `delete` through the pointer would run a deleting destructor on memory the
#     C++ heap never allocated. Lifetime is an explicit `Release()`.
#   * THE LAST SLOT IS `void Release()`. The generator owns it -- it frees the
#     GCHandle and tombstones the block -- and native's count check is taken
#     from it (`VTableHook::MemberOf( &I::Release ).slot + 1`), so it has to be
#     last for the count to mean the whole table.
#   * EVERY SLOT IS EXPRESSIBLE. A `Refused_` slot is a hole managed cannot fill,
#     and a hole in a table native calls is a call through garbage. A C++ proxy
#     does not help either: proxies serve managed calling native, and here
#     native calls managed.
#   * NO POLICY. `NOT EXPOSED` decides what managed may CALL; managed implements
#     every slot of a table it writes, so a policy entry against one is a
#     sentence about nothing.
# ---------------------------------------------------------------------------
CALLED_BY_MANAGED = 'called-by-managed'
IMPLEMENTED_BY_MANAGED = 'implemented-by-managed'

# VALVE'S LAYOUT, WRITTEN BY MANAGED (plan_physics_managed B0b). A callback
# interface vphysics or the engine calls -- IPhysicsCollisionEvent,
# IPhysicsObjectEvent, IMotionEvent -- whose slots are Valve's, so it cannot
# carry our Release/Validate pair. Managed builds the table in the same
# NativeMemory block as an implemented-by-managed one (the caller reads word 0
# only) and frees it itself when the native holder is done with it; nothing
# native validates it, so the slot hashes serve the reload's compatibility
# check alone. Refused for a virtual destructor, as above: the caller could
# `delete` a block the C++ heap never allocated.
VALVE_BY_MANAGED = 'valve-implemented-by-managed'
KINDS = (CALLED_BY_MANAGED, IMPLEMENTED_BY_MANAGED, VALVE_BY_MANAGED)
MANAGED_WRITTEN = (IMPLEMENTED_BY_MANAGED, VALVE_BY_MANAGED)


def kind_of(entry):
    """The row's chain kind; a row that names none is called-by-managed."""
    return entry.get('kind', CALLED_BY_MANAGED)


def slot_hash(declaration):
    """FNV-1a 32 over a field declaration's TYPE, all whitespace removed:
    `delegate* unmanaged<void*, int, int> Add;` hashes `delegate*unmanaged<void*,int,int>`."""
    text = ''.join(declaration.rstrip(';').rsplit(' ', 1)[0].split())
    h = 2166136261
    for b in text.encode('utf-8'):
        h ^= b
        h = (h * 16777619) & 0xFFFFFFFF
    return h


def reserved_spelling(entry):
    """The attribute's `, ReservedWords = N` for a row with caller-owned words
    after the vptr (CCallbackBase's flags and id), else ''."""
    words = entry.get('reserved_words', 0)
    return ', ReservedWords = %d' % words if words else ''


def managed_implementation_refusals(rows, policy, valve_layout=False):
    """Every reason a chain cannot be implemented by managed, or [].

    `rows` is derive_chain's [(class, method, parameters, returns, slot)].
    `valve_layout` is the valve-implemented-by-managed kind, which keeps the
    caller's own slots and so has no Release/Validate pair to require.
    """
    why = []

    if any(name == '~destructor' for _c, name, _p, _r, _s in rows):
        why.append('declares a virtual destructor, which takes two slots (D1, D0) '
                   'and would let native `delete` memory the C++ heap never '
                   'allocated -- lifetime on this kind is an explicit Release()')

    # THE TWO FIXED SLOTS (plan_managed_vtable_reload.md L1). Release is slot 0,
    # a fixed index like a destructor, and Validate slot 1, with exactly this
    # shape: native calls it before it knows anything else about the object,
    # so its own signature can never be what changed.
    def spelt(row):
        return '%s %s( %s )' % (row[3], row[1], row[2]) if row else 'nothing'

    def norm(text):
        return ' '.join(text.replace('*', ' * ').split())

    if valve_layout:
        pass
    elif not rows or rows[0][1] != 'Release' or rows[0][2].strip() not in ('', 'void') \
            or rows[0][3].strip() != 'void':
        why.append('does not start with `void Release()` (the first slot is %s): the '
                   'generator owns Release and it is slot 0, a fixed index like a '
                   'destructor' % spelt(rows[0] if rows else None))

    if valve_layout:
        pass
    elif len(rows) < 2 or rows[1][1] != 'Validate' or norm(rows[1][3]) != 'int32_t' \
            or norm(rows[1][2]) != norm('const uint32_t *, int32_t'):
        why.append('does not have `int32_t Validate( const uint32_t *pSlotHashes, int32_t '
                   'nSlots )` at slot 1 (it is %s): native calls it before it knows '
                   'anything else about the object, so its shape is fixed'
                   % spelt(rows[1] if len(rows) > 1 else None))

    for cls, name, parameters, returns, _slot in rows:
        if name == '~destructor':
            continue

        try:
            signature_of(returns, parameters)
        except Inexpressible as error:
            why.append('%s::%s cannot be typed (%s): managed cannot fill a slot it '
                       'cannot spell, and a proxy serves the other direction'
                       % (cls, name, error))

        if (cls, name) in PROXIES:
            why.append('%s::%s names a C++ proxy, which is meaningless when native '
                       'calls managed' % (cls, name))

        if name in policy.get(cls, {}):
            why.append('%s::%s has a policy reason, which decides what managed may '
                       'CALL; managed implements every slot of this table'
                       % (cls, name))

    return why



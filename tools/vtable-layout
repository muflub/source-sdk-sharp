# ---------------------------------------------------------------------------
# THE SERVER'S GENERATED SHIM AREAS (plan_engineapi_vtables Phase C).
#
# One row per interface tools/shim-areas binds, read from the same table it
# reads -- docs/engineapi-areas.tsv -- so the two tools cannot disagree about
# which interfaces exist, which chain each is, or which slots skip the GC
# transition (the table's `suppress` column, the A2 attribute).
# ---------------------------------------------------------------------------
def shim_area_rows(path='docs/engineapi-areas.tsv'):
    import csv

    hand = {'IShimRoot', 'IShimConsole'}
    order, slots, base, suppressed = [], {}, {}, set()
    client_order, client_slots = [], {}

    with open(path) as f:
        for r in csv.DictReader(f, delimiter='\t'):
            if r['struct'] != 'EngineApi' or r['interface'] in hand:
                continue
            if r['suppress'] == 'S':
                suppressed.add(r['slot'])
            # plan_client_vtables CC: a client-only area, declared apart.
            if r['kind'] == 'client':
                if r['interface'] not in client_slots:
                    client_order.append(r['interface'])
                    client_slots[r['interface']] = []
                client_slots[r['interface']].append(r['slot'])
                continue
            i = r['interface']
            if i not in slots:
                order.append(i)
                slots[i] = []
                base[i] = r['base'] if r['base'] and r['base'] not in hand else None
            slots[i].append(r['slot'])

    derived = {b for b in base.values() if b}
    rows = []

    for i in order:
        if i in derived:
            continue
        chain = ([base[i]] if base[i] else []) + [i]
        name = i[len('IShim'):]
        rows.append(dict(
            struct='Shim%sVtbl' % name,
            exposed=True,
            shim=True,
            header='src/sourcesharp/game/shared/ishim_areas.h',
            chain=chain,
            version='SourceSharp%s001' % name,
            suppress=[s for c in chain for s in slots[c] if s in suppressed],
            summary='<c>%s</c>, generated by <c>tools/shim-areas</c> from '
                    '<c>docs/engineapi-areas.tsv</c>.' % i,
            note='OURS and GENERATED: the server\'s engine slots of this family, '
                 'one method per slot, named after the slot. Append-only; the count '
                 'is read off the last slot of the most-derived class.',
        ))

    # plan_client_vtables CB: each shared base, which the client implements on
    # its own (CShim<Base>Client) and serves under the base's version string.
    for i in order:
        if i not in derived:
            continue
        name = i[len('IShim'):]
        rows.append(dict(
            struct='Shim%sVtbl' % name,
            exposed=True,
            shim=True,
            header='src/sourcesharp/game/shared/ishim_areas.h',
            chain=[i],
            version='SourceSharp%s001' % name,
            suppress=[s for s in slots[i] if s in suppressed],
            summary='<c>%s</c>, a shared base: the client implements it on its own '
                    '(plan_client_vtables CB).' % i,
            note='OURS and GENERATED: the shared engine slots of this family, '
                 'implemented by the client\'s CShim%sClient. The server reaches the '
                 'same slots through the area that extends it.' % name,
        ))

    for i in client_order:
        name = i[len('IShim'):]
        rows.append(dict(
            struct='Shim%sVtbl' % name,
            exposed=True,
            shim=True,
            header='src/sourcesharp/game/shared/ishim_areas_client.h',
            chain=[i],
            version='SourceSharp%s001' % name,

#!/usr/bin/env python3
"""
tools/shim-header-census -- the four questions `tools/shim-census` refuses.

    tools/shim-header-census includers   sourcesharp/game/shared/handle_cross.h
    tools/shim-header-census references  SourceSharp_CrossHandleToWeapon
    tools/shim-header-census vtables     '^vtable for CTraceFilter'
    tools/shim-header-census orphan-syms sourcesharp/game/shared/sound_emitter.cpp

=============================================================================
WHY THIS EXISTS, AND WHERE IT STOPS
=============================================================================

`tools/shim-census who-imports` is the sanctioned consumer census and this does
not replace it.  Asked about a HEADER it says, correctly:

    src/.../handle_cross.h is not a compiled translation unit on this side --
    0 objects, so it defines no symbols of its own and this answer is vacuous,
    not a proof of deadness.

That refusal is right, and it leaves three real questions unanswered, each of
which has already produced a wrong ruling in this port:

 1. A HEADER has no object.  `includers` answers it from ninja's own dependency
    database (the CMake build's `farm/<config>/build/.ninja_deps`, read
    directly rather than through `ninja -t deps`, so the answer does not
    depend on which ninja is on PATH), intersected with the objects on the
    .so's LINK EDGE in build.ninja -- the same rule shim-census enforces, for
    the same reason.  Every linked object must have a record in the log: one
    without is a refusal, because `deps.get(obj, [])` answering an empty list
    is how a re-keyed log would read "nothing includes it" for every header.

 2. An INLINE or TEMPLATE entity emits no out-of-line symbol, so a per-function
    census reads it as unused when it is not.  plan_shim.md §7 records this as
    3f's open question for the nine trace filters; `references` and `vtables`
    are the two halves of the answer.  `references` scans the TEXT of every
    live translation unit (the .cpp plus every header in its deps closure) with
    comments stripped; `vtables` runs `nm -C` over the link line and reports
    vtable/typeinfo rows DEFINED (type V/W) and UNDEFINED (type U) alike,
    because a class with a key function is emitted once and referenced from
    everywhere else.

 3. A ConVar or a ConCommand is reached BY NAME and no link-line census sees
    it.  `references` finds the string; the caller still has to grep `tools/`,
    `docs/`, `cfg/` and the managed tree, which this tool does not do for you.

`orphan-syms` is the per-symbol complement of `who-imports`: for ONE source
file, which of the symbols its object DEFINES does no other object on either
link line import.  `--text` restricts definitions to type T, which is what you
want when the question is "may this function body go".

HOW IT CAN STILL BE WRONG, stated so nobody quotes it as more than it is:

  * `orphan-syms` cannot see a caller INSIDE the same translation unit.  A
    function called only by its neighbour reads ORPHAN and is not dead.  Grep
    the file before you delete.
  * `references` matches text, so a name that appears only in a string literal
    or in dead preprocessor arms counts.  That direction is safe (it over-
    reports consumers), which is the direction a deletion tool should err in.
  * Comments are stripped before matching precisely so the opposite error does
    not happen: `tools/entity-census-patterns` matches raw text and a tombstone
    naming its own subject put deleted call sites back into the census.

`--self-test` proves each subcommand can tell a live subject from a dead one:
every check has a NEGATIVE CONTROL beside it, because a census that answers 0
for everything passes any test that only asks whether the dead thing is dead.

THE REFUSALS.  Same policy as shim-census: MISSING (the graph names an object
that is not on disk) is fatal, because nm reads nothing and every count that
object would have contributed is silently 0.  So is a build whose
compile_commands.json disagrees with the CMakeLists source lists
(tools/cmakegraph.py), and a linked object with no record in the deps log.  A
census that cannot measure must fail, not quietly answer.

    --build-dir D   the CMake build (default farm/<config>/build)
    --config C      debug (default) or release
"""

import collections
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import cmakegraph  # noqa: E402

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)          # the farm this script is IN, never a path
                                      # baked in -- a committed harness outlives
                                      # its lane.
BDIR = None                           # the CMake build dir; set by main()
SRC = None                            # the farm's src/ beside it; set by main()
DEPS_LOG = None                       # BDIR/.ninja_deps; set by main()


def build_for(config):
    """farm/<config>/build. ROOT is the farm this runs in (farm/<x>), so the
    other configuration's build is its sibling farm's."""
    farms = os.path.dirname(ROOT)
    if os.path.basename(farms) == "farm":
        return os.path.join(farms, config, "build")
    return os.path.join(ROOT, "farm", config, "build")


def use_build(bdir):
    global BDIR, SRC, DEPS_LOG
    BDIR = os.path.abspath(bdir)
    SRC = cmakegraph.farm_src(BDIR)
    DEPS_LOG = os.path.join(BDIR, ".ninja_deps")


NM_ROW = re.compile(r'^(?:([0-9a-fA-F]+))?\s+([A-Za-z?])\s+(\S.*)$')
DEF_TYPES = set('TWDBRVtwdbrv')


def die(msg):
    sys.stderr.write("shim-header-census: %s\n" % msg)
    raise SystemExit(2)


def graph_objects():
    """{side: [(absolute object, farm-relative source)]} from each .so's LINK
    EDGE in build.ninja, never from the objects directory. The sources come
    from compile_commands.json, cross-checked against the CMakeLists lists."""
    out = collections.defaultdict(list)
    try:
        for side, target in cmakegraph.SIDES.items():
            cmakegraph.compiled_sources(target, BDIR)
            srcof = {}
            for e in cmakegraph.target_entries(target, BDIR):
                o = e["output"] if os.path.isabs(e["output"]) else os.path.join(BDIR, e["output"])
                srcof[os.path.normpath(o)] = cmakegraph.farm_relative(e["file"], BDIR)
            for o in cmakegraph.link_edge(target, BDIR)["objects"]:
                o = os.path.normpath(o)
                if o not in srcof:
                    die("%s is on the link edge of %s but compile_commands.json "
                        "does not compile it" % (o, target))
                out[side].append((o, srcof[o]))
    except cmakegraph.GraphError as e:
        die(str(e))
    if not out["server"] or not out["client"]:
        die("the build links no shim objects on one side; is this the right build?")
    return out


def require_on_disk(entries, side):
    missing = [o for o, _ in entries if not os.path.exists(o)]
    if missing:
        die("REFUSING on %s: the graph names %d object(s) that are not on disk "
            "(first: %s). Build the tree before measuring it."
            % (side, len(missing), missing[0]))


def require_deps(objs, deps):
    """Every linked object has a record in the deps log. Without one, its
    header list reads as empty -- which is exactly "nothing includes it"."""
    for side in ("server", "client"):
        lost = [o for o, _ in objs[side] if o not in deps]
        if lost:
            die("REFUSING on %s: %d linked object(s) have no record in %s "
                "(first: %s). Rebuild the tree (the log is written by the "
                "compile), or this log keys objects some other way."
                % (side, len(lost), DEPS_LOG, lost[0]))


def _dep_path(p):
    """A deps-log path in the census's spelling: farm-relative when it is under
    the farm's src/ (the CMake build records absolute inputs), else as is."""
    if not os.path.isabs(p):
        p = os.path.normpath(os.path.join(BDIR, p))
    pre = SRC + "/"
    return p[len(pre):] if p.startswith(pre) else p


def deps_database():
    """ninja's own header dependency database, as {object: [inputs]}.

    Read straight out of the build's `.ninja_deps` rather than by shelling
    out to `ninja -t deps` (written when the compiler lived in a container and
    the host had no ninja; it keeps the answer independent of PATH). The
    format is ninja's own and is stable -- a 12-byte magic, a uint32 version,
    then two record kinds distinguished by the top bit of a uint32 size word.

    Keys are absolute object paths (CMake's log names them relative to the
    build dir); inputs are farm-relative where they are under the farm's src/.
    """
    if not os.path.exists(DEPS_LOG):
        die("no %s -- ninja has not built this tree, so no header question "
            "can be answered." % DEPS_LOG)
    with open(DEPS_LOG, 'rb') as f:
        blob = f.read()
    if not blob.startswith(b"# ninjadeps\n"):
        die("%s is not a ninja deps log" % DEPS_LOG)
    import struct
    version, = struct.unpack_from("<I", blob, 12)
    if version not in (3, 4):
        die("unsupported ninja deps log version %d -- refusing to guess"
            % version)
    mtime_words = 2 if version >= 4 else 1
    pos = 16
    paths = []
    deps = {}
    pending = []
    n = len(blob)
    while pos + 4 <= n:
        head, = struct.unpack_from("<I", blob, pos)
        pos += 4
        size = head & 0x7FFFFFFF
        if pos + size > n:
            break                      # a torn tail: ninja tolerates it, so do we
        body = blob[pos:pos + size]
        pos += size
        if head & 0x80000000:          # deps record
            out_id, = struct.unpack_from("<i", body, 0)
            ids = struct.unpack_from(
                "<%di" % ((size - 4 - 4 * mtime_words) // 4),
                body, 4 + 4 * mtime_words)
            pending.append((out_id, ids))
        else:                          # path record
            paths.append(body[:-4].rstrip(b"\0").decode("utf-8", "replace"))
    for out_id, ids in pending:
        if out_id >= len(paths):
            continue
        key = paths[out_id]
        key = os.path.normpath(key if os.path.isabs(key) else os.path.join(BDIR, key))
        deps[key] = [_dep_path(paths[i]) for i in ids if i < len(paths)]
    if not deps:
        die("the deps log holds no dependency records -- build the tree first.")
    return deps


_TEXT = {}


def stripped_text(path):
    """A file with its comments removed, so a tombstone naming its own subject
    does not count as a consumer of it."""
    if path in _TEXT:
        return _TEXT[path]
    full = path if os.path.isabs(path) else os.path.join(SRC, path)
    try:
        with open(full, errors='replace') as fh:
            txt = fh.read()
    except OSError:
        txt = ''
    txt = re.sub(r'/\*.*?\*/', ' ', txt, flags=re.S)
    txt = re.sub(r'//[^\n]*', ' ', txt)
    _TEXT[path] = txt
    return txt


def nm_symbols(obj, text_defs_only=False):
    out = subprocess.run(['nm', obj],
                         capture_output=True, text=True).stdout
    defined, undefined = set(), set()
    for line in out.splitlines():
        m = NM_ROW.match(line)
        if not m:
            continue
        typ, sym = m.group(2), m.group(3)
        if typ == 'U':
            undefined.add(sym)
        elif typ in DEF_TYPES:
            if text_defs_only and typ not in 'Tt':
                continue
            defined.add(sym)
    return defined, undefined


def demangle(names):
    if not names:
        return {}
    out = subprocess.run(['c++filt'], input='\n'.join(names),
                         capture_output=True, text=True).stdout
    return dict(zip(names, out.splitlines()))


def banner(objs):
    print("# tools/shim-header-census -- %s" % " ".join(sys.argv[1:]))
    print("# build\t%s" % os.path.relpath(BDIR, ROOT))
    for side in ("server", "client"):
        print("# objects\t%s\t%d on the graph" % (side, len(objs[side])))


def cmd_includers(objs, args):
    deps = deps_database()
    require_deps(objs, deps)
    for needle in args:
        print("=== %s" % needle)
        # A PATH THAT IS NOT THERE ANSWERS 0/0, AND 0/0 READS LIKE A DELETION
        # PROOF. That is the shape this repo calls "the check that cannot
        # fail", and it bit immediately: a task brief named
        # sourcesharp/game/shared/sequence_events.h, which Phase 2d had already
        # deleted, and the honest 0/0 for a file that does not exist is
        # indistinguishable from the 0/0 for a live file nothing includes.
        # So say so, loudly, instead of answering.
        probe = needle if os.path.isabs(needle) else os.path.join(SRC, needle)
        if not os.path.exists(probe) and not needle.startswith("/"):
            print("  REFUSING\tno such file under src/ -- a count over a path "
                  "that does not exist is 0 for the wrong reason")
            continue
        for side in ("server", "client"):
            hits = sorted({src for obj, src in objs[side]
                           if any(d.endswith(needle) for d in deps.get(obj, []))})
            print("  COUNT\t%s\t%d live translation unit(s) include it" % (side, len(hits)))
            for h in hits:
                print("        %s" % h)


def cmd_references(objs, args):
    excl = [a[len("--exclude="):] for a in args if a.startswith("--exclude=")]
    names = [a for a in args if not a.startswith("--")]
    deps = deps_database()
    require_deps(objs, deps)
    pats = {n: re.compile(r'\b' + re.escape(n) + r'\b') for n in names}
    found = {n: {"server": set(), "client": set()} for n in names}
    for side in ("server", "client"):
        for obj, src in objs[side]:
            for f in [src] + deps.get(obj, []):
                if any(e in f for e in excl):
                    continue
                txt = stripped_text(f)
                if not txt:
                    continue
                for n in names:
                    if pats[n].search(txt):
                        found[n][side].add("%s\t<- %s" % (src, f))
    for n in names:
        print("=== %s" % n)
        for side in ("server", "client"):
            hits = sorted(found[n][side])
            seen = sorted({h.split('\t')[0] for h in hits})
            print("  COUNT\t%s\t%d live translation unit(s) name it" % (side, len(seen)))
            for h in hits:
                print("        %s" % h)


def cmd_vtables(objs, args):
    pat = re.compile(args[0])
    for side in ("server", "client"):
        require_on_disk(objs[side], side)
        hits = collections.defaultdict(set)
        for obj, src in objs[side]:
            out = subprocess.run(['nm', '-C', obj],
                                 capture_output=True, text=True).stdout
            for line in out.splitlines():
                m = NM_ROW.match(line)
                if not m:
                    continue
                typ, sym = m.group(2), m.group(3)
                if not sym.startswith(("vtable for ", "typeinfo for ")):
                    continue
                if pat.search(sym):
                    hits[sym].add("[%s] %s" % (typ, src))
        print("=== %s" % side)
        for sym in sorted(hits):
            print("  %s\t%d object(s)" % (sym, len(hits[sym])))
            for s in sorted(hits[sym]):
                print("        %s" % s)


def cmd_orphan_syms(objs, args):
    text_only = "--text" in args
    target = [a for a in args if not a.startswith("--")][0]
    for side in ("server", "client"):
        entries = objs[side]
        mine = [o for o, s in entries if s == target]
        if not mine:
            print("### %s: %s is not compiled on this side" % (side, target))
            continue
        require_on_disk(entries, side)
        defined = set()
        for o in mine:
            defined |= nm_symbols(o, text_only)[0]
        imported = set()
        for o, s in entries:
            if s == target:
                continue
            imported |= (nm_symbols(o)[1] & defined)
        orphan = sorted(defined - imported)
        dm = demangle(orphan)
        print("### %s: defines %d, %d imported elsewhere, %d ORPHAN"
              % (side, len(defined), len(imported), len(orphan)))
        for s in orphan:
            print("  ORPHAN\t%s" % dm.get(s, s))
        print("#   an ORPHAN may still be called from INSIDE %s, or by name "
              "from a ConCommand. Check both before deleting." % target)


def cmd_self_test(objs, args):
    """Every check here has a NEGATIVE CONTROL beside it.

    A census that answers 0 for everything passes any test that only asks
    "is the dead thing dead" -- that is the check that cannot fail, and it has
    been written into this repo more than forty times. So each subcommand is
    asked about something the tree is known to USE as well, and the pair has to
    come out different.
    """
    failures = []

    def check(name, got, want):
        ok = got == want
        print("  %-4s %s (got %r, want %r)" % ("PASS" if ok else "FAIL", name, got, want))
        if not ok:
            failures.append(name)

    deps = deps_database()
    require_deps(objs, deps)

    def includers_count(path):
        return sum(1 for obj, _ in objs["server"]
                   if any(d.endswith(path) for d in deps.get(obj, [])))

    print("includers -- a header the tree uses vs one that is not there")
    check("slot_table.h is included by many server TUs",
          includers_count("sourcesharp/game/shared/slot_table.h") > 10, True)
    check("a header that does not exist is included by none",
          includers_count("sourcesharp/game/shared/no_such_header_qqq.h"), 0)

    print("references -- a live name vs an invented one")

    def refs(name):
        pat = re.compile(r'\b' + re.escape(name) + r'\b')
        n = 0
        for obj, src in objs["server"]:
            if any(pat.search(stripped_text(f)) for f in [src] + deps.get(obj, [])):
                n += 1
        return n

    check("SourceSharp_CrossHandleToGameEntity is named by server TUs",
          refs("SourceSharp_CrossHandleToGameEntity") > 10, True)
    check("an invented name is named by none",
          refs("SourceSharp_NoSuchSymbolQqq"), 0)

    print("orphan-syms -- agrees with tools/shim-census on one live symbol")
    target = "sourcesharp/game/shared/trace_filter_library.cpp"
    entries = objs["server"]
    mine = [o for o, s in entries if s == target]
    if not mine:
        check("trace_filter_library.cpp is on the server link line", False, True)
    else:
        defined = set()
        for o in mine:
            defined |= nm_symbols(o, True)[0]
        imported = set()
        for o, s in entries:
            if s != target:
                imported |= (nm_symbols(o)[1] & defined)
        # The pair has to be one symbol the tree IMPORTS and one it does not,
        # and BOTH have to be defined by this object -- otherwise "not
        # imported" is satisfied by "not there", which is the failure this
        # whole self-test exists to rule out.
        #
        # RE-ANCHORED, Phase 3f: the unimported half used to be
        # CTraceFilterChain::ShouldHitEntity, and 3f deleted that class. The
        # self-test caught it, which is the point -- an anchor that names a
        # deleted symbol makes the control vacuous rather than red, unless
        # something asserts the symbol is there. PassServerEntityFilter is the
        # replacement: type T in this object, and CTraceFilterSimple's own
        # ShouldHitEntity is its only caller, so nothing imports it.
        live = "_ZN18CTraceFilterSimple15ShouldHitEntityEP13IHandleEntityi"
        dead = "_Z22PassServerEntityFilterPK13IHandleEntityS1_"
        check("CTraceFilterSimple::ShouldHitEntity is imported", live in imported, True)
        check("PassServerEntityFilter is not", dead in imported, False)
        check("both are actually defined by the object",
              live in defined and dead in defined, True)

    print("vtables -- a class the tree emits vs a pattern nothing matches")
    found = set()
    for obj, _ in objs["server"]:
        out = subprocess.run(['nm', '-C', obj],
                             capture_output=True, text=True).stdout
        for line in out.splitlines():
            m = NM_ROW.match(line)
            if m and m.group(3).startswith("vtable for CTraceFilter"):
                found.add(m.group(3))
    check("CTraceFilterSimple's vtable is somewhere on the link line",
          "vtable for CTraceFilterSimple" in found, True)
    check("a class that does not exist has no vtable",
          "vtable for CTraceFilterQqq" in found, False)

    print("%d check(s) failed" % len(failures))
    raise SystemExit(1 if failures else 0)


COMMANDS = {
    "includers": cmd_includers,
    "references": cmd_references,
    "vtables": cmd_vtables,
    "orphan-syms": cmd_orphan_syms,
    "--self-test": cmd_self_test,
}


def main():
    config, bdir = "debug", None
    argv = []
    it = iter(sys.argv[1:])
    for a in it:
        if a in ("--build-dir", "--config"):
            v = next(it, None)
            if v is None:
                die("%s needs a value" % a)
            if a == "--config":
                config = v
            else:
                bdir = v
        else:
            argv.append(a)
    sys.argv[1:] = argv
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS or (
            len(sys.argv) < 3 and sys.argv[1] != "--self-test"):
        sys.stderr.write(__doc__)
        raise SystemExit(2)
    use_build(bdir or build_for(config))
    if not os.path.isdir(BDIR):
        die("no CMake build dir at %s -- build it first (make %s)" % (BDIR, config))
    objs = graph_objects()
    banner(objs)
    COMMANDS[sys.argv[1]](objs, sys.argv[2:])


if __name__ == "__main__":
    main()

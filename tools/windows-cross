#!/usr/bin/env bash
# tools/windows-cross [debug|release] -- a basic Windows check from Linux.
#
# Builds the Windows modules with clang-cl and lld-link over the MSVC CRT and
# Windows SDK xwin laid out (the windows-cross-<config> preset,
# cmake/toolchains/windows-clang-cl.cmake), then loads each DLL under wine
# with tools/build/win_load_check.cpp: LoadLibrary and the entry point the
# engine or the game DLL resolves. A failed compile, link or load fails the
# run. It checks that the Windows arms compile, link and load; GitHub's MSVC
# build stays the real test (warnings, the game itself).
#
# Needs: clang-cl, lld-link, llvm-lib (LLVM 22), wine, and
#   xwin --accept-license --arch x86_64 --include-debug-runtime splat \
#       --include-debug-libs --output ~/.xwin          (XWIN_DIR overrides)
# The pristine clone's devtools/bin tier0.dll and vstdlib.dll stand in for
# the engine's, which libss_particles imports. Wine runs in its own prefix,
# ~/.cache/sourcesharp/windows-cross-wine, never ~/.wine, and never inside
# the repo (its z: drive links to /, and the tests walk the farm).
set -euo pipefail
CONFIG="${1:-debug}"
REPO="$(cd "$(dirname "$0")/.." && pwd)"
BUILD="$REPO/farm/$CONFIG/build-windows-cross"
XWIN="${XWIN_DIR:-$HOME/.xwin}"
TARGETS=(server_sourcesharp ss_fwd_server client_sourcesharp ss_fwd_client sourcesharp ss_particles)
LOADS=(server.dll=CreateInterface ss_fwd_server.dll=SSFwdServer_Table client.dll=CreateInterface ss_fwd_client.dll=SSFwdClient_Table
       managed_host.dll=SourceSharp_LoadServer ss_particles.dll=SSParticleLib_Interface)

for tool in clang-cl-22 lld-link-22 wine; do
    command -v "$tool" > /dev/null || { echo "windows-cross: $tool is not installed"; exit 1; }
done
[[ -f "$XWIN/crt/include/vcruntime.h" ]] || { echo "windows-cross: no xwin sysroot at $XWIN (see this script's header)"; exit 1; }
VALVE="$(cat "$REPO/valve-sdk.lock.local" 2> /dev/null || true)"
[[ -f "$VALVE/src/devtools/bin/tier0.dll" ]] || { echo "windows-cross: no pristine clone (make setup) for devtools/bin/tier0.dll"; exit 1; }

cd "$REPO"
cmake --preset "windows-cross-$CONFIG" > "$BUILD.configure.log" 2>&1 || { tail -20 "$BUILD.configure.log"; exit 1; }
ninja -C "$BUILD" "${TARGETS[@]}"

LOAD="$BUILD/load-check"
rm -rf "$LOAD" && mkdir -p "$LOAD"
clang-cl-22 --target=x86_64-pc-windows-msvc -fuse-ld=lld-link /nologo /MT /O2 -D_CRT_SECURE_NO_WARNINGS \
    /imsvc "$XWIN/crt/include" /imsvc "$XWIN/sdk/include/ucrt" /imsvc "$XWIN/sdk/include/um" \
    /imsvc "$XWIN/sdk/include/shared" tools/build/win_load_check.cpp \
    "/Fe$LOAD/win_load_check.exe" "/Fo$LOAD/win_load_check.obj" \
    /link "/libpath:$XWIN/crt/lib/x86_64" "/libpath:$XWIN/sdk/lib/um/x86_64" "/libpath:$XWIN/sdk/lib/ucrt/x86_64"
cp "$BUILD"/out/*.dll "$VALVE/src/devtools/bin/tier0.dll" "$VALVE/src/devtools/bin/vstdlib.dll" "$LOAD/"
cd "$LOAD"
WINEPREFIX="${XDG_CACHE_HOME:-$HOME/.cache}/sourcesharp/windows-cross-wine" WINEDEBUG=-all wine win_load_check.exe "${LOADS[@]}" 2> /dev/null
echo "windows-cross: $CONFIG: ${#TARGETS[@]} targets built and ${#LOADS[@]} DLLs loaded under wine"

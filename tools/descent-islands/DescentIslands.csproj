<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>descent-islands</AssemblyName>
    <RootNamespace>DescentIslands</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- As ssmap runs the same analysis. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- The map tools checkout whose bin/Release/ holds the built assemblies. -->
    <MapToolsBin>$([MSBuild]::EnsureTrailingSlash('$(MapToolsDir)'))bin/Release/</MapToolsBin>
  </PropertyGroup>

  <ItemGroup>
    <MapToolsAssembly Include="ssmap;SourceSharp.MapTools;SourceSharp.MapFormats;SourceSharp.MapPreview" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy-local: RAR also copies their own dependencies from the same folder. -->
    <Reference Include="ssmap" HintPath="$(MapToolsBin)ssmap.dll" Private="true" />
    <Reference Include="SourceSharp.MapTools" HintPath="$(MapToolsBin)SourceSharp.MapTools.dll" Private="true" />
    <Reference Include="SourceSharp.MapFormats" HintPath="$(MapToolsBin)SourceSharp.MapFormats.dll" Private="true" />
    <Reference Include="SourceSharp.MapPreview" HintPath="$(MapToolsBin)SourceSharp.MapPreview.dll" Private="true" />
  </ItemGroup>

  <Target Name="DescentIslandsCheckMapTools" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="'$(MapToolsDir)' == ''"
           Text="descent-islands: set MapToolsDir to the map tools checkout (the checkout at maptools.lock, which make records in maptools.lock.local); its bin/Release/ must hold the built assemblies." />
    <Error Condition="'$(MapToolsDir)' != '' and !Exists('$(MapToolsBin)%(MapToolsAssembly.Identity).dll')"
           Text="descent-islands: $(MapToolsBin)%(MapToolsAssembly.Identity).dll is missing: build the map tools in Release first." />
  </Target>
</Project>

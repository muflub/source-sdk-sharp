#!/usr/bin/env python3
"""tools/defect-shadow-probe -- IS PASS B'S WEAK `push` THE PLAYER'S SHADOW?

WHAT THIS IS FOR.

`tools/live-gate` runs its checklist TWICE in one process, with a `map` reload
between the passes, and lane `policy-impact` measured the `push` step's own
number across three whole runs:

    trial 1   pass A 208.9   pass B   0.7    <- FAILED the >4.0 check
    trial 2   pass A 218.7   pass B  24.2
    trial 3   pass A 179.5   pass B   8.5

Pass A is 180-220 every time and pass B is an order of magnitude weaker, with
the gate's threshold (4.0) sitting INSIDE pass B's spread. That is not a flake;
something about the SECOND load in one process leaves the prop barely pushed.

The gate cannot answer why, because `push` is its tenth step of twenty and by
the time pass B runs it, nineteen other steps have moved the player, killed
them, respawned them, connected a second client and reloaded the map. This
probe strips all of that away and runs ONLY the push, N times in one process,
with nothing between the measurements but the reload:

    load 1   push                       <- the gate's pass A
    reload
    load 2   push                       <- the gate's pass B
    reload
    load 3   push                       <- and beyond, which the gate never sees

So a difference that survives here is the RELOAD's, and a difference that does
not survive here belongs to the nineteen steps.

AND IT READS THE SHADOW AT EVERY MEASUREMENT. lane `physics-defects` found the
player's own VPhysics shadow at `(-nan, -nan, nan)`, which freezes pair
generation. `ss_physworld_bounds` lists every physics object at a non-finite or
out-of-map position through the public IPhysicsObject API and costs one second.
If pass B's weak push is that same shadow going wrong in a milder way, the
shadow reading moves with the push number. If the shadow reads healthy on every
weak push, the two defects are two.

A PROBE, NOT A GATE: it prints a table and it asserts nothing.

    tools/defect-shadow-probe --loads 4 --trials 3
    tools/defect-shadow-probe --loads 2 --trials 8 --convar sourcesharp_player_shadow=1
"""
import argparse
import importlib.machinery
import importlib.util
import json
import math
import os
import re
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
_path = os.path.join(HERE, "live-gate")
spec = importlib.util.spec_from_file_location(
    "livegate", _path,
    loader=importlib.machinery.SourceFileLoader("livegate", _path))
lg = importlib.util.module_from_spec(spec)
spec.loader.exec_module(lg)

PLAYER_STAND = re.compile(
    r"\[SS-PHYSWORLD-OUTOFBOUNDS\] index=(\d+) name='([^']*)' "
    r"pos=\(([^)]*)\)")
NAN_REFUSALS = re.compile(r"\[SS-PHYSWORLD-NAN\] refusals=(\d+) firstSite=(-?\d+)")
BOUNDS = re.compile(r"\[SS-PHYSWORLD-BOUNDS\] objects=(\d+) outOfBounds=(\d+)")


def _logpath(api):
    return "/tmp/ss-physworld-%s.log" % api.pid


def _size(api):
    path = _logpath(api)
    return len(open(path).read()) if os.path.exists(path) else 0


def _tail(api, before):
    path = _logpath(api)
    if not os.path.exists(path):
        return ""
    return open(path).read()[before:]


def shadow_reading(api):
    """The out-of-bounds roll, in one second.

    `ss_physworld_bounds` walks every object for a non-finite or out-of-bounds
    position and `ss_physworld_nan` prints what the NaN guard refused (managed's
    since the guard moved with the player shadow), so the pair answers whether
    an object is at NaN and whether the guard saw it arrive.
    """
    before = _size(api)
    api.cmd("ss_physworld_bounds")
    api.cmd("ss_physworld_nan")
    time.sleep(0.8)
    text = _tail(api, before)
    out = {"objects": None, "oob": [], "nanRefusals": None}
    for line in text.splitlines():
        m = BOUNDS.search(line)
        if m:
            out["objects"] = int(m.group(1))
        m = PLAYER_STAND.search(line)
        if m:
            out["oob"].append((m.group(2), m.group(3)))
        m = NAN_REFUSALS.search(line)
        if m:
            out["nanRefusals"] = int(m.group(1))
    return out


def describe_shadow(s):
    if s["objects"] is None:
        return "shadow=NO REPORT"
    names = ",".join(n for n, _ in s["oob"]) or "-"
    return ("objects=%s oob=%d[%s] nanRefusals=%s"
            % (s["objects"], len(s["oob"]), names, s["nanRefusals"]))


PHYS_OBJECT = re.compile(
    r"\[SS-PHYSWORLD-OBJECT\] name='([^']*)' pos=\(([^)]*)\) vel=\(([^)]*)\) "
    r"asleep=(\d+) moveable=(\d+)")


def phys_objects(api, logpath, wanted):  # logpath is ignored: see below
    """`ss_physworld_object <substring>` -- where vphysics thinks a body is.

    THE QUESTION IT ANSWERS. When the player stops dead against the crate, is
    their SHADOW stopped too, or is it out in front of them? Stock closes that
    gap in VPhysicsShadowUpdate by moving the player to the shadow; this port
    does not carry that path, so an ahead-shadow would be a shadow that can
    never bring the player along.
    """
    # THE PER-PID PHYSWORLD LOG, not the launch's stdout. A Msg from
    # physics.cpp reaches bin/<config>/mods/test/console.log -- one file shared by every
    # instance in the game directory -- and not the launch's own stdout, so the
    # first version of this read an empty tail and I spent an hour believing the
    # console command had not registered. `help` in console.log said it had.
    before = _size(api)
    api.cmd("ss_physworld_object %s" % wanted)
    time.sleep(0.5)
    text = _tail(api, before)
    out = []
    for m in PHYS_OBJECT.finditer(text):
        out.append({"name": m.group(1),
                    "pos": [float(x) for x in m.group(2).split()],
                    "vel": [float(x) for x in m.group(3).split()],
                    "asleep": int(m.group(4)),
                    "moveable": int(m.group(5))})
    return out


SHADOW_COUNTERS = re.compile(
    r"playershadow: enabled=(\d+) built=(\d+) updates=(\d+) contacts=(\d+) "
    r"touches=(\d+) snaps=(\d+)")

# lane fix-push-jam's own counters, from the managed side. `cs_sv_shadowadvance`
# is SourceSharp.Server's ShadowAdvanceCommand and it prints through
# IEngineConsole, so it lands on the game's stdout beside the line above.
#
# WHY IT IS READ AT ALL: "the crate moved" and "the crate moved and the advance
# never fired once" are opposite findings -- the second says the run drew the
# free mode and the fix is inert -- and from outside the process they look
# identical.
ADVANCE_COUNTERS = re.compile(
    r"shadowadvance: enabled=(\d+) steps=(\d+) advances=(\d+) "
    r"blocked=(\d+) unasked=(\d+)")


def shadow_counters(api, logpath):
    """`cs_sv_playershadow`, which counts the state machine rather than its result.

    updates  ShadowProbe calls -- one per command per player
    contacts those with EITHER contact bit, which is what gates the SOFTENED
             aim (PlayerShadow.Plan: the halfway aim fires only when touching)
    touches  m_bTouchedPhysObject alone, the move helper's own answer
    snaps    the shadow being placed rather than dragged

    It is a Msg(), so it lands on the game's stdout and NOT in the debug-api log --
    that log is managed-only. Read from the launch's own file.
    """
    before = os.path.getsize(logpath) if os.path.exists(logpath) else 0
    api.cmd("cs_sv_playershadow")
    time.sleep(0.6)
    try:
        with open(logpath, errors="replace") as fh:
            fh.seek(before)
            text = fh.read()
    except OSError:
        return None
    m = SHADOW_COUNTERS.search(text)
    if not m:
        return None
    keys = ("enabled", "built", "updates", "contacts", "touches", "snaps")
    out = dict(zip(keys, (int(x) for x in m.groups())))

    # AND THE MANAGED COUNTERS OUT OF THE DEBUG-API LOG, not out of a file.
    # `cs_sv_shadowadvance` prints through IEngineConsole, and Engine.Msg feeds
    # the debug-api LogSink before it reaches the engine -- so the line is in this
    # instance's own log ring. The engine's copy of it lands in
    # bin/<config>/mods/test/console.log, which is ONE file for every game in the game
    # directory and therefore useless to two probe arms running at once. This is
    # the same trap the other way up from the note at the top of phys_objects:
    # native output reaches console.log and never the debug-api log; MANAGED output
    # reaches both, and only the debug-api half is per-instance.
    try:
        seq = api.get("log", 999999, 1).get("next", 0)
        api.cmd("cs_sv_shadowadvance")
        time.sleep(0.6)
        lines = api.log_from(seq, 40)
    except Exception:
        return out

    for line in lines:
        m = ADVANCE_COUNTERS.search(line)
        if m:
            keys = ("advanceOn", "steps", "advances", "advanceBlocked", "advanceUnasked")
            out.update(dict(zip(keys, (int(x) for x in m.groups()))))
    return out


def push_once(g, note, logpath=None, hold=2.0, wake=False):
    """The gate's step 10, measured rather than asserted.

    Every line here is `step_push_prop`'s, in its order, with its settle times.
    A probe whose walk differs from the gate's walk measures a different thing
    and would answer a question nobody asked.
    """
    out = {"fell": None, "walked": None, "closest": None, "moved": None,
           "resting": None, "final": None, "note": note}

    g.cheats()
    g.teleport(g.scen["openFloor"], g.scen["openFloorAngles"], settle=1.2)

    index, resting, fell = lg.spawn_prop(g)
    if index is None or resting is None:
        out["note"] = "no prop"
        return out

    out["fell"] = fell
    out["resting"] = resting

    here = g.player_origin()
    if here is None:
        out["note"] = "no player"
        lg.kill_prop(g)
        return out

    dx, dy = resting[0] - here[0], resting[1] - here[1]
    span = math.hypot(dx, dy) or 1.0
    stand = [resting[0] - dx / span * 64.0,
             resting[1] - dy / span * 64.0,
             resting[2]]
    g.teleport(stand, settle=1.2)
    g.face(resting, lift=64.0)

    walked_from = g.player_origin()
    closest = lg.distance(walked_from, resting)
    counters_before = shadow_counters(g.api, logpath) if logpath else None

    # THE PROP'S OWN TRACK, which the gate does not keep. "It moved 0.7" and
    # "it moved 200 and came back" are different findings and the endpoint
    # distance cannot tell them apart.
    track = []
    if wake:
        # THE SLEEP HYPOTHESIS. vphysics puts an object that has stopped moving
        # to sleep, and a sleeping object is a wall. The crate is spawned, let
        # fall and WAITED ON until it is still -- spawn_prop's own settle loop --
        # and then two more seconds pass while the player is placed and turned,
        # so by the time the walk starts it has been at rest for three. If the
        # jam is the crate sleeping under the shove, waking it every sample
        # turns a jam into a walk; if the jam is elsewhere, waking it changes
        # nothing. `Wake` is prop_physics's own input.
        g.api.fire(lg.PROP_NAME, "Wake")

    g.api.cmd("+forward")
    began = time.time()
    deadline = began + hold
    while time.time() < deadline:
        here = g.player_origin()
        there = lg.prop_origin(g, index)
        if here is not None and there is not None:
            if wake:
                g.api.fire(lg.PROP_NAME, "Wake")
            closest = min(closest, lg.distance(here, there))
            # BOTH TRACKS, because "the crate did not move" and "the player did
            # not walk" are different defects and the endpoint distance cannot
            # tell them apart. The gate has a `walked > 8.0` check for the
            # second one and 8.0 is not a walk: two seconds covers six hundred.
            track.append((round(time.time() - began, 2),
                          round(lg.distance(walked_from, here), 1),
                          round(lg.distance(resting, there), 1)))
    # MID-JAM, while +forward is still held: the one moment the question is
    # about. Taken at the end of the hold rather than after it, because the
    # release is what lets everything settle.
    out["playerDuringHold"] = g.player_origin()
    out["shadowDuringHold"] = phys_objects(g.api, logpath, "player_")

    # AND THE CRATE ITSELF, at the same moment and for the same reason.
    #
    # Every reading this probe has ever taken is about the PLAYER's half of the
    # pair -- where they got to, where their shadow is, what the shadow's state
    # machine counted. None of them can answer the question the tracks actually
    # raise: the pair stops, and at a five-second hold it stays stopped, so
    # WHICH BODY IS REFUSING TO MOVE. A crate that is ASLEEP is a wall whatever
    # the controller does; a crate that is awake with zero velocity under a
    # shadow that is in contact is a force that is too small; and those are
    # different defects with different fixes.
    #
    # `ss_physworld_object` already reports asleep, moveable and mass -- it was
    # only ever pointed at `player_`.
    #
    # BY POSITION, BECAUSE A PHYSICS OBJECT IS NAMED BY ITS CLASSNAME. The
    # object is not called `wood_crate001a` or `ss_livegate_prop`: it is called
    # `prop_physics`, and dm_lockdown holds 414 of those. So the substring
    # names the class and the CLOSEST ONE TO WHERE THE CRATE IS wins, with the
    # distance kept beside it -- a match ten units away is a different prop and
    # a reader can see that rather than believe the reading.
    where = lg.prop_origin(g, index)
    out["propDuringHold"] = nearest_object(
        phys_objects(g.api, logpath, "prop_physics"), where)

    g.api.cmd("-forward")
    time.sleep(0.8)

    # THE ENDPOINTS FIRST. The counter sample below costs 0.6 s and a crate
    # that is still coasting travels through it -- the first version of this
    # probe read `moved` after the sample and turned a 49-unit push into 142.
    walked_to = g.player_origin()
    moved_to = lg.prop_origin(g, index)

    counters_after = shadow_counters(g.api, logpath) if logpath else None
    if counters_before and counters_after:
        keys = ["updates", "contacts", "touches", "snaps"]
        keys += [k for k in ("advances", "advanceBlocked", "advanceUnasked")
                 if k in counters_before and k in counters_after]
        out["counters"] = dict(
            (k, counters_after[k] - counters_before[k]) for k in keys)
        if "advanceOn" in counters_after:
            out["advanceOn"] = counters_after["advanceOn"]

    out["walked"] = lg.distance(walked_from, walked_to) if walked_to else None
    out["closest"] = closest
    out["final"] = moved_to
    out["moved"] = lg.distance(resting, moved_to) if moved_to else None
    out["peak"] = max((d for _, _, d in track), default=0.0)
    out["samples"] = len(track)
    out["track"] = track
    # WHEN the player stopped, which is the whole question a weak push raises.
    # The last sample at which they were still gaining ground.
    out["walkPeak"] = max((w for _, w, _ in track), default=0.0)
    stalled = None
    for i in range(1, len(track)):
        if track[i][1] - track[i - 1][1] < 0.5:
            stalled = track[i][0]
            break
    out["stalledAt"] = stalled

    # DEADLOCK OR SLOW PUSH, which `walked` alone cannot tell apart and which
    # are DIFFERENT DEFECTS. `defect-shadow` established the jam is a deadlock
    # two ways: the walk is bimodal with nothing between, and 2.5x the hold
    # moves the crate no further. A build in which the player pushes at 25 units
    # a second instead of 190 fails the first test exactly as a deadlocked one
    # does -- it is under the FREE_WALK line -- and passes the second, and the
    # second is the one that is about the mechanism.
    #
    # lateGain is that test inside ONE hold: how much ground the player covered
    # in the LAST QUARTER of it. A player who stopped dead covers nothing there
    # however far they got first; a player who is shoving a crate slowly covers
    # about a quarter of their total. It costs no extra hold and it is read off
    # the track that was already kept.
    late = None
    if track:
        cut = (track[-1][0] - track[0][0]) * 0.75 + track[0][0]
        after = [w for t, w, _ in track if t >= cut]
        if len(after) >= 2:
            late = round(after[-1] - after[0], 1)
    out["lateGain"] = late
    out["hold"] = hold
    out["shadowAfter"] = phys_objects(g.api, logpath, "player_")
    out["playerAfter"] = walked_to
    lg.kill_prop(g)
    return out


def trial(scen, convars, loads, repeats=1, keep=False, hold=2.0,
          wake=False, positive=False):
    """One process, `loads` measurements, one map reload between each."""
    port = lg.free_udp_port(*lg.GATE_PORT_RANGE)
    scratch = os.path.join("/tmp", "ss-defshadow-%d-%d" % (os.getpid(), port))
    os.makedirs(scratch, exist_ok=True)
    log = os.path.join(scratch, "server.log")

    argv = lg.server_launch(port, scen["map"])
    at = argv.index("+map")
    for c in convars:
        name, _, value = c.partition("=")
        argv[at:at] = ["+" + name, value]
        at += 2

    game = lg.Game.launch(argv, log, os.path.join(scratch, "server"))
    if game is None:
        return [{"note": "no socket"}]

    api = game.api
    g = lg.Gate(api, scen, verbose=False)
    rows = []
    try:
        if not api.wait_for(lambda: api.player(scen["playerClass"]), 120.0):
            return [{"note": "no player"}]
        time.sleep(2.0)

        for n in range(loads):
            if n:
                api.cmd("map %s" % scen["map"])
                if not api.wait_for(lambda: api.census()[0] >= scen["entities"], 240.0):
                    rows.append({"note": "map would not reload", "load": n + 1})
                    break
                if not api.wait_for(lambda: api.player(scen["playerClass"]), 120.0):
                    rows.append({"note": "no player after reload", "load": n + 1})
                    break
                time.sleep(2.0)

            if positive:
                # A CHECK THAT HAS NEVER FAILED IS NOT YET A CHECK. Sixty-seven
                # shadow readings on this branch have all read
                # oob=0, nanRefusals=0, and "the shadow was healthy every time"
                # means nothing until the reading is shown going red. So put the
                # player -- and with them their shadow, which the controller
                # drags -- a long way outside the map and read it there. That is
                # physics-defects' mechanism driven by hand: an object far
                # outside the map is exactly what the bounds roll names.
                g.cheats()
                home = g.player_origin()
                healthy = shadow_reading(api)
                api.cmd("setpos 65000 65000 4000")
                time.sleep(2.5)
                sick = shadow_reading(api)
                if home:
                    g.teleport(home, settle=2.0)
                back = shadow_reading(api)
                rows.append({"note": "positive control", "load": n + 1,
                             "control": {"healthy": healthy, "far": sick,
                                         "back": back}})

            # REPEATS WITHIN ONE LOAD separate the two candidate variables the
            # gate cannot: its pass B is both the SECOND measurement and the
            # measurement after a RELOAD, and those are different hypotheses.
            # A drop that appears at repeat 2 of load 1 was never about the
            # reload at all.
            for r in range(repeats):
                before = shadow_reading(api)
                row = push_once(g, "", log, hold, wake)
                after = shadow_reading(api)
                row["load"] = n + 1
                row["repeat"] = r + 1
                row["before"] = before
                row["after"] = after
                rows.append(row)
                if not api.alive():
                    rows.append({"note": "the process died", "load": n + 1})
                    break
            if not api.alive():
                break
    finally:
        if not keep:
            try:
                api.cmd("quit")
            except Exception:
                pass
            game.kill()
    return rows


# THE WALK IS BIMODAL AND THIS IS WHERE THE TWO MODES PART. Measured over the
# first 43 holds on this branch: the player either covers 235-286 units in the
# two seconds (a free walk with the crate shoved along in front of them) or
# stops between 30 and 84 and does not move again while +forward is held. There
# is nothing in between -- no hold has ever landed in 100..230.
FREE_WALK = 150.0


def verdict(row):
    """STUCK or FREE, and the boundary SCALES WITH THE HOLD.

    A free walk covers about 120 units a second here, so the two modes part at
    roughly 75 a second; at the gate's own 2.0 s hold that is FREE_WALK exactly,
    and a five-second hold must not call a 150-unit crawl a free walk."""
    w = row.get("walked")
    if w is None:
        return "?"
    return "FREE" if w >= FREE_WALK * (row.get("hold") or 2.0) / 2.0 else "STUCK"


def shadow_gap(row):
    """How far in front of the player their shadow was, in the plane.

    The z is dropped: the shadow's hull origin and the player's feet are not at
    the same height by construction, and the walk is horizontal.
    """
    objs = row.get("shadowDuringHold") or []
    here = row.get("playerDuringHold") or row.get("playerAfter")
    stand = [o for o in objs if o["name"] == "player_stand"]
    if not stand or not here:
        return None
    p = stand[0]["pos"]
    return math.hypot(p[0] - here[0], p[1] - here[1])


def nearest_object(objs, where):
    """The one of `objs` closest to `where`, with the distance kept.

    A physics object is named by its CLASSNAME, so `prop_physics` names every
    physics prop on the map. Identity here is a position, and the distance is
    reported rather than assumed: a "crate" ten units from where the crate is
    is a different prop.
    """
    if not objs or not where:
        return []
    best = min(objs, key=lambda o: lg.distance(o["pos"], where))
    best = dict(best)
    best["awayFromCrate"] = round(lg.distance(best["pos"], where), 2)
    return [best]


def describe_prop(row):
    """The CRATE mid-hold: asleep, and how fast it is actually going.

    A sleeping body is a wall however hard the shadow presses, and an awake
    body at rest under a shadow that reports contact is a force too small.
    Those are different defects, and every other reading this probe takes is
    about the player's half of the pair.
    """
    objs = row.get("propDuringHold") or []
    if not objs:
        return "crate=?"
    o = objs[0]
    speed = math.sqrt(sum(v * v for v in o["vel"]))
    return ("crate asleep=%d speed=%.1f off=%.1f"
            % (o["asleep"], speed, o.get("awayFromCrate", -1.0)))


def describe_counters(c):
    if not c:
        return "counters=?"
    text = ("upd=%d contact=%d touch=%d snap=%d"
            % (c["updates"], c["contacts"], c["touches"], c["snaps"]))
    if "advances" in c:
        text += (" adv=%d(blocked %d, unasked %d)"
                 % (c["advances"], c["advanceBlocked"], c["advanceUnasked"]))
    return text


def box():
    """`hl2_linux64` count and free memory, because a rate from a loaded box is
    evidence of nothing. COMMON.md asks for both around every run."""
    import subprocess
    n = subprocess.run(["pgrep", "-c", "-x", "hl2_linux64"],
                       capture_output=True, text=True).stdout.strip() or "0"
    free = subprocess.run(["free", "-g"], capture_output=True, text=True).stdout
    avail = free.splitlines()[1].split()[-1] if len(free.splitlines()) > 1 else "?"
    load = open("/proc/loadavg").read().split()[0]
    return "hl2_linux64 %s, load %s, %s GB available" % (n, load, avail)


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--map", default="dm_lockdown")
    p.add_argument("--loads", type=int, default=3,
                   help="measurements per process; the gate takes 2")
    p.add_argument("--trials", type=int, default=1, help="processes")
    p.add_argument("--repeats", type=int, default=1,
                   help="push measurements per load, with no reload between")
    p.add_argument("--convar", action="append", default=[],
                   help="name=value, bound on the launch line")
    p.add_argument("--json", default=None, help="write every row here too")
    p.add_argument("--hold", type=float, default=2.0,
                   help="seconds of +forward; the gate holds 2.0. THE DEADLOCK "
                        "TEST: if the pair is truly locked rather than merely "
                        "pushing slowly, a longer hold moves the crate no further")
    p.add_argument("--wake", action="store_true",
                   help="fire the prop's Wake input before and during the hold")
    p.add_argument("--positive-control", action="store_true",
                   help="prove the shadow reading CAN go red: walk the player "
                        "far outside the map, read the bounds roll, walk them back")
    p.add_argument("--keep", action="store_true")
    args = p.parse_args()

    scen = lg.load_scenario(args.map)
    everything = []

    print("box before: %s" % box())
    for t in range(1, args.trials + 1):
        rows = trial(scen, args.convar, args.loads, args.repeats,
                     keep=args.keep, hold=args.hold, wake=args.wake,
                     positive=args.positive_control)
        for r in rows:
            r["trial"] = t
            everything.append(r)
            if r.get("control"):
                c = r["control"]
                print("  trial %d load %s  POSITIVE CONTROL" % (t, r.get("load")))
                for where in ("healthy", "far", "back"):
                    print("      %-8s %s" % (where, describe_shadow(c[where])))
                continue
            if r.get("moved") is None:
                print("  trial %d load %s.%s %s"
                      % (t, r.get("load"), r.get("repeat", 1), r.get("note")))
                continue
            print("  trial %d load %-2s.%-2s moved %8.1f  peak %8.1f  fell %5.1f  "
                  "walked %6.1f (peak %6.1f, late %s, %d samples)  "
                  "closest %5.1f  %-5s gap %s %s | %s"
                  % (t, r["load"], r.get("repeat", 1), r["moved"],
                     r.get("peak", 0.0), r["fell"],
                     r["walked"], r.get("walkPeak", 0.0), r.get("lateGain"),
                     r.get("samples", 0), r["closest"],
                     verdict(r),
                     ("%5.1f" % shadow_gap(r)) if shadow_gap(r) is not None else "    ?",
                     describe_counters(r.get("counters")) + " " + describe_prop(r),
                     describe_shadow(r["after"])))
    print("box after:  %s" % box())

    good = [r for r in everything if r.get("moved") is not None]
    print("\nBY LOAD NUMBER (the gate's pass A is load 1, its pass B is load 2)")
    loads = sorted({r["load"] for r in good})
    for n in loads:
        vals = [r["moved"] for r in good if r["load"] == n]
        sick = [r for r in good if r["load"] == n and r["after"]["oob"]]
        print("  load %-2d n=%-3d moved %s   under 4.0: %d   out of bounds: %d"
              % (n, len(vals), " ".join("%.1f" % v for v in vals),
                 sum(1 for v in vals if v <= 4.0), len(sick)))

    stuck = [r for r in good if verdict(r) == "STUCK"]
    free = [r for r in good if verdict(r) == "FREE"]
    print("\nSTUCK vs FREE -- the walk is what decides `moved`")
    for name, rows in (("STUCK", stuck), ("FREE", free)):
        if not rows:
            continue
        cs = [r["counters"] for r in rows if r.get("counters")]
        lates = [r["lateGain"] for r in rows if r.get("lateGain") is not None]
        print("  %-5s n=%-3d moved %.1f..%.1f  walked %.1f..%.1f  "
              "lateGain %s (median %s, still moving at the end: %d/%d)"
              % (name, len(rows),
                 min(r["moved"] for r in rows), max(r["moved"] for r in rows),
                 min(r["walked"] for r in rows), max(r["walked"] for r in rows),
                 ("%.1f..%.1f" % (min(lates), max(lates))) if lates else "?",
                 ("%.1f" % sorted(lates)[len(lates) // 2]) if lates else "?",
                 sum(1 for v in lates if v >= 1.0), len(lates)))
        if cs:
            for k in ("updates", "contacts", "touches", "snaps"):
                vals = [c[k] for c in cs]
                print("        %-9s mean %7.1f   %s"
                      % (k, sum(vals) / len(vals),
                         " ".join(str(v) for v in vals)))
    print("  STUCK rate %d/%d" % (len(stuck), len(stuck) + len(free)))

    print("\nBY REPEAT WITHIN ONE LOAD (no reload between these)")
    for n in sorted({r.get("repeat", 1) for r in good}):
        vals = [r["moved"] for r in good if r.get("repeat", 1) == n]
        print("  repeat %-2d n=%-3d moved %s   under 4.0: %d"
              % (n, len(vals), " ".join("%.1f" % v for v in vals),
                 sum(1 for v in vals if v <= 4.0)))

    if args.json:
        with open(args.json, "w") as fh:
            json.dump(everything, fh, indent=1)
        print("\nrows -> %s" % args.json)
    return 0


if __name__ == "__main__":
    sys.exit(main())

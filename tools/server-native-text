#!/usr/bin/env python3
"""tools/server-native-text -- release .text per server object, as a ratchet
(plan_server_native_v2 T0.2: a move that leaves a copy behind shows).

    tools/server-native-text            measure farm/release/build's server
                                        objects; compare against
                                        docs/server-native-text.tsv; exit 1
                                        if any object grew, or an object is
                                        new and unlisted
    tools/server-native-text --write    rewrite the committed table
    tools/server-native-text --self-test

Run after `make release` in this checkout (the release build is not part of
make test, so this is not a checks.tsv row: each track's exit quotes it).
A missing build, a missing `size`, or a missing table is a failure. --config
picks another farm (default release).
"""
import os
import subprocess
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TABLE = os.path.join(REPO, "docs", "server-native-text.tsv")


def fail(msg):
    print("server-native-text: " + msg)
    return 1


def objects(cfg):
    out = subprocess.run([sys.executable, os.path.join(REPO, "tools", "cmakegraph.py"),
                          "objects", "server", "--config", cfg], capture_output=True, text=True)
    if out.returncode != 0:
        return None
    rows = []
    for ln in out.stdout.splitlines():
        obj, src = ln.split(" ", 1)
        rows.append((obj, src))
    return rows or None


def text_sizes(rows):
    """{farm-relative source: .text bytes}, or None."""
    sizes = {}
    for obj, src in rows:
        if not os.path.isfile(obj):
            return None
        r = subprocess.run(["size", "-B", obj], capture_output=True, text=True)
        if r.returncode != 0:
            return None
        lines = r.stdout.strip().splitlines()
        sizes[src] = int(lines[-1].split()[0])
    return sizes


def read_table(path):
    if not os.path.isfile(path):
        return None
    t = {}
    for ln in open(path):
        if ln.startswith("#") or not ln.strip():
            continue
        src, n = ln.rstrip("\n").split("\t")
        t[src] = int(n)
    return t


def compare(committed, measured):
    """(grew, new): lists of failure lines."""
    grew = ["%s %d -> %d" % (s, committed[s], n) for s, n in sorted(measured.items())
            if s in committed and n > committed[s]]
    new = ["%s %d (not in the table)" % (s, n) for s, n in sorted(measured.items()) if s not in committed]
    return grew, new


def self_test():
    ok = True

    def ck(name, cond):
        nonlocal ok
        print(("  ok    " if cond else "  FAIL  ") + name)
        ok = ok and cond
    g, n = compare({"a.cpp": 10, "b.cpp": 5}, {"a.cpp": 10, "b.cpp": 4})
    ck("an object that shrank passes", g == [] and n == [])
    g, n = compare({"a.cpp": 10}, {"a.cpp": 11})
    ck("an object that grew is named", g == ["a.cpp 10 -> 11"])
    g, n = compare({"a.cpp": 10}, {"a.cpp": 10, "c.cpp": 3})
    ck("a new object is named", n == ["c.cpp 3 (not in the table)"])
    g, n = compare({"a.cpp": 10, "gone.cpp": 7}, {"a.cpp": 10})
    ck("an object that left the link is a fall, not an error", g == [] and n == [])
    return 0 if ok else 1


def main(argv):
    if "--self-test" in argv:
        return self_test()
    cfg = argv[argv.index("--config") + 1] if "--config" in argv else "release"
    rows = objects(cfg)
    if rows is None:
        return fail("cannot read server.so's link edge for farm/%s (build it first)" % cfg)
    sizes = text_sizes(rows)
    if sizes is None:
        return fail("an object on the link edge is missing or `size -B` failed")
    total = sum(sizes.values())
    print("server-native-text: %d objects, %d bytes of .text (%s)" % (len(sizes), total, cfg))
    if "--write" in argv:
        with open(TABLE, "w") as fh:
            fh.write("# tools/server-native-text: release .text bytes per server object\n"
                     "# (size -B). An object may only shrink; one that is new is listed\n"
                     "# by --write in the commit that adds it, with its reason there.\n"
                     "# total %d over %d objects\n" % (total, len(sizes)))
            for s in sorted(sizes):
                fh.write("%s\t%d\n" % (s, sizes[s]))
        return 0
    committed = read_table(TABLE)
    if committed is None:
        return fail("docs/server-native-text.tsv is missing")
    grew, new = compare(committed, sizes)
    for ln in grew:
        print("  grew  " + ln)
    for ln in new:
        print("  new   " + ln)
    return 1 if grew or new else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

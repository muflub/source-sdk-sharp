    ck("a whole-line ConVar declaration is counted",
       len(decl_lines('ConVar sv_x( "sv_x", "0" );\nstatic ConVar y("y","1");')) == 2)
    ck("CON_COMMAND and ConCommand are counted",
       len(decl_lines('CON_COMMAND( foo, "x" )\nCON_COMMAND_F( bar, "y", 0 )\nConCommand c( "c", f );')) == 3)
    ck("a mention in a comment or a pointer is not",
       decl_lines('// ConVar sv_x( ...\nConVar *p = cvar->FindVar("x");\nextern ConVar sv_x;') == [])
    ck("a client-only declaration is not the server's",
       decl_lines('#ifdef CLIENT_DLL\nConVar a( "a", "0" );\n#endif\n'
                  '#if defined( CLIENT_DLL )\nConVar b( "b", "0" );\n#endif\n'
                  '#ifndef GAME_DLL\nConVar c( "c", "0" );\n#endif') == [])
    ck("the other branch of a client-only #if is the server's",
       len(decl_lines('#ifdef CLIENT_DLL\nConVar a( "a", "0" );\n#else\nConVar b( "b", "0" );\n#endif')) == 1)
    ck("a server-only #else is dead",
       len(decl_lines('#ifndef CLIENT_DLL\nConVar a( "a", "0" );\n#else\nConVar b( "b", "0" );\n#endif')) == 1)
    ck("an unrelated condition counts both branches",
       len(decl_lines('#ifdef _DEBUG\nConVar a( "a", "0" );\n#else\nConVar b( "b", "0" );\n#endif')) == 2)
    ck("a nested client-only block stays dead",
       decl_lines('#ifdef CLIENT_DLL\n#ifdef _DEBUG\n#endif\nConVar a( "a", "0" );\n#endif') == [])

    nm_out = ("/b/x.cpp.o:                 U g_pMemAlloc\n"
              "/b/x.cpp.o:                 U malloc\n"

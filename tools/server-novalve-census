    ck("an allowlisted header is not", "src/public/eiface.h" not in bad)
    ck("our own files are not fork files", len(ff) == 2)
    ff, bad = classify_closure(paths, fork, {"src/public/eiface.h", "src/game/server/cbase.h"})
    ck("negative control: allowlisting it clears it", not bad)

    ck("a game/ line in the allowlist is refused",
       forbidden_allow_lines(["src/public/eiface.h", "src/game/shared/ehandle.h"]) == ["src/game/shared/ehandle.h"])
    ck("vscript/ steam/ particles/ dmxloader/ are refused",

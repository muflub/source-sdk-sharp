    ck("negative control: a longer name or another symbol is not a definer",
       memalloc_definers("/b/i.cpp.o:0000000000000000 D g_pMemAllocator\n") == [])
    ck("the DLL's table: a local definition and an import both count",
       len(memalloc_in_dll("0000000000164d88 d g_pMemAlloc\n                 U g_pMemAlloc\n")) == 2)
    ck("negative control: the DLL's table without it counts nothing",
       memalloc_in_dll("0000000000081f00 t MemAllocOOMError\n0000000000000010 D g_pMemAllocator\n") == [])

    # -- the client target (plan_client_novalve.md 4.3) ----------------------
    C = CLIENT
    paths = {fork + "/src/public/cdll_int.h", fork + "/src/game/client/c_baseentity.h"}

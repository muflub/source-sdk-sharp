# ---------------------------------------------------------------- main


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--config", default=os.environ.get("SOURCESHARP_CONFIG", "debug"))
    ap.add_argument("--target", choices=sorted(TARGETS), default="server")
    ap.add_argument("--write", action="store_true")
    ap.add_argument("--allowlist", action="store_true")
    ap.add_argument("--report", action="store_true")
    ap.add_argument("--self-test", action="store_true")
    a = ap.parse_args()
    t = TARGETS[a.target]
    tool = "%s-novalve-census" % t.name
    allowlist = t.doc("%s-fork-allowlist.txt")
    if a.self_test:
        return self_test()
    try:
        b = Build(a.config, t)
        roots = read_lines(t.doc("%s-fork-roots.txt"))
        generated = probe_allowlist(b, roots)
        bad_allow = forbidden_allow_lines(generated, t)
        if a.allowlist:
            if bad_allow:
                print("REFUSED: the roots' closure reaches forbidden directories:")
                for l in bad_allow:
                    print("  " + l)
                return 1
            with open(allowlist, "w") as f:
                f.write("# docs/%s-fork-allowlist.txt: GENERATED by tools/%s\n"
                        "# --allowlist from docs/%s-fork-roots.txt. Do not edit.\n"
                        % (t.name, tool, t.name))
                f.write("\n".join(generated) + "\n")
            print("wrote %d lines to %s" % (len(generated), os.path.relpath(allowlist, REPO)))
            return 0
        allow = read_lines(allowlist)
        rows, detail = measure(b, allow)
    except Missing as e:
        print("%s: MISSING INPUT: %s" % (tool, e))
        print("1 checks, 1 failed")
        return 1

    checks = failed = 0

    def ck(what, ok, why=""):
        nonlocal checks, failed
        checks += 1
        if not ok:
            failed += 1
            print("  FAIL %s %s" % (what, why))

    ck("allowlist reaches no forbidden directory", not bad_allow, ", ".join(bad_allow[:5]))
    bad_committed = forbidden_allow_lines(allow, t)
    ck("committed allowlist has no line under a forbidden directory", not bad_committed,
       ", ".join(bad_committed[:5]))
    ck("committed allowlist matches the roots' closure", sorted(allow) == generated,
       "(run --allowlist and review the diff)")
    if a.write:
        tip = subprocess.run(["git", "-C", REPO, "rev-parse", "--short", "HEAD"],
                             stdout=subprocess.PIPE, text=True).stdout.strip()
        write_ratchet(rows, tip, t)
        print("wrote %s" % os.path.relpath(t.doc("%s-novalve-ratchet.tsv"), REPO))
    try:
        base = read_ratchet(t)
    except Missing as e:
        print("%s: MISSING INPUT: %s" % (tool, e))
        base = {}
        ck("ratchet exists", False)
    rose, unmeasured, unbaselined = compare(base, rows)
    for k in sorted(rows):
        v = rows[k]
        mark = " (baseline %d)" % base[k] if k in base and base[k] != v else ""
        print("  %-26s %6d%s" % (k, v, mark))
        ck("%s did not rise" % k, not any(r[0] == k for r in rose),
           "%d -> %d" % (base.get(k, 0), v))
    for k in unmeasured:
        ck("baselined row %s was measured" % k, False)
    for k in unbaselined:
        ck("measured row %s has a baseline" % k, False)
    if a.report:
        for k, names in detail.items():
            if names:
                print("== %s" % k)
                for n in names:
                    print("  " + n)
    print("%d checks, %d failed" % (checks, failed))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())

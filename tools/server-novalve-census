class Missing(Exception):
    pass


def run(cmd, cwd=None):
    p = subprocess.run(cmd, cwd=cwd, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, text=True)
    if p.returncode != 0:
        raise Missing("%s failed (%d): %s" % (cmd[0], p.returncode, p.stderr.strip()[:300]))
    return p.stdout


def fork_root():
    local = os.path.join(REPO, "sdk-root.lock.local")
    if not os.path.isfile(local):
        raise Missing("sdk-root.lock.local is missing: run make setup")
    return os.path.realpath(open(local).read().strip())


# ---------------------------------------------------------------- pure parts


def classify_closure(paths, fork, allow):
    """Return (fork_files, not_allowed) for resolved absolute paths."""
    fork_files, bad = set(), set()
    pre = fork.rstrip("/") + "/"
    for p in paths:
        if p.startswith(pre):
            rel = p[len(pre):]
            fork_files.add(rel)
            if rel not in allow:
                bad.add(rel)
    return fork_files, bad


def forbidden_allow_lines(lines, t=SERVER):
    return sorted(l for l in lines if l.startswith(t.forbidden_allow_dirs))


def link_forbidden(tokens, target=SERVER):
    bad = []
    for t in tokens:
        base = os.path.basename(t)
        m = re.match(r"^-l(.+)$", t)
        name = m.group(1) if m else None
        if name is None:
            m = re.match(r"^(?:lib)?([A-Za-z0-9_]+)\.(?:a|so)$", base)
            name = m.group(1) if m else None
        if name in target.forbidden_libs:
            bad.append(t)
        elif "/devtools/" in t:
            bad.append(t)
        elif t.startswith("-Wl,--wrap="):
            if t[len("-Wl,--wrap="):] in TIER0_WRAPS:
                bad.append(t)
    return bad


def incdirs_forbidden(dirs, farm_src, repo, t=SERVER):
    bad = set()
    fs = farm_src.rstrip("/") + "/"
    for d in dirs:
        n = os.path.normpath(d)
        if n.startswith(fs) or n == farm_src.rstrip("/"):
            rel = "src/" + os.path.relpath(n, farm_src) if n != farm_src.rstrip("/") else "src"
            rel = rel.rstrip("/.")
            if rel.startswith("src/sourcesharp"):
                continue                     # this repo's files, linked in
            if rel not in t.allowed_farm_incdirs:
                bad.add(rel)
    return sorted(bad)


RE_PP_IF = re.compile(r"^\s*#\s*(ifdef|ifndef|if|elif|else|endif)\b(.*)$")
# The server compiles with GAME_DLL and without CLIENT_DLL, the client the
# other way round. A branch that is dead for the target's pair (only these two
# plain spellings are understood) holds none of its declarations; every other
# condition counts both of its branches.
RE_CLIENT_ONLY = re.compile(r"^\s*(?:\(\s*)?(?:defined\s*\(?\s*CLIENT_DLL\s*\)?|!\s*defined\s*\(?\s*GAME_DLL\s*\)?)\s*\)?\s*$")
RE_SERVER_ONLY = re.compile(r"^\s*(?:\(\s*)?(?:defined\s*\(?\s*GAME_DLL\s*\)?|!\s*defined\s*\(?\s*CLIENT_DLL\s*\)?)\s*\)?\s*$")


def decl_lines(text, t=SERVER):
    """Whole-line declarations the target's preprocessor can see."""
    dead_re, live_re = (RE_CLIENT_ONLY, RE_SERVER_ONLY) if t.dead_side == "client" \
        else (RE_SERVER_ONLY, RE_CLIENT_ONLY)
    out = []
    stack = []      # per #if: [is the CURRENT branch dead, which side's #if]
    for l in text.splitlines():
        m = RE_PP_IF.match(l)
        if m:
            kw, rest = m.group(1), m.group(2).split("//")[0].strip()
            if kw in ("ifdef", "ifndef", "if"):
                if kw == "ifdef":
                    cond = "defined(%s)" % rest
                elif kw == "ifndef":
                    cond = "!defined(%s)" % rest
                else:
                    cond = rest
                if dead_re.match(cond):
                    stack.append([True, "dead"])
                elif live_re.match(cond):
                    stack.append([False, "live"])
                else:
                    stack.append([False, None])
            elif kw == "elif" and stack:
                stack[-1] = [False, None]
            elif kw == "else" and stack:
                side = stack[-1][1]
                stack[-1] = [side == "live", None]
            elif kw == "endif" and stack:
                stack.pop()
            continue
        if any(dead for dead, _ in stack):
            continue
        if RE_DECL.match(l):
            out.append(l)
    return out


def memalloc_importers(nm_u_a):
    """Objects named by `nm -u -A` output lines that import g_pMemAlloc."""
    hits = set()
    for l in nm_u_a.splitlines():
        m = re.match(r"^(.*?):\s+U (\S+)$", l)
        if m and m.group(2) == "g_pMemAlloc":
            hits.add(m.group(1))
    return sorted(hits)


def memalloc_definers(nm_defined_a):
    """Objects named by `nm --defined-only -A` output lines that define g_pMemAlloc."""
    hits = set()
    for l in nm_defined_a.splitlines():
        m = re.match(r"^(.*?):[0-9a-fA-F]+ [A-Za-z] (\S+)$", l)
        if m and m.group(2) == "g_pMemAlloc":
            hits.add(m.group(1))
    return sorted(hits)


def memalloc_in_dll(nm_text):
    """Lines of `nm` output (any symbol type, U included) naming g_pMemAlloc."""
    return [l.strip() for l in nm_text.splitlines() if l.split() and l.split()[-1] == "g_pMemAlloc"]


def compare(baseline, measured):
    """Rows that rose, and rows missing from either side."""
    rose = [(k, baseline[k], v) for k, v in measured.items()
            if k in baseline and v > baseline[k]]
    unmeasured = sorted(set(baseline) - set(measured))
    unbaselined = sorted(set(measured) - set(baseline))
    return rose, unmeasured, unbaselined


# ---------------------------------------------------------------- measuring


class Build:
    def __init__(self, config, t=SERVER):
        self.config = config
        self.t = t
        self.farm = os.path.join(REPO, "farm", config)
        self.build = os.path.join(self.farm, "build")
        self.src = os.path.join(self.farm, "src")
        if not os.path.isfile(os.path.join(self.build, "build.ninja")):
            raise Missing("%s/build.ninja is missing: run make %s" % (self.build, config))
        cc = os.path.join(self.build, "compile_commands.json")
        if not os.path.isfile(cc):
            raise Missing(cc + " is missing")
        self.cc = [e for e in json.load(open(cc))
                   if any(d in e["output"] for d in t.target_dirs)]
        if not self.cc:
            raise Missing("no %s entries in compile_commands.json" % t.name)
        link = run(["ninja", "-C", self.build, "-t", "commands", t.output]).splitlines()
        if not link:
            raise Missing("no link command for " + t.output)
        self.link_tokens = shlex.split(link[-1].replace(":", " : ") if False else link[-1])
        self.objects = [t for t in self.link_tokens if t.endswith(".o")]
        if not self.objects:
            raise Missing("the link command names no objects")
        so = os.path.join(self.build, t.output)
        if not os.path.isfile(so):
            raise Missing(so + " is missing")
        self.so = so

    def closure(self):
        out = run(["ninja", "-C", self.build, "-t", "deps"] + self.objects)
        paths, seen_obj = set(), 0
        for line in out.splitlines():
            if not line.startswith(" "):
                if line.strip():
                    seen_obj += 1
                    if "deps not found" in line or "STALE" in line and "#deps 0" in line:
                        raise Missing("no deps for " + line.split(":")[0])
                continue
            p = line.strip()
            if not os.path.isabs(p):
                p = os.path.join(self.build, p)
            paths.add(os.path.realpath(p))
        if seen_obj < len(self.objects):
            raise Missing("ninja -t deps covered %d of %d objects" % (seen_obj, len(self.objects)))
        return paths

    def sources(self):
        outs = {os.path.normpath(os.path.join(self.build, o)) for o in self.objects}
        return [os.path.realpath(e["file"]) for e in self.cc
                if os.path.normpath(e["output"]) in outs]

    def incdirs(self, per_tu=False):
        """All -I directories, or {source: set of dirs} when per_tu."""
        dirs, by_tu = set(), {}
        for e in self.cc:
            mine = set()
            toks = shlex.split(e["command"])
            for i, t in enumerate(toks):
                if t in ("-I", "-isystem") and i + 1 < len(toks):
                    mine.add(toks[i + 1])
                elif t.startswith("-I"):
                    mine.add(t[2:])
            dirs |= mine
            by_tu[e["file"]] = mine
        return by_tu if per_tu else dirs

    def needed(self):
        out = run(["readelf", "-dW", self.so])
        return re.findall(r"\(NEEDED\)\s+Shared library: \[([^\]]+)\]", out)

    def lib_files(self):
        """Link-order library files, -l names resolved through -L dirs."""
        ldirs, libs = [], []
        for t in self.link_tokens:
            if t.startswith("-L"):
                ldirs.append(os.path.join(self.build, t[2:]))
        for t in self.link_tokens:
            if t.endswith((".a", ".so")) and not t.startswith("-"):
                libs.append(os.path.join(self.build, t))
            elif t.startswith("-l"):
                for d in ldirs:
                    for cand in ("lib%s.so" % t[2:], "lib%s.a" % t[2:]):
                        if os.path.isfile(os.path.join(d, cand)):
                            libs.append(os.path.join(d, cand))
                            break
                    else:
                        continue
                    break
        return libs

    def memalloc_importers(self):
        objs = [os.path.join(self.build, o) for o in self.objects]
        hits = []
        for chunk in range(0, len(objs), 200):
            out = run(["nm", "-u", "-A"] + objs[chunk:chunk + 200])
            hits += memalloc_importers(out)
        return sorted(os.path.relpath(h, self.build) for h in hits)

    def memalloc_definers(self):
        objs = [os.path.join(self.build, o) for o in self.objects]
        hits = []
        for chunk in range(0, len(objs), 200):
            out = run(["nm", "--defined-only", "-A"] + objs[chunk:chunk + 200])
            hits += memalloc_definers(out)
        return sorted(os.path.relpath(h, self.build) for h in hits)

    def memalloc_in_dll(self):
        # The DLL's own table and its dynamic table: a stripped release
        # build keeps only the second.
        return memalloc_in_dll(run(["nm", self.so])) + memalloc_in_dll(run(["nm", "-D", self.so]))

    def runtime_defined(self):
        """What the C and C++ runtimes define (dynamic symbols, demangled)."""
        out_set = set()
        for rt in ("libstdc++.so", "libc.so.6", "libm.so.6", "libgcc_s.so.1"):
            p = subprocess.run(["c++", "-print-file-name=" + rt],
                               stdout=subprocess.PIPE, text=True).stdout.strip()
            p = os.path.realpath(p)
            if not os.path.isfile(p):
                raise Missing("cannot locate " + rt)
            out = run(["nm", "-DC", "--defined-only", p])
            out_set |= {re.sub(r"@.*$", "", mm.group(2)) for mm in
                        (re.match(r"^[0-9a-f]+ ([A-Za-z]) (.*)$", l) for l in out.splitlines())
                        if mm}
        return out_set

    def home_link_tokens(self):
        """The link line of the library the bound archives moved to, or []."""
        if not self.t.bound_home:
            return []
        link = run(["ninja", "-C", self.build, "-t", "commands", self.t.bound_home]).splitlines()
        return shlex.split(link[-1]) if link else []

    def archive_imports(self, ours_defined, runtime):
        """imports:<lib><-<archive> for each bound archive: the undefined names of
        its members that reached the link (a member is linked when client.so
        defines one of its strong globals and none of our objects does), less
        what the archive itself, our objects and the runtimes define, charged
        to the dropped libraries in link order."""
        rows, detail = {}, {}
        if not self.t.bound_libs:
            return rows, detail
        so_def = set()
        for l in run(["nm", "-C", "--defined-only", self.so]).splitlines():
            mm = re.match(r"^[0-9a-f]+ ([A-Za-z]) (.*)$", l)
            if mm:
                so_def.add(mm.group(2))
        libs = self.lib_files()
        libdefs = {}
        for lib in libs:
            args = ["nm", "-DC", "--defined-only", lib] if lib.endswith(".so") \
                else ["nm", "-C", "--defined-only", lib]
            p = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
            libdefs[lib] = {mm.group(2) for mm in (re.match(r"^[0-9a-f]+ ([A-Za-z]) (.*)$", l)
                                                   for l in p.stdout.splitlines())
                            if mm and mm.group(1) in "TDBRWV"}
        def libname(lib):
            m = re.match(r"^(?:lib)?([A-Za-z0-9_]+)\.(?:a|so)$", os.path.basename(lib))
            return m.group(1) if m else os.path.basename(lib)
        home_tokens = None
        for arch in self.t.bound_libs:
            path = [l for l in libs if libname(l) == arch and l.endswith(".a")]
            if not path:
                if home_tokens is None:
                    home_tokens = self.home_link_tokens()
                if bound_archive_moved(arch, home_tokens):
                    for n in self.t.dropped_for_imports:
                        rows["%s<-%s" % (n, arch)] = 0
                        detail["%s<-%s" % (n, arch)] = []
                    continue
                raise Missing("bound archive %s is not on the link line, nor on %s's"
                              % (arch, self.t.bound_home or "a bound library"))
            members = {}
            cur = None
            for l in run(["nm", "-C", path[0]]).splitlines():
                if l.endswith(":") and not l.startswith(" "):
                    cur = members.setdefault(l[:-1], {"def": set(), "strong": set(), "undef": set()})
                    continue
                if cur is None:
                    continue
                mu = re.match(r"^\s+U (.*)$", l)
                if mu:
                    cur["undef"].add(mu.group(1))
                    continue
                mm = re.match(r"^[0-9a-f]+ ([A-Za-z]) (.*)$", l)
                if mm:
                    cur["def"].add(mm.group(2))
                    if mm.group(1) in "TDBR":
                        cur["strong"].add(mm.group(2))
            linked = [m for m in members.values()
                      if any(n in so_def and n not in ours_defined for n in m["strong"])]
            if not linked:
                raise Missing("no member of %s reached %s: nothing was read" % (arch, self.t.output))
            arch_def = set().union(*(m["def"] for m in members.values()))
            remaining = set().union(*(m["undef"] for m in linked)) - arch_def - ours_defined - runtime
            for n in self.t.dropped_for_imports:
                rows["%s<-%s" % (n, arch)] = 0
                detail["%s<-%s" % (n, arch)] = []
            for lib in libs:
                name = libname(lib)
                if name == arch:
                    continue
                hit = remaining & libdefs[lib]
                remaining -= hit
                if name in self.t.dropped_for_imports:
                    rows["%s<-%s" % (name, arch)] += len(hit)
                    detail["%s<-%s" % (name, arch)] += sorted(hit)
        return rows, detail

    def imports(self):
        objs = [os.path.join(self.build, o) for o in self.objects]
        defined, undef = set(), set()
        for chunk in range(0, len(objs), 200):
            out = run(["nm", "-C", "--defined-only"] + objs[chunk:chunk + 200])
            for l in out.splitlines():
                m = re.match(r"^[0-9a-f]+ ([A-Za-z]) (.*)$", l)
                if m and m.group(1) in "TDBRWVtdbrwvu":
                    defined.add(m.group(2))
            out = run(["nm", "-C", "-u"] + objs[chunk:chunk + 200])
            for l in out.splitlines():
                m = re.match(r"^\s+U (.*)$", l)
                if m:
                    undef.add(m.group(1))
        remaining = undef - defined
        # The C and C++ runtimes first: libsteam_api.so re-exports libstdc++'s
        # ABI symbols (__cxa_*, the typeinfo vtables), and attributing those
        # in link order would charge them to Steam.
        runtime = self.runtime_defined()
        remaining -= runtime
        result = {n: 0 for n in self.t.dropped_for_imports}
        detail = {n: [] for n in self.t.dropped_for_imports}
        for lib in self.lib_files():
            base = os.path.basename(lib)
            m = re.match(r"^(?:lib)?([A-Za-z0-9_]+)\.(?:a|so)$", base)
            name = m.group(1) if m else base
            args = ["nm", "-DC", "--defined-only", lib] if lib.endswith(".so") \
                else ["nm", "-C", "--defined-only", lib]
            p = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
            libdef = set()
            for l in p.stdout.splitlines():
                mm = re.match(r"^[0-9a-f]+ ([A-Za-z]) (.*)$", l)
                if mm and mm.group(1) in "TDBRWV":
                    libdef.add(mm.group(2))
            hit = remaining & libdef
            remaining -= hit
            if name in result:
                result[name] += len(hit)
                detail[name] += sorted(hit)
        arows, adetail = self.archive_imports(defined, runtime)
        result.update(arows)
        detail.update(adetail)
        return result, detail


def probe_allowlist(b, roots):
    """The fork closure of a TU that #includes every root."""
    e = next((x for x in b.cc if x["file"].endswith("/" + b.t.probe_tu)), None)
    if e is None:
        raise Missing("no compile entry for the probe's flag donor " + b.t.probe_tu)
    toks = shlex.split(e["command"])
    keep, skip = [], False
    for t in toks:
        if skip:
            skip = False
            continue
        if t in ("-o", "-c", "-MF", "-MT", "-MQ"):
            skip = True
            continue
        if t in ("-MD", "-MMD") or t.endswith((".cpp", ".cc")) or ".pch" in t:
            continue
        if t in ("-include", "-include-pch"):
            skip = True
            continue
        if t == "-Xclang":
            continue
        # -MM leaves out system headers, and --system-header-prefix makes a
        # fork header one (server.so's quiets utlblockmemory.h's warning). The
        # closure is about which headers are READ, so it is measured without it.
        if t.startswith("--system-header-prefix"):
            continue
        keep.append(t)
    with tempfile.TemporaryDirectory(prefix="nv-allow-") as td:
        tu = os.path.join(td, "probe.cpp")
        with open(tu, "w") as f:
            f.write('#include "tier0/platform.h"\n')
            for r in roots:
                f.write('#include "%s"\n' % r)
        out = run(keep + ["-MM", "-w", tu], cwd=e["directory"])
    paths = set()
    for t in out.replace("\\\n", " ").split():
        if t.startswith("/"):
            paths.add(os.path.realpath(t))
    fork = fork_root().rstrip("/") + "/"
    return sorted(p[len(fork):] for p in paths if p.startswith(fork))


def read_lines(path):
    if not os.path.isfile(path):
        raise Missing(path + " is missing")
    return [l.strip() for l in open(path) if l.strip() and not l.startswith("#")]


def measure(b, allow):
    t = b.t
    fork = fork_root()
    closure = b.closure()
    fork_files, bad = classify_closure(closure, fork, set(allow))
    srcs = b.sources()
    pre = fork.rstrip("/") + "/"
    fork_srcs = sorted(s[len(pre):] for s in srcs if s.startswith(pre))
    link_bad = link_forbidden(b.link_tokens, t)
    needed_bad = [n for n in b.needed() if n in NEEDED_FORBIDDEN]
    inc_bad = incdirs_forbidden(b.incdirs(), b.src, REPO, t)
    inc_bad_tus = sorted(os.path.relpath(os.path.realpath(f), REPO)
                         for f, d in b.incdirs(per_tu=True).items()
                         if incdirs_forbidden(d, b.src, REPO, t))
    decls = []
    for s in srcs:
        if s.startswith(pre):
            continue
        with open(s, errors="replace") as f:
            decls += ["%s: %s" % (os.path.relpath(s, REPO), l.strip()) for l in decl_lines(f.read(), t)]
    imports, imp_detail = b.imports()
    rows = {
        "fork-hdr-total": len(fork_files),
        "fork-hdr-not-allowed": len(bad),
        "fork-src": len(fork_srcs),
        "link-forbidden": len(link_bad),
        "needed-forbidden": len(needed_bad),
        "incdir-forbidden": len(inc_bad),
        "incdir-forbidden-tus": len(inc_bad_tus),
        "native-convar-decls": len(decls),
    }
    detail = {"fork-hdr-not-allowed": sorted(bad), "fork-src": fork_srcs,
              "link-forbidden": link_bad, "needed-forbidden": needed_bad,
              "incdir-forbidden": inc_bad, "incdir-forbidden-tus": inc_bad_tus,
              "native-convar-decls": decls}
    if t.memalloc:
        memalloc = b.memalloc_importers()
        memalloc_defs = b.memalloc_definers()
        memalloc_dll = b.memalloc_in_dll()
        rows.update({"memalloc-importers": len(memalloc),
                     "memalloc-definers": len(memalloc_defs),
                     "memalloc-in-dll": len(memalloc_dll)})
        detail.update({"memalloc-importers": memalloc,
                       "memalloc-definers": memalloc_defs, "memalloc-in-dll": memalloc_dll})
    if t.sdk_links:
        # R8: the fork files tools/sdk-census attributes to this DLL alone.
        links = read_lines(os.path.join(REPO, t.sdk_links))
        rows["sdk-links"] = len(links)
        detail["sdk-links"] = links
    if t.logic:
        # R7: LOGIC + unruled function lines by tools/shim-scope's ledger.
        # Its own check (drift, rulings) runs on its own; this is the count.
        import importlib.machinery
        ss = importlib.machinery.SourceFileLoader(
            "shim_scope", os.path.join(REPO, "tools", "shim-scope")).load_module()
        total, problems, _ = ss.measure(t.logic, quiet=True)
        unreadable = [p for p in problems if "no source files" in p or "cannot be mapped" in p]
        if unreadable:
            raise Missing("tools/shim-scope --scope %s: %s" % (t.logic, "; ".join(unreadable[:3])))
        rows["logic-lines"] = total
        detail["logic-lines"] = problems
    for k, v in imports.items():
        rows["imports:" + k] = v
    for k, v in imp_detail.items():
        detail["imports:" + k] = v
    return rows, detail


def read_ratchet(t=SERVER):
    rows = {}
    for l in read_lines(t.doc("%s-novalve-ratchet.tsv")):
        k, v = l.split("\t")[:2]
        rows[k] = int(v)
    return rows


def write_ratchet(rows, tip, t=SERVER):
    """Rewrite the rows; the comment lines (the file's history) are kept, and
    the `# measured at` line is moved to this tip."""
    path = t.doc("%s-novalve-ratchet.tsv")
    head = ["# docs/%s-novalve-ratchet.tsv: tools/%s-novalve-census's rows.\n" % (t.name, t.name),
            "# A row may only fall. Regenerate with --write and review the diff.\n"]
    if os.path.isfile(path):
        old = [l for l in open(path) if l.startswith("#")]
        if old:
            head = old
    head = [l for l in head if not l.startswith("# measured at ")]
    with open(path, "w") as f:
        f.write("".join(head[:2]) + "# measured at %s\n" % tip + "".join(head[2:]))
        for k in sorted(rows):
            f.write("%s\t%d\n" % (k, rows[k]))



    ff, bad = classify_closure({fork + "/src/public/cdll_int.h"}, fork, {"src/public/cdll_int.h"})
    ck("client: negative control: the allowlisted closure alone counts nothing", not bad and len(ff) == 1)
    ck("client: a game/ line in the allowlist is refused",
       forbidden_allow_lines(["src/public/cdll_int.h", "src/game/client/c_pixel_visibility.h"], C)
       == ["src/game/client/c_pixel_visibility.h"])
    ck("client: a steam/ or vscript/ line in the allowlist is refused",
       forbidden_allow_lines(["src/public/steam/isteamcontroller.h", "src/public/vscript/ivscript.h"], C)
       == ["src/public/steam/isteamcontroller.h", "src/public/vscript/ivscript.h"])
    ck("client: particles/ and dmxloader/ lines are allowed (plan 3.4), and refused for the server",
       forbidden_allow_lines(["src/public/particles/particles.h", "src/public/dmxloader/dmxelement.h"], C) == []
       and len(forbidden_allow_lines(["src/public/particles/particles.h"], SERVER)) == 1)
    htoks = ["clang++", "-o", "out/libss_particles.so", "/x/particles.a", "/x/dmxloader.a", "lib/libtier1.a"]
    ck("client: a bound archive on the bound library's link line has moved there",
       bound_archive_moved("particles", htoks) and bound_archive_moved("dmxloader", htoks))
    ck("negative control: one on neither link line has not (a missing input, not a zero)",
       not bound_archive_moved("particles", ["clang++", "-o", "out/libss_particles.so", "lib/libtier1.a"])
       and not bound_archive_moved("particles", [])
       and not bound_archive_moved("particles", ["-l/x/particles.a"]))
    ctoks = ["/x/libvgui_controls.a", "lib/libmatsys_controls.a", "/x/bitmap.a", "/x/vtf.a",
             "/x/particles.a", "/x/dmxloader.a", "/x/libmathlib.a", "-ltier0"]
    ck("client: vgui_controls, matsys_controls, bitmap, vtf and tier0 are forbidden; particles, "
       "dmxloader and mathlib are not",
       link_forbidden(ctoks, C) == ["/x/libvgui_controls.a", "lib/libmatsys_controls.a", "/x/bitmap.a",
                                    "/x/vtf.a", "-ltier0"])
    ib = incdirs_forbidden([fs + "/public", fs + "/vgui2/include", fs + "/game/client",
                            fs + "/vgui2/controls", fs + "/common"], fs, "/w", C)
    ck("client: vgui2/include is allowed; game/client, vgui2/controls and common are not",
       ib == ["src/common", "src/game/client", "src/vgui2/controls"])
    ck("server: vgui2/include stays forbidden", incdirs_forbidden([fs + "/vgui2/include"], fs, "/w") == ["src/vgui2/include"])
    ck("client: a GAME_DLL-only declaration is not the client's",
       decl_lines('#ifdef GAME_DLL\nConVar a( "a", "0" );\n#endif\n'
                  '#ifndef CLIENT_DLL\nConVar b( "b", "0" );\n#endif', C) == [])
    ck("client: a CLIENT_DLL-only declaration is the client's, its #else is not",
       decl_lines('#ifdef CLIENT_DLL\nConVar a( "a", "0" );\n#else\nConVar b( "b", "0" );\n#endif', C)
       == ['ConVar a( "a", "0" );'])

    rose, um, ub = compare({"a": 3, "b": 1}, {"a": 4, "b": 0})
    ck("a row that rose is red", rose == [("a", 3, 4)])
    ck("a row that fell is not", all(r[0] != "b" for r in rose))
    rose, um, ub = compare({"a": 3, "b": 1}, {"a": 3})
    ck("a baselined row that was not measured is red", um == ["b"])
    rose, um, ub = compare({"a": 3}, {"a": 3, "c": 0})

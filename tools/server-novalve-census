def self_test():
    checks = failed = 0

    def ck(what, ok):
        nonlocal checks, failed
        checks += 1
        if not ok:
            failed += 1
            print("  FAIL", what)

    fork = "/f/src-root"
    paths = {fork + "/src/public/eiface.h", fork + "/src/game/server/cbase.h", "/r/ours.h"}
    ff, bad = classify_closure(paths, fork, {"src/public/eiface.h"})

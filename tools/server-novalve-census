#!/usr/bin/env python3
"""tools/server-novalve-census -- how much Valve source and how many tier libs
server.so still uses: the ratchet behind docs/plans/plan_server_novalve.md.

    tools/server-novalve-census               measure, compare against
                                              docs/server-novalve-ratchet.tsv;
                                              exit 1 if any row ROSE, if the
                                              allowlist drifted, or an input
                                              is missing
    tools/server-novalve-census --write       rewrite the ratchet to what was
                                              measured (review the diff)
    tools/server-novalve-census --allowlist   regenerate
                                              docs/server-fork-allowlist.txt
                                              from docs/server-fork-roots.txt
    tools/server-novalve-census --report      print the offending names too
    tools/server-novalve-census --self-test   this script's own checks

    SOURCESHARP_CONFIG (or --config) picks farm/<config>; default debug.

    --target client (tools/client-novalve-census is that spelling) measures
    out/client.so against docs/client-{novalve-ratchet.tsv,fork-roots.txt,
    fork-allowlist.txt}: plan_client_novalve.md 4.1's R1-R8. The CLIENT
    Target below holds every difference (its forbidden libraries leave
    particles and dmxloader out by the plan 3.4 ruling, vgui2/include is an
    allowed include dir, GAME_DLL-only branches are the dead ones), and adds
      R7 logic-lines        LOGIC + unruled function lines, tools/shim-scope
      R8 sdk-links          rows of sdk-links/client.txt (tools/sdk-census)
    and drops the memalloc rows, which are server P4/P5's.

WHAT IS MEASURED (the plan's section 2 gates), all from BUILD OUTPUT, so it
needs `make debug` in this checkout; a missing input is a failure, never zero:

  R1 fork-hdr-not-allowed   fork files in the dep closure of server.so's
                            objects (`ninja -t deps`, readlink -f) that are not
                            in docs/server-fork-allowlist.txt
  R2 fork-src               fork files among the objects' sources
  R3 link-forbidden         forbidden link inputs: the tier libraries,
                            particles, dmxloader, steam_api, devtools/ files,
                            and the tier0 file-io --wrap flags
  R4 needed-forbidden       DT_NEEDED entries naming libtier0/libvstdlib/
                            libsteam_api (readelf -d)
  R5 incdir-forbidden       -I directories inside the farm other than the
                            allowed public dirs and this repo's own
     incdir-forbidden-tus   server TUs whose compile still carries one (the
                            legacy include set, src/server/native/CMakeLists.txt)
  R6 native-convar-decls    whole-line ConVar / ConCommand / CON_COMMAND
                            declarations in the target's own source files
  imports:<lib>             symbols the objects import from each dropped
                            library (undefined in some object, defined in
                            none, attributed to the first library in link
                            order that defines it)
  memalloc-importers        link-line objects whose `nm -u` names tier0's
                            g_pMemAlloc. tier1's CUtl containers and
                            memdbgon.h's strdup and aligned allocation reach
                            it; memoverride.cpp is the one P4 deletes
  memalloc-definers         link-line objects that DEFINE g_pMemAlloc
                            (tier0_heap_port.cpp's, until P5 step 5 deletes it)
  memalloc-in-dll           g_pMemAlloc in server.so's own symbol table, defined
                            or imported (`nm`): step 5's gate is 0 and 0 and 0

THE ALLOWLIST IS GENERATED, never hand-edited. --allowlist compiles one probe
TU #including every root in docs/server-fork-roots.txt with a server TU's own
flags and records the fork closure. It refuses a closure with a line under a
forbidden directory (game/, vscript/, particles/, dmxloader/, steam/). The
normal run regenerates it in memory and fails if the committed file drifted.
"""

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# The file-io wraps whose __wrap_ targets live in libtier0.so. The allocation
# checker's wraps (malloc, free, operator new/delete) are ours and allowed.
TIER0_WRAPS = ("fopen", "freopen", "open", "creat", "access", "__xstat", "stat",
               "stat64", "lstat", "fopen64", "open64", "opendir", "chmod",
               "chown", "lchown", "symlink", "link", "__lxstat64", "mknod",
               "utimes", "unlink", "rename", "utime", "__xstat64", "mount",
               "mkfifo", "mkdir", "rmdir", "scandir", "realpath", "__lxstat")
NEEDED_FORBIDDEN = ("libtier0.so", "libvstdlib.so", "libsteam_api.so")
RE_DECL = re.compile(r"^\s*(?:static\s+)?(?:ConVar\s+\w+\s*\(|ConCommand\s+\w+\s*\(|"
                     r"CON_COMMAND(?:_F|_EXTERN|_F_COMPLETION|_EXTERN_F)?\s*\()")


def bound_archive_moved(arch, home_tokens):
    """True when the bound archive <arch>.a is on the bound library's link line
    (plan_particles_so.md): it left the DLL for that library, not for nowhere."""
    return any(os.path.basename(t) in ("%s.a" % arch, "lib%s.a" % arch)
               for t in home_tokens if not t.startswith("-"))


class Target:
    """What differs between the DLLs this census measures. Everything else --
    how the closure, the link line, the include dirs and the imports are read
    -- is one code path for both."""

    def __init__(self, **kw):
        self.__dict__.update(kw)

    def doc(self, name):
        return os.path.join(REPO, "docs", name % self.name)



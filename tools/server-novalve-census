       not set(memalloc_importers(nm_out)) & {"/b/y.cpp.o", "/b/z.cpp.o", "/b/w.cpp.o"})
    ck("negative control: no importer, no count",
       memalloc_importers("/b/y.cpp.o:                 U malloc\n") == [])


#!/usr/bin/env python3
"""plan_entity.md step 7c's own gate: first and third person, shake, fade, viewmodel.

    tools/7c-view-gate

Launches ONE game, drives it, and prints PASS/FAIL per check with the number
each verdict was reached from. Exit 0 only when every check passed.

WHY THIS EXISTS RATHER THAN A SCREENSHOT. 7c's gate sentence is "first and
third person views; screen shake and fade; the viewmodel draws", and every one
of those is a picture. A picture is exactly the evidence this port has been
fooled by before: a third-person camera scaled by zero, a camera placed in
FRONT of the eye, and a camera that never moved all produce the same frame -- a
room with no player in it -- and "the game did not crash" is true of all three.

So each check below is a NUMBER read out of the running game, chosen so that
the failure it is looking for changes it:

  first/third person   the distance between where the CAMERA is (getpos) and
                       where the PLAYER is (getpos 2). In first person that is
                       the view offset, about 64 units straight up. In third
                       person the camera is cam_idealdist behind as well, so
                       the distance roughly trebles. A camera that did not move
                       leaves the two readings equal and the check fails.

  the viewmodel        cs_cl_viewmodel_report says "drawing" or "NOT drawing"
                       for the entity actually in the viewmodel pass, and where
                       it is drawn. Both are asserted: an entity in the pass
                       that reports drawing at (0,0,0) is not being drawn at
                       the eye.

  shake                cs_cl_vieweffects_report's last line is the displacement
                       the LAST RENDERED FRAME was moved by. Zero is what this
                       build read for the whole of the port while the server
                       sent shakes nobody applied, so a non-zero reading here
                       is the whole of the evidence.

  fade                 the same report's fade line, whose alpha is what the
                       screen is being tinted by.

The three-way ordering matters and is checked: first person, then third, then
first again. A viewmodel that reports "drawing" in all three states is not
reading the camera, and a check that only ever looked at one state would pass
for it.

  the fog          cs_cl_fog_report's "SHIPPED" and its push count. Step 7c
                   gated on the fog gap being on the not-shipped LEDGER,
                   because at the time the fog did not reach this client at
                   all. Step 8e-render then shipped it, so that check
                   inverted -- it asserted an absence that had been filled and
                   failed with nothing wrong. Step c7-view repointed it at
                   what fog now is: SHIPPED with a non-zero push count, plus
                   the row having LEFT the ledger. "The row is gone" alone
                   would pass for a fog that was silently dropped, which is
                   what step 7c wrote the row to prevent, so both halves are
                   asserted and the skybox row is the ledger's live control.

DEBT, with a removal owner: this is 7c's gate and nothing else reads it. It
goes when tools/live-gate grows a view step, or with step 8c, which folds the
live gates into a `make test` leg.
"""
import math
import os
import re
import signal
import subprocess
import sys
import time

# The flags every local game carries (+sv_lan 1 unless STEAM_AUTH=1, +fps_max
# 60): tools/local_launch.py, the Makefile's LOCAL_GAME_ARGS.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import local_launch  # noqa: E402

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# The game this configuration built, and the mod in it. bin/<config> holds the
# launcher and the shared bin/; the mod is bin/<config>/mods/test, handed to the
# launcher with -game, and -condebug writes console.log there.
# SOURCESHARP_CONFIG picks the configuration; debug when unset.
CONFIG = os.environ.get("SOURCESHARP_CONFIG") or "debug"
GAME_DIR = os.path.join(ROOT, "bin", CONFIG)
MOD_DIR = os.path.join(GAME_DIR, "mods", "test")

def launch_command(mod_dir):
    """source#, run from the game directory. No -game: it takes the mod from
    mods.yaml beside it, so every launch proves the file supplies it. `#` is
    quoted, so no shell reads it as a comment (tools/launcher-name-test)."""
    return "./'source#'"
SOCKET_DIR = os.environ.get("DEBUG_API_DIR", "/tmp/sourcesharp-debug-api")
CONSOLE = os.path.join(MOD_DIR, "console.log")

LAUNCH = ["-debugapi", "-debugapisocket", "-condebug", "-nomessagebox",
          "-nocrashdialog", "-assertlog", "-insecure", "-novid", "-windowed",
          "-w", "640", "-h", "480", "-maxplayers", "2",
          ] + local_launch.local_args() + ["+map", "dm_lockdown"]

# The open floor tools/live-gate-scenarios calls `openFloor`. Somewhere with
# room BEHIND the player, or the third-person camera is pulled into a wall and
# collapses onto the eye -- which is a correct camera producing a first-person
# reading, and would fail the third-person check for the wrong reason.
OPEN_FLOOR = "-3843 2894 0"

FAILURES = []
NOTES = []


def check(name, ok, detail):
    print("  %-34s %s   %s" % (name, "PASS" if ok else "FAIL", detail))
    if not ok:
        FAILURES.append(name)
    return ok


def live_sockets():
    if not os.path.isdir(SOCKET_DIR):
        return []
    out = []
    for name in os.listdir(SOCKET_DIR):
        if not name.endswith(".sock"):
            continue
        try:
            os.kill(int(name[:-5]), 0)
        except (OSError, ValueError):
            continue
        out.append(os.path.join(SOCKET_DIR, name))
    return out


def debug_api(pid, *args):
    env = dict(os.environ, DEBUG_API_PID=str(pid), DEBUG_API_DIR=SOCKET_DIR)
    r = subprocess.run([os.path.join(ROOT, "tools", "debug-api")] + list(args),
                       capture_output=True, text=True, env=env, timeout=120)
    return r.stdout


def console():
    try:
        with open(CONSOLE, "r", errors="replace") as fh:
            return fh.read()
    except IOError:
        return ""


def tail_after(marker):
    """Everything the console said after the LAST occurrence of marker.

    Every reading below is taken this way rather than by searching the whole
    log, because each of these commands is run three times and a whole-log
    search would answer with the first run's numbers for all three.
    """
    text = console()
    i = text.rfind(marker)
    return text[i:] if i >= 0 else ""


def getpos(pid, arg=""):
    """The camera (no arg) or the player (arg '2'), as three floats."""
    debug_api(pid, "cmd", ("getpos %s" % arg).strip())
    time.sleep(0.6)
    m = None
    for m2 in re.finditer(r"setpos(?:_exact)? (-?[\d.]+) (-?[\d.]+) (-?[\d.]+);", console()):
        m = m2
    if not m:
        return None
    return (float(m.group(1)), float(m.group(2)), float(m.group(3)))


def dist(a, b):
    return math.sqrt(sum((a[i] - b[i]) ** 2 for i in range(3)))


def camera_player_gap(pid):
    cam = getpos(pid)
    ply = getpos(pid, "2")
    if cam is None or ply is None:
        return None, None, None
    return dist(cam, ply), cam, ply


def viewmodel(pid):
    """(drawing, origin) for the entity in the viewmodel pass."""
    debug_api(pid, "cmd", "cs_cl_viewmodel_report")
    time.sleep(0.8)
    # "viewmodel pass: entity", NOT "viewmodel pass:". The report prints TWO
    # lines with that prefix -- the entity and then the arsenal beside it -- and
    # rfind lands on the arsenal line, which carries neither the origin nor the
    # verdict. The first version of this read EMPTY for a viewmodel that was
    # drawing, at the right place, in the console two lines above. A needle that
    # matches the wrong one of two lines is a needle with no subject.
    if "viewmodel pass: empty" in tail_after("viewmodel pass:"):
        return None, None
    text = tail_after("viewmodel pass: entity")
    m = re.search(r"drawn at \((-?[\d.]+) (-?[\d.]+) (-?[\d.]+)\)", text)
    origin = (float(m.group(1)), float(m.group(2)), float(m.group(3))) if m else None
    if ", NOT drawing" in text:
        return False, origin
    if ", drawing" in text:
        return True, origin
    return None, origin


def vieweffects(pid):
    """(applied-origin-shift-magnitude, applied-angle-shift-magnitude, fade alpha)."""
    debug_api(pid, "cmd", "cs_cl_vieweffects_report")
    time.sleep(0.8)
    text = tail_after("vieweffects:")
    a = re.search(r"APPLIED to the last rendered frame: origin\s+"
                  r"(-?[\d.]+)\s+(-?[\d.]+)\s+(-?[\d.]+)\s+angles\s+"
                  r"(-?[\d.]+)\s+(-?[\d.]+)\s+(-?[\d.]+)", text)
    f = re.search(r"fade\s+rgba (\d+) (\d+) (\d+) (\d+)", text)
    org = math.sqrt(sum(float(a.group(i)) ** 2 for i in (1, 2, 3))) if a else None
    ang = math.sqrt(sum(float(a.group(i)) ** 2 for i in (4, 5, 6))) if a else None
    alpha = int(f.group(4)) if f else None
    return org, ang, alpha


def main():
    tmpdir = "/tmp/ss-7c-viewgate"
    os.makedirs(tmpdir, exist_ok=True)
    os.makedirs(SOCKET_DIR, exist_ok=True)
    if os.path.exists(CONSOLE):
        os.remove(CONSOLE)

    print("box before: hl2_linux64 %s, free -g:" % count_games())
    subprocess.run(["free", "-g"])

    known = set(live_sockets())
    quoted = " ".join("'%s'" % a for a in LAUNCH)
    line = (". '%s/tools/gpu-offload'; cd '%s' && exec %s %s"
            % (ROOT, GAME_DIR, launch_command(MOD_DIR), quoted))
    log = open(os.path.join(tmpdir, "launch.log"), "wb")
    popen = subprocess.Popen(["bash", "-c", line], stdout=log,
                             stderr=subprocess.STDOUT,
                             env=dict(os.environ, TMPDIR=tmpdir),
                             start_new_session=True)

    pid = None
    deadline = time.time() + 240
    while time.time() < deadline:
        fresh = [s for s in live_sockets() if s not in known]
        if fresh:
            pid = int(os.path.basename(fresh[0])[:-5])
            break
        if popen.poll() is not None:
            break
        time.sleep(1.0)

    if pid is None:
        try:
            os.killpg(os.getpgid(popen.pid), signal.SIGKILL)
        except OSError:
            pass
        print("no socket appeared; the game never came up")
        return 2

    try:
        print("game pid %d" % pid)
        for _ in range(60):
            if "ss_player" in debug_api(pid, "ents", "ss_player"):
                break
            time.sleep(1.0)

        debug_api(pid, "cmd", "sv_cheats 1")
        time.sleep(0.5)

        # Onto the open floor, retried: `setpos` is a player command and the
        # console answers "no player issued that" -- silently, from here --
        # while the local player is still arriving.
        for _ in range(15):
            before = console().count("no player issued that")
            debug_api(pid, "cmd", "setpos " + OPEN_FLOOR)
            time.sleep(1.0)
            if console().count("no player issued that") == before:
                break
        time.sleep(1.5)

        # ---------------------------------------------------------------
        # FIRST PERSON
        # ---------------------------------------------------------------
        debug_api(pid, "cmd", "firstperson")
        time.sleep(1.2)
        gap1, cam1, ply1 = camera_player_gap(pid)
        vm1, vmorg1 = viewmodel(pid)

        check("first person: camera at the eye",
              gap1 is not None and gap1 < 80.0,
              "camera-to-player %.1f units (the view offset; a third-person "
              "camera is cam_idealdist further)"
              % (gap1 if gap1 is not None else -1))

        check("first person: the viewmodel DRAWS",
              vm1 is True,
              "cs_cl_viewmodel_report says %s" %
              ("drawing" if vm1 else "NOT drawing" if vm1 is False else "the pass is EMPTY"))

        check("first person: drawn at the eye, not the origin",
              vmorg1 is not None and cam1 is not None and dist(vmorg1, cam1) < 8.0,
              "viewmodel at %s, camera at %s" % (vmorg1, cam1))

        # ---------------------------------------------------------------
        # THIRD PERSON
        # ---------------------------------------------------------------
        debug_api(pid, "cmd", "thirdperson")
        time.sleep(1.5)
        gap3, cam3, ply3 = camera_player_gap(pid)
        vm3, _ = viewmodel(pid)

        check("third person: the camera LEFT the eye",
              gap1 is not None and gap3 is not None and gap3 > gap1 + 40.0,
              "camera-to-player %.1f units, against %.1f in first person"
              % (gap3 if gap3 is not None else -1, gap1 if gap1 is not None else -1))

        check("third person: the viewmodel is HIDDEN",
              vm3 is False,
              "cs_cl_viewmodel_report says %s" %
              ("drawing" if vm3 else "NOT drawing" if vm3 is False else "the pass is EMPTY"))

        # ---------------------------------------------------------------
        # ...AND BACK. A reading that never changes back is a latch, not a view.
        # ---------------------------------------------------------------
        debug_api(pid, "cmd", "firstperson")
        time.sleep(1.5)
        gapB, camB, plyB = camera_player_gap(pid)
        vmB, _ = viewmodel(pid)

        check("back to first person: camera returns",
              gapB is not None and gap3 is not None and gapB < gap3 - 40.0,
              "camera-to-player %.1f units" % (gapB if gapB is not None else -1))
        check("back to first person: viewmodel returns",
              vmB is True,
              "cs_cl_viewmodel_report says %s" %
              ("drawing" if vmB else "NOT drawing" if vmB is False else "the pass is EMPTY"))

        # ---------------------------------------------------------------
        # SCREEN SHAKE. Zero is what this build read for the whole of the port.
        # ---------------------------------------------------------------
        q0, a0, _ = vieweffects(pid)
        debug_api(pid, "cmd", "ent_create env_shake targetname ss7cshake "
                           "amplitude 16 frequency 40 duration 8 radius 0 spawnflags 1")
        time.sleep(1.0)
        NOTES.append("ents env_shake after create: "
                     + " ".join(debug_api(pid, "ents", "env_shake").split())[:300])
        # `debug-api fire`, NOT the console's `ent_fire`, and the difference is
        # recorded because it cost a run. An entity created by `ent_create` is a
        # point entity with index -1 -- no edict -- and the console `ent_fire`
        # answers `nothing is called "env_shake" and nothing is of that class`
        # for it, in the same second that `debug-api ents env_shake` reports
        # count 1. Both readings are kept in
        # .claude/entity-port/status/7c-gate-run2.log. So a zero
        # shake through that route would have been evidence about the harness
        # and not about the view.
        NOTES.append("fire StartShake: "
                     + " ".join(debug_api(pid, "fire", "env_shake", "StartShake").split())[:200])
        time.sleep(1.5)

        best = 0.0
        for _ in range(8):
            q, a, _ = vieweffects(pid)
            if q is not None:
                best = max(best, q)
            if a is not None:
                best = max(best, a)
            if best > 0.0:
                break
            time.sleep(0.5)

        check("screen shake moves the rendered view",
              best > 0.0,
              "largest applied displacement %.3f (was %.3f before the shake); "
              "zero is what an unapplied shake reads"
              % (best, (q0 or 0.0)))

        # ---------------------------------------------------------------
        # SCREEN FADE.
        # ---------------------------------------------------------------
        debug_api(pid, "cmd", "ent_create env_fade targetname ss7cfade "
                           "duration 8 holdtime 8 renderamt 255 rendercolor \"255 0 0\"")
        time.sleep(1.0)
        NOTES.append("ents env_fade after create: "
                     + " ".join(debug_api(pid, "ents", "env_fade").split())[:300])
        NOTES.append("fire Fade: "
                     + " ".join(debug_api(pid, "fire", "env_fade", "Fade").split())[:200])
        time.sleep(1.2)

        alphaBest = 0
        for _ in range(8):
            _, _, alpha = vieweffects(pid)
            if alpha:
                alphaBest = max(alphaBest, alpha)
                break
            time.sleep(0.5)

        check("screen fade tints the screen",
              alphaBest > 0,
              "fade alpha %d" % alphaBest)

        # ---------------------------------------------------------------
        # THE TWO GAPS 7c NAMED, AND WHAT HAPPENED TO THEM.
        #
        # Step 7c found the world fog and the 3D skybox both answering NULL,
        # made each a printed not-shipped row rather than a silent early
        # return, and gated on the row being there. Since then step 8e-render
        # (c03eaceb7, "the world fog reaches the client") SHIPPED
        # THE FOG: the resolved values ride in PlayerNetState and the managed
        # client pushes them through EngineApi.SetViewerFogParams. So the fog
        # row is gone from the ledger and this check inverted -- it had been
        # asserting an absence that has been filled, and it failed on
        # 19765e427 with no lane's change in the tree.
        #
        # Step c7-view repoints it at what fog now IS rather than deleting it,
        # and the replacement is STRONGER than the row it replaces: it reads
        # cs_cl_fog_report (shell_view_facts.cpp) and requires the fog to say
        # SHIPPED with a non-zero push count. "The row is not on the ledger"
        # on its own would pass for a fog that had been silently dropped,
        # which is precisely what 7c refused to allow.
        #
        # The skybox row is UNCHANGED and is the ledger's positive control: if
        # cs_cl_notshipped ever printed nothing at all, the fog half could
        # not tell that from a closed gap, and this half can.
        # ---------------------------------------------------------------
        debug_api(pid, "cmd", "cs_cl_fog_report")
        time.sleep(1.0)
        fogreport = tail_after("viewer fog:")
        fogpushes = 0
        m = re.search(r"pushes (\d+)", fogreport)
        if m:
            fogpushes = int(m.group(1))
        check("the world fog reaches the client",
              "SHIPPED" in fogreport and fogpushes > 0,
              "cs_cl_fog_report says %s, %d push(es)"
              % ("SHIPPED" if "SHIPPED" in fogreport else "nothing pushed",
                 fogpushes))

        debug_api(pid, "cmd", "cs_cl_notshipped")
        time.sleep(1.0)
        ledger = tail_after("not-shipped ledger (client)")
        check("the fog gap has LEFT the ledger",
              "world fog (client)" not in ledger,
              "cs_cl_notshipped %s the row"
              % ("STILL carries" if "world fog (client)" in ledger else "no longer carries"))
        # INVERTED BY LANE defect-skybox, and inverted rather than deleted for
        # the reason the fog's row above was: a row that simply disappears from
        # a gate makes a closed gap and a broken wire look identical again,
        # which is the whole thing this gate's ledger exists to stop. The
        # skybox took TWO faults to close -- phase4-exit's reachability half and
        # this lane's wire half -- and tools/7a-effect-gate carries the RENDERED
        # proof with its r_3dsky control arm. This gate only reads the ledger.
        check("the 3D skybox gap has LEFT the ledger",
              "3D skybox (client)" not in ledger,
              "cs_cl_notshipped %s the row"
              % ("STILL carries" if "3D skybox (client)" in ledger else "no longer carries"))

        # ---------------------------------------------------------------
        # And nothing fell over on the way.
        # ---------------------------------------------------------------
        text = console()
        nbad = len(re.findall(r"Assertion|SIGSEGV|Segmentation", text))
        check("no assertion and no segfault", nbad == 0,
              "%d matches for Assertion|SIGSEGV|Segmentation" % nbad)

    finally:
        try:
            os.killpg(os.getpgid(popen.pid), signal.SIGKILL)
        except OSError:
            pass
        try:
            popen.wait(timeout=20)
        except Exception:
            pass
        log.close()
        print("box after: hl2_linux64 %s" % count_games())

    print()
    for note in NOTES:
        print("  note: " + note)
    print()
    if FAILURES:
        print("7c-view-gate: FAILED -- " + ", ".join(FAILURES))
        return 1
    print("7c-view-gate: every check passed")
    return 0


def count_games():
    # `pgrep -c` prints 0 AND exits 1, so a shell `|| echo 0` emits TWO zeroes.
    # Counting the lines here avoids that entirely.
    r = subprocess.run(["pgrep", "-x", "hl2_linux64"], capture_output=True, text=True)
    return str(len([l for l in r.stdout.split("\n") if l.strip()]))


if __name__ == "__main__":
    sys.exit(main())
